[
  {
    "name": "MGnify_get_genome",
    "description": "Get detailed genome information from the MGnify genome catalog. Returns assembly quality metrics (completeness, contamination, N50), taxonomy, geographic origin, rRNA counts, protein count, pangenome statistics, and cross-references to ENA. Example: MGYG000000001 returns a high-quality Firmicutes isolate genome with 98.6% completeness.",
    "parameter": {
      "type": "object",
      "properties": {
        "genome_id": {
          "type": "string",
          "description": "MGnify genome accession. Examples: 'MGYG000000001', 'MGYG000535630'."
        }
      },
      "required": [
        "genome_id"
      ]
    },
    "fields": {
      "endpoint_type": "genome",
      "query_mode": "detail"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "genome_id": "MGYG000000001"
      },
      {
        "genome_id": "MGYG000535630"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "genome_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "description": "Isolate or MAG"
            },
            "taxonomy": {
              "type": "string",
              "description": "Full taxonomic lineage"
            },
            "completeness": {
              "type": "number"
            },
            "contamination": {
              "type": "number"
            },
            "length": {
              "type": "integer"
            },
            "num_proteins": {
              "type": "integer"
            },
            "gc_content": {
              "type": "number"
            },
            "n50": {
              "type": "integer"
            },
            "geographic_origin": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MGnify_search_genomes",
    "description": "Search the MGnify genome catalog by GTDB taxonomy lineage with explicit page pagination. Returns genome quality metrics, taxonomy, and protein counts. Response metadata exposes total_results, total_pages, has_more, and next_page. Taxonomy names follow GTDB: use 'Bacteroidota', 'Bacillota', or 'Pseudomonadota' rather than older NCBI-style phylum names.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxonomy": {
          "type": "string",
          "description": "GTDB taxonomy lineage filter, matched anywhere in the lineage. Examples: 'Bacteroidota' (phylum), 'Bacteroides' (genus), 'Bacillota', 'Pseudomonadota'. NCBI-style phylum names such as 'Bacteroidetes' or 'Firmicutes' return few or no hits -- use the GTDB spelling."
        },
        "page": {
          "type": "integer",
          "description": "One-based result page. Continue with metadata.next_page.",
          "default": 1,
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "description": "Results per page (default 25, range 1-100).",
          "default": 25,
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "fields": {
      "endpoint_type": "genome",
      "query_mode": "search"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "page": 1,
        "page_size": 5
      },
      {
        "taxonomy": "Bacteroides",
        "page": 2,
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "genome_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "taxonomy": {
                "type": "string"
              },
              "completeness": {
                "type": "number"
              },
              "contamination": {
                "type": "number"
              },
              "length": {
                "type": "integer"
              },
              "num_proteins": {
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MGnify_list_biomes",
    "description": "Browse the MGnify biome hierarchy with explicit page pagination. Returns biome identifiers, names, and sample counts. Response metadata exposes total_results, total_pages, has_more, and next_page so the complete hierarchy can be traversed.",
    "parameter": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "description": "Hierarchy depth to filter by (1=root, 2=second level, etc.)."
        },
        "page": {
          "type": "integer",
          "description": "One-based result page. Continue with metadata.next_page.",
          "default": 1,
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "description": "Results per page (default 25, range 1-100).",
          "default": 25,
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "fields": {
      "endpoint_type": "biome",
      "query_mode": "list"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "page_size": 10
      },
      {
        "page": 2,
        "page_size": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "biome_id": {
                "type": "string"
              },
              "biome_name": {
                "type": "string"
              },
              "samples_count": {
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MGnify_get_study_detail",
    "description": "Get detailed information about a specific MGnify metagenomics study. Returns study name, abstract, associated BioProject, centre, public/private status, sample count, and biomes. Complementary to MGnify_search_studies which lists studies; use MGnify_list_analyses / MGnify_list_analysis_downloads for exact analyses/downloads counts (this endpoint does not provide them). Example: MGYS00002008 is a Tara Oceans marine metagenomics study.",
    "parameter": {
      "type": "object",
      "properties": {
        "study_accession": {
          "type": "string",
          "description": "MGnify study accession. Examples: 'MGYS00002008', 'MGYS00005292'."
        }
      },
      "required": [
        "study_accession"
      ]
    },
    "fields": {
      "endpoint_type": "study",
      "query_mode": "detail"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "study_accession": "MGYS00002008"
      },
      {
        "study_accession": "MGYS00005292"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "study_id": {
              "type": "string"
            },
            "study_name": {
              "type": "string"
            },
            "study_abstract": {
              "type": "string"
            },
            "bioproject": {
              "type": "string"
            },
            "centre_name": {
              "type": "string"
            },
            "biomes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "is_public": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "samples_count": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MGnify_get_taxonomy",
    "description": "Get a page of taxonomic composition from a MGnify analysis, including abundance, lineage, and rank. Supports SSU and LSU marker genes with strict validation. The response metadata exposes total_results, total_pages, has_more, and next_page; follow next_page to retrieve all taxa rather than silently stopping at the first page.",
    "parameter": {
      "type": "object",
      "properties": {
        "analysis_id": {
          "type": "string",
          "description": "MGnify analysis accession (e.g., 'MGYA00585482'). Find IDs via MGnify_list_analyses."
        },
        "rna_type": {
          "type": "string",
          "description": "rRNA marker type: 'ssu' for 16S/18S (default) or 'lsu' for 23S/28S.",
          "enum": ["ssu", "lsu"],
          "default": "ssu"
        },
        "page": {
          "type": "integer",
          "description": "One-based result page. Continue with metadata.next_page.",
          "default": 1,
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "description": "Number of taxa to return per page (default 25, max 100).",
          "default": 25,
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "analysis_id"
      ]
    },
    "fields": {
      "endpoint_type": "analysis",
      "query_mode": "taxonomy"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "analysis_id": "MGYA00585482",
        "page_size": 10
      },
      {
        "analysis_id": "MGYA00585482",
        "page": 2,
        "rna_type": "lsu",
        "page_size": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organism_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rank": {
            "type": "string"
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "type": "integer"
          },
          "lineage": {
            "type": "string"
          }
        }
      }
    },
    "label": [
      "MGnify",
      "Microbiome",
      "Taxonomy",
      "Metagenomics"
    ],
    "metadata": {
      "tags": [
        "taxonomy",
        "microbiome",
        "16S",
        "metagenomics",
        "community_composition"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
