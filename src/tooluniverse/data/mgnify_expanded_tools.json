  {
    "name": "MGnify_get_samples",
    "description": "List MGnify biological samples with geographic, host, and environment provenance. Pass sample_accession for one record, or omit it to page through samples filtered by study_accession or biome. List responses expose total_results, total_pages, has_more, and next_page; follow next_page to avoid first-page truncation.",
    "parameter": {
      "type": "object",
      "properties": {
        "sample_accession": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fetch a single sample by its MGnify/ENA accession (e.g., 'SRS10016989'). If provided, study_accession/biome/page are ignored."
        },
        "study_accession": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter samples belonging to a study (e.g., 'MGYS00002008')."
        },
        "biome": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by biome name lineage (e.g., 'root:Host-associated:Human:Digestive system')."
        },
        "page": {
          "type": "integer",
          "description": "One-based result page for list mode. Continue with metadata.next_page.",
          "default": 1,
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "description": "Samples per page in list mode (default 25, range 1-100).",
          "default": 25,
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "sample",
      "query_mode": "list"
    },
    "type": "MGnifyExpandedTool",
    "test_examples": [
      {
        "page_size": 2
      },
      {
        "sample_accession": "SRS10016989"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
