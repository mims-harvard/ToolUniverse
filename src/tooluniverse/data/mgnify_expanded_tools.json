                  "null"
                ]
              },
              "geo_loc_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "collection_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host_tax_id": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "environment_biome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "environment_feature": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "environment_material": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
