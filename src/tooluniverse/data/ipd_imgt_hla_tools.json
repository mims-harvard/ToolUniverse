      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "IPD-IMGT/HLA allele accession (e.g. 'HLA00001'). Obtain via IPD_search_hla_alleles."
        }
      },
      "required": [
        "accession"
      ]
    },
    "label": [
      "IPD-IMGT/HLA",
      "HLA",
      "MHC",
      "allele",
      "sequence",
      "EMBL-EBI"
    ],
    "test_examples": [
      {
        "accession": "HLA00001"
      },
      {
        "accession": "HLA01244"
      }
    ],
