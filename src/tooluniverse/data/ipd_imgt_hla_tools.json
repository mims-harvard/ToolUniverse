                "null"
              ],
              "description": "HLA class, I or II"
            },
            "allele_history": {
              "type": [
                "array",
                "null"
              ],
              "description": "Previous names this allele has had, with the release each name changed in. An HLA allele renamed between releases is the same allele, and a caller matching on name alone will miss it",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object",
                    "null"
                  ]
                }
              }
            },
            "cell_entries": {
              "type": [
                "array",
                "null"
