  {
    "type": "IPDIMGTHLATool",
    "name": "IPD_search_cells",
    "description": "Search IPD cell lines (HLA reference cells with their HLA typing) by a field value with complete access through the official opaque cursor. Returns exact total, has_more, and next_cursor; continue with the same query/field/match/limit and cursor=next_cursor. Keyless EMBL-EBI API.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Text to search for (e.g. a cell primary name, or a lab name when field='lab_of_origin'). The filter expression is built for you."
        },
        "field": {
          "type": "string",
          "description": "Cell field to search (default 'primary_name'). Other useful fields include 'lab_of_origin'.",
          "default": "primary_name"
        },
        "match": {
          "type": "string",
          "enum": [
            "startsWith",
            "contains",
            "eq"
          ],
          "description": "How to match: 'contains' (default, substring), 'startsWith' (prefix), or 'eq' (exact).",
          "default": "contains"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of cells to return (default 10, max 100).",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque continuation token from data.next_cursor. Repeat the same search controls when continuing."
        }
      },
      "required": [
        "query"
      ]
    },
    "label": [
      "IPD-IMGT/HLA",
      "HLA",
      "cell line",
      "reference cell",
      "immunogenetics",
      "EMBL-EBI"
    ],
    "test_examples": [
      {
        "query": "Roche",
        "field": "lab_of_origin",
        "limit": 3
      },
      {
        "query": "10839496",
        "field": "primary_name",
        "match": "eq"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cellid": {
                    "type": "string"
                  },
                  "primary_name": {
                    "type": "string"
                  },
                  "lab_of_origin": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The laboratory the cell line came from. Provenance, and the only field that attributes it."
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            },
            "total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "previous_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Page size applied to this call."
            }
          },
          "required": [
            "cells"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
