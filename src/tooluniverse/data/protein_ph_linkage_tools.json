[
  {
    "name": "Protein_calculate_pH_linkage",
    "type": "ProteinPHLinkageTool",
    "description": "Integrate matched bound/free protein pKas into reference-normalized pH linkage curves, with declared inventory, component and terminal breakdowns. Postprocessing only; no pKa prediction, absolute affinity or experimental validation.",
    "parameter": {
      "type": "object",
      "properties": {
        "bound_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "chain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Bound-state chain identity, also used for explicitly mapped free groups."
              },
              "residue_number": {
                "type": "integer"
              },
              "insertion_code": {
                "type": "string",
                "maxLength": 200,
                "description": "Explicit insertion code; use empty string when absent."
              },
              "group_type": {
                "type": "string",
                "enum": [
                  "ASP",
                  "GLU",
                  "HIS",
                  "LYS",
                  "ARG",
                  "CYS",
                  "TYR",
                  "N+",
                  "C-"
                ]
              },
              "pka": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "required": [
              "chain",
              "residue_number",
              "group_type",
              "pka"
            ]
          }
        },
        "free_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "chain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Bound-state chain identity, also used for explicitly mapped free groups."
              },
              "residue_number": {
                "type": "integer"
              },
              "insertion_code": {
                "type": "string",
                "maxLength": 200,
                "description": "Explicit insertion code; use empty string when absent."
              },
              "group_type": {
                "type": "string",
                "enum": [
                  "ASP",
                  "GLU",
                  "HIS",
                  "LYS",
                  "ARG",
                  "CYS",
                  "TYR",
                  "N+",
                  "C-"
                ]
              },
              "pka": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "required": [
              "chain",
              "residue_number",
              "group_type",
              "pka"
            ]
          }
        },
        "expected_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "chain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Bound-state chain identity, also used for explicitly mapped free groups."
              },
              "residue_number": {
                "type": "integer"
              },
              "insertion_code": {
                "type": "string",
                "maxLength": 200,
                "description": "Explicit insertion code; use empty string when absent."
              },
              "group_type": {
                "type": "string",
                "enum": [
                  "ASP",
                  "GLU",
                  "HIS",
                  "LYS",
                  "ARG",
                  "CYS",
                  "TYR",
                  "N+",
                  "C-"
                ]
              },
              "component": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Reaction component identity. Expand every molecular copy, including all receptor chains."
              }
            },
            "required": [
              "chain",
              "residue_number",
              "group_type",
              "component"
            ]
          }
        },
        "reference_kind": {
          "type": "string",
          "enum": [
            "independent_coordinates",
            "same_coordinate_components"
          ],
          "description": "Both modes use titrating pKas; same-coordinate means component extraction, never a frozen protonation state."
        },
        "ph_values": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 14
          },
          "minItems": 1,
          "maxItems": 20
        },
        "reference_ph": {
          "type": "number",
          "minimum": 0,
          "maximum": 14
        },
        "temperature_kelvin": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 200,
          "maximum": 400,
          "description": "Defaults to 298.15 K; used only to convert the conditional logarithmic trend to kcal/mol."
        },
        "provenance": {
          "type": "object",
          "properties": {
            "pka_method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "inventory_source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "reference_description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "pka_method",
            "inventory_source",
            "reference_description"
          ]
        }
      },
      "required": [
        "bound_groups",
        "free_groups",
        "expected_groups",
        "reference_kind",
        "ph_values",
        "reference_ph",
        "provenance"
      ]
    },
    "cacheable": false,
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "properties": {
                "curve": {
                  "type": "array",
                  "minItems": 1
                },
                "inventory": {
                  "type": "object"
                },
                "reference_kind": {
                  "type": "string"
                },
                "provenance": {
                  "type": "object"
                },
                "calculation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "binding_verified": {
                  "const": false
                },
                "pH_selectivity_verified": {
                  "const": false
                }
              },
              "required": [
                "curve",
                "inventory",
                "reference_kind",
                "provenance",
                "calculation_sha256",
                "binding_verified",
                "pH_selectivity_verified"
              ]
            }
          },
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "bound_groups": [
          {
            "chain": "A",
            "residue_number": 1,
            "group_type": "HIS",
            "pka": 7
          }
        ],
        "free_groups": [
          {
            "chain": "A",
            "residue_number": 1,
            "group_type": "HIS",
            "pka": 6
          }
        ],
        "expected_groups": [
          {
            "chain": "A",
            "residue_number": 1,
            "group_type": "HIS",
            "component": "binder"
          }
        ],
        "reference_kind": "independent_coordinates",
        "reference_ph": 6,
        "ph_values": [
          6,
          7
        ],
        "provenance": {
          "pka_method": "synthetic analytic control",
          "inventory_source": "declared one-site toy system",
          "reference_description": "independently specified one-site free reference"
        }
      }
    ]
  }
]
