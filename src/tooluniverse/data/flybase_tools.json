[
  {
    "name": "FlyBase_get_gene",
    "description": "Get detailed Drosophila melanogaster (fruit fly) gene information from FlyBase via the Alliance of Genome Resources. Returns gene symbol, name, synopsis, genomic location, synonyms, and cross-references. FlyBase is the primary database for Drosophila genetics. Example: 'FB:FBgn0003996' returns the white (w) gene with its function as an ABCG2-class transporter.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID with 'FB:' prefix. Examples: 'FB:FBgn0003996' (white/w), 'FB:FBgn0000490' (decapentaplegic/dpp), 'FB:FBgn0004647' (Notch/N), 'FB:FBgn0000546' (eyeless/ey), 'FB:FBgn0003731' (hedgehog/hh)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_detail"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "FB:FBgn0003996"
      },
      {
        "gene_id": "FB:FBgn0000490"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "species": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "short_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "data_provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "automated_gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "so_term": {
              "type": [
                "string",
                "null"
              ]
            },
            "genomic_location": {
              "type": "object",
              "properties": {
                "chromosome": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "start": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "assembly": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "strand": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "curie": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "secondary_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Retired accessions for the gene. Older literature cites these, and nothing else recovers them."
            },
            "cross_references_total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "xref_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cross_references_returned": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cross_references_truncated": {
              "type": "boolean"
            },
            "next_xref_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "notes": {
              "type": "array",
              "description": "Curator notes the model-organism database wrote about the gene",
              "items": {
                "type": "object",
                "properties": {
                  "note_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What kind of note this is, as the source database classifies it"
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The note's text"
                  }
                }
              }
            },
            "reference_curies": {
              "type": "array",
              "description": "Publication curies for the gene. Alliance lists thousands for a well-studied gene, so this is capped; reference_curies_total is the true count."
            },
            "reference_curies_total": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many publications Alliance links to the gene"
            },
            "reference_curies_returned": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many are carried on this response"
            },
            "reference_curies_truncated": {
              "type": "boolean",
              "description": "True when reference_curies is a prefix of the full list"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "FlyBase_get_gene_orthologs",
    "description": "Get orthologs of a Drosophila gene across other species from the Alliance of Genome Resources. Returns orthologous genes in human, mouse, zebrafish, worm, yeast, and other model organisms with prediction method details and best-score indicators. Essential for translational research from fly models to human disease genes. Example: 'FB:FBgn0004647' (Notch) returns orthologs including human NOTCH1-4.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID with 'FB:' prefix. Examples: 'FB:FBgn0004647' (Notch/N), 'FB:FBgn0003996' (white/w), 'FB:FBgn0000546' (eyeless/ey)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of orthologs to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        },
        "stringency": {
          "type": "string",
          "description": "Stringency filter for orthology calls: 'stringent' (high confidence) or 'moderate'. Default: 'stringent'."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_orthologs"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "FB:FBgn0004647",
        "limit": 10
      },
      {
        "gene_id": "FB:FBgn0000546",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_best_score": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_best_score_reverse": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "method_count": {
                "type": "integer"
              },
              "methods_not_matched": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ortholog prediction methods that did NOT support the call, which is what makes method_count interpretable"
              },
              "stringency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which stringency band this ortholog row satisfies. The request asks for a stringency and the rows did not say what each one met."
              },
              "subject_taxon_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_taxon_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "FlyBase_get_gene_alleles",
    "description": "Get alleles and variants for a Drosophila gene from FlyBase via the Alliance of Genome Resources. Returns allele symbols, categories (insertion, point mutation, etc.), associated phenotypes, disease annotations, and variant details including genomic coordinates. Example: 'FB:FBgn0000490' (dpp) returns alleles like dpp[MI03752] with variant location and molecular consequence.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID with 'FB:' prefix. Examples: 'FB:FBgn0003996' (white/w), 'FB:FBgn0000490' (dpp), 'FB:FBgn0004647' (Notch/N)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of alleles to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_alleles"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "FB:FBgn0000490",
        "limit": 5
      },
      {
        "gene_id": "FB:FBgn0003996",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "symbol_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "has_disease": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_phenotype": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The variant's id"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The variant's genomic HGVS"
                    },
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "e.g. point_mutation, deletion"
                    },
                    "location": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "chromosome": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "hgvs": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "most_severe_consequence": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The most severe predicted consequence"
                    }
                  }
                },
                "description": "The allele's variants. variants_total says how many it has; the list is cut to three."
              },
              "alliance_curie": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The curie Alliance's own endpoints take, which differs from the source database's primary id"
              },
              "synonyms": {
                "type": "array"
              },
              "alteration_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "variants_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many variants the record has, as opposed to how many are carried"
              },
              "variants_returned": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many variants are carried on this response"
              },
              "variants_truncated": {
                "type": "boolean",
                "description": "True when the variant list is a prefix"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "FlyBase_get_gene_expression",
    "description": "Get expression annotations for a Drosophila gene from the Alliance of Genome Resources. Returns per-annotation records of developmental stage (whenExpressed) and anatomical location (whereExpressed) for the gene, plus the total annotation count. Example: 'FB:FBgn0000490' (dpp) has 317 expression annotations such as 'embryonic stage 14' in 'abdominal transverse muscle cell'. Useful for understanding when and where a fly gene is expressed.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID, with or without the 'FB:' prefix. Examples: 'FB:FBgn0000490' (dpp), 'FB:FBgn0003996' (white/w), 'FB:FBgn0004647' (Notch/N)."
        },
        "limit": {
          "type": "integer",
          "description": "Max annotations to return (default 50, max 100).",
          "default": 50
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based annotation page. Continue with next_page while has_more is true."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_expression_summary"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "FB:FBgn0000490",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_annotations": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "page": {
              "type": "integer"
            },
            "total_pages": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_page": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "data_provider": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "FlyBase_get_gene_interactions",
    "description": "Get molecular or genetic interactions for a Drosophila gene from the Alliance of Genome Resources. Molecular interactions are physical protein-protein interactions. Genetic interactions are phenotype-based (suppression, enhancement, etc.). Returns interacting gene pairs with species and interaction type. Example: 'FB:FBgn0000490' (dpp) has 169 genetic interactions including genetic suppression with anchor.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID with 'FB:' prefix. Examples: 'FB:FBgn0003996' (white/w), 'FB:FBgn0000490' (dpp), 'FB:FBgn0004647' (Notch/N)."
        },
        "interaction_type": {
          "type": "string",
          "description": "Type of interaction: 'molecular' (physical PPI) or 'genetic' (phenotype-based). Default: 'molecular'."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of interactions to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_interactions"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "FB:FBgn0000490",
        "interaction_type": "genetic",
        "limit": 5
      },
      {
        "gene_id": "FB:FBgn0003996",
        "interaction_type": "molecular",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interactor_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interactor_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interactor_species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interaction_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "relation": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The association's own relation, e.g. genetically_interacts_with"
              },
              "subject_role": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "MI ontology id, e.g. MI:0582"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "The queried gene's part in the interaction, e.g. 'suppressed gene'. Without it an interaction type names a pair but not a direction."
              },
              "interactor_role": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "MI ontology id, e.g. MI:0582"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "The partner gene's part, e.g. 'suppressor gene'"
              },
              "subject_type": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "MI ontology id, e.g. MI:0582"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "Interactor type of the queried gene, e.g. 'gene', 'protein'"
              },
              "interactor_type": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "MI ontology id, e.g. MI:0582"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "Interactor type of the partner"
              },
              "interaction_source": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "MI ontology id, e.g. MI:0582"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "The database that asserted the interaction, e.g. MI:0478 flybase"
              },
              "references": {
                "type": "array",
                "description": "The publications behind this interaction. Empty when Alliance reports none.",
                "items": {
                  "type": "object",
                  "properties": {
                    "agr_curie": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Alliance reference curie"
                    },
                    "pubmed_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "e.g. PMID:29735293"
                    },
                    "mod_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The model-organism database's own reference id, e.g. FB:FBrf0238983"
                    },
                    "citation": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Short citation, e.g. 'Wang XC (2018) Eur J Cell Biol 97(4):308-317'"
                    },
                    "cross_references": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Every curie Alliance cross-references, DOI included"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "FlyBase_get_gene_disease_models",
    "description": "Get disease models involving a Drosophila gene from the Alliance of Genome Resources. Drosophila is a powerful model organism for human disease research. Returns genotype-based disease models with associated human disease names and Disease Ontology IDs. Example: 'FB:FBgn0000490' (dpp) has 946 disease model entries including models for ALS, Parkinson's disease, and other neurodegenerative conditions.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "FlyBase gene ID with 'FB:' prefix. Examples: 'FB:FBgn0000490' (dpp), 'FB:FBgn0004647' (Notch/N), 'FB:FBgn0003996' (white/w)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of disease models to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
