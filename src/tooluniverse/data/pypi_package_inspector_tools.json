[
  {
    "type": "PyPIPackageInspector",
    "name": "PyPIPackageInspector",
    "description": "Extracts comprehensive package information from PyPI and GitHub for quality evaluation. Provides detailed metrics on popularity (downloads, stars, forks), maintenance (release frequency, recent activity), documentation quality, Python version compatibility, and security indicators. Returns an overall quality score (0-100) with breakdown by category.",
    "parameter": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "description": "Name of the Python package to inspect on PyPI (e.g., 'requests', 'numpy', 'pandas')"
        },
        "include_github": {
          "type": "boolean",
          "description": "Whether to fetch GitHub repository statistics (stars, forks, issues, last push). Requires package to have GitHub URL in metadata.",
          "default": true
        },
        "include_downloads": {
          "type": "boolean",
          "description": "Whether to fetch download statistics from pypistats.org (downloads per day/week/month)",
          "default": true
        }
      },
      "required": [
        "package_name"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "description": "Name of the inspected package"
        },
        "pypi_metadata": {
          "type": "object",
          "description": "Complete PyPI metadata including version, author, license, dependencies, release history",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "author": {
              "type": [
                "string",
                "null"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ]
            },
            "requires_python": {
              "type": [
                "string",
                "null"
              ]
            },
            "github_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_releases": {
              "type": [
                "integer",
                "null"
              ]
            },
            "days_since_last_release": {
              "type": [
                "integer",
                "null"
              ]
            },
            "releases_last_year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "author_email": {
              "type": [
                "string",
                "null"
              ],
              "description": "Author and contact as PyPI records it, e.g. 'Kenneth Reitz <me@kennethreitz.org>'."
            },
            "package_url": {
              "type": [
                "string",
                "null"
              ],
              "description": "The package's PyPI page, e.g. https://pypi.org/project/requests/."
            },
            "release_url": {
              "type": [
                "string",
                "null"
              ],
              "description": "The inspected release's page, e.g. https://pypi.org/project/requests/2.34.2/."
            },
            "project_urls": {
              "description": "Links the maintainer declared, keyed by label - Documentation, Source, Changelog. How a caller reaches the repository or the docs."
            },
            "latest_release_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the latest release was published, ISO 8601. The first thing to check before depending on a package."
            },
            "requires_dist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Declared dependencies with their version constraints, e.g. ['charset_normalizer<4,>=2']."
            },
            "classifiers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "PyPI trove classifiers, e.g. ['Development Status :: 5 - Production/Stable']. They carry the maturity and the supported Python versions."
            },
            "has_wheel": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether a wheel is published. Without one, installing needs a build toolchain."
            },
            "has_source": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether an sdist is published."
            },
            "description_length": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Length of the long description in characters. One of the inputs to the quality score, so it is here to make that score checkable."
            }
          }
        },
        "download_stats": {
          "type": "object",
          "description": "Download statistics from pypistats.org",
          "properties": {
            "downloads_last_day": {
              "type": [
                "integer",
                "null"
              ]
            },
            "downloads_last_week": {
              "type": [
                "integer",
                "null"
              ]
            },
            "downloads_last_month": {
              "type": [
                "integer",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why the download figures are missing or partial, when they are. Null when they are complete."
            }
          }
        },
        "github_stats": {
          "type": "object",
          "description": "GitHub repository statistics",
          "properties": {
            "stars": {
              "type": [
                "integer",
                "null"
              ]
            },
            "forks": {
              "type": [
                "integer",
                "null"
              ]
            },
            "open_issues": {
              "type": [
                "integer",
                "null"
              ]
            },
            "days_since_last_push": {
              "type": [
                "integer",
                "null"
              ]
            },
            "archived": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "The repository's one-line description, e.g. 'A simple, yet elegant, HTTP library.'"
            },
            "language": {
              "type": [
                "string",
                "null"
              ],
              "description": "GitHub's primary language for the repository."
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "description": "Licence GitHub detected, e.g. 'Apache License 2.0'. It can differ from the PyPI metadata's licence, and the difference is worth seeing."
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the repository was created, ISO 8601."
            },
            "updated_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the repository record last changed, ISO 8601 - metadata as well as code."
            },
            "pushed_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When code was last pushed, ISO 8601. This is the activity date; updated_at moves for things that are not commits."
            },
            "default_branch": {
              "type": [
                "string",
                "null"
              ],
              "description": "Default branch name, e.g. 'main'."
            },
            "watchers": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Watcher count, e.g. 1345."
            },
            "has_issues": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the issue tracker is enabled - if not, there is nowhere to report a bug."
            },
            "has_wiki": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the wiki is enabled."
            },
            "has_pages": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether GitHub Pages is enabled."
            },
            "disabled": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when GitHub has disabled the repository."
            }
          }
        },
        "quality_scores": {
          "type": "object",
          "description": "Comprehensive quality scores (0-100 scale)",
          "properties": {
            "overall_score": {
              "type": "integer",
              "description": "Weighted overall quality score combining all dimensions"
            },
            "popularity_score": {
              "type": "integer",
              "description": "Based on downloads, stars, forks, and release count"
            },
            "maintenance_score": {
              "type": "integer",
              "description": "Based on recent releases, GitHub activity, and update frequency"
            },
            "documentation_score": {
              "type": "integer",
              "description": "Based on docs URL, description length, and classifiers"
            },
            "compatibility_score": {
              "type": "integer",
              "description": "Based on wheel availability, Python version support"
            },
            "security_score": {
              "type": "integer",
              "description": "Based on license, maintenance status, and issue management"
            }
          }
        },
        "recommendation": {
          "type": "string",
          "description": "Human-readable recommendation with reasoning"
        },
        "error": {
          "type": "string",
          "description": "Error message if inspection failed"
        }
      },
      "required": [
        "package_name"
      ]
    },
    "test_examples": [
      {
        "package_name": "requests",
        "include_github": true,
        "include_downloads": true
      },
      {
        "package_name": "numpy"
      },
      {
        "package_name": "pandas",
        "include_github": false,
        "include_downloads": false
      }
    ],
    "metadata": {
      "tags": [
        "package-inspection",
        "pypi",
        "quality-metrics",
        "package-evaluation"
      ],
      "difficulty_level": "intermediate",
      "estimated_execution_time": "3-10 seconds",
      "api_dependencies": [
        "PyPI",
        "pypistats.org",
        "GitHub API"
      ],
      "version": "1.0.0",
      "author": "ToolUniverse Team",
      "use_cases": [
        "Evaluate package quality before adding as dependency",
        "Compare alternative packages for similar functionality",
        "Monitor package health and maintenance status",
        "Generate package quality reports for documentation"
      ]
    }
  }
]
