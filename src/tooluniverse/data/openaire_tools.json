[
  {
    "type": "OpenAIRETool",
    "name": "OpenAIRE_search_publications",
    "description": "Search OpenAIRE publications, datasets, or software with recoverable one-based pagination. Page size is 1-1000 and page * max_results must be <=10000. total_results is exact; accessible_results and upstream_truncated disclose the API's 10,000-result window.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for OpenAIRE research products. Use keywords to search across titles, abstracts, and metadata."
        },
        "max_results": {
          "type": "integer",
          "description": "Results per page (1-1000). Out-of-range values are rejected rather than silently clamped.",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        },
        "page": {
          "type": "integer",
          "description": "One-based page. OpenAIRE requires page * max_results <= 10000; continue with next_page while has_more is true.",
          "default": 1,
          "minimum": 1
        },
        "type": {
          "type": "string",
          "description": "Type of research product to search: 'publications', 'datasets', or 'software'. Default is 'publications'.",
          "default": "publications",
          "enum": [
            "publications",
            "datasets",
            "software"
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "total_results": {
              "type": [
                "integer",
                "number"
              ]
            },
            "results": {
              "type": "array"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "machine learning",
        "max_results": 2,
        "type": "publications"
      },
      {
        "query": "climate change",
        "max_results": 1,
        "type": "datasets"
      },
      {
        "query": "bioinformatics",
        "max_results": 1,
        "type": "software"
      }
    ]
  },
  {
    "type": "OpenAIRETool",
    "name": "OpenAIRE_search_projects",
    "description": "Search OpenAIRE funded projects/grants with recoverable one-based pagination. Page size is 1-1000, page * max_results must be <=10000, and metadata distinguishes exact total_results from the first 10,000 accessible matches. Returns grant code, title, funder, funding stream, dates, amounts, currency, and website.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Keyword(s) to search project titles, acronyms, and metadata (e.g., 'cancer', 'machine learning', 'graphene')."
        },
        "max_results": {
          "type": "integer",
          "description": "Projects per page (1-1000). OpenAIRE exposes at most the first 10,000 matches.",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        },
        "page": {
          "type": "integer",
          "description": "One-based page. page * max_results must not exceed 10000.",
          "default": 1,
          "minimum": 1
        },
        "type": {
          "type": "string",
          "description": "Must be 'projects' for this tool.",
          "default": "projects",
          "enum": [
            "projects"
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "total_results": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": "integer"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "acronym": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "funder": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "funder_shortname": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "funding_stream": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "start_date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end_date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "funded_amount": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "total_cost": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "website": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Which aggregator the row came from, e.g. 'OpenAIRE'."
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The kind of OpenAIRE entity the row is, e.g. 'projects'. Constant for this tool; it exists because the same row shape is used for publications and datasets."
                  }
                }
              }
            },
            "accessible_results": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many of the matches OpenAIRE will actually serve, e.g. 10000 -- against total_results of 338854 on the measured query. OpenAIRE's API caps deep paging, so this, not total_results, is the number of projects that can be retrieved."
            },
            "has_more": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when a further page exists, e.g. true."
            },
            "next_page": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The page number to request next, e.g. 2. Null when there is none."
            },
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Which page this reply is, 1-based, e.g. 1."
            },
            "page_size": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many results per page were requested, e.g. 1."
            },
            "total_results_is_exact": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when total_results is an exact count rather than a lower bound, e.g. true."
            },
            "upstream_truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when OpenAIRE itself cut the result set, e.g. true. Set when total_results exceeds accessible_results."
            },
            "warning": {
              "type": [
                "string",
                "null"
              ],
              "description": "The limit OpenAIRE discloses about the query. Measured value: 'OpenAIRE reports more than 10,000 matches, but its API only allows the first 10,000 results for a query.' Any count derived by paging this search is bounded by that cap, not by the real total."
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Short description of what went wrong, e.g. 'Network/API error calling OpenAIRE'. Present only on this branch; the success branch has no `error` key at all."
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "The underlying exception text behind `error`, e.g. \"HTTPSConnectionPool(host='api.openaire.eu', port=443): Read timed out. (read timeout=20)\". This is what distinguishes a transient timeout, which is worth retrying, from a rejected query, which is not."
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "cancer",
        "max_results": 1,
        "type": "projects"
      },
      {
        "query": "graphene",
        "max_results": 2,
        "type": "projects"
      }
    ]
  }
]
