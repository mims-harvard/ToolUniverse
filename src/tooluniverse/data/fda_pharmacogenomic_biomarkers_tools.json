[
  {
    "name": "fda_pharmacogenomic_biomarkers",
    "type": "FDAPharmacogenomicBiomarkersTool",
    "description": "Retrieve the FDA Table of Pharmacogenomic Biomarkers in Drug Labeling, optionally filtered by drug or biomarker. Results are recoverably paginated: start with offset=0 and continue with next_offset while has_more is true. count is the complete filtered-row count.",
    "parameter": {
      "type": "object",
      "properties": {
        "drug_name": {
          "type": "string",
          "description": "Filter by the name of the drug (e.g., 'Sivextro', 'Abacavir'). Case-insensitive partial match."
        },
        "biomarker": {
          "type": "string",
          "description": "Filter by the specific biomarker (e.g., 'CYP2D6', 'HLA-B*5701'). Case-insensitive partial match."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results to return.",
          "default": 10
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based filtered-row offset. Continue with next_offset while has_more is true.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "count": {
          "type": [
            "integer",
            "number"
          ]
        },
        "shown": {
          "type": [
            "integer",
            "number"
          ]
        },
        "offset": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": ["integer", "null"]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Drug": {
                "type": "string"
              },
              "TherapeuticArea": {
                "type": "string"
              },
              "Biomarker": {
                "type": "string"
              },
              "LabelingSection": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "drug_name": "Warfarin"
      },
      {
        "biomarker": "CYP2C9"
      }
    ]
  }
]
