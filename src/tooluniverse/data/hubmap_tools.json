[
  {
    "name": "HuBMAP_search_datasets",
    "description": "Search HuBMAP published datasets by organ, assay type, or free text. Supports Elasticsearch-style offset pagination: while has_more is true, pass next_offset as offset to retrieve the next page. Reports total, returned, offset, limit, and next_offset. Organ codes include LK=Left Kidney, RK=Right Kidney, HT=Heart, LV=Liver, LU=Lung, BR=Brain, and others from HuBMAP_list_organs.",
    "parameter": {
      "type": "object",
      "properties": {
        "organ": {
          "type": "string",
          "description": "Organ code to filter by (e.g., 'LK' for left kidney, 'HT' for heart, 'LV' for liver, 'LU' for lung, 'BR' for brain, 'SP' for spleen). Use HuBMAP_list_organs to see all codes."
        },
        "dataset_type": {
          "type": "string",
          "description": "Filter by assay/data type (e.g., 'RNAseq', 'CODEX', 'MALDI', 'snATACseq', 'LC-MS', 'scRNAseq-10xGenomics-v3')"
        },
        "query": {
          "type": "string",
          "description": "Free text search across title, description, and anatomy fields"
        },
        "status": {
          "type": "string",
          "description": "Dataset status filter. Default: 'Published'",
          "default": "Published"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-50, default 10)",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based result offset. Omit for the first page; use next_offset for subsequent pages.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": []
    },
    "fields": {
      "operation": "search_datasets"
    },
    "type": "HuBMAPTool",
    "test_examples": [
      {
        "organ": "LK",
        "limit": 3
      },
      {
        "dataset_type": "RNAseq",
        "organ": "SP",
        "limit": 3
      },
      {
        "query": "kidney",
        "limit": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer"
                },
                "returned": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                },
                "has_more": {
                  "type": "boolean"
                },
                "next_offset": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "datasets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hubmap_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "dataset_type": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "organ": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "group_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "anatomy": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "doi_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "data_types": {
                        "type": [
                          "array",
                          "null"
                        ]
                      },
                      "donor_sex": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "donor_age": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HuBMAP_list_organs",
    "description": "List all organs available in the HuBMAP (Human BioMolecular Atlas Program) atlas. Returns organ names, codes (for use in HuBMAP_search_datasets), UBERON ontology IDs, and CUI codes. HuBMAP maps 43 organs including kidney, heart, liver, lung, brain, spleen, intestine, skin, and more.",
    "parameter": {
      "type": "object",
      "properties": {},
