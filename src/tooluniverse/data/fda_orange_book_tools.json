  {
    "type": "FDAOrangeBookTool",
    "name": "FDA_OrangeBook_check_generic_availability",
    "description": "Check whether FDA-approved generic applications exist for a brand or ingredient. Scans every matching Drugs@FDA page. Generic means application_number starts with ANDA; reference means at least one product has reference_drug='Yes'. Returns these defining criteria, applications_scanned, and counts_complete so the classification is auditable.",
    "parameter": {
      "type": "object",
      "required": [],
      "properties": {
        "operation": {
          "const": "check_generic_availability",
          "description": "Operation type (fixed)",
          "default": "check_generic_availability"
        },
        "brand_name": {
          "type": "string",
          "description": "Brand name to check for generics"
        },
        "generic_name": {
          "type": "string",
          "description": "Generic name to check"
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "reference_drugs": {
          "type": "array"
        },
        "reference_count": {
          "type": "integer"
        },
        "generic_drugs": {
          "type": "array"
        },
        "generic_count": {
          "type": "integer"
        },
        "generics_available": {
          "type": "boolean"
        },
        "applications_scanned": {
          "type": "integer"
        },
        "counts_complete": {
          "type": "boolean"
        },
        "classification_criteria": {
          "type": "object"
        }
      }
    },
    "test_examples": [
      {
        "brand_name": "ADVIL"
      }
    ],
    "fields": {
      "operation": "check_generic_availability"
    }
  },
