[
  {
    "type": "FDAOrangeBookTool",
    "name": "FDA_OrangeBook_search_drug",
    "description": "Search FDA Drugs@FDA database by brand name, generic name, or application number. Returns approval status, products, and basic regulatory info. Example: brand_name='ADVIL' finds all Advil products with NDA numbers. A query that matches nothing returns status='success' with count=0 and an explanatory note -- an 'error' status means the request itself failed, never that there were no matches. Results use native openFDA pagination: start with offset=0 and continue with next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "required": [],
      "properties": {
        "operation": {
          "const": "search_drug",
          "description": "Operation type (fixed)",
          "default": "search_drug"
        },
        "brand_name": {
          "type": "string",
          "description": "Brand/trade name of drug (e.g., 'ADVIL', 'LIPITOR')"
        },
        "generic_name": {
          "type": "string",
          "description": "Generic/active ingredient name (e.g., 'IBUPROFEN', 'ATORVASTATIN')"
        },
        "drug_name": {
          "type": "string",
          "description": "Drug name of either kind when you do not know whether it is a brand or a generic name (e.g., 'QUVIVIQ', 'IBUPROFEN'). Matches the brand name OR the active-ingredient name. Prefer brand_name or generic_name when you know which one you have."
        },
        "application_number": {
          "type": "string",
          "description": "FDA application number (e.g., 'NDA020402', 'ANDA078394')"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-100, default 10)",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based Drugs@FDA result offset. Continue with next_offset while has_more is true.",
          "minimum": 0,
          "maximum": 25000,
          "default": 0
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "drugs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "application_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sponsor_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identifiers": {
                "type": "object",
                "description": "The codes a Drugs@FDA record is joined to the rest of the world by: NDC product and package codes, RxCUI, UNII, the SPL set id, the substance and manufacturer names. Without the NDCs an approval cannot be matched to a billing claim or a shortage notice; without the SPL set id, not to the label."
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "product_number": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "brand_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "active_ingredients": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "dosage_form": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "route": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "marketing_status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "te_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reference_drug": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reference_standard": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Whether this is the product generics are tested against, which is not the same as reference_drug"
                    }
                  }
                }
              },
              "original_approval_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "When the ORIG submission was approved, as YYYYMMDD. Drugs@FDA sends the submission history with every search result, and the search rows carried none of it -- so 'a generic exists' could not be told from 'a generic was approved in 2015'."
              },
              "original_approval_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "'AP' for approved, 'TA' for tentative approval"
              },
              "submission_count": {
                "type": "integer",
                "description": "How many submissions the application has; see FDA_OrangeBook_get_approval_history for them"
              },
              "latest_submission_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "count": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "description": "Present only when count=0, explaining that the query matched no Drugs@FDA records (an empty result, not a failure)."
        },
        "returned": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "test_examples": [
      {
        "brand_name": "ADVIL",
        "limit": 5
      }
    ],
    "fields": {
      "operation": "search_drug"
    }
  },
