[
  {
    "type": "FDAOrangeBookTool",
    "name": "FDA_OrangeBook_search_drug",
    "description": "Search FDA Drugs@FDA database by brand name, generic name, or application number. Returns approval status, products, and basic regulatory info. Example: brand_name='ADVIL' finds all Advil products with NDA numbers. A query that matches nothing returns status='success' with count=0 and an explanatory note -- an 'error' status means the request itself failed, never that there were no matches. Results use native openFDA pagination: start with offset=0 and continue with next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "required": [],
      "properties": {
        "operation": {
          "const": "search_drug",
          "description": "Operation type (fixed)",
          "default": "search_drug"
        },
        "brand_name": {
          "type": "string",
          "description": "Brand/trade name of drug (e.g., 'ADVIL', 'LIPITOR')"
        },
        "generic_name": {
          "type": "string",
          "description": "Generic/active ingredient name (e.g., 'IBUPROFEN', 'ATORVASTATIN')"
        },
        "drug_name": {
          "type": "string",
          "description": "Drug name of either kind when you do not know whether it is a brand or a generic name (e.g., 'QUVIVIQ', 'IBUPROFEN'). Matches the brand name OR the active-ingredient name. Prefer brand_name or generic_name when you know which one you have."
        },
        "application_number": {
          "type": "string",
          "description": "FDA application number (e.g., 'NDA020402', 'ANDA078394')"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-100, default 10)",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based Drugs@FDA result offset. Continue with next_offset while has_more is true.",
          "minimum": 0,
          "maximum": 25000,
          "default": 0
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "drugs": {
          "type": "array"
        },
        "count": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "description": "Present only when count=0, explaining that the query matched no Drugs@FDA records (an empty result, not a failure)."
        },
        "returned": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "test_examples": [
      {
        "brand_name": "ADVIL",
        "limit": 5
      }
    ],
    "fields": {
      "operation": "search_drug"
    }
  },
  {
    "type": "FDAOrangeBookTool",
    "name": "FDA_OrangeBook_get_approval_history",
    "description": "Get complete approval history for a drug application including original approval date, supplements, and review documents. Returns submission timeline and links to approval letters/labels. Example: NDA020402 shows all Advil approval actions.",
    "parameter": {
      "type": "object",
      "required": [
        "application_number"
      ],
      "properties": {
        "operation": {
          "const": "get_approval_history",
          "description": "Operation type (fixed)",
          "default": "get_approval_history"
        },
        "application_number": {
          "type": "string",
          "description": "FDA application number (e.g., 'NDA020402')"
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "application_number": {
          "type": "string"
        },
        "sponsor_name": {
          "type": "string"
        },
        "original_approval_date": {
          "type": "string"
        },
        "submissions": {
          "type": "array"
        },
        "submission_count": {
          "type": "integer"
        }
      }
    },
    "test_examples": [
      {
        "application_number": "NDA020402"
      }
    ],
    "fields": {
      "operation": "get_approval_history"
    }
  },
  {
    "type": "FDAOrangeBookTool",
    "name": "FDA_OrangeBook_get_patent_info",
    "description": "Get the patents FDA lists in the Orange Book for a drug product: patent number, expiration date, drug substance/drug product flags, every patent use code, delist request and submission date, per product. Reads FDA's monthly Orange Book data files from a local copy: download the zip from https://www.fda.gov/drugs/drug-approvals-and-databases/orange-book-data-files and set TOOLUNIVERSE_ORANGE_BOOK_DATA to the zip or its extracted folder; returns an error when it is not set. The file date is returned in source.files_dated. Search by application_number (e.g. 'NDA021695', 'N021695' or '021695') or exact brand_name. Covers NDA/ANDA drug products, not biologics. Use for patent expiry and generic entry questions. For product details and marketing status without local data files, use FDA_OrangeBook_search_drug; for therapeutic equivalence codes, use FDA_OrangeBook_get_te_code.",
    "parameter": {
      "type": "object",
      "required": [],
      "properties": {
        "operation": {
          "const": "get_patent_info",
          "description": "Operation type (fixed)",
          "default": "get_patent_info"
        },
        "application_number": {
          "type": "string",
          "description": "FDA application number, e.g. NDA021695, N021695 or 021695"
        },
        "brand_name": {
          "type": "string",
          "description": "Brand (trade) name of the drug, exact match, case-insensitive"
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "application_number": {
                "type": "string"
              },
              "product_number": {
                "type": "string"
              },
              "trade_name": {
                "type": "string"
              },
              "ingredient": {
                "type": "string"
              },
              "strength": {
                "type": "string"
              },
              "applicant": {
                "type": "string"
              },
              "marketing_category": {
                "type": "string"
              },
              "patents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "patent_number": {
                      "type": "string"
                    },
                    "expiration_date": {
                      "type": "string"
                    },
                    "pediatric_extension": {
                      "type": "boolean"
                    },
                    "drug_substance": {
                      "type": "boolean"
                    },
                    "drug_product": {
                      "type": "boolean"
                    },
                    "use_codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "delist_requested": {
                      "type": "boolean"
                    },
                    "submission_date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "count": {
          "type": "integer"
        },
        "patent_count": {
          "type": "integer"
        },
        "source": {
          "type": "object",
          "description": "FDA Orange Book data files used, with their file date",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "page": {
              "type": "string"
            },
            "files_dated": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "test_examples": [
      {
        "application_number": "NDA021695"
      }
    ],
    "fields": {
      "operation": "get_patent_info"
    }
  },
