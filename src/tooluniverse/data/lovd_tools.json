[
    {
        "name": "LOVD_get_gene",
        "description": "Get a complete LOVD gene record after normalizing the HGNC symbol to uppercase and verifying the returned symbol. Returns HGNC/Entrez IDs, chromosome and coordinates, RefSeq transcripts/build, curation details, and dates. Malformed or non-JSON responses are explicit errors.",
        "parameter": {
            "type": "object",
            "properties": {
                "gene_symbol": {
                    "type": "string",
                    "minLength": 1,
                    "description": "HGNC gene symbol (e.g., 'TP53', 'BRCA1', 'BRCA2', 'EGFR')."
                }
            },
            "required": ["gene_symbol"]
        },
        "fields": {
            "operation": "get_gene"
        },
        "type": "LOVDTool",
        "test_examples": [
            {
                "gene_symbol": "TP53"
            },
            {
                "gene_symbol": "BRCA2"
            }
        ],
        "return_schema": {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "hgnc_id": {"type": "integer"},
                "entrez_id": {"type": "integer"},
                "symbol": {"type": "string"},
                "name": {"type": "string"},
                "chromosome": {"type": "string"},
                "chromosome_location": {"type": "string"},
                "position_start": {"type": "string"},
                "position_end": {"type": "string"},
                "refseq_genomic": {"type": "string"},
                "refseq_mrna": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "refseq_build": {"type": "string"},
                "created_by": {"type": "string"},
                "created_date": {"type": "string"},
                "curators": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "updated_date": {"type": "string"}
            }
        }
    },
    {
        "name": "LOVD_get_variants",
        "description": "Get the full unpaginated LOVD variant response for a gene. Every record's gene symbol and Variant/DNA structure are validated; metadata reports the returned count, completeness basis, and symbol verification. Live TP53 currently returns 880 curated records, including repeated DBIDs when LOVD exposes distinct reports.",
        "parameter": {
            "type": "object",
            "properties": {
                "gene_symbol": {
                    "type": "string",
                    "minLength": 1,
                    "description": "HGNC gene symbol (e.g., 'TP53', 'BRCA1')."
                }
            },
            "required": ["gene_symbol"]
        },
        "fields": {
            "operation": "get_variants"
        },
        "type": "LOVDTool",
        "test_examples": [
            {
                "gene_symbol": "TP53"
            }
        ],
        "return_schema": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "symbol": {"type": "string"},
                    "id": {"type": "string"},
                    "position_mRNA": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "position_genomic": {"type": "object"},
                    "variant_genomic": {"type": "object"},
                    "variants_on_transcripts": {"type": "object"},
                    "Variant/DNA": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "Variant/DBID": {"type": "string"},
                    "Times_reported": {"type": "string"},
                    "owned_by": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "created_by": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "created_date": {"type": "string"},
                    "edited_date": {"type": "string"}
                }
            }
        }
    },
    {
        "name": "LOVD_search_variants",
        "description": "Search LOVD variants by exactly one DBID or HGVS DNA notation. The wrapper verifies every returned DBID/DNA value and gene symbol. LOVD's HTTP 404 plus empty array for a valid no-match filter is normalized to a successful empty result, distinct from a malformed response. RefSeq-prefixed returned DNA values are matched to the requested suffix.",
        "parameter": {
            "type": "object",
            "properties": {
                "gene_symbol": {
                    "type": "string",
                    "minLength": 1,
                    "description": "HGNC gene symbol (e.g., 'TP53', 'BRCA1')."
                },
                "variant_dbid": {
                    "type": "string",
                    "minLength": 1,
                    "description": "LOVD variant DBID (e.g., 'TP53_010464'). Unique identifier assigned by LOVD."
                },
                "dna_notation": {
                    "type": "string",
                    "minLength": 1,
                    "description": "HGVS DNA notation without RefSeq prefix (e.g., 'c.*2609C>A', 'c.742C>T'). Use coding 'c.' notation."
                }
            },
            "required": ["gene_symbol"],
            "oneOf": [
                {"required": ["variant_dbid"]},
                {"required": ["dna_notation"]}
            ]
        },
        "fields": {
            "operation": "search_variants"
        },
        "type": "LOVDTool",
        "test_examples": [
            {
                "gene_symbol": "TP53",
                "variant_dbid": "TP53_010464"
            },
            {
                "gene_symbol": "TP53",
                "dna_notation": "c.*2609C>A"
            }
        ],
        "return_schema": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "symbol": {"type": "string"},
                    "id": {"type": "string"},
                    "position_mRNA": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "position_genomic": {"type": "object"},
                    "variant_genomic": {"type": "object"},
                    "variants_on_transcripts": {"type": "object"},
                    "Variant/DNA": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "Variant/DBID": {"type": "string"},
                    "Times_reported": {"type": "string"}
                }
            }
        }
    }
]
