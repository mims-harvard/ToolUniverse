[
  {
    "type": "DataGovTool",
    "name": "DataGov_search_datasets",
    "description": "Search the US federal open data catalog using its current cursor-based JSON API. Each response contains the service's fixed 20-result page and all distributions for each dataset. Continue with next_after as the after parameter while has_more is true. The current API does not expose a total-hit count, so total_count is null.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search keywords for dataset discovery. Searches across dataset titles, descriptions, and tags."
        },
        "organization": {
          "type": ["string", "null"],
          "description": "Optional CKAN organization slug to filter by federal agency. Examples: 'epa-gov', 'cdc-gov', 'usda-gov', 'nih-gov', 'census-gov', 'noaa-gov', 'nasa-gov', 'nsf-gov', 'doe-gov', 'hhs-gov'. Leave null to search all agencies.",
          "default": null
        },
        "rows": {
          "type": "integer",
          "description": "Deprecated compatibility parameter; the current Data.gov API ignores page-size parameters and always returns up to 20 datasets. Use after for lossless pagination.",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        },
        "after": {
          "type": ["string", "null"],
          "description": "Opaque cursor returned as next_after by the previous response. Omit for the first page.",
          "default": null
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "description": "Data.gov dataset search results (inside the data wrapper)",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query that was executed"
        },
        "organization": {
          "type": ["string", "null"],
          "description": "Organization filter applied, or null"
        },
        "total_count": {
          "type": ["integer", "null"],
          "description": "Total matches when supplied by Data.gov; currently null because the cursor API omits totals"
        },
        "returned": {
          "type": "integer",
          "description": "Number of datasets returned in this response"
        },
        "page_size": {
          "type": "integer",
          "description": "Fixed page size used by the current Data.gov API"
        },
        "after": {
          "type": ["string", "null"],
          "description": "Cursor used for this request"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_after": {
          "type": ["string", "null"],
          "description": "Opaque cursor for the next page"
        },
        "datasets": {
          "type": "array",
          "description": "List of matching datasets",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Dataset title"
              },
              "description": {
                "type": ["string", "null"],
                "description": "Dataset description/notes"
              },
              "organization": {
                "type": ["string", "null"],
                "description": "Publishing organization name"
              },
              "organization_title": {
                "type": ["string", "null"],
                "description": "Human-readable organization title"
              },
              "metadata_modified": {
                "type": ["string", "null"],
                "description": "Last modification date (ISO format)"
              },
              "tags": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Dataset tags/keywords"
              },
              "resources": {
                "type": "array",
                "description": "Download links and resource files",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": ["string", "null"]},
                    "url": {"type": ["string", "null"]},
                    "format": {"type": ["string", "null"]},
                    "description": {"type": ["string", "null"]}
                  }
                }
              },
              "resource_count": {
                "type": "integer",
                "description": "Number of distributions returned for this dataset"
              },
              "url": {
                "type": ["string", "null"],
                "description": "Dataset page URL on Data.gov"
              }
            }
          }
        }
      },
      "required": ["query", "total_count", "returned", "page_size", "has_more", "next_after", "datasets"]
    },
    "test_examples": [
      {
        "query": "air quality monitoring",
        "organization": "epa-gov",
        "rows": 3
      },
      {
        "query": "dietary iron intake survey",
        "rows": 3
      },
      {
        "query": "census population demographics",
        "organization": "census-gov",
        "rows": 2
      }
    ]
  }
]
