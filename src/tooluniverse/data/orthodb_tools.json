[
  {
    "name": "OrthoDB_search_groups",
    "description": "Search for orthologous groups by gene/protein name in OrthoDB v12 with server-backed offset pagination. OrthoDB catalogs orthologous groups at different taxonomic levels. metadata/data total_groups uses OrthoDB's authoritative count (not the API's fixed 100-record window); continue with next_offset while has_more is true. Every bare search ID is enriched through /tab; each record exposes enrichment_status, and metadata.group_enrichment reports any per-group failure instead of silently presenting a bare ID as complete.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene or protein name to search. Examples: 'BRCA1', 'TP53', 'insulin', 'EGFR'."
        },
        "species": {
          "type": [
            "integer",
            "null"
          ],
          "description": "NCBI taxonomy ID to filter by species. Examples: 9606 (human), 10090 (mouse), 7227 (fly). Null for all species."
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Taxonomic level for group definition. Examples: 7742 (Vertebrata), 33208 (Metazoa), 2759 (Eukaryota). Null for all levels."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Page size (1-50). Default: 10."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based result offset. Default 0; continue with data.next_offset."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search"
    },
    "type": "OrthoDBTool",
    "test_examples": [
      {
        "query": "BRCA1",
        "species": 9606,
        "limit": 5
      },
      {
        "query": "insulin",
        "level": 7742,
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query used"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "string",
                    "description": "OrthoDB group ID (e.g., '727649at7742')"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Group name, when the per-group /tab enrichment completed"
                  },
                  "level_taxid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Taxonomic level ID"
                  },
                  "enrichment_status": {
                    "type": "string",
                    "enum": ["complete", "unavailable"],
                    "description": "Whether name and level metadata were successfully retrieved from OrthoDB /tab"
                  },
                  "enrichment_error": {
                    "type": ["string", "null"],
                    "description": "Explicit reason enrichment was unavailable; absent on complete records"
                  }
                }
              },
              "description": "Orthologous groups matching query"
            },
            "total_groups": {
              "type": "integer",
              "description": "Total groups found"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OrthoDB_get_group_details",
    "description": "Get detailed information about an OrthoDB v12 orthologous group using the current group schema. Returns all GO annotations across biological-process, cellular-component, molecular-function, and unclassified buckets; all InterPro domains and legacy KEGG annotations; plus EC numbers, functional categories, phyletic profile, evolutionary rate, and gene architecture. metadata.annotation_counts makes completeness explicit.",
    "parameter": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "OrthoDB group ID. Format: 'numberATtaxid'. Examples: '727649at7742' (Vertebrata level), '59506at9443' (Primates level). Get IDs from OrthoDB_search_groups."
        }
      },
      "required": [
        "group_id"
      ]
    },
    "fields": {
      "endpoint": "group"
    },
    "type": "OrthoDBTool",
    "test_examples": [
      {
        "group_id": "727649at7742"
      },
      {
        "group_id": "59506at9443",
        "species": "9606",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "OrthoDB group ID"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Group consensus name"
            },
            "level_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Taxonomic level name (Vertebrata, Metazoa, etc.)"
            },
            "tax_id": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Taxonomic level ID"
            },
            "go_terms": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "description": "GO term annotations"
            },
            "kegg_pathways": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "description": "KEGG pathway associations"
            },
            "interpro_domains": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "description": "InterPro domain annotations"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OrthoDB_get_orthologs",
    "description": "Get orthologous genes from an OrthoDB group, optionally filtered by species, with local offset pagination over the API's first 5,000 records. Continue with next_offset while has_more is true. metadata.total_is_lower_bound explicitly warns when the upstream 5,000-record window is exhausted.",
    "parameter": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "OrthoDB group ID. Format: 'numberATtaxid'. Get IDs from OrthoDB_search_groups."
        },
        "species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Comma-separated NCBI taxonomy IDs to filter. Examples: '9606' (human only), '9606,10090' (human+mouse). Null for all species."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum ortholog records per page (default 100, max 1000)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset in the fetched ortholog list. Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "group_id"
      ]
    },
    "fields": {
      "endpoint": "orthologs"
    },
    "type": "OrthoDBTool",
    "test_examples": [
      {
        "group_id": "727649at7742",
        "species": "9606"
      },
      {
        "group_id": "59506at9443"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "description": "OrthoDB group ID"
            },
            "orthologs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ortholog group ID"
                  },
                  "group_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Group name"
                  },
                  "level_taxid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Taxonomic level"
                  },
                  "organism_taxid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Organism taxonomy ID"
                  },
                  "organism_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Organism scientific name"
                  },
                  "gene_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene identifier"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene/protein description"
                  }
                }
              },
              "description": "Orthologous genes in the requested page"
            },
            "total_orthologs": {
              "type": "integer",
              "description": "Total orthologs in the fetched upstream window"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "organisms_summary": {
              "type": "object",
              "description": "Count of genes per organism"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OrthoDB_get_group_fasta",
    "description": "Retrieve a resumable structured page of member protein sequences for an OrthoDB orthologous group, optionally restricted to a species. data.total_sequences is the exact number parsed from the downloaded FASTA; continue with next_offset while has_more is true. The legacy data.fasta field remains the complete raw FASTA and metadata.fasta_contains_all_sequences makes that scope explicit.",
    "parameter": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "OrthoDB orthologous group ID, e.g. '794361at2759' (BRCA2 at Eukaryota level). Obtain from OrthoDB_search_groups."
        },
        "species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional NCBI taxon ID to restrict members to one species, e.g. '9606' (human), '10090' (mouse). Leave empty for all member species."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 500,
          "description": "Structured page size (default: 50, max: 500). The full raw FASTA is always returned in the 'fasta' field."
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Zero-based structured sequence offset. Continue with data.next_offset."
        }
      },
      "required": [
        "group_id"
      ]
    },
    "fields": {
      "endpoint": "fasta"
    },
    "type": "OrthoDBTool",
    "test_examples": [
      {
        "group_id": "794361at2759",
        "species": "9606"
      },
      {
        "group_id": "794361at2759",
        "species": "10090",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "sequences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "string"
                  },
                  "length": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "pub_gene_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "og_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "organism_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "organism_taxid": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pub_og_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_sequences": {
              "type": [
                "integer",
                "number"
              ]
            },
            "fasta": {
              "type": "string"
            }
          },
          "required": [
            "group_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
