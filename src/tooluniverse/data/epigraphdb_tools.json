  {
    "name": "EpiGraphDB_get_literature_evidence",
    "description": "Get SemMedDB literature triple evidence supporting a GWAS trait via EpiGraphDB, with recoverable offset pagination. Returns subject-predicate-object triples mined from PubMed and linked to GWAS hits, each citing a supporting article (pubmed_id). Continue with next_offset while has_more is true. Because the upstream endpoint does not return an exact match count, total_count is null until the final page is reached. Example: trait='body mass index' returns more than 1,000 supporting rows at pval_threshold=1e-4.",
    "parameter": {
      "type": "object",
      "properties": {
        "trait": {
          "type": "string",
          "description": "GWAS trait name (e.g., 'body mass index', 'LDL cholesterol', 'coronary heart disease'). Matched case-insensitively as a substring of GWAS labels."
        },
        "pval_threshold": {
          "type": "number",
          "description": "GWAS p-value threshold for the trait's GWAS hits (default 1e-8).",
          "default": 1e-08
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Number of literature evidence rows per page (1-1000; default 100)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based row offset. Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "trait"
      ]
    },
    "fields": {
      "operation": "literature_evidence"
    },
    "type": "EpiGraphDBTool",
    "test_examples": [
      {
        "trait": "body mass index"
      },
      {
        "trait": "body mass index",
        "pval_threshold": 1e-08
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literature_triples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "triple_subject": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "triple_predicate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "triple_object": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pubmed_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gwas_trait": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
