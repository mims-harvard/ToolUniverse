  {
    "name": "EpiGraphDB_search_gene",
    "description": "Search for gene information in EpiGraphDB by gene symbol or Ensembl ID. Returns gene metadata including druggability classification, chromosomal location, and gene type. Fuzzy name search supports up to the upstream maximum of 200 rows but the source exposes no offset; when a page is full, truncated=true and total_found=null warn that more matches may exist. Use an exact Ensembl gene_id or narrow the name in that case.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gene symbol to search for (e.g., 'BRCA1', 'TP53', 'EGFR'). Either gene_name or gene_id required."
        },
        "gene_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ensembl gene ID (e.g., 'ENSG00000012048'). Either gene_name or gene_id required."
        },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Maximum results to return (default 10, upstream max 200). A full fuzzy-name page is marked truncated because the upstream endpoint has no offset.",
          "default": 10
        }
      },
      "required": []
    },
    "fields": {
      "operation": "gene_search"
