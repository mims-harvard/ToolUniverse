[
  {
    "name": "EpiGraphDB_get_mendelian_randomization",
    "description": "Get Mendelian Randomization (MR) evidence using IEU OpenGWAS data with recoverable offset pagination. Provide exposure_trait, outcome_trait, or both: a single trait retrieves all MR edges in that direction, while both constrain the relationship. Returns MR estimates (beta, SE, p-value) from multiple instruments/methods. Continue with next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "exposure_trait": {
          "type": "string",
          "description": "GWAS trait name for the exposure (e.g., 'Body mass index', 'LDL cholesterol', 'Type 2 diabetes'). Use EpiGraphDB_search_opengwas to find exact trait names."
        },
        "outcome_trait": {
          "type": "string",
          "description": "GWAS trait name for the outcome (e.g., 'Coronary heart disease', 'Stroke', 'Alzheimer disease'). Use EpiGraphDB_search_opengwas to find exact trait names."
        },
        "pval_threshold": {
          "type": "number",
          "description": "P-value threshold for instrument selection (default 1e-5).",
          "default": 1e-05
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 50,
          "description": "Number of MR results per page (1-1000; default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based MR result offset. Continue with next_offset while has_more is true."
        }
      },
      "anyOf": [
        {
          "required": [
            "exposure_trait"
          ]
        },
        {
          "required": [
            "outcome_trait"
          ]
        }
      ]
    },
    "fields": {
      "operation": "mr"
    },
    "type": "EpiGraphDBTool",
    "test_examples": [
      {
        "exposure_trait": "Body mass index",
        "outcome_trait": "Coronary heart disease",
        "pval_threshold": 1e-05
      },
      {
        "exposure_trait": "LDL cholesterol",
        "outcome_trait": "Coronary heart disease",
        "pval_threshold": 1e-05
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mr_results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exposure_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exposure_trait": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outcome_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outcome_trait": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "beta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "se": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pval": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "moescore": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "returned_count": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "EpiGraphDB",
      "Mendelian Randomization",
      "GWAS",
      "Causal Inference"
    ],
    "metadata": {
      "tags": [
        "mendelian_randomization",
        "causal_inference",
        "gwas",
        "epidemiology"
      ],
      "estimated_execution_time": "5-15 seconds"
    }
