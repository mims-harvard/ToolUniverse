      "type": "object",
      "properties": {
        "trait": {
          "type": "string",
          "description": "GWAS risk factor trait name (e.g., 'LDL cholesterol', 'Body mass index', 'C-reactive protein', 'Systolic blood pressure')."
        },
        "pval_threshold": {
          "type": "number",
          "description": "GWAS p-value threshold for gene-trait associations (default 1e-4).",
          "default": 0.0001
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 30,
          "description": "Number of unique drugs per page (1-500; default 30)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into evidence-ranked unique drugs."
        }
      },
      "required": [
        "trait"
