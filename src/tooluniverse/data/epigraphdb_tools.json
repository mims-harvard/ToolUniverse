  {
    "name": "EpiGraphDB_get_genetic_correlations",
    "description": "Get strong genetic correlations (|rg| > 0.8) between a GWAS trait and other traits with recoverable offset pagination. total_count, has_more, and next_offset expose the complete result set. NOTE: the graph is sparse and exact-label sensitive; an empty result means no strong-rg edge in this graph, not no shared genetics. Genetic correlation is NOT causal evidence. Example traits with data: 'Waist circumference', 'Hip circumference', 'Body fat percentage'.",
    "parameter": {
      "type": "object",
      "properties": {
        "trait": {
          "type": "string",
          "description": "Exact, case-sensitive GWAS trait label (e.g., 'Waist circumference', 'Hip circumference'). Many labels have no node in the sparse genetic-correlation graph and return empty."
        },
        "pval_threshold": {
          "type": "number",
          "description": "Accepted for compatibility but NOT applied — the endpoint always returns the fixed |rg| > 0.8 set.",
          "default": 0.05
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Number of correlations per page (1-500; default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based correlation offset. Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "trait"
      ]
    },
    "fields": {
      "operation": "genetic_cor"
    },
    "type": "EpiGraphDBTool",
    "test_examples": [
      {
        "trait": "Waist circumference"
      },
      {
        "trait": "Hip circumference"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "correlations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "trait1_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trait1_trait": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trait2_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trait2_trait": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rg": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "rg_pval": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "returned": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {
              "type": ["integer", "null"]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "EpiGraphDB",
      "GWAS",
      "Genetic Correlation"
    ],
    "metadata": {
      "tags": [
        "genetic_correlation",
        "gwas",
        "shared_genetics",
        "epidemiology"
      ],
      "estimated_execution_time": "5-15 seconds"
    }
  },
  {
    "name": "EpiGraphDB_get_drugs_for_trait",
    "description": "Find drugs that target genes associated with a GWAS risk factor trait, ranked by supporting evidence and exposed through recoverable offset pagination. unique_drug_count is the full total; continue with next_offset while has_more is true. Example: 'LDL cholesterol' returns hundreds of genetically supported drug candidates.",
