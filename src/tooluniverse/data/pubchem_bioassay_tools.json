  {
    "name": "PubChemBioAssay_get_concise_activity_table",
    "description": "Get the assay-wide concise bioactivity table for a PubChem BioAssay, one row per tested compound with SID/CID, outcome, activity value/name, and target identifiers. Large assays can contain hundreds of thousands of rows; use max_rows/row_offset and continue with next_row_offset while has_more is true. total_rows is exact because PubChem returns the full table in one call.",
    "parameter": {
      "type": "object",
      "properties": {
        "aid": {
          "type": "integer",
          "description": "PubChem BioAssay ID (AID). Examples: 504832 (malaria qHTS, 305803 rows), 1259393 (TSHR counter screen)."
        },
        "max_rows": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of compound rows to return in the payload (default 1000, max 100000). total_rows always reports the true full count regardless of this cap."
        },
        "row_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset in the complete assay table. Continue with data.next_row_offset."
        }
      },
      "required": [
        "aid"
      ]
    },
    "fields": {
      "endpoint": "concise_activity_table"
    },
    "type": "PubChemBioAssayTool",
    "test_examples": [
      {
        "aid": 1259393,
        "max_rows": 50
      },
      {
        "aid": 504832,
        "max_rows": 20
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "aid": {
              "type": [
                "integer",
                "string"
              ],
              "description": "Assay ID"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Column headers (AID, SID, CID, Activity Outcome, Target Accession, Target GeneID, Activity Value [uM], Activity Name, ...)"
            },
            "total_rows": {
              "type": "integer",
              "description": "Total number of compound rows in the assay (full count, not capped)"
            },
            "returned_rows": {
              "type": "integer",
              "description": "Number of rows actually returned in this payload"
            },
            "row_offset": {
              "type": "integer"
            },
            "max_rows": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_row_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Per-compound rows keyed by column header. Each row maps each column name to its cell value (SID, CID, Activity Outcome, Activity Value [uM], etc.)."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
