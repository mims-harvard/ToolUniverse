[
    {
        "name": "TogoID_convert",
        "description": "Convert up to 50 biological identifiers between directly related TogoID datasets. Unlike TogoID's flattened multi-ID response, this wrapper performs identity-verified per-input conversion and returns complete input-to-output mappings, explicit unmapped IDs, association counts, and a compatibility union of unique targets. Unrelated dataset pairs return a no-route error. Call TogoID_list_datasets for current names.",
        "parameter": {"type": "object", "properties": {
            "ids": {"type": "string", "minLength": 1, "description": "One to 50 unique source identifiers, comma-separated, in the source dataset's native format."},
            "source": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_]+$", "description": "Source TogoID dataset name, e.g. 'ensembl_gene', 'ncbigene', 'uniprot', 'pubchem_compound', 'hgnc'."},
            "target": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_]+$", "description": "Target TogoID dataset name, e.g. 'uniprot', 'hgnc', 'chebi', 'pdb', 'ensembl_transcript'."}
        }, "required": ["ids", "source", "target"], "additionalProperties": false},
        "fields": {"timeout": 30},
        "type": "TogoIDConvertTool",
        "test_examples": [
            {"ids": "ENSG00000139618", "source": "ensembl_gene", "target": "uniprot"},
            {"ids": "675", "source": "ncbigene", "target": "hgnc"},
            {"ids": "2244", "source": "pubchem_compound", "target": "chebi"}
        ],
        "return_schema": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    },
    {
        "name": "TogoID_list_datasets",
        "description": "List the current TogoID identifier datasets and preserve each complete upstream configuration record, including label, category, catalog, validation regex, annotations, examples, and URI prefixes. Optionally filter by an exact case-insensitive category; unknown categories return an explicit error with valid choices.",
        "parameter": {"type": "object", "properties": {
            "category": {"type": "string", "minLength": 1, "description": "Optional category filter, e.g. 'Gene', 'Protein', 'Compound', 'Disease', 'Pathway', 'Variant'."}
        }, "required": [], "additionalProperties": false},
        "fields": {"timeout": 30},
        "type": "TogoIDDatasetsTool",
        "test_examples": [{"category": "Compound"}, {"category": "Gene"}, {}],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    }
]
