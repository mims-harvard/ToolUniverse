[
  {
    "name": "SRA_search_experiments",
    "description": "Search the NCBI Sequence Read Archive (SRA) for sequencing experiments by keyword, organism, strategy, or platform. Use the zero-based start offset and next_start while has_more is true to retrieve all matching experiments. Run arrays parsed from each NCBI summary are no longer post-truncated to 10.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search keywords (e.g., 'human gut metagenome', 'BRCA1 RNA-Seq', 'single cell lung cancer')"
        },
        "organism": {
          "type": "string",
          "description": "Organism name to filter by (e.g., 'Homo sapiens', 'Mus musculus', 'human gut metagenome')"
        },
        "library_strategy": {
          "type": "string",
          "description": "Sequencing strategy filter (e.g., 'RNA-Seq', 'WGS', 'WXS', 'ChIP-Seq', 'ATAC-seq', 'Bisulfite-Seq', 'AMPLICON')"
        },
        "platform": {
          "type": "string",
          "description": "Sequencing platform filter (e.g., 'ILLUMINA', 'PACBIO_SMRT', 'OXFORD_NANOPORE', 'ION_TORRENT')"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum results to return (1-50, default 10)",
          "default": 10
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based SRA search offset. Continue with next_start while has_more is true."
        }
      },
      "required": []
    },
    "fields": {
      "operation": "search"
    },
    "type": "SRATool",
    "test_examples": [
      {"query": "BRCA1", "organism": "Homo sapiens", "library_strategy": "RNA-Seq", "limit": 3},
      {"organism": "human gut metagenome", "limit": 3},
      {"query": "single cell kidney", "platform": "ILLUMINA", "limit": 3}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "total": {"type": "integer"},
                "returned": {"type": "integer"},
                "start": {
                  "type": "integer"
                },
                "has_more": {
                  "type": "boolean"
                },
                "next_start": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "query_used": {"type": "string"},
                "experiments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uid": {"type": "string"},
                      "title": {"type": ["string", "null"]},
                      "organism": {"type": ["string", "null"]},
                      "taxid": {"type": ["string", "null"]},
                      "platform": {"type": ["string", "null"]},
                      "library_strategy": {"type": ["string", "null"]},
                      "library_source": {"type": ["string", "null"]},
                      "library_layout": {"type": ["string", "null"]},
                      "total_runs": {"type": ["string", "null"]},
                      "total_spots": {"type": ["string", "null"]},
                      "total_bases": {"type": ["string", "null"]},
                      "experiment_accession": {"type": ["string", "null"]},
                      "study_accession": {"type": ["string", "null"]},
                      "bioproject": {"type": ["string", "null"]},
                      "submitter": {"type": ["string", "null"]},
                      "runs": {"type": ["array", "null"]},
                      "runs_returned": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "runs_complete": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "metadata": {"type": "object"}
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {"type": "string"}
          },
          "required": ["error"]
        }
      ]
    }
  },
  {
    "name": "SRA_get_experiment",
    "description": "Get detailed metadata for the first NCBI SRA record matching an accession. Returns the complete run array present in that record's eSummary plus runs_returned and runs_complete. For study/sample accessions with multiple experiment records, use SRA_search_experiments to enumerate them rather than assuming this single-record lookup represents the whole study.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "SRA accession number (e.g., 'SRX26927637', 'SRP000001', 'SRS000001')"
        }
      },
      "required": ["accession"]
    },
    "fields": {
      "operation": "get_experiment"
    },
    "type": "SRATool",
    "test_examples": [
      {"accession": "SRX515811"}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "uid": {"type": "string"},
                "title": {"type": ["string", "null"]},
                "organism": {"type": ["string", "null"]},
                "taxid": {"type": ["string", "null"]},
                "platform": {"type": ["string", "null"]},
                "library_strategy": {"type": ["string", "null"]},
                "library_source": {"type": ["string", "null"]},
                "library_selection": {"type": ["string", "null"]},
                "library_layout": {"type": ["string", "null"]},
                "total_runs": {"type": ["string", "null"]},
                "total_spots": {"type": ["string", "null"]},
                "total_bases": {"type": ["string", "null"]},
                "experiment_accession": {"type": ["string", "null"]},
                "study_accession": {"type": ["string", "null"]},
                "study_name": {"type": ["string", "null"]},
                "bioproject": {"type": ["string", "null"]},
                "submitter": {"type": ["string", "null"]},
                "runs": {"type": ["array", "null"]},
                "runs_returned": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "runs_complete": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "metadata": {"type": "object"}
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {"type": "string"}
          },
          "required": ["error"]
        }
      ]
    }
  }
]
