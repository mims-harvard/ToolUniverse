[
  {
    "name": "iNaturalist_search_taxa",
    "description": "Search iNaturalist taxa with exact total and page continuation. Page-based access is limited to 10,000 ranked matches; refine broad searches when metadata.upstream_truncated is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for taxon name (scientific or common). Examples: 'Panthera tigris', 'monarch butterfly', 'redwood', 'Homo sapiens', 'blue whale'."
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 10,
          "description": "Number of results to return per page (1-200, default 10)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based results page (default 1). iNaturalist exposes at most the first 10,000 matching records through this endpoint."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_taxa"
    },
    "type": "INaturalistTool",
    "test_examples": [
      {
        "query": "Panthera tigris"
      },
      {
        "query": "monarch butterfly",
        "per_page": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "iNaturalist taxon ID"
              },
              "name": {
                "type": "string",
                "description": "Scientific name"
              },
              "common_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Preferred common name"
              },
              "rank": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxonomic rank (species, genus, family, etc.)"
              },
              "observations_count": {
                "type": "integer",
                "description": "Total research-grade observations"
              },
              "is_active": {
                "type": "boolean",
                "description": "Whether taxon is currently accepted"
              },
              "conservation_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The headline status code alone; read conservation_status_detail for the authority"
              },
              "wikipedia_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Link to Wikipedia article"
              },
              "conservation_status_detail": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The status code or category as the authority words it"
                  },
                  "authority": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Who issued it, e.g. NatureServe or IUCN Red List - 'G4' is a NatureServe rank, not an IUCN category"
                  },
                  "iucn_code": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "iNaturalist's numeric IUCN equivalence code"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Any note on the status"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The authority's page for the status"
                  },
                  "place_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "iNaturalist place id, null for a global status"
                  },
                  "place_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Place the status applies to, null when global"
                  }
                },
                "description": "The headline status with the authority that issued it and the place it applies to"
              },
              "conservation_statuses": {
                "type": "array",
                "description": "The regional statuses beside the headline one, capped at metadata.statuses_per_taxon. Danaus plexippus has 29",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The status code or category as the authority words it"
                    },
                    "authority": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Who issued it, e.g. NatureServe or IUCN Red List - 'G4' is a NatureServe rank, not an IUCN category"
                    },
                    "iucn_code": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "iNaturalist's numeric IUCN equivalence code"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Any note on the status"
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The authority's page for the status"
                    },
                    "place_id": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "iNaturalist place id, null for a global status"
                    },
                    "place_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Place the status applies to, null when global"
                    }
                  }
                }
              },
              "conservation_status_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many statuses the response carried"
              },
              "extinct": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether iNaturalist records the taxon as extinct"
              },
              "iconic_taxon_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "iNaturalist's broad group, e.g. Insecta"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "iNaturalist_get_taxon",
    "description": "Get detailed taxonomy information for a species by its iNaturalist taxon ID. Returns scientific name, common names, full taxonomic lineage (kingdom through species), observation count, conservation status, and Wikipedia link. Use iNaturalist_search_taxa first to find taxon IDs. Example: taxon 41482 returns Tursiops truncatus (bottlenose dolphin) with 19000+ observations.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "type": "integer",
          "description": "iNaturalist taxon ID. Examples: 41482 (bottlenose dolphin), 43584 (Homo sapiens), 41944 (Panthera tigris), 48662 (monarch butterfly), 47126 (Sequoia sempervirens)."
        }
      },
      "required": [
        "taxon_id"
      ]
    },
    "fields": {
      "endpoint": "get_taxon"
    },
    "type": "INaturalistTool",
    "test_examples": [
      {
        "taxon_id": 41482
      },
      {
        "taxon_id": 43584
      }
    ],
    "return_schema": {
      "oneOf": [
