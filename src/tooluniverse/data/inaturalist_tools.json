  {
    "name": "iNaturalist_search_observations",
    "description": "Search iNaturalist observations by taxon/name, place, and quality, ordered by observation ID descending. Use metadata.next_page within the 10,000-result page window, or page=1 with metadata.next_id_below for sliding-window traversal beyond 10,000 records.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "iNaturalist taxon ID to filter by. Examples: 41482 (bottlenose dolphin), 41944 (tiger), 48662 (monarch butterfly)."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text search for species name. Alternative to taxon_id."
        },
        "quality_grade": {
          "type": "string",
          "enum": [
            "research",
            "needs_id",
            "casual"
          ],
          "default": "research",
          "description": "Observation quality: 'research' (community-verified), 'needs_id' (unverified), or 'casual'. Default: 'research'."
        },
        "place_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "iNaturalist place ID to filter by location. Example: 10211 (Yellowstone National Park)."
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 10,
          "description": "Number of results per page (1-200, default 10)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based results page (default 1). iNaturalist exposes at most the first 10,000 matching records through this endpoint."
        },
        "id_below": {
          "type": "integer",
          "minimum": 1,
          "description": "Sliding-window cursor. Set page=1 and pass metadata.next_id_below from the previous response to continue beyond the 10,000-result page limit."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "search_observations"
    },
    "type": "INaturalistTool",
    "test_examples": [
      {
        "taxon_id": 41482,
        "quality_grade": "research",
        "per_page": 5
      },
      {
        "query": "Panthera tigris",
        "per_page": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "Observation ID"
              },
              "species_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Scientific name of observed species"
              },
              "common_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common name"
              },
              "observed_on": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Date of observation (YYYY-MM-DD)"
              },
              "place_guess": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Location description"
              },
              "latitude": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "GPS latitude"
              },
              "longitude": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "GPS longitude"
              },
              "quality_grade": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Observation quality grade"
              },
              "user": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Observer username"
              },
              "photo_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "URL of observation photo"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "iNaturalist_get_species_counts",
    "description": "Get species observation counts from iNaturalist for a given taxon group or location. Returns a ranked list of species by number of observations, showing which species are most frequently observed. Useful for biodiversity assessments, understanding species abundance, and identifying common species in an area. Example: species counts for Delphinidae (taxon 41479) returns bottlenose dolphin, common dolphin, etc. ranked by observations.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Parent taxon ID to get species counts within. Examples: 41479 (Delphinidae - dolphins), 41944 (Panthera - big cats), 47126 (Sequoioideae - redwoods)."
        },
        "place_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Place ID to filter by location. Example: 10211 (Yellowstone)."
        },
        "quality_grade": {
          "type": "string",
          "enum": [
            "research",
            "needs_id",
            "casual"
          ],
          "default": "research",
          "description": "Quality filter: 'research', 'needs_id', or 'casual'. Default: 'research'."
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Number of species to return per page (1-500, default 20)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based results page (default 1). iNaturalist exposes at most the first 10,000 matching records through this endpoint."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "species_counts"
    },
    "type": "INaturalistTool",
    "test_examples": [
      {
        "taxon_id": 41479,
        "quality_grade": "research",
        "per_page": 10
      },
      {
        "taxon_id": 41944,
        "per_page": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taxon_id": {
                "type": "integer",
                "description": "iNaturalist taxon ID"
              },
              "name": {
                "type": "string",
                "description": "Scientific name"
              },
              "common_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common name"
              },
              "rank": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxonomic rank"
              },
              "count": {
                "type": "integer",
                "description": "Number of observations"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
