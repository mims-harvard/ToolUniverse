[
    {
        "name": "EPA_search_tri_facilities",
        "description": "Search EPA TRI facilities by US state and optional city. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results comes from the exact Envirofacts count endpoint.",
        "parameter": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "description": "2-letter US state code, e.g. 'CA', 'TX'."
                },
                "city": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional city name filter, e.g. 'Los Angeles'."
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Max facilities per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": [
                "state"
            ]
        },
        "fields": {
            "timeout": 30
        },
        "type": "EPATRIFacilitiesTool",
        "test_examples": [
            {
                "state": "CA",
                "city": "Sacramento",
                "limit": 5
            },
            {
                "state": "TX",
                "limit": 3
            },
            {
                "state": "NY",
                "limit": 3
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "tri_facility_id": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "EPA TRI facility identifier."
                            },
                            "facility_name": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "The facility's name."
                            },
                            "street_address": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Street address."
                            },
                            "city": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "City."
                            },
                            "county": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "County."
                            },
                            "state": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "State."
                            },
                            "zip_code": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "ZIP code."
                            },
                            "epa_region": {
                                "type": [
                                    "integer",
                                    "string",
                                    "null"
                                ],
                                "description": "Which EPA region it falls in."
                            },
                            "closed": {
                                "type": [
                                    "boolean",
                                    "string",
                                    "null"
                                ],
                                "description": "Whether the facility has closed. A closed facility still has historical releases on record."
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            ]
        }
    },
    {
        "name": "EPA_search_frs_facilities",
        "description": "Search EPA Facility Registry Service sites by US state and optional city. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results is exact.",
        "parameter": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "description": "2-letter US state code, e.g. 'MA', 'CA'."
                },
                "city": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional city name filter."
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Max facilities per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": [
                "state"
            ]
        },
        "fields": {
            "timeout": 30
        },
        "type": "EPAFRSFacilitiesTool",
        "test_examples": [
            {
                "state": "MA",
                "limit": 5
            },
            {
                "state": "CA",
                "city": "Oakland",
                "limit": 3
            },
            {
                "state": "WA",
                "limit": 3
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "registry_id": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "EPA Facility Registry Service id -- the key that joins a facility across EPA's programmes."
                            },
                            "facility_name": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Its name."
                            },
                            "address": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Street address."
                            },
                            "city": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "City."
                            },
                            "state": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "State."
                            },
                            "federal_facility": {
                                "type": [
                                    "boolean",
                                    "string",
                                    "null"
                                ],
                                "description": "Whether it is a federal facility."
                            },
                            "tribal_land": {
                                "type": [
                                    "boolean",
                                    "string",
                                    "null"
                                ],
                                "description": "Whether it sits on tribal land, which changes which authority regulates it."
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            ]
        }
    },
    {
        "name": "EPA_get_tri_facility_chemical_releases",
        "description": "Get per-chemical, per-year EPA TRI reporting forms for one facility. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results is exact.",
        "parameter": {
            "type": "object",
            "properties": {
                "tri_facility_id": {
                    "type": "string",
                    "description": "EPA TRI facility identifier, e.g. '15902CCKRN75BRI'. Obtain from EPA_search_tri_facilities."
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Max reporting forms per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": [
                "tri_facility_id"
            ]
        },
        "fields": {
            "timeout": 30,
            "table": "tri_reporting_form",
            "lookup_column": "tri_facility_id",
            "lookup_param": "tri_facility_id",
            "row_kind": "reporting_form"
        },
        "type": "EPATRIFacilitiesTool",
        "test_examples": [
            {
                "tri_facility_id": "15902CCKRN75BRI",
                "limit": 3
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "tri_facility_id": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "tri_chem_id": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "chemical_name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "reporting_year": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "form_type": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "max_amount_code": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "doc_ctrl_num": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "EPA's document control number for the submitted TRI form, e.g. '1300140000011'. The key back to the filing itself."
                            },
                            "federal_facility": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "'1' when the site is a federal facility, '0' otherwise -- a STRING, not a boolean."
                            },
                            "one_time_release_qty": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "description": "Quantity released in a one-off event, in the form's units, e.g. 0. Separate from routine releases, so a spill does not inflate the annual trend."
                            },
                            "production_ratio": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "description": "This year's production or activity divided by last year's, e.g. 1.25. Releases must be read against it: a rise of 25% in releases alongside a production_ratio of 1.25 is flat intensity, not a worsening."
                            },
                            "trade_secret": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "'1' when the submitter claimed trade secret protection, '0' otherwise, as a STRING. A claimed trade secret means the reported quantities may be withheld or sanitised."
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            ]
        }
    }
]
