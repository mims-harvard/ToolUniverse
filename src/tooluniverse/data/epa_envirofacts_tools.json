[
    {
        "name": "EPA_search_tri_facilities",
        "description": "Search EPA TRI facilities by US state and optional city. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results comes from the exact Envirofacts count endpoint.",
        "parameter": {
            "type": "object",
            "properties": {
                "state": {"type": "string", "description": "2-letter US state code, e.g. 'CA', 'TX'."},
                "city": {"type": ["string", "null"], "description": "Optional city name filter, e.g. 'Los Angeles'."},
                "limit": {
                    "type": ["integer", "null"],
                    "description": "Max facilities per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": ["state"]
        },
        "fields": {"timeout": 30},
        "type": "EPATRIFacilitiesTool",
        "test_examples": [{"state": "CA", "city": "Sacramento", "limit": 5}, {"state": "TX", "limit": 3}, {"state": "NY", "limit": 3}],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    },
    {
        "name": "EPA_search_frs_facilities",
        "description": "Search EPA Facility Registry Service sites by US state and optional city. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results is exact.",
        "parameter": {
            "type": "object",
            "properties": {
                "state": {"type": "string", "description": "2-letter US state code, e.g. 'MA', 'CA'."},
                "city": {"type": ["string", "null"], "description": "Optional city name filter."},
                "limit": {
                    "type": ["integer", "null"],
                    "description": "Max facilities per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": ["state"]
        },
        "fields": {"timeout": 30},
        "type": "EPAFRSFacilitiesTool",
        "test_examples": [{"state": "MA", "limit": 5}, {"state": "CA", "city": "Oakland", "limit": 3}, {"state": "WA", "limit": 3}],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    },
    {
        "name": "EPA_get_tri_facility_chemical_releases",
        "description": "Get per-chemical, per-year EPA TRI reporting forms for one facility. Results use native Envirofacts pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. metadata.total_results is exact.",
        "parameter": {
            "type": "object",
            "properties": {
                "tri_facility_id": {"type": "string", "description": "EPA TRI facility identifier, e.g. '15902CCKRN75BRI'. Obtain from EPA_search_tri_facilities."},
                "limit": {
                    "type": ["integer", "null"],
                    "description": "Max reporting forms per page (default 10, max 100)."
                },
                "offset": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "default": 0,
                    "minimum": 0,
                    "description": "Zero-based row offset; continue with metadata.next_offset."
                }
            },
            "required": ["tri_facility_id"]
        },
        "fields": {"timeout": 30, "table": "tri_reporting_form", "lookup_column": "tri_facility_id", "lookup_param": "tri_facility_id", "row_kind": "reporting_form"},
        "type": "EPATRIFacilitiesTool",
        "test_examples": [{"tri_facility_id": "15902CCKRN75BRI", "limit": 3}],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tri_facility_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tri_chem_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "chemical_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reporting_year": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "form_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "max_amount_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    }
]
