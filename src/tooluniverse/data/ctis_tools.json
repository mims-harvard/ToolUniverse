[
    {
        "name": "CTIS_search_trials",
        "description": "Search EU CTIS with strict, recoverable one-based pagination. Returns exact total_records plus has_more and next_page; continue with the same query and limit while has_more is true. Records preserve CT number, full and short titles, status, conditions, investigational products, primary and other endpoints, phase, sponsor, countries, age criteria, enrollment, decision dates, results availability, and publication/update dates. No API key required.",
        "parameter": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "Free-text search, e.g. 'breast cancer', 'pembrolizumab', 'cystic fibrosis'."
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Results per page, 1-100. Defaults to 10; invalid values are rejected rather than silently clamped.",
                    "minimum": 1,
                    "maximum": 100
                },
                "page": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "One-based CTIS page number. Defaults to 1; use metadata.next_page while metadata.has_more is true.",
                    "minimum": 1
                }
            },
            "required": [
                "query"
            ]
        },
        "fields": {
            "timeout": 30
        },
        "type": "CTISSearchTrialsTool",
        "test_examples": [
            {
                "query": "breast cancer",
                "limit": 5
            },
            {
                "query": "cystic fibrosis",
                "limit": 3
            },
            {
                "query": "pembrolizumab",
                "limit": 3
            }
        ],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    },
    {
        "name": "CTIS_search_trials_filtered",
        "description": "Structured EU CTIS search with strict, recoverable one-based pagination. Narrow by medical condition, status, phase, age group, gender, results availability, sponsor, therapeutic area, country/MSC, or trial region. Records preserve products, endpoints, detailed dates and age fields rather than dropping them. Returns exact total_records plus has_more and next_page; continue with identical filters and limit. No API key required.",
        "parameter": {
            "type": "object",
            "properties": {
                "query": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional free-text term applied as CTIS 'containAll' (e.g. 'cancer', 'pembrolizumab'). Combine with structured filters below."
                },
                "medical_condition": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Medical condition / indication filter, e.g. 'breast cancer', 'leukemia'."
                },
                "status": {
                    "type": [
                        "array",
                        "integer",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": [
                            "integer",
                            "string"
                        ]
                    },
                    "description": "Trial status code(s), e.g. [3] for ongoing. Accepts a single value or a list."
                },
                "trial_phase_code": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Trial phase code(s) as strings, e.g. ['3'] for Phase III. Accepts a single value or a list."
                },
                "age_group_code": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Age group code(s) as strings, e.g. ['2']. Accepts a single value or a list."
                },
                "gender_code": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Gender code(s) as strings. Accepts a single value or a list."
                },
                "therapeutic_area": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Therapeutic area code(s). Accepts a single value or a list."
                },
                "has_study_results": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "If true, return only trials that have posted study results."
                },
                "sponsor": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Sponsor name filter, e.g. 'Pfizer'."
                },
                "sponsor_type_code": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Sponsor type code(s). Accepts a single value or a list."
                },
                "country": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Member State Concerned (MSC) country code(s). Accepts a single value or a list (alias for msc)."
                },
                "msc": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Member State Concerned (MSC) code(s). Accepts a single value or a list."
                },
                "trial_region_code": {
                    "type": [
                        "array",
                        "string",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Trial region code(s) (e.g. EU/EEA vs partly outside). Accepts a single value or a list."
                },
                "sort_by": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional CTIS sort key (e.g. by decision date)."
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Results per page, 1-100. Defaults to 10; invalid values are rejected rather than silently clamped.",
                    "minimum": 1,
                    "maximum": 100
                },
                "page": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "One-based CTIS page number. Defaults to 1; use metadata.next_page while metadata.has_more is true.",
                    "minimum": 1
                }
            },
            "required": []
        },
        "fields": {
            "timeout": 30
        },
        "type": "CTISSearchTrialsTool",
        "test_examples": [
            {
                "medical_condition": "breast cancer",
                "status": [
                    3
                ],
                "limit": 3
            },
            {
                "query": "cancer",
                "has_study_results": true,
                "limit": 2
            },
            {
                "query": "cancer",
                "trial_phase_code": [
                    "3"
                ],
                "limit": 2
            }
        ],
        "return_schema": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    },
    {
        "name": "CTIS_get_trial",
        "description": "Retrieve complete top-level public CTIS trial metadata by CT number, including human-readable and coded status/region, key dates, authorized Part I/II application details, member states, events, results, corrective measures, and the full public document manifest (protocol and other publication files with UUID/type/version metadata). No API key required.",
        "parameter": {
            "type": "object",
            "properties": {
                "ct_number": {
                    "type": "string",
                    "description": "CTIS CT number, e.g. '2022-503001-38-01'."
                }
            },
            "required": [
                "ct_number"
            ]
        },
        "fields": {
            "timeout": 30
        },
        "type": "CTISGetTrialTool",
        "test_examples": [
            {
                "ct_number": "2022-503001-38-01"
            },
            {
                "ct_number": "2022-501024-20-00"
            },
            {
                "ct_number": "2024-514022-23-00"
            }
        ],
        "return_schema": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    }
]
