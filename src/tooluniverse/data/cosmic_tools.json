[
  {
    "name": "COSMIC_search_mutations",
    "description": "Search COSMIC mutation records by gene, mutation ID, or mutation description through NLM Clinical Tables. Repeated source records are aggregated into unique mutations with all cancer contexts visible in the accessible window. COSMIC does not permit pagination: metadata explicitly reports the 500-record upstream window, truncation, and whether the server total may be capped at 10,000.",
    "type": "COSMICTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "search",
          "description": "Operation type (fixed: search)",
          "default": "search"
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "description": "Search query: gene name (e.g. BRAF), mutation (e.g. V600E), or mutation ID."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum unique mutations to return from the accessible 500-source-record window (default 20, range 1-500). Increase this value to expose more unique mutations in that one window; the upstream API does not support offsets.",
          "default": 20,
          "minimum": 1,
          "maximum": 500
        },
        "genome_build": {
          "type": "integer",
          "description": "Genome build version: 37 (GRCh37/hg19) or 38 (GRCh38/hg38). Default: 37",
          "default": 37,
          "enum": [
            37,
            38
          ]
        }
      },
      "required": [
        "terms"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "Server-reported matching source-record count, not a unique-mutation count. The server limits this value to 10,000."
        },
        "count": {
          "type": "integer",
          "description": "Number of unique aggregated mutations returned."
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mutation_id": {
                "type": "string",
                "description": "COSMIC mutation ID."
              },
              "gene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mutation_cds": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mutation_aa": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "genome_position": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mutation_strand": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fathmm_prediction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cancer_contexts": {
                "type": "array",
                "description": "Distinct primary-site and histology contexts retained while aggregating repeated source records in the accessible window.",
                "items": {
                  "type": "object",
                  "properties": {
                    "primary_site": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "primary_histology": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "primary_site",
                    "primary_histology"
                  ]
                }
              }
            },
            "required": [
              "mutation_id",
              "gene",
              "mutation_cds",
              "mutation_aa",
              "genome_position",
              "mutation_strand",
              "fathmm_prediction",
              "cancer_contexts"
            ]
          }
        },
        "genome_build": {
          "type": "string",
          "description": "Genome build used (GRCh37 or GRCh38)"
        }
      },
      "required": [
        "total_count",
        "count",
        "results",
        "genome_build"
      ]
    },
    "test_examples": [
      {
        "operation": "search",
        "terms": "BRAF V600E",
        "max_results": 10
      },
      {
        "operation": "search",
        "terms": "TP53",
        "max_results": 20
      }
    ],
    "fields": {
      "operation": "search"
    }
  },
  {
    "name": "COSMIC_get_mutations_by_gene",
    "description": "Retrieve COSMIC mutation records constrained to one gene symbol. Repeated source records are aggregated into unique mutations while retaining every distinct cancer context visible in the upstream 500-record window. COSMIC does not permit pagination; metadata explicitly reports truncation and a possibly capped server total.",
    "type": "COSMICTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_by_gene",
          "description": "Operation type (fixed: get_by_gene)",
          "default": "get_by_gene"
        },
        "gene": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "HGNC-style gene symbol, e.g. BRAF, TP53, HLA-DRA."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum unique mutations to return from the accessible 500-source-record window (default 100, range 1-500). The upstream API does not support offsets.",
          "default": 100,
          "minimum": 1,
          "maximum": 500
        },
        "genome_build": {
          "type": "integer",
          "description": "Genome build version: 37 (GRCh37/hg19) or 38 (GRCh38/hg38). Default: 37",
          "default": 37,
          "enum": [
            37,
            38
          ]
        }
      },
      "required": [
        "gene"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol queried"
        },
        "total_count": {
          "type": "integer",
          "description": "Server-reported matching source-record count, not a unique-mutation count. The server limits this value to 10,000."
        },
        "count": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mutation_id": {
                "type": "string",
                "description": "COSMIC mutation ID"
              },
              "gene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mutation_cds": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mutation_aa": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "genome_position": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Genomic coordinates."
              },
              "mutation_strand": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fathmm_prediction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cancer_contexts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "primary_site": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "primary_histology": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "primary_site",
                    "primary_histology"
                  ]
                }
              }
            },
            "required": [
              "mutation_id",
              "gene",
              "mutation_cds",
              "mutation_aa",
              "genome_position",
              "mutation_strand",
              "fathmm_prediction",
              "cancer_contexts"
            ]
          }
        },
        "genome_build": {
          "type": "string"
        }
      },
      "required": [
        "gene",
        "total_count",
        "count",
        "results",
        "genome_build"
      ]
    },
    "test_examples": [
      {
        "operation": "get_by_gene",
        "gene": "BRAF",
        "max_results": 50
      },
      {
        "operation": "get_by_gene",
        "gene": "TP53",
        "max_results": 100
      }
    ],
    "fields": {
      "operation": "get_by_gene"
    }
  }
]