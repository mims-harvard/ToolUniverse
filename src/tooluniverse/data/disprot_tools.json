[
    {
        "name": "DisProt_search",
        "description": "Search DisProt for intrinsically disordered proteins using DisProt's free-text search across database fields. Results are explicitly paginated, and metadata reports the full match count and next page. Returns DisProt ID, UniProt accession, protein name, organism, disorder content fraction, and number of annotated regions.",
        "parameter": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Search term: gene name (e.g., 'TP53'), protein name (e.g., 'kinase'), organism (e.g., 'sapiens'), or keyword (e.g., 'amyloid', 'phase separation')."
                },
                "page_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 10,
                    "description": "Number of results per page (default 10, ToolUniverse safety maximum 500). The DisProt API documents page_size without an upstream maximum."
                },
                "page": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based result page. Use metadata.next_page to continue. Default: 0."
                }
            },
            "required": ["query"],
            "additionalProperties": false
        },
        "fields": {
            "endpoint": "search"
        },
        "type": "DisProtTool",
        "test_examples": [
            {
                "query": "TP53"
            },
            {
                "query": "amyloid",
                "page_size": 5
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "disprot_id": {"type": "string", "description": "DisProt accession (e.g., DP00086)"},
                            "acc": {"type": "string", "description": "UniProt accession"},
                            "name": {"type": "string", "description": "Protein name"},
                            "gene": {"type": "string", "description": "Gene symbol"},
                            "organism": {"type": "string"},
                            "length": {"type": "integer"},
                            "disorder_content": {"type": ["number", "null"], "description": "Fraction of sequence that is disordered (0-1)"},
                            "regions_counter": {"type": ["integer", "null"], "description": "Number of annotated disorder regions"},
                            "dataset": {"type": "array", "items": {"type": "string"}, "description": "Dataset categories"}
                        }
                    },
                    "description": "List of matching disordered proteins"
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {"type": "string"}
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "DisProt_get_entry",
        "description": "Get detailed disorder region annotations for a protein from DisProt. Accepts either a DisProt ID or UniProt accession. Regions use explicit offset/limit pagination; response metadata reports the exact returned and total region counts, whether more regions exist, and the next offset. Every region retains all returned cross-references.",
        "parameter": {
            "type": "object",
            "properties": {
                "accession": {
                    "type": "string",
                    "minLength": 1,
                    "description": "DisProt ID (e.g., 'DP00086') or UniProt accession (e.g., 'P04637'). Both formats accepted."
                },
                "region_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based offset within the entry's disorder regions. Default: 0."
                },
                "region_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 30,
                    "description": "Maximum disorder regions returned per call. Default: 30. Use metadata.next_region_offset to continue."
                }
            },
            "required": ["accession"],
            "additionalProperties": false
        },
        "fields": {
            "endpoint": "get_entry"
        },
        "type": "DisProtTool",
        "test_examples": [
            {
                "accession": "P04637"
            },
            {
                "accession": "DP00086"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "disprot_id": {"type": "string"},
                        "acc": {"type": "string"},
                        "name": {"type": "string"},
                        "gene": {"type": "string"},
                        "organism": {"type": "string"},
                        "length": {"type": "integer"},
                        "disorder_content": {"type": ["number", "null"]},
                        "regions_counter": {"type": ["integer", "null"]},
                        "dataset": {"type": "array", "items": {"type": "string"}},
                        "regions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "region_id": {"type": ["string", "null"]},
                                    "start": {"type": ["integer", "null"]},
                                    "end": {"type": ["integer", "null"]},
                                    "term_name": {"type": ["string", "null"], "description": "Disorder classification term"},
                                    "term_namespace": {"type": ["string", "null"]},
                                    "evidence_code": {"type": ["string", "null"]},
                                    "method": {"type": ["string", "null"]},
                                    "cross_refs": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "db": {"type": "string"},
                                                "id": {"type": "string"}
                                            }
                                        }
                                    }
                                }
                            },
                            "description": "Experimentally validated disorder regions"
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {"type": "string"}
                    },
                    "required": ["error"]
                }
            ]
        }
    }
]
