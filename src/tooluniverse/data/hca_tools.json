[
    {
        "name": "hca_search_projects",
        "type": "HCATool",
        "description": "Searches for single-cell projects in the Human Cell Atlas (HCA) Data Coordination Platform (DCP). This tool allows filtering projects based on specific organs and disease states.",
        "parameter": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "search_projects"
                    ],
                    "default": "search_projects",
                    "description": "The specific action to perform. Must be set to 'search_projects'."
                },
                "organ": {
                    "type": "string",
                    "description": "The organ to filter projects by. Examples include 'heart', 'liver', 'brain', 'kidney'. This field is optional."
                },
                "disease": {
                    "type": "string",
                    "description": "The disease state to filter by. Examples include 'normal', 'cancer', 'covid-19'. This field is optional."
                },
                "limit": {
                    "type": "integer",
                    "description": "The maximum number of projects to return. The default is 10. Use this to control the size of the result set.",
                    "default": 10
                }
            },
            "required": []
        },
        "return_schema": {
            "type": "object",
            "description": "A dictionary containing the search results, including the total count of hits and a list of project details.",
            "properties": {
                "total_hits": {
                    "type": "integer",
                    "description": "The total number of projects matching the search criteria."
                },
                "projects": {
                    "type": "array",
                    "description": "A list of project objects containing metadata about each matching project.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "entryId": {
                                "type": "string",
                                "description": "The unique identifier (UUID) for the project. This ID is used to retrieve file manifests."
                            },
                            "organ": {
                                "type": [
                                    "array",
                                    "null"
                                ],
                                "description": "Organs across every specimen of the project, not only the first"
                            },
                            "projectTitle": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Title of the project"
                            },
                            "projectShortname": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "HCA's short name for the project"
                            },
                            "laboratory": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Laboratories that contributed the project"
                            },
                            "estimatedCellCount": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "description": "HCA's estimate of the project's cell count"
                            },
                            "accessible": {
                                "type": [
                                    "boolean",
                                    "null"
                                ],
                                "description": "Whether the project's data can be downloaded"
                            },
                            "dataUseRestriction": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Any restriction on reusing the data"
                            },
                            "organPart": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Organ parts the cell suspensions came from"
                            },
                            "selectedCellType": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Cell types the suspensions were selected for"
                            },
                            "totalCells": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "description": "Cells summed over the project's cell suspensions"
                            },
                            "donorDisease": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Diseases across every donor of the project"
                            },
                            "genusSpecies": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Species of the donors. HCA holds mouse projects as well as human ones - the first project this endpoint returns is Mus musculus - so a human-only question has to read this"
                            },
                            "biologicalSex": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Sexes of the donors"
                            },
                            "developmentStage": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Development stages of the donors"
                            },
                            "organismAge": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Donor ages as value and unit, e.g. '25.0 year'"
                            },
                            "donorCount": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "description": "Donors summed over the project's donor records"
                            },
                            "libraryConstructionApproach": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "The single-cell assay, e.g. \"10x 3' v2\" or 'Smart-seq2'"
                            },
                            "nucleicAcidSource": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "e.g. 'single cell' or 'single nucleus'"
                            },
                            "instrumentManufacturerModel": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Sequencers used"
                            },
                            "pairedEnd": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Whether the sequencing was paired-end"
                            }
                        }
                    }
                }
            }
        },
        "test_examples": [
            {
                "action": "search_projects",
                "organ": "heart",
                "limit": 2
            }
        ]
    },
    {
        "name": "hca_get_file_manifest",
        "type": "HCATool",
        "description": "Retrieves a list of downloadable files for a specific Human Cell Atlas (HCA) project identified by its Project ID.",
        "parameter": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "get_file_manifest"
                    ],
                    "default": "get_file_manifest",
                    "description": "The specific action to perform. Must be set to 'get_file_manifest'."
                },
                "project_id": {
                    "type": "string",
                    "description": "The unique UUID of the project (entryId) for which to retrieve files. This ID is typically obtained from the 'hca_search_projects' tool."
                },
                "limit": {
                    "type": "integer",
                    "description": "The maximum number of files to list. The default is 10.",
                    "default": 10
                }
            },
            "required": [
                "project_id"
            ]
        },
        "return_schema": {
            "type": "object",
            "description": "A dictionary containing the file manifest, including the total file count and a list of file details.",
            "properties": {
                "total_files": {
                    "type": "integer",
                    "description": "The total number of files available for the project."
                },
                "files": {
                    "type": "array",
                    "description": "A list of file objects with download links and metadata.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "The name of the file."
                            },
                            "url": {
                                "type": "string",
                                "description": "The direct download URL for the file."
                            },
                            "format": {
                                "type": "string",
                                "description": "The format of the file (e.g., 'h5', 'fastq')."
                            },
                            "size": {
                                "type": "integer",
                                "description": "The size of the file in bytes."
                            },
                            "uuid": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "HCA's identifier for the file"
                            },
                            "version": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Version of the file; a name alone does not identify one"
                            },
                            "sha256": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "SHA-256 of the file, to verify a download"
                            },
                            "accessible": {
                                "type": [
                                    "boolean",
                                    "null"
                                ],
                                "description": "Whether this file can be downloaded"
                            },
                            "is_intermediate": {
                                "type": [
                                    "boolean",
                                    "null"
                                ],
                                "description": "True for an intermediate product rather than a final matrix"
                            },
                            "content_description": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "What the file holds, e.g. 'Matrix'"
                            },
                            "matrix_cell_count": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "description": "Cells in the matrix, when the file is one"
                            },
                            "file_source": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "Where the file came from, e.g. a contributor or the DCP pipeline"
                            },
                            "drs_uri": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "GA4GH DRS URI for the file"
                            }
                        }
                    }
                }
            }
        },
        "test_examples": [
            {
                "action": "get_file_manifest",
                "project_id": "7027adc6-c9c9-46f3-84ee-9badc3a4f53b"
            }
        ]
    }
]
