[
  {
    "name": "OncoKB_annotate_variant",
    "description": "Annotate a cancer variant for oncogenic potential and treatment implications using OncoKB. Returns evidence level, oncogenicity, mutation effect, and FDA-approved therapies. Requires ONCOKB_API_TOKEN env var (demo mode available for BRAF, TP53, ROS1). Example: BRAF V600E in melanoma.",
    "type": "OncoKBTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "annotate_variant",
          "description": "Operation type (fixed: annotate_variant)"
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., BRAF, EGFR, TP53, KRAS)"
        },
        "gene_symbol": {
          "type": "string",
          "description": "Alias for gene. Gene symbol (e.g., BRAF, EGFR, TP53, KRAS)."
        },
        "variant": {
          "type": "string",
          "description": "Variant notation - protein change (e.g., V600E, T790M, G12D)"
        },
        "tumor_type": {
          "type": "string",
          "description": "Optional OncoTree tumor type code (e.g., MEL for melanoma, LUAD for lung adenocarcinoma)"
        },
        "alteration": {
          "type": "string",
          "description": "Alias for variant. Protein change notation (e.g., \"V600E\", \"T790M\", \"G12D\")."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "oncogenic": {
          "type": "string",
          "description": "Oncogenicity classification (Oncogenic, Likely Oncogenic, etc.)"
        },
        "mutationEffect": {
          "type": "object",
          "description": "Mutation effect on protein function"
        },
        "highestSensitiveLevel": {
          "type": "string",
          "description": "Highest level of evidence for drug sensitivity"
        },
        "treatments": {
          "type": "array",
          "description": "List of treatment options with evidence levels"
        }
      }
    },
    "test_examples": [
      {
        "gene": "BRAF",
        "variant": "V600E"
      },
      {
        "gene": "BRAF",
        "variant": "V600E",
        "tumor_type": "MEL"
      }
    ],
    "optional_api_keys": [
      "ONCOKB_API_TOKEN"
    ]
  },
  {
    "name": "OncoKB_get_gene_info",
    "description": "Get gene-level oncogenic information from OncoKB. Returns whether gene is an oncogene, tumor suppressor, or both. Includes curated background information. Requires ONCOKB_API_TOKEN env var (demo mode available for BRAF, TP53, ROS1).",
    "type": "OncoKBTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_gene_info",
          "description": "Operation type (fixed: get_gene_info)"
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., BRAF, TP53, ROS1). Without ONCOKB_API_TOKEN only BRAF, TP53, and ROS1 are available (demo mode)."
        },
        "gene_symbol": {
          "type": "string",
          "description": "Gene symbol alias — alternative to gene parameter"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "hugoSymbol": {
          "type": "string",
          "description": "Official gene symbol"
        },
        "oncogene": {
          "type": "boolean",
          "description": "Whether gene is classified as oncogene"
        },
        "tsg": {
          "type": "boolean",
          "description": "Whether gene is a tumor suppressor gene"
        },
        "geneAliases": {
          "type": "array",
          "description": "Alternative gene names"
        }
      }
    },
    "test_examples": [
      {
        "gene": "BRAF"
      },
      {
        "gene": "TP53"
      }
    ],
    "optional_api_keys": [
      "ONCOKB_API_TOKEN"
    ]
  },
  {
    "name": "OncoKB_get_cancer_genes",
    "description": "Get list of all cancer genes curated in OncoKB. Returns genes classified as oncogenes and/or tumor suppressors. Useful for checking if a gene is a known cancer driver. Requires ONCOKB_API_TOKEN env var.",
    "type": "OncoKBTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_cancer_genes",
          "description": "Operation type (fixed: get_cancer_genes)"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "total_genes": {
          "type": "integer",
          "description": "Total genes in database"
        },
        "cancer_genes_count": {
          "type": "integer",
          "description": "Number of cancer-related genes"
        },
        "genes": {
          "type": "array",
          "description": "List of cancer genes with classifications"
        }
      }
    },
    "test_examples": [
      {},
      {}
    ],
    "optional_api_keys": [
      "ONCOKB_API_TOKEN"
    ]
  },
  {
    "name": "OncoKB_get_levels",
    "description": "Get OncoKB evidence level definitions. Returns descriptions of all therapeutic actionability levels (1, 2, 3A, 3B, 4, R1, R2). Level 1 = FDA-approved, Level 2 = Standard care, Level 3A = Compelling clinical evidence, etc.",
    "type": "OncoKBTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_levels",
          "description": "Operation type (fixed: get_levels)"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "description": "Level code (LEVEL_1, LEVEL_2, etc.)"
              },
              "description": {
                "type": "string",
                "description": "Level description"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {},
      {}
    ],
    "optional_api_keys": [
      "ONCOKB_API_TOKEN"
    ]
  },
  {
    "name": "OncoKB_annotate_copy_number",
    "description": "Annotate copy number alterations (amplification/deletion) for oncogenic potential. Returns evidence for gene amplification or deletion in cancer. Example: ERBB2 amplification in breast cancer, CDKN2A deletion.",
    "type": "OncoKBTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "annotate_copy_number",
          "description": "Operation type (fixed: annotate_copy_number)"
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., ERBB2, MYC, CDKN2A)"
        },
        "copy_number_type": {
          "type": "string",
          "enum": [
            "AMPLIFICATION",
            "DELETION",
            "Amplification",
            "Deletion",
            "amplification",
            "deletion"
          ],
          "description": "Type of copy number alteration (case-insensitive: AMPLIFICATION or DELETION)"
        },
        "tumor_type": {
          "type": "string",
          "description": "Optional OncoTree tumor type code"
        },
        "copy_number_alteration": {
          "type": "string",
          "description": "Alias for copy_number_type. Amplification or Deletion."
        }
      },
      "required": [
        "gene"
      ]
    },
    "test_examples": [
      {
        "gene": "ERBB2",
        "copy_number_type": "AMPLIFICATION"
      },
      {
        "gene": "BRCA1",
        "copy_number_type": "DELETION",
        "tumor_type": "BRCA"
      }
    ],
    "optional_api_keys": [
      "ONCOKB_API_TOKEN"
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "description": "Echo of the query parameters submitted",
          "properties": {
            "referenceGenome": {
              "type": "string",
              "description": "Reference genome (e.g., GRCh37)"
            },
            "hugoSymbol": {
              "type": "string",
              "description": "Gene symbol"
            },
            "entrezGeneId": {
              "type": "integer",
              "description": "Entrez Gene ID"
            },
            "alteration": {
              "type": ["string", "null"],
              "description": "Alteration type (e.g., Amplification, Deletion)"
            },
            "tumorType": {
              "type": ["string", "null"],
              "description": "OncoTree tumor type code"
            }
          }
        },
        "geneExist": {
          "type": "boolean",
          "description": "Whether the gene exists in OncoKB"
        },
        "variantExist": {
          "type": "boolean",
          "description": "Whether the specific variant is cataloged"
        },
        "alleleExist": {
          "type": "boolean",
          "description": "Whether the allele exists"
        },
        "oncogenic": {
          "type": "string",
          "description": "Oncogenicity classification (Oncogenic, Likely Oncogenic, Unknown)"
        },
        "mutationEffect": {
          "type": "object",
          "description": "Effect of the copy number alteration",
          "properties": {
            "knownEffect": {
              "type": "string",
              "description": "Known functional effect (Gain-of-function, Loss-of-function, Unknown)"
            },
            "description": {
              "type": "string",
              "description": "Textual description of the mutation effect"
            },
            "citations": {
              "type": "object",
              "properties": {
                "pmids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "abstracts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "highestSensitiveLevel": {
          "type": ["string", "null"],
          "description": "Highest evidence level for drug sensitivity (e.g., LEVEL_1)"
        },
        "highestResistanceLevel": {
          "type": ["string", "null"],
          "description": "Highest evidence level for drug resistance"
        },
        "highestDiagnosticImplicationLevel": {
          "type": ["string", "null"],
          "description": "Highest diagnostic implication level"
        },
        "highestPrognosticImplicationLevel": {
          "type": ["string", "null"],
          "description": "Highest prognostic implication level"
        },
        "highestFdaLevel": {
          "type": ["string", "null"],
          "description": "Highest FDA evidence level"
        },
        "otherSignificantSensitiveLevels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "otherSignificantResistanceLevels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "VUS": {
          "type": "boolean",
          "description": "Whether the variant is of unknown significance"
        },
        "hotspot": {
          "type": "boolean",
          "description": "Whether the variant is a hotspot mutation"
        },
        "geneSummary": {
          "type": "string",
          "description": "Curated gene summary from OncoKB"
        },
        "variantSummary": {
          "type": "string",
          "description": "Curated variant summary from OncoKB"
        },
        "tumorTypeSummary": {
          "type": "string",
          "description": "Tumor-type-specific summary"
        },
        "diagnosticImplications": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Diagnostic implication entries"
        },
        "prognosticImplications": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Prognostic implication entries"
        },
        "treatments": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Treatment options with evidence levels"
        },
        "dataVersion": {
          "type": "string",
          "description": "OncoKB data version"
        },
        "lastUpdate": {
          "type": "string",
          "description": "Date of last update"
        }
      }
    }
  }
]
