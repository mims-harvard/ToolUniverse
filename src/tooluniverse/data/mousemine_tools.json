[
  {
    "name": "MouseMine_search",
    "type": "MouseMineTool",
    "description": "Search MouseMine, the InterMine data warehouse for mouse (Mus musculus) genomics data from MGI (Mouse Genome Informatics). Searches across genes, alleles, proteins, publications, gene ontology terms, protein domains, and more. Returns matching records with category facets and relevance scores. MouseMine integrates data from MGI including gene annotations, phenotypes, alleles, expression data, pathways, and disease models. Use facet_Category parameter to filter by specific entity type (e.g., 'ProteinCodingGene', 'Allele', 'Publication', 'Protein').",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Search query: gene symbol (e.g., 'Brca1', 'Tp53', 'Sox9'), protein name, disease term, or free text."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results to return (default: 10, max: 100)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        },
        "format": {
          "type": "string",
          "default": "json",
          "description": "Response format. Must be 'json'."
        },
        "facet_Category": {
          "type": "string",
          "description": "Filter results by entity category. Options include: 'ProteinCodingGene', 'Gene', 'Allele', 'Protein', 'Publication', 'Genotype', 'GOTerm', 'ProteinDomain', 'GXDExpression', 'NcRNAGene', 'AntisenseLncRNAGene', 'Strain', 'HTExperiment', 'InteractionExperiment', 'DOTerm', 'UniProtFeature'."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.mousemine.org/mousemine/service/search",
      "return_format": "JSON",
      "params": {
        "format": "json"
      },
      "pagination": "intermine_start"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "MouseMine search results",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total number of matching records"
            },
            "facets": {
              "type": [
                "object",
                "null"
              ],
              "description": "Facet counts, keyed by facet name (Category, organism.shortName, pathways.name, strain.name) and then by facet value, with the count as the value. An empty inner object means the facet matched nothing",
              "properties": {
                "Category": {
                  "type": "object",
                  "description": "Counts for the Category facet, keyed by facet value. An empty object means the facet matched nothing",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                },
                "organism.shortName": {
                  "type": "object",
                  "description": "Counts for the organism.shortName facet, keyed by facet value. An empty object means the facet matched nothing",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                },
                "pathways.name": {
                  "type": "object",
                  "description": "Counts for the pathways.name facet, keyed by facet value. An empty object means the facet matched nothing",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                },
                "strain.name": {
                  "type": "object",
                  "description": "Counts for the strain.name facet, keyed by facet value. An empty object means the facet matched nothing",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                }
              },
              "additionalProperties": {
                "type": [
                  "object",
                  "null",
                  "boolean",
                  "array",
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "integer",
                    "null",
                    "boolean",
                    "array",
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array",
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ]
                    }
                  },
                  "description": "How many results carry that value"
                },
                "description": "Counts for one facet, keyed by value"
              }
            },
            "results": {
              "type": "array",
              "description": "Matching records",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "Internal database ID"
                  },
                  "type": {
                    "type": "string",
                    "description": "Entity type (Gene, Allele, Protein, etc.)"
                  },
                  "relevance": {
                    "type": "number",
                    "description": "Search relevance score"
                  },
                  "fields": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "The matched record's fields, keyed by MouseMine field name",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "wasSuccessful": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether MouseMine itself reported success. A query that failed upstream is not an empty result"
            },
            "statusCode": {
              "type": [
                "integer",
                "null"
              ],
              "description": "HTTP status MouseMine returned"
            },
            "executionTime": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "How long MouseMine took"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "q": "Brca1",
        "size": 5,
        "format": "json"
      },
      {
        "q": "Tp53",
        "size": 5,
        "format": "json",
        "facet_Category": "ProteinCodingGene"
      },
      {
        "q": "Sox9",
        "size": 5,
        "format": "json",
        "facet_Category": "Allele"
      }
    ]
  },
  {
    "name": "MouseMine_search_genes",
    "type": "MouseMineTool",
    "description": "Search MouseMine specifically for mouse protein-coding genes. This is a convenience wrapper that filters results to ProteinCodingGene category only. Returns gene symbols, MGI identifiers, and organism information from Mouse Genome Informatics (MGI). For broader searches across all entity types, use MouseMine_search instead.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Gene search query: gene symbol (e.g., 'Brca1', 'Tp53'), gene name, or keyword."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results to return (default: 10)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.mousemine.org/mousemine/service/search",
      "return_format": "JSON",
      "params": {
        "format": "json",
        "facet_Category": "ProteinCodingGene"
      },
      "pagination": "intermine_start"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "MouseMine gene search results",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total matching genes"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "description": "Always 'ProteinCodingGene'"
                  },
                  "relevance": {
                    "type": "number"
                  },
                  "fields": {
                    "type": "object",
                    "properties": {
                      "symbol": {
                        "type": "string",
                        "description": "Official gene symbol (e.g., 'Brca1')"
                      },
                      "primaryIdentifier": {
                        "type": "string",
                        "description": "MGI identifier (e.g., 'MGI:104537')"
                      },
                      "organism.commonName": {
                        "type": "string",
                        "description": "Organism name (e.g., 'mouse, laboratory')"
                      },
                      "sequenceOntologyTerm.name": {
                        "type": "string",
                        "description": "Gene biotype"
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "q": "Brca1",
        "size": 5
      },
      {
        "q": "insulin",
        "size": 10
      },
      {
        "q": "Notch1",
        "size": 5
      }
    ]
  },
  {
    "name": "MouseMine_search_alleles",
    "type": "MouseMineTool",
    "description": "Search MouseMine specifically for mouse alleles and mutants. Returns allele symbols, names, MGI identifiers, allele types (Targeted, Endonuclease-mediated, Spontaneous, etc.), and attribute strings (Null/knockout, etc.) from Mouse Genome Informatics (MGI). Useful for finding knockout/knockin alleles, spontaneous mutations, and transgenic alleles for specific genes. For broader searches, use MouseMine_search instead.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Allele search query: gene symbol (e.g., 'Brca1'), allele symbol (e.g., 'Brca1<tm1Whl>'), or keyword."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results to return (default: 10)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.mousemine.org/mousemine/service/search",
      "return_format": "JSON",
      "params": {
        "format": "json",
        "facet_Category": "Allele"
      },
      "pagination": "intermine_start"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "MouseMine allele search results",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total matching alleles"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "description": "Always 'Allele'"
                  },
                  "relevance": {
                    "type": "number"
                  },
                  "fields": {
                    "type": "object",
                    "properties": {
                      "symbol": {
                        "type": "string",
                        "description": "Allele symbol (e.g., 'Brca1<tm1Whl>')"
                      },
                      "name": {
                        "type": "string",
                        "description": "Full allele name"
                      },
                      "primaryIdentifier": {
                        "type": "string",
                        "description": "MGI allele ID (e.g., 'MGI:1858107')"
                      },
                      "alleleType": {
                        "type": "string",
                        "description": "Allele type: Targeted, Endonuclease-mediated, Spontaneous, Transgenic, Chemically induced, etc."
                      },
                      "attributeString": {
                        "type": "string",
                        "description": "Allele attribute: Null/knockout, Reporter, Conditional ready, etc."
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "q": "Brca1",
        "size": 5
      },
      {
        "q": "Tp53",
        "size": 5
      },
      {
        "q": "CRISPR",
        "size": 10
      }
    ]
  }
]
