  {
    "name": "AlphaGenome_score_ism_variants",
    "type": "AlphaGenomeTool",
    "fields": {
      "operation": "score_ism_variants"
    },
    "description": "In-silico saturation mutagenesis with DeepMind AlphaGenome: scores every possible single-nucleotide substitution across a short window (<=500 bp) and ranks candidates by their single most extreme per-gene, per-track effect -- a 'which bases matter most' scan for finding causal regulatory positions (e.g. within a promoter or enhancer). Each live call costs ~3x the window width in underlying model evaluations, so the window is capped at 500 bp; for a single known variant use AlphaGenome_score_variant instead. Hosted API via the alphagenome SDK; free for non-commercial use (set ALPHA_GENOME_API_KEY).",
    "required_api_keys": [
      "ALPHA_GENOME_API_KEY"
    ],
    "api_key_info": {
      "ALPHA_GENOME_API_KEY": {
        "domain": "Models & Infrastructure",
        "type": "api_key",
        "register_url": "https://deepmind.google.com/science/alphagenome",
        "purpose": "Free non-commercial access to the hosted AlphaGenome prediction API (Atlas shares the same key).",
        "without": "Tool stays config-only until the key is set."
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "chromosome",
        "start",
        "end"
      ],
      "properties": {
        "chromosome": {
          "type": "string",
          "description": "Chromosome, e.g. 'chr22'."
        },
        "start": {
          "type": "integer",
          "description": "ISM window start (0-based). Window (end - start) must be <= 500 bp."
        },
        "end": {
          "type": "integer",
          "description": "ISM window end. Window (end - start) must be <= 500 bp."
        },
        "output_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Modality/scorer to rank by, i.e. a key of alphagenome.models.variant_scorers.RECOMMENDED_VARIANT_SCORERS. RNA_SEQ (default), ATAC, DNASE, CAGE, CHIP_HISTONE, CHIP_TF, PROCAP, SPLICE_SITES, SPLICE_SITE_USAGE, SPLICE_JUNCTIONS, POLYADENYLATION, CONTACT_MAPS, or an _ACTIVE variant of ATAC/DNASE/CAGE/CHIP_TF/CHIP_HISTONE/PROCAP/RNA_SEQ."
        },
        "organism": {
          "type": [
            "string",
            "null"
          ],
          "description": "'human' (default) or 'mouse'."
        },
        "sequence_length": {
          "type": [
            "string",
            "null"
          ],
          "description": "Context window: 16KB, 100KB, 500KB, or 1MB (default)."
        },
        "top_n": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Number of top |effect| entries to return (default 20)."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ism_interval": {
              "type": "string"
            },
            "output_type": {
              "type": "string"
            },
            "top_variants": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "chromosome": "chr22",
        "start": 36201690,
        "end": 36201710,
        "sequence_length": "16KB",
        "output_type": "RNA_SEQ",
        "top_n": 10
      }
    ]
  },
