[
  {
    "name": "Alliance_get_gene",
    "description": "Get detailed gene information from the Alliance of Genome Resources, including species, synopsis, synonyms, genomic location, and paginated cross-references. Use xref_offset/xref_limit and inspect cross_references_total, cross_references_truncated, and next_xref_offset; well-studied genes can have hundreds of cross-references.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "Alliance gene ID with source prefix. Examples: 'HGNC:6081' (human INS), 'MGI:98834' (mouse Trp53), 'FB:FBgn0003996' (fly w), 'SGD:S000000259' (yeast GAL4), 'ZFIN:ZDB-GENE-990415-8' (zebrafish pax2a), 'WB:WBGene00006763' (worm unc-13)."
        },
        "xref_offset": {
          "type": "integer",
          "description": "Zero-based cross-reference offset.",
          "default": 0,
          "minimum": 0
        },
        "xref_limit": {
          "type": "integer",
          "description": "Cross-references returned per page (default 10, maximum 500).",
          "default": 10,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_detail"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "HGNC:6081"
      },
      {
        "gene_id": "MGI:98834"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "species": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "short_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "data_provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "automated_gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "so_term": {
              "type": [
                "string",
                "null"
              ]
            },
            "genomic_location": {
              "type": "object",
              "properties": {
                "chromosome": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "start": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "assembly": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "strand": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "curie": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "cross_references_total": {
              "type": "integer"
            },
            "xref_offset": {
              "type": "integer"
            },
            "cross_references_returned": {
              "type": "integer"
            },
            "cross_references_truncated": {
              "type": "boolean"
            },
            "next_xref_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Alliance_search_genes",
    "description": "Search genes across all Alliance of Genome Resources species by symbol, synonym, name, or keyword. Returns exact total_results and recoverable offset pagination; continue with next_offset while has_more is true. Results include human, mouse, rat, zebrafish, fly, worm, yeast, and frog genes. Example: 'TP53' has more than 100 cross-species and related gene matches.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or synonym to search for (not a descriptive name). Examples: 'INS', 'TP53', 'shh', 'notch1'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results to return (1-50). Default: 10."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset in the complete matching gene list. Continue with metadata.next_offset. Default: 0."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search_genes"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "query": "INS",
        "limit": 10
      },
      {
        "query": "shh"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "primary_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Alliance_get_gene_phenotypes",
    "description": "Get phenotype annotations for a gene from the Alliance of Genome Resources. Results are recoverably paginated: start with page=1 and continue with metadata.next_page while metadata.has_more is true; metadata.total_results and total_pages are exact.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "Alliance gene ID with source prefix. Examples: 'HGNC:6081' (human INS), 'MGI:98834' (mouse Trp53), 'FB:FBgn0003996' (fly w)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of phenotypes to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_phenotypes",
      "pagination": "alliance_page"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "HGNC:6081",
        "limit": 10
      },
      {
        "gene_id": "FB:FBgn0003996"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gene_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phenotype_statement": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Alliance_get_disease_genes",
