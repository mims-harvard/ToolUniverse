          "type": "string",
          "description": "Alliance gene ID with member prefix, e.g. 'MGI:97490' (Pax6), 'HGNC:8620'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Max results (default 20, max 100)."
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page number (default 1)."
