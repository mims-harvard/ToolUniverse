  {
    "name": "Alliance_get_disease",
    "description": "Get disease summary information from the Alliance of Genome Resources by Disease Ontology (DO) ID. Returns disease name, definition, synonyms, and classification. The Alliance integrates disease annotations from multiple model organism databases. Example: 'DOID:162' returns cancer with definition and synonyms like 'malignant neoplasm'.",
    "parameter": {
      "type": "object",
      "properties": {
        "disease_id": {
          "type": "string",
          "description": "Disease Ontology (DO) ID. Examples: 'DOID:162' (cancer), 'DOID:10652' (Alzheimer's disease), 'DOID:9351' (diabetes mellitus), 'DOID:1612' (breast cancer)."
        }
      },
      "required": [
        "disease_id"
      ]
    },
    "fields": {
      "endpoint_type": "disease_detail"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "disease_id": "DOID:162"
      },
      {
        "disease_id": "DOID:10652"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "disease_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "definition": {
              "type": [
                "string",
