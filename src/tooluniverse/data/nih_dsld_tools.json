[
  {
    "name": "NIHDSLD_search_products",
    "type": "NIHDSLDTool",
    "description": "Search the NIH Dietary Supplement Label Database (DSLD), covering over 200,000 US supplement product labels, by product name, brand, or ingredient. Returns each match's product_id, brand, product type, and market status. Example: query='vitamin d' or query='turmeric curcumin'. Use product_id with NIHDSLD_get_label for the full ingredient list with amounts.",
    "fields": {
      "operation": "search_products"
    },
    "parameter": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "Product name, brand, or ingredient, e.g. 'vitamin d', 'turmeric', 'Nature Made'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max products to return, 1-100. Default 25."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {"type": ["string", "null"]},
              "name": {"type": ["string", "null"]},
              "brand": {"type": ["string", "null"]},
              "product_type": {"type": ["string", "null"]},
              "physical_state": {"type": ["string", "null"]},
              "net_contents": {"type": ["string", "null"]},
              "off_market": {"type": "boolean"}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"query": "vitamin d", "limit": 5},
      {"query": "turmeric curcumin", "limit": 5}
    ]
  },
  {
    "name": "NIHDSLD_get_label",
    "type": "NIHDSLDTool",
    "description": "Retrieve one dietary supplement's full label from the NIH DSLD: every ingredient with its per-serving amount, unit, and percent daily value, plus serving size and brand. Example: product_id=20581 (Vitamin D Gummy Vitamins) returns 2000 IU Vitamin D at 500% daily value per 2-gummy serving. Use NIHDSLD_search_products to find a product_id.",
    "fields": {
      "operation": "get_label"
    },
    "parameter": {
      "type": "object",
      "required": ["product_id"],
      "properties": {
        "product_id": {
          "type": ["string", "integer"],
          "description": "DSLD product identifier, e.g. 20581."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "product_id": {"type": ["integer", "string", "null"]},
            "name": {"type": ["string", "null"]},
            "brand": {"type": ["string", "null"]},
            "upc": {"type": ["string", "null"]},
            "product_type": {"type": ["string", "null"]},
            "serving_size": {
              "type": ["object", "null"],
              "description": "The label's serving size",
              "properties": {
                "order": {"type": ["integer", "null"]},
                "unit": {"type": ["string", "null"], "description": "e.g. 'Gummy(ies)'"},
                "minQuantity": {"type": ["number", "null"], "description": "Serving size, lower bound"},
                "maxQuantity": {"type": ["number", "null"], "description": "Serving size, upper bound"},
                "minDailyServings": {"type": ["number", "null"], "description": "Servings per day, lower bound"},
                "maxDailyServings": {"type": ["number", "null"], "description": "Servings per day, upper bound"},
                "inSFB": {"type": ["boolean", "null"], "description": "Whether it appears in the supplement facts box"}
              }
            },
            "servings_per_container": {},
            "ingredients": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": ["string", "null"]},
                  "category": {"type": ["string", "null"]},
                  "amount": {"type": ["number", "null"]},
                  "unit": {"type": ["string", "null"]},
                  "percent_daily_value": {"type": ["number", "null"]},
                  "per_serving_quantity": {"type": ["number", "null"]},
                  "per_serving_unit": {"type": ["string", "null"]},
                  "notes": {"type": ["string", "null"]}
                }
              }
            },
            "other_ingredients": {
              "type": "object",
              "description": "The inactive ingredients, the other half of 'every ingredient'",
              "properties": {
                "text": {"type": ["string", "null"], "description": "DSLD's free-text other-ingredients line, where present"},
                "ingredient_count": {"type": ["integer", "null"], "description": "How many the label carries, before the cap"},
                "ingredients": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": ["string", "null"]},
                      "category": {"type": ["string", "null"], "description": "DSLD category, e.g. sugar"},
                      "ingredient_group": {"type": ["string", "null"]},
                      "unii_code": {"type": ["string", "null"], "description": "FDA UNII for the substance"},
                      "alternate_names": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            },
            "statements": {
              "type": "array",
              "description": "What the package says, capped at metadata.statements_per_label. The audited label has 23, four of them precautions",
              "items": {
                "type": "object",
                "properties": {
                  "type": {"type": ["string", "null"], "description": "DSLD's statement type, e.g. 'Precautions re: Pregnant or Nursing or Prescription Medications', 'Suggested/Recommended/Usage/Directions', 'Storage', 'FDA Disclaimer Statement'"},
                  "text": {"type": ["string", "null"], "description": "The statement as printed"}
                }
              }
            },
            "net_contents": {
              "type": "array",
              "description": "How much is in the package",
              "items": {
                "type": "object",
                "properties": {
                  "quantity": {"type": ["number", "null"]},
                  "unit": {"type": ["string", "null"], "description": "e.g. 'Gummy Vitamin(s)'"},
                  "display": {"type": ["string", "null"], "description": "As printed, e.g. '75 Gummy Vitamin(s)'"}
                }
              }
            },
            "percent_dv_footnote": {"type": ["string", "null"], "description": "What the percent_daily_value figures are a percentage of, e.g. 'Percent Daily Values are based on a 2,000 calorie diet.'"},
            "claim_types": {"type": "array", "items": {"type": "string"}, "description": "LanguaL claim categories on the label, e.g. 'Structure/Function'"},
            "contacts": {
              "type": "array",
              "description": "Who makes or distributes the product, as printed",
              "items": {
                "type": "object",
                "properties": {
                  "role": {"type": ["string", "null"], "description": "The label's wording, e.g. 'Manufactured By'"},
                  "types": {"type": "array", "items": {"type": "string"}},
                  "name": {"type": ["string", "null"], "description": "Company name"},
                  "city": {"type": ["string", "null"]},
                  "state": {"type": ["string", "null"]},
                  "country": {"type": ["string", "null"]},
                  "web_address": {"type": ["string", "null"]}
                }
              }
            },
            "events": {
              "type": "array",
              "description": "Dated label events. off_market says whether; these say when",
              "items": {
                "type": "object",
                "properties": {
                  "date": {"type": ["string", "null"]},
                  "type": {"type": ["string", "null"], "description": "e.g. 'Off Market', 'Date entered into DSLD'"}
                }
              }
            },
            "pdf_url": {"type": ["string", "null"], "description": "DSLD's scan of the label, where it has one"},
            "off_market": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"product_id": 20581},
      {"product_id": "20581"}
    ]
  }
]
