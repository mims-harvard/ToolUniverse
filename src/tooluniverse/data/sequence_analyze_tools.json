[
  {
    "name": "Sequence_count_residues",
    "type": "SequenceAnalyzeTool",
    "description": "Count occurrences of a specific amino acid or nucleotide residue in a sequence. Accepts either a raw sequence string or a UniProt accession (fetches protein sequence from UniProt REST API). Reports count, fraction, percentage, and pageable 1-based positions, including explicit truncation and continuation fields for residues occurring more than 50 times.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "count_residues"
          ],
          "description": "Operation type",
          "default": "count_residues"
        },
        "sequence": {
          "type": "string",
          "description": "Sequence string (DNA/RNA/protein). Optional if uniprot_id is provided."
        },
        "uniprot_id": {
          "type": "string",
          "description": "UniProt accession to fetch sequence from (e.g., 'P00533' for EGFR). Optional if sequence is provided."
        },
        "residue": {
          "type": "string",
          "description": "Single character residue to count (e.g., 'C' for cysteine)"
        },
        "position_limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of matching 1-based residue positions to return on this page."
        },
        "position_offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into all matching residue positions. Continue with data.next_position_offset while data.positions_truncated is true."
        }
      },
      "required": [
        "residue"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "sequence_length": {
                  "type": "integer"
                },
                "fraction": {
                  "type": "number"
                },
                "percent": {
                  "type": "number"
                },
                "positions_1based": {
                  "type": "array"
                },
                "total_positions": {
                  "type": "integer"
                },
                "positions_returned": {
                  "type": "integer"
                },
                "position_limit": {
                  "type": "integer"
                },
                "position_offset": {
                  "type": "integer"
                },
                "positions_truncated": {
                  "type": "boolean"
                },
                "next_position_offset": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "residue": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Which residue was counted, e.g. 'C'. Echoes the request, so a count is never ambiguous about what it counted."
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Where the sequence came from, e.g. 'UniProt REST API' - as opposed to a sequence supplied by the caller."
                },
                "uniprot_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The accession the sequence was fetched for, e.g. 'P00533'. Says which isoform the count applies to."
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "count_residues",
        "uniprot_id": "P00533",
        "residue": "C"
      }
    ],
    "fields": {
      "operation": "count_residues"
    }
  },
  {
    "name": "Sequence_gc_content",
    "type": "SequenceAnalyzeTool",
    "description": "Calculate GC content of a DNA or RNA sequence. Reports GC count, GC fraction, GC percentage, and full nucleotide composition. Ambiguous bases (N) are excluded from the denominator. Useful for primer design, genome characterization, and codon usage analysis.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "gc_content"
          ],
          "description": "Operation type",
          "default": "gc_content"
        },
        "sequence": {
          "type": "string",
          "description": "DNA or RNA sequence string"
        }
      },
      "required": [
        "sequence"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "gc_fraction": {
                  "type": "number"
                },
                "gc_percent": {
                  "type": "number"
                },
                "length": {
                  "type": "integer"
                },
                "composition": {
                  "type": "object"
                },
                "gc_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Number of G and C bases counted, e.g. 11. The absolute count behind the percentage, which a short sequence makes essential - 100% of 2 bases is not a GC-rich sequence."
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "gc_content",
        "sequence": "ATGCGATCGATCGATCGATCG"
      }
    ],
    "fields": {
      "operation": "gc_content"
    }
  },
  {
    "name": "Sequence_reverse_complement",
    "type": "SequenceAnalyzeTool",
    "description": "Return the reverse complement of a DNA sequence. Supports A, T, C, G, and N bases. Useful for primer design, probe design, and strand orientation analysis.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "reverse_complement"
          ],
          "description": "Operation type",
          "default": "reverse_complement"
        },
        "sequence": {
          "type": "string",
          "description": "DNA sequence (A/T/C/G/N only)"
        }
      },
      "required": [
        "sequence"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "original": {
                  "type": "string"
                },
                "reverse_complement": {
                  "type": "string"
                },
                "length": {
                  "type": "integer"
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "reverse_complement",
        "sequence": "ATGCGATCG"
      }
    ],
    "fields": {
      "operation": "reverse_complement"
    }
  },
  {
    "name": "Sequence_stats",
    "type": "SequenceAnalyzeTool",
    "description": "Compute basic statistics for a DNA, RNA, or protein sequence. Auto-detects sequence type, reports length, full composition, and type-specific metrics (GC% for nucleotides, estimated monoisotopic molecular weight for proteins -- for the conventional average mass reported by ExPASy ProtParam/UniProt, use ProtParam_calculate instead). Accepts sequence string or UniProt accession.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "stats"
          ],
          "description": "Operation type",
          "default": "stats"
        },
        "sequence": {
          "type": "string",
          "description": "Sequence string. Optional if uniprot_id is provided."
        },
        "uniprot_id": {
          "type": "string",
          "description": "UniProt accession to fetch protein sequence from. Optional if sequence is provided."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "sequence_type": {
                  "type": "string"
                },
                "length": {
                  "type": "integer"
                },
                "composition": {
                  "type": "object"
                },
                "estimated_mw_monoisotopic_da": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Monoisotopic molecular weight in daltons, e.g. 8300.5 - computed from the most abundant isotope of each element, which is what mass spectrometry measures. The average mass reported beside it is a different number and the two are not interchangeable."
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "stats",
        "sequence": "MKTAYIAKQRQISFVKSHFSRQLEERLGLIEVQAPILSRVGDGTQDNLSGAEKAVQVKVKALPDAQFEVVHSLAK"
      }
    ],
    "fields": {
      "operation": "stats"
    }
  }
]
