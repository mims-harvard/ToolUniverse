[
  {
    "name": "Mondo_search_disease",
    "description": "Search Mondo diseases by name or keyword with exact offset pagination. Metadata reports total_results, has_more and next_offset; continue until has_more is false.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Disease name or keyword to search. Examples: 'Alzheimer', 'breast cancer', 'type 2 diabetes', 'Parkinson', 'cystic fibrosis', 'sickle cell'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Disease results per page (1-50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "mondo_search"
    },
    "type": "MonarchV3Tool",
    "test_examples": [
      {
        "query": "Alzheimer disease",
        "limit": 5
      },
      {
        "query": "breast cancer",
        "limit": 5
      },
      {
        "query": "type 2 diabetes"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Mondo disease identifier (e.g., MONDO:0004975)"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Disease name"
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Biolink category (biolink:Disease)"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Disease description"
              },
              "xref": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Cross-references to other ontologies (OMIM, Orphanet, DOID, MeSH, etc.)"
              },
              "deprecated": {
                "type": "boolean",
                "description": "True if this Mondo term is obsolete. Obsolete terms still match searches but carry no annotations."
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Monarch's relevance score, which is the order the rows are in. 'breast cancer' scores 287.25 and 'sporadic breast cancer' 51.77 for the query 'breast cancer'"
              },
              "match_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Whether the hit matched on the name, a synonym or the description"
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The disease's other names, which is often what the query actually matched"
              },
              "namespace": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Ontology namespace of the id, e.g. MONDO"
              },
              "provided_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which Monarch source asserted the record"
              },
              "xrefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Cross-references; the same list as `xref`, under the name the general search uses"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Symbol, for a hit that has one"
              },
              "taxon": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxon curie, null for a disease"
              },
              "taxon_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxon name, null for a disease"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Mondo_get_disease",
    "description": "Get detailed information about a disease from the Mondo Disease Ontology by its MONDO ID. Returns the disease name, description, synonyms, cross-references (OMIM, Orphanet, DOID, MeSH, ICD-10, NCIT, UMLS, SNOMED-CT), hierarchy (parent diseases), subtypes count, causal genes, inheritance pattern, and association counts (phenotypes, correlated genes, etc.). Essential for understanding disease classification and finding equivalent IDs across ontologies.",
    "parameter": {
      "type": "object",
      "properties": {
        "disease_id": {
          "type": "string",
          "description": "Mondo disease identifier. Examples: 'MONDO:0004975' (Alzheimer disease), 'MONDO:0005148' (type 2 diabetes mellitus), 'MONDO:0007254' (breast cancer), 'MONDO:0018076' (Huntington disease), 'MONDO:0009061' (cystic fibrosis)."
        }
      },
      "required": [
        "disease_id"
      ]
    },
    "fields": {
      "endpoint": "mondo_disease"
    },
    "type": "MonarchV3Tool",
    "test_examples": [
      {
        "disease_id": "MONDO:0004975"
      },
      {
        "disease_id": "MONDO:0005148"
      },
      {
        "disease_id": "MONDO:0009061"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Mondo disease identifier"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Disease name"
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Disease description"
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Known disease synonyms"
            },
            "xrefs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Cross-references (OMIM, Orphanet, DOID, MeSH, ICD-10, NCIT, UMLS, etc.)"
            },
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Mappings to external ontologies with URLs"
            },
            "parent_diseases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Parent disease categories in Mondo hierarchy"
            },
            "subtypes_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of disease subtypes (descendants)"
            },
            "causal_genes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene CURIE (e.g., HGNC:1884)"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene name"
                  }
                }
              },
              "description": "Known causal genes"
            },
            "inheritance": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "HPO inheritance ID (e.g., HP:0000006)"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Inheritance pattern name (e.g., Autosomal dominant)"
                }
              },
              "description": "Inheritance pattern if known"
            },
            "association_counts": {
              "type": "object",
              "description": "Counts of different association types (phenotypes, genes, etc.)"
            },
            "deprecated": {
              "type": "boolean",
              "description": "True if this Mondo term is obsolete. Monarch strips the annotations of obsolete terms, so empty fields mean 'not recorded here', not 'none exist'."
            },
            "replaced_by": {
              "type": [
                "string",
                "null"
              ],
              "description": "For an obsolete term, the current Mondo term that replaced it (present only when deprecated is true)."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Mondo_get_disease_phenotypes",
    "description": "Get HPO phenotypes associated with a Mondo disease using exact offset pagination. Metadata reports total_phenotypes, has_more and next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "disease_id": {
          "type": "string",
          "description": "Mondo disease identifier. Examples: 'MONDO:0004975' (Alzheimer disease, 95 phenotypes), 'MONDO:0005148' (type 2 diabetes, 50+ phenotypes), 'MONDO:0009061' (cystic fibrosis, 100+ phenotypes)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20,
          "description": "Phenotypes per page (1-200)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "disease_id"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "mondo_phenotypes"
    },
    "type": "MonarchV3Tool",
    "test_examples": [
      {
        "disease_id": "MONDO:0004975",
        "limit": 10
      },
      {
        "disease_id": "MONDO:0005148",
        "limit": 10
      },
      {
        "disease_id": "MONDO:0009061",
        "limit": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phenotype_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "HPO phenotype identifier (e.g., HP:0000726)"
              },
              "phenotype_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Phenotype name (e.g., 'Dementia')"
              },
              "disease_subtype": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Specific disease subtype contributing this phenotype"
              },
              "disease_subtype_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "MONDO ID of the contributing disease subtype"
              },
              "predicate": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Relationship predicate"
              },
              "negated": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether the phenotype association is negated"
              },
              "primary_knowledge_source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Primary data source for this association"
              },
              "frequency_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "HPO frequency term for how often this phenotype occurs in the disease, e.g. 'HP:0040280' (Obligate, 100%) through 'HP:0040285' (Excluded). The single most important qualifier of an HPO annotation."
              },
              "frequency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "That frequency term by name, e.g. 'Obligate', 'Very frequent', 'Occasional'. Null where the source recorded no frequency, which is not the same as 'rare'."
              },
              "observed_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many patients in the source cohort showed the phenotype, where the source gave a count."
              },
              "observed_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many were examined, i.e. the denominator for observed_count. A count without this says nothing."
              },
              "observed_percentage": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "The observed frequency as a percentage, where the source gave one directly."
              },
              "onset_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "HPO onset term, e.g. 'HP:0003577' (Congenital onset). A phenotype that appears in adulthood and one present at birth are different claims about the same disease."
              },
              "onset": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "That onset term by name, e.g. 'Congenital onset'."
              },
              "sex": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Sex the annotation is limited to, where the source limited it. Null means not sex-specific as recorded, not that both sexes were checked."
              },
              "evidence": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "ECO evidence codes behind the association, e.g. ['ECO:0000304'] (author statement). An author statement and an experimental observation are not the same support."
              },
              "knowledge_level": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Biolink knowledge level, e.g. 'knowledge_assertion' -- a curated claim -- as opposed to a prediction or a statistical association."
              },
              "agent_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Who produced the claim, e.g. 'manual_agent' (a human curator) rather than an automated or text-mining agent."
              },
              "publications": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "Publication curies supporting the association, where the source recorded them."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
