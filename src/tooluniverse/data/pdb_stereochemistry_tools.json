[
  {
    "name": "PDB_check_alpha_stereochemistry",
    "type": "PDBStereochemistryTool",
    "description": "Check C-alpha orientation in local legacy PDB or public 1UBQ. Reports L/D mirrors, degenerate centers, altloc and missing-atom coverage. Distance checks miss reflections. No reconstruction, full stereochemistry or binding validation.",
    "cacheable": false,
    "parameter": {
      "type": "object",
      "properties": {
        "pdb_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Local legacy PDB path; stays local. Exactly one input source."
        },
        "pdb_content": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inline legacy PDB coordinates; stays local. Exactly one input source."
        },
        "pdb_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Four-character public RCSB identifier, e.g. 1UBQ; downloads only this public PDB."
        },
        "model_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000,
          "description": "Model by file order, default 1. Models are never pooled."
        },
        "protein_residue_aliases": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^[A-Za-z0-9]{1,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "ALA",
              "ARG",
              "ASN",
              "ASP",
              "CYS",
              "GLN",
              "GLU",
              "GLY",
              "HIS",
              "ILE",
              "LEU",
              "LYS",
              "MET",
              "PHE",
              "PRO",
              "SER",
              "THR",
              "TRP",
              "TYR",
              "VAL"
            ]
          },
          "description": "Caller declarations mapping nonstandard protein names to canonical 3-letter amino acids; e.g. NLN to ASN for a known GLYCAM input."
        },
        "max_residue_details": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "description": "Bound residue detail lists, default 100. Counts and coordinate sequences stay complete; truncation is reported."
        },
        "expected_orientation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "L",
            "D",
            null
          ],
          "description": "Expected C-alpha geometric orientation, default L for natural encoded proteins; D is also supported. This is not formal CIP R/S."
        },
        "degenerate_tolerance_A3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 0.1,
          "description": "Absolute N/CA/C/CB determinant tolerance in A^3 for degenerate centers, default 1e-6."
        },
        "minimum_normalized_volume": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum absolute determinant divided by product of CA-N/CA-C/CA-CB lengths. Default0.1 flags near-planar centers;0 requests orientation only. A geometric diagnostic, not a calibrated energy cutoff."
        }
      },
      "oneOf": [
        {
          "required": [
            "pdb_path"
          ],
          "properties": {
            "pdb_path": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_content"
                ],
                "properties": {
                  "pdb_content": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_id"
                ],
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        {
          "required": [
            "pdb_content"
          ],
          "properties": {
            "pdb_content": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_path"
                ],
                "properties": {
                  "pdb_path": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_id"
                ],
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        {
          "required": [
            "pdb_id"
          ],
          "properties": {
            "pdb_id": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_path"
                ],
                "properties": {
                  "pdb_path": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_content"
                ],
                "properties": {
                  "pdb_content": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "data"
          ],
          "properties": {
            "status": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "required": [
                "input_sha256",
                "checked_centers",
                "opposite_or_degenerate_centers",
                "uncheckable_centers",
                "complete_coordinate_center_coverage",
                "all_coordinate_centers_match_expected",
                "structure_chemistry_verified"
              ],
              "properties": {
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checked_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "opposite_or_degenerate_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "uncheckable_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete_coordinate_center_coverage": {
                  "type": "boolean"
                },
                "all_coordinate_centers_match_expected": {
                  "type": "boolean"
                },
                "structure_chemistry_verified": {
                  "const": false,
                  "description": "Always false. The alpha-centre orientation is ONE chemistry check, not a verdict on the structure's chemistry: CIP R/S, Ile and Thr sidechain chirality, bond geometry and energy are all outside it. 'all_coordinate_centers_match_expected' is the field that carries this check's own result."
                },
                "binding_verified": {
                  "const": false,
                  "description": "Always false. It is here so a caller cannot read a stereochemistry pass as a binding check: this tool looks at C-alpha geometry and says nothing about whether a ligand binds. See 'scope'."
                },
                "pH_selectivity_verified": {
                  "const": false,
                  "description": "Always false, for the same reason as binding_verified: nothing here speaks to pH-dependent behaviour."
                },
                "coordinate_protein_like_residues": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Protein-like residues present in the coordinates. The denominator for coverage: the check can only speak about residues the file actually contains."
                },
                "glycine_nonchiral_residues": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Glycines, which have no C-beta and so no alpha centre to check. Subtracted before judging coverage, or every structure would look incompletely checked."
                },
                "matched_centers": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Centres whose orientation matched 'expected_orientation'."
                },
                "all_checked_centers_match": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "True when every centre that COULD be checked matched. Weaker than all_coordinate_centers_match_expected, which also requires that nothing was left uncheckable."
                },
                "counts_by_chain": {
                  "type": "object",
                  "description": "Per chain, how many centres came out in each orientation, e.g. {\"A\": {\"L\": 70}}. A single D centre in one chain is the finding this tool exists for, and the totals alone would bury it.",
                  "additionalProperties": {
                    "description": "Orientation counts for one chain, keyed by orientation."
                  }
                },
                "center_details": {
                  "type": "array",
                  "description": "Per-centre evidence, so a verdict can be checked rather than taken. Truncated; see center_details_truncated.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chain": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Chain id."
                      },
                      "segment_index": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Index of the segment within the chain."
                      },
                      "residue_number": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Residue sequence number."
                      },
                      "insertion_code": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "PDB insertion code, empty when none."
                      },
                      "residue_names": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Residue names at this position, more than one when alternates disagree."
                      },
                      "canonical_residue_name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The residue name used for the check."
                      },
                      "alternate_location": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Altloc identifier, empty when the atom has none."
                      },
                      "center_type": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Which centre was checked, e.g. 'alpha'."
                      },
                      "ordered_atoms": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "The four atoms in the order the determinant was computed from, e.g. ['CA','N','C','CB']. The sign of the determinant depends on this order, so it is stated."
                      },
                      "determinant_A3": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Signed volume of the four atoms, in cubic angstroms. Its sign is the orientation."
                      },
                      "normalized_determinant": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "The determinant divided by the bond lengths, so it can be compared against minimum_normalized_volume rather than against a raw volume that varies with geometry."
                      },
                      "orientation": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "'L' or 'D', or absent when the centre was degenerate."
                      },
                      "matches_expected": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "Whether this centre matched expected_orientation."
                      }
                    }
                  }
                },
                "center_details_truncated": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "True when more centres were checked than center_details lists. The counts are complete either way."
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "description": "One problem found while checking."
                  },
                  "description": "Problems encountered, e.g. missing atoms or unparseable residues."
                },
                "issue_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Total issues, which may exceed the length of 'issues'."
                },
                "issues_truncated": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "True when 'issues' was cut."
                },
                "checked_center_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Which centre type this run checked."
                },
                "input_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Where the structure came from: the PDB id fetched, or the uploaded file."
                },
                "input_model_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Models in the file. Only one is checked."
                },
                "selected_model_index": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Zero-based index of the model that was checked."
                },
                "selected_model_serial": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "That model's serial number as the file records it."
                },
                "expected_orientation": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The orientation the caller asked to verify, 'L' or 'D'. Echoed because every boolean in this result is relative to it."
                },
                "degenerate_tolerance_A3": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Normalized-volume magnitude below which a centre is called degenerate rather than L or D."
                },
                "minimum_normalized_volume": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The threshold a centre's normalized determinant must exceed to be judged at all."
                },
                "protein_residue_aliases": {
                  "description": "Non-standard residue names treated as their standard equivalents for this check."
                },
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "What this check does and does not cover, in words: C-alpha N/CA/C/CB orientation only, not CIP R/S, not Ile/Thr sidechain chirality, not energy or binding validation, and coordinate-only coverage."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          }
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "1UBQ",
        "expected_orientation": "L"
      },
      {
        "pdb_path": "tests/fixtures/pdb_inventory/1ubq_protein.pdb",
        "expected_orientation": "L"
      }
    ]
  },
  {
    "name": "PDB_check_beta_stereochemistry",
    "type": "PDBStereochemistryTool",
    "description": "Check natural Ile/Thr C-beta orientation in local legacy PDB or public1UBQ. Reports inverted/planar centers, missing-atom coverage, altlocs and no-site applicability. Complements C-alpha checking; no repair or binding validation.",
    "cacheable": false,
    "parameter": {
      "type": "object",
      "properties": {
        "pdb_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Local legacy PDB path; stays local. Exactly one input source."
        },
        "pdb_content": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inline legacy PDB coordinates; stays local. Exactly one input source."
        },
        "pdb_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Four-character public RCSB identifier, e.g. 1UBQ; downloads only this public PDB."
        },
        "model_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000,
          "description": "Model by file order, default 1. Models are never pooled."
        },
        "protein_residue_aliases": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^[A-Za-z0-9]{1,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "ALA",
              "ARG",
              "ASN",
              "ASP",
              "CYS",
              "GLN",
              "GLU",
              "GLY",
              "HIS",
              "ILE",
              "LEU",
              "LYS",
              "MET",
              "PHE",
              "PRO",
              "SER",
              "THR",
              "TRP",
              "TYR",
              "VAL"
            ]
          },
          "description": "Caller declarations mapping nonstandard protein names to canonical 3-letter amino acids; e.g. NLN to ASN for a known GLYCAM input."
        },
        "max_residue_details": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "description": "Bound residue detail lists, default 100. Counts and coordinate sequences stay complete; truncation is reported."
        },
        "expected_orientation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "natural",
            "opposite",
            null
          ],
          "description": "Expected Ile/Thr beta geometry, default natural; opposite is supported. Independent of alpha L/D labels and not formal CIP R/S."
        },
        "degenerate_tolerance_A3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 0.1,
          "description": "Absolute CB/CA/CG1-or-OG1/CG2 determinant tolerance in A^3 for degenerate beta centers, default1e-6."
        },
        "minimum_normalized_volume": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum absolute beta determinant divided by product of center-neighbor lengths; default0.1 flags near-planar centers,0 requests orientation only. Geometric diagnostic, not an energy cutoff."
        }
      },
      "oneOf": [
        {
          "required": [
            "pdb_path"
          ],
          "properties": {
            "pdb_path": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_content"
                ],
                "properties": {
                  "pdb_content": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_id"
                ],
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        {
          "required": [
            "pdb_content"
          ],
          "properties": {
            "pdb_content": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_path"
                ],
                "properties": {
                  "pdb_path": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_id"
                ],
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        {
          "required": [
            "pdb_id"
          ],
          "properties": {
            "pdb_id": {
              "type": "string"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "pdb_path"
                ],
                "properties": {
                  "pdb_path": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "pdb_content"
                ],
                "properties": {
                  "pdb_content": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "data"
          ],
          "properties": {
            "status": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "required": [
                "input_sha256",
                "checked_centers",
                "opposite_or_degenerate_centers",
                "uncheckable_centers",
                "complete_coordinate_center_coverage",
                "all_coordinate_centers_match_expected",
                "structure_chemistry_verified",
                "checked_center_type",
                "eligible_beta_residues",
                "beta_check_applicable"
              ],
              "properties": {
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checked_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "opposite_or_degenerate_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "uncheckable_centers": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete_coordinate_center_coverage": {
                  "type": "boolean"
                },
                "all_coordinate_centers_match_expected": {
                  "type": "boolean"
                },
                "structure_chemistry_verified": {
                  "const": false
                },
                "binding_verified": {
                  "const": false
                },
                "pH_selectivity_verified": {
                  "const": false
                },
                "checked_center_type": {
                  "const": "beta"
                },
                "eligible_beta_residues": {
                  "type": "integer",
                  "minimum": 0
                },
                "beta_check_applicable": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "True if recognized Ile/Thr sites exist; false only when no sites and no uncheckable identities. Null when applicability cannot be established."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          }
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "1UBQ",
        "expected_orientation": "natural"
      },
      {
        "pdb_path": "tests/fixtures/pdb_inventory/1ubq_protein.pdb",
