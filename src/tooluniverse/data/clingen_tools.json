  {
    "name": "ClinGen_get_variant_classifications",
    "description": "Get correctly filtered and paginated variant pathogenicity classifications from the ClinGen Evidence Repository Summary API. Returns the exact total and explicit next_offset, plus expert-curated classification, CAID/ClinVar IDs, condition and inheritance, met/unmet ACMG criteria, evidence summary, expert panel, dates, version, and HGVS forms. Filter by exact gene symbol or by CAID, ClinVar Variation ID, or HGVS/protein change.",
    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Optional: Filter by gene symbol"
        },
        "variant": {
          "type": "string",
          "description": "Optional: Filter by CAID (e.g. CA114360), numeric ClinVar Variation ID, HGVS notation, or protein change"
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum classifications to return from this page"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based classification offset; follow next_offset for later records"
        }
      },
      "required": []
    },
    "fields": {
      "operation": "get_variant_classifications",
      "timeout": 120
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Variation": {"type": ["string", "null"]},
          "ClinVar Variation Id": {"type": ["string", "null"]},
          "HGNC Gene Symbol": {"type": ["string", "null"]},
          "Disease": {"type": ["string", "null"]},
          "Mondo Id": {"type": ["string", "null"]},
          "Assertion": {"type": ["string", "null"]},
          "Expert Panel": {"type": ["string", "null"]},
          "CAID": {"type": ["string", "null"]},
          "Mode of Inheritance": {"type": ["string", "null"]},
          "Met Criteria": {"type": "array"},
          "Unmet Criteria": {"type": "array"},
          "Summary": {"type": ["string", "null"]},
          "Approved Date": {"type": ["string", "null"]},
          "Published Date": {"type": ["string", "null"]},
          "Document Version": {"type": ["string", "null"]},
          "UUID": {"type": ["string", "null"]},
          "HGVS": {"type": "array"}
        }
      }
    },
    "test_examples": [
      {"gene": "BRCA1", "limit": 5},
      {"gene": "PAH", "limit": 5, "offset": 5}
    ]
  }
