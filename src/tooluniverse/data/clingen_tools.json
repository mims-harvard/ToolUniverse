    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Optional: Filter by gene symbol"
        },
        "include_regions": {
          "type": "boolean",
          "description": "Include recurrent CNV regions (default: false)",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum curations per page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based curation offset. Continue with next_offset while has_more is true."
        }
      },
      "required": []
    },
    "fields": {
      "operation": "get_dosage_sensitivity",
      "timeout": 120
    },
    "return_schema": {
      "type": "array",
      "items": {"type": "object"}
    },
    "test_examples": [
      {},
      {"include_regions": true}
    ]
  },
