[
  {
    "name": "ClinGen_search_gene_validity",
    "description": "Search ClinGen gene-disease validity curations by gene symbol. Returns classification (Definitive, Strong, Moderate, Limited, Disputed, Refuted), disease associations, and inheritance patterns. Essential for ACMG variant classification. Example: BRCA1 returns validity scores for hereditary breast/ovarian cancer.",
    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol to search (e.g., BRCA1, TP53, CFTR)"
        }
      },
      "required": ["gene"]
    },
    "fields": {
      "operation": "search_gene_validity",
      "timeout": 60
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "GENE SYMBOL": {"type": ["string", "null"]},
          "GENE ID (HGNC)": {"type": ["string", "null"]},
          "DISEASE LABEL": {"type": ["string", "null"]},
          "DISEASE ID (MONDO)": {"type": ["string", "null"]},
          "CLASSIFICATION": {"type": ["string", "null"]},
          "MOI": {"type": ["string", "null"]},
          "SOP": {"type": ["string", "null"]},
          "GCEP": {"type": ["string", "null"]},
          "ONLINE REPORT": {"type": ["string", "null"]},
          "CLASSIFICATION DATE": {"type": ["string", "null"]}
        }
      }
    },
    "test_examples": [
      {"gene": "BRCA1"},
      {"gene": "TP53"}
    ]
  },
  {
    "name": "ClinGen_get_gene_validity",
    "description": "Get ClinGen gene-disease validity curations with classifications (Definitive, Strong, Moderate, Limited). The full catalog contains thousands of rows and is paged with limit/offset; total and next_offset make every curation reachable. An optional exact gene-symbol filter is available.",
    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Optional: Filter by gene symbol"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum curations per page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based curation offset. Continue with next_offset while has_more is true."
        }
      },
      "required": []
    },
    "fields": {
      "operation": "get_gene_validity",
      "timeout": 120
    },
    "return_schema": {
      "type": "array",
      "items": {"type": "object"}
    },
    "test_examples": [
      {},
      {"gene": "CFTR"}
    ]
  },
  {
    "name": "ClinGen_search_dosage_sensitivity",
    "description": "Search ClinGen dosage sensitivity curations by gene symbol. Returns haploinsufficiency (HI) and triplosensitivity (TS) scores (0-3 scale). Score 3 = Sufficient evidence for dosage pathogenicity. Critical for CNV interpretation. Example: MECP2 has HI score of 3.",
    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol to search (e.g., MECP2, PMP22, RAI1)"
        }
      },
      "required": ["gene"]
    },
    "fields": {
      "operation": "search_dosage_sensitivity",
      "timeout": 60
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "GENE SYMBOL": {"type": ["string", "null"]},
          "HGNC ID": {"type": ["string", "null"]},
          "HAPLOINSUFFICIENCY": {"type": ["string", "null"]},
          "TRIPLOSENSITIVITY": {"type": ["string", "null"]},
          "ONLINE REPORT": {"type": ["string", "null"]},
          "DATE": {"type": ["string", "null"]}
        }
      }
    },
    "test_examples": [
      {"gene": "MECP2"},
      {"gene": "PMP22"}
    ]
  },
  {
    "name": "ClinGen_get_dosage_sensitivity",
