  {
    "name": "ClinGen_search_actionability",
    "description": "Search ClinGen clinical actionability across both adult and pediatric contexts by gene. Returns actionability data from both contexts for comparison. Useful for comprehensive actionability assessment of a gene across age groups.",
    "type": "ClinGenTool",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol to search (e.g., BRCA1, MLH1, LDLR)"
        }
      },
      "required": ["gene"]
    },
    "fields": {
      "operation": "search_actionability",
      "timeout": 200
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "Adult": {"type": "array"},
            "Pediatric": {"type": "array"}
          }
        },
        "gene_searched": {"type": "string"},
        "adult_count": {"type": "integer"},
        "pediatric_count": {"type": "integer"},
        "source": {"type": "string"}
      }
    },
    "test_examples": [
      {"gene": "BRCA1"},
      {"gene": "MLH1"}
    ]
