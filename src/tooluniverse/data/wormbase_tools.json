  {
    "name": "WormBase_get_orthologs",
    "description": "Get cross-species orthologs, nematode orthologs, and within-worm paralogs. All three lists are independently recoverably paginated with the same offset; continue while data.has_more is true and consult each category's count/next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "WBGene identifier or gene name. Examples: 'WBGene00006818', 'unc-86'."
        },
        "ortholog_limit": {
          "type": "integer",
          "description": "Maximum rows per cross-species and nematode ortholog list (default 50).",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "paralog_limit": {
          "type": "integer",
          "description": "Maximum paralogs per page (default 30).",
          "default": 30,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset applied independently to all three lists.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_orthologs"
    },
    "type": "WormBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "WBGene00006818"
      },
      {
        "gene_id": "unc-86"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wormbase_id": {
              "type": "string"
            },
            "cross_species_ortholog_count": {
              "type": "integer"
            },
            "cross_species_ortholog_returned": {"type": "integer"},
            "cross_species_ortholog_has_more": {"type": "boolean"},
            "cross_species_ortholog_next_offset": {"type": ["integer", "null"]},
            "cross_species_orthologs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ortholog_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ortholog_label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "species": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "methods": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "nematode_ortholog_count": {
              "type": "integer"
            },
            "nematode_ortholog_returned": {"type": "integer"},
            "nematode_ortholog_has_more": {"type": "boolean"},
            "nematode_ortholog_next_offset": {"type": ["integer", "null"]},
            "nematode_orthologs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "paralog_count": {
              "type": "integer"
            },
            "paralog_returned": {"type": "integer"},
            "paralog_has_more": {"type": "boolean"},
            "paralog_next_offset": {"type": ["integer", "null"]},
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "paralogs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "WormBase_get_interactions",
    "description": "Get physical and genetic interactions for a C. elegans gene. Both lists are independently recoverably paginated with the same offset; continue while data.has_more is true and use each category's next_offset/count fields to quantify completeness.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "WBGene identifier or gene name. Examples: 'WBGene00006818', 'unc-86'."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum interactions to return per category (default 150).",
          "default": 150,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset applied independently to physical and genetic lists.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_interactions"
    },
    "type": "WormBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "WBGene00006818"
      },
      {
        "gene_id": "unc-86"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wormbase_id": {
              "type": "string"
            },
            "total_interactions": {
              "type": "integer"
            },
            "physical_count": {
              "type": "integer"
            },
            "physical_returned": {"type": "integer"},
            "physical_has_more": {"type": "boolean"},
            "physical_next_offset": {"type": ["integer", "null"]},
            "physical_interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "interactor_1": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interactor_1_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interactor_2": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interactor_2_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interaction_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "citation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "genetic_count": {
              "type": "integer"
            },
            "genetic_returned": {"type": "integer"},
            "genetic_has_more": {"type": "boolean"},
            "genetic_next_offset": {"type": ["integer", "null"]},
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "genetic_interactions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "WormBase_get_human_diseases",
    "description": "Get human disease models (Disease Ontology / DOID) for a C. elegans gene from WormBase, inferred by orthology to human disease genes. Accepts a WBGene ID or gene name. Example: WBGene00006818 (unc-86) is a potential model for DOID:0110546 'autosomal dominant nonsyndromic deafness 15', inferred by orthology to human HGNC:9220.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "WBGene identifier or gene name. Examples: 'WBGene00006818', 'unc-86'."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_human_diseases"
    },
    "type": "WormBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "WBGene00006818"
      },
      {
        "gene_id": "unc-86"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "wormbase_id": {
              "type": "string"
            },
            "human_gene_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "disease_count": {
              "type": "integer"
            },
            "diseases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "disease_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "disease_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "model_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
