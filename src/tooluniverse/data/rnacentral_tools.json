[
  {
    "name": "RNAcentral_search",
    "type": "RNAcentralSearchTool",
    "description": "Search aggregated ncRNA records with explicit page pagination. Preserves RNAcentral's next URL and reports returned, truncation, and next_page metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Keyword, accession, or sequence-based query (per RNAcentral API)."
        },
        "page_size": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of records per page (1\u2013100)."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "One-based page number. Continue with metadata.next_page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://rnacentral.org/api/v1/rna/",
      "format": "json"
    },
    "return_schema": {
      "type": "object",
      "description": "Raw RNAcentral paginated RNA list payload",
      "additionalProperties": true,
      "properties": {
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "rnacentral_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "rna_type": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "results"
      ]
    },
    "test_examples": [
      {
        "query": "let-7",
        "page_size": 1
      },
      {
        "query": "U6",
        "page_size": 1
      }
    ],
    "label": [
      "RNAcentral",
      "ncRNA",
      "Search"
    ],
    "metadata": {
      "tags": [
        "rna",
        "mirna",
        "lncrna",
        "annotation"
      ],
      "estimated_execution_time": "< 2 seconds"
    }
  },
  {
    "name": "RNAcentral_get_by_accession",
    "type": "RNAcentralGetTool",
    "description": "Retrieve a single RNAcentral entry by accession for detailed annotations and source cross-references. Use for cross-database ID mapping and metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "RNAcentral accession (e.g., 'URS000075C808')."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://rnacentral.org/api/v1/rna/{accession}",
      "format": "json"
    },
    "return_schema": {
      "type": "object",
      "description": "RNAcentral accession response",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "test_examples": [
      {
        "accession": "URS000075C808"
      }
    ],
    "label": [
      "RNAcentral",
      "ncRNA",
      "Record"
    ],
    "metadata": {
      "tags": [
        "rna",
        "accession",
        "annotation"
      ],
      "estimated_execution_time": "< 2 seconds"
    }
  },
  {
    "name": "RNAcentral_get_xrefs_and_pubs",
    "type": "RNAcentralGetTool",
    "description": "Get paginated cross-references and literature for an RNAcentral entry in one call. xrefs_page and publications_page advance independently; follow each resource's next_page while has_more is true. Counts are upstream record counts, and publication PMIDs are not guaranteed unique because RNAcentral may retain citation variants.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "minLength": 1,
          "description": "RNAcentral URS identifier (e.g., 'URS000063A371', 'URS000075C808')."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Records per sub-resource page (1-50)."
        },
        "xrefs_page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based xref page; continue with data.xrefs.next_page."
        },
        "publications_page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based publication page; continue with data.publications.next_page."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://rnacentral.org/api/v1/rna/{accession}/[xrefs,publications]",
      "sub_resources": [
        "xrefs",
        "publications"
      ],
      "format": "json"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "xrefs": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "returned": {"type": "integer"},
                "page": {"type": "integer"},
                "page_size": {"type": "integer"},
                "has_more": {"type": "boolean"},
                "next_page": {"type": ["integer", "null"]},
                "previous_page": {"type": ["integer", "null"]},
                "truncated": {"type": "boolean"},
                "result_set_complete": {"type": "boolean"}
              },
              "required": ["count", "results", "returned", "page", "page_size", "has_more", "next_page", "previous_page", "truncated", "result_set_complete"]
            },
            "publications": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "returned": {"type": "integer"},
                "page": {"type": "integer"},
                "page_size": {"type": "integer"},
                "has_more": {"type": "boolean"},
                "next_page": {"type": ["integer", "null"]},
                "previous_page": {"type": ["integer", "null"]},
                "truncated": {"type": "boolean"},
                "result_set_complete": {"type": "boolean"}
              },
              "required": ["count", "results", "returned", "page", "page_size", "has_more", "next_page", "previous_page", "truncated", "result_set_complete"]
            }
          },
          "required": ["xrefs", "publications"]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "accession": "URS000063A371"
      }
    ],
    "label": [
      "RNAcentral",
      "ncRNA",
      "CrossReference"
    ],
    "metadata": {
      "tags": [
        "rna",
        "xrefs",
        "publications",
        "annotation"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  },
  {
    "name": "RNAcentral_get_region_ncRNAs",
    "type": "RNAcentralGetTool",
    "description": "List all RNAcentral non-coding RNAs overlapping a genome locus, aggregated from 50+ member databases (miRBase, snoRNA, tRNA, lncRNA, piRNA, etc.). Provide a species (default 'homo_sapiens') and either a 'region' string ('2:39745816-39826679') or discrete 'chromosome'/'start'/'end'. Returns overlapping ncRNA transcripts and their exon features with biotype, strand and coordinates, split into data.transcripts and data.exons. Use to annotate what ncRNAs sit in a region of interest. Public, no authentication.",
    "parameter": {
      "type": "object",
      "properties": {
        "region": {
          "type": [
            "string",
            "null"
          ],
          "description": "Locus as 'chr:start-end' (1-based), e.g. '2:39745816-39826679'. Omit if giving chromosome/start/end."
        },
        "species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ensembl species slug (default 'homo_sapiens'). E.g. 'mus_musculus', 'danio_rerio'."
        },
        "chromosome": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chromosome name without 'chr' prefix, e.g. '2'. Used with start/end when 'region' is omitted."
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region start (1-based). Used with chromosome/end when 'region' is omitted."
        },
        "end": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region end (1-based). Used with chromosome/start when 'region' is omitted."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://rnacentral.org/api/v1/overlap/region/{species}/{region}",
      "region_overlap": true,
      "format": "json"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "features": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "transcripts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "exons": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "transcript_count": {
              "type": "integer"
            },
            "exon_count": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "region": "2:39745816-39826679",
        "species": "homo_sapiens"
      }
    ],
    "label": [
      "RNAcentral",
      "ncRNA",
      "GenomeRegion"
    ],
    "metadata": {
      "tags": [
        "rna",
        "ncrna",
        "genome",
        "region",
        "annotation"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  }
]
