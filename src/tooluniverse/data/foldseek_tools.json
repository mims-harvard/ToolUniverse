[
  {
    "name": "Foldseek_search_structure",
    "description": "Submit a Foldseek structural similarity search for a PDB structure and wait for completion. Returns the ticket_id, exact total_hits, and a recoverable offset page ranked by e-value. Continue later pages efficiently with Foldseek_get_result using the same ticket_id and data.next_offset; broad queries can have hundreds of hits (4HHB against pdb100 currently has more than 900).",
    "parameter": {
      "type": "object",
      "properties": {
        "pdb_id": {
          "type": "string",
          "description": "PDB ID to search (e.g., '4HHB', '1CRN'). The structure will be fetched from RCSB PDB. Required: this API only accepts structure-based (3D coordinate) search, not a raw sequence."
        },
        "sequence": {
          "type": "string",
          "description": "NOT SUPPORTED as a standalone input: the Foldseek search API requires a 3D structure, so submitting a raw sequence without pdb_id always fails. Provide pdb_id instead. Alias: 'query'."
        },
        "query": {
          "type": "string",
          "description": "NOT SUPPORTED as a standalone input: see 'sequence'. Provide pdb_id instead."
        },
        "database": {
          "type": "string",
          "description": "Database to search against. Options: 'afdb50' (AlphaFold DB 50% clustered, default), 'afdb-swissprot' (AlphaFold SwissProt), 'afdb-proteome' (AlphaFold proteomes), 'pdb100' (PDB), 'gmgcl_id' (GMGC), 'bfmd' (ESMAtlas), 'cath50' (CATH), 'mgnify_esm30' (MGnify ESM).",
          "default": "afdb50"
        },
        "mode": {
          "type": "string",
          "description": "Search mode: '3diaa' (fast 3Di+AA, default), 'tmalign' (TM-align, slower but more sensitive).",
          "default": "3diaa"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results to return (default 10, max 50).",
          "default": 10
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset in the complete ranked hit list. Use the returned ticket_id with Foldseek_get_result for subsequent pages.",
          "default": 0
        }
      },
      "required": []
    },
    "fields": {
      "operation": "search"
    },
    "type": "FoldseekTool",
    "test_examples": [
      {
        "pdb_id": "1CRN",
        "database": "afdb50",
        "mode": "3diaa",
        "max_results": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "ticket_id": {
              "type": ["string", "null"]
            },
            "alignments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "seq_identity": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "e_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "query_start": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "query_end": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "target_start": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "target_end": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "alignment_length": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "target_description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_hits": {
              "type": "integer"
            },
            "returned": {"type": "integer"},
            "offset": {"type": "integer"},
            "max_results": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "result_set_complete": {"type": "boolean"}
          },
          "required": [
            "query",
            "alignments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Foldseek_get_result",
    "description": "Get a recoverable offset page from a previously submitted Foldseek ticket. Completed jobs return exact total_hits, has_more, and next_offset without resubmitting the structural search; pending jobs return their current status.",
    "parameter": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "description": "Foldseek job ticket ID returned from a previous search submission."
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results to return (default 10, max 50).",
          "default": 10
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset in the complete ranked hit list. Continue with data.next_offset.",
          "default": 0
        }
      },
      "required": [
        "ticket_id"
      ]
    },
    "fields": {
      "operation": "get_result"
    },
    "type": "FoldseekTool",
    "test_examples": [],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "ticket_id": {
              "type": ["string", "null"]
            },
            "job_status": {
              "type": "string"
            },
            "alignments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "seq_identity": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "e_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_hits": {
              "type": "integer"
            },
            "returned": {"type": "integer"},
            "offset": {"type": "integer"},
            "max_results": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "result_set_complete": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
