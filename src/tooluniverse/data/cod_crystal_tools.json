              },
              "Zprime": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Z' (formula units per asymmetric unit)"
              },
              "nel": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Number of distinct elements"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Publication DOI"
              },
              "journal": {
                "type": [
                  "string",
                  "null"
                ],
