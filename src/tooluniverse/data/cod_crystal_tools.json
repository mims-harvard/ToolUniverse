[
  {
    "name": "COD_search_structures",
    "description": "Search the Crystallography Open Database (COD) by chemical formula, elements, space group, mineral name, or compound name with recoverable client-side offset pagination. COD's public JSON endpoint ignores limit/results/offset/page, so this tool fetches the exact upstream set and exposes metadata.total_results, has_more and next_offset; continue until has_more is false. At least one search filter is required. Full upstream records are preserved.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "Alias for 'text'. Free text search across titles, keywords, and compound names. Examples: 'aspirin', 'perovskite', 'diamond'"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free text search across titles, keywords, and compound names. Examples: 'aspirin', 'perovskite', 'diamond', 'zeolite', 'ice'"
        },
        "formula": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chemical formula to search (use spaces between elements). Examples: 'Fe2 O3', 'Si O2', 'Na Cl', 'C H4'. Exact formula matching."
        },
        "el1": {
          "type": [
            "string",
            "null"
          ],
          "description": "First required element (chemical symbol). Examples: 'Cu', 'Fe', 'Si', 'C', 'N'"
        },
        "el2": {
          "type": [
            "string",
            "null"
          ],
          "description": "Second required element (chemical symbol)"
        },
        "el3": {
          "type": [
            "string",
            "null"
          ],
          "description": "Third required element (chemical symbol)"
        },
        "nel": {
          "type": [
            "string",
            "null"
          ],
          "description": "Number of distinct elements in formula (e.g., '2' for binary compounds, '3' for ternary)"
        },
        "commonname": {
          "type": [
            "string",
            "null"
          ],
          "description": "Common/trivial compound name (partial, case-insensitive), applied client-side to each row's 'commonname' field after a free-text search. Examples: 'aspirin', 'perovskite', 'zeolite', 'diamond'"
        },
        "mineral": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mineral name (partial, case-insensitive). COD's server has no working mineral filter, so this runs a free-text search and keeps rows whose own 'mineral' field contains the value. Examples: 'calcite', 'pyrite', 'quartz'"
        },
        "spacegroup": {
          "type": [
            "string",
            "null"
          ],
          "description": "Alias for 'sg'. Space group symbol (Hermann-Mauguin notation). Examples: 'P 21/c', 'Fm -3 m', 'P 1'"
        },
        "sg": {
          "type": [
            "string",
            "null"
          ],
          "description": "Space group symbol (Hermann-Mauguin notation). Examples: 'P 21/c', 'Fm -3 m', 'P 1'"
        },
        "sgNumber": {
          "type": [
            "string",
            "null"
          ],
          "description": "Space group number (1-230). Examples: '225' (Fm-3m, FCC metals), '62' (Pnma, common for perovskites)"
        },
        "max_results": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Alias for limit. Page size from 1 to 500; default 100."
        },
        "results": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Legacy alias for limit. Page size from 1 to 500; default 100."
        },
        "limit": {
          "type": "integer",
          "description": "Client-side page size, 1-500 (default 100). Server-side default is 100. Left undeclared as a schema default so it cannot collide with the max_results/results aliases.",
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based client-side offset. Continue with metadata.next_offset while metadata.has_more is true.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://www.crystallography.net/cod/result",
      "params": {
        "format": "json"
      }
    },
    "type": "CODTool",
    "test_examples": [
      {
        "el1": "Si",
        "el2": "O",
        "nel": "2",
        "results": 10
      },
      {
        "mineral": "calcite",
        "results": 5
      },
      {
        "el1": "Cu",
        "el2": "O",
        "nel": "2",
        "sgNumber": "225",
        "results": 5
      },
      {
        "text": "aspirin",
        "results": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of crystal structures matching the search criteria",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "COD structure file ID"
              },
              "formula": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Chemical formula"
              },
              "calcformula": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commonname": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common compound name"
              },
              "mineral": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Mineral name"
              },
              "chemname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sg": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Space group symbol"
              },
              "sgNumber": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Space group number (1-230)"
              },
              "a": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter a (Angstroms)"
              },
              "b": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter b (Angstroms)"
              },
              "c": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter c (Angstroms)"
              },
              "alpha": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle alpha (degrees)"
              },
              "beta": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle beta (degrees)"
              },
              "gamma": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle gamma (degrees)"
              },
              "vol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell volume (Angstroms^3)"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Publication DOI"
              },
              "journal": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "year": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authors": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Diffraction method"
              },
              "radiation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Rall": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The R factor over all reflections: how closely the refined model agrees with the measured data. Lower is better; '0.028' on the row measured. A structure with no R factor has not been refined against data you can check."
              },
              "Z": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Formula units per unit cell."
              },
              "Zprime": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Formula units per asymmetric unit."
              },
              "cellformula": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The formula of the CONTENTS OF THE UNIT CELL -- Z times the chemical formula. Measured '- Ca4 Mg4 O24 Si8 -' on a row whose `formula` is '- Ca Mg O6 Si2 -'. Read as the compound's formula it multiplies every count by Z."
              },
              "compoundsource": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Where the sample came from: a mineral locality ('DeKalb, New York') or 'synthetic'. A natural specimen and a synthetic preparation of the same formula are different samples and often different structures."
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Date of the COD revision this record was last changed in, 'YYYY-MM-DD' ('2023-03-26')."
              },
              "diffrpressure": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Pressure during the diffraction experiment, in kPa as COD stores it. Measured '100' -- one atmosphere -- on a diopside row whose paper is titled 'at pressure to 10 GPa Sample: P = 1 atm'. A structure measured under pressure is not the ambient structure."
              },
              "firstpage": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "First page of the paper in `journal`."
              },
              "flags": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "COD's own record flags. 'has coordinates' on all 15 rows measured; a record without it carries no atomic coordinates, so it cannot be used as a structure."
              },
              "lastpage": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Last page of the paper in `journal`."
              },
              "nel": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "How many distinct elements the record's own formula contains. Measured '4' on all ten rows returned for a query that asked nel='2' (diopside, Ca Mg Si O), so COD does not apply the nel filter to the result set -- read this field rather than trusting the parameter."
              },
              "sgHall": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Space group in Hall notation ('-C 2yc'), the machine-readable form. `sg` is the Hermann-Mauguin symbol ('C 1 2/c 1') and `sgNumber` the International Tables number; all three name the same group."
              },
              "siga": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Estimated standard deviation of cell parameter `a`, same units. A cell edge without its e.s.d. cannot honestly be compared with another."
              },
              "sigb": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Estimated standard deviation of cell parameter `b`."
              },
              "sigbeta": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Estimated standard deviation of cell angle `beta`, in degrees."
              },
              "sigc": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Estimated standard deviation of cell parameter `c`."
              },
              "svnrevision": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The COD subversion revision the record was last changed in ('282068'). Two answers citing the same `file` at different revisions are not the same deposition state."
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Clock time of that revision, 'HH:MM:SS' ('10:11:39'). Read with `date` and `svnrevision`."
              },
              "volume": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The JOURNAL volume the paper appeared in -- '93' for American Mineralogist 2008, '1930' for a Zentralblatt entry. It is not a unit-cell volume; `vol` is."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "COD_get_structure",
    "description": "Get the complete source record for one seven-digit Crystallography Open Database entry ID. Validates that the returned file ID matches the request and reports missing IDs explicitly. Returns all upstream crystallographic and publication fields, including unit cell, space group, formula, names, Z, R factors, DOI, journal, authors, method and radiation.",
    "parameter": {
      "type": "object",
      "properties": {
        "cod_id": {
          "type": "string",
          "description": "Alias for 'id'. COD structure entry ID (numeric string). Examples: '9008460' (Aluminum), '1011240' (Hematite Fe2O3), '5900000' (Methane), '1515581' (Aspirin)"
        },
        "id": {
          "type": "string",
          "description": "COD structure entry ID (numeric string). Examples: '9008460' (Aluminum), '1011240' (Hematite Fe2O3), '5900000' (Methane), '1515581' (Aspirin)"
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://www.crystallography.net/cod/result",
      "params": {
        "format": "json"
      }
    },
    "type": "CODTool",
    "test_examples": [
      {
        "id": "9008460"
      },
      {
        "id": "1011240"
      },
      {
        "id": "5900000"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "Array with single crystal structure entry",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "COD structure file ID"
              },
              "formula": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Chemical formula (e.g., '- Fe2 O3 -')"
              },
              "calcformula": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Calculated formula"
              },
              "cellformula": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell formula"
              },
              "commonname": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common compound name"
              },
              "mineral": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Mineral name (e.g., 'Hematite')"
              },
              "chemname": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "IUPAC chemical name"
              },
              "sg": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Space group symbol (Hermann-Mauguin notation)"
              },
              "sgHall": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Hall space group symbol"
              },
              "sgNumber": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Space group number (1-230)"
              },
              "a": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter a (Angstroms)"
              },
              "b": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter b (Angstroms)"
              },
              "c": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell parameter c (Angstroms)"
              },
              "alpha": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle alpha (degrees)"
              },
              "beta": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle beta (degrees)"
              },
              "gamma": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell angle gamma (degrees)"
              },
              "vol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit cell volume (Angstroms^3)"
              },
              "Z": {
                "type": [
                  "string",
