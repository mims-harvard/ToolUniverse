[
  {
    "name": "RGD_get_gene",
    "description": "Get detailed rat gene information from the Rat Genome Database by RGD ID. Returns gene symbol, name, description (including AGR-aggregated functional summary with disease associations, pathways, and interactions), gene type, and Ensembl cross-reference. Use when looking up specific rat genes for toxicology, pharmacology, or disease model research.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (numeric, e.g., '2218' for Brca1). Can include 'RGD:' prefix."
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_gene"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218"
      },
      {
        "rgd_id": "RGD:3001"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_search_genes",
    "description": "Search rat, human, or mouse genes through RGD/Alliance by symbol or keyword. Returns IDs, symbols, names, species, and every synonym with synonym_count; aliases are not limited to the former first five. Use for gene resolution, ortholog work, toxicology, and disease models.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or keyword (e.g., 'Brca1', 'Tp53', 'insulin')"
        },
        "species": {
          "type": "string",
          "description": "Species to search: 'rat' (default), 'human', 'mouse'",
          "default": "rat"
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search_genes"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "query": "Brca1"
      },
      {
        "query": "Tp53",
        "species": "rat"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_annotations",
    "description": "Get disease, phenotype, pathway, GO, and expression annotations for an RGD gene with limit/offset pagination and explicit total/has_more metadata. Returns ontology terms, evidence codes, qualifiers, data sources, and complete annotation notes; notes are not shortened. Filter by aspect: D=Disease, P=Pathway, W=Phenotype, F=Molecular Function, C=Cellular Component, E=Expression.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (e.g., '2218' for Brca1)"
        },
        "aspect": {
          "type": "string",
          "description": "Filter by annotation type: 'D' (Disease), 'P' (Pathway), 'W' (Phenotype), 'F' (Function), 'C' (Component), 'E' (Expression). Leave empty for all.",
          "default": ""
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 50,
          "description": "Maximum number of filtered annotations to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after aspect filtering. Use metadata.next_offset for the next page."
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_annotations"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218",
        "aspect": "D"
      },
      {
        "rgd_id": "3001"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_orthologs",
    "description": "Get orthologs of a rat gene across species (human, mouse, chinchilla, dog, pig, etc.) from RGD. Returns ortholog gene symbols, RGD IDs, names, and species. Use for cross-species comparison in model organism genetics, finding human disease gene orthologs in rat.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (e.g., '2218' for Brca1)"
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_orthologs"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_qtls_in_region",
    "description": "Get QTLs (Quantitative Trait Loci) overlapping a genomic region from RGD with limit/offset pagination and explicit total/has_more metadata. Returns QTL symbol, name, RGD ID, LOD score, p-value, variance, and inheritance type. Requires chromosome, coordinates, and an assembly map_key such as 360 for rat rn7/GRCr8.",
    "parameter": {
      "type": "object",
      "properties": {
        "chromosome": {
          "type": "string",
          "description": "Chromosome name, e.g. '10' or 'chr10'."
        },
        "start": {
          "type": "integer",
          "description": "Region start coordinate (1-based)."
        },
        "stop": {
          "type": "integer",
          "description": "Region stop coordinate."
        },
        "map_key": {
          "type": "integer",
          "description": "Assembly map key. 360=rat rn7/GRCr8, 372=rat mRatBN7.2, 38=human GRCh38, 17=human GRCh37, 35=mouse GRCm39, 18=mouse GRCm38."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of overlapping QTLs to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based QTL offset. Use metadata.next_offset for the next page."
        }
      },
      "required": [
        "chromosome",
        "start",
        "stop",
        "map_key"
      ]
    },
    "fields": {
      "endpoint_type": "get_qtls_in_region"
    },
    "type": "RGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "chromosome": "10",
        "start": 1,
        "stop": 50000000,
        "map_key": 360
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rgd_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chromosome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lod": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "variance": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "inheritance_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_resolve_symbol_or_region",
    "description": "Resolve a gene symbol to its native RGD record, or list genes overlapping a genomic region. Symbol mode returns one record. Region mode supports limit/offset pagination and reports total_genes, has_more, and next_offset so large chromosome intervals are fully reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "description": "Rat gene symbol, e.g. 'Tp53'. Use this for symbol mode."
        },
        "species_type_key": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Species type key for symbol mode (default 3=rat, 1=human, 2=mouse)."
        },
        "chromosome": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chromosome for region mode, e.g. '10'."
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region start (region mode)."
        },
        "stop": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region stop (region mode)."
        },
        "map_key": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Assembly map key for region mode (e.g. 360 for rat rn7)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Region mode only: maximum number of overlapping genes to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Region mode only: zero-based gene offset. Use metadata.next_offset for the next page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "resolve_symbol_or_region"
    },
    "type": "RGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "symbol": "Tp53"
      },
      {
        "chromosome": "10",
        "start": 1,
        "stop": 5000000,
        "map_key": 360
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "description": "Gene record (symbol mode) or list of genes in region (region mode)."
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
