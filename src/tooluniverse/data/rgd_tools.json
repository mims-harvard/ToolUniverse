[
  {
    "name": "RGD_get_gene",
    "description": "Get detailed rat gene information from the Rat Genome Database by RGD ID. Returns gene symbol, name, description (including AGR-aggregated functional summary with disease associations, pathways, and interactions), gene type, and Ensembl cross-reference. Use when looking up specific rat genes for toxicology, pharmacology, or disease model research.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (numeric, e.g., '2218' for Brca1). Can include 'RGD:' prefix."
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_gene"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218"
      },
      {
        "rgd_id": "RGD:3001"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "rgd_id": {
              "type": [
                "integer",
                "string",
                "null"
              ],
              "description": "Rat Genome Database identifier."
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene symbol."
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene name."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the gene does."
            },
            "type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene type, e.g. 'protein-coding'."
            },
            "ensembl_symbol": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "description": "The symbol Ensembl uses, where it differs."
            },
            "refseq_status": {
              "type": [
                "string",
                "null"
              ],
              "description": "RefSeq's curation status for the gene, e.g. 'VALIDATED', 'PROVISIONAL'. A provisional record has not been reviewed."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_search_genes",
    "description": "Search rat, human, or mouse genes through RGD/Alliance by symbol or keyword. Returns IDs, symbols, names, species, and every synonym with synonym_count; aliases are not limited to the former first five. Use for gene resolution, ortholog work, toxicology, and disease models.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or keyword (e.g., 'Brca1', 'Tp53', 'insulin')"
        },
        "species": {
          "type": "string",
          "description": "Species to search: 'rat' (default), 'human', 'mouse'",
          "default": "rat"
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search_genes"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "query": "Brca1"
      },
      {
        "query": "Tp53",
        "species": "rat"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "diseases": {
                "type": "array",
                "description": "The diseases the hit is associated with -- 113 across one page -- which is most of why a caller searches for a gene in RGD",
                "items": {
                  "type": "string"
                }
              },
              "disease_count": {
                "type": "integer"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "automated_description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "so_term_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cross_references": {
                "type": "array",
                "description": "The gene in other databases; the search answers 236 of these and 528 gene-level ones",
                "items": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              },
              "gene_cross_references": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "object"
                  ]
                }
              },
              "related_data": {
                "type": "array",
                "description": "What else RGD holds for this gene, which is how a caller knows what to ask for next",
                "items": {
                  "type": "object"
                }
              },
              "search_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The same id in curie form, e.g. 'RGD:2218'. The form other tools expect."
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Full gene name, e.g. 'BRCA1, DNA repair associated'."
              },
              "rgd_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "RGD's numeric id for the gene, e.g. '2218'."
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Species the gene belongs to, e.g. 'Rattus norvegicus'. RGD carries rat, mouse and human, so a symbol alone is ambiguous."
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene symbol, e.g. 'Brca1'."
              },
              "synonym_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many, e.g. 7."
              },
              "synonyms": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Other symbols and names for the gene."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_annotations",
    "description": "Get disease, phenotype, pathway, GO, and expression annotations for an RGD gene with limit/offset pagination and explicit total/has_more metadata. Returns ontology terms, evidence codes, qualifiers, data sources, and complete annotation notes; notes are not shortened. Filter by aspect: D=Disease, P=Pathway, W=Phenotype, F=Molecular Function, C=Cellular Component, E=Expression.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (e.g., '2218' for Brca1)"
        },
        "aspect": {
          "type": "string",
          "description": "Filter by annotation type: 'D' (Disease), 'P' (Pathway), 'W' (Phenotype), 'F' (Function), 'C' (Component), 'E' (Expression). Leave empty for all.",
          "default": ""
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 50,
          "description": "Maximum number of filtered annotations to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after aspect filtering. Use metadata.next_offset for the next page."
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_annotations"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218",
        "aspect": "D"
      },
      {
        "rgd_id": "3001"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The gene the annotation is on. The row carried the term and the evidence code and left the object unnamed -- 1,114 annotations on one gene."
              },
              "object_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotated_object_rgd_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "reference_rgd_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "The reference supporting the annotation, without which it cannot be cited"
              },
              "with_from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qualifier2": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "alteration": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "An annotation against an allele or a specific molecular entity is not the same claim as one against the gene"
              },
              "alteration_location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "molecular_entity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_extension": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_date": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ],
                "description": "RGD answers these as epoch milliseconds, not a date string"
              },
              "last_modified_date": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ],
                "description": "RGD answers these as epoch milliseconds, not a date string"
              },
              "aspect": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which ontology the term is from, as RGD's one-letter code: 'D' disease, 'P' biological process, 'F' molecular function, 'C' cellular component, 'E' ChEBI, 'W' pathway."
              },
              "data_src": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which database supplied the annotation, e.g. 'CTD'."
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Evidence code, e.g. 'ISO' inferred from sequence orthology, 'IDA' direct assay. An ISO annotation is transferred from another species, not observed in this one."
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The curator's note, e.g. 'CTD Direct Evidence: marker/mechanism'. Often the only statement of how the gene relates to the term."
              },
              "term": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The annotated term's label, e.g. 'Animal Mammary Neoplasms'."
              },
              "term_acc": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The term's accession, e.g. 'DOID:9000403'. The ontology id, which the label is not."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_orthologs",
    "description": "Get orthologs of a rat gene across species (human, mouse, chinchilla, dog, pig, etc.) from RGD. Returns ortholog gene symbols, RGD IDs, names, and species. Use for cross-species comparison in model organism genetics, finding human disease gene orthologs in rat.",
    "parameter": {
      "type": "object",
      "properties": {
        "rgd_id": {
          "type": "string",
          "description": "RGD gene ID (e.g., '2218' for Brca1)"
        }
      },
      "required": [
        "rgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_orthologs"
    },
    "type": "RGDTool",
    "test_examples": [
      {
        "rgd_id": "2218"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Protein-coding against pseudogene"
              },
              "so_acc_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refseq_status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "VALIDATED against PREDICTED"
              },
              "ncbi_annotation_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agr_description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ensembl_gene_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ensembl_gene_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nomenclature_source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Its full name."
              },
              "rgd_id": {
                "description": "RGD id of the orthologous gene."
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which species the ortholog is in, e.g. 'human'. The point of an ortholog record and it was undeclared."
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Its symbol, e.g. 'BRCA1'."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_get_qtls_in_region",
    "description": "Get QTLs (Quantitative Trait Loci) overlapping a genomic region from RGD with limit/offset pagination and explicit total/has_more metadata. Returns QTL symbol, name, RGD ID, LOD score, p-value, variance, and inheritance type. Requires chromosome, coordinates, and an assembly map_key such as 360 for rat rn7/GRCr8.",
    "parameter": {
      "type": "object",
      "properties": {
        "chromosome": {
          "type": "string",
          "description": "Chromosome name, e.g. '10' or 'chr10'."
        },
        "start": {
          "type": "integer",
          "description": "Region start coordinate (1-based)."
        },
        "stop": {
          "type": "integer",
          "description": "Region stop coordinate."
        },
        "map_key": {
          "type": "integer",
          "description": "Assembly map key. 360=rat rn7/GRCr8, 372=rat mRatBN7.2, 38=human GRCh38, 17=human GRCh37, 35=mouse GRCm39, 18=mouse GRCm38."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of overlapping QTLs to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based QTL offset. Use metadata.next_offset for the next page."
        }
      },
      "required": [
        "chromosome",
        "start",
        "stop",
        "map_key"
      ]
    },
    "fields": {
      "endpoint_type": "get_qtls_in_region"
    },
    "type": "RGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "chromosome": "10",
        "start": 1,
        "stop": 50000000,
        "map_key": 360
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rgd_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chromosome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lod": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "variance": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "inheritance_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "flank1_rgd_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "A QTL is defined by its flanking markers and its peak; the row gave a chromosome"
              },
              "flank2_rgd_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "peak_rgd_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "flank1_rs_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "flank2_rs_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "peak_rs_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "peak_offset": {
                "type": [
                  "integer",
                  "number",
                  "null"
                ]
              },
              "p_value_mlog": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "most_significant_cmo_term": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "RGD_resolve_symbol_or_region",
    "description": "Resolve a gene symbol to its native RGD record, or list genes overlapping a genomic region. Symbol mode returns one record. Region mode supports limit/offset pagination and reports total_genes, has_more, and next_offset so large chromosome intervals are fully reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "description": "Rat gene symbol, e.g. 'Tp53'. Use this for symbol mode."
        },
        "species_type_key": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Species type key for symbol mode (default 3=rat, 1=human, 2=mouse)."
        },
        "chromosome": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chromosome for region mode, e.g. '10'."
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region start (region mode)."
        },
        "stop": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Region stop (region mode)."
        },
        "map_key": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Assembly map key for region mode (e.g. 360 for rat rn7)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Region mode only: maximum number of overlapping genes to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Region mode only: zero-based gene offset. Use metadata.next_offset for the next page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "resolve_symbol_or_region"
    },
    "type": "RGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "symbol": "Tp53"
      },
      {
        "chromosome": "10",
        "start": 1,
        "stop": 5000000,
        "map_key": 360
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "description": "Gene record (symbol mode) or list of genes in region (region mode).",
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "rgd_id": {
              "type": [
                "integer",
                "string",
                "null"
              ],
              "description": "RGD identifier for the object"
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene symbol"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene name"
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Description of the object"
            },
            "type": {
              "type": [
                "string",
                "null"
              ],
              "description": "What kind of object it is, e.g. gene"
            },
            "so_acc_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Sequence Ontology accession for that type"
            },
            "species_type_key": {
              "type": [
                "integer",
                "null"
              ],
              "description": "RGD's species key"
            },
            "key": {
              "type": [
                "integer",
                "string",
                "null"
              ],
              "description": "RGD's internal key for the record"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
