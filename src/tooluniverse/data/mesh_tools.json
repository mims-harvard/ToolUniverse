[
  {
    "name": "MeSH_search_descriptors",
    "description": "Search MeSH (Medical Subject Headings) descriptors by label. MeSH is NLM's controlled vocabulary for indexing biomedical literature in PubMed. Descriptors are the main headings in MeSH that represent biomedical concepts including diseases, drugs, anatomy, organisms, and procedures. Supports exact, contains, and prefix matching. The public lookup endpoint has a hard 50-result limit and exposes neither a total count nor an offset; when the requested limit is reached, metadata marks the result as possibly truncated and callers should refine the query. Example: searching 'Neoplasms' with exact match returns descriptor D009369.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Descriptor label to search for. Examples: 'Neoplasms', 'Diabetes Mellitus', 'Aspirin', 'Brain', 'Escherichia coli'."
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "contains",
            "startsWith"
          ],
          "description": "Match type: 'exact' for exact match, 'contains' for partial match (default), 'startsWith' for prefix match."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results (default: 20, max: 50)."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "search_descriptors"
    },
    "type": "MeSHTool",
    "test_examples": [
      {
        "query": "Neoplasms",
        "match": "exact"
      },
      {
        "query": "Diabetes",
        "match": "contains",
        "limit": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descriptor_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "MeSH descriptor ID (e.g., D009369)"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Descriptor label/name"
              },
              "resource_uri": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Full MeSH URI"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MeSH_get_descriptor",
    "description": "Get the complete source record for a MeSH descriptor by its ID. Returns convenient parsed fields plus the unprojected JSON-LD record, including concepts, preferred terms, allowable qualifiers, history/public notes, tree numbers, dates, and active status. The returned identifier is checked against the requested ID. Example: D009369 returns 'Neoplasms' with tree number C04.",
    "parameter": {
      "type": "object",
      "properties": {
        "descriptor_id": {
          "type": "string",
          "pattern": "^[CcDdMmQqTt][0-9]{6,9}$",
          "description": "MeSH descriptor ID. Examples: 'D009369' (Neoplasms), 'D003920' (Diabetes Mellitus), 'D001241' (Aspirin), 'D001921' (Brain), 'D000998' (Antiviral Agents)."
        }
      },
      "required": [
        "descriptor_id"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "get_descriptor"
    },
    "type": "MeSHTool",
    "test_examples": [
      {
        "descriptor_id": "D009369"
      },
      {
        "descriptor_id": "D003920"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "descriptor_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "MeSH descriptor ID"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "Record name. Read from 'label' for descriptors and from 'prefLabel' for Term and Concept records."
            },
            "type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Record class: TopicalDescriptor, PublicationType, GeographicalDescriptor, Qualifier, Term, or Concept."
            },
            "note": {
              "type": "string",
              "description": "Present only when the identifier resolves to something other than a topical descriptor, explaining what the record is and, for Term/Concept records, how to reach the descriptor that owns it."
            },
            "annotation": {
              "type": [
                "string",
                "null"
              ],
              "description": "Usage annotation/notes"
            },
            "tree_numbers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "MeSH tree numbers for hierarchy"
            },
            "consider_also": {
              "type": [
                "string",
                "null"
              ],
              "description": "Related terms to consider"
            },
            "date_introduced": {
              "type": [
                "string",
                "null"
              ],
              "description": "Year descriptor was introduced"
            },
            "last_updated": {
              "type": [
                "string",
                "null"
              ],
              "description": "Last update date"
            },
            "active": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether descriptor is active"
            },
            "history_note": {
              "type": [
                "string",
                "null"
              ]
            },
            "public_mesh_note": {},
            "allowable_qualifiers": {
              "type": "array"
            },
            "concepts": {
              "type": "array"
            },
            "preferred_concept": {},
            "preferred_term": {},
            "record": {
              "type": "object",
              "description": "Complete unprojected JSON-LD descriptor record returned by NLM MeSH."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MeSH_search_terms",
    "description": "Search MeSH terms (entry terms/synonyms) by label. MeSH terms include preferred descriptor names, alternative entry terms, synonyms, and common names. Supports exact, contains, and prefix matching. The public lookup endpoint has a hard 50-result limit and exposes neither a total count nor an offset; when the requested limit is reached, metadata marks the result as possibly truncated and callers should refine the query.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Term label to search for. Examples: 'tumor', 'heart attack', 'aspirin', 'blood pressure', 'DNA repair'."
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "contains",
            "startsWith"
          ],
          "description": "Match type: 'exact' for exact match, 'contains' for partial match (default), 'startsWith' for prefix match."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results (default: 20, max: 50)."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "search_terms"
    },
    "type": "MeSHTool",
    "test_examples": [
      {
        "query": "tumor",
        "match": "contains",
        "limit": 10
      },
      {
        "query": "Aspirin",
        "match": "exact"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "MeSH term ID (e.g., T027926)"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Term label/name"
              },
              "resource_uri": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Full MeSH URI"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
