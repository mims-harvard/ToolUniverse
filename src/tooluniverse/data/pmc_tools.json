[
  {
    "type": "PMCTool",
    "name": "PMC_search_papers",
    "description": "Search full-text biomedical literature in PMC by relevance. Uses limit (default 10; retmax is an alias) and zero-based offset. The historical return type remains a paper list; every returned paper includes the identical search_pagination envelope with PMC's exact total_results, has_more, and next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for PMC papers. Use keywords separated by spaces to refine your search."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of papers to return. This sets the maximum number of papers retrieved from PMC.",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "retmax": {
          "type": "integer",
          "description": "Alias for limit (NCBI eutils naming). If both retmax and limit are provided, limit is used.",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9998,
          "default": 0,
          "description": "Zero-based PMC relevance offset within NCBI's 9,999-record retrieval window (0-9998). Continue with search_pagination.next_offset while has_more is true. If total_results exceeds retrievable_results, narrow the query or add date filters."
        },
        "date_from": {
          "type": "string",
          "description": "Start date for publication date filter (YYYY/MM/DD format). Optional parameter to limit search to papers published from this date onwards."
        },
        "date_to": {
          "type": "string",
          "description": "End date for publication date filter (YYYY/MM/DD format). Optional parameter to limit search to papers published up to this date."
        },
        "article_type": {
          "type": "string",
          "description": "Article type filter (e.g., 'research-article', 'review', 'case-report'). Optional parameter to limit search to specific article types."
        },
        "include_abstract": {
          "type": "boolean",
          "description": "If true, attempts to enrich results with an abstract (best-effort) by fetching PubMed abstracts for items that have a PMID.",
          "default": false
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "type": "array",
      "description": "List of full-text biomedical papers from PMC matching the search query",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the paper"
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ],
            "description": "Abstract of the paper (null when not available via esummary)"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of author names"
          },
          "year": {
            "type": [
              "string",
              "null"
            ],
            "description": "Publication year"
          },
          "pmc_id": {
            "type": "string",
            "description": "PMC identifier"
          },
          "pmid": {
            "type": [
              "string",
              "null"
            ],
            "description": "PubMed identifier"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ],
            "description": "Digital Object Identifier (DOI) of the paper"
          },
          "doi_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "DOI resolver URL"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL to access the paper on PMC"
          },
          "pdf_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "PDF URL on PMC (when available)"
          },
          "abstract_source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source of abstract text (when include_abstract=true)"
          },
          "venue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Journal or venue name"
          },
          "open_access": {
            "type": "boolean",
            "description": "Open access status (always true for PMC)"
          },
          "source": {
            "type": "string",
            "description": "Source identifier (always 'PMC')"
          },
          "article_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Type of article (e.g., research-article, review)"
          },
          "citations": {
            "type": "integer",
            "description": "Number of citations"
          },
          "search_pagination": {
            "type": "object",
            "description": "Page metadata repeated on each paper to preserve the historical list response type.",
            "properties": {
              "total_results": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "retrievable_results": {
                "type": "integer"
              },
              "returned": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_offset": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "result_set_complete": {
                "type": "boolean"
              },
              "database_result_complete": {
                "type": "boolean"
              },
              "retrieval_limit_reached": {
                "type": "boolean"
              },
              "retrieval_limit_note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "query": "cancer research",
        "limit": 2
      },
      {
        "query": "COVID-19",
        "limit": 1,
        "date_from": "2020/01/01"
      }
    ]
  }
]
