[
  {
    "name": "ArtIC_search_artworks",
    "description": "Search the Art Institute of Chicago collection with explicit page pagination. Continue with metadata.next_page while metadata.has_more is true. The API ranks the full searchable catalog, so pagination.total and metadata.total_results are candidate counts, not counts of exact keyword matches; use _score and the returned fields to judge relevance.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Search query. Examples: 'monet water lilies', 'picasso cubism', 'ancient egypt', 'japanese woodblock', 'american landscape'"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Ranked records per page (1-100, default 10)"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based result page. Continue with metadata.next_page."
        },
        "fields": {
          "type": [
            "string",
            "null"
          ],
          "description": "Comma-separated fields to return. Default: 'id,title,artist_display,date_display,medium_display'. Other options: image_id, dimensions, artwork_type_title, style_title, classification_title"
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://api.artic.edu/api/v1/artworks/search",
      "params": {},
      "pagination": "artic_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "monet water lilies",
        "limit": 5
      },
      {
        "q": "picasso cubism",
        "limit": 5
      },
      {
        "q": "ancient egypt",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preference": {
              "type": "null"
            },
            "pagination": {
              "type": "object",
              "properties": {
                "total": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "limit": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "offset": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "total_pages": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "current_page": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "_score": {
                    "type": "number"
                  },
                  "id": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "api_model": {
                    "type": "string"
                  },
                  "api_link": {
                    "type": "string"
                  },
                  "is_boosted": {
                    "type": "boolean"
                  },
                  "title": {
                    "type": "string"
                  },
                  "thumbnail": {
                    "type": "object",
                    "properties": {
                      "lqip": {
                        "type": "string"
                      },
                      "width": {
                        "type": [
                          "integer",
                          "number"
                        ]
                      },
                      "height": {
                        "type": [
                          "integer",
                          "number"
                        ]
                      },
                      "alt_text": {
                        "type": "string"
                      }
                    }
                  },
                  "timestamp": {
                    "type": "string"
                  }
                }
              }
            },
            "info": {
              "type": "object",
              "properties": {
                "license_text": {
                  "type": "string"
                },
                "license_links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "config": {
              "type": "object",
              "properties": {
                "iiif_url": {
                  "type": "string"
                },
                "website_url": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "preference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ArtIC_get_artwork",
    "description": "Get detailed information about a specific artwork from the Art Institute of Chicago collection by its numeric ID. Returns full metadata including title, artist, date, medium, dimensions, provenance, exhibition history, and IIIF image URL. No authentication required. Use ArtIC_search_artworks to find artwork IDs.",
    "parameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Artwork ID from Art Institute of Chicago. Examples: 27992 (A Sunday on La Grande Jatte), 16568 (The Bedroom by Van Gogh), 20684 (American Gothic)"
        }
      },
      "required": [
        "id"
      ]
    },
    "fields": {
      "endpoint": "https://api.artic.edu/api/v1/artworks/{id}",
      "params": {
        "fields": "id,title,artist_display,date_display,medium_display,dimensions,image_id,description,place_of_origin,style_title,artwork_type_title,credit_line,is_public_domain"
      }
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "id": 27992
      },
      {
        "id": 16568
      },
      {
        "id": 20684
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "date_display": {
                  "type": "string"
                },
                "artist_display": {
                  "type": "string"
                },
                "place_of_origin": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "dimensions": {
                  "type": "string"
                },
                "medium_display": {
                  "type": "string"
                },
                "credit_line": {
                  "type": "string"
                },
                "is_public_domain": {
                  "type": "boolean"
                },
                "artwork_type_title": {
                  "type": "string"
                },
                "style_title": {
                  "type": "string"
                },
                "image_id": {
                  "type": "string"
                },
                "config": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "The IIIF image server base URL and the website URL. An image id is useless without the iiif_url to build a request from."
                },
                "data": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "The artwork record itself - id, title, date_display, artist_display, place_of_origin, medium, dimensions, credit_line and the image id. The payload, nested one level below the envelope's own 'data'."
                },
                "info": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "The licence under which the metadata is offered - license_text, license_links and version. The attribution the museum's terms require."
                }
              }
            },
            "info": {
              "type": "object",
              "properties": {
                "license_text": {
                  "type": "string"
                },
                "license_links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "config": {
              "type": "object",
              "properties": {
                "iiif_url": {
                  "type": "string"
                },
                "website_url": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
