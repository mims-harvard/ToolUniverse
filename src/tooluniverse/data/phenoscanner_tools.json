[
  {
    "type": "PhenoScannerTool",
    "name": "PhenoScanner_query_snp",
    "description": "Query phenotype associations for a SNP (rsID). Workaround for PhenoScanner V2 (down since March 2024) using the EBI GWAS Catalog. Returns GWAS trait associations with p-values, effect sizes, and EFO trait mappings. Note: only GWAS catalogue is available; eQTL/pQTL/mQTL/methQTL and LD proxy lookups are not supported in this workaround.",
    "fields": {
      "operation": "query_snp"
    },
    "parameter": {
      "type": "object",
      "properties": {
        "rsid": {
          "type": "string",
          "description": "dbSNP rs identifier (e.g., 'rs10840293', 'rs429358')"
        },
        "p_value_threshold": {
          "type": "number",
          "description": "P-value threshold for filtering results (default: 1e-5). Only associations with p-value <= threshold are returned.",
          "default": 1e-5
        },
        "size": {
          "type": "integer",
          "description": "Maximum number of associations to return (default: 100)",
          "default": 100
        }
      },
      "required": ["rsid"]
    },
    "label": [
      "GWAS",
      "PhenoScanner",
      "SNP",
      "Phenotype",
      "Genotype-Phenotype",
      "Variant",
      "Association"
    ],
    "return_schema": {
      "type": "array",
      "description": "Array of SNP-phenotype associations from GWAS Catalog",
      "items": {
        "type": "object",
        "properties": {
          "snp": {"type": "string", "description": "dbSNP rs identifier"},
          "p_value": {"type": ["number", "null"], "description": "Association p-value"},
          "p_value_text": {"type": ["string", "null"], "description": "Original p-value text"},
          "or_beta": {"type": ["number", "null"], "description": "Odds ratio or beta coefficient"},
          "ci": {"type": ["string", "null"], "description": "Confidence interval"},
          "beta_direction": {"type": ["string", "null"], "description": "Direction of beta effect"},
          "beta_unit": {"type": ["string", "null"], "description": "Unit of beta measurement"},
          "efo_traits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trait": {"type": ["string", "null"]},
                "efo_id": {"type": ["string", "null"]},
                "uri": {"type": ["string", "null"]}
              }
            }
          },
          "risk_alleles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "risk_allele": {"type": ["string", "null"]},
                "risk_frequency": {"type": ["number", "string", "null"]}
              }
            }
          },
          "study_accession": {"type": ["string", "null"]},
          "catalogue": {"type": "string"}
        }
      }
    },
    "test_examples": [
      {"rsid": "rs10840293"},
      {"rsid": "rs429358", "p_value_threshold": 1e-8}
    ]
  },
  {
    "type": "PhenoScannerTool",
    "name": "PhenoScanner_query_gene",
    "description": "Query phenotype associations for all SNPs in a gene region. Workaround for PhenoScanner V2 (down since March 2024) using the EBI GWAS Catalog. Returns GWAS trait associations for SNPs mapped to the gene, with p-values and EFO trait mappings. Note: only GWAS catalogue is available; eQTL/pQTL/mQTL/methQTL catalogues are not supported.",
    "fields": {
      "operation": "query_gene"
    },
    "parameter": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "description": "Gene symbol (e.g., 'APOE', 'TP53', 'BRCA1')"
        },
        "p_value_threshold": {
          "type": "number",
          "description": "P-value threshold for filtering results (default: 1e-5). Only associations with p-value <= threshold are returned.",
          "default": 1e-5
        },
        "size": {
          "type": "integer",
          "description": "Maximum number of SNPs to retrieve for the gene (default: 100)",
          "default": 100
        }
      },
      "required": ["gene_symbol"]
    },
    "label": [
      "GWAS",
      "PhenoScanner",
      "Gene",
      "Phenotype",
      "Genotype-Phenotype",
      "Association"
    ],
    "return_schema": {
      "type": "array",
      "description": "Array of gene-region phenotype associations from GWAS Catalog",
      "items": {
        "type": "object",
        "properties": {
          "snp": {"type": "string", "description": "dbSNP rs identifier"},
          "gene": {"type": "string", "description": "Gene symbol"},
          "p_value": {"type": ["number", "null"], "description": "Association p-value"},
          "or_beta": {"type": ["number", "null"], "description": "Odds ratio or beta"},
          "ci": {"type": ["string", "null"], "description": "Confidence interval"},
          "efo_traits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trait": {"type": ["string", "null"]},
                "efo_id": {"type": ["string", "null"]}
              }
            }
          },
          "study_accession": {"type": ["string", "null"]},
          "catalogue": {"type": "string"}
        }
      }
    },
    "test_examples": [
      {"gene_symbol": "APOE"},
      {"gene_symbol": "TP53", "p_value_threshold": 1e-8}
    ]
  }
]
