[
  {
    "name": "HumanMine_search",
    "description": "Search HumanMine (InterMine) for genes, proteins, pathways, diseases, and other biological entities related to human, mouse, and rat. HumanMine integrates data from 30+ sources including NCBI Gene, UniProt, Ensembl, GO, KEGG, Reactome, OMIM, and GWAS Catalog. Returns entity IDs, types, names, symbols, and organism information. Use the facet_Category parameter to filter results to a specific type (Gene, Protein, Pathway, Disease, Publication, etc.).",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Search query: gene symbol (e.g., 'TP53', 'BRCA1'), gene name, disease name, pathway name, or any biological term"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results in this page (default 10, max 100)"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        },
        "facet_Category": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by entity type: 'Gene', 'Protein', 'Pathway', 'Disease', 'Publication', 'GWASResult', 'GOTerm', 'ProteinDomain', etc."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.humanmine.org/humanmine/service/search",
      "params": {
        "format": "json"
      },
      "pagination": "intermine_start"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "TP53",
        "size": 5,
        "facet_Category": "Gene"
      },
      {
        "q": "BRCA1",
        "size": 3
      },
      {
        "q": "apoptosis",
        "facet_Category": "Pathway",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "description": "HumanMine search results",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total number of matching entries"
            },
            "facets": {
              "type": [
                "object",
                "null"
              ],
              "description": "Facet counts, keyed by facet name then by facet value",
              "properties": {
                "Category": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Counts for one facet, keyed by facet value",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                },
                "organism.shortName": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Counts for one facet, keyed by facet value",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many results carry that value"
                  }
                }
              },
              "additionalProperties": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Counts for one facet, keyed by value",
                "additionalProperties": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "How many results carry that value"
                }
              }
            },
            "results": {
              "type": "array",
              "description": "List of matching entities",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "HumanMine internal ID"
                  },
                  "type": {
                    "type": "string",
                    "description": "Entity type: Gene, Protein, Pathway, Disease, etc."
                  },
                  "fields": {
                    "type": "object",
                    "description": "Entity-specific fields",
                    "properties": {
                      "symbol": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Gene symbol"
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Gene/protein/pathway name"
                      },
                      "organism.name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Organism scientific name"
                      },
                      "primaryIdentifier": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Primary ID (Entrez Gene ID, Reactome ID, etc.)"
                      },
                      "secondaryIdentifier": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Secondary ID (Ensembl gene ID)"
                      },
                      "identifier": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Identifier for pathways/diseases"
                      }
                    }
                  },
                  "relevance": {
                    "type": [
                      "integer",
                      "number",
                      "null"
                    ],
                    "description": "InterMine's relevance score for the match, which is what the result order is based on"
                  }
                }
              }
            },
            "wasSuccessful": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the InterMine server reported success. A query that failed upstream is not an empty result"
            },
            "statusCode": {
              "type": [
                "integer",
                "null"
              ],
              "description": "HTTP status the server returned"
            },
            "executionTime": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "When the server executed the query"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HumanMine_search_genes",
    "description": "Search HumanMine specifically for genes by symbol, name, or ID across human, mouse, and rat. HumanMine integrates gene data from NCBI Gene, Ensembl, UniProt, and other sources. Returns gene symbols, Entrez IDs, Ensembl IDs, gene names, and organism information. More focused than HumanMine_search as it pre-filters to Gene category only.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Gene search query: gene symbol (e.g., 'EGFR', 'TP53'), gene name (e.g., 'tumor protein p53'), or Entrez Gene ID"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results in this page (default 10, max 100)"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.humanmine.org/humanmine/service/search",
      "params": {
        "format": "json",
        "facet_Category": "Gene"
      },
      "pagination": "intermine_start"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "EGFR",
        "size": 5
      },
      {
        "q": "BRCA1",
        "size": 3
      },
      {
        "q": "insulin receptor"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "description": "Gene search results from HumanMine",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total matching genes"
            },
            "facets": {
              "type": "object",
              "properties": {
                "organism.shortName": {
                  "type": "object",
                  "description": "Gene counts per organism"
                },
                "Category": {
                  "description": "Counts per result category, keyed by category name."
                }
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "properties": {
                      "symbol": {
                        "type": "string",
                        "description": "Gene symbol"
                      },
                      "name": {
                        "type": "string",
                        "description": "Full gene name"
                      },
                      "organism.name": {
                        "type": "string",
                        "description": "Species"
                      },
                      "primaryIdentifier": {
                        "type": "string",
                        "description": "Entrez Gene ID or MGI/RGD ID"
                      },
                      "secondaryIdentifier": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Ensembl gene ID"
                      }
                    }
                  },
                  "relevance": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "InterMine's relevance score for the row."
                  }
                }
              }
            },
            "executionTime": {
              "type": [
                "string",
                "null"
              ],
              "description": "When InterMine ran the query, as it formats it."
            },
            "statusCode": {
              "type": [
                "integer",
                "null"
              ],
              "description": "InterMine's HTTP-style status for the query."
            },
            "wasSuccessful": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether InterMine considered the query successful. False with an empty result set is an error, not an absence of matches."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HumanMine_search_pathways",
    "description": "Search HumanMine specifically for biological pathways by name or identifier. Integrates pathway data from Reactome, KEGG, and other sources. Returns pathway names, identifiers (Reactome IDs like R-HSA-109581), and associated organisms. Useful for finding pathway IDs for downstream enrichment analysis.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Pathway search query: pathway name (e.g., 'apoptosis', 'cell cycle', 'PI3K-Akt signaling'), or Reactome ID"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results in this page (default 10, max 100)"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based search offset. Continue with metadata.next_start while metadata.has_more is true."
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://www.humanmine.org/humanmine/service/search",
      "params": {
        "format": "json",
        "facet_Category": "Pathway"
      },
      "pagination": "intermine_start"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "apoptosis",
        "size": 5
      },
      {
        "q": "cell cycle"
      },
      {
        "q": "DNA repair",
        "size": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "description": "Pathway search results from HumanMine",
          "properties": {
            "totalHits": {
              "type": "integer",
              "description": "Total matching pathways"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "description": "Always 'Pathway'"
                  },
                  "fields": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Pathway name"
                      },
                      "identifier": {
                        "type": "string",
                        "description": "Pathway ID (e.g., R-HSA-109581 for Reactome)"
                      }
                    }
                  },
                  "relevance": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "InterMine's relevance score for the row."
                  }
                }
              }
            },
            "executionTime": {
              "type": [
                "string",
                "null"
              ],
              "description": "When InterMine ran it."
            },
            "facets": {
              "description": "Facet counts for the result set."
            },
            "statusCode": {
              "type": [
                "integer",
                "null"
              ],
              "description": "InterMine's status for the query."
            },
            "wasSuccessful": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether InterMine considered the query successful."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "InterMine_run_pathquery",
    "description": "Run an arbitrary InterMine PathQuery against HumanMine (an InterMine data warehouse) to traverse the data model graph: gene->pathways, gene->protein domains, region->features, etc. The 'query' argument is an InterMine XML PathQuery string (with model, view columns, and constraints) — results come back as JSON rows in the order of the 'view' columns. Example: query '<query model=\"genomic\" view=\"Gene.symbol Gene.pathways.name Gene.pathways.dataSets.name\"><constraint path=\"Gene.symbol\" op=\"=\" value=\"PAX6\"/></query>' returns PAX6 Reactome pathways like 'Activation of HOX genes during differentiation'. A second view 'Gene.proteins.proteinDomainRegions.proteinDomain.name' returns protein domains such as 'Homeobox domain'.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "InterMine XML PathQuery. Must include model, view (space-separated paths), and constraints. Example: '<query model=\"genomic\" view=\"Gene.symbol Gene.pathways.name\"><constraint path=\"Gene.symbol\" op=\"=\" value=\"PAX6\"/></query>'."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://www.humanmine.org/humanmine/service/query/results",
      "params": {
        "format": "json"
      }
    },
    "type": "BaseRESTTool",
    "timeout": 30,
    "test_examples": [
      {
        "query": "<query model=\"genomic\" view=\"Gene.symbol Gene.pathways.name Gene.pathways.dataSets.name\"><constraint path=\"Gene.symbol\" op=\"=\" value=\"PAX6\"/></query>"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "InterMine PathQuery JSON result",
          "properties": {
            "views": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Column paths in result order"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "array"
              },
              "description": "Result rows; each row is a list of cell values matching 'views'"
            },
            "modelName": {
              "type": "string"
            },
            "columnHeaders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rootClass": {
              "type": "string"
            },
            "start": {
              "type": "integer"
            },
            "wasSuccessful": {
              "type": "boolean"
            },
            "executionTime": {
              "type": "string"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "statusCode": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "views",
            "results"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
