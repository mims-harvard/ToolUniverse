[
  {
    "type": "SCREENRESTTool",
    "name": "SCREEN_get_regulatory_elements",
    "description": "Resolve an official human gene symbol to its GRCh38 coordinates with Ensembl, then return genuine ENCODE SCREEN cCREs overlapping the gene interval plus a configurable flank (default 10 kb). Filters real cCRE classes: enhancer=pELS/dELS, promoter=PLS, insulator=CTCF-only. Results use exact client-side offset pagination. This reports genomic-window overlap only and explicitly does not claim the cCRE functionally regulates the gene.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_name": {
          "type": "string",
          "description": "Gene symbol to search for regulatory elements (e.g., BRCA1, TP53). Alias: 'query'."
        },
        "query": {
          "type": "string",
          "description": "Gene symbol to search for regulatory elements (alias for gene_name)."
        },
        "element_type": {
          "type": "string",
          "description": "cCRE class filter: enhancer (pELS+dELS), promoter (PLS), insulator (CTCF-only), all, or a raw SCREEN class (PLS, pELS, dELS, CTCF-only, DNase-H3K4me3).",
          "default": "enhancer",
          "enum": ["enhancer", "promoter", "insulator", "all", "PLS", "pELS", "dELS", "CTCF-only", "DNase-H3K4me3"]
        },
        "limit": {
          "type": "integer",
          "description": "Page size for filtered cCREs.",
          "default": 10,
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based filtered cCRE offset. Continue with metadata.next_offset while metadata.has_more is true.",
          "default": 0,
          "minimum": 0
        },
        "flank_bp": {
          "type": "integer",
          "description": "Base pairs added on both sides of the Ensembl gene interval (default 10000).",
          "default": 10000,
          "minimum": 0,
          "maximum": 1000000
        },
        "assembly": {
          "type": "string",
          "const": "GRCh38",
          "default": "GRCh38",
          "description": "Genome assembly. This gene-symbol resolver currently supports human GRCh38 only."
        }
      },
      "required": []
    },
    "fields": {
      "gene_lookup_endpoint": "https://rest.ensembl.org/lookup/symbol/homo_sapiens/{gene_name}",
      "screen_endpoint": "https://ga.staging.wenglab.org/graphql",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene_name": {
              "type": "string"
            },
            "requested_gene_name": {
              "type": "string"
            },
            "ensembl_gene_id": {
              "type": "string"
            },
            "element_type": {
              "type": "string"
            },
            "count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "total_results": {
              "type": "integer"
            },
            "regulatory_elements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": ["string", "null"]
                  },
                  "chrom": {
                    "type": ["string", "null"]
                  },
                  "start": {
                    "type": ["integer", "null"]
                  },
                  "end": {
                    "type": ["integer", "null"]
                  },
                  "element_type": {
                    "type": ["string", "null"]
                  },
                  "is_proximal": {
                    "type": ["boolean", "null"]
                  },
                  "dnase_zscore": {
                    "type": ["number", "null"]
                  },
                  "promoter_zscore": {
                    "type": ["number", "null"]
                  },
                  "enhancer_zscore": {
                    "type": ["number", "null"]
                  },
                  "ctcf_zscore": {
                    "type": ["number", "null"]
                  }
                }
              }
            },
            "gene_coordinates": {
              "type": "object"
            },
            "query_region": {
              "type": "object"
            },
            "functional_association_claimed": {
              "const": false
            }
          },
          "required": [
            "gene_name",
            "ensembl_gene_id",
            "regulatory_elements",
            "gene_coordinates",
            "query_region",
            "functional_association_claimed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "gene_name": "BRCA1",
        "element_type": "enhancer",
        "limit": 5,
        "offset": 0
      },
      {
        "gene_name": "TP53",
        "element_type": "promoter",
        "limit": 3
      },
      {
        "gene_name": "MYC",
        "element_type": "enhancer",
        "limit": 5
      }
    ]
  }
]
