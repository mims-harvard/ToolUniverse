  {
    "name": "VSDCDCPlacesHeartHealthProfile",
    "type": "VSDCDCPlacesHeartHealthProfile",
    "description": "Retrieve a validated eight-measure CDC PLACES heart-health profile for census tracts in one US county through a fixed endpoint.",
    "category": "special_tools",
    "cacheable": true,
    "mcp_annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "state_abbr": {
          "type": "string",
          "pattern": "^[A-Za-z]{2}$",
          "description": "Two-letter US state abbreviation."
        },
        "county_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "County name without the word County, for example Autauga."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 500,
          "description": "Maximum census-tract measure records to retrieve."
        }
      },
      "required": ["state_abbr", "county_name"],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "measure_definitions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "measure_id": {"type": "string"},
              "name": {"type": "string"},
              "domain": {
                "type": "string",
                "enum": ["access", "clinical_risk", "health_behavior", "health_outcome", "prevention"]
              },
              "population": {"type": "string"},
              "direction": {
                "type": "string",
                "enum": ["higher_is_worse", "higher_is_better"]
              }
            },
            "required": ["measure_id", "name", "domain", "population", "direction"],
            "additionalProperties": false
          }
        },
        "state_abbr": {"type": "string"},
        "county_name": {"type": "string"},
        "possibly_truncated": {"type": "boolean"},
        "estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": {"type": "string"},
              "stateabbr": {"type": "string"},
              "countyname": {"type": "string"},
              "locationname": {"type": "string"},
              "measure": {"type": "string"},
              "measureid": {"type": "string"},
              "data_value": {"type": "string"},
              "low_confidence_limit": {"type": "string"},
              "high_confidence_limit": {"type": "string"}
            },
            "required": [
              "year",
              "stateabbr",
              "countyname",
              "locationname",
              "measure",
              "measureid",
              "data_value",
              "low_confidence_limit",
              "high_confidence_limit"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "provider": {"type": "string"},
            "endpoint": {"type": "string", "format": "uri"},
            "query_params": {"type": "object"},
            "retrieved_at": {"type": "string", "format": "date-time"},
            "http_status": {"type": "integer"},
            "content_type": {"type": "string"},
            "response_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "redirects": {"type": "integer", "const": 0},
            "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": [
            "provider",
            "endpoint",
            "query_params",
            "retrieved_at",
            "http_status",
            "content_type",
            "response_bytes",
            "redirects",
            "payload_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "measure_definitions",
        "state_abbr",
        "county_name",
        "possibly_truncated",
        "estimates",
        "provenance"
      ],
      "additionalProperties": false
    }
  },
