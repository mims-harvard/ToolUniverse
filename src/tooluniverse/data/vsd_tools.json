[
  {
    "name": "VSDResolveCapability",
    "type": "VSDResolveCapability",
    "description": "Check a requested capability against registered ToolUniverse tools and composed workflows before searching for an external API. Returns exact, partial, or missing coverage with deterministic evidence and never persists or reports the request.",
    "cacheable": false,
    "parameter": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Non-sensitive description of the required capability."
        },
        "provider": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Optional provider name or HTTPS provider URL."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"],
          "default": "GET"
        },
        "endpoint": {
          "type": "string",
          "description": "Optional exact HTTPS operation endpoint without query parameters."
        },
        "operation_id": {
          "type": "string",
          "description": "Optional stable provider operation identifier."
        },
        "required_inputs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string"},
          "default": []
        },
        "output_fields": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string"},
          "default": []
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        }
      },
      "required": ["description"],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "data": {"type": "object"}
      },
      "required": ["status", "data"]
    },
    "mcp_annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "test_examples": [
      {
        "description": "Find a rare disease registry for ALS genes and phenotypes",
        "required_inputs": ["disease"],
        "limit": 5
      }
    ]
  },
  {
    "name": "VSDPlanWorkflow",
    "type": "VSDPlanWorkflow",
    "description": "Preflight an agent-proposed multi-step workflow against registered ToolUniverse tools and composed workflows. Returns an ordered, non-executable plan that reuses exact coverage, flags partial coverage for review, and sends only real gaps to API discovery.",
    "category": "special_tools",
    "cacheable": false,
    "mcp_annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Non-sensitive overall workflow goal."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 3,
                "maxLength": 500
              },
              "provider": {"type": "string", "minLength": 3, "maxLength": 500},
              "method": {"type": "string", "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"], "default": "GET"},
              "endpoint": {"type": "string"},
              "operation_id": {"type": "string"},
              "required_inputs": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {"type": "string"},
                "default": []
              },
              "output_fields": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {"type": "string"},
                "default": []
              },
              "depends_on": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
                "default": []
              },
              "optional": {"type": "boolean", "default": false},
              "fulfillment": {
                "type": "string",
                "enum": ["tool", "agent"],
                "default": "tool",
                "description": "Use agent for reasoning or assembly steps that must never trigger API discovery."
              }
            },
            "required": ["step_id", "description"],
            "additionalProperties": false
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        }
      },
      "required": ["goal", "capabilities"],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "data": {"type": "object"}
      },
      "required": ["status", "data"]
    },
    "test_examples": [
      {
        "goal": "Build an ALS evidence workflow from registry genes, phenotypes, and trials",
        "capabilities": [
          {"step_id": "genes", "description": "rare disease registry genes", "required_inputs": ["disease"]},
          {"step_id": "phenotypes", "description": "rare disease registry phenotypes", "required_inputs": ["disease"]},
          {"step_id": "trials", "description": "clinical trials by disease", "required_inputs": ["condition"], "depends_on": ["genes", "phenotypes"]}
        ],
        "limit": 5
      }
    ]
  },
  {
    "name": "VSDDiscoverAPICandidates",
    "type": "VSDDiscoverAPICandidates",
    "description": "Search one or more explicit public catalogs for API-ready data endpoints and OpenAPI specifications related to a research demand. Defaults to Socrata for compatibility; multi-catalog results are deduplicated against each other and the ToolUniverse registry. Returned metadata is untrusted and non-executable until separately reviewed, verified, and approved.",
    "category": "special_tools",
    "cacheable": true,
    "mcp_annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Research capability or dataset need, such as active cancer clinical trials by site and phase."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10,
          "description": "Maximum number of non-executable candidates to return."
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["socrata", "datagov", "data_europa", "ckan_data_gov_uk", "apis_guru"]
          },
          "description": "Optional explicit catalog set. Omit for the backward-compatible Socrata search; provide several IDs for normalized multi-catalog discovery."
        },
        "exclude_registered": {
          "type": "boolean",
          "default": true,
          "description": "For multi-catalog discovery, remove query-free endpoint candidates already covered exactly by a registered ToolUniverse tool."
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {"type": "string"},
        "requested_providers": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array"},
        "candidate_count": {"type": "integer"},
        "catalog_result_count": {"type": ["integer", "null"]},
        "provider_results": {"type": "array"},
        "successful_provider_count": {"type": "integer"},
        "failed_provider_count": {"type": "integer"},
        "cross_catalog_duplicate_count": {"type": "integer"},
        "registered_duplicate_count": {"type": "integer"},
        "registered_duplicates": {"type": "array"},
        "registry_tool_count": {"type": "integer"},
        "boundary": {"type": "string"},
        "provenance": {"type": "object"}
      },
      "required": ["query", "candidates", "candidate_count", "catalog_result_count", "boundary", "provenance"],
      "additionalProperties": false
    }
  },
  {
    "name": "VSDDiscoverSources",
    "type": "VSDDiscoverSources",
    "description": "Search the packaged catalog of reviewed VSD integrations. Review covers the transport profile and response adapter, not scientific endorsement.",
    "category": "special_tools",
    "cacheable": true,
    "mcp_annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional case-insensitive filter over source metadata."
        }
      },
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {"type": "string"},
              "name": {"type": "string"},
              "endpoint": {"type": "string"},
              "description": {"type": "string"},
              "default_params": {"type": "object"},
              "tool_name": {"type": "string"},
              "review_scope": {"type": "string"}
            },
            "required": [
              "source_id",
              "name",
              "endpoint",
              "description",
              "default_params",
              "tool_name",
              "review_scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["sources"],
      "additionalProperties": false
    }
  },
  {
