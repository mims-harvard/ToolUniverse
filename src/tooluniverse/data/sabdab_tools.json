[
  {
    "name": "SAbDab_search_structures",
    "description": "Search the current SAbDab2 antibody-structure JSON API. Returns full antibody-instance records plus exact total/offset pagination metadata; use next_offset while has_more is true. query/antigen searches bound-antigen names. Optional filters mirror the web interface, including species, resolution, method, antigen/antibody/construct type, and PDB ID.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "search_structures",
          "default": "search_structures"
        },
        "query": {
          "type": "string",
          "description": "Bound-antigen name search (e.g., 'SARS-CoV-2' or 'receptor-binding domain'). This is not a generic keyword search."
        },
        "antigen": {
          "type": "string",
          "description": "Alias for query. Antigen name to search (e.g., 'EGFR', 'HER2')."
        },
        "limit": {
          "type": "integer",
          "description": "Page size, 1-100 (default: 50).",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based result offset. Use next_offset from the previous response.",
          "default": 0,
          "minimum": 0
        },
        "pdb_id": {
          "type": "string",
          "description": "Restrict to one four-character PDB ID."
        },
        "species": {
          "type": "string",
          "description": "Antibody organism scientific name, e.g. 'homo sapiens'."
        },
        "resolution_max": {
          "type": "number",
          "description": "Maximum structure resolution in angstroms.",
          "exclusiveMinimum": 0
        },
        "method": {
          "type": "string",
          "description": "Experimental method, e.g. 'X-ray diffraction'."
        },
        "antigen_type": {
          "type": "string",
          "description": "SAbDab2 antigen type filter."
        },
        "antibody_type": {
          "type": "string",
          "description": "SAbDab2 antibody type filter, e.g. FAB."
        },
        "construct_type": {
          "type": "string",
          "description": "SAbDab2 construct type filter."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "structures": {"type": "array"},
            "count": {"type": "integer"},
            "returned_count": {"type": "integer"},
            "total": {"type": "integer"},
            "limit": {"type": "integer"},
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "result_set_complete": {"type": "boolean"},
            "query": {"type": "string"},
            "filters_applied": {"type": "object"}
          },
          "required": [
            "structures",
            "returned_count",
            "total",
            "limit",
            "offset",
            "has_more",
            "result_set_complete"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {"type": "string"}
          },
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {
        "query": "SARS-CoV-2",
        "limit": 2
      }
    ],
    "fields": {
      "operation": "search_structures"
    }
  },
  {
    "name": "SAbDab_get_structure",
    "description": "Get complete current SAbDab2 structure metadata by four-character PDB ID. Returns the full source record, polymer/non-polymer chains, complete antibody instances with CDR and numbering data, and enriched antigen-binding instances. source_record_complete confirms the upstream record was preserved.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_structure",
          "default": "get_structure"
        },
        "pdb_id": {
          "type": "string",
          "description": "4-character PDB ID (e.g., 1IGT, 6W41). Alias: pdb_code."
        },
        "pdb_code": {
          "type": "string",
          "description": "Alias for pdb_id. 4-character PDB ID (e.g., 1IGT, 6W41)."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pdb_id": {"type": "string"},
            "sabdab2_pdb_id": {"type": "string"},
            "name": {"type": ["string", "null"]},
            "resolution": {"type": ["number", "null"]},
            "method": {"type": ["string", "null"]},
            "polymer_instances": {"type": "array"},
            "non_polymer_instances": {"type": "array"},
            "antibody_instances": {"type": "array"},
            "antigen_instances": {"type": "array"},
            "source_record": {"type": "object"},
            "source_record_complete": {"type": "boolean"}
          },
          "required": ["pdb_id"]
        },
        {
          "type": "object",
          "properties": {
            "error": {"type": "string"}
          },
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "1AHW"
      }
    ],
    "fields": {
      "operation": "get_structure"
    }
  },
  {
    "name": "SAbDab_get_structure_summary",
    "description": "Get current per-structure SAbDab2 annotations for a PDB ID. Returns summary fields plus full antibody/CDR records, antigen instances and the complete upstream PDB record. Legacy affinity fields absent from SAbDab2 are explicitly null instead of silently omitted. Pass a four-character PDB ID (e.g., 7d6i, 3hfm).",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_structure_summary",
          "default": "get_structure_summary"
        },
        "pdb_id": {
          "type": "string",
          "description": "4-character PDB ID of an antibody structure (e.g., '7d6i', '3hfm'). Aliases: pdb_code, pdb."
        },
        "pdb_code": {
          "type": "string",
          "description": "Alias for pdb_id."
        },
        "pdb": {
          "type": "string",
          "description": "Alias for pdb_id."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pdb_id": {
              "type": "string"
            },
            "sabdab2_pdb_id": {
              "type": "string"
            },
            "name": {
              "type": ["string", "null"]
            },
            "antigen_name": {
              "type": ["string", "null"]
            },
            "antigen_type": {
              "type": ["string", "null"]
            },
            "antigen_species": {
              "type": ["string", "null"]
            },
            "heavy_species": {
              "type": ["string", "null"]
            },
            "light_species": {
              "type": ["string", "null"]
            },
            "resolution": {
              "type": ["number", "string", "null"]
            },
            "method": {
              "type": ["string", "null"]
            },
            "r_free": {
              "type": ["number", "string", "null"]
            },
            "r_factor": {
              "type": ["number", "string", "null"]
            },
            "chains": {
              "type": "array"
            },
            "count": {
              "type": "integer"
            },
            "antigen_instances": {
              "type": "array"
            },
            "source_record": {
              "type": "object"
            },
            "source_record_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "pdb_id",
            "chains",
            "count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "7d6i"
      },
      {
        "pdb_id": "3hfm"
      }
    ],
    "fields": {
      "operation": "get_structure_summary"
    }
  },
  {
    "name": "SAbDab_get_summary",
    "description": "Get live SAbDab2 database statistics, including antibody instances, PDB entries, canonical SAbDab2 entries, antigen-bound instances, experimental-method counts and last-update time. Never substitutes static prose for unavailable live statistics.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_summary",
          "default": "get_summary"
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "antibody_instances": {"type": "integer"},
            "PDB_entries": {"type": "integer"},
            "SAbDab2_entries": {"type": "integer"},
            "with_antigen": {"type": "integer"},
            "last_update": {"type": "string"},
            "experimental_methods": {
              "type": "object",
              "additionalProperties": {"type": "integer"}
            }
          },
          "required": [
            "antibody_instances",
            "PDB_entries",
            "SAbDab2_entries",
            "with_antigen",
            "last_update"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {"type": "string"}
          },
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {}
    ],
    "fields": {
      "operation": "get_summary"
    }
  }
]
