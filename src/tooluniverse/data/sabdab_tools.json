[
  {
    "name": "SAbDab_search_structures",
    "description": "Search SAbDab (Structural Antibody Database) for antibody structures by the antigen they bind, antibody source organism, experimental method, resolution, antigen type or antibody format. Returns one compact row per antibody instance: PDB ID, structure name, antibody format, resolution, heavy and light chain CDR1-3 with V/J genes, and the bound antigen instance IDs. 'query' is matched as a case-insensitive substring of the antigen's name as deposited in the PDB, at most 25 characters: gene symbols and shorthand usually miss ('HER2' and 'PD-1' find nothing), so use a distinctive part of the full protein name ('erbB-2', 'cell death protein 1', 'spike glycoprotein', 'lysozyme'). Results are paginated: data.total_matches is the full count, data.count is the rows on this page, and data.next_offset continues while data.has_more is true. Use SAbDab_get_structure_summary with a returned pdb_id for the full entry.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "search_structures",
          "default": "search_structures"
        },
        "query": {
          "type": "string",
          "description": "Part of the bound antigen's name as deposited in the PDB, case-insensitive, at most 25 characters (e.g. 'erbB-2', 'lysozyme', 'spike glycoprotein'). Gene symbols such as 'HER2' usually match nothing. Omit to list all antibody instances matching the other filters."
        },
        "antigen": {
          "type": "string",
          "description": "Alias for query."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "Rows per page (1-100, default 20)."
        },
        "species": {
          "type": "string",
          "description": "Substring of the antibody's source organism scientific name (e.g. 'Homo sapiens', 'Lama glama')."
        },
        "method": {
          "type": "string",
          "enum": [
            "X-ray diffraction",
            "electron microscopy",
            "electron crystallography",
            "solution NMR",
            "solid-state NMR",
            "neutron diffraction",
            "fiber diffraction",
            "powder diffraction",
            "solution scattering",
            "fluorescence transfer",
            "infrared spectroscopy",
            "EPR",
            "theoretical model"
          ],
          "description": "Experimental method of the structure (case-insensitive)."
        },
        "resolution_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Keep structures determined at this resolution (angstroms) or better."
        },
        "antigen_type": {
          "type": "string",
          "enum": [
            "PROTEIN",
            "PEPTIDE",
            "DNA",
            "RNA",
            "NUCLEOTIDE",
            "PEPTIDE_NUCLEIC_ACID",
            "SUGAR",
            "HAPTEN",
            "ION",
            "CHEMICAL_ELEMENT",
            "WATER",
            "UNKNOWN",
            "OTHER"
          ],
          "description": "Kind of antigen bound (case-insensitive)."
        },
        "antibody_type": {
          "type": "string",
          "enum": [
            "FV",
            "FAB",
            "FAB+FC",
            "FV*",
            "SD-H",
            "SD-L",
            "VNAR"
          ],
          "description": "Antibody format: FV, FAB, FAB+FC, FV*, SD-H (heavy-chain single domain, e.g. nanobody), SD-L or VNAR (case-insensitive)."
        },
        "pdb_id": {
          "type": "string",
          "description": "Restrict to one PDB entry (4-character code, e.g. '3hfm')."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based row offset; continue with data.next_offset while data.has_more is true."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "filters_applied": {
              "type": "object"
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "count": {
              "type": "integer",
              "description": "Rows on this page"
            },
            "total_matches": {
              "type": "integer",
              "description": "All antibody instances matching the filters"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "test_examples": [
      {
        "query": "lysozyme",
        "limit": 5
      },
      {
        "query": "spike glycoprotein",
        "antibody_type": "SD-H",
        "limit": 5
      }
    ],
    "fields": {
      "operation": "search_structures"
    }
  },
  {
    "name": "SAbDab_get_structure",
    "description": "Get antibody structure details from SAbDab by PDB ID. Returns CDR annotations, chain information, and antigen binding data. Useful for structural analysis of antibody-antigen complexes.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_structure",
          "default": "get_structure"
        },
        "pdb_id": {
          "type": "string",
          "description": "4-character PDB ID (e.g., 1IGT, 6W41). Alias: pdb_code."
        },
        "pdb_code": {
          "type": "string",
          "description": "Alias for pdb_id. 4-character PDB ID (e.g., 1IGT, 6W41)."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "test_examples": [
      {
        "pdb_id": "1AHW"
      }
    ],
    "fields": {
      "operation": "get_structure"
    }
  },
  {
    "name": "SAbDab_get_structure_summary",
    "description": "Get per-structure curated antibody annotations from SAbDab for a PDB ID. Returns the SAbDab summary TSV row(s): antigen name/type/species, heavy/light chain species and IMGT V-gene subclass, resolution, experimental method, R-free / R-factor, scFv and engineered flags, and (when curated) binding affinity Kd, delta_G, affinity method, temperature and PMID. Use for antibody-antigen complex characterization. Pass a 4-character PDB ID (e.g., 7d6i, 3hfm). No authentication required.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_structure_summary",
          "default": "get_structure_summary"
        },
        "pdb_id": {
          "type": "string",
          "description": "4-character PDB ID of an antibody structure (e.g., '7d6i', '3hfm'). Aliases: pdb_code, pdb."
        },
        "pdb_code": {
          "type": "string",
          "description": "Alias for pdb_id."
        },
        "pdb": {
          "type": "string",
          "description": "Alias for pdb_id."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "description": "Curated SAbDab annotations for one PDB entry. Flat rather than a oneOf of success and error: `data` has to sit at the schema's top level for the validator to recognise the {status,data} envelope and check the whole result.",
      "properties": {
        "status": {
          "type": "string",
          "description": "'success', or 'error' with an 'error' message and no 'data'"
        },
        "error": {
          "type": "string",
          "description": "Present only when status is 'error'. A PDB entry SAbDab does not hold -- it keeps antibody and nanobody structures only -- is an error rather than an empty answer."
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "pdb_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "SAbDab's extended PDB ID, e.g. 'pdb_00003hfm'"
            },
            "query_pdb_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "The id as asked for, e.g. '3hfm'"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolution": {
              "type": [
                "number",
                "null"
              ],
              "description": "Angstroms; null for methods that do not report one"
            },
            "structure_method": {
              "type": [
                "string",
                "null"
              ],
              "description": "e.g. 'X-ray diffraction'"
            },
            "r_work": {
              "type": [
                "number",
                "null"
              ]
            },
            "r_free": {
              "type": [
                "number",
                "null"
              ]
            },
            "deposition_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "release_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "journal_references": {
              "type": [
                "string",
                "null"
              ],
              "description": "Free-text citation as SAbDab stores it. The API carries no PMID field, so this is the only citation available."
            },
            "antibody_type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Distinct SAbDab types of the antibodies present, e.g. ['FAB']"
            },
            "antibody_count": {
              "type": "integer",
              "description": "Paired antibodies in the entry; 1AHW has two copies"
            },
            "heavy_chains": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Chain identifiers typed H"
            },
            "light_chains": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Chain identifiers typed K (kappa) or L (lambda). Testing for 'L' alone drops every kappa chain."
            },
            "single_chain_constructs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Chain identifiers typed M, such as an scFv"
            },
            "heavy_chain_species": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "light_chain_species": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "antigen_chains": {
              "type": "array",
              "description": "Chains typed N: the antigen side of the complex.",
              "items": {
                "type": "object",
                "properties": {
                  "chain": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "e.g. 'HEN EGG WHITE LYSOZYME'"
                  },
                  "organism_scientific": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unclassified_chains": {
              "type": "array",
              "description": "Chains whose SAbDab type is none of H/K/L/M/N. Reported rather than folded into the antigen list, so a type added upstream is visible instead of mislabelled.",
              "items": {
                "type": "object",
                "properties": {
                  "chain": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "chain_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "all_cdr_coords_resolved": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when every antibody in the entry has all CDR coordinates resolved; null when the entry has no paired antibody."
            }
          },
          "required": [
            "pdb_id",
            "antibody_count",
            "heavy_chains",
            "light_chains",
            "antigen_chains"
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "description": "Records that this comes from the SAbDab 2 JSON entry, and that IMGT V-gene subclass is absent from it rather than guessed."
            }
          }
        }
      },
      "required": [
        "status"
      ]
    },
    "test_examples": [
      {
        "pdb_id": "7d6i"
      },
      {
        "pdb_id": "3hfm"
      }
    ],
    "fields": {
      "operation": "get_structure_summary"
    }
  },
  {
    "name": "SAbDab_get_summary",
    "description": "Get SAbDab database summary and statistics. Returns information about database content, features, and access URLs. Good starting point for exploring antibody structural data.",
    "type": "SAbDabTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_summary",
          "default": "get_summary"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "test_examples": [
      {}
    ],
    "fields": {
      "operation": "get_summary"
    }
  }
]