[
  {
    "name": "SCXA_list_experiments",
    "description": "List a resumable page of single-cell RNA-seq experiments from EBI Single Cell Expression Atlas, with species, cell counts, technology, and experimental factors. Filter by species or keyword; metadata.total_matching is the exact post-filter count and metadata.next_offset continues the result set.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name to filter by (e.g., 'Homo sapiens', 'Mus musculus', 'Drosophila melanogaster'). Case-insensitive."
        },
        "keyword": {
          "type": "string",
          "description": "Keyword to search in experiment descriptions and factors (e.g., 'pancreas', 'brain', 'cancer', 'immune')."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Page size (default 20, max 100).",
          "default": 20
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based experiment offset. Continue with metadata.next_offset.",
          "default": 0
        }
      }
    },
    "fields": {
      "operation": "list_experiments"
    },
    "type": "SCExpressionAtlasTool",
    "test_examples": [
      {
        "species": "Homo sapiens",
        "limit": 5
      },
      {
        "keyword": "pancreas",
        "limit": 10
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accession": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "species": {
            "type": "string"
          },
          "technology": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "num_cells": {
            "type": "integer"
          },
          "experimental_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experiment_type": {
            "type": "string"
          },
          "last_updated": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "label": [
      "Single Cell Expression Atlas",
      "scRNA-seq",
      "Cell Type"
    ],
    "metadata": {
      "tags": [
        "single_cell",
        "rna_seq",
        "cell_type",
        "expression",
        "experiment_discovery"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "SCXA_search_gene",
    "description": "Search the EBI Single Cell Expression Atlas for single-cell experiments where a specific gene is expressed. Accepts gene symbols (TP53, BRCA1) or Ensembl IDs (ENSG00000141510). Returns matching scRNA-seq experiments with cell counts, technology, PubMed IDs, and DOIs. Useful for finding single-cell datasets studying a gene of interest. Example: TP53 returns 15 experiments including ovarian cancer, lung atlas datasets.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., 'TP53', 'BRCA1', 'INS') or Ensembl gene ID (e.g., 'ENSG00000141510')."
        },
        "species": {
          "type": "string",
          "description": "Species name to filter (e.g., 'Homo sapiens', 'Mus musculus'). Optional."
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "operation": "search_gene"
    },
    "type": "SCExpressionAtlasTool",
    "test_examples": [
      {
        "gene": "TP53",
        "species": "Homo sapiens"
      },
      {
        "gene": "ENSG00000141510"
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accession": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "species": {
            "type": "string"
          },
          "num_cells": {
            "type": "integer"
          },
          "technology": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "experimental_factors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "pubmed_ids": {
            "type": [
              "array",
              "null"
            ]
          },
          "dois": {
            "type": [
              "array",
              "null"
            ]
          }
        }
      }
    },
    "label": [
      "Single Cell Expression Atlas",
      "Gene Expression",
      "scRNA-seq"
    ],
    "metadata": {
      "tags": [
        "single_cell",
        "gene_expression",
        "scRNA_seq",
        "cell_type",
        "gene_search"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "SCXA_get_cluster_marker_genes",
    "description": "Get EBI Single Cell Expression Atlas computed marker genes per cell cluster or inferred cell type. When limit is supplied, offset and metadata.next_offset provide resumable local pagination; metadata.num_markers is the exact full row count rather than the page length. Omitting limit preserves the all-rows behavior.",
    "parameter": {
      "type": "object",
      "properties": {
        "experiment_accession": {
          "type": "string",
          "description": "SCXA experiment accession (e.g. 'E-MTAB-5061', 'E-ENAD-13', 'E-CURD-4'). Use SCXA_list_experiments to find accessions."
        },
        "marker_type": {
          "type": "string",
          "enum": [
            "clusters",
            "cell_types"
          ],
          "default": "clusters",
          "description": "'clusters' for marker genes per cluster at resolution k (default); 'cell_types' for marker genes per inferred cell type (requires organism_part)."
        },
        "k": {
          "type": "integer",
          "description": "Clustering resolution / number of clusters for marker_type='clusters' (e.g. 8, 4, 6). Required for clusters mode.",
          "minimum": 1
        },
        "organism_part": {
          "type": "string",
          "description": "Organism part for marker_type='cell_types' (e.g. 'pancreas', 'lung'). Required for cell_types mode."
        },
        "limit": {
          "type": "integer",
          "description": "Optional page size. Omit to return all marker rows from offset.",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based marker-row offset. Default 0.",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "experiment_accession"
      ]
    },
    "fields": {
      "operation": "cluster_marker_genes"
    },
    "type": "SCExpressionAtlasTool",
    "test_examples": [
      {
        "experiment_accession": "E-MTAB-5061",
        "k": 8,
        "limit": 20
      },
      {
        "experiment_accession": "E-ENAD-13",
        "k": 4,
        "limit": 20
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gene_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cell_group_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cell_group_value_where_marker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "expression_unit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "Single Cell Expression Atlas",
      "Marker Genes",
      "Cluster"
    ],
    "metadata": {
      "tags": [
        "single_cell",
        "marker_genes",
        "cluster",
        "cell_type",
        "scRNA_seq"
      ],
      "estimated_execution_time": "< 15 seconds"
    }
  }
]
