  {
    "name": "ORCID_get_fundings",
    "type": "ORCIDTool",
    "description": "Get every public funding-summary assertion in every ORCID funding group, including group/summary indexes, group and summary external IDs, title, funder, type, dates, and URL. Metadata distinguishes funding groups from summaries and confirms no grouped source assertion was silently dropped.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_fundings"
          ],
          "description": "Operation type",
          "default": "get_fundings"
        },
        "orcid": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9Xx]$",
          "description": "ORCID iD in format XXXX-XXXX-XXXX-XXXX (e.g., '0000-0001-5109-3700')"
        }
      },
      "required": [
        "orcid"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "put_code": {
