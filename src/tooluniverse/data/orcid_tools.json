[
  {
    "name": "ORCID_get_profile",
    "type": "ORCIDTool",
    "description": "Get the complete public ORCID record after format and ISO 7064 checksum validation. Returns the raw person and activities-summary objects plus convenience fields. Legacy works_count/employments_count are explicitly group counts; separate group and summary counts prevent grouped assertions from being mistaken for individual works or employments.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_profile"
          ],
          "description": "Operation type",
          "default": "get_profile"
        },
        "orcid": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9Xx]$",
          "description": "ORCID iD in format XXXX-XXXX-XXXX-XXXX (e.g., '0000-0002-1825-0097')"
        }
      },
      "required": [
        "orcid"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "orcid": {
          "type": "string"
        },
        "name": {},
        "biography": {},
        "emails": {},
        "keywords": {},
        "urls": {},
        "external_identifiers": {},
        "other_names": {},
        "addresses": {},
        "person": {"type": "object"},
        "activities_summary": {"type": "object"},
        "works_count": {
          "type": "integer"
        },
        "employments_count": {
          "type": "integer"
        },
        "works_group_count": {"type": "integer"},
        "works_summary_count": {"type": "integer"},
        "employment_group_count": {"type": "integer"},
        "employment_summary_count": {"type": "integer"}
      }
    },
    "test_examples": [
      {
        "operation": "get_profile",
        "orcid": "0000-0002-1825-0097"
      }
    ],
    "fields": {
      "operation": "get_profile"
    }
  },
  {
    "name": "ORCID_get_works",
    "type": "ORCIDTool",
    "description": "Get every public work-summary assertion for an ORCID researcher. ORCID groups equivalent works from multiple sources; this wrapper returns every summary in every group (not only the first), with group/summary indexes and group external IDs. Metadata distinguishes work_group_count from work_summary_count and confirms all summaries were returned.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_works"
          ],
          "description": "Operation type",
          "default": "get_works"
        },
        "orcid": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9Xx]$",
          "description": "ORCID iD in format XXXX-XXXX-XXXX-XXXX"
        }
      },
      "required": [
        "orcid"
      ]
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "test_examples": [
      {
        "operation": "get_works",
        "orcid": "0000-0002-1825-0097"
      }
    ],
    "fields": {
      "operation": "get_works"
    }
  },
  {
    "name": "ORCID_search_researchers",
    "type": "ORCIDTool",
    "description": "Search ORCID expanded-search with strict start/rows controls. Returns names, other names, institutions, and checksum-validated ORCID iDs. Metadata exposes total_found, returned, has_more, next_start, and page_complete; continue with next_start while has_more is true. Live family-name:Smith currently has over 24,000 records.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_researchers"
          ],
          "description": "Operation type",
          "default": "search_researchers"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search query (e.g., 'BRCA1 cancer genetics', 'Harvard genomics')"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Pagination offset (0-based)"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 10,
          "description": "Number of results to return"
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "test_examples": [
      {
        "operation": "search_researchers",
        "query": "BRCA1 cancer genetics",
        "rows": 5
      }
    ],
    "fields": {
      "operation": "search_researchers"
    }
  },
