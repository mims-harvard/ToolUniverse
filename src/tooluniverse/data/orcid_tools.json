      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_profile"
          ],
          "description": "Operation type",
          "default": "get_profile"
        },
        "orcid": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9Xx]$",
          "description": "ORCID iD in format XXXX-XXXX-XXXX-XXXX (e.g., '0000-0002-1825-0097')"
