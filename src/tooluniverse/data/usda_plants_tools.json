                            }
                        },
                        "related_links": {
                            "type": [
                                "array",
                                "null"
                            ]
                        },
                        "available_data": {
                            "type": "object",
                            "description": "Which sibling tool will have something for this plant -- characteristics, wetland, wildlife, invasive, noxious, images -- as USDA states it per record. A caller otherwise finds out by trying."
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
