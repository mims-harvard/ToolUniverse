                        },
                        "protected_statuses": {
                            "type": [
                                "array",
                                "object",
                                "null"
                            ]
                        },
                        "notes": {
                            "type": [
                                "object",
                                "null"
                            ],
                            "description": "USDA's own notes: general, synonym, subordinate-taxa and legal"
