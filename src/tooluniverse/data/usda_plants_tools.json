[
    {
        "name": "USDA_plants_get_profile",
        "description": "Get a USDA PLANTS Database profile for a plant by its PLANTS symbol (e.g. 'ABBA' = balsam fir): scientific name, common name, taxonomic group/rank, duration (annual/perennial), growth habits (tree/shrub/forb), and synonyms. 'native_statuses' gives region-level (e.g. 'L48', 'CAN') native/introduced status; fine-grained per-state/county FIPS distribution codes are not returned by this endpoint (fips_distribution is included for forward-compatibility but is null in the current USDA API response). Authoritative US plant taxonomy. No API key required.",
        "parameter": {
            "type": "object",
            "properties": {
                "symbol": {
                    "type": "string",
                    "description": "USDA PLANTS symbol, e.g. 'ABBA' (balsam fir), 'ACRU' (red maple), 'QUAL' (white oak)."
                }
            },
            "required": [
                "symbol"
            ]
        },
        "fields": {
            "timeout": 30
        },
        "type": "USDAPlantsProfileTool",
        "test_examples": [
            {
                "symbol": "ABBA"
            },
            {
                "symbol": "ACRU"
            },
            {
                "symbol": "QUAL"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "not": {
                        "required": [
                            "error"
                        ]
                    },
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "symbol": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "The symbol USDA answered WITH, which is not always the one asked for: a synonym symbol is redirected to the accepted taxon (symbol=AGRE2 answers ELRE4)."
                        },
                        "queried_symbol": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "synonym_note": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "Set when the two differ, stating the substitution"
                        },
                        "scientific_name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "common_name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "other_common_names": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "group": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "rank": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "rank_id": {
                            "type": [
                                "integer",
                                "string",
                                "null"
                            ]
                        },
                        "duration": {
                            "type": [
                                "array",
                                "string",
                                "null"
                            ]
                        },
                        "growth_habits": {
                            "type": [
                                "array",
                                "string",
                                "null"
                            ]
                        },
                        "native_statuses": {
                            "type": [
                                "array",
                                "null"
                            ],
                            "description": "Native, introduced or both, per region"
                        },
                        "synonyms": {
                            "type": [
                                "array",
                                "null"
                            ]
                        },
                        "synonym_symbol": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "accepted_symbol": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "accepted_id": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "accepted_scientific_name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "accepted_common_name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "ancestors": {
                            "type": "array",
                            "description": "The classification, Kingdom down to Genus, each ancestor with its own symbol and rank. Nine of them for balsam fir, and the profile already held them.",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "symbol": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "scientific_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "common_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "rank": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "rank_id": {
                                        "type": [
                                            "integer",
                                            "string",
                                            "null"
                                        ]
                                    }
                                }
                            }
                        },
                        "map_coordinates": {
