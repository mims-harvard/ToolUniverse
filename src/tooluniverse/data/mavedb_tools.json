                "version": {"type": ["string", "null"]},
                "note": {"type": ["string", "null"], "description": "The curator's note on why this keyword applies here, which is not the term's definition"}
              }
            }
          },
            "score_set_urns": {"type": "array", "items": {"type": "string"}},
            "num_score_sets": {"type": ["integer", "null"]},
            "publications": {"type": "array", "items": {"type": "object"}}
          }
        },
        "mapping_state": {"type": ["string", "null"], "description": "'incomplete' is why a variant query can come back with no VRS allele"},
        "processing_state": {"type": ["string", "null"]},
        "meta_analyzes_score_set_urns": {"type": "array", "items": {"type": "string"}},
        "meta_analyzed_by_score_set_urns": {"type": "array", "items": {"type": "string"}},
        "official_collections": {"type": "array", "items": {"type": "object"}},
        "external_links": {"type": ["object", "null"]}
      }
    }
  },
  {
    "name": "MaveDB_get_variant_scores",
    "description": "Get functional variant effect scores from a MaveDB score set. Returns HGVS-annotated variants with their functional scores from deep mutational scanning or other MAVE assays. Scores indicate variant effect on protein function (interpretation depends on the specific assay - check score set metadata). Optionally filter by HGVS protein notation (e.g., 'Arg175' to find all R175 substitutions). The /scores endpoint returns every variant in one CSV; `limit` is client-side truncation only — set `limit=0` (or omit) to receive ALL variants in one call (use this for whole-protein DMS analyses, e.g. KRAS folding ΔΔG has ~2200 variants).",
    "parameter": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "description": "MaveDB score set URN (e.g., 'urn:mavedb:00001234-c-1'). Obtain from MaveDB_search_score_sets."
        },
        "hgvs_pro": {
          "type": "string",
          "description": "Optional filter: HGVS protein notation substring (e.g., 'Arg175', 'p.Arg175His'). Case-insensitive partial match on protein-level HGVS."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Maximum variants to return after client-side filtering. Set to 0 or null to return all variants in the score set (default — needed for whole-protein DMS workflows). Set to a positive integer to truncate. The MaveDB API returns the full CSV in one HTTP call regardless, so 'unlimited' has no extra cost.",
          "default": 0
        }
      },
      "required": ["urn"]
    },
    "fields": {
      "operation": "get_variant_scores"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "urn": "urn:mavedb:00001234-c-1",
        "limit": 10
      },
      {
        "urn": "urn:mavedb:00001234-c-1",
        "hgvs_pro": "Arg175",
        "limit": 20
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "urn": {"type": "string"},
        "total_variants_in_set": {"type": "integer"},
        "returned": {"type": "integer"},
        "truncated": {"type": "boolean"},
        "limit_applied": {"type": ["integer", "null"]},
        "hgvs_filter": {"type": ["string", "null"]},
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hgvs_nt": {"type": ["string", "null"]},
              "hgvs_splice": {"type": ["string", "null"]},
              "hgvs_pro": {"type": ["string", "null"]},
              "score": {"type": ["number", "null"]}
            }
          }
        }
      }
    }
  },
  {
    "name": "MaveDB_search_experiments",
    "description": "Search MaveDB for experiments (groups of related score sets from the same study). Each experiment may contain multiple score sets from different replicates, conditions, or analysis methods. Returns experiment URNs, titles, associated score sets, and publications. Search by gene name, protein, or assay keywords.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query: gene symbol (e.g., 'TP53', 'BRCA1'), protein name, or keywords describing the experiment."
        }
      },
      "required": ["query"]
    },
    "fields": {
      "operation": "search_experiments"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "query": "BRCA1"
      },
      {
        "query": "deep mutational scanning"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {"type": "string"},
        "total_experiments": {"type": "integer"},
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "urn": {"type": ["string", "null"]},
              "title": {"type": ["string", "null"]},
              "short_description": {"type": ["string", "null"]},
              "published_date": {"type": ["string", "null"]},
              "score_set_urns": {
                "type": "array",
                "items": {"type": "string"}
              },
              "num_score_sets": {"type": "integer"},
              "publications": {
                "type": "array",
                "description": "Each paper with its journal, year, DOI, citation and author list, not only the identifier and title",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {"type": ["string", "null"]},
                    "db_name": {"type": ["string", "null"]},
                    "title": {"type": ["string", "null"]},
                    "journal": {"type": ["string", "null"]},
                    "year": {"type": ["integer", "string", "null"]},
                    "doi": {"type": ["string", "null"]},
                    "url": {"type": ["string", "null"]},
                    "citation": {"type": ["string", "null"]},
                    "authors": {"type": "array", "items": {"type": "object"}},
                    "author_count": {"type": "integer"},
                    "authors_truncated": {"type": "boolean"}
                  }
                }
              },
              "abstract": {"type": ["string", "null"], "description": "An experiment IS its method; the row carried a title and a one-line description, so two experiments on the same gene were indistinguishable"},
              "method": {"type": ["string", "null"], "description": "How the library was made and how the phenotype was read"},
              "keywords": {
                "type": "array",
                "description": "The controlled keywords the experiment is indexed under: assay method, phenotype measured, delivery method",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {"type": ["string", "null"]},
                    "label": {"type": ["string", "null"]},
                    "description": {"type": ["string", "null"]},
                    "special": {"type": ["boolean", "null"]},
                    "system": {"type": ["string", "null"]},
                    "code": {"type": ["string", "null"]},
                    "version": {"type": ["string", "null"]},
                    "note": {"type": ["string", "null"]}
                  }
                }
              },
              "experiment_set_urn": {"type": ["string", "null"]},
              "secondary_publications": {"type": "array", "items": {"type": "object"}},
              "raw_read_identifiers": {"type": "array", "items": {"type": "object"}},
              "doi_identifiers": {"type": "array", "items": {"type": "object", "properties": {"identifier": {"type": ["string", "null"]}, "url": {"type": ["string", "null"]}}}},
              "contributors": {"type": "array", "description": "Who deposited it, with the ORCIDs that are the attribution they asked for", "items": {"type": "object", "properties": {"orcid_id": {"type": ["string", "null"]}, "given_name": {"type": ["string", "null"]}, "family_name": {"type": ["string", "null"]}}}}
            }
          }
        }
      }
    }
  },
  {
    "name": "MaveDB_get_effect_matrix",
    "description": "One-shot DMS data loader: fetch a MaveDB score set, parse HGVS to (ref_aa, position, alt_aa), filter to single missense, optionally verify position numbering against a UniProt canonical sequence, and reshape into a (20 amino acids × n_positions) effect matrix ready for downstream analysis. Hides the boilerplate that variant-effect-prediction benchmarking and residue-mechanism interpretation skills used to inline. Returns the matrix, the position list, the standard amino acid order, and explicit numbering / drop / score-field metadata so the caller can audit what was loaded.",
    "parameter": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "description": "MaveDB score set URN (e.g., 'urn:mavedb:00000115-a-7'). Obtain from MaveDB_search_score_sets."
        },
        "uniprot_id": {
          "type": ["string", "null"],
          "description": "Optional UniProt accession (e.g., 'P01116' for KRAS). If supplied, the tool fetches the canonical sequence and verifies the MaveDB position numbering against it via a landmark check; sets numbering_offset and surfaces a warning in numbering_check if the positions don't match (silent off-by-N is the #1 silent bug in DMS analysis)."
        },
        "score_field": {
          "type": ["string", "null"],
          "description": "Optional explicit column name to use as the variant score (e.g., 'score', 'ddG', 'fitness'). If omitted, tries 'score' → 'ddG' → 'fitness' → first numeric non-HGVS field in that order. The actual field used is reported in data.score_field_used."
        }
      },
      "required": ["urn"]
    },
    "fields": {
      "operation": "get_effect_matrix"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "urn": "urn:mavedb:00000115-a-7",
        "uniprot_id": "P01116"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "urn": {
              "type": "string"
            },
            "matrix": {
              "type": "array",
              "description": "(20 × n_positions) effect matrix. Rows = 20 standard amino acids in 'ACDEFGHIKLMNPQRSTVWY' order. Cells = score for that (alt_aa, position) variant, or null for unmeasured / WT-diagonal.",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "positions": {
              "type": "array",
              "description": "Sorted list of 1-based residue positions (length = matrix's column count).",
              "items": {
                "type": "integer"
              }
            },
            "amino_acid_order": {
              "type": "string",
              "description": "Always 'ACDEFGHIKLMNPQRSTVWY' for consistency across downstream skills."
            },
            "shape": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "n_parsed_single_missense": {
              "type": "integer"
            },
            "n_dropped": {
              "type": "integer"
            },
            "n_total_rows": {
              "type": "integer"
            },
            "score_field_used": {
              "type": [
                "string",
                "null"
              ]
            },
            "numbering_check": {
              "type": [
                "object",
                "null"
              ]
            },
            "numbering_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "matrix",
            "positions",
            "amino_acid_order"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MaveDB_get_mapped_variants",
    "description": "Get genomically-mapped variant coordinates (GA4GH VRS Allele + ClinGen Allele ID) for a MaveDB score set. Each variant carries genomic_hgvs (MaveDB's own projection of the scored variant onto an NC_ genome accession, null when it could not be projected), cdna_hgvs, protein_hgvs, the ClinGen canonical Allele ID, the preMapped/postMapped VRS pair, and assay_level (the level the assay scored: protein, cdna or genomic). Reads the /variant-details route that replaced /mapped-variants, retired upstream and answering HTTP 410 as of 2026-11-01; it takes no page-size parameter and streams the whole score set as newline-delimited JSON (784 variants = 11.4 MB), so limit/offset provide recoverable local pagination over that download. Continue with next_offset while has_more is true. Obtain the URN from MaveDB_search_score_sets.",
    "parameter": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "description": "MaveDB score set URN (e.g., 'urn:mavedb:00001263-a-2' for BRCA2 SGE). Obtain from MaveDB_search_score_sets."
        },
        "limit": {
          "type": ["integer", "null"],
