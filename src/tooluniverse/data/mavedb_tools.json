          "items": {
            "type": "object",
            "properties": {
            "name": {"type": ["string", "null"]},
            "category": {"type": ["string", "null"], "description": "e.g. protein_coding"},
            "mapped_hgnc_name": {"type": ["string", "null"]},
            "accession": {"type": ["string", "null"], "description": "Given instead of a sequence on most search rows"},
            "accession_gene": {"type": ["string", "null"]},
            "accession_assembly": {"type": ["string", "null"]},
            "is_base_editor": {"type": ["boolean", "null"]},
            "uniprot_id": {"type": ["string", "null"]},
            "external_identifiers": {"type": "array", "items": {"type": "object"}, "description": "Ensembl, RefSeq and UniProt ids with the offset each is aligned at"},
            "sequence_type": {"type": ["string", "null"], "description": "dna or protein"},
            "sequence_length": {"type": ["integer", "null"]},
            "sequence": {"type": ["string", "null"], "description": "The construct positions are numbered against"},
            "organism": {"type": ["string", "null"], "description": "A score set read against the wrong organism is a different experiment"},
            "taxon_id": {"type": ["integer", "string", "null"]},
            "common_name": {"type": ["string", "null"]},
            "taxon_rank": {"type": ["string", "null"]},
            "taxon_url": {"type": ["string", "null"]},
            "taxon_reference": {"type": ["string", "null"]},
            "record_id": {"type": ["integer", "string", "null"], "description": "MaveDB's internal numeric key; the urn is what its endpoints take"}
            }
          }
          },
        "doi_identifiers": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "primary_publications": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "description": "The bare identifiers, kept as they were; `publications` has the same papers in full"
        },
        "publications": {
          "type": "array",
          "description": "The papers, as MaveDB answers them: title, journal, year, DOI, a formatted citation and the author list. The tools returned the bare PubMed number.",
          "items": {
            "type": "object",
            "properties": {
            "identifier": {"type": ["string", "null"]},
            "db_name": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "journal": {"type": ["string", "null"]},
