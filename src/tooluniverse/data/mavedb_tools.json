[
  {
    "name": "MaveDB_search_score_sets",
    "description": "Search MaveDB for variant effect score sets from Multiplexed Assays of Variant Effect (MAVE) experiments, including deep mutational scanning. Returns score set URNs, target genes, titles, variant counts, and publication dates. Metadata exposes the exact total and next_offset so every result from MaveDB's full search response is reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search text - gene name (e.g., 'BRCA1', 'TP53'), protein name, or keyword. Searches titles and descriptions of score sets."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results to return.",
          "default": 20
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based result offset. Continue with metadata.next_offset while has_more is true."
        }
      },
      "required": ["query"]
    },
    "fields": {
      "operation": "search"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "query": "BRCA1"
      },
      {
        "query": "TP53",
        "limit": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "urn": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "short_description": {"type": ["string", "null"]},
          "num_variants": {"type": ["integer", "null"]},
          "published_date": {"type": ["string", "null"]},
          "target_genes": {"type": ["array", "null"], "items": {"type": "string"}},
          "target_gene_details": {
          "type": "array",
          "description": "What the assay was run on. `uniprot_id` used to be read from targetSequence.uniprot, a key a target sequence does not carry, so it was null on every score set while the accession sat in uniprotIdFromMappedMetadata.",
          "items": {
            "type": "object",
            "properties": {
            "name": {"type": ["string", "null"]},
            "category": {"type": ["string", "null"], "description": "e.g. protein_coding"},
            "mapped_hgnc_name": {"type": ["string", "null"]},
            "accession": {"type": ["string", "null"], "description": "Given instead of a sequence on most search rows"},
            "accession_gene": {"type": ["string", "null"]},
            "accession_assembly": {"type": ["string", "null"]},
            "is_base_editor": {"type": ["boolean", "null"]},
            "uniprot_id": {"type": ["string", "null"]},
            "external_identifiers": {"type": "array", "items": {"type": "object"}, "description": "Ensembl, RefSeq and UniProt ids with the offset each is aligned at"},
            "sequence_type": {"type": ["string", "null"], "description": "dna or protein"},
            "sequence_length": {"type": ["integer", "null"]},
            "sequence": {"type": ["string", "null"], "description": "The construct positions are numbered against"},
            "organism": {"type": ["string", "null"], "description": "A score set read against the wrong organism is a different experiment"},
            "taxon_id": {"type": ["integer", "string", "null"]},
            "common_name": {"type": ["string", "null"]},
            "taxon_rank": {"type": ["string", "null"]},
            "taxon_url": {"type": ["string", "null"]},
            "taxon_reference": {"type": ["string", "null"]},
            "record_id": {"type": ["integer", "string", "null"], "description": "MaveDB's internal numeric key; the urn is what its endpoints take"}
            }
          }
          },
          "publications": {
          "type": "array",
          "description": "The papers, as MaveDB answers them: title, journal, year, DOI, a formatted citation and the author list. The tools returned the bare PubMed number.",
          "items": {
            "type": "object",
            "properties": {
            "identifier": {"type": ["string", "null"]},
            "db_name": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "journal": {"type": ["string", "null"]},
            "year": {"type": ["integer", "string", "null"]},
            "doi": {"type": ["string", "null"]},
            "url": {"type": ["string", "null"]},
            "citation": {"type": ["string", "null"]},
            "authors": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": ["string", "null"]}, "primary": {"type": ["boolean", "null"]}}}},
            "author_count": {"type": "integer"},
            "authors_truncated": {"type": "boolean"}
            }
          }
          },
          "secondary_publications": {"type": "array", "items": {"type": "object"}, "description": "Carried; present on 2 of the 62 BRCA1 hits, so a default page of 20 can hold none"},
          "experiment_urn": {"type": ["string", "null"]},
          "experiment_title": {"type": ["string", "null"]},
          "experiment_method": {"type": ["string", "null"], "description": "How the assay was done, which is what tells two score sets of the same gene apart"},
          "experiment_set_urn": {"type": ["string", "null"]},
          "keywords": {
          "type": "array",
          "description": "The controlled keywords the experiment is indexed under: the assay method, the phenotype measured, how the library was delivered. A caller had the free-text title to guess from.",
          "items": {
            "type": "object",
            "properties": {
            "key": {"type": ["string", "null"]},
            "label": {"type": ["string", "null"]},
            "description": {"type": ["string", "null"]},
            "special": {"type": ["boolean", "null"]},
            "system": {"type": ["string", "null"]},
            "code": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]},
            "note": {"type": ["string", "null"], "description": "The curator's note on why this keyword applies here, which is not the term's definition"}
            }
          }
          },
          "license": {"type": ["string", "null"]},
          "license_name": {"type": ["string", "null"]},
          "license_url": {"type": ["string", "null"]}
        }
      }
    }
  },
  {
    "name": "MaveDB_get_score_set",
    "description": "Get detailed information about a specific MaveDB score set by its URN identifier. Returns the target gene, experimental methods, variant count, publications, and license. Score sets contain functional impact scores from deep mutational scanning or saturation genome editing experiments.",
    "parameter": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "description": "MaveDB score set URN (e.g., 'urn:mavedb:00000001-a-1'). Obtain URNs from MaveDB_search_score_sets."
        }
      },
      "required": ["urn"]
    },
    "fields": {
      "operation": "get_score_set"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "urn": "urn:mavedb:00000001-a-1"
      },
      {
        "urn": "urn:mavedb:00000097-i-2"
      }
    ],
