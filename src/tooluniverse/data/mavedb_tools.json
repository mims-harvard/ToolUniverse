  {
    "name": "MaveDB_get_clinical_controls",
    "description": "Get ClinVar clinical-control variants overlapping a MaveDB score set for functional-score calibration. Returns identifiers, gene, clinical significance, review status, version, and linked MaveDB variant URNs. The significance filter is applied before exact total counts and recoverable limit/offset pagination; continue with next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "description": "MaveDB score set URN (e.g., 'urn:mavedb:00001263-a-2' for BRCA2 SGE). Obtain from MaveDB_search_score_sets."
        },
        "clinical_significance": {
          "type": ["string", "null"],
          "description": "Optional exact-match filter on ClinVar clinical significance (case-insensitive), e.g. 'Pathogenic', 'Benign', 'Uncertain significance'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Maximum clinical controls on this page. Set to 0 or null to return everything from offset onward.",
          "default": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset after the optional significance filter. Continue with data.next_offset.",
          "default": 0
        }
      },
      "required": ["urn"]
    },
    "fields": {
      "operation": "get_clinical_controls"
    },
    "type": "MaveDBTool",
    "test_examples": [
      {
        "urn": "urn:mavedb:00001263-a-2",
        "limit": 50
      },
      {
        "urn": "urn:mavedb:00001263-a-2",
        "clinical_significance": "Pathogenic",
        "limit": 20
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "urn": {
              "type": "string"
            },
            "total_clinical_controls": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            },
            "offset": {
              "type": "integer"
            },
            "limit_applied": {
              "type": [
                "integer",
                "null"
              ]
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "significance_filter": {
              "type": [
                "string",
                "null"
              ]
            },
            "significance_breakdown": {
              "type": "object"
            },
            "clinical_controls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "db_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "db_identifier": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "db_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gene_symbol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "clinical_significance": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "clinical_review_status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mapped_variant_urns": {
                    "type": "array",
                    "description": "The score set's own variants this control maps to. Read from `clinvarLinks`; it used to be read from `mappedVariants`, a key the response does not carry, so it was empty on all 2,122 controls and the link between a ClinVar call and the measured score -- the reason this endpoint exists -- was missing.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "variant_links": {
                    "type": "array",
                    "description": "Each link with the allele digest it was matched on, so a control mapping to one variant through two alleles reads as that rather than as a duplicate",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variant_urn": {"type": ["string", "null"]},
                        "allele_digest": {"type": ["string", "null"]}
                      }
                    }
                  },
                  "record_id": {
                    "type": ["integer", "string", "null"],
                    "description": "MaveDB's internal numeric key for the control"
                  }
                }
              }
            }
          },
          "required": [
            "urn",
            "clinical_controls"
          ]
        },
