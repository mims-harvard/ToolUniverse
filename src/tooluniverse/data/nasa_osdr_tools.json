[
  {
    "name": "OSDR_search_studies",
    "type": "NASAOSDRTool",
    "description": "Full-text search NASA's Open Science Data Repository (OSDR, formerly GeneLab): ~1,000 space biology studies on how spaceflight and microgravity affect organisms, across transcriptomics, proteomics, microscopy, and physiology assays. Optionally filter by organism. Example: query='microgravity bone loss', organism='Mus musculus'. Results also include cross-referenced external datasets (e.g. GEO); only rows with usable_with_get_study true work with OSDR_get_study and OSDR_list_files.",
    "fields": {
      "operation": "search_studies"
    },
    "parameter": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "Free-text search, e.g. 'microgravity bone loss', 'radiation Drosophila'."
        },
        "organism": {
          "type": ["string", "null"],
          "description": "Optional organism filter, e.g. 'Mus musculus', 'Homo sapiens', 'Arabidopsis thaliana'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max studies to return, 1-100. Default 25."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession": {"type": ["string", "null"]},
              "title": {"type": ["string", "null"]},
              "organism": {"type": ["string", "null"]},
              "mission": {"type": ["string", "null"]},
              "flight_program": {"type": ["string", "null"]},
              "assay_measurement_type": {"type": ["string", "null"]},
              "assay_technology_type": {"type": ["string", "null"]},
              "factor_name": {"type": ["string", "null"]},
              "release_date": {"type": ["string", "number", "null"], "description": "Public release date. OSDR sends it as a string of digits, and as the literal '0000000000' for a row with no date -- so the previous declaration of number-or-null never matched its own output."},
              "assay_technology_platform": {"type": ["string", "null"], "description": "The platform the assay ran on, e.g. the GEO platform id GPL1219. Often the only one of the three assay fields populated: assay_technology_type is empty on the first microgravity hit while the platform reads GPL1219."},
              "project_type": {"type": ["string", "null"], "description": "Study design, e.g. 'Expression profiling by array'."},
              "description": {"type": ["string", "null"], "description": "What the study was, capped at DESCRIPTION_CHARACTERS with an ellipsis -- the text a caller reads to choose between hits."},
              "investigator": {"type": ["string", "null"], "description": "Who ran the study."},
              "data_source_type": {"type": ["string", "null"], "description": "Which repository the row came from -- the note already warns that OSDR indexes external datasets, and this is the field that says which."},
              "data_source_accession": {"type": ["string", "null"]},
              "funding_agency": {"type": ["string", "null"]},
              "managing_nasa_center": {"type": ["string", "null"]},
              "usable_with_get_study": {"type": "boolean"}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"query": "microgravity bone loss", "organism": "Mus musculus", "limit": 5},
      {"query": "radiation Drosophila", "limit": 5}
    ]
  },
  {
    "name": "OSDR_get_study",
    "type": "NASAOSDRTool",
    "description": "Retrieve full metadata for one NASA OSDR space biology study: title, description, organism, spaceflight mission, experimental factors, assay type, and publication details. Example: study_id='OSD-1' (Drosophila immune response aboard the Space Shuttle). Use OSDR_search_studies to find a study_id.",
    "fields": {
      "operation": "get_study"
    },
    "parameter": {
      "type": "object",
      "required": ["study_id"],
      "properties": {
        "study_id": {
          "type": "string",
          "description": "OSDR study accession, e.g. 'OSD-1' or '1'."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "accession": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "description": {"type": ["string", "null"]},
            "organism": {"type": ["string", "null"]},
            "material_type": {"type": ["string", "null"]},
            "mission": {},
            "flight_program": {"type": ["string", "null"]},
            "project_title": {"type": ["string", "null"]},
            "factor_name": {},
            "factor_type": {},
            "assay_measurement_type": {},
            "assay_technology_type": {},
            "publication_title": {},
            "publication_authors": {},
            "release_date": {},
            "protocol_names": {"type": ["array", "string", "null"], "items": {"type": "string"}, "description": "The study's protocols by name; OSD-1 lists eight. These three protocol fields are the methods and all three were dropped."},
            "protocol_types": {"type": ["array", "string", "null"], "items": {"type": "string"}},
            "protocol_descriptions": {"type": ["array", "string", "null"], "items": {"type": "string"}, "description": "The protocol text itself."},
            "investigator": {"type": ["string", "null"], "description": "The study person, assembled from the separate name parts OSDR stores."},
            "funding_agency": {"type": ["string", "null"]},
            "grant_number": {"type": ["string", "null"]},
            "managing_nasa_center": {"type": ["string", "null"]},
            "space_program": {"type": ["string", "null"]},
            "project_identifier": {"type": ["string", "null"]},
            "project_link": {"type": ["string", "null"]},
            "project_type": {"type": ["string", "null"]},
            "experiment_platform": {"type": ["string", "null"]},
            "assay_technology_platform": {"type": ["string", "null"]},
            "characteristics": {},
            "factor_values": {},
            "parameter_values": {},
            "identifiers": {},
            "data_source_type": {"type": ["string", "null"], "description": "Which repository the record came from; OSDR also indexes cross-referenced external datasets."},
            "data_source_accession": {"type": ["string", "null"]},
            "authoritative_source_url": {"type": ["string", "null"]},
            "acknowledgments": {"type": ["string", "null"]},
            "assays_url": {"type": ["string", "null"], "description": "Link to the study's assay list. `assays` on this endpoint is an object holding only a REST_URL rather than a list, so counting it gave 1 for every study."},
            "files_url": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"study_id": "OSD-1"},
      {"study_id": "486"}
    ]
  },
  {
    "name": "OSDR_list_files",
    "type": "NASAOSDRTool",
    "description": "List the downloadable data files for one NASA OSDR study: raw and processed files across assay types, with category, size, and download path. Example: study_id='OSD-1' returns 73 files including microarray differential expression tables. Use OSDR_search_studies to find a study_id.",
    "fields": {
      "operation": "list_files"
    },
    "parameter": {
      "type": "object",
      "required": ["study_id"],
      "properties": {
        "study_id": {
          "type": "string",
          "description": "OSDR study accession, e.g. 'OSD-1' or '1'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max files to return, 1-200. Default 50."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_name": {"type": ["string", "null"]},
              "category": {"type": ["string", "null"]},
              "subcategory": {"type": ["string", "null"]},
              "file_size_bytes": {"type": ["integer", "null"]},
              "restricted": {"type": "boolean"},
              "download_path": {"type": ["string", "null"]},
              "date_created": {"type": ["number", "null"], "description": "Unix timestamp."},
              "date_updated": {"type": ["number", "null", "string"]},
              "organization": {"type": ["string", "null"], "description": "Which group deposited the file."},
              "subdirectory": {"type": ["string", "null"]},
              "visible": {"type": ["boolean", "null"]}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"study_id": "OSD-1", "limit": 10},
      {"study_id": "1"}
    ]
  }
]
