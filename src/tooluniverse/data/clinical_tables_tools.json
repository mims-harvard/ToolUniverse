[
  {
    "name": "RxTerms_search_drugs",
    "description": "Search NLM RxTerms drug names with official count+offset pagination. Returns prescribable display names, strengths/forms, and RxNorm RxCUIs. Response metadata exposes total_results, accessible_results, has_more, and next_offset; NLM caps retrieval at 7,500 matches.",
    "type": "ClinicalTablesTool",
    "parameter": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "string",
          "description": "Drug name or prefix to search, e.g. 'metformin', 'atorvas', 'insulin aspart'."
        },
        "max_results": {
          "type": "integer",
          "description": "Page size (default 20, range 1-500).",
          "default": 20,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based first match. Continue with metadata.next_offset; offset + max_results cannot exceed 7,500.",
          "default": 0,
          "minimum": 0,
          "maximum": 7499
        }
      },
      "required": [
        "terms"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_count": {
              "type": "integer",
              "description": "Total number of matches available on the server."
            },
            "count": {
              "type": "integer",
              "description": "Number of matches returned in this response."
            },
            "search_terms": {
              "type": "string"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "RxTerms display-name code."
                  },
                  "DISPLAY_NAME": {
                    "type": "string"
                  },
                  "STRENGTHS_AND_FORMS": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "RXCUIS": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "results"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "terms": "metformin",
        "max_results": 5,
        "offset": 5
      }
    ]
  },
