[
  {
    "name": "OMA_get_protein",
    "description": "Get protein information from the OMA (Orthologous MAtrix) Browser by UniProt accession or OMA ID. OMA is a comprehensive orthology database covering 2,600+ complete genomes. Returns protein details including species, genomic location, OMA group membership, and Hierarchical Orthologous Group (HOG) assignment. Example: P04637 returns human TP53 with OMA ID HUMAN31534, HOG:F0782425.2c.7a, and genomic locus on chromosome 17.",
    "parameter": {
      "type": "object",
      "properties": {
        "protein_id": {
          "type": "string",
          "description": "UniProt accession (e.g., 'P04637' for human p53) or OMA ID (e.g., 'HUMAN31534'). UniProt accessions are recommended for cross-database compatibility."
        }
      },
      "required": [
        "protein_id"
      ]
    },
    "fields": {
      "endpoint": "protein"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "protein_id": "P04637"
      },
      {
        "protein_id": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entry_nr": {
              "type": [
                "integer",
                "number"
              ]
            },
            "oma_id": {
              "type": "string"
            },
            "canonical_id": {
              "type": "string"
            },
            "sequence_length": {
              "type": [
                "integer",
                "number"
              ]
            },
            "species_code": {
              "type": "string"
            },
            "species_name": {
              "type": "string"
            },
            "taxon_id": {
              "type": [
                "integer",
                "number"
              ]
            },
            "oma_group": {
              "type": [
                "integer",
                "number"
              ]
            },
            "oma_hog_id": {
              "type": "string"
            },
            "chromosome": {
              "type": "string"
            },
            "locus_start": {
              "type": [
                "integer",
                "number"
              ]
            },
            "locus_end": {
              "type": [
                "integer",
                "number"
              ]
            },
            "locus_strand": {
              "type": [
                "integer",
                "number"
              ]
            },
            "is_main_isoform": {
              "type": "boolean"
            },
            "roothog_id": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "entry_nr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_get_orthologs",
    "description": "Get pairwise orthologs for one protein from OMA. The upstream protein-ortholog endpoint returns its complete filtered list and ignores per_page/page, so ToolUniverse applies reliable local per_page/offset pagination. Metadata reports the full filtered total, has_more, and next_offset; use those rather than a page parameter.",
    "parameter": {
      "type": "object",
      "properties": {
        "protein_id": {
          "type": "string",
          "description": "UniProt accession (e.g., 'P04637' for human p53) or OMA ID."
        },
        "rel_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by orthology relationship type. Options: '1:1' (one-to-one), '1:n' (one-to-many), 'n:1' (many-to-one), 'n:m' (many-to-many). Leave empty for all types."
        },
        "per_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum orthologs in the local page (default 20, max 1000). The upstream endpoint ignores per_page, so ToolUniverse fetches the complete list then slices it locally."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the complete filtered ortholog list. Continue with metadata.next_offset while has_more is true."
        }
      },
      "required": [
        "protein_id"
      ]
    },
    "fields": {
      "endpoint": "orthologs"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "protein_id": "P04637",
        "per_page": 10
      },
      {
        "protein_id": "P00533",
        "rel_type": "1:1",
        "per_page": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oma_id": {
                "type": "string"
              },
              "canonical_id": {
                "type": "string"
              },
              "species_name": {
                "type": "string"
              },
              "species_code": {
                "type": "string"
              },
              "taxon_id": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "rel_type": {
                "type": "string"
              },
              "distance": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "sequence_length": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "chromosome": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_get_hog",
    "description": "Get complete Hierarchical Orthologous Group (HOG) information from OMA. Returns all child HOGs and all alternative taxonomic levels, including every child's complete alternative-level list, with explicit counts at each layer; evolutionary branches are not silently capped.",
    "parameter": {
      "type": "object",
      "properties": {
        "hog_id": {
          "type": "string",
          "description": "Hierarchical Orthologous Group ID. Examples: 'HOG:F0782425' (p53 family), 'HOG:F0798498' (insulin family). Use OMA_get_protein to find the current HOG ID for a specific protein (the 'oma_hog_id' field). Note: OMA reassigns HOG IDs between releases, so IDs from older releases may return 'no longer valid'."
        }
      },
      "required": [
        "hog_id"
      ]
    },
    "fields": {
      "endpoint": "hog"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "hog_id": "HOG:F0782425"
      },
      {
        "hog_id": "HOG:F0798498"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hog_id": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "roothog_id": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "completeness_score": {
                "type": "number"
              },
              "description": {
                "type": "string"
              },
              "parent_hogs": {
                "type": "array"
              },
              "children_hogs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "hog_id": {
                      "type": "string"
                    },
                    "alternative_levels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "alternative_levels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_get_group",
    "description": "Get OMA Group details and page through all member proteins. Reports the true member total, returned count, and next offset so large strict-ortholog groups do not silently stop at 30 members.",
    "parameter": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "description": "OMA Group number (numeric ID). Examples: '1388790' (p53 group), '839588' (EGFR group). Use OMA_get_protein to find the group ID for a specific protein."
        },
        "limit": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum group members to return."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into all OMA group members."
        }
      },
      "required": [
        "group_id"
      ]
    },
    "fields": {
      "endpoint": "group"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "group_id": "1388790"
      },
      {
        "group_id": "839588"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_nr": {
              "type": [
                "integer",
                "number"
              ]
            },
            "fingerprint": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "oma_id": {
                    "type": "string"
                  },
                  "canonical_id": {
                    "type": "string"
                  },
                  "species_name": {
                    "type": "string"
                  },
                  "species_code": {
                    "type": "string"
                  },
                  "taxon_id": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "sequence_length": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "chromosome": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "group_nr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_resolve_xref",
    "description": "Resolve and page through OMA cross-reference matches for a gene symbol, UniProt entry name, or other identifier. Returns the true match total, returned count, and next offset so broad identifiers such as BRCA2 do not silently stop at 100; feed returned OMA IDs into protein/ortholog/HOG tools.",
    "parameter": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string",
          "description": "Gene symbol (e.g. 'BRCA2'), UniProt entry name (e.g. 'MED4_HUMAN'), or any cross-reference identifier to resolve to OMA entries."
        },
      "limit": {
          "type": [
            "integer",
            "null"
          ],
        "description": "Maximum cross-reference matches to return (default 25, max 1000).",
        "default": 25,
        "minimum": 1,
        "maximum": 1000
      },
      "offset": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Zero-based offset into all OMA cross-reference matches."
      }
      },
      "required": [
        "search"
      ]
    },
    "fields": {
      "endpoint": "xref"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "search": "MED4_HUMAN"
      },
      {
        "search": "BRCA2"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "xref": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "seq_match": {
                "type": "string"
              },
              "entry_nr": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "oma_id": {
                "type": "string"
              },
              "species_code": {
                "type": "string"
              },
              "species_name": {
                "type": "string"
              },
              "taxon_id": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_get_genome_pair_orthologs",
    "description": "Retrieve pairwise orthologs between two whole genomes in OMA. Unlike OMA_get_orthologs, this endpoint has real server-side page/per_page pagination. Metadata preserves the official x-total-count and reports has_more and next_page, making the complete proteome-vs-proteome set reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "genome1": {
          "type": "string",
          "description": "First genome: UniProt species code (e.g. 'HUMAN', 'PANTR') or NCBI taxon ID (e.g. '9606')."
        },
        "genome2": {
          "type": "string",
          "description": "Second genome: UniProt species code (e.g. 'MOUSE', 'PANTR') or NCBI taxon ID (e.g. '10090')."
        },
        "per_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000,
          "description": "Ortholog pairs per official server page (default 20, verified through 10000). Invalid values return an error rather than being silently clamped."
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "One-based official result page (default 1). Continue with metadata.next_page while has_more is true."
        }
      },
      "required": [
        "genome1",
        "genome2"
      ]
    },
    "fields": {
      "endpoint": "genome_pairs"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "genome1": "HUMAN",
        "genome2": "MOUSE",
        "per_page": 1
      },
      {
        "genome1": "HUMAN",
        "genome2": "PANTR",
        "per_page": 2
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_1": {
                "type": "object"
              },
              "entry_2": {
                "type": "object"
              },
              "rel_type": {
                "type": "string"
              },
              "distance": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "oma_group": {
                "type": [
                  "integer",
                  "number",
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "OMA_get_protein_go",
    "description": "Get Gene Ontology (GO) functional annotations for a specific OMA protein. OMA attaches per-entry GO annotations with the aspect (biological_process / molecular_function / cellular_component), information content (ic), evidence code (e.g. IDA, NAS, IEA), and a literature reference (PMID). Other OMA tools return orthology / HOG / group membership but not these functional annotations. Accepts an OMA ID (e.g. 'HUMAN17018') or UniProt accession (e.g. 'P04637'); use OMA_resolve_xref or OMA_get_protein first if you only have a gene symbol. Example: protein_id='HUMAN17018' returns GO:0060261 'positive regulation of transcription initiation by RNA polymerase II', aspect biological_process, ic 8.27, evidence IDA, reference PMID:12218053.",
    "parameter": {
      "type": "object",
      "properties": {
        "protein_id": {
          "type": "string",
          "description": "OMA ID (e.g. 'HUMAN17018') or UniProt accession (e.g. 'P04637')."
        },
        "aspect": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional GO aspect filter: 'biological_process', 'molecular_function', or 'cellular_component'. Leave empty for all aspects."
        }
      },
      "required": [
        "protein_id"
      ]
    },
    "fields": {
      "endpoint": "protein_ontology"
    },
    "type": "OMATool",
    "test_examples": [
      {
        "protein_id": "HUMAN17018"
      },
      {
        "protein_id": "P04637"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "go_term": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "aspect": {
                "type": "string"
              },
              "information_content": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
