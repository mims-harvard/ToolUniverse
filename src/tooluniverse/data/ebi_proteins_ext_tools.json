  {
    "name": "EBIProteins_get_rna_editing",
    "description": "Get RNA editing annotations (A-to-I / Q->R recoding sites) for a UniProt protein from the EBI Proteins API. Returns post-transcriptional RNA editing sites where a genomic adenosine is read as guanosine, recoding the protein. Each site includes the protein position, genomic location, codon, consequence type, wild-type and edited amino acid, and tissue/sample editing statistics. Distinct from DNA-level variation. NOTE (checked 2026-09-20): the upstream rna-editing dataset currently returns no features for any accession tried (GRIA2 P42262, HTR2C P28335), and a taxid=9606 query returns an empty list, so this tool returns an error until EBI restores the data. It previously returned e.g. the canonical GRIA2 Q/R site at residue 607.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P42262' (GRIA2, canonical Q/R editing site), 'P28335' (HTR2C, 5 editing sites)."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "rna_editing"
    },
    "type": "EBIProteinsExtTool",
    "test_examples": [
      {
        "accession": "P42262"
      },
      {
        "accession": "P28335"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "RNA editing sites curated by UniProt. An entry with none returns an empty list, which is an answer rather than a failure.",
          "properties": {
            "accession": {
              "type": [
                "string",
                "null"
              ]
            },
            "entry_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt entry name, e.g. GRIA2_HUMAN"
            },
            "rna_editing_sites": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Always 'RNA editing'"
                  },
                  "position": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Residue position in the protein sequence; null if UniProt gives a position it cannot parse as a number"
                  },
                  "evidences": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "ECO evidence code, e.g. ECO:0000269"
                        },
                        "source": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "'PubMed' or 'UniProtKB'"
                        },
                        "id": {
