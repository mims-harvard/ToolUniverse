  {
    "name": "EBIProteins_get_variation",
    "description": "Get known protein sequence variants from the EBI Proteins API with source/disease filters, limit/offset pagination, and explicit completeness metadata. Preserves all supplied COSMIC, ClinVar, dbSNP, gnomAD/ExAC, and UniProt cross-references rather than only the first three. Example: P04637 (TP53) currently has more than 3,000 variants and requires multiple pages.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1)."
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by variant source. Options: 'large_scale_study' (COSMIC, gnomAD), 'mixed' (multiple sources), 'uniprot' (curated). Null returns all."
        },
        "disease_only": {
          "type": "boolean",
          "description": "If true, return only variants with disease associations. Default: false."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of filtered variants to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after source_type and disease_only filtering. Use data.next_offset for the next page."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "variation"
    },
    "type": "EBIProteinsExtTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533",
        "disease_only": true
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "entry_name": {
              "type": "string"
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position_start": {
                    "type": "string"
                  },
                  "position_end": {
                    "type": "string"
                  },
                  "wild_type": {
                    "type": "string"
                  },
                  "alternative": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "source_type": {
                    "type": "string"
                  },
                  "clinical_significances": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "associations": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "is_disease": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "xrefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "url": {
                          "type": [
                            "null",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "total_variants": {
              "type": [
                "integer",
                "number"
              ]
            },
            "total_all_sources": {
              "type": [
                "integer",
                "number"
              ]
            },
            "source_counts": {
              "type": "object",
              "properties": {
                "large_scale_study": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "mixed": {
                  "type": [
                    "integer",
                    "number"
                  ]
                },
                "uniprot": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              }
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_features",
    "description": "Get protein features by category from the EBI Proteins API with limit/offset pagination and explicit completeness metadata. Preserves every evidence record supplied for each feature. Categories include DOMAINS_AND_SITES, MOLECULE_PROCESSING, PTM, STRUCTURAL, TOPOLOGY, VARIANTS, and MUTAGENESIS. Example: P04637 has 31 domain/site features but more than 1,000 VARIANTS features.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P01308' (Insulin)."
        },
        "category": {
          "type": "string",
          "description": "Feature category. Options: 'DOMAINS_AND_SITES', 'MOLECULE_PROCESSING', 'PTM', 'STRUCTURAL', 'TOPOLOGY', 'VARIANTS', 'MUTAGENESIS'. Default: 'DOMAINS_AND_SITES'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of category features to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based feature offset. Use data.next_offset for the next page."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "features"
    },
    "type": "EBIProteinsExtTool",
    "test_examples": [
      {
        "accession": "P04637",
        "category": "DOMAINS_AND_SITES"
      },
      {
        "accession": "P00533",
        "category": "STRUCTURAL"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "entry_name": {
              "type": "string"
            },
            "sequence_length": {
              "type": [
                "integer",
                "number"
              ]
            },
            "category_queried": {
              "type": "string"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "position_start": {
                    "type": "string"
                  },
                  "position_end": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "evidences": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "source_name": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "source_id": {
                          "type": [
                            "null",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "total_features": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_antigen",
    "description": "Get predicted antigenic regions for a protein from the EBI Proteins API. Returns regions of the protein sequence predicted to be immunogenic and suitable for antibody generation. Includes match scores indicating prediction confidence. Critical for antibody design, vaccine development, and immunology research. Example: P04637 (TP53) returns 2 antigenic regions at positions 291-379 and 5-64 with 100% match scores.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P01308' (Insulin)."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "antigen"
    },
    "type": "EBIProteinsExtTool",
