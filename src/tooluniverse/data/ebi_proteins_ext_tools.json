  {
    "name": "EBIProteins_get_coordinates",
    "description": "Get genomic coordinate mappings for a protein from the EBI Proteins API. Maps UniProt protein to genomic coordinates including Ensembl gene/transcript IDs, chromosome location, strand, and exon structure. Essential for cross-referencing protein features with genomic data, variant mapping between coordinate systems, and genome browser integration. Example: P04637 (TP53) maps to ENSG00000141510 on chr17.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1)."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "coordinates"
    },
    "type": "EBIProteinsExtTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sequence_length": {
              "type": [
                "integer",
                "number"
              ]
            },
            "genomic_mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ensembl_gene_id": {
                    "type": "string"
                  },
                  "ensembl_transcript_id": {
                    "type": "string"
                  },
                  "chromosome": {
                    "type": "string"
                  },
                  "start": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "end": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "reverseStrand": {
                    "type": "boolean"
                  },
                  "num_exons": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  }
                }
              }
            },
            "total_mappings": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
