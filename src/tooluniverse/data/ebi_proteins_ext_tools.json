[
  {
    "name": "EBIProteins_get_mutagenesis",
    "description": "Get mutagenesis experiment data for a protein from the EBI Proteins API with limit/offset pagination and explicit completeness metadata. Returns experimentally characterized mutations, functional effects, and all supplied literature evidence. Example: P04637 (TP53) has 651 annotations; use next_offset to retrieve pages after the first 100.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53/p53), 'P38398' (BRCA1), 'P00533' (EGFR), 'P01308' (Insulin)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of mutagenesis features to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based feature offset. Use data.next_offset for the next page."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "mutagenesis"
    },
    "type": "EBIProteinsExtTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "entry_name": {
              "type": "string"
            },
            "gene_name": {
              "type": "null"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "position_start": {
                    "type": "string"
                  },
                  "position_end": {
                    "type": "string"
                  },
                  "original_sequence": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "evidences": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "source_name": {
                          "type": "string"
                        },
                        "source_id": {
                          "type": "string"
                        },
                        "source_url": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "total_features": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
