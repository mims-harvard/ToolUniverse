  {
    "name": "EBIProteins_get_hpp_peptides",
    "description": "Get Human Proteome Project (HPP) peptide-level mass-spectrometry evidence mapped to a protein from the EBI Proteins API. Returns HPP-curated peptides with sequence, positions, uniqueness, and supporting source, with complete limit/offset pagination and explicit total/has_more metadata. This is the stringent HPP evidence set, distinct from the generic proteomics peptide set. Example: P04637 (TP53) has 237 HPP features; use next_offset to retrieve pages after the first 100.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of HPP peptides to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based peptide offset. Use data.next_offset to retrieve the next page."
        }
