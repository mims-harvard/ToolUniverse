              "type": "string"
            },
            "antigenic_regions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "position_start": {
                    "type": "string"
                  },
                  "position_end": {
                    "type": "string"
                  },
                  "match_score": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "antigen_sequence": {
                    "type": "string"
                  },
                  "evidences": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "source_name": {
                          "type": "string"
                        },
                        "source_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
