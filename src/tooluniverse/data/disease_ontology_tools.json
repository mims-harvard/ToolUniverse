[
  {
    "name": "DiseaseOntology_get_term",
    "description": "Get a complete semantic Disease Ontology term by DOID. The returned ID is verified and the wrapper preserves name, definition, synonyms, parent relationship/source, external references, subsets, alternate IDs, and broad/exact/narrow SKOS mappings. Only the internal neo4jid is intentionally omitted and named in metadata. Live DOID:162 currently has 3 synonyms, 7 external references, and 7 subsets.",
    "parameter": {
      "type": "object",
      "properties": {
        "doid": {
          "type": "string",
          "pattern": "^(?:[Dd][Oo][Ii][Dd]:)?[0-9]+$",
          "description": "Disease Ontology identifier in format 'DOID:XXXX'. Examples: 'DOID:162' (cancer), 'DOID:9352' (type 2 diabetes mellitus), 'DOID:10283' (prostate cancer), 'DOID:2531' (hematologic cancer), 'DOID:684' (hepatocellular carcinoma), 'DOID:4' (disease - root term)."
        }
      },
      "required": [
        "doid"
      ]
    },
    "fields": {
      "endpoint": "get_term"
    },
    "type": "DiseaseOntologyTool",
    "test_examples": [
      {
        "doid": "DOID:162"
      },
      {
        "doid": "DOID:9352"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Disease Ontology ID (DOID:XXXX)"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Disease name"
            },
            "definition": {
              "type": [
                "string",
                "null"
              ],
              "description": "Disease definition"
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Disease synonyms with relationship type (EXACT, RELATED)"
            },
            "parents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relationship": {
                    "type": "string",
                    "description": "Relationship type (is_a)"
                  },
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Parent terms in DO hierarchy"
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Cross-references to ICD10CM, ICD9CM, MeSH, NCI, SNOMEDCT, UMLS, OMIM, ICDO"
            },
            "subsets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "DO subsets this disease belongs to (e.g. DO_cancer_slim, DO_AGR_slim)"
            },
            "alternate_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skos_broad_matches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skos_exact_matches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skos_narrow_matches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "DiseaseOntology_get_parents",
    "description": "Get direct parents for a Disease Ontology term and expand each parent by one additional level. This is a depth-2 view, not a complete path to the root. Every relation includes type and source; each parent has fetch_complete, while metadata reports failed_parent_fetches, parent_expansion_complete, hierarchy_depth_returned=2, and full_ancestry_complete so a failed or deliberately shallow traversal cannot appear complete. Live DOID:10283 has two direct parents: prostate disease and male reproductive organ cancer.",
    "parameter": {
      "type": "object",
      "properties": {
        "doid": {
          "type": "string",
          "pattern": "^(?:[Dd][Oo][Ii][Dd]:)?[0-9]+$",
          "description": "Disease Ontology identifier in format 'DOID:XXXX'. Examples: 'DOID:10283' (prostate cancer), 'DOID:162' (cancer), 'DOID:9352' (type 2 diabetes)."
        }
      },
      "required": [
        "doid"
      ]
    },
    "fields": {
      "endpoint": "get_parents"
    },
    "type": "DiseaseOntologyTool",
    "test_examples": [
      {
        "doid": "DOID:10283"
      },
      {
        "doid": "DOID:684"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Queried Disease Ontology ID"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Disease name"
            },
            "parents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Parent DOID"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Parent disease name"
                  },
                  "definition": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Parent disease definition"
                  },
                  "relationship": {
                    "type": "string"
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fetch_complete": {
                    "type": "boolean"
                  },
                  "grandparents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "relationship": {
                          "type": "string"
                        },
                        "source": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "description": "Parent's parent terms"
                  }
                }
              },
              "description": "Direct parent disease terms with their parents"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
