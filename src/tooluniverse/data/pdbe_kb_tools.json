[
  {
    "name": "PDBe_KB_get_summary_stats",
    "description": "Get aggregated structural summary statistics for a UniProt protein from PDBe-KB. Returns the number of PDB structures, unique ligands, interaction partners, annotations, and similar proteins available for the protein. This is a quick way to assess structural coverage before diving into detailed data. Example: P04637 (TP53) has 296 PDB structures, 121 ligands, and 54 interaction partners.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_accession": {
          "type": "string",
          "description": "UniProt accession ID for the protein. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (insulin)."
        }
      },
      "required": [
        "uniprot_accession"
      ]
    },
    "fields": {
      "endpoint": "summary_stats"
    },
    "type": "PDBe_KB_Tool",
    "test_examples": [
      {
        "uniprot_accession": "P04637"
      },
      {
        "uniprot_accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_accession": {
              "type": "string",
              "description": "UniProt accession queried"
            },
            "pdbs": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of PDB structures available"
            },
            "ligands": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of unique ligands bound"
            },
            "interaction_partners": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of protein interaction partners with structural evidence"
            },
            "annotations": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of functional annotations"
            },
            "similar_proteins": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of similar proteins in PDB"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBe_KB_get_ligand_sites",
    "description": "Get ligand binding site residues for a UniProt protein from PDBe-KB, including PDB structures and ligand metadata. Results are independently paginated at the ligand, residue, and PDB-entry levels. Always inspect total/returned/truncated/next-offset fields at every level and continue until the relevant level is complete; the API does not order ligands by clinical relevance.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_accession": {
          "type": "string",
          "description": "UniProt accession ID for the protein. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1)."
        },
        "max_ligands": {
          "type": "integer",
          "description": "Number of ligand records to return from ligand_offset (default 100).",
          "default": 100,
          "minimum": 1
        },
        "ligand_offset": {
          "type": "integer",
          "description": "Zero-based ligand offset for the next ligand page.",
          "default": 0,
          "minimum": 0
        },
        "residue_offset": {
          "type": "integer",
          "description": "Zero-based binding-residue offset applied within every returned ligand.",
          "default": 0,
          "minimum": 0
        },
        "residue_limit": {
          "type": "integer",
          "description": "Binding residues returned per ligand (default 20, maximum 500).",
          "default": 20,
          "minimum": 1,
          "maximum": 500
        },
        "pdb_entry_offset": {
          "type": "integer",
          "description": "Zero-based PDB-entry offset applied within every returned residue.",
          "default": 0,
          "minimum": 0
        },
        "pdb_entry_limit": {
          "type": "integer",
          "description": "PDB entries returned per residue (default 10, maximum 500).",
          "default": 10,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "uniprot_accession"
      ]
    },
    "fields": {
      "endpoint": "ligand_sites"
    },
    "type": "PDBe_KB_Tool",
    "test_examples": [
      {
        "uniprot_accession": "P04637"
      },
      {
        "uniprot_accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_accession": {
              "type": "string",
              "description": "UniProt accession queried"
            },
            "protein_length": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Protein sequence length"
            },
            "ligands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ligand full name"
                  },
                  "accession": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ligand chemical component ID (e.g. ATP, NAD, ZN)"
                  },
                  "binding_residues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "Start residue position (UniProt numbering)"
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "End residue position"
                        },
                        "pdb_entries": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "PDB IDs where this binding observed"
                        },
                        "pdb_entries_total": {
                          "type": "integer"
                        },
                        "pdb_entries_returned": {
                          "type": "integer"
                        },
                        "pdb_entries_truncated": {
                          "type": "boolean"
                        },
                        "next_pdb_entry_offset": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      }
                    },
                    "description": "Residues involved in ligand binding"
                  },
                  "binding_residues_total": {
                    "type": "integer"
                  },
                  "binding_residues_returned": {
                    "type": "integer"
                  },
                  "binding_residues_truncated": {
                    "type": "boolean"
                  },
                  "next_residue_offset": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "is_cofactor": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether ligand is a cofactor"
                  },
                  "is_solvent": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether ligand is a solvent molecule"
                  },
                  "chembl_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ChEMBL compound ID if drug-like"
                  },
                  "drugbank_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DrugBank ID if applicable"
                  }
                }
              },
              "description": "Ligands with binding site details"
            },
            "total_ligands": {
              "type": "integer",
              "description": "Total number of unique ligands"
            },
            "ligand_offset": {
              "type": "integer"
            },
            "ligands_returned": {
              "type": "integer"
            },
            "next_ligand_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean",
              "description": "True if fewer ligands were returned than total_ligands"
            },
            "truncation_note": {
              "type": "string",
              "description": "Explains the truncation and how to raise max_ligands to see all results"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBe_KB_get_interface_residues",
    "description": "Get protein-protein interaction interface residues for a UniProt protein from PDBe-KB. Results are independently paginated at the partner, residue, and PDB-entry levels. Inspect total/returned/truncated/next-offset fields at every level and continue until the relevant level is complete.",
