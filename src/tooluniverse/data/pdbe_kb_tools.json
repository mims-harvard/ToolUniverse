          "minimum": 0
        },
        "pdb_entry_limit": {
          "type": "integer",
          "description": "PDB entries returned per residue (default 10, maximum 500).",
          "default": 10,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "uniprot_accession"
      ]
    },
    "fields": {
      "endpoint": "interface_residues"
    },
    "type": "PDBe_KB_Tool",
    "test_examples": [
      {
        "uniprot_accession": "P04637"
      },
      {
        "uniprot_accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
