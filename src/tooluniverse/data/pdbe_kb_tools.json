            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBe_KB_get_superposition_clusters",
    "description": "Get structural superposition clusters for a UniProt protein from PDBe-KB. Segments, clusters within each returned segment, and members within each returned cluster are independently paginated. Inspect total/returned/truncated/next-offset fields at each level to avoid silently missing structures.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_accession": {
          "type": "string",
          "description": "UniProt accession ID for the protein. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1)."
        },
        "segment_offset": {
          "type": "integer",
          "description": "Zero-based segment offset.",
          "default": 0,
          "minimum": 0
        },
        "segment_limit": {
          "type": "integer",
          "description": "Segments to return (default 10, maximum 100).",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "cluster_offset": {
          "type": "integer",
          "description": "Zero-based cluster offset applied within every returned segment.",
          "default": 0,
          "minimum": 0
        },
        "cluster_limit": {
          "type": "integer",
          "description": "Clusters returned per segment (default 10, maximum 100).",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "member_offset": {
          "type": "integer",
          "description": "Zero-based member offset applied within every returned cluster.",
          "default": 0,
          "minimum": 0
        },
        "member_limit": {
          "type": "integer",
          "description": "Members returned per cluster (default 20, maximum 500).",
          "default": 20,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "uniprot_accession"
      ]
    },
    "fields": {
      "endpoint": "superposition"
    },
    "type": "PDBe_KB_Tool",
    "test_examples": [
      {
        "uniprot_accession": "P04637"
      },
      {
        "uniprot_accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_accession": {
              "type": "string"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "segment_start": {
                    "type": "integer",
                    "description": "Start residue position (UniProt numbering)"
                  },
                  "segment_end": {
                    "type": "integer",
                    "description": "End residue position"
                  },
                  "num_clusters": {
                    "type": "integer",
                    "description": "Number of structural clusters"
                  },
                  "cluster_offset": {
                    "type": "integer"
                  },
                  "clusters_returned": {
                    "type": "integer"
                  },
                  "clusters_truncated": {
                    "type": "boolean"
                  },
                  "next_cluster_offset": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "clusters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "representative": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "pdb_id": {
                              "type": "string"
                            },
                            "auth_asym_id": {
                              "type": "string"
                            },
                            "is_representative": {
                              "type": "boolean"
                            }
                          },
                          "description": "Representative structure for this cluster"
                        },
                        "total_members": {
                          "type": "integer"
                        },
                        "member_offset": {
                          "type": "integer"
                        },
                        "members_returned": {
                          "type": "integer"
                        },
                        "members_truncated": {
                          "type": "boolean"
                        },
                        "next_member_offset": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "members": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "pdb_id": {
                                "type": "string"
                              },
                              "auth_asym_id": {
                                "type": "string"
                              },
                              "entity_id": {
                                "type": "integer"
                              },
                              "is_representative": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "total_segments": {
              "type": "integer"
            },
            "segment_offset": {
              "type": "integer"
            },
            "segments_returned": {
              "type": "integer"
            },
            "segments_truncated": {
              "type": "boolean"
            },
            "next_segment_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
