        },
        "max_partners": {
          "type": "integer",
          "description": "Number of interaction partners to return from partner_offset (default 60).",
          "default": 60,
          "minimum": 1
        },
        "partner_offset": {
          "type": "integer",
          "description": "Zero-based interaction-partner offset.",
          "default": 0,
          "minimum": 0
        },
        "residue_offset": {
          "type": "integer",
          "description": "Zero-based interface-residue offset applied within every returned partner.",
          "default": 0,
          "minimum": 0
        },
        "residue_limit": {
          "type": "integer",
          "description": "Interface residues returned per partner (default 30, maximum 500).",
