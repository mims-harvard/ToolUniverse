[
  {
    "type": "ZoomaTool",
    "name": "ZOOMA_annotate_text",
    "description": "Map free text to ontology terms with EBI ZOOMA and exact local pagination over the complete upstream annotation array. Returns semantic-tag IRIs/CURIEs, confidence, provenance and OLS links. metadata.total_matches is the exact count after min_confidence filtering; continue with metadata.next_offset while has_more is true. Optionally restrict ontology sources or provide a property-type hint.",
    "parameter": {
      "type": "object",
      "properties": {
        "property_value": {
          "type": "string",
          "description": "Free text to annotate to ontology terms, e.g. 'bone marrow', 'asthma', 'Homo sapiens'. Required."
        },
        "property_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional property-type hint that narrows the annotation context, e.g. 'disease', 'organism part', 'cell type', 'organism'. Leave unset to let ZOOMA infer it."
        },
        "ontologies": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Ontology source filter as a comma-separated string or string array, e.g. 'efo,uberon' or ['efo','uberon']."
        },
        "min_confidence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional minimum confidence to keep, one of LOW, MEDIUM, GOOD, HIGH. Invalid values are rejected rather than silently disabling the filter.",
          "enum": [
            "LOW",
            "MEDIUM",
            "GOOD",
            "HIGH",
            null
          ]
        },
        "max_results": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Legacy alias for limit. Maximum annotations on this page; defaults to 10.",
          "minimum": 1,
          "maximum": 1000
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum annotations on this local page, 1-1000. Takes precedence over max_results and defaults to 10.",
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Zero-based offset into the exact match set after min_confidence filtering. Continue with metadata.next_offset.",
          "minimum": 0
        }
      },
      "required": [
        "property_value"
      ]
    },
    "fields": {
      "operation": "annotate"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "property_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "property_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "semantic_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ontology term IRIs (OBO/EFO PURLs) this text maps to."
              },
              "curies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Compact CURIEs derived from the semantic-tag IRIs, e.g. 'MONDO:0004979', 'UBERON:0002371', 'EFO:0006842'."
              },
              "confidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "HIGH, GOOD, MEDIUM, or LOW."
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Annotation source name, e.g. 'zooma', 'uberon', 'efo'."
              },
              "source_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ONTOLOGY or DATABASE."
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Evidence type, e.g. ZOOMA_INFERRED_FROM_CURATED, OLS_TEXT_TAGGER, OLS_EMBEDDING."
              },
              "ols_links": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "OLS API URLs for each semantic tag."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "property_value": "bone marrow"
      },
      {
        "property_value": "asthma",
        "property_type": "disease"
      },
      {
        "property_value": "diabetes",
        "ontologies": "efo",
        "limit": 5,
        "offset": 0
      },
      {
        "property_value": "Homo sapiens",
        "min_confidence": "HIGH",
        "max_results": 3
      },
      {
        "property_value": "liver",
        "property_type": "organism part",
        "ontologies": "uberon"
      }
    ]
  },
  {
    "type": "ZoomaTool",
    "name": "ZOOMA_list_datasources",
    "description": "List the curated annotation datasources that EBI ZOOMA draws on when mapping free text to ontology terms. Returns each datasource's short name, type (DATABASE or ONTOLOGY), and home URI - for example 'uniprot', 'eva-clinvar', 'atlas' (Expression Atlas), 'cbi' (BioSamples), 'metabolights'. Use this to discover valid source identifiers for provenance interpretation or to understand which curated resources back a given ZOOMA annotation. Takes no arguments.",
    "parameter": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "fields": {
      "operation": "list_datasources"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Short datasource identifier, e.g. 'uniprot', 'eva-clinvar', 'atlas'."
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Datasource type: 'DATABASE' or 'ONTOLOGY'."
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Home URI of the datasource."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {}
    ]
  }
]
