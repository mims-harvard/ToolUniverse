[
  {
    "name": "MCSA_get_entry",
    "type": "MCSATool",
    "description": "Retrieve an enzyme's catalytic machinery from M-CSA, the curated Mechanism and Catalytic Site Atlas. Returns the catalytic residues with their PDB and UniProt numbering and the role each plays in the mechanism (nucleophile, proton donor, electrostatic stabiliser and so on), plus the EC number and reaction. ToolUniverse covers enzyme function through BRENDA, Rhea and UniProt, but nothing else identifies which specific residues do the catalysis. Example: mcsa_id=2 (class A beta-lactamase).",
    "fields": {
      "operation": "get_entry"
    },
    "parameter": {
      "type": "object",
      "required": [
        "mcsa_id"
      ],
      "properties": {
        "mcsa_id": {
          "type": [
            "integer",
            "string"
          ],
          "description": "M-CSA entry identifier, e.g. 2. Runs from 1 to roughly 1000."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "",
          "properties": {
            "mcsa_id": {
              "type": [
                "integer",
                "null"
              ],
              "description": "M-CSA identifier"
            },
            "enzyme_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Enzyme name"
            },
            "ec_numbers": {
              "type": "array",
              "description": "Enzyme Commission numbers",
              "items": {
                "type": "string",
                "description": "EC number"
              }
            },
            "reference_uniprot_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Reference UniProt accession"
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Entry description"
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "description": "M-CSA entry URL"
            },
            "catalytic_residues": {
              "type": "array",
              "description": "Residues performing catalysis",
              "items": {
                "type": "object",
                "description": "",
                "properties": {
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Residue three-letter code"
                  },
                  "pdb_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "PDB entry the numbering refers to"
                  },
                  "chain": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Chain identifier"
                  },
                  "residue_number": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Residue number in the PDB entry"
                  },
                  "uniprot_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "UniProt accession"
                  },
                  "uniprot_position": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Residue position in UniProt numbering"
                  },
                  "roles": {
                    "type": "array",
                    "description": "Roles this residue plays in the mechanism",
                    "items": {
                      "type": "string",
                      "description": "Catalytic role"
                    }
                  },
                  "roles_summary": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Comma-separated role summary"
                  },
                  "is_ptm": {
                    "type": "boolean",
                    "description": "Whether the residue carries a post-translational modification"
                  },
                  "auth_residue_number": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "The PDB author numbering of the residue - what papers and mutation names use. Entry 2's catalytic serine is residue_number 45 and auth_residue_number 70, and the literature calls it Ser70"
                  },
                  "domain_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "CATH domain the residue sits in"
                  },
                  "domain_cath_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "That domain's CATH classification"
                  },
                  "assembly": {
                    "type": [
                      "integer",
                      "null",
                      "string"
                    ],
                    "description": "Biological assembly the chain belongs to"
                  },
                  "is_reference_chain": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether these chain fields come from the chain M-CSA marks as the reference"
                  },
                  "chain_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many chains M-CSA records this residue in; the chain fields above describe the reference one"
                  },
                  "role_details": {
                    "type": "array",
                    "description": "Each catalytic role as M-CSA records it, not collapsed to its name",
                    "items": {
                      "type": "object",
                      "properties": {
                        "function": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The role, e.g. nucleophile, proton donor"
                        },
                        "function_type": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "reactant, interaction or spectator: whether the residue does the chemistry, holds the substrate, or neither"
                        },
                        "emo_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "EMO ontology id of the role"
                        },
                        "group_function": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Role of the group the residue belongs to"
                        }
                      }
                    }
                  },
                  "role_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many role records the residue has"
                  },
                  "role_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The distinct function_types across this residue's roles"
                  },
                  "function_location": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "'main-N' where catalysis is by the backbone nitrogen rather than the side chain"
                  },
                  "annotation": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "M-CSA's free-text note on the residue"
                  }
                }
              }
            },
            "catalytic_residue_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of catalytic residues"
            },
            "reaction_ec": {
              "type": [
                "string",
                "null"
              ],
              "description": "EC number of the catalysed reaction"
            },
            "reaction_is_polymeric": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the substrate is a polymer"
            },
            "reaction_compounds": {
              "type": "array",
              "description": "What the reaction consumes and produces",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Compound name"
                  },
                  "chebi_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ChEBI identifier"
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "reactant or product"
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Stoichiometric count"
                  }
                }
              }
            },
            "mechanism_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many curated mechanisms M-CSA holds for the entry"
            },
            "mechanisms": {
              "type": "array",
              "description": "M-CSA's curated mechanisms. Returned by MCSA_get_entry; a search row carries mechanism_count and url instead",
              "items": {
                "type": "object",
                "properties": {
                  "mechanism_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "M-CSA mechanism identifier"
                  },
                  "is_detailed": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether the curator recorded per-step chemistry"
                  },
                  "rating": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "M-CSA's confidence rating for the mechanism"
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The curator's narrative, capped at MECHANISM_TEXT_CHARACTERS"
                  },
                  "text_truncated": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "True when text was cut at that cap"
                  },
                  "step_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Steps in the mechanism; the arrow-pushing itself is on the M-CSA page that url points at"
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pubmed_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "PubMed identifier"
                        },
                        "doi": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "DOI"
                        },
                        "title": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Paper title"
                        },
                        "evidence_types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "How the paper supports this mechanism, e.g. 'computational experiment' or 'traceable author statement'"
                        }
                      }
                    },
                    "description": "Literature references for the mechanism"
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "description": "Error response",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "string",
              "description": "Human-readable error message"
            }
          }
        }
      ]
    },
    "test_examples": [
      {
        "mcsa_id": 2
      },
      {
        "mcsa_id": 1
      },
      {
        "mcsa_id": 203
      }
    ]
  },
  {
    "name": "MCSA_search_enzymes",
    "type": "MCSATool",
    "description": "Search M-CSA for enzymes by name, EC number prefix, or reference UniProt accession. Example: ec_number='3.5.2' finds beta-lactamases; enzyme_name='lysozyme' finds the lysozyme families. The M-CSA API ignores server-side filters, so entries are scanned page by page under an explicit budget: metadata reports entries_scanned, catalogue_size and scan_complete, so a partial scan is never mistaken for an exhaustive one. Raise max_pages to 11 to cover the whole catalogue.",
    "fields": {
      "operation": "search_enzymes"
    },
    "parameter": {
      "type": "object",
      "required": [],
      "properties": {
        "enzyme_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Substring of the enzyme name, e.g. 'lysozyme'."
        },
        "ec_number": {
          "type": [
            "string",
            "null"
          ],
          "description": "EC number or prefix, e.g. '3.5.2' or '3.5.2.6'."
        },
        "uniprot_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference UniProt accession, e.g. 'P62593'."
        },
        "max_pages": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Catalogue pages to scan, 100 entries each (default 4, max 11 which is the full catalogue)."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum matches to return (default 25)."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "Matching enzymes",
          "items": {
            "type": "object",
            "description": "",
