                ],
                "description": "Reference UniProt accession"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Entry description"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "M-CSA entry URL"
              },
              "catalytic_residues": {
                "type": "array",
                "description": "Residues performing catalysis",
                "items": {
                  "type": "object",
                  "description": "",
                  "properties": {
                    "code": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Residue three-letter code"
                    },
                    "pdb_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "PDB entry the numbering refers to"
                    },
                    "chain": {
                      "type": [
                        "string",
                        "null"
