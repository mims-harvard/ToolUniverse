[
  {
    "type": "RegulomeDBRESTTool",
    "name": "RegulomeDB_query_variant",
    "description": "Query RegulomeDB for regulatory variant annotations using rsID. Nearby SNPs are independently paginated: use nearby_snp_offset and nearby_snp_limit, and follow next_nearby_snp_offset until it is null.",
    "aliases": [
      "RegulomeDB_get_score"
    ],
    "parameter": {
      "type": "object",
      "properties": {
        "rsid": {
          "type": "string",
          "description": "dbSNP rsID (e.g., 'rs4994', 'rs429358')"
        },
        "variant": {
          "type": "string",
          "description": "Alias for rsid. dbSNP rsID (e.g., 'rs7903146', 'rs429358')."
        },
        "nearby_snp_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the nearby SNP list (default 0)."
        },
        "nearby_snp_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 10,
          "description": "Maximum nearby SNPs to return (default 10, max 500)."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://api.regulomedb.org/search?regions={rsid}&genome=GRCh38",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Successful regulatory annotation",
          "properties": {
            "rsid": {
              "type": "string"
            },
            "assembly": {
              "type": [
                "string",
                "null"
              ]
            },
            "query_coordinates": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "regulome_score": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "probability": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ranking": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tissue_specific_scores": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "chrom": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  },
                  "rsids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "alt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Alternate allele, e.g. 'G'. The regulatory evidence is for the change from ref to alt, and neither allele was declared."
                  },
                  "freq": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Population allele frequencies, keyed by source and population - bravo_af and the gnomad_af_* breakdowns including per-sex figures. A variant common in one population and absent in another is the usual explanation for a surprising regulatory call."
                  },
                  "gencode_category": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What the variant overlaps in GENCODE, e.g. 'coding'. A regulatory score on a coding variant needs reading differently."
                  },
                  "hgvs": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGVS genomic notation, e.g. 'NC_000008.11:g.37966280A>G'. The unambiguous name for the variant, assembly accession included."
                  },
                  "ref": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Reference allele, e.g. 'A'."
                  },
                  "spdi": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "SPDI notation for the same variant, e.g. 'NC_000008.11:37966279:A:G'. Note it is 0-based where HGVS is 1-based, so the two positions differ by one by design."
                  }
                }
              }
            },
            "features": {
              "type": [
                "object",
                "array",
                "null"
              ]
            },
            "nearby_snps": {
              "type": "array"
            },
            "nearby_snps_total": {
              "type": "integer"
            },
            "nearby_snps_returned": {
              "type": "integer"
            },
            "nearby_snps_truncated": {
              "type": "boolean"
            },
            "next_nearby_snp_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "notifications": {
              "type": [
                "object",
                "null"
              ]
            },
            "total_supporting_datasets": {
              "type": "integer"
            },
            "motif_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many distinct motif target labels were found across the records, e.g. 0."
            },
            "motif_note": {
              "type": [
                "string",
                "null"
              ],
              "description": "States exactly what motif_count counts and how it differs from motif_records. Two near-identical numbers whose definitions differ is precisely the case where a caller needs telling."
            },
            "motif_records": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many motif records were found. It differs from motif_count because several records can share a target label, so the two count different things."
            }
          },
          "required": [
            "rsid",
            "regulome_score",
            "variants"
          ]
        },
        {
          "type": "object",
          "description": "Error response",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "rsid": "rs4994"
      },
      {
        "rsid": "rs429358"
      }
    ]
  }
]
