[
    {
        "name": "EnsemblSeq_get_region_sequence",
        "description": "Get the DNA nucleotide sequence for a genomic region from Ensembl with recoverable sequence paging. The default page is 10,000 bp; continue with next_sequence_offset while has_more is true. Returns the full sequence_length separately from sequence_returned_length. Supports any Ensembl species and coordinate strand.",
        "parameter": {
            "type": "object",
            "properties": {
                "region": {
                    "type": "string",
                    "description": "Genomic region in format 'chr:start-end' or 'chr:start..end:strand'. Examples: '17:7668421-7668520' (TP53 locus, 100bp), '7:140424943-140425043' (BRAF locus, 100bp), 'X:15560138-15602945' (MECP2 gene). Strand: 1 for forward, -1 for reverse."
                },
                "species": {
                    "type": "string",
                    "description": "Ensembl species name. Default: 'homo_sapiens'. Examples: 'mus_musculus', 'danio_rerio', 'drosophila_melanogaster'.",
                    "default": "homo_sapiens"
                },
                "max_length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000,
                    "default": 10000,
                    "description": "Maximum sequence characters in this page."
                },
                "sequence_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based sequence characters to skip. Continue with next_sequence_offset."
                }
            },
            "required": [
                "region"
            ]
        },
        "fields": {
            "endpoint": "region_sequence"
        },
        "type": "EnsemblSequenceTool",
        "test_examples": [
            {
                "region": "17:7668421-7668520"
            },
            {
                "region": "7:140424943-140425043",
                "species": "homo_sapiens"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "species": {
                            "type": "string",
                            "description": "Species name"
                        },
                        "region": {
                            "type": "string",
                            "description": "Genomic region queried"
                        },
                        "molecule": {
                            "type": "string",
                            "description": "Molecule type (dna)"
                        },
                        "description": {
                            "type": ["string", "null"],
                            "description": "Region description from Ensembl"
                        },
                        "sequence_length": {
                            "type": "integer",
                            "description": "Full upstream sequence length in bp"
                        },
                        "sequence_returned_length": {
                            "type": "integer"
                        },
                        "sequence_offset": {
                            "type": "integer"
                        },
                        "max_length": {
                            "type": "integer"
                        },
                        "has_more": {
                            "type": "boolean"
                        },
                        "next_sequence_offset": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "result_set_complete": {
                            "type": "boolean"
                        },
                        "sequence": {
                            "type": "string",
                            "description": "Current DNA sequence page"
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "EnsemblSeq_get_id_sequence",
        "description": "Get the amino acid or nucleotide sequence for an Ensembl protein, transcript, or gene ID with recoverable paging. Type auto-selects protein for ENSP, cDNA for ENST, and genomic for other IDs when omitted. The default page is 10,000 characters; continue with next_sequence_offset while has_more is true.",
        "parameter": {
            "type": "object",
            "properties": {
                "ensembl_id": {
                    "type": "string",
                    "description": "Ensembl stable ID. Examples: 'ENSP00000269305' (TP53 protein, 393 aa), 'ENST00000269305' (TP53-201 transcript), 'ENSG00000141510' (TP53 gene). Protein IDs start with ENSP, transcript with ENST, gene with ENSG."
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "protein",
                        "cdna",
                        "cds",
                        "genomic"
                    ],
                    "description": "Sequence type. If omitted: protein for ENSP, cDNA for ENST, genomic for ENSG/other IDs."
                },
                "max_length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000,
                    "default": 10000,
                    "description": "Maximum sequence characters in this page."
                },
                "sequence_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based sequence characters to skip. Continue with next_sequence_offset."
                }
            },
            "required": [
                "ensembl_id"
            ]
        },
        "fields": {
            "endpoint": "id_sequence"
        },
        "type": "EnsemblSequenceTool",
        "test_examples": [
            {
                "ensembl_id": "ENSP00000269305"
            },
            {
                "ensembl_id": "ENST00000269305",
                "type": "cdna"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "ensembl_id": {
                            "type": "string",
                            "description": "Ensembl stable ID"
                        },
                        "molecule": {
                            "type": ["string", "null"],
                            "description": "Molecule type (protein or dna)"
                        },
                        "description": {
                            "type": ["string", "null"],
                            "description": "Sequence description"
                        },
                        "sequence_length": {
                            "type": "integer",
                            "description": "Sequence length (aa for protein, bp for DNA)"
                        },
                        "sequence_returned_length": {
                            "type": "integer"
                        },
                        "sequence_offset": {
                            "type": "integer"
                        },
                        "max_length": {
                            "type": "integer"
                        },
                        "has_more": {
                            "type": "boolean"
                        },
                        "next_sequence_offset": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "result_set_complete": {
                            "type": "boolean"
                        },
                        "sequence": {
                            "type": "string",
                            "description": "Current amino acid or nucleotide sequence page"
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": ["error"]
                }
            ]
        }
    }
]
