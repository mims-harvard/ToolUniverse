[
  {
    "name": "BioRxiv_list_recent_preprints",
    "description": "List bioRxiv or medRxiv preprints by date range. The live API currently returns 30 records per batch; cursor is a zero-based record offset, not a page number. Always continue with metadata.next_cursor while metadata.has_more is true rather than adding a fixed 100. Metadata distinguishes total records (including revisions) from unique_new_papers. For keyword search, use EuropePMC_search_articles with 'SRC:PPR'.",
    "parameter": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "description": "Inclusive start date in YYYY-MM-DD format (e.g., '2024-01-01')."
        },
        "end_date": {
          "type": "string",
          "description": "Inclusive end date in YYYY-MM-DD format (e.g., '2024-01-03'); must not precede start_date."
        },
        "server": {
          "type": "string",
          "description": "Server: 'biorxiv' for biology preprints, 'medrxiv' for health sciences preprints",
          "default": "biorxiv",
          "enum": [
            "biorxiv",
            "medrxiv"
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based record offset. Start at 0, then use metadata.next_cursor; do not assume a fixed batch size.",
          "default": 0
        }
      },
      "required": [
        "start_date",
        "end_date"
      ]
    },
    "fields": {
      "endpoint": "https://api.biorxiv.org/details/{server}/{start_date}/{end_date}/{cursor}",
      "pagination": "biorxiv_cursor"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "start_date": "2024-01-01",
        "end_date": "2024-01-03",
        "server": "biorxiv",
        "cursor": 0
      },
      {
        "start_date": "2024-06-01",
        "end_date": "2024-06-03",
        "server": "medrxiv",
        "cursor": 0
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "bioRxiv/medRxiv recent preprints response",
          "properties": {
            "messages": {
              "type": "array",
              "description": "Status messages with pagination info",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "interval": {
                    "type": "string",
                    "description": "Date range queried"
                  },
                  "cursor": {
                    "type": "integer",
                    "description": "Current cursor position"
                  },
                  "count": {
                    "type": "integer",
                    "description": "Number of results in this batch (currently 30 in the live API)"
                  },
                  "count_new_papers": {
                    "type": "string",
                    "description": "Total unique new papers in date range"
                  },
                  "total": {
                    "type": "string",
                    "description": "Total records including revisions"
                  }
                }
              }
            },
            "collection": {
              "type": "array",
              "description": "Array of preprint metadata",
              "items": {
                "type": "object",
                "properties": {
                  "doi": {
                    "type": "string",
                    "description": "bioRxiv/medRxiv DOI"
                  },
                  "title": {
                    "type": "string",
                    "description": "Preprint title"
                  },
                  "authors": {
                    "type": "string",
                    "description": "Author list as semicolon-separated string"
                  },
                  "author_corresponding": {
                    "type": "string",
                    "description": "Corresponding author name"
                  },
                  "author_corresponding_institution": {
                    "type": "string",
                    "description": "Corresponding author institution"
                  },
                  "date": {
                    "type": "string",
                    "description": "Publication date"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version number"
                  },
                  "category": {
                    "type": "string",
                    "description": "Subject category (e.g., neuroscience, bioinformatics, genomics)"
                  },
                  "abstract": {
                    "type": "string",
                    "description": "Full abstract text"
                  },
                  "published": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Published journal DOI if accepted"
                  },
                  "license": {
                    "type": "string",
                    "description": "License type"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
