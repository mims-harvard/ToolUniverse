[
  {
    "name": "Nextstrain_list_datasets",
    "description": "List available pathogen phylogenetic datasets from Nextstrain, grouped by pathogen. Nested dataset lists are recoverably paginated: start with dataset_offset=0 and, for each pathogen group, continue with next_dataset_offset while has_more is true. dataset_count is the full group size; datasets_returned is the current page size. Optionally filter by pathogen name.",
    "parameter": {
      "type": "object",
      "properties": {
        "pathogen": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional pathogen name filter. Examples: 'flu', 'ebola', 'zika', 'dengue', 'mpox'. Leave empty for all pathogens."
        },
        "dataset_limit": {
          "type": "integer",
          "description": "Maximum datasets to return per matched pathogen group.",
          "default": 10,
          "minimum": 1,
          "maximum": 500
        },
        "dataset_offset": {
          "type": "integer",
          "description": "Zero-based offset applied within every matched pathogen group. Continue each group using its next_dataset_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "list_datasets"
    },
    "type": "NextstrainTool",
    "test_examples": [
      {
        "pathogen": "flu"
      },
      {
        "pathogen": "ebola"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pathogen": {
                "type": "string"
              },
              "dataset_count": {
                "type": "integer"
              },
              "datasets_returned": {
                "type": "integer"
              },
              "dataset_offset": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_dataset_offset": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "datasets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Nextstrain_get_dataset",
    "description": "Get metadata and phylogenetic summary for a Nextstrain pathogen dataset. Returns title, update date, sequence count, provenance, maintainers, root attributes, and the complete list of available coloring dimensions with an explicit count. Large datasets such as seasonal H3N2 expose more than 15 colorings.",
    "parameter": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Nextstrain dataset path. Examples: 'zika', 'ebola', 'flu/seasonal/h3n2/ha/2y', 'dengue/denv1', 'mpox/clade-IIb'."
        }
      },
      "required": [
        "dataset"
      ]
    },
    "fields": {
      "endpoint_type": "get_dataset"
    },
    "type": "NextstrainTool",
    "test_examples": [
      {
        "dataset": "zika"
      },
      {
        "dataset": "ebola"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated": {
              "type": [
                "string",
                "null"
              ]
            },
            "build_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "num_sequences": {
              "type": "integer"
            },
            "data_provenance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maintainers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "root_attributes": {
              "type": "object"
            },
            "available_colorings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "available_colorings_count": {"type": "integer"},
            "available_colorings_complete": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
