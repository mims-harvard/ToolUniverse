[
  {
    "name": "SIGNOR_get_interactions",
    "description": "Get causal signaling interactions for a protein or entity from SIGNOR. Results are recoverably paginated: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. Use UniProt IDs (e.g., P04637 for TP53) or SIGNOR entity IDs.",
    "parameter": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity identifier - typically a UniProt accession (e.g., 'P04637' for TP53, 'Q00987' for MDM2, 'P38398' for BRCA1). Can also be a SIGNOR complex/pathway ID."
        },
        "organism": {
          "type": "integer",
          "description": "NCBI taxonomy ID. 9606 for human, 10090 for mouse.",
          "default": 9606
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of interactions to return.",
          "default": 50,
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based interaction offset. Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        },
        "protein": {
          "type": "string",
          "description": "Gene symbol or protein name (alias for entity_id; prefer UniProt accession like P04637 for TP53)"
        }
      },
      "required": []
    },
    "fields": {
      "operation": "get_interactions",
      "pagination": "local_limit_offset"
    },
    "type": "SIGNORTool",
    "test_examples": [
      {
        "entity_id": "P04637"
      },
      {
        "entity_id": "Q00987",
        "limit": 10
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_entity": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "target_entity": {
            "type": "string"
          },
          "target_type": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "residue": {
            "type": [
              "string",
              "null"
            ]
          },
          "pmid": {
            "type": [
              "string",
              "null"
            ]
          },
          "direct": {
            "type": "boolean"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "signor_id": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "SIGNOR_list_pathways",
    "description": "List curated signaling pathways in the SIGNOR database. Optionally filter by keyword to find pathways related to diseases (Alzheimer, AML), biological processes (apoptosis, autophagy), or signaling (MAPK, PI3K). Returns pathway IDs that can be used with SIGNOR_get_pathway.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Optional keyword to filter pathways by name or description (e.g., 'cancer', 'apoptosis', 'AML'). Leave empty to list all pathways.",
          "default": ""
        }
      },
      "required": []
    },
    "fields": {
      "operation": "list_pathways"
    },
    "type": "SIGNORTool",
    "test_examples": [
      {
        "query": "apoptosis"
      },
      {
        "query": ""
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pathway_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "curator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  {
    "name": "SIGNOR_get_pathway",
    "description": "Get signaling interactions in a SIGNOR curated pathway. Results are recoverably paginated: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true. Use pathway IDs from SIGNOR_list_pathways.",
    "parameter": {
      "type": "object",
      "properties": {
        "pathway_id": {
          "type": "string",
          "description": "SIGNOR pathway identifier (e.g., 'SIGNOR-AD' for Alzheimer, 'SIGNOR-AML' for Acute Myeloid Leukemia, 'SIGNOR-AMPK' for AMPK signaling). Get IDs from SIGNOR_list_pathways."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of interactions to return.",
          "default": 100,
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based pathway-interaction offset. Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "pathway_id"
      ]
    },
    "fields": {
      "operation": "get_pathway",
      "pagination": "local_limit_offset"
    },
    "type": "SIGNORTool",
    "test_examples": [
      {
        "pathway_id": "SIGNOR-AD"
      },
      {
        "pathway_id": "SIGNOR-AMPK",
        "limit": 20
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_entity": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "target_entity": {
            "type": "string"
          },
          "target_type": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "residue": {
            "type": [
              "string",
              "null"
            ]
          },
          "pmid": {
            "type": [
              "string",
              "null"
            ]
          },
          "direct": {
            "type": "boolean"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "signor_id": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "SIGNOR_connect_proteins",
    "description": "Find the curated causal signaling sub-network connecting a set of proteins. Results are recoverably paginated with offset and metadata.next_offset. 'level' controls how many intermediate steps are allowed.",
    "parameter": {
      "type": "object",
      "properties": {
        "proteins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of two or more UniProt accessions to connect (e.g., ['P29317', 'Q06124', 'P04049', 'P15056']). SIGNOR requires UniProt IDs, not gene symbols."
        },
        "level": {
          "type": "integer",
          "description": "Path depth for connecting the proteins: 1 (direct interactions only), 2 (allow one intermediate node), or 3 (allow two intermediate nodes).",
          "default": 2,
          "enum": [
            1,
            2,
            3
          ]
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of interactions to return.",
          "default": 200,
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based interaction offset. Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "proteins"
      ]
    },
    "fields": {
      "operation": "connect_proteins",
      "pagination": "local_limit_offset"
    },
    "type": "SIGNORTool",
    "test_examples": [
      {
        "proteins": [
          "P29317",
          "Q06124",
          "P04049",
          "P15056"
        ],
        "level": 2
      },
      {
        "proteins": [
          "P15056",
          "P04049"
        ],
        "level": 1
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_entity": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "target_entity": {
                "type": "string"
              },
              "target_type": {
                "type": "string"
              },
              "target_id": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "residue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pmid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "direct": {
                "type": "boolean"
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "signor_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
