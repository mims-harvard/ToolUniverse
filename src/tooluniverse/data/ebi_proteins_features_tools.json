[
  {
    "name": "EBIProteins_get_domains_sites",
    "description": "Get and page through domain/site features for a protein from the EBI Proteins API. Returns true counts and continuation metadata and preserves every evidence record (plus its original payload), rather than silently limiting each feature to three evidence links.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53/p53), 'P00533' (EGFR), 'P01308' (Insulin), 'P31749' (AKT1)."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum features to return on this page."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into category features."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "category": "DOMAINS_AND_SITES"
    },
    "type": "EBIProteinsFeaturesTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt accession"
            },
            "entry_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt entry name"
            },
            "sequence_length": {
              "type": "integer",
              "description": "Protein sequence length"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Feature type (DNA_BIND, BINDING, REGION, MOTIF, SITE, etc.)"
                  },
                  "position_start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Start residue position"
                  },
                  "position_end": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "End residue position"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Feature description (interaction partner, binding specificity, etc.)"
                  },
                  "evidences": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "description": "Evidence for the feature, each an ECO code with its source",
                    "items": {
                      "type": "object",
                      "description": "One piece of evidence for the feature",
                      "properties": {
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Evidence Code Ontology term, e.g. ECO:0000269 for experimental evidence"
                        },
                        "source": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Where the evidence comes from, e.g. PubMed"
                        },
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Identifier in that source"
                        }
                      }
                    }
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The feature category, as upstream labels it"
                  },
                  "feature_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "UniProt feature id, e.g. PRO_0000015819 for the insulin B chain; how a processed chain is cited"
                  },
                  "molecule": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Isoform the feature applies to; empty on the canonical sequence"
                  },
                  "ligand": {
                    "type": "object",
                    "description": "What binds at this site. EGFR 718-726 binds ATP (CHEBI:30616) and the whole of that was dropped from a category whose own description is 'binding sites'.",
                    "properties": {
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "part": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "label": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "database": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Usually ChEBI"
                      },
                      "database_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "ligand_part": {
                    "type": "object",
                    "description": "The part of the ligand that binds, where UniProt distinguishes it",
                    "properties": {
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "database": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "database_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "raw_evidences": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "description": "The same evidence as UniProt sends it, with the source object intact",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "array",
                          "object",
                          "null"
                        ]
                      }
                    }
                  }
                }
              },
              "description": "Domain/site features (max 100)"
            },
            "total_features": {
              "type": "integer",
              "description": "Total feature count"
            },
            "feature_type_counts": {
              "type": [
                "object",
                "null"
              ],
              "description": "How many features of each type the entry has, keyed by UniProt feature type such as DNA_BIND, REGION or MOTIF",
              "additionalProperties": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Count for that feature type"
              }
            },
            "taxid": {
              "type": [
                "integer",
                "null"
              ],
              "description": "NCBI taxon id of the organism, which the response carries"
            },
            "sequence_checksum": {
              "type": [
                "string",
                "null"
              ],
              "description": "CRC64 of the sequence the positions are against"
            },
            "has_more": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether more features remain beyond this page"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Page size applied"
            },
            "offset": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Offset of this page"
            },
            "returned": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Features on this page"
            },
            "truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the feature list was cut. Declared because a caller reading the schema otherwise has no way to know the result is paged at all"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
