[
  {
    "name": "EBIProteins_get_domains_sites",
    "description": "Get and page through domain/site features for a protein from the EBI Proteins API. Returns true counts and continuation metadata and preserves every evidence record (plus its original payload), rather than silently limiting each feature to three evidence links.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P04637' (TP53/p53), 'P00533' (EGFR), 'P01308' (Insulin), 'P31749' (AKT1)."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum features to return on this page."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into category features."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "category": "DOMAINS_AND_SITES"
    },
    "type": "EBIProteinsFeaturesTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt accession"
            },
            "entry_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt entry name"
            },
            "sequence_length": {
              "type": "integer",
              "description": "Protein sequence length"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Feature type (DNA_BIND, BINDING, REGION, MOTIF, SITE, etc.)"
                  },
                  "position_start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Start residue position"
                  },
                  "position_end": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "End residue position"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Feature description (interaction partner, binding specificity, etc.)"
                  },
                  "evidences": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "description": "Literature evidence"
                  }
                }
              },
              "description": "Domain/site features (max 100)"
            },
            "total_features": {
              "type": "integer",
              "description": "Total feature count"
            },
            "feature_type_counts": {
              "type": "object",
              "description": "Count of each feature type (DNA_BIND, BINDING, REGION, MOTIF, SITE)"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_molecule_processing",
    "description": "Get and page through molecule-processing features for a protein from the EBI Proteins API. Returns true counts, continuation metadata, and every evidence record for signal peptides, chains, propeptides, transit peptides, and related processing annotations.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession. Examples: 'P01308' (Insulin - classic example), 'P01375' (TNF-alpha), 'P01189' (POMC - multiple peptides), 'P06213' (Insulin receptor)."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum features to return on this page."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into category features."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "category": "MOLECULE_PROCESSING"
    },
    "type": "EBIProteinsFeaturesTool",
    "test_examples": [
      {
        "accession": "P01308"
      },
      {
        "accession": "P01375"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt accession"
            },
            "entry_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt entry name"
            },
            "sequence_length": {
              "type": "integer",
              "description": "Full precursor sequence length"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Feature type (SIGNAL, TRANSIT, CHAIN, PEPTIDE, PROPEP, INIT_MET)"
                  },
                  "position_start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Start residue position"
                  },
                  "position_end": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "End residue position"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Chain/peptide name or processing description"
                  },
                  "evidences": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "description": "Evidence references"
                  }
                }
              },
              "description": "Molecule processing features"
            },
            "total_features": {
              "type": "integer",
              "description": "Total feature count"
            },
            "feature_type_counts": {
              "type": "object",
              "description": "Count of each processing type (SIGNAL, CHAIN, PEPTIDE, PROPEP, etc.)"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_structural_features",
