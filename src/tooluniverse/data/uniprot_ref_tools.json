[
  {
    "name": "UniProtRef_search_diseases",
    "description": "Search the UniProt controlled disease vocabulary with official cursor pagination. Returns disease definitions and cross-references; metadata reports the true upstream total and next_cursor.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for diseases. Can be disease name, symptom keyword, or gene name. Examples: 'breast cancer', 'diabetes', 'Alzheimer', 'cystic fibrosis', 'TP53'."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per official cursor page (default 10, maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_diseases"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "query": "breast cancer"
      },
      {
        "query": "diabetes",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "acronym": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "alternative_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cross_references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "properties": {
                      "type": "array",
                      "description": "MIM cross-references carry the property that says which KIND of entry the id is -- UniProt sends these as plain strings such as \"phenotype\" or \"gene\", and an OMIM gene id used as a disease id is a different claim",
                      "items": {
                        "type": [
                          "string",
                          "object"
                        ]
                      }
                    }
                  }
                }
              },
              "reviewed_protein_count": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "unreviewed_protein_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": [
                    "object",
                    "string"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_get_disease",
    "description": "Get detailed information about a specific disease from the UniProt controlled disease vocabulary by its ID. Returns the full disease definition, alternative names, cross-references to OMIM/MeSH/MedGen/SNOMED, and protein association counts. Example: DI-01559 returns 'Breast-ovarian cancer, familial, 1' with links to OMIM:604370 and MeSH:D001943.",
    "parameter": {
      "type": "object",
      "properties": {
        "disease_id": {
          "type": "string",
          "description": "UniProt disease ID in format DI-XXXXX. Get IDs from UniProtRef_search_diseases. Examples: 'DI-01559' (familial breast-ovarian cancer 1), 'DI-01465' (Cystathioninuria)."
        }
      },
      "required": [
        "disease_id"
      ]
    },
    "fields": {
      "endpoint": "get_disease"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "disease_id": "DI-01559"
      },
      {
        "disease_id": "DI-01465"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "acronym": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            },
            "alternative_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "reviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "unreviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_search_keywords",
    "description": "Search the UniProt keyword controlled vocabulary with official cursor pagination. Returns keyword definitions and protein counts; metadata reports the true upstream total and next_cursor.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for keywords. Examples: 'kinase', 'apoptosis', 'membrane', 'phosphorylation', 'zinc finger'."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per official cursor page (default 10, maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_keywords"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "query": "apoptosis"
      },
      {
        "query": "kinase",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "reviewed_protein_count": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "unreviewed_protein_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "A keyword on 300 Swiss-Prot entries and 40,000 TrEMBL ones is a different thing from one on 300 and 12"
              },
              "category_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parents": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "gene_ontologies": {
                "type": "array",
                "description": "The GO terms the keyword corresponds to, which is how a keyword search is carried into an enrichment analysis",
                "items": {
                  "type": "object"
                }
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_get_keyword",
    "description": "Get detailed information about a specific UniProt keyword by its ID. Returns the full definition, category (Biological process, Molecular function, Cellular component, Disease, etc.), parent keywords in the hierarchy, GO term mappings, and protein counts. Example: KW-0053 returns 'Apoptosis' in the 'Biological process' category with GO:0006915 mapping and count of annotated proteins.",
    "parameter": {
      "type": "object",
      "properties": {
        "keyword_id": {
          "type": "string",
          "description": "UniProt keyword ID in format KW-XXXX. Get IDs from UniProtRef_search_keywords. Examples: 'KW-0053' (Apoptosis), 'KW-0418' (Kinase), 'KW-0002' (3D-structure)."
        }
      },
      "required": [
        "keyword_id"
      ]
    },
    "fields": {
      "endpoint": "get_keyword"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "keyword_id": "KW-0053"
      },
      {
        "keyword_id": "KW-0418"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            },
            "parents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "go_mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "go_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "reviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "unreviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_get_proteome",
    "description": "Get reference proteome information from UniProt by proteome ID. Returns the complete upstream description with description_length (not the former 500-character prefix). The total protein count covers every component; the component list is explicitly paginated with complete totals and a next offset in metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "proteome_id": {
          "type": "string",
          "description": "UniProt proteome ID. Examples: 'UP000005640' (human), 'UP000000589' (mouse), 'UP000002311' (yeast), 'UP000000625' (E. coli K-12)."
        },
        "component_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based component offset. Continue with metadata.next_component_offset."
        },
        "component_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 30,
          "description": "Maximum components returned in this response. total_protein_count always covers all components."
        }
      },
      "required": [
        "proteome_id"
      ]
    },
    "fields": {
      "endpoint": "get_proteome"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "proteome_id": "UP000005640"
      },
      {
        "proteome_id": "UP000000625"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "description_length": {
              "type": "integer"
            },
            "organism": {
              "type": "object",
              "properties": {
                "scientific_name": {
                  "type": "string"
                },
                "common_name": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "proteome_type": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "protein_count": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "genome_accession": {
                    "type": "string"
                  }
                }
              }
            },
            "total_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "taxon_lineage": {
              "type": "array",
              "description": "The organism's place in the tree; 30 ranks are in the same record",
              "items": {
                "type": "object"
              }
            },
            "strain": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "citations": {
              "type": "array",
              "description": "The papers describing the proteome, with their authors and cross-references",
              "items": {
                "type": "object"
              }
            },
            "genome_assembly": {
              "type": [
                "object",
                "null"
              ]
            },
            "genome_annotation": {
              "type": [
                "object",
                "null"
              ]
            },
            "annotation_score": {
              "type": [
                "number",
                "null"
              ]
            },
            "busco": {
              "type": [
                "object",
                "null"
              ],
              "description": "BUSCO completeness: complete, duplicated, fragmented and missing counts"
            },
            "cpd": {
              "type": [
                "object",
                "null"
              ],
              "description": "UniProt's own Complete Proteome Detector report"
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_search_proteomes",
    "description": "Search UniProt reference proteomes with official cursor pagination. Returns proteome IDs, organisms, types, and protein counts; metadata reports the true upstream total and next_cursor.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for proteomes. Can be organism name or taxon ID. Examples: 'homo sapiens', 'mouse', 'Arabidopsis thaliana', '9606', 'Escherichia coli'."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per official cursor page (default 10, maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_proteomes"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "query": "Arabidopsis thaliana"
      },
      {
        "query": "Escherichia coli",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "organism": {
                "type": "string"
              },
              "common_name": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "taxon_id": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "proteome_type": {
                "type": "string"
              },
              "protein_count": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "taxon_lineage": {
                "type": "array",
                "description": "Lineage names, summarised; UniProtRef_get_proteome has the ranked records",
                "items": {
                  "type": "string"
                }
              },
              "taxon_rank": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "strain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "component_count": {
                "type": "integer"
              },
              "citation_count": {
                "type": "integer"
              },
              "annotation_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "genome_assembly_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "busco_complete_percent": {
                "type": [
                  "number",
                  "integer",
                  "null"
                ]
              },
              "component_databases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
