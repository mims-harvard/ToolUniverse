[
  {
    "name": "UniProtRef_search_diseases",
    "description": "Search the UniProt controlled disease vocabulary with official cursor pagination. Returns disease definitions and cross-references; metadata reports the true upstream total and next_cursor.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for diseases. Can be disease name, symptom keyword, or gene name. Examples: 'breast cancer', 'diabetes', 'Alzheimer', 'cystic fibrosis', 'TP53'."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per official cursor page (default 10, maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_diseases"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "query": "breast cancer"
      },
      {
        "query": "diabetes",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "acronym": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "alternative_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cross_references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              },
              "reviewed_protein_count": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_get_disease",
    "description": "Get detailed information about a specific disease from the UniProt controlled disease vocabulary by its ID. Returns the full disease definition, alternative names, cross-references to OMIM/MeSH/MedGen/SNOMED, and protein association counts. Example: DI-01559 returns 'Breast-ovarian cancer, familial, 1' with links to OMIM:604370 and MeSH:D001943.",
    "parameter": {
      "type": "object",
      "properties": {
        "disease_id": {
          "type": "string",
          "description": "UniProt disease ID in format DI-XXXXX. Get IDs from UniProtRef_search_diseases. Examples: 'DI-01559' (familial breast-ovarian cancer 1), 'DI-01465' (Cystathioninuria)."
        }
      },
      "required": [
        "disease_id"
      ]
    },
    "fields": {
      "endpoint": "get_disease"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "disease_id": "DI-01559"
      },
      {
        "disease_id": "DI-01465"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "acronym": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            },
            "alternative_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "reviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "unreviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
