  {
    "name": "UniProtRef_get_keyword",
    "description": "Get detailed information about a specific UniProt keyword by its ID. Returns the full definition, category (Biological process, Molecular function, Cellular component, Disease, etc.), parent keywords in the hierarchy, GO term mappings, and protein counts. Example: KW-0053 returns 'Apoptosis' in the 'Biological process' category with GO:0006915 mapping and count of annotated proteins.",
    "parameter": {
      "type": "object",
      "properties": {
        "keyword_id": {
          "type": "string",
          "description": "UniProt keyword ID in format KW-XXXX. Get IDs from UniProtRef_search_keywords. Examples: 'KW-0053' (Apoptosis), 'KW-0418' (Kinase), 'KW-0002' (3D-structure)."
        }
      },
      "required": [
        "keyword_id"
      ]
    },
    "fields": {
      "endpoint": "get_keyword"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "keyword_id": "KW-0053"
      },
      {
        "keyword_id": "KW-0418"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            },
            "parents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "go_mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "go_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "reviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "unreviewed_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_get_proteome",
    "description": "Get reference proteome information from UniProt by proteome ID. Returns the complete upstream description with description_length (not the former 500-character prefix). The total protein count covers every component; the component list is explicitly paginated with complete totals and a next offset in metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "proteome_id": {
          "type": "string",
          "description": "UniProt proteome ID. Examples: 'UP000005640' (human), 'UP000000589' (mouse), 'UP000002311' (yeast), 'UP000000625' (E. coli K-12)."
        },
        "component_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based component offset. Continue with metadata.next_component_offset."
        },
        "component_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 30,
          "description": "Maximum components returned in this response. total_protein_count always covers all components."
        }
      },
      "required": [
        "proteome_id"
      ]
    },
    "fields": {
      "endpoint": "get_proteome"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "proteome_id": "UP000005640"
      },
      {
        "proteome_id": "UP000000625"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "description_length": {
              "type": "integer"
            },
            "organism": {
              "type": "object",
              "properties": {
                "scientific_name": {
                  "type": "string"
                },
                "common_name": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              }
            },
            "proteome_type": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "protein_count": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "genome_accession": {
                    "type": "string"
                  }
                }
              }
            },
            "total_protein_count": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtRef_search_proteomes",
    "description": "Search UniProt reference proteomes with official cursor pagination. Returns proteome IDs, organisms, types, and protein counts; metadata reports the true upstream total and next_cursor.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for proteomes. Can be organism name or taxon ID. Examples: 'homo sapiens', 'mouse', 'Arabidopsis thaliana', '9606', 'Escherichia coli'."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per official cursor page (default 10, maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_proteomes"
    },
    "type": "UniProtRefTool",
    "test_examples": [
      {
        "query": "Arabidopsis thaliana"
      },
      {
        "query": "Escherichia coli",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "organism": {
                "type": "string"
              },
              "common_name": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "taxon_id": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "proteome_type": {
                "type": "string"
              },
              "protein_count": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
