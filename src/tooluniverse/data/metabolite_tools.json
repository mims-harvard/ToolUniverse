[
  {
    "name": "Metabolite_get_info",
    "description": "Get compound information for a metabolite by HMDB ID, compound name, or PubChem CID. Returns common name, IUPAC name, molecular formula, molecular weight, canonical SMILES, and InChIKey via PubChem. Accepts HMDB IDs (e.g., HMDB0000122), compound names (e.g., glucose), or PubChem CIDs (numeric).",
    "type": "MetaboliteTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_info",
          "default": "get_info"
        },
        "hmdb_id": {
          "type": "string",
          "description": "HMDB ID (e.g., HMDB0000122 or HMDB0000001)"
        },
        "compound_name": {
          "type": "string",
          "description": "Compound name (e.g., glucose, L-alanine, caffeine)"
        },
        "pubchem_cid": {
          "type": [
            "integer",
            "string"
          ],
          "description": "PubChem CID (e.g., 5793)"
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "pubchem_cid": {
          "type": "integer"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "iupac_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "molecular_weight": {
          "type": [
            "string",
            "null"
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "inchikey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "test_examples": [
      {
        "hmdb_id": "HMDB0000122"
      },
      {
        "compound_name": "caffeine"
      },
      {
        "pubchem_cid": 5793
      }
    ],
    "fields": {
      "operation": "get_info"
    }
  },
  {
    "name": "Metabolite_search",
    "description": "Search for metabolites by compound name or molecular formula via PubChem. Returns a resumable result page with PubChem CID, name, formula, molecular weight, and SMILES. Use search_type='name' for name/keyword search (default) or search_type='formula' for exact molecular formula search (e.g., C6H12O6). metadata.total_results reports the full count for exact name/formula results; autocomplete fallbacks explicitly set metadata.result_set_complete=false because PubChem autocomplete exposes no authoritative total.",
    "type": "MetaboliteTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "search",
          "default": "search"
        },
        "query": {
          "type": "string",
          "description": "Search query: compound name (e.g., glucose) or molecular formula (e.g., C6H12O6)"
        },
        "search_type": {
          "type": "string",
          "description": "Search type: 'name' for compound name search, 'formula' for molecular formula search (default: name)",
          "default": "name"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Page size (default 10, maximum 50).",
          "default": 10
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based result offset. Continue with metadata.next_offset when metadata.has_more is true.",
          "default": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "results": {
          "type": "array"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "test_examples": [
      {
        "query": "glucose"
      },
      {
        "query": "C6H12O6",
        "search_type": "formula"
      }
    ],
    "fields": {
      "operation": "search"
    }
  },
  {
    "name": "Metabolite_get_diseases",
    "description": "Get curated disease associations for a metabolite using mydisease.info's BioThings cache of CTD (Comparative Toxicogenomics Database). Accepts HMDB ID, compound name, or PubChem CID. Resolves the identifier through PubChem, fetches every mydisease hit across server pages, and returns a resumable association page with disease ID, direct CTD evidence when present, and supporting PubMed IDs. data.disease_count and metadata.total_results report the full matched association count.",
    "type": "MetaboliteTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "get_diseases",
          "default": "get_diseases"
        },
        "hmdb_id": {
          "type": "string",
          "description": "HMDB ID (e.g., HMDB0000122)"
        },
        "compound_name": {
          "type": "string",
          "description": "Compound name (e.g., glucose, cholesterol)"
        },
        "pubchem_cid": {
          "type": [
            "integer",
            "string"
          ],
          "description": "PubChem CID (e.g., 5793)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Page size for disease associations (default: 50)",
          "default": 50
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based association offset. Continue with metadata.next_offset when metadata.has_more is true.",
          "default": 0
        }
      }
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "compound_name": {
          "type": "string"
        },
        "pubchem_cid": {
          "type": "integer"
        },
        "ctd_query_term": {
          "type": "string"
        },
        "disease_count": {
          "type": "integer"
        },
        "diseases": {
          "type": "array"
        }
      }
    },
    "test_examples": [
      {
        "hmdb_id": "HMDB0000122",
        "limit": 5
      },
      {
        "compound_name": "cholesterol",
        "limit": 10
      }
    ],
    "fields": {
      "operation": "get_diseases"
    }
  },
  {
