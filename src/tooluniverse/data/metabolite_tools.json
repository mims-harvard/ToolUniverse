                    ]
                  },
                  "formula": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "molecular_weight": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "smiles": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "count": {
              "type": "integer",
              "description": "Number of compounds returned"
            }
          },
          "required": [
