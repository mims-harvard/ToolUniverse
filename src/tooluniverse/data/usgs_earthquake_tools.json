[
  {
    "name": "USGS_get_earthquake_feed",
    "description": "Get recent USGS earthquake data feeds in GeoJSON format. Returns earthquakes based on magnitude threshold and time period. Data includes magnitude, location, depth, coordinates, and impact metrics. Feeds are updated in real-time. Use for monitoring seismic activity, disaster response planning, and geological research.",
    "parameter": {
      "type": "object",
      "properties": {
        "magnitude": {
          "type": "string",
          "description": "Minimum magnitude filter: 'significant' (felt widely), '4.5', '2.5', '1.0', 'all' (includes micro-earthquakes). Higher magnitude = fewer but larger events."
        },
        "period": {
          "type": "string",
          "description": "Time period: 'hour' (past 1 hour), 'day' (past 24 hours), 'week' (past 7 days), 'month' (past 30 days)"
        }
      },
      "required": [
        "magnitude",
        "period"
      ]
    },
    "fields": {
      "endpoint": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/{magnitude}_{period}.geojson"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "magnitude": "significant",
        "period": "month"
      },
      {
        "magnitude": "4.5",
        "period": "week"
      },
      {
        "magnitude": "2.5",
        "period": "day"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "GeoJSON FeatureCollection of recent earthquakes",
          "properties": {
            "type": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "generated": {
                  "type": "integer",
                  "description": "Unix timestamp of feed generation"
                },
                "count": {
                  "type": "integer",
                  "description": "Number of events in feed"
                },
                "title": {
                  "type": "string"
                },
                "api": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Version of the USGS feed API that produced the reply, e.g. '2.8.2'."
                },
                "status": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "HTTP status USGS recorded for the feed generation, e.g. 200."
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The exact feed URL queried, e.g. '.../summary/significant_month.geojson'. The record of which magnitude threshold and time window the answer actually covers."
                }
              }
            },
            "features": {
              "type": "array",
              "description": "List of earthquake events",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "USGS event ID"
                  },
                  "geometry": {
                    "type": "object",
                    "properties": {
                      "coordinates": {
                        "type": "array",
                        "description": "[longitude, latitude, depth_km]",
                        "items": {
                          "type": "number"
                        }
                      },
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "GeoJSON geometry type, 'Point'. USGS reports an epicentre as a point, never an extent."
                      }
                    }
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "mag": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Magnitude"
                      },
                      "place": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Location description"
                      },
                      "time": {
                        "type": "integer",
                        "description": "Event time (milliseconds since epoch)"
                      },
                      "updated": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "description": "USGS event page URL"
                      },
                      "alert": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "PAGER alert level: green/yellow/orange/red"
                      },
                      "tsunami": {
                        "type": "integer",
                        "description": "1 if tsunami potential, 0 if not"
                      },
                      "sig": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Significance score 0-1000"
                      },
                      "magType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "felt": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Number of felt reports"
                      },
                      "cdi": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Maximum community intensity"
                      },
                      "mmi": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Instrumental intensity (Modified Mercalli)"
                      },
                      "code": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The event code within its network, e.g. '7000tx16'. Combined with 'net' it forms the full event id."
                      },
                      "detail": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "URL of the full GeoJSON record for this one quake, with all its products. The feed row is a summary; this is where the rest is."
                      },
                      "dmin": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Horizontal distance from the epicentre to the nearest station, in degrees. Large values mean the depth is poorly constrained."
                      },
                      "gap": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Largest azimuthal gap between stations, in degrees, e.g. 29. Above about 180 the location is unreliable whatever the other numbers say."
                      },
                      "ids": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Every event id this quake is known by, comma-delimited with leading and trailing commas, e.g. ',us7000tx16,'. Regional networks assign their own ids to the same quake, and this is how duplicates are recognised."
                      },
                      "net": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Network that contributed the preferred origin, e.g. 'us', 'ci', 'ak'. Which observatory's solution is being reported."
                      },
                      "nst": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Number of seismic stations used to locate the event, e.g. 129. More stations means a tighter location."
                      },
                      "rms": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Root-mean-square residual of the travel-time fit, in seconds. How well the reported location explains the arrivals."
                      },
                      "sources": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Every network that contributed, comma-delimited with leading and trailing commas, e.g. ',us,'."
                      },
                      "status": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Whether a human has checked the solution: 'reviewed' means an analyst confirmed it, 'automatic' means no one has. The difference between a provisional and a confirmed earthquake."
                      },
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "What the event was, e.g. 'earthquake', 'quarry blast', 'explosion', 'ice quake'. Not every row in an earthquake feed is an earthquake."
                      },
                      "types": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Every product available for the quake, comma-delimited, e.g. ',dyfi,ground-failure,losspager,moment-tensor,origin,phase-data,shakemap,'. Says whether a ShakeMap or a loss estimate exists before one is requested."
                      }
                    }
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GeoJSON feature type, 'Feature'."
                  }
                }
              }
            },
            "bbox": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              },
              "description": "Bounding box of every quake in the feed, as six numbers: min longitude, min latitude, min depth, max longitude, max latitude, max depth. Depth is part of it, so it is six values, not four."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "USGS_query_earthquakes",
    "description": "Query the USGS FDSN earthquake database with explicit one-based offset pagination and an exact total from the official count endpoint. Continue with metadata.next_offset while metadata.has_more is true. The GeoJSON response itself contains only the current page and does not include a total count. Use a fixed endtime for reproducible pagination of live data.",
    "parameter": {
      "type": "object",
      "properties": {
        "minmagnitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Minimum earthquake magnitude (e.g., 5.0, 6.5, 7.0)"
        },
        "maxmagnitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Maximum earthquake magnitude"
        },
        "starttime": {
          "type": [
            "string",
            "null"
          ],
          "description": "Start time in ISO 8601 format (e.g., '2024-01-01', '2020-01-01T00:00:00')"
        },
        "endtime": {
          "type": [
            "string",
            "null"
          ],
          "description": "End time in ISO 8601 format (e.g., '2024-12-31'). Defaults to current time."
        },
        "minlatitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Minimum latitude for bounding box search (-90 to 90)"
        },
        "maxlatitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Maximum latitude for bounding box search"
        },
        "minlongitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Minimum longitude (-180 to 360)"
        },
        "maxlongitude": {
          "type": [
            "number",
            "null"
          ],
          "description": "Maximum longitude"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20000,
          "default": 20000,
          "description": "Events per page (default 20000, max 20000)"
        },
        "offset": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based event offset. Continue with metadata.next_offset."
        },
        "orderby": {
          "type": "string",
          "enum": [
            "time",
            "time-asc",
            "magnitude",
            "magnitude-asc"
          ],
          "default": "time",
          "description": "Stable result ordering. Default 'time' (newest first)."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://earthquake.usgs.gov/fdsnws/event/1/query",
      "count_endpoint": "https://earthquake.usgs.gov/fdsnws/event/1/count",
      "params": {
        "format": "geojson"
      },
      "pagination": "usgs_offset_count"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "minmagnitude": 7.0,
        "starttime": "2020-01-01",
        "endtime": "2024-12-31",
        "limit": 10
      },
      {
        "minmagnitude": 6.0,
        "starttime": "2024-01-01",
        "minlatitude": -60,
        "maxlatitude": 60,
        "limit": 5
      },
      {
        "minmagnitude": 5.0,
        "starttime": "2023-01-01",
        "endtime": "2023-12-31",
        "minlatitude": 30,
        "maxlatitude": 45,
        "minlongitude": 25,
        "maxlongitude": 45,
        "limit": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "GeoJSON FeatureCollection of earthquake results",
          "properties": {
            "type": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "geometry": {
                    "type": "object"
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "mag": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "place": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "time": {
                        "type": "integer"
                      },
                      "updated": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "alert": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "tsunami": {
                        "type": "integer"
                      },
                      "sig": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "magType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
