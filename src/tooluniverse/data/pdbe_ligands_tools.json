[
    {
        "name": "PDBe_get_structure_ligands",
        "description": "Get ligands (drug-like molecules, cofactors, ions) bound in a PDB structure. Ligands and annotations within each ligand are independently paginated. Inspect total/returned/truncated/next-offset fields at both levels; large structures can contain hundreds or thousands of ligand instances.",
        "parameter": {
            "type": "object",
            "properties": {
                "pdb_id": {
                    "type": "string",
                    "description": "PDB entry ID (4-character code). Examples: '4hhb' (hemoglobin), '3ert' (estrogen receptor + tamoxifen), '1m17' (EGFR + erlotinib), '6lu7' (SARS-CoV-2 main protease + inhibitor). Case-insensitive."
                },
                "ligand_offset": {
                    "type": "integer",
                    "description": "Zero-based ligand offset.",
                    "default": 0,
                    "minimum": 0
                },
                "ligand_limit": {
                    "type": "integer",
                    "description": "Ligands returned per page (default 50, maximum 500).",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 500
                },
                "annotation_offset": {
                    "type": "integer",
                    "description": "Zero-based annotation offset applied within every returned ligand.",
                    "default": 0,
                    "minimum": 0
                },
                "annotation_limit": {
                    "type": "integer",
                    "description": "Annotations returned per ligand (default 5, maximum 500).",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 500
                }
            },
            "required": ["pdb_id"]
        },
        "fields": {
            "endpoint": "ligand_monomers"
        },
        "type": "PDBeLigandsTool",
        "test_examples": [
            {
                "pdb_id": "4hhb"
            },
            {
                "pdb_id": "3ert"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "pdb_id": {"type": "string"},
                        "ligands": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "chem_comp_id": {"type": "string", "description": "3-letter chemical component code"},
                                    "chem_comp_name": {"type": "string", "description": "Full chemical name"},
                                    "weight": {"type": "number", "description": "Molecular weight in Da"},
                                    "chain_id": {"type": "string"},
                                    "entity_id": {"type": "integer"},
                                    "author_residue_number": {"type": "integer"},
                                    "carbohydrate_polymer": {"type": "boolean"},
                                    "annotations": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "type": {"type": ["string", "null"]},
                                                "interacting_entity_id": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "interacting_chain": {"type": ["string", "null"]},
                                                "interacting_uniprot": {"type": ["string", "null"]}
                                            }
                                        }
                                    },
                                    "annotations_total": {
                                        "type": "integer"
                                    },
                                    "annotations_returned": {
                                        "type": "integer"
                                    },
                                    "annotations_truncated": {
                                        "type": "boolean"
                                    },
                                    "next_annotation_offset": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    }
                                }
                            }
                        },
                        "total_ligands": {"type": "integer"},
                        "ligand_offset": {
                            "type": "integer"
                        },
                        "ligands_returned": {
                            "type": "integer"
                        },
                        "ligands_truncated": {
                            "type": "boolean"
                        },
                        "next_ligand_offset": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {"type": "string"}
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "PDBe_get_residue_listing",
        "description": "Get per-residue information for a PDB structure, optionally filtered by chain. Molecules, chains within each molecule, and residues within each chain are independently paginated. Inspect total/returned/truncated/next-offset fields at every level to avoid silently missing residues.",
        "parameter": {
            "type": "object",
            "properties": {
                "pdb_id": {
                    "type": "string",
                    "description": "PDB entry ID (4-character code). Examples: '4hhb', '3ert', '1tup', '6lu7'. Case-insensitive."
                },
                "chain_id": {
                    "type": ["string", "null"],
                    "description": "Optional chain ID to filter (e.g., 'A', 'B'). If not provided, all chains are returned."
                },
                "molecule_offset": {
                    "type": "integer",
                    "description": "Zero-based molecule offset.",
                    "default": 0,
                    "minimum": 0
                },
                "molecule_limit": {
                    "type": "integer",
                    "description": "Molecules returned per page (default 10, maximum 500).",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 500
                },
                "chain_offset": {
                    "type": "integer",
                    "description": "Zero-based chain offset applied within every returned molecule.",
                    "default": 0,
                    "minimum": 0
                },
                "chain_limit": {
                    "type": "integer",
                    "description": "Chains returned per molecule (default 5, maximum 500).",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 500
                },
                "residue_offset": {
                    "type": "integer",
                    "description": "Zero-based residue offset applied within every returned chain.",
                    "default": 0,
                    "minimum": 0
                },
                "residue_limit": {
                    "type": "integer",
                    "description": "Residues returned per chain (default 30, maximum 5000).",
                    "default": 30,
                    "minimum": 1,
                    "maximum": 5000
                }
            },
            "required": ["pdb_id"]
        },
        "fields": {
            "endpoint": "residue_listing"
        },
        "type": "PDBeLigandsTool",
        "test_examples": [
            {
                "pdb_id": "4hhb",
                "chain_id": "A"
            },
            {
                "pdb_id": "3ert"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "pdb_id": {"type": "string"},
                        "molecules": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "entity_id": {"type": "integer"},
                                    "chains": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "chain_id": {"type": "string"},
                                                "struct_asym_id": {
                                                    "type": "string"
                                                },
                                                "total_residues": {"type": "integer"},
                                                "residue_offset": {
                                                    "type": "integer"
                                                },
                                                "residues_returned": {
                                                    "type": "integer"
                                                },
                                                "residues_truncated": {
                                                    "type": "boolean"
                                                },
                                                "next_residue_offset": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "residues": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "residue_number": {"type": "integer"},
                                                            "residue_name": {"type": "string"},
                                                            "author_residue_number": {"type": "integer"},
                                                            "observed_ratio": {"type": "number"}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "total_chains": {
                                        "type": "integer"
                                    },
                                    "chain_offset": {
                                        "type": "integer"
                                    },
                                    "chains_returned": {
                                        "type": "integer"
                                    },
                                    "chains_truncated": {
                                        "type": "boolean"
                                    },
                                    "next_chain_offset": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    }
                                }
                            }
                        },
                        "total_molecules": {"type": "integer"},
                        "molecule_offset": {
                            "type": "integer"
                        },
                        "molecules_returned": {
                            "type": "integer"
                        },
                        "molecules_truncated": {
                            "type": "boolean"
                        },
                        "next_molecule_offset": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {"type": "string"}
                    },
                    "required": ["error"]
                }
            ]
        }
    }
]
