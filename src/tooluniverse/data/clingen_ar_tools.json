[
  {
    "name": "ClinGenAR_lookup_allele",
    "description": "Look up a genetic variant in the ClinGen Allele Registry by HGVS notation. Returns the canonical allele identifier (CA ID), community standard title, and cross-references to ClinVar, dbSNP, COSMIC, gnomAD, and other databases. The Allele Registry normalizes variant representations across different coordinate systems and nomenclatures. Example: 'NM_000546.6:c.743G>A' returns CA000387 (TP53 p.Arg248Gln) with links to ClinVar, COSMIC, and gnomAD.",
    "parameter": {
      "type": "object",
      "properties": {
        "hgvs": {
          "type": "string",
          "description": "HGVS expression for the variant. Supports coding (c.), genomic (g.), and protein (p.) notations. Examples: 'NM_000546.6:c.743G>A' (TP53 R248Q), 'NC_000017.11:g.7674220C>T', 'NM_000059.4:c.5946delT' (BRCA2)."
        }
      },
      "required": [
        "hgvs"
      ]
    },
    "fields": {
      "endpoint": "lookup_allele"
    },
    "type": "ClinGenARTool",
    "test_examples": [
      {
        "hgvs": "NM_000546.6:c.743G>A"
      },
      {
        "hgvs": "NC_000017.11:g.7674220C>T"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allele_id": {
              "type": "string",
              "description": "ClinGen canonical allele ID (e.g., CA000387)"
            },
            "allele_url": {
              "type": "string",
              "description": "Full URL to allele record"
            },
            "community_standard_title": {
              "type": [
                "string",
                "null"
              ],
              "description": "Standardized HGVS title"
            },
            "external_records": {
              "type": "object",
              "description": "Cross-references to external databases (dbSNP, ClinVar, COSMIC, gnomAD, ExAC)"
            },
            "genomic_alleles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hgvs": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference_genome": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hgvs_all": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every HGVS spelling for this assembly, not only the first"
                  },
                  "chromosome": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "coordinates": {
                    "type": "array",
                    "description": "Where the allele sits in this reference sequence and what it replaces",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "reference_allele": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "allele": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "start_intron_offset": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "Offset into the intron from `start`. When set, the position is start-offset or start+offset per start_intron_direction, not `start` itself."
                        },
                        "start_intron_direction": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "'-' or '+': which way the offset runs from the exon boundary"
                        },
                        "end_intron_offset": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end_intron_direction": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "is_intronic": {
                          "type": "boolean",
                          "description": "True when either offset is set, i.e. `start`/`end` alone do not name the position"
                        }
                      }
                    }
                  },
                  "reference_sequence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Genomic coordinates in different assemblies"
            },
            "allele_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "The kind of allele the registry normalised, e.g. 'nucleotide'"
            },
            "community_standard_titles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every community standard title, where community_standard_title is the first"
            },
            "gene_symbol": {
              "type": [
                "string",
                "null"
              ],
              "description": "The gene the allele is in, when the transcript alleles name exactly one"
            },
            "gene_symbols": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every gene named by a transcript allele (an allele can overlap several)"
            },
            "gene_ncbi_id": {
              "type": [
                "integer",
                "null"
              ],
              "description": "NCBI Gene ID of the gene"
            },
            "protein_effect": {
              "type": [
                "string",
                "null"
              ],
              "description": "Protein consequence (p.) from the MANE Select transcript, else from the first transcript allele"
            },
            "mane_select_transcript": {
              "type": [
                "object",
                "null"
              ],
              "description": "The MANE Select transcript allele, surfaced whatever its position in the list; same shape as a transcript_alleles item. Null when the registry lists no MANE transcript."
            },
            "transcript_allele_count": {
              "type": "integer",
              "description": "How many transcript alleles the registry holds for this allele"
            },
            "transcript_alleles": {
              "type": "array",
              "description": "Per-transcript representations, capped at TRANSCRIPTS_PER_ALLELE (25)",
              "items": {
                "type": "object",
                "properties": {
                  "hgvs": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The transcript-level HGVS (c.) expression"
                  },
                  "hgvs_all": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every HGVS spelling the registry lists for this transcript"
                  },
                  "gene_symbol": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC symbol of the gene this transcript belongs to"
                  },
                  "gene_ncbi_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "NCBI Gene ID of that gene"
                  },
                  "gene_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "protein_hgvs": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The protein consequence (p.) on this transcript"
                  },
                  "protein_hgvs_well_defined": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "coordinates": {
                    "type": "array",
                    "description": "Where the allele sits in this reference sequence and what it replaces",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "reference_allele": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "allele": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "start_intron_offset": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "Offset into the intron from `start`. When set, the position is start-offset or start+offset per start_intron_direction, not `start` itself."
                        },
                        "start_intron_direction": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "'-' or '+': which way the offset runs from the exon boundary"
                        },
                        "end_intron_offset": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end_intron_direction": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "is_intronic": {
                          "type": "boolean",
                          "description": "True when either offset is set, i.e. `start`/`end` alone do not name the position"
                        }
                      }
                    }
                  },
                  "reference_sequence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mane_status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "'MANE Select' or 'MANE Plus Clinical' when this is a MANE transcript, else null"
                  },
                  "mane_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mane_refseq_hgvs": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The MANE RefSeq c. expression, the clinically standard representation"
                  },
                  "mane_ensembl_hgvs": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mane_refseq_protein_hgvs": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mane_ensembl_protein_hgvs": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "transcript_alleles_truncated": {
              "type": "boolean",
              "description": "True when transcript_allele_count exceeds the cap"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ClinGenAR_get_external_records",
    "description": "Get detailed cross-references and external database records for a ClinGen canonical allele. Takes a ClinGen allele ID (CA ID) and returns links to ClinVar, dbSNP, COSMIC, gnomAD, ExAC, and other databases. Useful for finding all known database entries for a given variant. Example: CA000387 (TP53 R248Q) returns ClinVar variation IDs, COSMIC IDs, dbSNP rsIDs, and gnomAD allele frequencies.",
    "parameter": {
      "type": "object",
      "properties": {
        "allele_id": {
          "type": "string",
          "description": "ClinGen canonical allele ID. Examples: 'CA000387' (TP53 R248Q), 'CA006116' (BRCA1 variant). Use ClinGenAR_lookup_allele first to get the CA ID."
        }
      },
      "required": [
        "allele_id"
      ]
    },
    "fields": {
      "endpoint": "get_external_records"
    },
    "type": "ClinGenARTool",
    "test_examples": [
      {
        "allele_id": "CA000387"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allele_id": {
              "type": "string",
              "description": "ClinGen canonical allele ID"
            },
            "community_standard_title": {
              "type": [
                "string",
                "null"
              ],
              "description": "Standardized variant title"
            },
            "databases": {
              "type": "object",
              "description": "External database records keyed by database name (ClinVarAlleles, ClinVarVariations, dbSNP, COSMIC, gnomAD_2, gnomAD_3, gnomAD_4, ExAC, MyVariantInfo_hg19, MyVariantInfo_hg38). Each record carries every key that database sent, snake_cased, with `@id` as `url` and an `id` filled from whichever key names the identifier (dbSNP sends `rs`, ClinVar alleles `alleleId`, ClinVar variations `variationId`)."
            },
            "database_count": {
              "type": "integer",
              "description": "Number of external databases with records"
            },
            "record_count": {
              "type": "integer",
              "description": "Total external records across all databases"
