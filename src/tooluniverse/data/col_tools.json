[
  {
    "name": "CoL_search_species",
    "description": "Search the Catalogue of Life (CoL) for species and other taxa by scientific name. CoL is the global index of all known species, compiled from 165+ taxonomic databases covering ~2 million species. Returns taxon IDs, accepted names, ranks, classification hierarchy, and taxonomic status. Use rank parameter to filter by taxonomic level (species, genus, family, order, class, phylum, kingdom).",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Scientific name to search for (e.g., 'Homo sapiens', 'Panthera leo', 'Arabidopsis thaliana')"
        },
        "rank": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by taxonomic rank: 'species', 'genus', 'family', 'order', 'class', 'phylum', 'kingdom'"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 10,
          "description": "Maximum number of results to return (default 10, max 1000)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://api.catalogueoflife.org/dataset/3LR/nameusage/search",
      "pagination": "col_offset"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "Homo sapiens",
        "rank": "species"
      },
      {
        "q": "Panthera",
        "rank": "genus",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Catalogue of Life search results",
          "properties": {
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total matches, not the number returned."
            },
            "offset": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Index of the first row returned."
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Page size that was applied."
            },
            "result": {
              "type": "array",
              "description": "The matching name usages.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Catalogue of Life id for the usage."
                  },
                  "group": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "CoL's broad group for the taxon, e.g. 'Mammals'."
                  },
                  "sectorDatasetKey": {
                    "description": "Which source dataset CoL took this usage from."
                  },
                  "sectorPublisherKey": {
                    "description": "Publisher of that source dataset."
                  },
                  "vernacularNames": {
                    "description": "Common names, with their language where CoL records one."
                  },
                  "usage": {
                    "type": "object",
                    "description": "The name usage itself: the name, its nomenclatural status and its place in the tree, plus CoL's provenance for the record.",
                    "additionalProperties": {
                      "description": "One field of CoL's usage record; the set varies by rank and by source dataset."
                    }
                  },
                  "classification": {
                    "type": "array",
                    "description": "The full lineage from domain down, in order. Each entry is a rank, not just a name - without 'rank' and 'status' a caller cannot tell a genus from a family or an accepted name from a synonym.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "CoL id of the ancestor."
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Scientific name, e.g. 'Eukaryota'."
                        },
                        "authorship": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Naming authority and year, e.g. '(Chatton, 1925) Whittaker & Margulis, 1978'. Part of the formal name: two taxa can share a name and differ by authorship."
                        },
                        "rank": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Taxonomic rank, e.g. 'domain', 'genus', 'species'."
                        },
                        "status": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Nomenclatural status, e.g. 'accepted', 'synonym'."
                        },
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Name and authorship joined, as CoL displays it."
                        },
                        "labelHtml": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The same label with CoL's HTML markup."
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Which nomenclatural code governs the name at this rank, e.g. 'ZOOLOGICAL', 'BOTANICAL'. The code decides how the name and its authorship must be written and whether two identical names are the same taxon."
                        }
                      }
                    }
                  }
                }
              }
            },
            "empty": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when the page holds no rows. Checking 'result' is equivalent; CoL sends both."
            },
            "last": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when this is the final page, so paging can stop without another call."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "CoL_get_taxon",
    "description": "Get detailed taxonomic information for a specific taxon in the Catalogue of Life by its CoL ID. Returns full name details, accepted status, classification hierarchy, authorship, publication, and environments. Use CoL_search_species to find the CoL ID first.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "type": "string",
          "description": "CoL taxon ID (e.g., '6MB3T' for Homo sapiens, '64J67' for Panthera leo). Obtain from CoL_search_species."
        }
      },
      "required": [
        "taxon_id"
      ]
    },
    "fields": {
      "endpoint": "https://api.catalogueoflife.org/dataset/3LR/nameusage/{taxon_id}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "taxon_id": "6MB3T"
      },
      {
        "taxon_id": "64J67"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Detailed taxon information",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "name": {
              "type": "object",
              "properties": {
                "scientificName": {
                  "type": "string"
                },
                "rank": {
                  "type": "string"
                },
                "authorship": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "description": "Nomenclatural code: zoological, botanical, etc."
                },
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Catalogue of Life id for the usage."
                },
                "created": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "When CoL created the record, ISO 8601."
                },
                "createdBy": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "CoL user id that created it."
                },
                "datasetKey": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Which source dataset in CoL this record came from. The provenance of the name."
                },
                "link": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The source database's own page for this name, e.g. an ITIS SingleRpt URL. CoL aggregates, so this is where the record came from."
                },
                "modified": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "When CoL last changed the record, ISO 8601."
                },
                "modifiedBy": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "CoL user id that last changed it."
                },
                "origin": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "How the name entered CoL, e.g. 'SOURCE'."
                },
                "sectorKey": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "CoL sector the record belongs to."
                },
                "verbatimSourceKey": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Key of the verbatim source record, for tracing back to the original text."
                },
                "genus": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Genus part of the name."
                },
                "specificEpithet": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Species epithet."
                },
                "infraspecificEpithet": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Subspecies or variety epithet, where there is one."
                },
                "combinationAuthorship": {
                  "description": "Authorship of the current combination, as authors and a year. Differs from basionymAuthorship when a species has been moved between genera, and the difference is what the parentheses in a name mean."
                },
                "basionymAuthorship": {
                  "description": "Authorship of the original description."
                },
                "nomStatus": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Nomenclatural status of the name itself, e.g. 'established'. Distinct from the taxon's accepted/synonym status."
                },
                "parsed": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "Whether CoL could parse the name into its parts. False means the fields above are unreliable."
                },
                "namesIndexId": {
                  "type": [
                    "integer",
                    "null",
                    "string"
                  ],
                  "description": "Id in CoL's names index, which is how the same name is matched across datasets."
                },
                "namesIndexType": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "How the name matched the index, e.g. 'EXACT'."
                },
                "remarks": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "CoL's notes on the name."
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Name type, e.g. 'SCIENTIFIC'."
                },
                "labelHtml": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The name with CoL's HTML markup."
                }
              },
              "description": "The name record: the scientific name taken apart. A taxon's identity is its name PLUS its authorship and nomenclatural status, so the parsed parts are here rather than only the joined label."
            },
            "extinct": {
              "type": "boolean"
            },
            "environments": {
              "type": "array"
            },
            "parentId": {
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "Name and authorship joined, as CoL displays it."
            },
            "labelHtml": {
              "type": [
                "string",
                "null"
              ],
              "description": "The same label with CoL's HTML markup."
            },
            "created": {
              "type": [
                "string",
                "null"
              ],
              "description": "When CoL created the record, ISO 8601."
            },
            "createdBy": {
              "type": [
                "integer",
                "null"
              ],
              "description": "CoL user id that created it."
            },
            "datasetKey": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Which source dataset in CoL this record came from. The provenance of the name."
            },
            "link": {
              "type": [
                "string",
                "null"
              ],
              "description": "The source database's own page for this name, e.g. an ITIS SingleRpt URL. CoL aggregates, so this is where the record came from."
            },
            "modified": {
              "type": [
                "string",
                "null"
              ],
              "description": "When CoL last changed the record, ISO 8601."
            },
            "modifiedBy": {
              "type": [
                "integer",
                "null"
              ],
              "description": "CoL user id that last changed it."
            },
            "scrutinizer": {
              "type": [
                "string",
                "null"
              ],
              "description": "Who vetted the record."
            },
            "scrutinizerDate": {
              "type": [
                "string",
                "null"
              ],
              "description": "When it was vetted. An unvetted record is not wrong, but it is not vetted."
            },
            "sectorKey": {
              "type": [
                "integer",
                "null"
              ],
              "description": "CoL sector the record belongs to."
            },
            "verbatimSourceKey": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Key of the verbatim source record, for tracing back to the original text."
            },
            "referenceIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "CoL ids of the references behind the record. They are pointers: resolve them against CoL's reference endpoint to get the citations."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "CoL_get_children",
    "description": "Get immediate child taxa of a Catalogue of Life taxon through the official tree/{id}/children endpoint. The previous nameusage?parentId form silently ignored the parent and returned the whole Catalogue. Supports exact offset/limit continuation on non-empty pages.",
    "parameter": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "description": "CoL ID of the parent taxon whose children to retrieve (e.g., '636X2' for genus Homo, '623RM' for family Felidae). Obtain from CoL_search_species or CoL_get_taxon."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 10,
          "description": "Maximum number of children to return (default 10, max 1000)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "required": [
        "parentId"
      ]
    },
    "fields": {
      "endpoint": "https://api.catalogueoflife.org/dataset/3LR/tree/{parentId}/children",
      "pagination": "col_offset"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "parentId": "636X2",
        "limit": 10
      },
      {
        "parentId": "623RM",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Child taxa list",
          "properties": {
            "total": {
              "type": "integer",
              "description": "Total number of child taxa"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "result": {
              "type": "array",
              "description": "List of child taxa",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "CoL taxon ID of the child"
                  },
                  "name": {
                    "type": "string"
                  },
                  "rank": {
                    "type": "string"
                  },
                  "authorship": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "description": "Taxonomic status: accepted, synonym"
                  },
                  "label": {
                    "type": "string",
                    "description": "Formatted name with authorship"
                  },
                  "parentId": {
                    "type": "string",
                    "description": "Parent taxon ID"
                  },
                  "childCount": {
                    "type": "integer"
                  },
                  "labelHtml": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The same label with CoL's HTML markup."
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of children below this child, where CoL reports it. Zero at the leaves."
                  },
                  "datasetKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Which source dataset the child record came from."
                  }
                }
              }
            },
            "empty": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when the page holds no rows. Checking 'result' is equivalent; CoL sends both."
            },
            "last": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when this is the final page, so paging can stop without another call."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
