[
  {
    "name": "AllenCellTypes_search_specimens",
    "description": "Search Allen Cell Types neuron specimens with exact RMA row pagination. Filter by donor species and/or brain structure; metadata reports total_available, has_more and next_start_row so records after the default page remain reachable. Returns electrophysiology, donor, structure and reconstruction metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Donor species: 'Homo Sapiens' or 'Mus musculus'."
        },
        "structure": {
          "type": [
            "string",
            "null"
          ],
          "description": "Brain structure name substring, e.g. 'frontal gyrus', 'visual cortex'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 20,
          "description": "Specimens per page (1-2000)."
        },
        "start_row": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based RMA offset. Continue with metadata.next_start_row."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fields": {
      "timeout": 30
    },
    "type": "AllenCellTypesSpecimensTool",
    "test_examples": [
      {
        "species": "Homo Sapiens",
        "limit": 5
      },
      {
        "species": "Mus musculus",
        "limit": 3
      },
      {
        "structure": "frontal gyrus",
        "limit": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "specimen_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "specimen_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sex": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "age": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "disease_state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "brain_structure": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "transgenic_line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "avg_firing_rate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "input_resistance": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tau": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upstroke_downstroke_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "has_reconstruction": {
                "type": "boolean"
              },
              "donor_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Which brain the neuron came from; two specimens sharing it are from one donor"
              },
              "donor_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The donor's label, e.g. H15.06.016"
              },
              "donor_race": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Donor's reported race, for human specimens"
              },
              "years_of_seizure_history": {
                "type": [
                  "null",
                  "string"
                ],
                "description": "Years of seizure history, for human epilepsy resections"
              },
              "cortical_layer": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Layer within the structure; layer 3 and layer 5 pyramidal neurons are different cell types"
              },
              "structure_acronym": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Structure abbreviation, e.g. IFG"
              },
              "structure_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Allen structure id"
              },
              "hemisphere": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which hemisphere the specimen came from"
              },
              "soma_location": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "x": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "x"
                  },
                  "y": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "y"
                  },
                  "z": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "z"
                  },
                  "normalized": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ],
                    "description": "Normalized position where given"
                  }
                },
                "description": "Position in the common coordinate framework. Per cell for mouse; coarser for human, where it identifies the tissue block rather than the individual cell"
              },
              "resting_potential_mv": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Resting membrane potential in mV"
              },
              "rheobase_pa": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Minimum long-square current evoking a spike, in pA"
              },
              "adaptation_index": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Spike-frequency adaptation index"
              },
              "f_i_curve_slope": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Slope of the firing-rate versus current curve"
              },
              "avg_interspike_interval_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Mean interspike interval in ms"
              },
              "fast_trough_mv": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Fast trough voltage in mV"
              },
              "ramp_peak_time_s": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Time to peak on the ramp stimulus, in s"
              },
              "dendrite_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "spiny or aspiny - the standard morphological proxy for excitatory versus inhibitory"
              },
              "apical_dendrite": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Whether the apical dendrite is intact or truncated, which bounds what the reconstruction supports"
              },
              "reconstruction_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Kind of morphological reconstruction, where one exists"
              },
              "model_counts": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "glif": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "GLIF models"
                  },
                  "biophysical_perisomatic": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Perisomatic biophysical models"
                  },
                  "biophysical_all_active": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "All-active biophysical models"
                  }
                },
                "description": "How many models the Allen Institute fit to this cell"
              }
            },
            "required": [
              "specimen_id",
              "specimen_name",
              "species",
              "sex",
              "age",
              "disease_state",
              "brain_structure",
              "transgenic_line",
              "avg_firing_rate",
              "input_resistance",
              "tau",
              "upstroke_downstroke_ratio",
              "has_reconstruction"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
