                            "journal": {
                              "type": "string"
                            },
                            "year": {
                              "type": "string"
                            },
                            "article-id_pmc": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            },
                            "authors": {
                              "type": "string"
                            }
                          }
                        },
                        "offset": {
                          "type": [
                            "integer",
                            "number"
                          ]
                        },
                        "text": {
                          "type": "string"
                        },
                        "sentences": {
                          "type": "array"
                        },
                        "annotations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "infons": {
                                "type": "object",
                                "properties": {
                                  "identifier": {
                                    "type": "string"
                                  },
                                  "type": {
                                    "type": "string"
                                  },
                                  "valid": {
                                    "type": "boolean"
                                  },
                                  "normalized": {
                                    "type": "array",
                                    "items": {
                                      "type": [
                                        "integer",
                                        "number",
                                        "string"
                                      ]
                                    }
                                  },
                                  "database": {
                                    "type": "string"
                                  },
                                  "normalized_id": {
                                    "type": [
                                      "integer",
                                      "number",
                                      "string"
                                    ]
