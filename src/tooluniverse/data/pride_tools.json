[
  {
    "type": "PRIDERESTTool",
    "name": "PRIDE_search_proteomics",
    "description": "Search PRIDE proteomics projects with explicit zero-based page pagination. Metadata preserves PRIDE's total_records header and reports truncation and next_page.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search keywords for proteomics experiments. Examples: 'cancer', 'phosphorylation', 'liver proteome', 'COVID-19'. Searches across project titles, descriptions, species, and tissues."
        },
        "page_size": {
          "type": "integer",
          "default": 20,
          "description": "Number of projects to return per page (default: 20, max: 100)"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based page number. Continue with metadata.next_page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/pride/ws/archive/v2/search/projects?keyword={query}",
      "return_format": "JSON"
    },
    "return_schema": {
      "type": "array",
      "description": "Array of PRIDE project search results.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "accession": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "projectDescription": {
            "type": "string"
          },
          "organisms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organismParts": {
            "type": "array"
          },
          "diseases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submissionDate": {
            "type": "string"
          },
          "publicationDate": {
            "type": "string"
          },
          "submitters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projectTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experimentTypes": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Experiment types as PRIDE controlled-vocabulary terms, each with cvLabel, accession and name."
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Publications for the project, each with a referenceLine and its identifiers."
          },
          "sampleAttributes": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Sample characteristics as key/value pairs of ontology terms - organism, tissue, disease and the rest."
          },
          "submissionType": {
            "type": [
              "string",
              "null"
            ],
            "description": "'COMPLETE' or 'PARTIAL'. A PARTIAL submission has no search results attached, so what can be done with the project depends on this."
          },
          "affiliations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Submitting institutions, e.g. ['UKSH Kiel, Germany']."
          },
          "avgDownloadsPerFile": {
            "type": [
              "number",
              "null"
            ],
            "description": "Downloads averaged per file, when carried."
          },
          "dataProcessingProtocol": {
            "type": [
              "string",
              "null"
            ],
            "description": "How the data were processed, including the quantification scale - 'NPX, log2 scale' on this project, which changes what the numbers mean."
          },
          "doi": {
            "type": [
              "string",
              "null"
            ],
            "description": "The project's DOI, e.g. '10.6019/PAD000072'. The citable handle, and it was not in the search result."
          },
          "downloadCount": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Total downloads, when PRIDE's search index carries it."
          },
          "highlights": {
            "description": "The search terms' matches within the project's text fields, keyed by field. This is what explains WHY a project matched the query."
          },
          "labPIs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Principal investigators."
          },
          "organismsPart": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tissues or sample parts, e.g. ['Cell culture']."
          },
          "percentile": {
            "description": "PRIDE's relevance percentile for the hit within the result set."
          },
          "projectFileNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the project's files, so a search result shows what is actually downloadable."
          },
          "quantificationMethods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Quantification methods used. Empty when the project declares none."
          },
          "sampleProcessingProtocol": {
            "type": [
              "string",
              "null"
            ],
            "description": "How the samples were prepared, in the submitters' words."
          },
          "sdrf": {
            "description": "The project's SDRF sample-and-data-relationship file, when one was submitted."
          },
          "softwares": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Software used in the analysis. Empty when the project declares none."
          },
          "updatedDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the project was last updated, YYYY-MM-DD."
          }
        }
      }
    },
    "test_examples": [
      {
        "query": "cancer",
        "page_size": 5
      },
      {
        "query": "COVID-19",
        "page_size": 10
      }
    ]
  },
  {
    "type": "PRIDERESTTool",
    "name": "PRIDE_get_project",
    "description": "Get comprehensive details for a specific PRIDE Archive project by its accession ID. Returns complete project metadata including experimental design, sample information, instruments used, data processing methods, publication links, protein identifications, quantification data, and file download URLs. Use accession IDs from PRIDE_search_proteomics (format: PXD######).",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "PRIDE project accession identifier in format PXD###### (e.g., 'PXD000001', 'PXD012345'). Find accessions using PRIDE_search_proteomics."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/pride/ws/archive/v2/projects/{accession}",
      "return_format": "JSON"
    },
