  {
    "type": "PRIDERESTTool",
    "name": "PRIDE_get_project_files",
    "description": "Get the complete list of data files for a PRIDE Archive project including raw mass spectrometry files, search results, FASTA databases, and supplementary data. Returns file metadata with names, types, sizes, FTP/Aspera download URLs, and checksums. Essential for downloading proteomics datasets for reanalysis or integration. Use accession from PRIDE_search_proteomics.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "PRIDE project accession identifier (format: PXD######, e.g., 'PXD000001'). Find accessions using PRIDE_search_proteomics."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/pride/ws/archive/v2/projects/{accession}/files",
      "return_format": "JSON"
    },
    "return_schema": {
      "type": "array",
      "description": "List of project files with download URLs and metadata.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "projectAccessions": {
            "type": "array"
          },
          "accession": {
            "type": "string"
          },
          "fileCategory": {
            "type": "object"
          },
          "fileName": {
            "type": "string"
          },
          "fileSize": {
            "type": "object"
          },
          "publicFileLocations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "@type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The term's type, 'CvParam' for a controlled-vocabulary term."
                },
                "accession": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Accession of the location type in PRIDE's vocabulary, e.g. 'PRIDE:0000469' for an FTP protocol."
                },
                "cvLabel": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Which vocabulary the accession is from, e.g. 'PRIDE'."
                }
              }
            }
          },
          "checksum": {
            "type": [
              "string",
              "null"
            ],
            "description": "Checksum of the file, empty string when PRIDE records none. The means of verifying a download - and when it is empty, that itself is worth seeing."
          },
          "compress": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the file is compressed."
          },
          "fileSizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Size in bytes, e.g. 497985. Needed before downloading and absent from the row."
          },
          "publicationDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it became public, ISO 8601."
          },
          "submissionDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the file was submitted, ISO 8601."
          },
          "totalDownloads": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Times this file has been downloaded, e.g. 701."
          },
          "updatedDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it last changed, ISO 8601."
          }
        }
      }
    },
    "test_examples": [
      {
        "accession": "PXD000001"
      },
      {
        "accession": "PXD012345"
      }
    ]
  },
  {
    "type": "PRIDERESTTool",
    "name": "PRIDE_get_projects_for_protein",
    "description": "Reverse lookup: list every PRIDE Archive project (PXD accession) that identified a given protein, keyed by UniProt accession. PRIDE's other tools are project-centric (search/get/files) and cannot answer 'which proteomics datasets contain protein X' - this tool fills that gap. Given a UniProt accession (e.g., 'P38398' for BRCA1, 'P04637' for TP53), returns the protein accession and the full list of PXD project accessions where it was reported. Use the returned PXD IDs with PRIDE_get_project or PRIDE_get_project_files for details.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt protein accession (e.g., 'P38398' for BRCA1, 'P04637' for TP53, 'P00533' for EGFR). Returns every PRIDE project that identified this protein."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/pride/ws/archive/v2/proteins/{accession}",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "proteinAccession": {
              "type": "string",
              "description": "UniProt accession queried (echoed back by PRIDE)"
            },
            "projects": {
              "type": "array",
              "description": "List of PRIDE project accessions (PXD######) that identified this protein",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "proteinAccession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "accession": "P38398"
      },
      {
        "accession": "P04637"
      }
    ]
  }
]
