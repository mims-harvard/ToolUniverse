[
  {
    "name": "NASACMR_search_collections",
    "description": "Search NASA CMR for Earth-observation collections. Results use exact one-based CMR pagination: start with page=1 and continue with metadata.next_page while metadata.has_more is true; metadata.total_results comes from the CMR-Hits response header. Returns titles, summaries, temporal coverage, data centers, processing levels, and links.",
    "parameter": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "Free-text keyword search. Examples: 'sea surface temperature', 'land cover', 'atmospheric CO2', 'Arctic sea ice', 'precipitation', 'vegetation index NDVI'"
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2000,
          "default": 10,
          "description": "Collections per page (default 10, max 2000)"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based CMR page number. Continue with metadata.next_page."
        },
        "data_center": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by data center short name. Examples: 'NSIDC', 'PODAAC', 'GES_DISC', 'LAADS', 'LP DAAC'"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by satellite/instrument platform. Examples: 'Terra', 'Aqua', 'Landsat-8', 'GOES-16', 'ICESat-2'"
        }
      },
      "required": [
        "keyword"
      ]
    },
    "fields": {
      "endpoint": "https://cmr.earthdata.nasa.gov/search/collections.json",
      "param_mapping": {
        "page": "page_num"
      },
      "pagination": "cmr_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "keyword": "sea surface temperature",
        "page_size": 5
      },
      {
        "keyword": "Arctic sea ice",
        "page_size": 5
      },
      {
        "keyword": "vegetation NDVI",
        "page_size": 5,
        "data_center": "LP DAAC"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "description": "NASA CMR collection search results",
          "properties": {
            "feed": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "updated": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "entry": {
                  "type": "array",
                  "description": "List of matching dataset collections",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "CMR concept ID (e.g., 'C2036882064-POCLOUD')"
                      },
                      "title": {
                        "type": "string",
                        "description": "Dataset collection title"
                      },
                      "dataset_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "summary": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Dataset description"
                      },
                      "short_name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Short identifier"
                      },
                      "version_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "time_start": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Temporal coverage start"
                      },
                      "time_end": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Temporal coverage end"
                      },
                      "data_center": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Hosting data center"
                      },
                      "processing_level_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Processing level (0-4)"
                      },
                      "cloud_hosted": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "online_access_flag": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "platforms": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": [
                            "string",
                            "object"
                          ]
                        }
                      },
                      "links": {
                        "type": [
                          "array",
                          "null"
                        ]
                      },
                      "archive_center": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The DAAC that archives the collection, e.g. 'NASA/JPL/PODAAC'. Which centre to approach for the data, and it is not always the same as data_center."
                      },
                      "association_details": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "The concept ids of the variables, services, tools and citations associated with the collection - the ids needed to request any of them."
                      },
                      "associations": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "The same associations as counts and id lists, keyed 'variables', 'services', 'tools', 'citations'."
                      },
                      "boxes": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "description": "The collection's bounding boxes as 'south west north east' strings, e.g. ['-90 -180 90 180'] for global coverage. The spatial extent, which nothing else in the row states."
                      },
                      "browse_flag": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when the collection has browse imagery - a preview that can be shown without downloading the data."
                      },
                      "consortiums": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "description": "Programmes the collection belongs to, e.g. ['GEOSS', 'EOSDIS']."
                      },
                      "coordinate_system": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "How the collection's spatial extent is expressed, e.g. 'CARTESIAN' or 'GEODETIC'. Reading a box without it gives wrong geometry near the poles."
                      },
                      "entry_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The collection's versioned entry id, e.g. 'OSTIA-UKMO-L4-GLOB-REP-v2.0_2.0' - short_name and version_id joined. The identifier CMR's own documentation cites."
                      },
                      "has_combine": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when granules can be concatenated server-side."
                      },
                      "has_formats": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when a service can convert the data to another format on request."
                      },
                      "has_spatial_subsetting": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when a spatial subset can be requested, so a region can be fetched without the globe."
                      },
                      "has_temporal_subsetting": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when a time subset can be requested."
                      },
                      "has_transforms": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when regridding or reprojection is offered."
                      },
                      "has_variables": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when individual variables can be requested instead of whole granules."
                      },
                      "organizations": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "description": "Every organisation CMR records for the collection, e.g. ['NASA/JPL/PODAAC', 'UKMO']. Producer and archiver together, which the two single-valued centre fields separate but do not list."
                      },
                      "original_format": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The metadata format the collection was supplied in, e.g. 'UMM_JSON', 'DIF10', 'ECHO10'. Whether a field is missing because it was not supplied or because the source format has no slot for it."
                      },
                      "score": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "CMR's relevance score for the hit, e.g. 1.5840001. Results are ordered by it, so without it the ranking cannot be reproduced or a weak match spotted."
                      },
                      "service_features": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "The same capabilities broken out per service - 'harmony', 'opendap' and 'esi', each with its own has_formats/has_variables/has_subsetting flags. The has_* flags above are the union, so they do not say which service provides what."
                      },
                      "updated": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "When the collection's metadata was last revised, e.g. '2017-04-28T05:01:46.000Z'."
                      },
                      "collection_data_type": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "How the collection is graded, e.g. 'SCIENCE_QUALITY'. Separates a science-quality product from a near-real-time or expedited one, which is the difference between data fit for publication and data fit for monitoring. Measured present on 1 of 5 entries, so its absence is not a statement about the collection."
                      },
                      "dif_ids": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "description": "The collection's ids in other catalogues, e.g. ['EO:EUM:DAT:SENTINEL-3:SL_2_WST___NRT_2017-07-05']. How a NASA CMR collection is matched to the same product in a partner archive. Measured present on 2 of 5 entries."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "NASACMR_search_granules",
    "description": "Search NASA CMR for individual granules. Results use exact one-based CMR pagination: start with page=1 and continue with metadata.next_page while metadata.has_more is true; metadata.total_results comes from the CMR-Hits header. Filter by collection, time, or bounding box and retrieve download/spatial metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "concept_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Parent collection concept ID (e.g., 'C2036882064-POCLOUD'). Get from NASACMR_search_collections."
        },
        "short_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Collection short name (e.g., 'MYD11A1', 'MODIS_A-JPL-L2P-v2019.0')"
        },
        "temporal": {
          "type": [
            "string",
            "null"
          ],
          "description": "Temporal range in format 'YYYY-MM-DD,YYYY-MM-DD'. Examples: '2020-01-01,2020-01-31', '2023-06-01,2023-06-30'"
        },
        "bounding_box": {
          "type": [
            "string",
            "null"
          ],
          "description": "Spatial bounding box: 'west,south,east,north' in decimal degrees. Example: '-10,35,10,55' for Western Europe"
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2000,
          "default": 10,
          "description": "Granules per page (default 10, max 2000)"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based CMR page number. Continue with metadata.next_page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://cmr.earthdata.nasa.gov/search/granules.json",
      "param_mapping": {
        "page": "page_num"
      },
      "pagination": "cmr_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "concept_id": "C2036882064-POCLOUD",
        "temporal": "2020-01-01,2020-01-03",
        "page_size": 5
      },
      {
        "short_name": "GRACE-FO_L3_MASCON_GRID_RL06_v04",
        "page_size": 3
      },
      {
        "concept_id": "C2799438271-NSIDC_CPRD",
        "temporal": "2023-01-01,2023-01-07",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "description": "NASA CMR granule search results",
          "properties": {
            "feed": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "entry": {
                  "type": "array",
                  "description": "List of matching data granules",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Granule concept ID"
                      },
                      "title": {
                        "type": "string",
                        "description": "Granule title/filename"
                      },
                      "time_start": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "time_end": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "dataset_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "collection_concept_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "links": {
                        "type": "array",
                        "description": "Download and metadata links",
                        "items": {
                          "type": "object",
                          "properties": {
                            "rel": {
                              "type": "string"
                            },
                            "href": {
                              "type": "string"
                            },
                            "type": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "title": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "hreflang": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Language of the linked resource, e.g. 'en-US'."
                            },
                            "inherited": {
                              "type": [
                                "boolean",
                                "null"
                              ],
                              "description": "True when the link came from the parent collection rather than this granule. Measured on 44 of 54 links - an inherited link may not resolve to this granule's own data."
                            },
                            "length": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Size of the linked file as a STRING with its unit, e.g. '0.0MB'. Measured on only 4 of 54 links."
                            }
                          }
                        }
                      },
                      "boxes": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "description": "The collection's bounding boxes as 'south west north east' strings, e.g. ['-90 -180 90 180'] for global coverage. The spatial extent, which nothing else in the row states."
                      },
                      "browse_flag": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when the collection has browse imagery - a preview that can be shown without downloading the data."
                      },
                      "coordinate_system": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "How the collection's spatial extent is expressed, e.g. 'CARTESIAN' or 'GEODETIC'. Reading a box without it gives wrong geometry near the poles."
                      },
                      "data_center": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Hosting data center"
                      },
                      "original_format": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The metadata format the collection was supplied in, e.g. 'UMM_JSON', 'DIF10', 'ECHO10'. Whether a field is missing because it was not supplied or because the source format has no slot for it."
                      },
                      "updated": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "When the collection's metadata was last revised, e.g. '2017-04-28T05:01:46.000Z'."
                      },
                      "day_night_flag": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Whether the granule was acquired by day, by night, or both, e.g. 'UNSPECIFIED', 'DAY', 'NIGHT'. For optical instruments a night granule holds no usable reflectance."
                      },
                      "granule_size": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Size of the granule in megabytes, as a STRING, e.g. '14.350640296936033'. Needs converting before it can be summed to a download budget."
                      },
                      "online_access_flag": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "True when the granule can be downloaded directly rather than ordered."
                      }
                    }
                  }
                },
                "updated": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "When the collection's metadata was last revised, e.g. '2017-04-28T05:01:46.000Z'."
                },
                "id": {
                  "type": "string",
                  "description": "CMR concept ID (e.g., 'C2036882064-POCLOUD')"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
