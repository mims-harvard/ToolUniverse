  {
    "name": "LipidMaps_get_protein",
    "description": "Look up a lipid-metabolism protein/enzyme in LIPID MAPS LMPD, including gene/species identifiers, UniProt and RefSeq cross-references, protein name, sequence length, and sequence. Gene-symbol queries may match multiple species; all rows are returned in numeric Row order with explicit unpaginated completeness metadata. Input/output namespaces are strictly validated and malformed rows cannot become a silent partial success. Use output_item='all' for the complete record.",
    "parameter": {
      "type": "object",
      "properties": {
        "input_value": {
          "type": "string",
          "minLength": 1,
          "description": "The protein identifier value to resolve, e.g. 'P49327' (UniProt), 'NP_004095' (RefSeq protein), 'SCD' (gene symbol), or 'LMP002507' (LIPID MAPS protein id)."
        },
        "input_item": {
          "type": "string",
          "description": "Namespace of input_value. One of: 'uniprot_id', 'gene_symbol', 'gene_id', 'gene_name', 'refseq_id', 'mrna_id', 'protein_entry', 'lmp_id'.",
