[
  {
    "name": "LipidMaps_get_gene",
    "description": "Look up a lipid-metabolism gene in the LIPID MAPS Proteome Database (LMPD). A gene symbol can match multiple species; the REST endpoint returns the full unpaginated set and metadata marks result_set_complete. For example, live FASN lookup returns mouse, human, rat, and cow records. Input and output namespaces are strictly validated, URL path values are encoded, and malformed rows are errors rather than silently dropped. Use output_item='all' for complete records; metadata.field_scope_complete is false for an intentionally selected single-field response.",
    "parameter": {
      "type": "object",
      "properties": {
        "input_value": {
          "type": "string",
          "minLength": 1,
          "description": "The gene identifier value to resolve, e.g. 'FASN' (gene symbol), '2194' (NCBI Gene ID), or 'LMP002507' (LIPID MAPS protein id)."
        },
        "input_item": {
          "type": "string",
          "description": "Namespace of input_value. One of: 'gene_symbol', 'gene_id', 'gene_name', 'lmp_id'.",
          "enum": [
            "gene_symbol",
            "gene_id",
            "gene_name",
            "lmp_id"
          ],
          "default": "gene_symbol"
        },
        "output_item": {
          "type": "string",
          "description": "Which fields to return. 'all' (default) returns the complete record; a single field name (e.g. 'gene_name', 'summary', 'chromosome') returns just that field.",
          "enum": [
            "all",
            "lmp_id",
            "gene_id",
            "gene_name",
            "gene_symbol",
            "gene_synonyms",
            "alt_names",
            "chromosome",
            "map_location",
            "summary",
            "taxid",
            "species",
            "species_long"
          ],
          "default": "all"
        }
      },
      "required": [
        "input_value"
      ]
    },
    "fields": {
      "context": "gene",
      "input_item": "gene_symbol"
    },
    "type": "LipidMapsGeneTool",
    "test_examples": [
      {
        "input_value": "FASN",
        "input_item": "gene_symbol"
      },
      {
        "input_value": "2194",
        "input_item": "gene_id"
      },
      {
        "input_value": "LMP002507",
        "input_item": "lmp_id"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
