[
  {
    "name": "SwissModel_get_models",
    "description": "Get a paginated list of protein structures from SWISS-MODEL Repository for a UniProt accession. Results include homology models and experimental PDB structures, template, coverage, quality scores, coordinates URL, and complete complex-partner lists. Use next_offset while has_more is true; model_count is the total after optional range/provider/template filters.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_id": {
          "type": "string",
          "description": "UniProt accession identifier. Examples: 'P04637' (human p53), 'P00533' (human EGFR), 'Q9Y6I3' (human EPN1)."
        },
        "range": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional residue range filter; only models covering this range are returned. Format 'from-to', e.g. '94-312'."
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional model-provider filter. 'swissmodel' returns only SWISS-MODEL homology models; 'pdb' returns only experimental PDB structures. Omit for both.",
          "enum": [
            "swissmodel",
            "pdb",
            null
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional template filter; restrict results to models built from this template (PDB ID, optionally with chain, e.g. '2j6m.1.A')."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 30,
          "description": "Maximum models to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based model offset. Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "uniprot_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_models"
    },
    "type": "SwissModelTool",
    "test_examples": [
      {
        "uniprot_id": "P04637"
      },
      {
        "uniprot_id": "P04637",
        "range": "94-312"
      },
      {
        "uniprot_id": "P04637",
        "provider": "swissmodel"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_id": {
              "type": "string"
            },
            "sequence_length": {
              "type": [
                "integer",
                "null"
              ]
            },
            "crc64": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_count": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": ["integer", "null"]
            },
            "filters_applied": {
              "type": "object"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "template": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "coverage": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "from_residue": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "to_residue": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "created_date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "provider": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "coordinates_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "qmean_global": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "qmean_z_score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SwissModel_get_summary",
    "description": "Get a summary of the best available homology model from SWISS-MODEL Repository for a UniProt accession. Returns the model with highest sequence coverage, total model count, methods distribution, and quality metrics. Useful for quickly checking if a homology model exists for a protein of interest. Example: P04637 (human p53) has 4 models, best covers residues 12-351 (86.5% coverage).",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_id": {
          "type": "string",
          "description": "UniProt accession identifier. Examples: 'P04637' (human p53), 'P00533' (human EGFR)."
        }
      },
      "required": [
        "uniprot_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_model_summary"
    },
    "type": "SwissModelTool",
    "test_examples": [
      {
        "uniprot_id": "P04637"
      },
      {
        "uniprot_id": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_id": {
              "type": "string"
            },
            "sequence_length": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total_models": {
              "type": "integer"
            },
            "best_model": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "template": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "coverage": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "from_residue": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "to_residue": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "created_date": {
                  "type": "string"
                },
                "coordinates_url": {
                  "type": "string"
                },
                "qmean_global": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "methods_distribution": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SwissModel_download_pdb",
    "description": "Download the actual 3D atomic coordinates (PDB format) of SWISS-MODEL Repository structures for a UniProt accession. Unlike SwissModel_get_models / SwissModel_get_summary (which return only JSON metadata and a coordinates URL), this tool fetches the real ATOM/HETATM records and returns them as text. Optional selectors: 'sort' ('seqid' = sequence identity, or 'seqsim' = sequence similarity) orders the bundled models; 'provider' restricts to 'swissmodel' (homology models) or 'pdb' (experimental structures); 'template' selects a specific template; 'range' restricts to models covering a residue range. Example: P04637 (human p53) returns ~5.5 MB of coordinates; provider=swissmodel isolates the homology model with a SWISS-MODEL TITLE header. Use the returned 'pdb_content' for structural analysis, visualization, or docking.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_id": {
          "type": "string",
          "description": "UniProt accession identifier. Examples: 'P04637' (human p53), 'P00533' (human EGFR)."
        },
        "sort": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ordering for the bundled models. 'seqid' sorts by sequence identity to the template, 'seqsim' by sequence similarity.",
          "enum": [
            "seqid",
            "seqsim",
            null
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional model-provider filter. 'swissmodel' = SWISS-MODEL homology models only; 'pdb' = experimental PDB structures only. Omit for all.",
          "enum": [
            "swissmodel",
            "pdb",
            null
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional template filter; download only models built from this template (PDB ID, optionally with chain)."
        },
        "range": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional residue range filter ('from-to', e.g. '94-312'); download only models covering this range."
        }
      },
      "required": [
        "uniprot_id"
      ]
    },
    "fields": {
      "endpoint_type": "download_pdb"
    },
    "type": "SwissModelTool",
    "test_examples": [
      {
        "uniprot_id": "P04637",
        "provider": "swissmodel"
      },
      {
        "uniprot_id": "P00533",
        "sort": "seqid"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uniprot_id": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "pdb_content": {
              "type": "string"
            },
            "atom_count": {
              "type": "integer"
            },
            "size_bytes": {
              "type": "integer"
            },
            "filters_applied": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SwissModel_get_models_batch",
    "description": "Batch SWISS-MODEL Repository lookup for up to 250 UniProt accessions in a single call. Each result exposes model_count, models_returned, has_more, and next_model_offset, so model lists beyond the default first 30 are recoverable using model_offset. The same offset window is applied independently to every requested accession. Example: P04637 has hundreds of structures that can be paged through without silent truncation.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of up to 250 UniProt accessions, e.g. ['P04637', 'P00533', 'P38398']. A comma-separated string is also accepted."
        },
        "model_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 30,
          "description": "Maximum models returned per accession (1-500; default 30)."
        },
        "model_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based model offset applied independently to each accession."
        }
      },
      "required": [
        "uniprot_ids"
      ]
    },
    "fields": {
      "endpoint_type": "get_models_batch"
    },
    "type": "SwissModelTool",
    "test_examples": [
      {
        "uniprot_ids": [
          "P04637",
          "P00533",
          "P38398"
        ]
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "requested_count": {
              "type": "integer"
            },
            "returned_count": {
              "type": "integer"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uniprot_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sequence_length": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "crc64": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "model_count": {
                    "type": "integer"
                  },
                  "model_offset": {"type": "integer"},
                  "model_limit": {"type": "integer"},
                  "models_returned": {"type": "integer"},
                  "has_more": {"type": "boolean"},
                  "next_model_offset": {
                    "type": ["integer", "null"]
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
