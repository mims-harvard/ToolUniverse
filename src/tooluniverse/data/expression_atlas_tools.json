  {
    "name": "ExpressionAtlas_get_experiment",
    "description": "Get metadata for a specific Expression Atlas experiment by accession (e.g., E-MTAB-2836): accession, type, species, and description/URLs. Caveat: the underlying GXA API does not expose per-experiment design/technology/contrasts/PubMed/assay-count data through this endpoint (confirmed live: those fields are always empty) -- for that level of detail, visit the experiment's page on https://www.ebi.ac.uk/gxa directly.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "Expression Atlas experiment accession (e.g., 'E-MTAB-2836', 'E-GEOD-26284')"
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "operation": "get_experiment"
    },
    "type": "ExpressionAtlasTool",
    "test_examples": [
      {
        "accession": "E-MTAB-2836"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "factors": {
              "type": "array"
            },
            "technology": {
              "type": "array"
            },
            "contrasts": {
              "type": "array"
            },
            "assay_count": {
              "type": "null"
            },
            "last_update": {
              "type": "null"
            },
            "pubmed_ids": {
              "type": "array"
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "Expression Atlas",
      "Experiment Detail"
    ],
    "metadata": {
