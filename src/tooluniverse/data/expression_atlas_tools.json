[
  {
    "name": "ExpressionAtlas_get_baseline",
    "description": "List baseline gene expression experiments in EBI Expression Atlas for a given species with recoverable offset pagination. Continue with next_offset while has_more is true. The `gene` argument labels the request but does NOT filter the experiment list; use GxA_get_experiment_expression with an experiment_accession and gene_id=<gene> for actual per-gene data. No API key needed.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., 'TP53', 'WDR7') or Ensembl ID (e.g., 'ENSG00000141510')"
        },
        "species": {
          "type": "string",
          "description": "Species name (default: 'homo sapiens'). Also supports 'mus musculus', 'rattus norvegicus', etc.",
          "default": "homo sapiens"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of experiments to return (default 50, max 500). Compare with the total reported in the response to see how many exist.",
          "default": 50
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Zero-based index of the first experiment to return, for paging through results beyond the first page (e.g. offset=50 returns 51-100). Default: 0.",
          "default": 0
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "operation": "get_baseline_expression"
    },
    "type": "ExpressionAtlasTool",
    "test_examples": [
      {
        "gene": "TP53",
        "species": "homo sapiens"
      },
      {
        "gene": "BRCA1"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "baseline_experiments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "experiment_accession": {
                    "type": "string"
                  },
                  "experiment_type": {
                    "type": "string"
                  },
                  "experiment_description": {
                    "type": "string"
                  },
                  "species": {
                    "type": "string"
                  },
                  "num_assays": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "last_update": {
                    "type": "string"
                  }
                }
              }
            },
            "total_baseline": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned_baseline": {"type": "integer"},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "result_set_complete": {"type": "boolean"}
          },
          "required": [
            "gene"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "Expression Atlas",
      "Baseline Expression",
      "Tissue Expression"
    ],
    "metadata": {
      "tags": [
        "gene_expression",
        "baseline",
        "tissue",
        "rna_seq",
        "proteomics"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
