[
  {
    "name": "SIDER_search_drug",
    "type": "SiderTool",
    "description": "Search the SIDER drug side effects database for a drug by name. Returns matching drugs with SIDER IDs and any related side effects. SIDER contains adverse drug reaction data extracted from drug labels for marketed medicines. Use this to find the SIDER drug ID needed for other SIDER operations (get_side_effects, get_indications).",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_drug"
          ],
          "description": "Operation type",
          "default": "search_drug"
        },
        "drug_name": {
          "type": "string",
          "description": "Drug name to search for (e.g., 'aspirin', 'ibuprofen', 'metformin', 'warfarin')"
        }
      },
      "required": [
        "drug_name"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query used"
        },
        "drugs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sider_drug_id": {
                "type": "string",
                "description": "SIDER internal drug ID (PubChem CID)"
              },
              "drug_name": {
                "type": "string",
                "description": "Drug name"
              },
              "url": {
                "type": "string",
                "description": "URL to drug page on SIDER"
              }
            }
          }
        },
        "related_side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meddra_code": {
                "type": "string",
                "description": "MedDRA concept code (UMLS CUI)"
              },
              "side_effect_name": {
                "type": "string",
                "description": "Side effect name"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "search_drug",
        "drug_name": "aspirin"
      },
      {
        "operation": "search_drug",
        "drug_name": "metformin"
      }
    ],
    "fields": {
      "operation": "search_drug"
    }
  },
  {
    "name": "SIDER_get_drug_side_effects",
    "type": "SiderTool",
    "description": "Get known side effects for one SIDER drug with exact, recoverable local pagination over the complete parsed drug page. metadata.total_matches is exact when source_parse_complete is true; continue with next_offset while has_more is true. Frequency values are label-derived, not incidence estimates for an unselected population. Provide exactly one of drug_name or sider_drug_id.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_side_effects"
          ],
          "description": "Operation type",
          "default": "get_side_effects"
        },
        "drug_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Drug name (e.g., 'ibuprofen', 'metformin'). Will search SIDER and use first match. Mutually exclusive with sider_drug_id."
        },
        "sider_drug_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "SIDER drug ID (PubChem CID) from SIDER_search_drug results (e.g., '3672' for ibuprofen, '4091' for metformin)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Maximum side effects on this page (default: 50)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the exact parsed side-effect set; continue with metadata.next_offset"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "drug_name": {
          "type": "string",
          "description": "Resolved drug name from SIDER"
        },
        "sider_drug_id": {
          "type": "string",
          "description": "SIDER drug ID"
        },
        "total_side_effects": {
          "type": "integer",
          "description": "Total number of side effects found"
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meddra_code": {
                "type": "string",
                "description": "MedDRA concept code (UMLS CUI, e.g., C0027497 for Nausea)"
              },
              "side_effect_name": {
                "type": "string",
                "description": "Side effect name"
              },
              "frequency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Reported frequency range (e.g., '21% - 57.5%' or '6%') or null if unavailable"
              },
              "placebo_frequency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Placebo group frequency if available"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "MedDRA concept description"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "get_side_effects",
        "drug_name": "ibuprofen",
        "limit": 10,
        "offset": 0
      },
      {
        "operation": "get_side_effects",
        "sider_drug_id": "4091",
        "limit": 10
      }
    ],
    "fields": {
      "operation": "get_side_effects"
    }
  },
  {
    "name": "SIDER_get_drug_indications",
    "type": "SiderTool",
    "description": "Get the therapeutic indications for a drug from SIDER. Indications are medical conditions that a drug is approved to treat, extracted from the indications and usage sections of drug labels. Returns MedDRA-coded conditions with descriptions. Provide either a drug name or SIDER drug ID.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_indications"
          ],
          "description": "Operation type",
          "default": "get_indications"
        },
        "drug_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Drug name (e.g., 'aspirin', 'metformin'). Will search SIDER and use first match."
        },
        "sider_drug_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "SIDER drug ID (PubChem CID) from SIDER_search_drug (e.g., '2244' for aspirin)"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "drug_name": {
          "type": "string",
          "description": "Resolved drug name from SIDER"
        },
        "sider_drug_id": {
          "type": "string",
          "description": "SIDER drug ID"
        },
        "total_indications": {
          "type": "integer",
          "description": "Total number of indications found"
        },
        "indications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meddra_code": {
                "type": "string",
                "description": "MedDRA concept code (UMLS CUI)"
              },
              "indication_name": {
                "type": "string",
                "description": "Indication name"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Medical description of the indication"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "get_indications",
        "drug_name": "aspirin"
      },
      {
        "operation": "get_indications",
        "sider_drug_id": "4091"
      }
    ],
    "fields": {
      "operation": "get_indications"
    }
  },
  {
    "name": "SIDER_get_drugs_for_side_effect",
    "type": "SiderTool",
    "description": "Find unique drugs associated with one SIDER side effect using exact, recoverable local pagination over the complete side-effect page. Duplicate source rows for one drug ID are merged without discarding distinct frequency strings; metadata exposes source_association_rows and duplicate_source_rows. Continue with next_offset while has_more is true. Provide exactly one of meddra_code or side_effect_name.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_drugs_for_side_effect"
          ],
          "description": "Operation type",
          "default": "get_drugs_for_side_effect"
        },
        "meddra_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "MedDRA concept code / UMLS CUI (e.g., 'C0018681' for headache, 'C0027497' for nausea)"
        },
        "side_effect_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Side effect name to search (e.g., 'headache', 'nausea', 'diarrhea'). Will search SIDER and use first match."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 50,
          "description": "Maximum drugs on this page (default: 50)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the exact drug association set; continue with metadata.next_offset"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "meddra_code": {
          "type": "string",
          "description": "MedDRA concept code used"
        },
        "side_effect_name": {
          "type": "string",
          "description": "Side effect name"
        },
        "total_drugs": {
          "type": "integer",
          "description": "Exact number of unique SIDER drug IDs associated with this side effect"
        },
        "drugs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sider_drug_id": {
                "type": "string",
                "description": "SIDER drug ID (PubChem CID)"
              },
              "drug_name": {
                "type": "string",
                "description": "Drug name"
              },
              "frequency_info": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Frequency information (e.g., '7%', '5% - 18%', 'postmarketing', 'common', 'rare')"
              },
              "frequency_values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "All distinct non-empty frequency strings across duplicate source rows for this drug"
              },
              "source_row_count": {
                "type": "integer",
                "description": "Number of SIDER detail-page rows merged into this unique drug record"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "get_drugs_for_side_effect",
        "meddra_code": "C0018681",
        "limit": 10,
        "offset": 0
      },
      {
        "operation": "get_drugs_for_side_effect",
        "side_effect_name": "nausea",
        "limit": 10
      }
    ],
    "fields": {
      "operation": "get_drugs_for_side_effect"
    }
  },
  {
    "name": "SIDER_search_side_effect",
    "type": "SiderTool",
    "description": "Search for a side effect by name in SIDER and return matching MedDRA/UMLS codes. drug_count is only the upstream search suggestion's reported count and is explicitly marked non-exact because it can disagree with unique drug IDs on the detail page; call SIDER_get_drugs_for_side_effect for an exact unique count and pagination.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_side_effect"
          ],
          "description": "Operation type",
          "default": "search_side_effect"
        },
        "side_effect_name": {
          "type": "string",
          "description": "Side effect name to search (e.g., 'headache', 'nausea', 'diarrhea', 'liver')"
        }
      },
      "required": [
        "side_effect_name"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query used"
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meddra_code": {
                "type": "string",
                "description": "MedDRA concept code (UMLS CUI)"
              },
              "side_effect_name": {
                "type": "string",
                "description": "Side effect name"
              },
              "drug_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Number of drugs associated with this side effect"
              },
              "drug_count_is_upstream_reported": {
                "type": "boolean",
                "description": "True when drug_count came from the SIDER search suggestion"
              },
              "drug_count_is_exact": {
                "type": "boolean",
                "description": "False because SIDER search counts can disagree with unique IDs on the detail page"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "search_side_effect",
        "side_effect_name": "headache"
      },
      {
        "operation": "search_side_effect",
        "side_effect_name": "nausea"
      }
    ],
    "fields": {
      "operation": "search_side_effect"
    }
  }
]
