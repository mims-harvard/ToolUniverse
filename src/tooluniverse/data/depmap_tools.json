[
  {
    "name": "DepMap_get_cell_lines",
    "description": "Get a page of cancer cell line and organoid models from DepMap/Sanger with their metadata. Each row carries the model id and names, its type and growth properties, its tumour mutational burden and ploidy, and data_available: which assays exist for it, including crispr_ko, so a target-validation screen can see whether the line has knockout data at all. Tissue and cancer type are NOT on this endpoint and no tissue or cancer_type filter can be applied upstream; pass a model_id to DepMap_get_cell_line for those.",
    "parameter": {
      "type": "object",
      "properties": {
        "tissue": {
          "type": "string",
          "description": "Filter by tissue type (e.g., 'Lung', 'Breast', 'Colon')"
        },
        "cancer_type": {
          "type": "string",
          "description": "Filter by cancer type (e.g., 'Non-Small Cell Lung Carcinoma')"
        },
        "page_size": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results (1-100)"
        }
      }
    },
    "fields": {
      "operation": "get_cell_lines"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "tissue": "Lung",
        "page_size": 5
      },
      {
        "page_size": 10
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "cell_lines": {
              "type": "array",
              "description": "Cell line (and organoid) models",
              "items": {
                "type": "object",
                "properties": {
                  "model_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cell Model Passports model id, e.g. SIDM01774"
                  },
                  "model_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The model's first recorded name"
                  },
                  "model_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every name recorded for the model"
                  },
                  "model_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cell Line, Organoid, and so on"
                  },
                  "growth_properties": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Adherent, Suspension, Semi-Adherent"
                  },
                  "model_treatment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Treatment the model was derived under, where recorded"
                  },
                  "mutations_per_mb": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Tumour mutational burden, mutations per megabase"
                  },
                  "ploidy_wes": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Ploidy from whole-exome sequencing"
                  },
                  "ploidy_wgs": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Ploidy from whole-genome sequencing"
                  },
                  "ploidy": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Ploidy, where recorded without a platform"
                  },
                  "pubmed_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "PubMed id of the model's source publication"
                  },
                  "doi": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DOI of that publication"
                  },
                  "comment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Curator comment on the model"
                  },
                  "commercially_available": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether the model can be bought"
                  },
                  "data_available": {
                    "type": "object",
                    "description": "Which assays exist for this model - the question a target-validation screen starts from. crispr_ko false means no knockout data.",
                    "properties": {
                      "crispr_ko": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "expression": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "mutations": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "rnaseq": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "cnv": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "methylation": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "proteomics": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "fusions": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "drugs": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          }
        },
        "error": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "description": "Present when a tissue or cancer_type filter was given, to say that the upstream cannot apply it",
          "properties": {
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "label": [
      "DepMap",
      "Cell Lines",
      "Cancer"
    ],
    "metadata": {
      "tags": [
        "cell_lines",
        "cancer_models",
        "target_validation"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "DepMap_get_cell_line",
    "description": "Get detailed metadata for a specific cancer cell line. Returns tissue, cancer type, MSI status, ploidy, mutational burden. Use model_id (e.g., 'SIDM00001') or model_name (e.g., 'A549').",
    "parameter": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "description": "Cell Model Passport ID (e.g., 'SIDM00001')"
        },
        "model_name": {
          "type": "string",
          "description": "Cell line name (e.g., 'A549', 'MCF7', 'HeLa')"
        }
      }
    },
    "fields": {
      "operation": "get_cell_line"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "model_name": "A549"
      },
      {
        "model_name": "MCF7"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "tissue": {
              "type": [
                "string",
                "null"
              ]
            },
            "cancer_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "msi_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "ploidy": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "description": "null when the record does not exist. The query was well-formed and the upstream answered 'no such record', which this tool reports as a successful empty result rather than an error; the reason is in `message`."
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the result is empty, e.g. \"Cell line 'A549' not found\". Without it an empty result and a failed lookup are the same answer."
        }
      }
    },
    "label": [
      "DepMap",
      "Cell Line",
      "Metadata"
    ],
    "metadata": {
      "tags": [
        "cell_line",
        "metadata",
        "characterization"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  },
  {
    "name": "DepMap_search_cell_lines",
    "description": "Search cancer cell lines by name. Returns matching cell lines with IDs and cancer types. Use for finding cell models by common names (A549, HeLa, MCF7, etc.).",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query (cell line name like 'A549', 'MCF7')"
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "operation": "search_cell_lines"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "query": "A549"
      },
      {
        "query": "MCF"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "cell_lines": {
              "type": "array"
            },
            "count": {
              "type": "integer"
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "label": [
      "DepMap",
      "Search",
      "Cell Lines"
    ],
    "metadata": {
      "tags": [
        "search",
        "cell_lines"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  },
  {
    "name": "DepMap_get_gene_dependencies",
    "description": "Get gene dependency information from CRISPR knockout screens. Returns gene IDs and annotations. Negative gene effect scores indicate essentiality (cell death upon knockout).",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "description": "Gene symbol (e.g., 'EGFR', 'KRAS', 'TP53')"
        },
        "model_id": {
          "type": "string",
          "description": "Optional: Filter by specific cell line"
        }
      },
      "required": [
        "gene_symbol"
      ]
    },
    "fields": {
      "operation": "get_gene_dependencies"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "gene_symbol": "EGFR"
      },
      {
        "gene_symbol": "KRAS"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "gene_symbol": {
              "type": "string"
            },
            "genes": {
              "type": "array"
            },
            "matched_gene": {
              "description": "The gene record this query resolved to, with its symbol, ids and whether the match was exact. The query 'TP53' can resolve to more than one gene and this says which one was used."
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the dependency scores mean: negative is essential, zero is no effect. The sign convention, without which the numbers can be read backwards."
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "label": [
      "DepMap",
      "CRISPR",
      "Dependencies"
    ],
    "metadata": {
      "tags": [
        "crispr",
        "gene_effect",
        "essentiality",
        "target_validation"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "DepMap_search_genes",
    "description": "Search the full DepMap/Sanger gene catalog by exact symbol or symbol prefix. Prefix matches spanning multiple upstream catalog pages are collected, then exposed through recoverable offset pagination with total_genes (all matches), count/returned (this page), has_more, and next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or name to search (e.g., 'WDR7', 'EGFR', 'TP53')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Number of matching genes per page (1-500; default 20)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the complete prefix match set."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "operation": "search_genes"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "query": "EGFR"
      },
      {
        "query": "WDR7"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "genes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gene_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DepMap's own id for the gene."
                  },
                  "symbol": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC symbol."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Full gene name."
                  },
                  "hgnc_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC identifier, e.g. 'HGNC:11998'."
                  },
                  "ensembl_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl gene id, e.g. 'ENSG00000141510'."
                  },
                  "exact_match": {
                    "type": "boolean",
                    "description": "Whether the symbol equals the query exactly rather than merely starting with it."
                  },
                  "hgnc_status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC status of the symbol, e.g. 'current'. A withdrawn or merged symbol otherwise resolves silently and the caller cannot see that what they searched is no longer the current symbol."
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cytogenetic location, e.g. '17p13.1'."
                  },
                  "method_of_action": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DepMap's mechanism annotation for the gene's product, e.g. 'ambiguous'. Populated on a minority of genes."
                  },
                  "hgnc_merge_comment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC's note when this symbol's record was merged into another. Null when none."
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            },
            "total_genes": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "label": [
      "DepMap",
      "Gene Search"
    ],
    "metadata": {
      "tags": [
        "gene_search",
        "symbol_validation"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  }
]
