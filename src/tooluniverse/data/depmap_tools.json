  {
    "name": "DepMap_get_gene_dependencies",
    "description": "Get the CRISPR knockout fitness scores of a gene across cancer cell lines and organoids from DepMap at Sanger (Cell Model Passports). Returns one row per screen of a model: model id, name, tissue, cancer type, the source of the screen (Sanger Project Score or Broad), and the scores bf_scaled (scaled Bayes factor) and fc_clean_qn (corrected log fold change). bf_scaled below 0 means the knockout causes a significant loss of fitness in that model (loss_of_fitness true); more negative is a stronger dependency. Rows are sorted most dependent first. summary counts the screens and how many show a loss of fitness, in total and per source, e.g. KRAS: 578 of 1,269 screens on 2026-11-25. Optional model_id keeps one model (a model id such as 'SIDM00903' or a model name such as 'A549'). These are Sanger-pipeline scores, not the Chronos gene effect of depmap.org, so the Chronos threshold of -0.5 does not apply; for Broad Chronos scores by Ensembl gene id use OpenTargets_get_target_depmap_essentiality. A gene with no knockout record returns an empty scores list with a note, not an error.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "description": "Gene symbol (e.g., 'EGFR', 'KRAS', 'TP53')"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional: keep the screens of one model. A model id (e.g. 'SIDM00903') or a model name (e.g. 'A549'), from DepMap_search_cell_lines. An unknown id or name returns an error."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Rows per page (default 50, maximum 500)."
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Rows to skip (default 0). Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "gene_symbol"
      ]
    },
    "fields": {
      "operation": "get_gene_dependencies"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "gene_symbol": "KRAS",
        "limit": 5
      },
      {
        "gene_symbol": "KRAS",
        "model_id": "A549"
      },
      {
        "gene_symbol": "TP53",
        "model_id": "SIDM00136"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "gene_symbol": {
              "type": "string"
            },
            "matched_gene": {
              "description": "The gene record this query resolved to, with its symbol, ids and whether the match was exact. The query 'TP53' can resolve to more than one gene and this says which one was used."
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the scores mean: bf_scaled below 0 is a significant loss of fitness. The sign convention, without which the numbers can be read backwards."
            },
            "summary": {
              "type": "object",
              "description": "Counts over every CRISPR knockout screen of the gene, before the model_id filter",
              "properties": {
                "screens": {
                  "type": "integer",
                  "description": "Number of screen records"
                },
                "loss_of_fitness_screens": {
                  "type": "integer",
                  "description": "Screens with bf_scaled below 0"
                },
                "loss_of_fitness_fraction": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "loss_of_fitness_screens / screens"
                },
                "models": {
                  "type": "integer",
                  "description": "Distinct models screened"
                },
                "by_source": {
                  "type": "object",
                  "description": "The same counts per source, e.g. 'Sanger', 'Broad'",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "screens": {
                        "type": "integer"
                      },
                      "loss_of_fitness_screens": {
                        "type": "integer",
                        "description": "Screens with bf_scaled below 0"
                      },
                      "loss_of_fitness_fraction": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "scores": {
              "type": "array",
              "description": "One row per screen of a model, most dependent first (this page)",
              "items": {
                "type": "object",
                "properties": {
                  "model_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Model id, e.g. 'SIDM00903'"
                  },
                  "model_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "First name of the model, e.g. 'A549'"
                  },
                  "model_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "'Cell Line' or 'Organoid'"
                  },
                  "tissue": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cancer_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Who ran the screen: 'Sanger' or 'Broad'"
                  },
                  "bf_scaled": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Scaled Bayes factor. Below 0: significant loss of fitness."
                  },
                  "bf": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Bayes factor before scaling"
                  },
                  "fc_clean_qn": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Corrected, quantile-normalised log fold change. More negative: stronger depletion."
                  },
                  "qc_pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "loss_of_fitness": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "true when bf_scaled is below 0"
                  }
                }
              }
            },
            "model_filter": {
              "type": [
                "string",
                "null"
              ],
              "description": "The model_id argument, when given"
            },
            "count": {
              "type": "integer"
            },
            "total_scores": {
              "type": "integer",
              "description": "Rows that match (all pages)"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "warning": {
              "type": "string",
              "description": "Present when the gene symbol had no exact match, or when the API returned fewer records than it reported"
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "label": [
      "DepMap",
      "CRISPR",
      "Dependencies"
    ],
    "metadata": {
      "tags": [
        "crispr",
        "gene_effect",
        "essentiality",
        "target_validation"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "DepMap_search_genes",
    "description": "Search the full DepMap/Sanger gene catalog by exact symbol or symbol prefix. Prefix matches spanning multiple upstream catalog pages are collected, then exposed through recoverable offset pagination with total_genes (all matches), count/returned (this page), has_more, and next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or name to search (e.g., 'WDR7', 'EGFR', 'TP53')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Number of matching genes per page (1-500; default 20)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the complete prefix match set."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "operation": "search_genes"
    },
    "type": "DepMapTool",
    "test_examples": [
      {
        "query": "EGFR"
      },
      {
        "query": "WDR7"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "genes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gene_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DepMap's own id for the gene."
                  },
                  "symbol": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC symbol."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Full gene name."
                  },
                  "hgnc_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC identifier, e.g. 'HGNC:11998'."
                  },
                  "ensembl_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl gene id, e.g. 'ENSG00000141510'."
                  },
                  "exact_match": {
                    "type": "boolean",
                    "description": "Whether the symbol equals the query exactly rather than merely starting with it."
                  },
                  "hgnc_status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC status of the symbol, e.g. 'current'. A withdrawn or merged symbol otherwise resolves silently and the caller cannot see that what they searched is no longer the current symbol."
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cytogenetic location, e.g. '17p13.1'."
                  },
                  "method_of_action": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DepMap's mechanism annotation for the gene's product, e.g. 'ambiguous'. Populated on a minority of genes."
                  },
                  "hgnc_merge_comment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC's note when this symbol's record was merged into another. Null when none."
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            },
            "total_genes": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "label": [
      "DepMap",
      "Gene Search"
    ],
    "metadata": {
      "tags": [
        "gene_search",
        "symbol_validation"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  }
]
