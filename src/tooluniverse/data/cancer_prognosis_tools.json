[
  {
    "name": "CancerPrognosis_get_survival_data",
    "type": "CancerPrognosisTool",
    "description": "Retrieve patient-level OS and DFS data from a TCGA or cBioPortal study. The tool fetches every raw clinical-data page before computing exact cohort counts. Patient arrays are recoverably paginated with patient_offset; follow the separate OS/DFS next_patient_offset fields until has_more is false.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_survival_data"
          ],
          "description": "Operation type",
          "default": "get_survival_data"
        },
        "cancer": {
          "type": "string",
          "description": "TCGA cancer type abbreviation (e.g., 'BRCA', 'LUAD', 'COAD', 'GBM', 'COADREAD') or cBioPortal study ID (e.g., 'brca_tcga'). Use cancer_type as alias."
        },
        "cancer_type": {
          "type": "string",
          "description": "Alias for cancer. TCGA cancer type abbreviation (e.g., 'BRCA', 'LUAD', 'COAD', 'GBM', 'COADREAD') or cBioPortal study ID."
        },
        "study_id": {
          "type": "string",
          "description": "Alias for cancer. cBioPortal study ID (e.g., 'brca_tcga', 'coadread_tcga', 'luad_tcga')."
        },
        "max_patients": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of patient records to return (default 500, max 2000)"
        },
        "patient_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset applied independently to the sorted OS and DFS patient lists."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "study_id": {
                  "type": "string"
                },
                "cancer": {
                  "type": "string"
                },
                "total_patients": {
                  "type": "integer"
                },
                "clinical_records_fetched": {
                  "type": "integer"
                },
                "clinical_pages_fetched": {
                  "type": "integer"
                },
                "patient_offset": {
                  "type": "integer"
                },
                "overall_survival": {
                  "type": "object",
                  "properties": {
                    "n_patients": {
                      "type": "integer"
                    },
                    "n_events": {
                      "type": "integer"
                    },
                    "patients": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "patient_id": {
                            "type": "string"
                          },
                          "os_months": {
                            "type": "number"
                          },
                          "os_status": {
                            "type": "string"
                          },
                          "event": {
                            "type": "integer"
                          },
                          "age": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Patient age at diagnosis as a STRING, e.g. '55'. Convert before using it as a covariate."
                          }
                        }
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "next_patient_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "total_patients_with_os_data": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "How many patients in the study have overall-survival data, e.g. 1096 -- against the 50 patient rows this reply carries. Any survival estimate computed from the returned rows alone uses a sample of the cohort."
                    }
                  }
                },
                "disease_free_survival": {
                  "type": "object",
                  "properties": {
                    "n_patients": {
                      "type": "integer"
                    },
                    "n_events": {
                      "type": "integer"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "next_patient_offset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "patients": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "description": "Per-patient disease-free survival rows, each {patient_id, dfs_months, dfs_status, ...}; dfs_status is cBioPortal's coded string such as '1:Recurred/Progressed'. 50 rows returned."
                    },
                    "total_patients_with_dfs_data": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "How many patients have disease-free-survival data, e.g. 1004. Smaller than the overall-survival count, so the two endpoints are not computed on the same patients."
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "description": "Description of profile and any warnings (e.g., duplicate aliquot warning)"
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "get_survival_data",
        "cancer": "BRCA",
        "max_patients": 50
      }
    ],
    "fields": {
      "operation": "get_survival_data"
    }
  },
  {
    "name": "CancerPrognosis_get_gene_expression",
    "type": "CancerPrognosisTool",
    "description": "Fetch gene expression values (RNA-seq) for a specific gene across cancer samples in a TCGA or cBioPortal study. Returns per-sample expression values with summary statistics (mean, median, min, max). Output can be combined with survival data for expression-based prognostic analysis. Supports 33 TCGA cancer types and any cBioPortal study with mRNA expression data.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_gene_expression"
          ],
          "description": "Operation type",
          "default": "get_gene_expression"
        },
        "cancer": {
          "type": "string",
          "description": "TCGA cancer type abbreviation (e.g., 'BRCA', 'LUAD', 'COADREAD') or cBioPortal study ID. Use cancer_type as alias."
        },
        "cancer_type": {
          "type": "string",
          "description": "Alias for cancer. TCGA cancer type (e.g., 'BRCA', 'LUAD', 'COADREAD') or cBioPortal study ID."
        },
        "study_id": {
          "type": "string",
          "description": "Alias for cancer. cBioPortal study ID (e.g., 'brca_tcga', 'luad_tcga')."
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol (e.g., 'TP53', 'BRCA1', 'EGFR', 'CD8A')"
        },
        "gene_symbol": {
          "type": "string",
          "description": "Alias for gene. Gene symbol (e.g., 'TP53', 'BRCA1', 'EGFR')."
        },
        "gene_name": {
          "type": "string",
          "description": "Alias for gene. Gene symbol or name (e.g., 'TP53', 'BRCA1')."
        },
        "max_samples": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Upper bound on sample records to return (default 500, max 2000). Actual count may be lower if some samples lack expression data for the requested gene."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "study_id": {
                  "type": "string"
                },
                "gene": {
                  "type": "string"
                },
                "entrez_gene_id": {
                  "type": "integer"
                },
                "profile_id": {
                  "type": "string"
                },
                "expression_units": {
                  "type": "string",
                  "description": "Description of the expression value type (e.g., 'RSEM (RNA Seq V2 normalized expected read counts)')"
                },
                "n_samples_with_expression_data": {
                  "type": "integer",
                  "description": "Number of samples with non-null expression values for this gene"
                },
                "n_samples_returned": {
                  "type": "integer",
                  "description": "Number of sample records in the 'samples' array (may be less than n_samples_with_expression_data if max_samples was applied)"
                },
                "expression_summary": {
                  "type": "object",
                  "properties": {
                    "mean": {
                      "type": "number"
                    },
                    "median": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  }
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sample_id": {
                        "type": "string"
                      },
                      "patient_id": {
                        "type": "string"
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "description": "Description of profile and any warnings (e.g., duplicate aliquot warning)"
                },
                "duplicate_aliquot_warning": {
                  "type": "object",
                  "description": "Present when patients have multiple samples (e.g., primary + recurrence). Joining on patient_id will double-count affected patients.",
                  "properties": {
                    "n_affected_patients": {
                      "type": "integer"
                    },
                    "affected_patient_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "message": {
                      "type": "string"
                    },
                    "detection_scope": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "What the duplicate check covered, e.g. 'all_fetched_samples'. A scope narrower than the whole study means duplicates outside it were not looked for."
                    },
                    "n_samples_checked": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "How many samples were checked for duplicate aliquots, e.g. 495."
                    }
                  }
                },
                "profile_datatype": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "What cBioPortal says the values ARE, beside the units inferred from the profile name. A Z-SCORE and a CONTINUOUS value cannot be compared."
                },
                "profile_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "profile_description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "study_note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Which study was used and whether the tool chose it, e.g. \"Auto-selected study_id='brca_tcga'. Use CancerPrognosis_search_studies to find alternatives\". When the study was auto-selected the result answers a question the caller did not quite ask."
                }
              }
            },
            "truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when the reply holds fewer samples than the study has, e.g. true. The measured call returned 50 of 495."
            },
            "truncation_note": {
              "type": [
                "string",
                "null"
              ],
              "description": "What was cut and how to get the rest, e.g. 'Returning 50 of 495 samples. Pass max_samples=495 (up to 2000) to retrieve the full dataset.' Any statistic computed on the returned samples alone is computed on a fraction of the cohort."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "get_gene_expression",
        "cancer": "BRCA",
        "gene": "TP53",
        "max_samples": 50
      }
    ],
    "fields": {
      "operation": "get_gene_expression"
    }
  },
  {
    "name": "CancerPrognosis_search_studies",
    "type": "CancerPrognosisTool",
    "description": "Search cBioPortal for cancer genomics studies by keyword. Find studies by cancer type, institution, or data type. Returns study IDs that can be used with other CancerPrognosis tools. Covers 400+ studies including all TCGA projects, AACR GENIE, MSK-IMPACT, and institutional cohorts.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_studies"
          ],
          "description": "Operation type",
          "default": "search_studies"
        },
        "keyword": {
          "type": "string",
          "description": "Search keyword (e.g., 'breast', 'lung', 'TCGA', 'melanoma', 'glioblastoma')"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of results to return (default 20, max 100)"
        },
        "cancer_type": {
          "type": "string",
          "description": "Cancer type to search for. Alias for keyword."
        },
        "cancer": {
          "type": "string",
          "description": "Cancer type to search for. Alias for keyword."
        },
        "query": {
          "type": "string",
          "description": "Search query. Alias for keyword (e.g., 'lung', 'breast', 'TCGA')."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "keyword": {
                  "type": "string"
                },
                "n_results": {
                  "type": "integer"
                },
                "studies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "study_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "cancer_type_id": {
                        "type": "string"
                      },
                      "sample_count": {
                        "type": "integer"
                      },
                      "cancer_type_name": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "What the cancer IS. cancer_type_id is \"brca\"; this is \"Invasive Breast Carcinoma\"."
                      },
                      "cancer_type_short_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cancer_type_parent": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reference_genome": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "hg19 or hg38. They are not interchangeable and nothing said which this was."
                      },
                      "import_date": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "public_study": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "groups": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "treatment_count": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "structural_variant_count": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "sample_counts": {
                        "type": "object",
                        "description": "Samples per modality -- sequenced, CNA, RNA-seq, microarray, miRNA, methylation, RPPA, mass spectrometry, complete. `sample_count` is the largest of three of these with no way to tell which, and a study with 1,108 samples of which 982 are sequenced and 316 have HM27 methylation is three studies depending on the question."
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Cut at 1000 characters, which description_truncated discloses; it used to be cut at 200 in silence"
                      },
                      "description_truncated": {
                        "type": "boolean"
                      },
                      "description_length": {
                        "type": "integer"
                      },
                      "reference_pmid": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "search_studies",
        "keyword": "breast",
        "limit": 10
      }
    ],
    "fields": {
      "operation": "search_studies"
    }
  },
  {
    "name": "CancerPrognosis_get_study_summary",
    "type": "CancerPrognosisTool",
    "description": "Get summary information for a cancer study including available molecular profiles (mutations, expression, CNV), survival-related clinical attributes, and sample counts. Useful for determining what data is available before querying expression or survival data. Lists all 33 supported TCGA cancer type abbreviations.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "get_study_summary"
          ],
          "description": "Operation type",
          "default": "get_study_summary"
        },
        "cancer": {
          "type": "string",
          "description": "TCGA cancer type abbreviation (e.g., 'BRCA', 'LUAD', 'COADREAD') or cBioPortal study ID. Use cancer_type as alias."
        },
        "cancer_type": {
          "type": "string",
          "description": "Alias for cancer. TCGA cancer type abbreviation (e.g., 'BRCA', 'LUAD', 'COADREAD')."
        },
        "study_id": {
          "type": "string",
          "description": "Alias for cancer. cBioPortal study ID (e.g., 'brca_tcga', 'luad_tcga')."
        }
      },
      "required": []
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "study_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "cancer_type_id": {
                  "type": "string"
                },
                "sample_count": {
                  "type": "integer"
                },
                "molecular_profiles": {
                  "type": "array",
                  "description": "Each profile with the datatype that says how its values are expressed",
                  "items": {
                    "type": "object",
                    "properties": {
                      "profile_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "e.g. MRNA_EXPRESSION, COPY_NUMBER_ALTERATION"
                      },
                      "datatype": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Z-SCORE, CONTINUOUS or DISCRETE -- which decides whether a value can be compared across studies"
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "show_profile_in_analysis_tab": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "patient_level": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "survival_attributes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                },
                "available_tcga_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cancer_type_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "What the cancer IS. cancer_type_id is \"brca\"; this is \"Invasive Breast Carcinoma\"."
                },
                "cancer_type_short_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cancer_type_parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reference_genome": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "hg19 or hg38. They are not interchangeable and nothing said which this was."
                },
                "import_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "public_study": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "groups": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "treatment_count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "structural_variant_count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "sample_counts": {
                  "type": "object",
                  "description": "Samples per modality -- sequenced, CNA, RNA-seq, microarray, miRNA, methylation, RPPA, mass spectrometry, complete. `sample_count` is the largest of three of these with no way to tell which, and a study with 1,108 samples of which 982 are sequenced and 316 have HM27 methylation is three studies depending on the question."
                },
                "description_truncated": {
                  "type": "boolean"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Cut at 1000 characters, which description_truncated discloses; it used to be cut at 200 in silence"
                },
                "total_clinical_attributes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "How many clinical attributes the study records, e.g. 106. The summary names only a few of them, so this is the count of what else could be requested."
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "get_study_summary",
        "cancer": "LUAD"
      }
    ],
    "fields": {
      "operation": "get_study_summary"
    }
  }
]
