[
  {
    "name": "UCSC_search",
    "description": "Search the UCSC Genome Browser for genes, transcripts, or genomic features by name. Returns the true match count across all returned tracks with explicit local offset pagination; continue with next_offset while has_more is true. Supports gene symbols, transcript IDs, SNP rsIDs, and chromosomal bands.",
    "parameter": {
      "type": "object",
      "properties": {
        "search_term": {
          "type": "string",
          "description": "Gene symbol, transcript ID, SNP rsID, or genomic feature to search. Examples: 'TP53', 'BRCA1', 'rs429358', 'ENST00000269305'."
        },
        "genome": {
          "type": "string",
          "description": "UCSC genome assembly identifier. Default: 'hg38'. Others: 'hg19', 'mm10', 'mm39', 'dm6', 'ce11', 'danRer11', 'sacCer3'."
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum position matches per page (default 50, max 1000)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based match offset. Continue with next_offset while has_more is true."
        }
      },
      "required": [
        "search_term"
      ]
    },
    "fields": {
      "endpoint_type": "search"
    },
    "type": "UCSCGenomeTool",
    "test_examples": [
      {
        "search_term": "TP53",
        "genome": "hg38"
      },
      {
        "search_term": "BRCA1",
        "genome": "hg38"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "genome": {
              "type": "string"
            },
            "search_term": {
              "type": "string"
            },
            "match_count": {
              "type": "integer"
            },
            "total_matches": {
              "type": "integer"
            },
            "returned_count": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track": {
                    "type": "string"
                  },
                  "track_description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "position": {
                    "type": "string"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "transcript_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UCSC_list_tracks",
    "description": "Discover UCSC Genome Browser tracks with exact track_count and recoverable local offset pagination. Continue with next_offset while has_more is true. When track is provided, returns that track's column schema instead of the list.",
    "parameter": {
      "type": "object",
      "properties": {
        "genome": {
          "type": "string",
          "description": "UCSC genome assembly identifier. Examples: 'hg38', 'hg19', 'mm39', 'mm10', 'dm6', 'danRer11'."
        },
        "track": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional. When set, return this track's column schema instead of the track list. Example: 'knownGene', 'dbSnp155', 'ncbiRefSeq'."
        },
        "name_filter": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional substring filter (case-insensitive) applied to track name/shortLabel/longLabel when listing tracks. Example: 'dbSnp', 'gencode', 'clinvar'."
        },
        "max_tracks": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of tracks to return when listing (default 500). The total matched count is always reported in track_count."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset in the filtered track list. Continue with next_offset."
        }
      },
      "required": [
        "genome"
      ]
    },
    "fields": {
      "endpoint_type": "list_tracks"
    },
    "type": "UCSCGenomeTool",
    "test_examples": [
      {
        "genome": "hg38",
        "name_filter": "dbSnp155",
        "max_tracks": 10
      },
      {
        "genome": "hg38",
        "track": "knownGene"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "genome": {
              "type": "string"
            },
            "name_filter": {
              "type": [
                "string",
                "null"
              ]
            },
            "track_count": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "returned_count": {
              "type": "integer"
            },
            "tracks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track": {
                    "type": "string"
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "short_label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "long_label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "group": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "track": {
              "type": "string"
            },
            "track_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "column_count": {
              "type": "integer"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "sqlType": {
                    "type": "string"
                  },
                  "jsonType": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UCSC_get_sequence",
    "description": "Get DNA sequence from the UCSC Genome Browser for a genomic region. Pass 'region' as a written locus (e.g. 'chr14:89000000-89000100', 1-based inclusive, 101 bp) to paste coordinates verbatim, or give chrom/start/end with 'coordinate_system'. Returns the nucleotide sequence plus the resolved region in both conventions. Useful for primer design, sequence analysis and regulatory element inspection.",
    "parameter": {
      "type": "object",
      "properties": {
        "genome": {
          "type": "string",
          "description": "UCSC genome assembly identifier. Examples: 'hg38' (human), 'mm39' (mouse), 'dm6' (fly), 'sacCer3' (yeast)."
        },
        "chrom": {
          "type": "string",
          "description": "Chromosome name. Examples: 'chr1', 'chr17', 'chrX', 'chrM'."
        },
        "start": {
          "type": "integer",
          "description": "Start position. Interpreted per 'coordinate_system' (default 0-based, inclusive). Example: 7668421."
        },
        "end": {
          "type": "integer",
          "description": "End position. Exclusive when coordinate_system is 0-based, inclusive when 1-based. Span must be <= 100000 bp. Example: 7668521."
        },
        "region": {
          "type": "string",
          "description": "Genomic region written the usual way, 1-based INCLUSIVE on both ends, e.g. 'chr14:89000000-89000100' (101 bp). This is the form shown by the UCSC browser, IGV and samtools, so you can paste a locus verbatim. PREFERRED over chrom/start/end: it removes the 0-based/1-based conversion that otherwise silently drops the first base."
        },
        "coordinate_system": {
          "type": "string",
          "enum": [
            "0-based",
            "1-based"
          ],
          "description": "Which convention chrom/start/end are given in. '0-based' (default) is half-open, matching the UCSC API: length = end - start. '1-based' is inclusive, matching a written locus: length = end - start + 1. Ignored when 'region' is supplied.",
          "default": "0-based"
        }
      },
      "required": [
        "genome"
      ]
    },
    "fields": {
      "endpoint_type": "get_sequence"
    },
    "type": "UCSCGenomeTool",
    "test_examples": [
      {
        "genome": "hg38",
        "region": "chr14:89000000-89000100"
      },
      {
        "genome": "hg38",
        "chrom": "chr17",
        "start": 7668421,
        "end": 7668521
      },
      {
        "genome": "hg38",
        "chrom": "chr17",
        "start": 7668422,
        "end": 7668521,
        "coordinate_system": "1-based"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "genome": {
              "type": "string"
            },
            "chrom": {
              "type": "string"
            },
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "length": {
              "type": "integer"
            },
            "dna": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UCSC_get_track",
    "description": "Get annotation track data for a genomic region. If UCSC reports maxItemsLimit=true, the response sets truncated and includes a remediation note; UCSC supplies no continuation cursor, so increase maxItemsOutput or split the interval before treating results as complete.",
    "parameter": {
      "type": "object",
      "properties": {
        "genome": {
          "type": "string",
          "description": "UCSC genome assembly. Examples: 'hg38', 'hg19', 'mm39'."
        },
        "track": {
          "type": "string",
          "description": "Track name. Common tracks: 'knownGene' (GENCODE genes), 'ncbiRefSeq' (RefSeq), 'snp151' (dbSNP), 'encodeCcreCombined' (ENCODE cCREs), 'phastCons100way' (conservation), 'rmsk' (repeats)."
        },
        "chrom": {
          "type": "string",
          "description": "Chromosome name. Examples: 'chr1', 'chr17', 'chrX'."
        },
        "start": {
          "type": "integer",
          "description": "0-based start position (inclusive)."
        },
        "end": {
          "type": "integer",
          "description": "End position (exclusive). Must be > start."
        },
        "maxItemsOutput": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of items to return. Default: 100. Set to limit large result sets."
        }
      },
      "required": [
        "genome",
        "track",
        "chrom",
        "start",
        "end"
      ]
    },
    "fields": {
      "endpoint_type": "get_track"
    },
    "type": "UCSCGenomeTool",
    "test_examples": [
      {
        "genome": "hg38",
        "track": "knownGene",
        "chrom": "chr17",
        "start": 7668421,
        "end": 7687490,
        "maxItemsOutput": 10
      },
      {
        "genome": "hg38",
        "track": "encodeCcreCombined",
        "chrom": "chr1",
        "start": 11000,
        "end": 15000,
        "maxItemsOutput": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "genome": {
              "type": "string"
            },
            "track": {
              "type": "string"
            },
            "track_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "chrom": {
              "type": "string"
            },
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "item_count": {
              "type": "integer"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
