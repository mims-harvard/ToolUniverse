[
  {
    "name": "ELIXIRTeSS_search_materials",
    "description": "Search ELIXIR TeSS for bioinformatics training materials. Results use one-based page pagination: start with page=1 and continue with metadata.next_page while metadata.has_more is true. TeSS exposes no total; ToolUniverse reports an exact total only when a short final page is reached. Returns topics, EDAM operations, difficulty, and resource URLs.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": [
            "string",
            "null"
          ],
          "description": "Search query for training materials. Examples: 'CRISPR', 'protein structure prediction', 'RNA-seq', 'machine learning', 'genome assembly'"
        },
        "scientific_topics": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by EDAM scientific topic. Examples: 'Genomics', 'Proteomics', 'Sequence analysis', 'Phylogenetics'"
        },
        "target_audience": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by target audience. Examples: 'Researchers', 'Graduate students', 'Bioinformaticians'"
        },
        "difficulty_level": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by difficulty: 'Beginner', 'Intermediate', 'Advanced'"
        },
        "licence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by license type. Example: 'CC-BY'"
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Results per page (default 10, max 100)"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 1,
          "description": "One-based page number. Continue with metadata.next_page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://tess.elixir-europe.org/materials.json",
      "params": {
        "page_size": "10"
      },
      "pagination": "tess_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "CRISPR",
        "page_size": 5
      },
      {
        "q": "protein structure",
        "difficulty_level": "Beginner",
        "page_size": 5
      },
      {
        "q": "RNA-seq analysis",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of bioinformatics training materials",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "TeSS material ID"
              },
              "title": {
                "type": "string",
                "description": "Training material title"
              },
              "url": {
                "type": "string",
                "description": "URL to the material on TeSS"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Description of the training content"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "DOI if available"
              },
              "remote_updated_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Last updated date"
              },
              "remote_created_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Created date"
              },
              "scientific_topics": {
                "type": "array",
                "description": "EDAM scientific topics",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "preferred_label": {
                      "type": "string"
                    }
                  }
                }
              },
              "operations": {
                "type": "array",
                "description": "EDAM operations covered",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "preferred_label": {
                      "type": "string"
                    }
                  }
                }
              },
              "external_resources": {
                "type": "array",
                "description": "Links to external resources",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "url": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "When the record was created in TeSS, ISO-8601 UTC, e.g. '2026-09-05T05:12:11.782Z'."
                    },
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Kind of linked resource, e.g. 'other'."
                    },
                    "updated_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "When the record was last changed, e.g. '2026-11-11T04:42:13.398Z'."
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ELIXIRTeSS_search_events",
    "description": "Search ELIXIR TeSS for bioinformatics training events. Results use one-based page pagination: start with page=1 and continue with metadata.next_page while metadata.has_more is true. TeSS exposes no total; ToolUniverse reports an exact total only at a short final page. Returns organizer, location, dates, costs, and registration links.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": [
            "string",
            "null"
          ],
          "description": "Search query for events. Examples: 'metagenomics workshop', 'NGS training', 'structural biology course'"
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by country. Examples: 'United Kingdom', 'Germany', 'Netherlands', 'Online'"
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by event type. Values: 'workshops_and_courses', 'conferences', 'webinars'"
        },
        "online": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Filter to online events only (true/false)"
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Results per page (default 10, max 100)"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 1,
          "description": "One-based page number. Continue with metadata.next_page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://tess.elixir-europe.org/events.json",
      "params": {
        "page_size": "10"
      },
      "pagination": "tess_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "bioinformatics",
        "page_size": 5
      },
      {
        "q": "proteomics",
        "page_size": 5
      },
      {
        "q": "machine learning biology",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of bioinformatics training events",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "external_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string",
                "description": "Event title"
              },
              "subtitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": "string",
                "description": "TeSS event URL"
              },
              "organizer": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Event organizer"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Start date (ISO format)"
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "End date (ISO format)"
              },
              "venue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "online": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "cost_basis": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "free, partly_free, or fee_based"
              },
              "scientific_topics": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "fields": {
                "type": "array"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capacity": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Number of places, e.g. 8. Present on 2 of the 5 events; absent means not stated, not unlimited."
              },
              "content_provider_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Numeric id of the TeSS content provider that supplied the record, e.g. 2."
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "When the record was created in TeSS, ISO-8601 UTC, e.g. '2026-09-05T05:12:11.782Z'."
              },
              "event_types": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "What kind of event it is, e.g. ['workshops_and_courses']. TeSS's controlled vocabulary."
              },
              "last_scraped": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Date the harvester last refreshed the record, 'YYYY-MM-DD', e.g. '2026-11-11'. A stale date means the upstream listing may have moved on."
              },
              "latitude": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Latitude of the venue as a STRING, e.g. '43.590472'. Present on 2 of 5 -- online events have none."
              },
              "longitude": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Longitude of the venue as a STRING, e.g. '3.859513'. Present on 2 of 5."
              },
              "nodes": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "ELIXIR nodes the record belongs to, each {name, node_id}, e.g. {'name': 'EMBL-EBI', 'node_id': 4}."
              },
              "scraper_record": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "True when the record was harvested automatically rather than entered by hand. True on all 5 events measured, which is why some fields are sparse."
              },
              "slug": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "TeSS's URL slug for the record, e.g. 'uniprot-b58010bb-9cd8-41a5-b74b-20bbdbddeff2'. This, not the numeric id, is what appends to https://tess.elixir-europe.org/events/."
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Where TeSS got the record, e.g. 'tess'."
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "When the record was last changed, e.g. '2026-11-11T04:42:13.398Z'."
              },
              "user_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Numeric TeSS user who owns the record, e.g. 1."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
