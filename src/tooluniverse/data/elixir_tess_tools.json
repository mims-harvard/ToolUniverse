[
  {
    "name": "ELIXIRTeSS_search_materials",
    "description": "Search ELIXIR TeSS for bioinformatics training materials. Results use one-based page pagination: start with page=1 and continue with metadata.next_page while metadata.has_more is true. TeSS exposes no total; ToolUniverse reports an exact total only when a short final page is reached. Returns topics, EDAM operations, difficulty, and resource URLs.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": [
            "string",
            "null"
          ],
          "description": "Search query for training materials. Examples: 'CRISPR', 'protein structure prediction', 'RNA-seq', 'machine learning', 'genome assembly'"
        },
        "scientific_topics": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by EDAM scientific topic. Examples: 'Genomics', 'Proteomics', 'Sequence analysis', 'Phylogenetics'"
        },
        "target_audience": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by target audience. Examples: 'Researchers', 'Graduate students', 'Bioinformaticians'"
        },
        "difficulty_level": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by difficulty: 'Beginner', 'Intermediate', 'Advanced'"
        },
        "licence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by license type. Example: 'CC-BY'"
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Results per page (default 10, max 100)"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 1,
          "description": "One-based page number. Continue with metadata.next_page."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://tess.elixir-europe.org/materials.json",
      "params": {
        "page_size": "10"
      },
      "pagination": "tess_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "CRISPR",
        "page_size": 5
      },
      {
        "q": "protein structure",
        "difficulty_level": "Beginner",
        "page_size": 5
      },
      {
        "q": "RNA-seq analysis",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of bioinformatics training materials",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "TeSS material ID"
              },
              "title": {
                "type": "string",
                "description": "Training material title"
              },
              "url": {
                "type": "string",
                "description": "URL to the material on TeSS"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Description of the training content"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "DOI if available"
              },
              "remote_updated_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Last updated date"
              },
              "remote_created_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Created date"
              },
              "scientific_topics": {
                "type": "array",
                "description": "EDAM scientific topics",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "preferred_label": {
                      "type": "string"
                    }
                  }
                }
              },
              "operations": {
                "type": "array",
                "description": "EDAM operations covered",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "preferred_label": {
                      "type": "string"
                    }
                  }
                }
              },
              "external_resources": {
                "type": "array",
                "description": "Links to external resources",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
