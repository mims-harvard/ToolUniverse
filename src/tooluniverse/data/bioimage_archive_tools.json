[
  {
    "name": "BioImageArchive_search_studies",
    "description": "Search the BioImage Archive (EBI BioStudies) for biological imaging datasets with explicit page navigation. The BioImage Archive hosts open microscopy, imaging, and visualization data from life sciences research. Search by imaging modality, organism, technique, or topic. Metadata preserves BioStudies' isTotalHitsExact qualifier: when total_hits_relation is lower_bound, total_hits must not be reported as the exact number of matches; continue through next_page until pagination ends.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query - imaging modality, organism, technique, or topic. Examples: 'cryo-EM', 'fluorescence microscopy', 'cell segmentation', 'brain imaging', 'protein localization'."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results per page. Default: 10. Max: 100."
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Page number (1-indexed). Default: 1. Continue with metadata.next_page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "action": "search"
    },
    "type": "BioImageArchiveTool",
    "test_examples": [
      {
        "query": "fluorescence microscopy cell",
        "page_size": 5
      },
      {
        "query": "cryo-EM",
        "page_size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession": {
                "type": "string",
                "description": "Study accession (e.g., S-BIAD634)"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Study title"
              },
              "author": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Author(s)"
              },
              "release_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Release date"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Study type"
              },
              "links": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Number of linked resources"
              },
              "files": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Number of files"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "BioImageArchive_get_study",
    "description": "Get detailed information about a specific BioImage Archive study by accession number. Returns comprehensive metadata including title, description, imaging methods, organism, and file information. Example: 'S-BIAD634' returns an annotated fluorescence image dataset.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "BioImage Archive study accession number. Format: S-BIAD#### or S-BSST#### or S-EPMC#######. Examples: 'S-BIAD634', 'S-BIAD928'."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "action": "get_study"
    },
    "type": "BioImageArchiveTool",
    "test_examples": [
      {
        "accession": "S-BIAD634"
      },
      {
        "accession": "S-BIAD928"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "release_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "organism": {
              "type": [
                "string",
                "null"
              ]
            },
            "imaging_method": {
              "type": [
                "string",
                "null"
              ]
            },
            "attributes": {
              "type": [
                "array",
                "null"
              ]
            },
            "section_type": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "BioImageArchive_search_bioimages",
    "description": "Search the BioImages collection with explicit page pagination. Metadata reports next_page and preserves the upstream isTotalHitsExact qualifier. When total_hits_relation is lower_bound, total_hits is only a lower bound rather than the true total; continue until pagination ends.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for biological imaging data. Examples: 'cell division', 'neuron morphology', 'tissue section', 'live cell imaging'."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Number of results per page. Default: 10. Max: 100."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based result page. Continue with metadata.next_page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "action": "search_bioimages"
    },
    "type": "BioImageArchiveTool",
    "test_examples": [
      {
        "query": "cell division",
        "page_size": 5
      },
      {
        "query": "neuron morphology",
        "page_size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "release_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "BioImageArchive_list_study_files",
    "description": "List the file/image manifest of a BioImage Archive study, giving per-file download paths and per-image experimental annotations. Unlike BioImageArchive_get_study (which returns study-level metadata), this returns the actual files: image Name, relative download path, size, and submitter annotations. Use limit/offset to page through large manifests; metadata preserves records_total and records_filtered and provides has_more and next_offset so every file is reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "BioImage Archive study accession. Format S-BIAD#### / S-BSST#### (e.g. 'S-BIAD144'). Obtain from BioImageArchive_search_studies."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of files to return (default 25, max 500). Values outside this range return an error rather than being silently changed."
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Number of files to skip for pagination (default 0). Continue with metadata.next_offset while metadata.has_more is true."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "action": "list_study_files"
    },
    "type": "BioImageArchiveTool",
    "test_examples": [
      {
        "accession": "S-BIAD144",
        "limit": 5
      },
      {
        "accession": "S-BIAD144",
        "limit": 3,
        "offset": 2
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size": {
                "type": [
                  "integer",
                  "number",
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotations": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
