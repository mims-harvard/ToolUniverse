[
    {
        "name": "ThreeDBeacons_get_structure_summary",
        "description": "Get a summary of all available 3D structure models for a protein from the 3D Beacons Hub. Aggregates data from multiple providers: PDBe (experimental), AlphaFold DB (AI-predicted), SWISS-MODEL (homology), PED (conformational ensembles), AlphaFill, and isoform.io. Returns total structure count broken down by provider and model category (experimentally determined, template-based, ab-initio, conformational ensemble). Example: P04637 (TP53) returns 327 structures from 6 providers: 299 PDBe experimental, 20 PED ensembles, 4 SWISS-MODEL homology models, plus AlphaFold and AlphaFill predictions.",
        "parameter": {
            "type": "object",
            "properties": {
                "accession": {
                    "type": "string",
                    "description": "UniProt protein accession. Examples: 'P04637' (TP53, 327 structures), 'P00533' (EGFR, 407 structures), 'P01308' (Insulin), 'P38398' (BRCA1)."
                }
            },
            "required": [
                "accession"
            ]
        },
        "fields": {
            "endpoint": "summary"
        },
        "type": "ThreeDBeaconsTool",
        "test_examples": [
            {
                "accession": "P04637"
            },
            {
                "accession": "P00533"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "not": {
                        "required": [
                            "error"
                        ]
                    },
                    "type": "object",
                    "properties": {
                        "accession": {
                            "type": "string",
                            "description": "UniProt accession queried"
                        },
                        "sequence_length": {
                            "type": ["integer", "null"],
                            "description": "Full protein sequence length"
                        },
                        "total_structures": {
                            "type": "integer",
                            "description": "Total number of 3D structures/models available"
                        },
                        "by_provider": {
                            "type": "object",
                            "description": "Structure counts by data provider (PDBe, AlphaFold DB, SWISS-MODEL, PED, AlphaFill, isoform.io)"
                        },
                        "by_category": {
                            "type": "object",
                            "description": "Structure counts by model category (EXPERIMENTALLY DETERMINED, TEMPLATE-BASED, AB-INITIO, CONFORMATIONAL ENSEMBLE)"
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "ThreeDBeacons_get_structures",
        "description": "Get detailed 3D structure models for a protein from the 3D Beacons Hub. Returns model identifier, provider, category, coverage, resolution or confidence, and download URL. Supports category/provider filters and recoverable offset pagination. Continue with next_offset while has_more is true; broad proteins can have hundreds of structures (P04637 currently has more than 300).",
        "parameter": {
            "type": "object",
            "properties": {
                "accession": {
                    "type": "string",
                    "description": "UniProt protein accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P01308' (Insulin)."
                },
                "category": {
                    "type": "string",
                    "description": "Filter by model category. Options: 'EXPERIMENTALLY DETERMINED', 'TEMPLATE-BASED', 'AB-INITIO', 'CONFORMATIONAL ENSEMBLE'. Case-insensitive partial match."
                },
                "provider": {
                    "type": "string",
                    "description": "Filter by data provider. Options: 'PDBe', 'AlphaFold DB', 'SWISS-MODEL', 'PED', 'AlphaFill', 'isoform.io'. Case-insensitive partial match."
                },
                "max_results": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Maximum structures to return on this page (default 20).",
                    "default": 20
                },
                "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Zero-based offset in the complete filtered structure list. Continue with data.next_offset.",
                    "default": 0
                }
            },
            "required": [
                "accession"
            ]
        },
        "fields": {
            "endpoint": "structures"
        },
        "type": "ThreeDBeaconsTool",
        "test_examples": [
            {
                "accession": "P04637",
                "category": "TEMPLATE-BASED"
            },
            {
                "accession": "P00533",
                "max_results": 5
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "not": {
                        "required": [
                            "error"
                        ]
                    },
                    "type": "object",
                    "properties": {
                        "accession": {
                            "type": "string",
                            "description": "UniProt accession queried"
                        },
                        "sequence_length": {
                            "type": ["integer", "null"],
                            "description": "Full protein sequence length"
                        },
                        "total_matched": {
                            "type": "integer",
                            "description": "Total structures matching filters"
                        },
                        "returned": {
                            "type": "integer",
                            "description": "Number of structures returned"
                        },
                        "offset": {
                            "type": "integer",
                            "description": "Zero-based offset of this page"
                        },
                        "max_results": {
                            "type": "integer",
                            "description": "Requested page size"
                        },
                        "has_more": {
                            "type": "boolean",
                            "description": "Whether more matching structures are retrievable"
                        },
                        "next_offset": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Offset for the next page, or null at the end"
                        },
                        "result_set_complete": {
                            "type": "boolean",
                            "description": "Whether this response contains the full filtered result set"
                        },
                        "structures": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "model_identifier": {
                                        "type": ["string", "null"],
                                        "description": "Structure/model identifier (PDB ID or model ID)"
                                    },
                                    "model_category": {
                                        "type": ["string", "null"],
                                        "description": "Model category"
                                    },
                                    "provider": {
                                        "type": ["string", "null"],
                                        "description": "Data provider name"
                                    },
                                    "coverage": {
                                        "type": ["number", "null"],
                                        "description": "Fraction of protein covered (0-1)"
                                    },
                                    "resolution": {
                                        "type": ["number", "null"],
                                        "description": "Resolution in Angstroms (experimental only)"
                                    },
                                    "experimental_method": {
                                        "type": ["string", "null"],
                                        "description": "Experimental method (e.g., X-ray diffraction)"
                                    },
                                    "model_url": {
                                        "type": ["string", "null"],
                                        "description": "URL to download the model"
                                    },
                                    "model_format": {
                                        "type": ["string", "null"],
                                        "description": "Format of the file at model_url - MMCIF or PDB - which the caller needs to parse it. 373 of P04637's 375 models are MMCIF and 2 are PDB"
                                    },
                                    "model_page_url": {
                                        "type": ["string", "null"],
                                        "description": "Provider's human-readable page for the model"
                                    },
                                    "sequence_identity": {
                                        "type": ["number", "null"],
                                        "description": "Percent identity to the queried sequence; a structure can cover the protein at 50%"
                                    },
                                    "created": {
                                        "type": ["string", "null"],
                                        "description": "When the model was created"
                                    },
                                    "uniprot_start": {
                                        "type": ["integer", "null"],
                                        "description": "First residue of the queried protein covered"
                                    },
                                    "uniprot_end": {
                                        "type": ["integer", "null"],
                                        "description": "Last residue covered"
                                    },
                                    "confidence_avg_local_score": {
                                        "type": ["number", "null"],
                                        "description": "Mean per-residue confidence, for a predicted model"
                                    },
                                    "entity_count": {
                                        "type": ["integer", "null"],
                                        "description": "Entities the structure has, before the cap"
                                    },
                                    "entity_counts_by_type": {
                                        "type": "object",
                                        "description": "How many entities of each type, so a caller can find the models with a ligand bound without reading them all",
                                        "additionalProperties": {"type": "integer"}
                                    },
                                    "entities_truncated": {
                                        "type": ["boolean", "null"],
                                        "description": "True when ENTITIES_PER_STRUCTURE applied"
                                    },
                                    "entities": {
                                        "type": "array",
                                        "description": "Chains and bound components of the structure, capped at ENTITIES_PER_STRUCTURE",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "entity_type": {
                                                    "type": ["string", "null"],
                                                    "description": "POLYMER, NON-POLYMER (a ligand or ion) or BRANCHED (a glycan)"
                                                },
                                                "entity_poly_type": {
                                                    "type": ["string", "null"],
                                                    "description": "For a polymer, e.g. POLYPEPTIDE(L)"
                                                },
                                                "identifier": {
                                                    "type": ["string", "null"],
                                                    "description": "Accession or chemical id of the entity"
                                                },
                                                "identifier_category": {
                                                    "type": ["string", "null"],
                                                    "description": "Namespace of that identifier, e.g. UNIPROT or CHEMBL"
                                                },
                                                "description": {
                                                    "type": ["string", "null"],
                                                    "description": "Name of the entity"
                                                },
                                                "chain_ids": {
                                                    "type": "array",
                                                    "items": {"type": "string"},
                                                    "description": "Chains this entity occupies"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "ThreeDBeacons_get_annotations",
        "description": "Get residue-level structural and functional annotations mapped onto a protein's 3D models from the 3D Beacons Hub, with the exact residue and region lists plus source/evidence. This is distinct from the model-list summary: it returns features such as DOMAIN, BINDING, ACT_SITE, METAL, DISULFID, MOD_RES, HELIX, STRAND, INTERFACE, CHANNEL, each carrying a description (with InterPro IDs where applicable), source_name (e.g. InterPro), evidence level (e.g. COMPUTATIONAL/PREDICTED), the list of residue numbers, and start/end regions. Example: P38398 (BRCA1) type=DOMAIN returns the 'BRCA1-associated (IPR031099)' domain over residues 7-99.",
        "parameter": {
            "type": "object",
            "properties": {
                "accession": {
                    "type": "string",
                    "description": "UniProt protein accession. Examples: 'P38398' (BRCA1), 'P04637' (TP53), 'P00533' (EGFR)."
                },
                "type": {
                    "type": "string",
                    "description": "Annotation type to filter to -- required by the upstream 3D Beacons API (it 422s without it, confirmed live). Valid values: CARBOHYD, DOMAIN, ACT_SITE, METAL, BINDING, NON_STD, MOD_RES, DISULFID, MUTAGEN, HELIX, STRAND, DISORDERED, INTERFACE, CHANNEL."
                },
                "provider": {
                    "type": ["string", "null"],
                    "description": "Optional model provider to source annotations from: 'pdbe' or 'alphafold'."
                }
            },
            "required": [
                "accession",
                "type"
            ]
        },
        "fields": {
            "endpoint": "annotations"
        },
        "type": "ThreeDBeaconsTool",
        "test_examples": [
            {
                "accession": "P38398",
                "type": "DOMAIN"
            },
            {
                "accession": "P04637",
                "type": "BINDING"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "not": {
                        "required": [
                            "error"
                        ]
                    },
                    "type": "object",
                    "properties": {
                        "accession": {
                            "type": "string",
                            "description": "UniProt accession queried"
                        },
                        "id": {
                            "type": ["string", "null"],
                            "description": "3D Beacons annotation record identifier"
                        },
                        "sequence_length": {
                            "type": ["integer", "null"],
                            "description": "Length of the annotated sequence"
                        },
                        "type_filter": {
                            "type": ["string", "null"],
                            "description": "Annotation type filter applied, if any"
                        },
                        "annotation_count": {
                            "type": "integer",
                            "description": "Number of annotation entries returned"
                        },
                        "annotations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "type": {
                                        "type": ["string", "null"],
                                        "description": "Annotation type (DOMAIN, BINDING, ACT_SITE, etc.)"
                                    },
                                    "description": {
                                        "type": ["string", "null"],
                                        "description": "Human-readable description (may include InterPro IDs)"
                                    },
                                    "source_name": {
                                        "type": ["string", "null"],
                                        "description": "Annotation source (e.g. InterPro, UniProt)"
                                    },
                                    "evidence": {
                                        "type": ["string", "null"],
                                        "description": "Evidence level (e.g. COMPUTATIONAL/PREDICTED, EXPERIMENTAL)"
                                    },
                                    "residues": {
                                        "type": ["array", "null"],
                                        "description": "List of residue numbers covered by the annotation"
                                    },
                                    "regions": {
                                        "type": ["array", "null"],
                                        "description": "List of {start, end} region objects"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": ["error"]
                }
            ]
        }
    }
]
