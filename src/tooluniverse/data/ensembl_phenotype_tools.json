[
  {
    "name": "EnsemblPheno_get_by_gene",
    "description": "Get phenotype associations for a gene from Ensembl with limit/offset pagination and explicit total/has_more metadata. Returns deduplicated diseases, traits, and clinical conditions from Cancer Gene Census, OMIM, ClinVar, NHGRI-EBI GWAS Catalog, Orphanet, and other sources. Example: TP53 currently has more than 400 associations and requires multiple pages.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name. Use 'homo_sapiens' for human. Default: 'homo_sapiens'.",
          "default": "homo_sapiens"
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol. Examples: 'BRCA1', 'TP53', 'EGFR', 'KRAS', 'BRAF'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 200,
          "description": "Maximum number of deduplicated phenotype associations to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based association offset. Use data.next_offset for the next page."
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "endpoint_type": "gene"
    },
    "timeout": 90,
    "type": "EnsemblPhenotypeTool",
    "test_examples": [
      {
        "gene": "BRCA1"
      },
      {
        "gene": "TP53",
        "species": "homo_sapiens"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "phenotype_count": {
              "type": "integer"
            },
            "phenotypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gene_ensembl_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ontology_accessions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "external_references": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblPheno_get_by_region",
    "description": "Get phenotype associations for variants and genes in an Ensembl region with limit/offset pagination and explicit total/has_more metadata. Returns deduplicated disease/trait associations from GWAS Catalog, ClinVar, Cancer Gene Census, and other sources. Even small well-studied regions can exceed 200 associations, so follow next_offset until has_more is false.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name. Use 'homo_sapiens' for human. Default: 'homo_sapiens'.",
          "default": "homo_sapiens"
        },
        "region": {
          "type": "string",
          "description": "Genomic region in format 'chromosome:start-end'. Example: '17:7661779-7687538' for TP53, '17:43044295-43125482' for BRCA1. Keep regions under 5Mb for reasonable response times."
        },
        "feature_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by feature type: 'Variation' (variants only), 'Gene' (genes only), 'QTL' (quantitative trait loci). Default: all types."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 200,
          "description": "Maximum number of deduplicated phenotype associations to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based association offset. Use data.next_offset for the next page."
        }
      },
      "required": [
        "region"
      ]
    },
    "fields": {
      "endpoint_type": "region"
    },
    "timeout": 90,
    "type": "EnsemblPhenotypeTool",
    "test_examples": [
      {
        "region": "17:7661779-7687538"
      },
      {
        "region": "7:140424943-140524564",
        "species": "homo_sapiens"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "region": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "phenotype_count": {
              "type": "integer"
            },
            "phenotypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ontology_accessions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblPheno_get_by_term",
    "description": "Reverse phenotype lookup from the Ensembl REST API: given a trait/disease name or ontology accession, return associated variants and genes with risk allele, p-value, beta, clinical significance, and source. Large result sets are paged with limit/offset; total_associations and next_offset make every association reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name. Use 'homo_sapiens' for human. Default: 'homo_sapiens'.",
          "default": "homo_sapiens"
        },
        "term": {
          "type": [
            "string",
            "null"
          ],
          "description": "Trait or disease name. Examples: 'Alzheimer disease', 'Coronary artery disease', 'Type 2 diabetes mellitus'. If you pass an ontology accession (e.g. 'EFO:0000249') here it is auto-detected and routed correctly."
        },
        "accession": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ontology accession (EFO, HP, MONDO, Orphanet). Examples: 'EFO:0000249' (Alzheimer disease), 'HP:0002511' (Alzheimer disease phenotype), 'MONDO:0004975'. Mutually exclusive with 'term'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 500,
          "description": "Maximum associations per page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based association offset. Continue with data.next_offset while has_more is true."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "term"
    },
    "type": "EnsemblPhenotypeTool",
    "test_examples": [
      {
        "term": "Alzheimer disease"
      },
      {
        "accession": "EFO:0000249"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "query_kind": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "association_count": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "associations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "variant": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gene": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "risk_allele": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "p_value": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "beta": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "odds_ratio": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "clinical_significance": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mapped_to_accession": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "external_reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblPheno_get_by_variant",
    "description": "Get phenotype associations for a specific variant (by rsID) from the Ensembl REST API. Returns traits, diseases, and phenotypes from sources such as the NHGRI-EBI GWAS catalog and ClinVar. Large result sets are paged with limit/offset; total_phenotypes and next_offset make every association reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name. Use 'homo_sapiens' for human. Default: 'homo_sapiens'.",
          "default": "homo_sapiens"
        },
        "variant_id": {
          "type": "string",
          "description": "Variant rsID. Examples: 'rs429358' (APOE e4), 'rs7903146' (TCF7L2 diabetes), 'rs1801133' (MTHFR)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 200,
          "description": "Maximum phenotype associations per page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based association offset. Continue with data.next_offset while has_more is true."
        }
      },
      "required": [
        "variant_id"
      ]
    },
    "fields": {
      "endpoint_type": "variant"
    },
    "type": "EnsemblPhenotypeTool",
    "test_examples": [
      {
        "variant_id": "rs429358"
      },
      {
        "variant_id": "rs7903146",
        "species": "homo_sapiens"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "variant_id": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "phenotype_count": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "phenotypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "trait": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "risk_allele": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pvalue": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "beta_coefficient": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "study": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "genes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ontology_accessions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
