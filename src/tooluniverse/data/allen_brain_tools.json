[
  {
    "name": "AllenBrain_search_genes",
    "description": "Search Allen Brain Atlas genes by symbol or name with exact RMA row pagination. Metadata reports the upstream total and next_start_row so later gene matches remain reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_acronym": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gene symbol/acronym for exact match. Examples: 'Gad1', 'Pvalb', 'Sst', 'Bdnf', 'Th'."
        },
        "gene_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gene name for partial match search (alternative to gene_acronym). Example: 'glutamate decarboxylase'."
        },
        "num_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "Results per page (1-2000).",
          "default": 50
        },
        "start_row": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based RMA row offset. Continue with metadata.next_start_row."
        }
      }
    },
    "fields": {
      "query_type": "gene_search"
    },
    "type": "AllenBrainTool",
    "test_examples": [
      {
        "gene_acronym": "Gad1"
      },
      {
        "gene_name": "parvalbumin",
        "num_rows": 10
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Allen Brain Atlas gene ID"
          },
          "acronym": {
            "type": [
              "string",
              "null"
            ],
            "description": "Gene symbol"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full gene name"
          },
          "entrez_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "NCBI Entrez Gene ID"
          },
          "homologene_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "chromosome_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "organism_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "2=mouse, 1=human, 3=rat"
          },
          "ensembl_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "alias_tags": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "sphinx_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "version_status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  {
    "name": "AllenBrain_search_structures",
    "description": "Search Allen Brain Atlas structures by acronym or name with exact RMA row pagination. Metadata reports the upstream total and next_start_row so later structures remain reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "acronym": {
          "type": [
            "string",
            "null"
          ],
          "description": "Structure acronym for exact match. Examples: 'CA1', 'VISp', 'TH', 'HIP', 'CTX'."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Structure name for partial match (alternative to acronym). Example: 'hippocampus', 'cerebellum'."
        },
        "num_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "Results per page (1-2000).",
          "default": 50
        },
        "start_row": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based RMA row offset. Continue with metadata.next_start_row."
        }
      }
    },
    "fields": {
      "query_type": "structure_search"
    },
    "type": "AllenBrainTool",
    "test_examples": [
      {
        "acronym": "CA1"
      },
      {
        "name": "hippocampus",
        "num_rows": 10
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Structure ID"
          },
          "acronym": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "safe_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "color_hex_triplet": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hex color for visualization"
          },
          "graph_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "graph_order": {
            "type": [
              "integer",
              "null"
            ]
          },
          "parent_structure_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "structure_id_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hierarchical path of structure IDs"
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Depth in the ontology hierarchy"
          },
          "ontology_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "atlas_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hemisphere_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "failed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "failed_facet": {
            "type": [
              "integer",
              "null"
            ]
          },
          "st_level": {
            "type": [
              "integer",
              "null"
            ]
          },
          "weight": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sphinx_id": {
            "description": "Allen's internal search-index id."
          },
          "structure_name_facet": {
            "description": "Allen's internal facet id for the name."
          }
        }
      }
    }
  },
  {
    "name": "AllenBrain_get_expression_datasets",
    "description": "Get Allen Mouse Brain ISH expression datasets for a gene with exact RMA row pagination. Failed experiments are excluded from data, while metadata separately reports the upstream total including failed rows, failed rows on this page, and next_start_row.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_acronym": {
          "type": "string",
          "description": "Gene symbol/acronym. Examples: 'Gad1', 'Pvalb', 'Sst', 'Bdnf', 'Th', 'Slc17a7'."
        },
        "product_id": {
          "type": "integer",
          "description": "Product ID for the dataset type. 1=Mouse Brain ISH, 2=Mouse Brain microarray. Default: 1.",
          "default": 1
        },
        "num_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "Results per page (1-2000).",
          "default": 50
        },
        "start_row": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based RMA row offset. Continue with metadata.next_start_row."
        }
      },
      "required": [
        "gene_acronym"
      ]
    },
    "fields": {
      "query_type": "expression_data"
    },
    "type": "AllenBrainTool",
    "test_examples": [
      {
        "gene_acronym": "Gad1"
      },
      {
        "gene_acronym": "Pvalb",
        "num_rows": 10
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Section data set ID"
          },
          "plane_of_section_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "section_thickness": {
            "type": [
              "number",
              "null"
            ]
          },
          "expression": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "failed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the experiment failed QC. A failed dataset is not usable evidence and this was undeclared"
          },
          "delegate": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "storage_directory": {
            "type": [
              "string",
              "null"
            ]
          },
          "specimen_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reference_space_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "qc_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "When QC was performed"
          },
          "genes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "acronym": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Gene acronym"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Gene name"
                },
                "entrez_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "NCBI Entrez gene id"
                },
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Allen gene id"
                },
                "original_symbol": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Symbol as originally submitted"
                },
                "original_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Name as originally submitted"
                },
                "alias_tags": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Alternative symbols"
                },
                "homologene_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "HomoloGene group id, for cross-species comparison"
                },
                "chromosome_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Allen chromosome id"
                },
                "organism_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Allen organism id"
                },
                "genomic_reference_update_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Which genome build update the record reflects"
                },
                "version_status": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Status of this gene record version"
                },
                "sphinx_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Allen search-index id"
                }
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "array",
                  "object",
                  "null"
                ]
              }
            },
            "description": "The genes the experiment measured"
          },
          "failed_facet": {
            "type": [
              "string",
              "integer",
              "null"
            ],
            "description": "Which QC facet failed"
          },
          "weight": {
            "type": [
              "number",
              "integer",
              "null"
            ],
            "description": "Allen's internal ranking weight for the dataset"
          },
          "sphinx_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Allen search-index id"
          }
        }
      }
    }
  },
  {
    "name": "AllenBrain_get_structure",
    "description": "Get detailed information about a brain structure by its Allen Brain Atlas structure ID. Returns full structure record including name, hierarchy path, parent structure, color code. Example: structure_id=382 returns 'Field CA1' in hippocampus.",
    "parameter": {
      "type": "object",
      "properties": {
        "structure_id": {
          "type": "integer",
          "description": "Allen Brain Atlas structure ID. Examples: 382 (CA1), 375 (Hippocampus), 315 (Isocortex), 997 (root)."
        }
      },
      "required": [
        "structure_id"
      ]
    },
    "fields": {
      "query_type": "structure_lookup"
    },
    "type": "AllenBrainTool",
    "test_examples": [
      {
        "structure_id": 382
      },
      {
        "structure_id": 375
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "acronym": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_hex_triplet": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "graph_order": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parent_structure_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "structure_id_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ontology_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "atlas_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hemisphere_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "failed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "failed_facet": {
          "type": [
            "integer",
            "null"
          ]
        },
        "st_level": {
          "type": [
            "integer",
            "null"
          ]
        },
        "weight": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sphinx_id": {
          "description": "Allen's internal search-index id."
        },
        "structure_name_facet": {
          "description": "Allen's internal facet id for the name."
        }
      }
    }
  },
  {
    "name": "AllenBrain_get_structure_expression_values",
    "description": "Get quantified StructureUnionize expression values for one Allen Mouse Brain ISH experiment. Each dataset can contain about 2400 brain-structure rows; use start_row and follow metadata.next_start_row instead of treating the default 50-row page as complete. Returns expression_energy, expression_density, sum_expressing_pixels and optional structure records.",
    "parameter": {
      "type": "object",
      "properties": {
        "section_data_set_id": {
          "type": "integer",
          "description": "Allen Brain Atlas SectionDataSet (ISH experiment) ID. Get one from AllenBrain_get_expression_datasets. Example: 75457539 (a Gad1 mouse-brain ISH dataset)."
        },
        "include_structure": {
          "type": "boolean",
          "description": "Whether to include the linked brain structure record (acronym, name, hierarchy) for each row. Default: true.",
          "default": true
        },
        "num_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "Per-structure rows per page (1-2000). There are approximately 2400 rows per dataset; continue with start_row.",
          "default": 50
        },
        "start_row": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based RMA row offset. Continue with metadata.next_start_row."
        }
      },
      "required": [
        "section_data_set_id"
      ]
    },
    "fields": {
      "query_type": "structure_unionize"
    },
    "type": "AllenBrainTool",
    "test_examples": [
      {
        "section_data_set_id": 75457539,
        "num_rows": 3
      },
      {
        "section_data_set_id": 75457539,
        "include_structure": false,
        "num_rows": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "description": "Per-structure quantified expression values for the ISH dataset",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "StructureUnionize record ID"
          },
          "section_data_set_id": {
            "type": "integer",
            "description": "Source ISH experiment (SectionDataSet) ID"
          },
          "structure_id": {
            "type": "integer",
            "description": "Allen Brain Atlas structure (brain region) ID"
          },
          "expression_energy": {
            "type": [
              "number",
              "null"
            ],
            "description": "Expression energy = sum of expressing pixel intensity / total pixels (intensity x density)"
          },
          "expression_density": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fraction of pixels in the structure that express the gene"
          },
          "sum_expressing_pixels": {
            "type": [
              "number",
              "null"
            ],
            "description": "Total number of expressing pixels in the structure"
          },
          "sum_expressing_pixel_intensity": {
            "type": [
              "number",
              "null"
            ]
          },
          "sum_pixels": {
            "type": [
              "number",
              "null"
            ]
          },
          "sum_pixel_intensity": {
            "type": [
              "number",
              "null"
            ]
          },
          "voxel_energy_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "voxel_energy_cv": {
            "type": [
              "number",
              "null"
            ]
          },
          "structure": {
            "type": [
              "object",
              "null"
            ],
            "description": "The brain structure the values were measured in. The row carried a structure_id and this block, which names it and places it in the ontology, was undeclared - so an expression value could not be attributed to a named region without a second lookup.",
            "properties": {
              "id": {
                "type": "integer"
              },
              "acronym": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "safe_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The structure's full name, e.g. 'lateral wings of the dorsal raphe nucleus'. The field that makes a row readable."
              },
              "structure_id_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Path of ancestor ids from the root, e.g. '/15564/15565/16808/.../112892315/'. Lets a value be rolled up to a coarser region without fetching the ontology."
              },
              "parent_structure_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Id of the immediate parent structure."
              },
              "depth": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Depth in the structure tree."
              },
              "st_level": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Allen's structure level, a coarser grouping than depth."
              },
              "graph_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Which structure graph this id belongs to; ids are only unique within a graph."
              },
              "graph_order": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Position in the graph's canonical ordering, which is the order Allen's own figures use."
              },
              "ontology_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Which Allen ontology the structure comes from."
              },
              "hemisphere_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Hemisphere: 1 left, 2 right, 3 both."
              },
              "color_hex_triplet": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Allen's colour for the structure, e.g. 'D332E6', so a plot can match their atlas figures."
              },
              "atlas_id": {
                "description": "Atlas the structure belongs to, when Allen records one; null for many structures."
              },
              "failed": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Allen's QC flag on the structure record."
              },
              "failed_facet": {
                "description": "Allen's internal facet id for failed records."
              },
              "sphinx_id": {
                "description": "Allen's internal search-index id."
              },
              "structure_name_facet": {
                "description": "Allen's internal facet id for the name."
              },
              "weight": {
                "description": "Allen's internal ordering weight."
              }
            }
          }
        }
      }
    }
  }
]
