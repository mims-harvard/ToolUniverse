[
  {
    "name": "InterPro_get_entries_for_protein",
    "description": "Get InterPro domain and family entries annotated on a protein. Results are cursor-paginated when needed: pass next_cursor as cursor while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt protein accession. Examples: 'P04637' (TP53, 9 entries), 'P00533' (EGFR), 'P01308' (Insulin), 'P38398' (BRCA1)."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100,
          "description": "Maximum entries to return per page (default 100, max 200)."
        },
        "cursor": {
          "type": ["string", "null"],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "entries_for_protein"
    },
    "type": "InterProEntryTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protein_accession": {
              "type": "string"
            },
            "total_entries": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_cursor": {"type": ["string", "null"]},
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "source_database": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "protein_accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "InterPro_search_entries",
    "description": "Search InterPro entries (domains, families, sites) by keyword. Results are cursor-paginated: when has_more is true, pass next_cursor as cursor with the same query and filters.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search keyword. Examples: 'zinc finger' (466 entries), 'kinase', 'immunoglobulin', 'helicase', 'protease', 'p53'."
        },
        "entry_type": {
          "type": "string",
          "enum": ["domain", "family", "homologous_superfamily", "repeat", "conserved_site", "active_site", "binding_site", "ptm"],
          "description": "Filter by entry type. Options: 'domain', 'family', 'homologous_superfamily', 'repeat', 'conserved_site', 'active_site', 'binding_site', 'ptm'."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Number of results to return (1-50, default 20).",
          "default": 20
        },
        "cursor": {
          "type": ["string", "null"],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_entries"
    },
    "type": "InterProEntryTool",
    "test_examples": [
      {
        "query": "zinc finger"
      },
      {
        "query": "kinase",
        "entry_type": "domain",
        "page_size": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "total_results": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": [
                "integer",
                "number"
              ]
            },
            "has_more": {"type": "boolean"},
            "next_cursor": {"type": ["string", "null"]},
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "protein_count": {
                    "type": "null"
                  },
                  "structure_count": {
                    "type": "null"
                  },
                  "taxa_count": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "required": [
            "query"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
