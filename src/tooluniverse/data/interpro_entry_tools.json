[
  {
    "name": "InterPro_get_entries_for_protein",
    "description": "Get InterPro domain and family entries annotated on a protein. Results are cursor-paginated when needed: pass next_cursor as cursor while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt protein accession. Examples: 'P04637' (TP53, 9 entries), 'P00533' (EGFR), 'P01308' (Insulin), 'P38398' (BRCA1)."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100,
          "description": "Maximum entries to return per page (default 100, max 200)."
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "entries_for_protein"
    },
    "type": "InterProEntryTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protein_accession": {
              "type": "string"
            },
            "total_entries": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "source_database": {
                    "type": "string"
                  },
                  "integrated_interpro": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "InterPro accession this member-database signature is integrated into, null when it stands alone"
                  },
                  "member_databases": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Member-database signatures behind this InterPro entry, keyed by database then accession"
                  },
                  "go_terms": {
                    "type": "array",
                    "description": "GO terms the entry is annotated to",
                    "items": {
                      "type": "object",
                      "properties": {
                        "identifier": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GO id"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Term name"
                        },
                        "category": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GO domain, from the term's category name"
                        }
                      }
                    }
                  },
                  "match_locations": {
                    "type": "array",
                    "description": "Where on this protein the entry matches - the part of a domain hit that says which residues it covers",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "First residue of the match"
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "Last residue of the match"
                        },
                        "fragments": {
                          "type": "array",
                          "description": "Discontinuous pieces of the match",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "First residue of the fragment"
                              },
                              "end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Last residue of the fragment"
                              },
                              "status": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "InterPro's continuity code for the fragment, e.g. S for a single continuous piece"
                              }
                            }
                          }
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Signature model the match came from"
                        },
                        "score": {
                          "type": [
                            "number",
                            "integer",
                            "null"
                          ],
                          "description": "Match score or e-value as InterPro reports it"
                        },
                        "representative": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether InterPro treats this as the representative match"
                        }
                      }
                    }
                  },
                  "match_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of match locations on this protein"
                  },
                  "protein_length": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Length of the queried protein in residues"
                  },
                  "protein_source_database": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Database the protein record came from, reviewed or unreviewed"
                  },
                  "in_alphafold": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether AlphaFold DB holds a model for the protein"
                  }
                }
              }
            },
            "page_size": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Entries requested per page"
            },
            "truncated": {
              "type": "boolean",
              "description": "True when entries is not the whole set"
            },
            "result_set_complete": {
              "type": "boolean",
              "description": "True only when every entry was returned"
            },
            "pagination_stalled": {
              "type": "boolean",
              "description": "True when the cursor stopped advancing"
            }
          },
          "required": [
            "protein_accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "InterPro_search_entries",
    "description": "Search InterPro entries (domains, families, sites) by keyword. Results are cursor-paginated: when has_more is true, pass next_cursor as cursor with the same query and filters.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search keyword. Examples: 'zinc finger' (466 entries), 'kinase', 'immunoglobulin', 'helicase', 'protease', 'p53'."
        },
        "entry_type": {
          "type": "string",
          "enum": [
            "domain",
            "family",
            "homologous_superfamily",
            "repeat",
            "conserved_site",
            "active_site",
            "binding_site",
            "ptm"
          ],
          "description": "Filter by entry type. Options: 'domain', 'family', 'homologous_superfamily', 'repeat', 'conserved_site', 'active_site', 'binding_site', 'ptm'."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Number of results to return (1-50, default 20).",
          "default": 20
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_entries"
    },
    "type": "InterProEntryTool",
    "test_examples": [
      {
        "query": "zinc finger"
      },
      {
        "query": "kinase",
        "entry_type": "domain",
        "page_size": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "total_results": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": [
                "integer",
                "number"
              ]
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "protein_count": {
                    "type": "integer",
                    "description": "UniProt proteins matched by the entry. The listing fills this only when it asks the API for extra_fields=counts; measured as an integer for all 450 entries returned by 10 queries."
                  },
                  "structure_count": {
                    "type": "integer",
                    "description": "PDB structures containing the entry. Integer for all 450 entries measured."
                  },
                  "taxa_count": {
                    "type": "integer",
                    "description": "Distinct taxa the entry is seen in. Integer for all 450 entries measured."
                  }
                }
              }
            }
          },
          "required": [
            "query"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
