[
  {
    "name": "PDB_REDO_get_structure_quality",
    "type": "BaseRESTTool",
    "description": "Get re-refined structure quality metrics from PDB-REDO for a given PDB entry. PDB-REDO is a databank of optimized macromolecular structures: all PDB X-ray structures are re-refined using the latest crystallographic methods, improving R-factors, geometry, and fit to electron density. Returns 200+ quality metrics including: R-factor (RFIN), R-free (RFFIN), resolution (DATARESH), correlation coefficients (CCFFIN, CCWFIN), Ramachandran Z-score (ZRAMA), packing Z-score (ZPACKING), B-factor average (BAVER), number of backbone/sidechain flips (NBBFLIP/NSCFLIP), space group (SPACEGROUP), and unit cell dimensions. Only available for X-ray crystal structures. Use lowercase PDB IDs.",
    "parameter": {
      "type": "object",
      "properties": {
        "pdb_id": {
          "type": "string",
          "description": "PDB entry ID in lowercase. Examples: '1cbs' (cellular retinoic acid binding protein), '6lu7' (SARS-CoV-2 main protease), '2hhb' (hemoglobin). Note: not all PDB entries have PDB-REDO data; mainly X-ray crystal structures."
        }
      },
      "required": [
        "pdb_id"
      ]
    },
    "fields": {
      "endpoint": "https://pdb-redo.eu/db/{pdb_id}/data.json",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "PDB-REDO structure data with quality metrics",
          "properties": {
            "pdbid": {
              "type": "string",
              "description": "PDB entry ID"
            },
            "properties": {
              "type": "object",
              "description": "PDB-REDO's refinement statistics. Which metrics are present depends on the entry: 1cbs returns 208 and 2por 184, the latter a strict subset. The well-understood ones are declared by name; the rest are PDB-REDO's own metric names, for which no public data dictionary was reachable, so they are left as an open level rather than given descriptions that would be guesses",
              "properties": {
                "RFIN": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Final R-factor after re-refinement"
                },
                "RFFIN": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Final R-free after re-refinement"
                },
                "ROLD": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Original R-factor before re-refinement"
                },
                "RFOLD": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Original R-free before re-refinement"
                },
                "DATARESH": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Resolution in Angstroms"
                },
                "EXPTYP": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Experimental method (e.g., 'X-ray')"
                },
                "DYEAR": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Deposition year"
                },
                "SPACEGROUP": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Crystal space group"
                },
                "BAVER": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Mean atomic B-factor, in angstrom squared"
                },
                "CCFFIN": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Final correlation coefficient (Fc vs Fo)"
                },
                "CCWFIN": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Final weighted correlation coefficient"
                },
                "ZRAMA": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Ramachandran Z-score"
                },
                "ZPACKING": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Packing Z-score"
                },
                "NBBFLIP": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Number of backbone flips"
                },
                "NSCFLIP": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Number of sidechain flips"
                },
                "RFREE": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Free R-factor of the original structure"
                },
                "RESOLUTION": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Resolution of the diffraction data, in angstrom"
                },
                "DATARESL": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Low-resolution limit of the data, in angstrom"
                },
                "COMPLETED": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Percentage completeness of the diffraction data"
                },
                "BWILS": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Wilson B-factor, in angstrom squared"
                },
                "AAXIS": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell a axis, in angstrom"
                },
                "BAXIS": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell b axis, in angstrom"
                },
                "CAXIS": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell c axis, in angstrom"
                },
                "ALPHA": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell alpha angle, in degrees"
                },
                "BETA": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell beta angle, in degrees"
                },
                "GAMMA": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Unit cell gamma angle, in degrees"
                }
              },
              "additionalProperties": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "One PDB-REDO metric, keyed by its PDB-REDO name"
              }
            },
            "rama-angles": {
              "type": [
                "array",
                "null"
              ],
              "description": "Per-residue Ramachandran angles before and after re-refinement. This is the one place the tool shows what PDB-REDO actually changed, residue by residue, and it was entirely undeclared",
              "items": {
                "type": "object",
                "properties": {
                  "entity_id": {
                    "type": [
                      "integer",
                      "string",
                      "null"
                    ],
                    "description": "Entity the chains belong to"
                  },
                  "chains": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "description": "Chains in the entity",
                    "items": {
                      "type": "object",
                      "properties": {
                        "asym_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Chain id in the mmCIF asym numbering"
                        },
                        "auth_asym_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Chain id as the depositor labelled it"
                        },
                        "models": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "description": "Models in the entry",
                          "items": {
                            "type": "object",
                            "properties": {
                              "model_id": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Model number"
                              },
                              "residues": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "description": "Residues, each with its angles before and after",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "seq_id": {
                                      "type": [
                                        "integer",
                                        "null"
                                      ],
                                      "description": "Residue number in the mmCIF sequence"
                                    },
                                    "auth_seq_id": {
                                      "type": [
                                        "string",
                                        "integer",
                                        "null"
                                      ],
                                      "description": "Residue number as the depositor numbered it"
                                    },
                                    "compound_id": {
                                      "type": [
                                        "string",
                                        "null"
                                      ],
                                      "description": "Residue type, e.g. PRO"
                                    },
                                    "orig": {
                                      "type": [
                                        "object",
                                        "null"
                                      ],
                                      "description": "The angles in the original deposited structure",
                                      "properties": {
                                        "phi": {
                                          "type": [
                                            "number",
                                            "null"
                                          ],
                                          "description": "Phi torsion in degrees"
                                        },
                                        "psi": {
                                          "type": [
                                            "number",
                                            "null"
                                          ],
                                          "description": "Psi torsion in degrees"
                                        },
                                        "rama": {
                                          "type": [
                                            "string",
                                            "number",
                                            "null"
                                          ],
                                          "description": "Ramachandran classification PDB-REDO assigned"
                                        }
                                      }
                                    },
                                    "redo": {
                                      "type": [
                                        "object",
                                        "null"
                                      ],
                                      "description": "The angles after PDB-REDO re-refined it",
                                      "properties": {
                                        "phi": {
                                          "type": [
                                            "number",
                                            "null"
                                          ],
                                          "description": "Phi torsion in degrees"
                                        },
                                        "psi": {
                                          "type": [
                                            "number",
                                            "null"
                                          ],
                                          "description": "Psi torsion in degrees"
                                        },
                                        "rama": {
                                          "type": [
                                            "string",
                                            "number",
                                            "null"
                                          ],
                                          "description": "Ramachandran classification PDB-REDO assigned"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "1cbs"
      },
      {
        "pdb_id": "6lu7"
      }
    ]
  },
  {
    "name": "PDB_REDO_get_version_info",
    "type": "BaseRESTTool",
    "description": "Get PDB-REDO re-refinement version and provenance metadata for a PDB entry. This is the versions.json file, separate from the quality-metrics data.json: it reports the pdb-redo pipeline version used, the mmCIF coordinate revision (major/minor), the reflections revision, whether coordinates or reflections were edited, Foldit-player provenance (foldit_used, foldit_id, foldit_player), and the version/used flag of every supporting crystallographic program (mtzdmp, WHAT_CHECK, refmac, etc.). Use lowercase PDB IDs. Only X-ray structures present in PDB-REDO have version info.",
    "parameter": {
      "type": "object",
      "properties": {
        "pdb_id": {
          "type": "string",
          "description": "PDB entry ID in lowercase. Examples: '1cbs', '6lu7', '2hhb'. Not all PDB entries have PDB-REDO data (mainly X-ray crystal structures)."
        }
      },
      "required": [
        "pdb_id"
      ]
    },
    "fields": {
      "endpoint": "https://pdb-redo.eu/db/{pdb_id}/versions.json",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "description": "Provenance metadata",
              "properties": {
                "PDBID": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "coordinates_revision_major_mmCIF": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Major coordinate revision number (mmCIF)"
                },
                "coordinates_revision_minor_mmCIF": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Minor coordinate revision number (mmCIF)"
                },
                "coordinates_edited": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "reflections_revision": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reflections_edited": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "foldit_used": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "foldit_id": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                },
                "foldit_player": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "software": {
              "type": "object",
              "description": "Per-program version and 'used' flag (key 'pdb-redo' carries the pipeline version, e.g. '8.21')"
            }
          },
          "required": [
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "pdb_id": "1cbs"
      },
      {
        "pdb_id": "6lu7"
      }
    ]
  }
]
