[
  {
    "name": "Progenetix_search_biosamples",
    "description": "Search cancer tumor biosamples in Progenetix by NCIt disease code. Returns diagnoses, stage, and every external reference with its id, label, description, URL/reference, and notes; reference metadata is not discarded. Use skip/limit and next_skip while has_more is true to retrieve all results.",
    "parameter": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "string",
          "description": "NCIt ontology code to filter biosamples by cancer type. Examples: 'NCIT:C3058' (Glioblastoma), 'NCIT:C4017' (Breast Carcinoma), 'NCIT:C9145' (Acute Myeloid Leukemia), 'NCIT:C3224' (Melanoma), 'NCIT:C4872' (Lung Adenocarcinoma), 'NCIT:C3167' (Neuroblastoma)."
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of biosamples to return (default: 10)."
        },
        "skip": {
          "type": "integer",
          "default": 0,
          "description": "Number of results to skip for pagination (default: 0)."
        }
      },
      "required": ["filters"]
    },
    "fields": {
      "endpoint": "biosamples"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {"filters": "NCIT:C3058", "limit": 3},
      {"filters": "NCIT:C4017", "limit": 3}
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "filters": {"type": "string"},
        "total_count": {"type": "integer"},
        "returned_count": {"type": "integer"},
        "skip": {"type": "integer"},
        "limit": {"type": "integer"},
        "has_more": {"type": "boolean"},
        "next_skip": {"type": ["integer", "null"]},
        "biosamples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"]},
              "biosample_status": {"type": ["string", "null"]},
              "histological_diagnosis": {"type": ["string", "null"]},
              "histological_diagnosis_id": {"type": ["string", "null"]},
              "pathological_stage": {"type": ["string", "null"]},
              "pathological_tnm": {"type": ["string", "null"]},
              "sample_origin_type": {"type": ["string", "null"]},
              "external_references": {
                "type": "array",
                "items": {"type": "object"}
              },
              "external_references_count": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "Progenetix_search_individuals",
    "description": "Search individuals (patients) in the Progenetix cancer CNV database by NCIt disease code. Returns sex, diagnosis, onset, and every external reference with id, label, description, URL/reference, and notes. Use skip/limit and next_skip while has_more is true; broad diseases can contain hundreds of patients.",
    "parameter": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "string",
          "description": "NCIt ontology code to filter individuals by cancer type. Examples: 'NCIT:C9145' (AML), 'NCIT:C3058' (Glioblastoma), 'NCIT:C4017' (Breast Carcinoma), 'NCIT:C3224' (Melanoma)."
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of individuals to return (default: 10)."
        },
        "skip": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Number of matching individuals to skip. Use next_skip from the preceding response for the next page."
        }
      },
      "required": ["filters"]
    },
    "fields": {
      "endpoint": "individuals"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {"filters": "NCIT:C3058", "limit": 3},
      {"filters": "NCIT:C9145", "limit": 3}
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "filters": {"type": "string"},
        "total_count": {"type": "integer"},
        "returned_count": {"type": "integer"},
        "skip": {"type": "integer"},
        "limit": {"type": "integer"},
        "has_more": {"type": "boolean"},
        "next_skip": {"type": ["integer", "null"]},
        "individuals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"]},
              "sex": {"type": ["string", "null"]},
              "index_disease": {"type": ["string", "null"]},
              "index_disease_id": {"type": ["string", "null"]},
              "onset_age": {"type": ["string", "null"]},
              "external_references": {
                "type": "array",
                "items": {"type": "object"}
              },
              "external_references_count": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "Progenetix_list_filtering_terms",
    "description": "List Progenetix filtering terms (ontology codes) with matching-sample counts. Prefix filtering is applied client-side before exact total_terms and recoverable offset pagination; continue with data.next_offset while has_more is true. The live NCIT catalog currently contains more than 600 terms.",
    "parameter": {
      "type": "object",
      "properties": {
        "prefixes": {
          "type": "string",
          "default": "NCIT",
          "description": "Ontology prefix to filter terms by. Use 'NCIT' for NCI Thesaurus cancer types (default), 'EDAM' for operation types, 'HP' for HPO phenotypes."
        },
        "limit": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of terms to return (default: 25)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset after prefix filtering. Continue with data.next_offset."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "filtering_terms"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {"prefixes": "NCIT", "limit": 10},
      {"limit": 5}
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "prefixes": {"type": "string"},
        "total_terms": {"type": "integer"},
        "returned": {"type": "integer"},
        "offset": {"type": "integer"},
        "limit": {"type": "integer"},
        "has_more": {"type": "boolean"},
        "next_offset": {"type": ["integer", "null"]},
        "result_set_complete": {"type": "boolean"},
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"]},
              "label": {"type": ["string", "null"]},
              "count": {"type": ["integer", "null"]},
              "type": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  },
  {
    "name": "Progenetix_list_cohorts",
    "description": "List Progenetix cohorts with IDs, names, sizes, types, and data types. Returns exact total_cohorts and recoverable offset pagination; continue with data.next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of cohorts to return (default: 10)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset in the complete cohort list. Continue with data.next_offset."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "cohorts"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {"limit": 5},
      {}
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "total_cohorts": {"type": "integer"},
        "returned": {"type": "integer"},
        "offset": {"type": "integer"},
        "limit": {"type": "integer"},
        "has_more": {"type": "boolean"},
        "next_offset": {"type": ["integer", "null"]},
        "result_set_complete": {"type": "boolean"},
        "cohorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"]},
              "name": {"type": ["string", "null"]},
              "cohort_size": {"type": ["integer", "null"]},
              "cohort_type": {"type": ["string", "null"]},
              "data_types": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "Progenetix_cnv_search",
    "description": "Search for cancer biosamples with copy number variations (CNVs) in a specific genomic region. Combines disease and genomic filters and returns complete external-reference metadata (id, label, description, URL/reference, and notes) instead of only reference IDs.",
    "parameter": {
      "type": "object",
      "properties": {
        "reference_name": {
          "type": "string",
          "description": "RefSeq chromosome accession. Examples: 'refseq:NC_000007.14' (chr7/GRCh38), 'refseq:NC_000017.11' (chr17/GRCh38), 'refseq:NC_000001.11' (chr1/GRCh38)."
        },
        "start": {
          "type": "integer",
          "description": "Start position (1-based, GRCh38). Example: 55019017 for EGFR start."
        },
        "end": {
          "type": "integer",
          "description": "End position (1-based, GRCh38). Example: 55211628 for EGFR end."
        },
        "variant_type": {
          "type": "string",
          "description": "CNV type: 'DUP' for amplification/duplication, 'DEL' for deletion. Leave empty for any CNV type.",
          "default": ""
        },
        "filters": {
          "type": "string",
          "description": "Optional NCIt ontology code to filter by cancer type. Example: 'NCIT:C4017' for breast cancer.",
          "default": ""
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of biosamples to return (default: 10)."
        }
      },
      "required": ["reference_name", "start", "end"]
    },
    "fields": {
      "endpoint": "cnv_search"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {
        "reference_name": "refseq:NC_000007.14",
        "start": 55019017,
        "end": 55211628,
        "variant_type": "DUP",
        "filters": "NCIT:C4017",
        "limit": 3
      },
      {
        "reference_name": "refseq:NC_000017.11",
        "start": 7669000,
        "end": 7690000,
        "variant_type": "DEL",
        "limit": 3
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "region": {"type": "string"},
        "variant_type": {"type": "string"},
        "filters": {"type": "string"},
        "total_count": {"type": "integer"},
        "returned_count": {"type": "integer"},
        "biosamples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"]},
              "biosample_status": {"type": ["string", "null"]},
              "histological_diagnosis": {"type": ["string", "null"]},
              "histological_diagnosis_id": {"type": ["string", "null"]},
              "external_references": {
                "type": "array",
                "items": {"type": "object"}
              },
              "external_references_count": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "Progenetix_get_cnv_frequencies",
    "description": "Get the genome-wide aggregate CNV frequency profile for a cancer type from Progenetix — the signature Progenetix output. For each genomic interval bin (cytoband), returns the gain frequency and loss frequency aggregated across all samples of a Progenetix collation, selected by NCIt code. Example: NCIT:C4017 (Breast Ductal Carcinoma) returns sampleCount 13869 across 3106 interval bins; NCIT:C3058 (Glioblastoma) bin 1p36.33 has gain_frequency 4.258 and loss_frequency 5.278.",
    "parameter": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "string",
          "description": "NCIt ontology code identifying the cancer-type collation. Examples: 'NCIT:C4017' (Breast Ductal Carcinoma), 'NCIT:C3058' (Glioblastoma), 'NCIT:C9145' (AML), 'NCIT:C3224' (Melanoma), 'NCIT:C4872' (Lung Adenocarcinoma)."
        },
        "dataset_ids": {
          "type": "string",
          "default": "progenetix",
          "description": "Progenetix dataset to query (default 'progenetix')."
        },
        "max_intervals": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional cap on the number of interval bins returned (default: all ~3000 bins)."
        }
      },
      "required": ["filters"]
    },
    "fields": {
      "endpoint": "interval_frequencies"
    },
    "type": "ProgenetixTool",
    "test_examples": [
      {"filters": "NCIT:C4017", "max_intervals": 5},
      {"filters": "NCIT:C3058", "max_intervals": 5}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "filters": {
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "group_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "dataset_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "sample_count": {
              "type": "integer"
            },
            "interval_count": {
              "type": "integer"
            },
            "returned_interval_count": {
              "type": "integer"
            },
            "intervals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "no": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reference_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cytobands": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "start": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "size": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "gain_frequency": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "loss_frequency": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "gain_hlfrequency": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "loss_hlfrequency": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "filters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
