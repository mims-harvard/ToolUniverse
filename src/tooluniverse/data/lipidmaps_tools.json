  {
    "name": "LipidMaps_get_compound_by_xref",
    "description": "Resolve a KEGG, HMDB, ChEBI, PubChem, InChIKey, or chain-resolved abbreviation to every matching LIPID MAPS structure record. Namespace aliases cannot conflict, all path segments are encoded, output fields are validated, and the complete unpaginated match set is explicit. Slash chain forms are normalized to the API's underscore representation before request.",
    "parameter": {
      "type": "object",
      "properties": {
        "input_value": {
          "type": "string",
          "minLength": 1,
          "description": "The cross-reference identifier value to resolve, e.g. 'C00157' (KEGG), 'HMDB0000564' (HMDB), '57643' (ChEBI), or 'PC(16:0/18:1)' (abbrev_chains)."
        },
        "xref_type": {
          "type": "string",
          "description": "Namespace of input_value. One of: 'kegg_id', 'hmdb_id', 'chebi_id', 'pubchem_cid', 'inchi_key', 'abbrev_chains'.",
          "enum": ["kegg_id", "hmdb_id", "chebi_id", "pubchem_cid", "inchi_key", "abbrev_chains"],
          "default": "kegg_id"
        },
        "output_item": {
          "type": "string",
          "enum": ["all", "classification", "regno", "lm_id", "name", "sys_name", "synonyms", "abbrev", "abbrev_chains", "core", "main_class", "sub_class", "class_level4", "exactmass", "formula", "inchi", "inchi_key", "kegg_id", "hmdb_id", "chebi_id", "lipidbank_id", "pubchem_cid", "smiles", "molfile", "structure", "physchem", "png"],
          "description": "Type of output. Options: 'all' (complete record with all cross-refs), 'name', 'formula', 'exactmass', 'smiles', 'classification'.",
          "default": "all"
        }
      },
      "required": ["input_value"]
    },
    "fields": {
      "context": "compound",
      "input_item": "kegg_id"
    },
    "type": "LipidMapsTool",
    "test_examples": [
      {
        "input_value": "C00157",
        "xref_type": "kegg_id"
      },
      {
        "input_value": "HMDB0000564",
        "xref_type": "hmdb_id"
      },
      {
        "input_value": "PC(16:0/18:1)",
        "xref_type": "abbrev_chains"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": [
            "object",
            "array"
          ],
          "description": "LMSD record (single object) or list of records with lm_id, name, formula, exactmass, and cross-references (kegg_id, hmdb_id, chebi_id, pubchem_cid)."
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
