[
  {
    "name": "LipidMaps_get_compound_by_id",
    "description": "Get lipid structure and classification by exact LIPID MAPS ID (LMID). The wrapper validates output fields before network access, requires JSON, verifies the returned LMID, and reports result-set and field-scope completeness. Example: LMFA08040013 returns Palmitoyl-EA with structure and external cross-references.",
    "parameter": {
      "type": "object",
      "properties": {
        "input_value": {
          "type": "string",
          "minLength": 1,
          "description": "LIPID MAPS ID (LMID), e.g., 'LMFA08040013'. Format: LM + 2-letter category + 8-digit number."
        },
        "output_item": {
          "type": "string",
          "enum": ["all", "classification", "regno", "lm_id", "name", "sys_name", "synonyms", "abbrev", "abbrev_chains", "core", "main_class", "sub_class", "class_level4", "exactmass", "formula", "inchi", "inchi_key", "kegg_id", "hmdb_id", "chebi_id", "lipidbank_id", "pubchem_cid", "smiles", "molfile", "structure", "physchem", "png"],
          "description": "Type of output. Options: 'all' (complete record), 'name', 'formula', 'exactmass', 'smiles', 'classification', 'molfile'.",
          "default": "all"
        }
      },
      "required": [
        "input_value"
      ]
    },
    "fields": {
      "context": "compound",
      "input_item": "lm_id"
    },
    "type": "LipidMapsTool",
    "test_examples": [
      {
        "input_value": "LMFA08040013"
      },
      {
        "input_value": "LMFA01030185",
        "output_item": "all"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "lm_id": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "sys_name": {
          "type": ["string", "null"]
        },
        "formula": {
          "type": ["string", "null"]
        },
        "exactmass": {
          "type": ["string", "null"]
        },
        "smiles": {
          "type": ["string", "null"]
        },
        "inchi_key": {
          "type": ["string", "null"]
        },
        "core": {
          "type": ["string", "null"]
        },
        "main_class": {
          "type": ["string", "null"]
        },
        "sub_class": {
          "type": ["string", "null"]
        },
        "kegg_id": {
          "type": ["string", "null"]
        },
        "hmdb_id": {
          "type": ["string", "null"]
        },
        "chebi_id": {
          "type": ["string", "null"]
        },
        "pubchem_cid": {
          "type": ["string", "null"]
        },
        "input": {
          "type": ["string", "null"]
        },
        "regno": {
          "type": ["string", "null"]
        },
        "abbrev": {
          "type": ["string", "null"]
        }
      }
    }
  },
  {
    "name": "LipidMaps_search_by_name",
    "description": "Search exact lipidomics abbreviations in LIPID MAPS. Sum compositions use abbrev (e.g. PC 34:1); an acyl-chain slash form such as PC 16:0/18:1 is normalized before the first request to abbrev_chains=PC 16:0_18:1, avoiding the upstream router's 404. Sphingolipid sums require the ;O2-style suffix. Returns the complete unpaginated match set with explicit field-scope metadata; class names are not abbreviation searches.",
    "parameter": {
      "type": "object",
      "properties": {
        "input_value": {
          "type": "string",
          "minLength": 1,
          "description": "Exact lipid abbreviation used in lipidomics (e.g., 'DHA', 'EPA', 'PC 34:1', 'PC 16:0/18:1', 'SM 34:1;O2'). Class names like 'ceramide' will not match — use exact abbreviations only. Sphingolipid sum-composition abbreviations must include the ';O2'-style hydroxyl-count suffix."
        },
        "output_item": {
          "type": "string",
          "enum": ["all", "classification", "regno", "lm_id", "name", "sys_name", "synonyms", "abbrev", "abbrev_chains", "core", "main_class", "sub_class", "class_level4", "exactmass", "formula", "inchi", "inchi_key", "kegg_id", "hmdb_id", "chebi_id", "lipidbank_id", "pubchem_cid", "smiles", "molfile", "structure", "physchem", "png"],
          "description": "Type of output. Options: 'all', 'name', 'formula', 'exactmass', 'smiles', 'classification'.",
          "default": "all"
        }
      },
      "required": [
        "input_value"
      ]
    },
    "fields": {
      "context": "compound",
      "input_item": "abbrev"
    },
    "type": "LipidMapsTool",
    "test_examples": [
      {
        "input_value": "DHA"
      },
      {
        "input_value": "EPA",
        "output_item": "all"
      },
      {
        "input_value": "PC 16:0/18:1"
      },
      {
        "input_value": "SM 34:1;O2"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "lm_id": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]},
            "formula": {"type": ["string", "null"]},
            "exactmass": {"type": ["string", "null"]},
            "smiles": {"type": ["string", "null"]},
            "core": {"type": ["string", "null"]},
            "abbrev": {"type": ["string", "null"]}
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lm_id": {"type": ["string", "null"]},
              "name": {"type": ["string", "null"]},
              "formula": {"type": ["string", "null"]},
              "abbrev": {"type": ["string", "null"]}
            }
          }
        }
      ]
    }
  },
  {
