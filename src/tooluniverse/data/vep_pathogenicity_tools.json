[
  {
    "name": "VEP_predict_pathogenicity_by_rsid",
    "description": "Get missense pathogenicity predictor scores for a dbSNP variant via Ensembl VEP. Returns per-transcript AlphaMissense (class + 0-1 pathogenicity), SIFT (tolerated/deleterious + score), PolyPhen-2 (benign/damaging + score), and the variant's most-severe consequence. One call returns predictions across all overlapping transcripts. No API key required. For CADD scores use the dedicated CADD tools.",
    "parameter": {
      "type": "object",
      "properties": {
        "rsid": {
          "type": "string",
          "description": "dbSNP reference SNP ID, e.g. 'rs699' (AGT) or 'rs28934578' (TP53 R175H)."
        },
        "genome_build": {
          "type": "string",
          "default": "GRCh38",
          "enum": ["GRCh38", "GRCh37"],
          "description": "Reference genome assembly. AlphaMissense is available on both."
        }
      },
      "required": ["rsid"]
    },
    "fields": {
      "operation": "predict_by_rsid"
    },
    "type": "VEPPathogenicityTool",
    "test_examples": [
      { "rsid": "rs699" },
      { "rsid": "rs28934578", "genome_build": "GRCh38" }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": { "type": ["string", "null"] },
          "variant_id": { "type": ["string", "null"] },
          "assembly_name": { "type": ["string", "null"] },
          "seq_region_name": { "type": ["string", "null"] },
          "start": { "type": ["integer", "null"] },
          "end": { "type": ["integer", "null"] },
          "allele_string": { "type": ["string", "null"] },
          "most_severe_consequence": { "type": ["string", "null"] },
          "has_alphamissense": { "type": "boolean" },
          "predictions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transcript_id": { "type": ["string", "null"] },
                "gene_symbol": { "type": ["string", "null"] },
                "gene_id": { "type": ["string", "null"] },
                "biotype": { "type": ["string", "null"] },
                "consequence_terms": { "type": ["array", "null"], "items": { "type": "string" } },
                "amino_acids": { "type": ["string", "null"] },
                "codons": { "type": ["string", "null"] },
                "impact": { "type": ["string", "null"] },
                "sift_prediction": { "type": ["string", "null"] },
                "sift_score": { "type": ["number", "null"] },
                "polyphen_prediction": { "type": ["string", "null"] },
                "polyphen_score": { "type": ["number", "null"] },
                "alphamissense_class": { "type": ["string", "null"] },
                "alphamissense_pathogenicity": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    }
  },
  {
