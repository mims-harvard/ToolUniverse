      "properties": {
        "hgvs_notation": {
          "type": "string",
          "description": "HGVS notation, e.g. 'ENST00000269305.9:c.524G>A' (TP53 R175H). The reference allele must match the transcript/genome."
        },
        "genome_build": {
          "type": "string",
          "default": "GRCh38",
          "enum": ["GRCh38", "GRCh37"],
          "description": "Reference genome assembly."
