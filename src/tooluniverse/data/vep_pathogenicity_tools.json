  {
    "name": "VEP_predict_pathogenicity_by_region",
    "description": "Get missense pathogenicity predictor scores for a variant specified by chromosome, position, and alternate allele via Ensembl VEP. Example: BRAF V600E is chrom=7, pos=140753336, alt=T on GRCh38. Returns per-transcript AlphaMissense (class + 0-1 score), SIFT, PolyPhen-2, and the most-severe consequence. No API key required.",
    "parameter": {
      "type": "object",
      "properties": {
        "chrom": {
          "type": "string",
          "description": "Chromosome (1-22, X, Y, MT). A 'chr' prefix is accepted and stripped."
        },
        "pos": {
          "type": "integer",
          "description": "1-based genomic position of the substituted base."
        },
        "alt": {
          "type": "string",
          "description": "Alternate (variant) allele, e.g. 'T'. Single-nucleotide substitution."
        },
        "genome_build": {
          "type": "string",
          "default": "GRCh38",
          "enum": ["GRCh38", "GRCh37"],
          "description": "Reference genome assembly. Coordinates must match the chosen build."
        }
      },
      "required": ["chrom", "pos", "alt"]
    },
    "fields": {
      "operation": "predict_by_region"
    },
    "type": "VEPPathogenicityTool",
    "test_examples": [
      { "chrom": "7", "pos": 140753336, "alt": "T" },
      { "chrom": "17", "pos": 7675088, "alt": "T", "genome_build": "GRCh38" }
    ],
    "return_schema": {
