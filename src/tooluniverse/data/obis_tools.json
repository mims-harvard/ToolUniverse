[
  {
    "name": "OBIS_search_taxa",
    "type": "OBISTaxaTool",
    "description": "Resolve an exact scientific name through OBIS /taxon/{scientificname}. Returns same-name accepted and unaccepted taxa with WoRMS taxonID/AphiaID, rank, status, accepted-name mapping, environment flags, and lineage. Uses local offset pagination over the complete response.",
    "parameter": {
      "type": "object",
      "properties": {
        "scientificname": {
          "type": "string",
          "description": "Scientific name query (e.g., 'Gadus')."
        },
        "size": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of taxon matches to return (1–100)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based local offset over exact-name matches. Continue with metadata.next_offset."
        }
      },
      "required": [
        "scientificname"
      ]
    },
    "fields": {
      "endpoint": "https://api.obis.org/v3/taxon",
      "format": "json"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scientificName": {
                    "type": "string"
                  },
                  "aphiaID": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "rank": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kingdom": {
                    "type": "string"
                  },
                  "phylum": {
                    "type": "string"
                  },
                  "class": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "order": {
                    "type": "string"
                  },
                  "family": {
                    "type": "string"
                  },
                  "genus": {
                    "type": "string"
                  }
                }
              }
            },
            "total": {
              "type": [
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "results"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "scientificname": "Gadus",
        "size": 1
      }
    ],
    "label": [
      "OBIS",
      "Taxonomy",
      "Marine"
    ],
    "metadata": {
      "tags": [
        "marine",
        "taxonomy",
        "aphia"
      ],
      "estimated_execution_time": "< 2 seconds"
    }
  },
  {
    "name": "OBIS_search_occurrences",
    "type": "OBISOccurrenceTool",
    "description": "Retrieve one cursor page of marine occurrence records from OBIS. The API ignores offset/from/page; continue with metadata.next_after, which is the internal occurrence UUID field id (not Darwin Core occurrenceID). Exact total and one-record lookahead prevent silent truncation.",
    "parameter": {
      "type": "object",
      "properties": {
        "scientificname": {
          "type": "string",
          "description": "Scientific name filter to restrict occurrences."
        },
        "areaid": {
          "type": "string",
          "description": "Area identifier filter (per OBIS API)."
        },
        "size": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of records in this cursor page (1–100)."
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "description": "Cursor from metadata.next_after. Must be the internal UUID in result field id, not occurrenceID."
        }
      }
    },
    "fields": {
      "endpoint": "https://api.obis.org/v3/occurrence",
      "format": "json"
    },
    "return_schema": {
      "oneOf": [
