[
  {
    "name": "FDAGSRS_search_substances",
    "type": "FDAGSRSTool",
    "description": "Search FDA GSRS for substances by name, UNII, InChIKey, or formula. Results are recoverably paginated with offset and metadata.next_offset. GSRS pins exact-name hits on later native pages; the wrapper removes that repeated pin so ranked results are not lost.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query: drug/chemical name, UNII code, InChIKey, or molecular formula. Examples: 'aspirin', 'semaglutide', 'R16CO5Y76E', 'C9H8O4', 'BSYNRYMUTXBXSQ-UHFFFAOYSA-N'."
        },
        "substance_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by substance class. Options: 'chemical', 'protein', 'mixture', 'polymer', 'nucleicAcid', 'structurallyDiverse', 'specifiedSubstanceG1'. Default: no filter (all classes)."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of results to return (1-50, default 10).",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based ranked-result offset. Continue with metadata.next_offset while metadata.has_more is true.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "operation": "search_substances"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string"
              },
              "unii": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "substanceClass": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "smiles": {
                "type": "string"
              },
              "synonyms": {
                "type": "array"
              },
              "synonyms_total": {
                "type": "integer"
              },
              "synonyms_truncated": {
                "type": "boolean"
              },
              "xrefs": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "aspirin",
        "limit": 5
      },
      {
        "query": "semaglutide"
      },
      {
        "query": "metformin"
      }
    ]
  },
  {
    "name": "FDAGSRS_get_substance",
    "type": "FDAGSRSTool",
    "description": "Get the full FDA substance record by UNII, including every inlined name and code from GSRS view=full, structure, and approval status. metadata.total_names and total_codes quantify completeness. Example: R16CO5Y76E is aspirin.",
    "parameter": {
      "type": "object",
      "properties": {
        "unii": {
          "type": "string",
          "description": "FDA UNII (Unique Ingredient Identifier) code. 10-character alphanumeric string. Examples: 'R16CO5Y76E' (aspirin), '9100L32L2N' (ibuprofen), '4T6H12BN9U' (metformin), '57GNO57U7G' (semaglutide)."
        }
      },
      "required": [
        "unii"
      ]
    },
    "fields": {
      "operation": "get_substance"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "unii": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "substanceClass": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "structure": {
              "type": "object",
              "description": "Chemical structure",
              "properties": {
                "smiles": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "SMILES"
                },
                "formula": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Molecular formula"
                },
                "molfile": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "MDL molfile"
                },
                "inchiKey": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "InChIKey"
                },
                "charge": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ]
                },
                "mwt": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ],
                  "description": "Molecular weight"
                }
              }
            },
            "names": {
              "type": "array",
              "description": "Every name GSRS inlines for the substance",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The name"
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GSRS name type, e.g. sys, cn, of"
                  },
                  "preferred": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether GSRS treats it as the preferred name"
                  },
                  "display_name": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Name as GSRS displays it"
                  },
                  "standardized_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Standardised form"
                  },
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Languages the name is recorded in"
                  },
                  "jurisdictions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Jurisdictions the name applies in"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "citation": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The document, e.g. 'EP 10.5'"
                        },
                        "doc_type": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GSRS's type for it, e.g. EP or FDA_SRS"
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "GSRS tags on the reference, e.g. NOMEN"
                        },
                        "public_domain": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether GSRS releases the reference publicly"
                        },
                        "uuid": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GSRS reference uuid; present alone when the record does not inline the reference it points at"
                        }
                      }
                    },
                    "description": "Which pharmacopoeia or document establishes the name, resolved from the record's own references array"
                  },
                  "deprecated": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether GSRS has deprecated the name"
                  }
                }
              }
            },
            "codes": {
              "type": "array",
              "description": "Every code GSRS inlines for the substance",
              "items": {
                "type": "object",
                "properties": {
                  "codeSystem": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Code system, e.g. WHO-ATC, CAS, DRUG BANK"
                  },
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The code"
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GSRS code type, e.g. PRIMARY"
                  },
                  "comments": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GSRS's note on the code. For WHO-ATC this is the classification path the code means: 'ATC|CARDIOVASCULAR SYSTEM|BETA BLOCKING AGENTS|...'"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Resolver link for the code, where GSRS records one"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "citation": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The document, e.g. 'EP 10.5'"
                        },
                        "doc_type": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GSRS's type for it, e.g. EP or FDA_SRS"
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "GSRS tags on the reference, e.g. NOMEN"
                        },
                        "public_domain": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether GSRS releases the reference publicly"
                        },
                        "uuid": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "GSRS reference uuid; present alone when the record does not inline the reference it points at"
                        }
                      }
                    },
                    "description": "References behind the code"
                  },
                  "deprecated": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether GSRS has deprecated the code"
                  }
                }
              }
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The document, e.g. 'EP 10.5'"
                  },
                  "doc_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GSRS's type for it, e.g. EP or FDA_SRS"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "GSRS tags on the reference, e.g. NOMEN"
                  },
                  "public_domain": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether GSRS releases the reference publicly"
                  },
                  "uuid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GSRS reference uuid; present alone when the record does not inline the reference it points at"
                  }
                }
              },
              "description": "Every reference the record carries, which the names' and codes' citations are resolved against"
            }
          },
          "required": [
            "uuid"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "unii": "R16CO5Y76E"
      },
      {
        "unii": "9100L32L2N"
      },
      {
        "unii": "4T6H12BN9U"
      }
    ]
  },
  {
    "name": "FDAGSRS_get_structure",
    "type": "FDAGSRSTool",
    "description": "Get chemical structure data for an FDA-regulated substance by UNII code. Returns SMILES, molecular formula, InChIKey, molfile, molecular weight, stereochemistry, and optical activity. No API key required. Only works for chemical substances; returns error for proteins, mixtures, or non-chemical substances. Example: UNII 'R16CO5Y76E' (aspirin) -> SMILES 'CC(=O)Oc1ccccc1C(O)=O'.",
    "parameter": {
      "type": "object",
      "properties": {
        "unii": {
          "type": "string",
          "description": "FDA UNII code for the chemical substance. Examples: 'R16CO5Y76E' (aspirin), '9100L32L2N' (ibuprofen), '4T6H12BN9U' (metformin), 'IY9XDZ35W2' (cisplatin)."
        }
      },
      "required": [
        "unii"
      ]
    },
    "fields": {
      "operation": "get_structure"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "smiles": {
              "type": "string"
            },
            "formula": {
              "type": "string"
            },
            "molfile": {
              "type": "string"
            },
            "inchiKey": {
              "type": "string"
            },
            "mwt": {},
            "charge": {},
            "stereoChemistry": {
              "type": "string"
            },
            "opticalActivity": {
              "type": "string"
            },
            "atropisomerism": {
              "type": [
                "string",
                "null"
              ],
              "description": "Whether the substance shows atropisomerism, e.g. 'No'. Atropisomers are separable stereoisomers arising from hindered rotation, so a 'Yes' means the SMILES alone does not identify the substance."
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "unii": "R16CO5Y76E"
      },
      {
        "unii": "9100L32L2N"
      }
    ]
  },
  {
    "name": "FDAGSRS_get_substance_relationships",
    "type": "FDAGSRSTool",
    "description": "Get the FDA GSRS substance relationship graph plus regulatory references for a substance by UNII. Returns the full set of relationship edges that the default substance view drops as unexpanded link stubs: salt/solvate->parent, impurity->parent, metabolite->parent (including METABOLITE ACTIVE / METABOLITE INACTIVE), prodrug->metabolite-active, and the active moiety, each with the related substance name+UNII, interaction type, qualification, amount, and comments. Also returns the regulatory/literature references attached to the record. No API key required. Example: UNII 'R16CO5Y76E' (aspirin) -> 37 relationships + 78 references.",
    "parameter": {
      "type": "object",
      "properties": {
        "unii": {
          "type": "string",
          "description": "FDA UNII (Unique Ingredient Identifier) code. Examples: 'R16CO5Y76E' (aspirin), '9100L32L2N' (ibuprofen), '4T6H12BN9U' (metformin)."
        },
        "relationship_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional case-insensitive substring filter on relationship type. Examples: 'METABOLITE', 'SALT/SOLVATE', 'IMPURITY', 'PRODRUG', 'ACTIVE MOIETY'. Default: no filter (all relationships)."
        },
        "include_references": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to include the regulatory/literature references attached to the record. Default: true."
        },
        "max_references": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of references to return (1-500, default 100)."
        }
      },
      "required": [
        "unii"
      ]
    },
    "fields": {
      "operation": "get_substance_relationships"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "unii": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "substanceClass": {
              "type": "string"
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "relatedSubstanceName": {
                    "type": "string"
                  },
                  "relatedSubstanceUnii": {
                    "type": "string"
                  },
                  "relatedSubstanceClass": {
                    "type": "string"
                  },
                  "interactionType": {
                    "type": "string"
                  },
                  "qualification": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "string"
                  },
                  "comments": {
                    "type": "string"
                  }
                }
              }
            },
            "references": {
              "type": "array"
            }
          },
          "required": [
            "uuid"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "unii": "R16CO5Y76E"
      },
      {
        "unii": "R16CO5Y76E",
        "relationship_type": "METABOLITE"
      },
      {
        "unii": "9100L32L2N",
        "include_references": false
      }
    ]
  }
]
