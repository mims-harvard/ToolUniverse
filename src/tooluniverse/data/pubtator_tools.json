[
  {
    "type": "PubTatorTool",
    "name": "PubTator3_EntityAutocomplete",
    "description": "Provides suggestions for the best‐matching standardized PubTator IDs for a partial biomedical term (gene, disease, chemical, or variant). Use this tool first to convert free‐text names into the stable @IDs required by the other PubTator APIs.",
    "endpoint_path": "/entity/autocomplete/",
    "method": "GET",
    "param_map": {
      "text": "query",
      "entity_type": "concept",
      "max_results": "limit"
    },
    "parameter": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "A few characters or the full name of the biomedical concept you are trying to look up (e.g. “BRAF V6”)."
        },
        "entity_type": {
          "type": "string",
          "description": "Optional filter to restrict suggestions to a single category such as GENE, DISEASE, CHEMICAL, or VARIANT."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of suggestions to return (1 - 50, default = 10)."
        }
      },
      "required": [
        "text"
      ]
    },
    "fields": {
      "tool_subtype": "PubTatorEntity"
    },
    "test_examples": [
      {
        "text": "BRCA1",
        "entity_type": "gene",
        "max_results": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "description": "Matching entities, best match first.",
      "items": {
        "type": "object",
        "properties": {
          "_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "PubTator's own entity id, e.g. '@GENE_BRCA1'. This is what a PubTator search must be given, not the gene symbol."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The entity's name, e.g. 'BRCA1'."
          },
          "biotype": {
            "type": [
              "string",
              "null"
            ],
            "description": "What kind of entity it is, e.g. 'gene', 'disease', 'chemical'. The same text can autocomplete to several biotypes."
          },
          "db": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source database for the identifier, e.g. 'ncbi_gene'."
          },
          "db_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The identifier in that database, e.g. '672'."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What distinguishes this entity from the others, e.g. 'All Species'. This is what separates the human gene from its orthologues in the list."
          },
          "match": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it matched, with the matched span marked, e.g. 'Matched on name <m>BRCA1</m>'. A match on a synonym rather than the name is a weaker hit and this is where that shows."
          }
        }
      }
    }
  },
  {
    "type": "PubTatorTool",
    "name": "PubTator3_LiteratureSearch",
    "description": "Find PubMed articles that match a keyword, a PubTator entity ID (e.g. “@GENE_BRAF”), or an entity-to-entity relation expression (e.g. “relations:treat|@CHEMICAL_Doxorubicin|@DISEASE_Neoplasms”).",
    "endpoint_path": "/search/",
    "method": "GET",
    "param_map": {
      "query": "text",
      "page": "page",
      "page_size": "page_size"
    },
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "What you want to search for. This can be plain keywords, a single PubTator ID, or the special relation syntax shown above."
        },
        "page": {
          "type": "integer",
          "description": "Zero-based results page (optional; default = 0).",
          "default": 0
        },
        "page_size": {
          "type": "integer",
          "description": "How many PMIDs to return per page (optional; default = 10; note: the PubTator3 API always returns 10 per page regardless of this value).",
          "default": 10
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results to return (applied client-side). The PubTator3 API returns 10 results per page; this parameter truncates the results to the requested count."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "tool_subtype": "PubTatorSearch"
    },
    "test_examples": [
      {
        "query": "cancer",
        "page": 1,
        "page_size": 1
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_id": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "pmid": {
                "type": [
                  "integer",
                  "null",
                  "number"
                ]
              },
              "title": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "journal": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "date": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "doi": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "meta_date_publication": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "meta_volume": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "meta_issue": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "meta_pages": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "score": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "text_hl": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "citations": {
                "type": "object",
                "properties": {
                  "NLM": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "BibTeX": {
                    "type": [
                      "null",
                      "string"
                    ]
                  }
                }
              }
            }
          }
        },
        "page_size": {
          "type": [
            "integer",
            "null",
            "number"
          ]
        },
        "current": {
          "type": [
            "integer",
            "null",
            "number"
          ]
        },
        "count": {
          "type": [
            "integer",
            "null",
            "number"
          ]
        },
        "total_pages": {
          "type": [
            "integer",
            "null",
            "number"
          ]
        }
      }
    }
  }
]
