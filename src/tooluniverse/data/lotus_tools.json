[
  {
    "name": "LOTUS_search_natural_products",
    "description": "Search the LOTUS (naturaL prOducTs occUrrenceS) database for natural products by name, SMILES, or InChIKey. LOTUS is the largest open natural products database, containing 750,000+ structure-organism pairs from 35,000+ references. Returns compound IDs, structures (SMILES, InChI), molecular properties, and chemical taxonomy classifications. Supports searching by common name (e.g., 'caffeine'), SMILES string, or InChIKey.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query: compound name (e.g., 'caffeine', 'quercetin'), SMILES string, or InChIKey"
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://lotus.naturalproducts.net/api/search/simple?query={query}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "query": "caffeine"
      },
      {
        "query": "quercetin"
      },
      {
        "query": "RYYVLZVUVIJVGH-UHFFFAOYSA-N"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "LOTUS search results",
          "properties": {
            "originalQuery": {
              "type": "string",
              "description": "The query that was searched"
            },
            "determinedInputType": {
              "type": "string",
              "description": "Detected input type: name, SMILES, or InChi Key"
            },
            "naturalProducts": {
              "type": "array",
              "description": "List of matching natural products",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Internal MongoDB ID"
                  },
                  "lotus_id": {
                    "type": "string",
                    "description": "LOTUS identifier (e.g., LTS0075508)"
                  },
                  "wikidata_id": {
                    "type": "string",
                    "description": "Wikidata entity URI"
                  },
                  "traditional_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Common name of the compound"
                  },
                  "smiles": {
                    "type": "string",
                    "description": "SMILES structure representation"
                  },
                  "inchi": {
                    "type": "string",
                    "description": "InChI identifier"
                  },
                  "inchikey": {
                    "type": "string",
                    "description": "InChIKey hash"
                  },
                  "molecular_formula": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Molecular formula"
                  },
                  "molecular_weight": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Molecular weight in g/mol"
                  },
                  "contains_sugar": {
                    "type": "integer",
                    "description": "Whether compound contains sugar moieties (0 or 1)"
                  },
                  "heavy_atom_number": {
                    "type": "integer",
                    "description": "Number of heavy (non-hydrogen) atoms"
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "LOTUS_get_compound",
    "description": "Get detailed information about a specific natural product from LOTUS by its internal compound ID. Returns comprehensive data including structure (SMILES, InChI), molecular properties (weight, formula, LogP, PSA), drug-likeness metrics (Lipinski violations, H-bond donors/acceptors), chemical taxonomy (NPClassifier and ClassyFire classifications), and source organism data. Use LOTUS_search_natural_products to find the compound ID first.",
    "parameter": {
      "type": "object",
      "properties": {
        "compound_id": {
          "type": "string",
          "description": "LOTUS internal compound ID (MongoDB ObjectId, e.g., '604b8da112e4996162764b83' for caffeine). Obtain from LOTUS_search_natural_products."
        }
      },
      "required": [
        "compound_id"
      ]
    },
    "fields": {
      "endpoint": "https://lotus.naturalproducts.net/api/compound/{compound_id}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "compound_id": "604b8da112e4996162764b83"
      },
      {
        "compound_id": "604b86f112e499616275424f"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Detailed compound information",
          "properties": {
            "lotus_id": {
              "type": "string",
              "description": "LOTUS identifier"
            },
            "wikidata_id": {
              "type": "string",
              "description": "Wikidata entity URI"
            },
            "traditional_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Common name"
            },
            "iupac_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "IUPAC systematic name"
            },
            "cas": {
              "type": [
                "string",
                "null"
              ],
              "description": "CAS registry number"
            },
            "smiles": {
              "type": "string",
              "description": "SMILES structure"
            },
            "inchi": {
              "type": "string",
              "description": "InChI identifier"
            },
            "inchikey": {
              "type": "string",
              "description": "InChIKey hash"
            },
            "molecular_formula": {
              "type": [
                "string",
                "null"
              ],
              "description": "Molecular formula"
            },
            "molecular_weight": {
              "type": [
                "number",
                "null"
              ],
              "description": "Molecular weight (g/mol)"
            },
            "xlogp": {
              "type": [
                "number",
                "null"
              ],
              "description": "Predicted XLogP (lipophilicity)"
            },
            "alogp": {
              "type": [
                "number",
                "null"
              ],
              "description": "Predicted ALogP"
            },
            "topoPSA": {
              "type": [
                "number",
                "null"
              ],
              "description": "Topological polar surface area"
            },
            "hBondAcceptorCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of H-bond acceptors"
            },
            "hBondDonorCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of H-bond donors"
            },
            "lipinskiRuleOf5Failures": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of Lipinski Rule of 5 violations"
            },
            "number_of_rings": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of rings"
            },
            "heavy_atom_number": {
              "type": "integer",
              "description": "Number of heavy atoms"
            },
            "contains_sugar": {
              "type": "integer",
              "description": "Contains sugar moiety (0 or 1)"
            },
            "chemicalTaxonomyNPclassifierClass": {
              "type": [
                "string",
                "null"
              ],
              "description": "NPClassifier chemical class"
            },
            "chemicalTaxonomyNPclassifierPathway": {
              "type": [
                "string",
                "null"
              ],
              "description": "NPClassifier biosynthetic pathway"
            },
            "chemicalTaxonomyNPclassifierSuperclass": {
              "type": [
                "string",
                "null"
              ],
              "description": "NPClassifier superclass"
            },
            "chemicalTaxonomyClassyfireKingdom": {
              "type": [
                "string",
                "null"
              ],
              "description": "ClassyFire kingdom"
            },
            "chemicalTaxonomyClassyfireClass": {
              "type": [
                "string",
                "null"
              ],
              "description": "ClassyFire class"
            },
            "chemicalTaxonomyClassyfireDirectParent": {
              "type": [
                "string",
                "null"
              ],
              "description": "ClassyFire direct parent classification"
            },
            "allTaxa": {
              "type": [
                "array",
                "null"
              ],
              "description": "Source organisms from which this natural product has been isolated"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "LOTUS_search_by_inchikey",
    "description": "Search the LOTUS natural products database specifically by InChIKey, which provides exact structural matching. InChIKey is a 27-character hash that uniquely identifies a chemical structure. This is the most precise way to look up a natural product in LOTUS. Returns the same results as LOTUS_search_natural_products but is optimized for InChIKey lookups.",
    "parameter": {
      "type": "object",
      "properties": {
        "inchikey": {
          "type": "string",
          "description": "InChIKey to search for (e.g., 'RYYVLZVUVIJVGH-UHFFFAOYSA-N' for caffeine, 'IQBMWEYFKNVACH-MEBVLIOMSA-N' for quercetin)"
        }
      },
      "required": [
        "inchikey"
      ]
    },
    "fields": {
      "endpoint": "https://lotus.naturalproducts.net/api/search/simple?query={inchikey}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "inchikey": "RYYVLZVUVIJVGH-UHFFFAOYSA-N"
      },
      {
        "inchikey": "IQBMWEYFKNVACH-MEBVLIOMSA-N"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "LOTUS InChIKey search results",
          "properties": {
            "originalQuery": {
              "type": "string"
            },
            "determinedInputType": {
              "type": "string",
              "description": "Should be 'InChi Key'"
            },
            "naturalProducts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "lotus_id": {
                    "type": "string"
                  },
                  "traditional_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "smiles": {
                    "type": "string"
                  },
                  "inchikey": {
                    "type": "string"
                  },
                  "molecular_formula": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "molecular_weight": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "allChemClassifications": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "description": "Every chemical class assigned to the compound, pooled from both taxonomies below, e.g. ['Imidazopyrimidines', 'Purine alkaloids|Purine alkaloids', 'Alkaloids|Alkaloids', 'Xanthines', 'Organic compounds']. A flat union, so it does not say which scheme gave which label."
                  },
                  "allTaxa": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "description": "Every organism LOTUS records this compound in, as scientific names - 148 of them for caffeine, from 'Coffea canephora' to 'Schizosaccharomyces pombe' and 'Anthozoa'. LOTUS exists to record which organism a natural product was found in, and this is the only field that answers it."
                  },
                  "alogp": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Ghose-Crippen ALogP, the calculated octanol/water partition coefficient."
                  },
                  "alogp2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "ALogP squared, the form QSAR models use directly."
                  },
                  "amralogp": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Molar refractivity from the same Ghose-Crippen parameterisation."
                  },
                  "apol": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Sum of atomic polarisabilities."
                  },
                  "bcutDescriptor": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "description": "Six BCUT eigenvalue descriptors - the lowest and highest eigenvalue for each of three atomic weightings (mass, charge, polarisability), in that order."
                  },
                  "bond_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of bonds in the structure."
                  },
                  "bpol": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Sum of the absolute differences in polarisability across each bond."
                  },
                  "chemicalTaxonomyClassyfireClass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ClassyFire class, e.g. 'Imidazopyrimidines'."
                  },
                  "chemicalTaxonomyClassyfireDirectParent": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The most specific ClassyFire term for the compound, e.g. 'Xanthines'. More informative than the class, and the level a chemist would name."
                  },
                  "chemicalTaxonomyClassyfireKingdom": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ClassyFire kingdom, e.g. 'Organic compounds'."
                  },
                  "chemicalTaxonomyClassyfireSuperclass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ClassyFire superclass, e.g. 'Organoheterocyclic compounds'."
                  },
                  "chemicalTaxonomyNPclassifierClass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "NPClassifier class, e.g. 'Purine alkaloids|Purine alkaloids'. '|'-joined as above."
                  },
                  "chemicalTaxonomyNPclassifierPathway": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "NPClassifier biosynthetic pathway, e.g. 'Alkaloids'. Measured values repeat the term joined by '|' ('Alkaloids|Alkaloids') when more than one classifier run agreed, so the string may need splitting on '|' before use."
                  },
                  "chemicalTaxonomyNPclassifierSuperclass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "NPClassifier superclass, e.g. 'Pseudoalkaloids (transamidation)|Pseudoalkaloids'. '|'-joined as above, and the two halves are not always the same string."
                  },
                  "circularFingerprint": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "integer"
                    },
                    "description": "Indices of the set bits in the circular (ECFP-style) fingerprint - the one used for similarity search."
                  },
                  "contains_linear_sugars": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether an open-chain sugar moiety was detected."
                  },
                  "contains_ring_sugars": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether a cyclic sugar moiety was detected."
                  },
                  "contains_sugar": {
                    "type": [
                      "integer",
                      "boolean",
                      "null"
                    ],
                    "description": "Whether the structure carries any sugar moiety. Measured as the integer 0, while the two fields below are real booleans, so do not assume one type across all three."
                  },
                  "deep_smiles": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "DeepSMILES form of the structure, the syntax used for machine-learning models. Measured empty ('') on records where the service did not compute it."
                  },
                  "eccentricConnectivityIndexDescriptor": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Eccentric connectivity index of the molecular graph."
                  },
                  "ertlFunctionalFragments": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "description": "Functional groups found by Ertl's algorithm, as a map from the group's SMARTS-like string to its count, e.g. {'*n(*)*': 4, '[c]=O': 2}."
                  },
                  "ertlFunctionalFragmentsPseudoSmiles": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "description": "The same functional groups written in pseudo-SMILES with R-groups spelled out, e.g. {'[C*]=O': 1, 'RN*(R)R': 4}."
                  },
                  "extendedFingerprint": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "integer"
                    },
                    "description": "Indices of the set bits in the CDK extended fingerprint, which adds ring information to the path-based one."
                  },
                  "fmfDescriptor": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Fraction of the molecular framework - the share of heavy atoms that belong to the scaffold rather than the side chains."
                  },
                  "fragmentComplexityDescriptor": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Nilakantan fragment complexity."
                  },
                  "fragments": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "description": "Murcko-style fragments of the structure, as a map from the fragment's pseudo-SMILES to how many times it occurs, e.g. {'[O](=[C](p[C]p[N]))': 1}. Keyed by the fragment, so the property names are data, not a fixed set."
                  },
                  "fragmentsWithSugar": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "description": "The same fragment map computed before sugar removal. Identical to fragments for a compound with no sugar moiety."
                  },
                  "fsp3": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Fraction of carbons that are sp3 hybridised; a measure of three-dimensionality."
                  },
                  "gravitationalIndexHeavyAtoms": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ],
                    "description": "Gravitational index over heavy atoms, a 3D descriptor. Measured as the STRING 'NaN' when no coordinates are available."
                  },
                  "hBondAcceptorCount": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Hydrogen-bond acceptors."
                  },
                  "hBondDonorCount": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Hydrogen-bond donors."
                  },
                  "heavy_atom_number": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Non-hydrogen atoms."
                  },
                  "hybridizationRatioDescriptor": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Fraction of sp3 among all hybridised carbons."
                  },
                  "inchi": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Full InChI of the compound, e.g. 'InChI=1S/C8H10N4O2/c1-10-4-9-6-5(10)7(13)12(3)8(14)11(6)2/h4H,1-3H3'."
                  },
                  "inchi2D": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "InChI with stereochemistry layers stripped. Equal to inchi for a compound that has no stereocentres."
                  },
                  "inchikey2D": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The first, skeleton block of the InChIKey only - 14 characters, e.g. 'RYYVLZVUVIJVGH'. It is not the 27-character key, so it matches every stereoisomer and cannot be used where a full InChIKey is expected."
                  },
                  "iupac_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The systematic IUPAC name, e.g. '1,3,7-trimethyl-2,3,6,7-tetrahydro-1H-purine-2,6-dione'. traditional_name gives the common name ('caffeine') instead."
                  },
                  "kappaShapeIndex1": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "First-order Hall-Kier kappa shape index."
                  },
                  "kappaShapeIndex2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Second-order kappa shape index."
                  },
                  "kappaShapeIndex3": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Third-order kappa shape index."
                  },
                  "lipinskiRuleOf5Failures": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "How many of Lipinski's four rules the compound breaks; 0 means it passes all of them."
                  },
                  "manholdlogp": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Mannhold LogP, a logP estimate from atom counts alone."
                  },
                  "max_number_of_rings": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Largest ring count found by the ring perception used, e.g. 3."
                  },
                  "min_number_of_rings": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Smallest ring count found, e.g. 2. It differs from max_number_of_rings because fused systems can be counted more than one way."
                  },
                  "murko_framework": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The Bemis-Murcko scaffold as SMILES, e.g. 'n1cnc2N=C[N]c2c1' - the ring system with side chains removed, which is how series of analogues are grouped."
                  },
                  "npl_noh_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The same score computed with hydrogens suppressed."
                  },
                  "npl_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Natural-product-likeness score; positive values mean more natural-product-like than drug-like."
                  },
                  "npl_sugar_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Natural-product-likeness of the sugar-free structure. Separates likeness that comes from the aglycone from likeness that comes from the glycosylation."
                  },
                  "numberSpiroAtoms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Atoms shared by two rings joined at a single atom."
                  },
                  "number_of_carbons": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Carbon atom count."
                  },
                  "number_of_nitrogens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Nitrogen atom count."
                  },
                  "number_of_oxygens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Oxygen atom count."
                  },
                  "petitjeanNumber": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Petitjean topological shape index from the graph."
                  },
                  "petitjeanShapeGeom": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ],
                    "description": "Petitjean geometric shape ratio, which needs 3D coordinates. Measured as the STRING 'NaN' when the service has no conformer, so the field is not always a number."
                  },
                  "petitjeanShapeTopo": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Petitjean topological shape ratio."
                  },
                  "pfCounts": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "The PubChem fingerprint as 'count' (how many bits are set, e.g. 113) and 'bits' (their indices). The same information as pubchemFingerprint with its length stated.",
                    "properties": {
                      "count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Number of set bits."
                      },
                      "bits": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "integer"
                        },
                        "description": "Indices of the set bits."
                      }
                    }
                  },
                  "pubchemBits": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The PubChem fingerprint base64-encoded, the form PubChem itself serves."
                  },
                  "pubchemBitsString": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The PubChem fingerprint written out as a string of '0' and '1' characters."
                  },
                  "pubchemFingerprint": {
                    "type": [
                      "array",
