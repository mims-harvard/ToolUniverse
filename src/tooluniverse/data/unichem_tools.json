[
  {
    "name": "UniChem_search_compound",
    "description": "Search UniChem by InChI, InChIKey, source compound ID, or UCI. Every returned compound is preserved (important because source IDs can map one-to-many), totalCompounds is normalized and verified, and every source record retains its numeric source ID. Per compound, source_record_count, unique_source_count, and duplicate_source_records distinguish database coverage from multiple IDs in the same database. Live aspirin data includes many duplicate records within sources such as ClinicalTrials and BRENDA, so source record count must not be interpreted as unique database count.",
    "parameter": {
      "type": "object",
      "properties": {
        "compound": {
          "type": "string",
          "description": "The compound identifier to search. Can be an InChIKey (e.g., 'BSYNRYMUTXBXSQ-UHFFFAOYSA-N'), source compound ID (e.g., 'CHEMBL25'), or UCI number."
        },
        "type": {
          "type": "string",
          "enum": [
            "inchi",
            "inchikey",
            "sourceID",
            "uci"
          ],
          "description": "Type of compound representation. sourceID means a source compound ID and requires the numeric sourceID field."
        },
        "sourceID": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Required when type='sourceID'. The source database ID (e.g., 1=ChEMBL, 2=DrugBank, 7=ChEBI, 22=PubChem). Use UniChem_list_sources to see all IDs."
        }
      },
      "required": [
        "compound",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "sourceID"
              }
            }
          },
          "then": {
            "required": [
              "sourceID"
            ]
          }
        }
      ]
    },
    "fields": {
      "endpoint_type": "search_compound"
    },
    "type": "UniChemTool",
    "test_examples": [
      {
        "compound": "BSYNRYMUTXBXSQ-UHFFFAOYSA-N",
        "type": "inchikey"
      },
      {
        "compound": "RYYVLZVUVIJVGH-UHFFFAOYSA-N",
        "type": "inchikey"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "inchi": {
              "type": [
                "string",
                "null"
              ]
            },
            "inchikey": {
              "type": [
                "string",
                "null"
              ]
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "uci": {
              "type": [
                "integer",
                "null"
              ],
              "description": "UniChem Compound Identifier (UCI) for the matched structure"
            },
            "source_count": {
              "type": "integer"
            },
            "total_compounds": {
              "type": "integer"
            },
            "returned_compounds": {
              "type": "integer"
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "compounds": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_name": {
                    "type": "string"
                  },
                  "source_id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "source_long_name": {
                    "type": "string"
                  },
                  "compound_id": {
                    "type": "string"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniChem_list_sources",
    "description": "List the complete current UniChem source catalog and verify returned length against totalSources. The live catalog currently reports 25 active sources, not a fixed 40+ count. Use the returned source IDs rather than assuming historical mappings. Current major examples include ChEMBL=1, DrugBank=2, RCSB PDB=3, PDBe=5, ChEBI=7, HMDB=18, and PubChem=22.",
    "parameter": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "fields": {
      "endpoint_type": "list_sources"
    },
    "type": "UniChemTool",
    "test_examples": [
      {}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source_count": {
              "type": "integer"
            },
            "reported_total_sources": {
              "type": "integer"
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "long_name": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "compound_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "last_updated": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniChem_connectivity_search",
    "description": "Connectivity (cross-source) search in UniChem: find all compounds across the 40+ source databases that share the same connectivity layer as the query - i.e. salts, stereoisomers, tautomers, and charge/protonation/isotope variants of the input structure. Each returned match carries a per-match 'comparison' object of boolean flags (charge, connectivity, formula, isotope, protonation, stereoDbond, stereoSp3, HAtoms, ...) showing exactly how that match differs from the query. Use this (rather than UniChem_search_compound, which does exact-structure matching) to discover related forms of a molecule across databases. Example: aspirin InChIKey 'BSYNRYMUTXBXSQ-UHFFFAOYSA-N' returns response 'Success' with totalCompounds 15 across 1044 source entries.",
    "parameter": {
      "type": "object",
      "properties": {
        "compound": {
          "type": "string",
          "description": "The compound identifier to search. Typically a (full or connectivity-layer) InChIKey, e.g. 'BSYNRYMUTXBXSQ-UHFFFAOYSA-N' (aspirin). Can also be a source compound ID when type='sourceID'."
        },
        "type": {
          "type": "string",
          "enum": [
            "inchi",
            "inchikey",
            "sourceID",
            "uci"
          ],
          "description": "Type of compound representation. sourceID requires the numeric sourceID field."
        },
        "sourceID": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Required when type='sourceID'. The source database ID (e.g., 1=ChEMBL, 2=DrugBank, 7=ChEBI, 22=PubChem)."
        }
      },
      "required": [
        "compound",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "sourceID"
              }
            }
          },
          "then": {
            "required": [
              "sourceID"
            ]
          }
        }
      ]
    },
    "fields": {
      "endpoint_type": "connectivity_search"
    },
    "type": "UniChemTool",
    "test_examples": [
      {
        "compound": "BSYNRYMUTXBXSQ-UHFFFAOYSA-N",
        "type": "inchikey"
      },
      {
        "compound": "RYYVLZVUVIJVGH-UHFFFAOYSA-N",
        "type": "inchikey"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "response": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniChem response status (e.g. 'Success')"
            },
            "searched_compound": {
              "type": "object",
              "properties": {
                "inchi": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "inchikey": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "uci": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            },
            "total_compounds": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total number of distinct connectivity-matched compounds"
            },
            "total_sources": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total number of source-database match entries"
            },
            "match_count": {
              "type": "integer",
              "description": "Number of match entries returned"
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "source_name": {
                    "type": "string"
                  },
                  "source_long_name": {
                    "type": "string"
                  },
                  "compound_id": {
                    "type": "string"
                  },
                  "type_of_search": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "comparison": {
                    "type": "object",
                    "description": "Per-match boolean flags showing how this match differs from the query (charge, connectivity, formula, isotope, protonation, stereoDbond, stereoSp3, HAtoms, ...)"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
