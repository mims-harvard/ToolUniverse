[
    {
        "name": "UniParc_get_entry",
        "description": "Get a UniProt UniParc entry by its stable UPI identifier. Returns the full sequence plus explicitly paginated active database cross-references and sequence features. Metadata reports complete totals, truncation, and next offsets so large entries are never presented as complete when only one page was returned.",
        "parameter": {
            "type": "object",
            "properties": {
                "upi": {
                    "type": "string",
                    "description": "UniParc identifier (e.g., 'UPI000002ED67' for TP53/P04637). Find UPIs via UniParc_search or from UniProt protein pages."
                },
                "cross_reference_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based offset into active cross-references. Continue with metadata.next_cross_reference_offset."
                },
                "cross_reference_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 100,
                    "description": "Maximum active cross-references returned in this response."
                },
                "feature_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based offset into sequence features. Continue with metadata.next_feature_offset."
                },
                "feature_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 100,
                    "description": "Maximum sequence features returned in this response."
                }
            },
            "required": [
                "upi"
            ]
        },
        "fields": {
            "endpoint": "get_entry"
        },
        "type": "UniParcTool",
        "test_examples": [
            {
                "upi": "UPI000002ED67"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "uniparc_id": {
                            "type": "string"
                        },
                        "sequence": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "description": "Full amino acid sequence"
                                },
                                "length": {
                                    "type": "integer"
                                },
                                "mol_weight": {
                                    "type": "integer"
                                },
                                "crc64": {
                                    "type": "string"
                                },
                                "md5": {
                                    "type": "string"
                                }
                            }
                        },
                        "cross_references": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "database": {
                                        "type": "string"
                                    },
                                    "id": {
                                        "type": "string"
                                    },
                                    "active": {
                                        "type": "boolean"
                                    },
                                    "gene_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "protein_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "organism": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "taxon_id": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    }
                                }
                            },
                            "description": "Active cross-references to other databases"
                        },
                        "sequence_features": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "database": {
                                        "type": "string"
                                    },
                                    "database_id": {
                                        "type": "string"
                                    },
                                    "interpro_id": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "interpro_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "locations": {
                                        "type": "array"
                                    }
                                }
                            },
                            "description": "InterPro domain annotations"
                        }
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            ]
        }
    },
    {
        "name": "UniParc_search",
        "description": "Search UniParc with official result cursor pagination plus independently reachable organism and gene-name pages inside each sequence record. Large identical sequences can map to hundreds of organisms and gene names. Each result reports nested totals, returned counts, truncation flags, and next offsets instead of silently showing only five.",
        "parameter": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "Search query in Lucene syntax. Examples: 'gene:TP53 AND organism_id:9606', 'database:PDB AND gene:BRCA1', 'accession:P04637'. Fields: gene, organism_id, organism_name, database, accession, upi, checksum."
                },
                "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "description": "Results per official cursor page (default 5, maximum 500). Invalid values return an error rather than being silently clamped."
                },
                "cursor": {
                    "type": "string",
                    "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
                },
                "organism_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based offset into each result's organism list."
                },
                "organism_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 100,
                    "description": "Maximum organisms returned per UniParc result."
                },
                "gene_name_offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Zero-based offset into each result's gene-name list."
                },
                "gene_name_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 100,
                    "description": "Maximum gene names returned per UniParc result."
                }
            },
            "required": [
                "query"
            ]
        },
        "fields": {
            "endpoint": "search"
        },
        "type": "UniParcTool",
        "test_examples": [
            {
                "query": "gene:TP53 AND organism_id:9606",
                "size": 3
            },
            {
                "query": "accession:P04637"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "uniparc_id": {
                                "type": "string",
                                "description": "Stable UPI identifier"
                            },
                            "uniprot_accessions": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "organisms": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "taxon_id": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        }
                                    }
                                }
                            },
                            "organisms_total": {
                                "type": "integer"
                            },
                            "organisms_returned": {
                                "type": "integer"
                            },
                            "organisms_truncated": {
                                "type": "boolean"
                            },
                            "next_organism_offset": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "gene_names": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "gene_names_total": {
                                "type": "integer"
                            },
                            "gene_names_returned": {
                                "type": "integer"
                            },
                            "gene_names_truncated": {
                                "type": "boolean"
                            },
                            "next_gene_name_offset": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "oldest_created": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "most_recent_updated": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    },
                    "description": "Matching UniParc entries"
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            ]
        }
    }
]
