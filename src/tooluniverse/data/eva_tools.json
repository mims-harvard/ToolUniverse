[
  {
    "name": "EVA_get_variants_by_gene",
    "description": "Get genetic variants from the European Variation Archive (EVA) for a specific gene. Results use exact skip pagination: start with offset=0 and continue with metadata.next_offset while metadata.has_more is true, always keeping the same limit because EVA aligns skip to page boundaries. metadata.total_results is exact. Returns allele frequencies, study sources, and variant type. Species defaults to human GRCh38.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol (HGNC format, e.g., 'BRCA1', 'TP53', 'EGFR', 'BRCA2', 'APOE')"
        },
        "species": {
          "type": "string",
          "default": "hsapiens_grch38",
          "description": "Species and assembly (e.g., 'hsapiens_grch38', 'hsapiens_grch37', 'mmusculus_grcm38')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20,
          "description": "Variants per page (default 20, maximum 1000)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based variant offset. It must be a multiple of limit; continue with metadata.next_offset using the same limit."
        }
      },
      "required": [
        "gene"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/eva/webservices/rest/v1/genes/{gene}/variants",
      "param_mapping": {
        "offset": "skip"
      },
      "pagination": "eva_skip"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "gene": "BRCA2",
        "species": "hsapiens_grch38",
        "limit": 5
      },
      {
        "gene": "TP53",
        "species": "hsapiens_grch38",
        "limit": 5
      },
      {
        "gene": "EGFR",
        "species": "hsapiens_grch38",
        "limit": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "EVA response containing variant data for the gene",
          "properties": {
            "time": {
              "type": "integer",
              "description": "Query execution time in milliseconds"
            },
            "apiVersion": {
              "type": "string",
              "description": "API version (e.g., 'v1')"
            },
            "response": {
              "type": "array",
              "description": "Array of response objects containing variant results",
              "items": {
                "type": "object",
                "properties": {
                  "numResults": {
                    "type": "integer",
                    "description": "Number of results in this response"
                  },
                  "numTotalResults": {
                    "type": "integer",
                    "description": "Total number of variants available for the gene"
                  },
                  "result": {
                    "type": "array",
                    "description": "Array of variant objects",
                    "items": {
                      "type": "object",
                      "properties": {
                        "chromosome": {
                          "type": "string"
                        },
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        },
                        "reference": {
                          "type": "string"
                        },
                        "alternate": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "description": "Variant type (SNV, INDEL, etc.)"
                        },
                        "hgvs": {
                          "type": "object"
                        },
                        "sourceEntries": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EVA_get_variants_by_region",
    "description": "Get genetic variants from EVA within a genomic region. Start with offset=0 and continue with metadata.next_offset while metadata.has_more is true, always keeping the same limit because EVA aligns skip to page boundaries. EVA can report numTotalResults=0 on non-empty region pages; ToolUniverse detects this conflict, exposes upstream_total_inconsistent, and uses full-page continuation until a short page establishes the exact total. Returns SNVs, indels, and structural variants.",
    "parameter": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "description": "Genomic region in 'chr:start-end' format (e.g., '17:41200000-41210000', '7:140753300-140753400', '19:44905700-44910000')"
        },
        "species": {
          "type": "string",
          "default": "hsapiens_grch38",
          "description": "Species and assembly (e.g., 'hsapiens_grch38', 'hsapiens_grch37')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20,
          "description": "Variants per page (default 20, maximum 1000)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based variant offset. It must be a multiple of limit; continue with metadata.next_offset using the same limit."
        }
      },
      "required": [
        "region"
      ],
      "additionalProperties": false
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/eva/webservices/rest/v1/segments/{region}/variants",
      "param_mapping": {
        "offset": "skip"
      },
      "pagination": "eva_skip"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "region": "17:41200000-41210000",
        "species": "hsapiens_grch38",
        "limit": 5
      },
      {
        "region": "7:140753300-140753400",
        "species": "hsapiens_grch38",
        "limit": 5
      },
      {
        "region": "19:44905700-44910000",
        "species": "hsapiens_grch38",
        "limit": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "EVA response containing variants in the specified genomic region",
          "properties": {
            "time": {
              "type": "integer"
            },
            "apiVersion": {
              "type": "string"
            },
            "response": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "numResults": {
                    "type": "integer"
                  },
                  "numTotalResults": {
                    "type": "integer"
                  },
                  "result": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "chromosome": {
                          "type": "string"
                        },
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        },
                        "reference": {
                          "type": "string"
                        },
                        "alternate": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "length": {
                          "type": "integer"
                        },
                        "hgvs": {
                          "type": "object"
                        },
                        "sourceEntries": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EVA_list_studies",
    "description": "List EVA variant studies with deterministic local limit/offset pagination. The upstream endpoint returns the complete study list, ignores pagination parameters, and can vary raw order between identical calls. ToolUniverse sorts by studyId before paging. Continue with metadata.next_offset while metadata.has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "default": "hsapiens_grch38",
          "description": "Species and assembly (e.g., 'hsapiens_grch38', 'hsapiens_grch37', 'mmusculus_grcm38')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20,
          "description": "Studies per deterministic local page (default 20, max 1000)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after sorting by studyId. Continue with metadata.next_offset."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/eva/webservices/rest/v1/meta/studies/list",
      "client_only_params": [
        "limit",
        "offset"
      ],
      "pagination": "eva_studies_client_sort"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "species": "hsapiens_grch38"
      },
      {
        "species": "mmusculus_grcm38"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "List of available EVA studies",
          "properties": {
            "time": {
              "type": "integer"
            },
            "apiVersion": {
              "type": "string"
            },
            "response": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "numResults": {
                    "type": "integer"
                  },
                  "numTotalResults": {
                    "type": "integer"
                  },
                  "result": {
                    "type": "array",
                    "description": "Array of study objects with studyId, studyName, and filesCount"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EVA_get_clustered_variant_by_rs",
    "description": "Resolve an EVA clustered-variant RS accession to its canonical assembly/contig/position record using the EVA accessioning (identifiers) service. This is distinct from EVA's variant-DATA API (webservices/rest) used by the other EVA tools: the accessioning API (webservices/identifiers) maps an RS accession to its definitive coordinate record (assemblyAccession, taxonomyAccession, contig, start, variant type). The RS accession is the numeric clustered-variant id (e.g. 429358), not the 'rs' prefixed dbSNP string. Returns a list of accession records (usually one).",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "EVA clustered-variant RS accession (numeric, no 'rs' prefix). Examples: '429358' (human APOE region, GRCh38 contig CM000681.2 start 44908684), '3091781465' (horse clustered variant)"
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "https://www.ebi.ac.uk/eva/webservices/identifiers/v1/clustered-variants/{accession}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "accession": "429358"
      },
      {
        "accession": "3091781465"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession": {
                "type": "integer"
              },
              "version": {
                "type": "integer"
              },
              "data": {
                "type": "object",
                "properties": {
                  "assemblyAccession": {
                    "type": "string"
                  },
                  "taxonomyAccession": {
                    "type": "integer"
                  },
                  "contig": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "description": "Variant type (e.g., SNV)"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
