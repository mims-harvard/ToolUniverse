[
  {
    "name": "LNCipedia_search_lncrna",
    "description": "Search long non-coding RNAs by name, accession, or keyword using EBI Search over RNAcentral. Results use exact offset pagination: while has_more is true, pass next_start as start with the same query and species filter.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search query: lncRNA name (e.g., 'MALAT1', 'HOTAIR'), gene symbol, accession, or keyword. Supports AND/OR operators."
        },
        "species": {
          "type": "string",
          "description": "Species name filter (e.g., 'Homo sapiens', 'Mus musculus'). Leave empty for all species."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results per page (1-100)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based EBI Search result offset. Continue with next_start."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "rna_type_filter": "lncRNA"
    },
    "type": "miRNASearchTool",
    "test_examples": [
      {
        "query": "MALAT1",
        "size": 5
      },
      {
        "query": "HOTAIR",
        "species": "Homo sapiens",
        "size": 5
      },
      {
        "query": "NEAT1",
        "size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_hits": {
              "type": "integer",
              "description": "Total number of matching lncRNA entries"
            },
            "returned": {
              "type": "integer",
              "description": "Number of entries returned in this response"
            },
            "start": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_start": {
              "type": [
                "integer",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "entries": {
              "type": "array",
              "description": "List of lncRNA entries with IDs, descriptions, and metadata",
              "items": {
                "type": "object",
                "properties": {
                  "rnacentral_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "rna_type": {
                    "type": "string"
                  },
                  "length": {
                    "type": "integer"
                  },
                  "expert_databases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "has_secondary_structure": {
                    "type": "boolean"
                  },
                  "has_genomic_coordinates": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": [
            "total_hits",
            "returned",
            "start",
            "has_more",
            "next_start",
            "truncated",
            "result_set_complete",
            "entries"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "lncRNA",
      "LNCipedia",
      "RNAcentral",
      "Search"
    ],
    "metadata": {
      "tags": [
        "lncrna",
        "long-noncoding-rna",
        "ncrna",
        "lncipedia",
        "rnacentral",
        "search"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  },
  {
    "name": "LNCipedia_get_lncrna",
    "description": "Get detailed lncRNA information from RNAcentral including full RNA sequence, species, gene associations, publication count, and source databases. For species-specific metadata, use URS_TAXID or pass the same positive integer taxid with a base URS ID; the returned record identity and taxid are verified. A bare URS without taxid is a cross-species sequence record, so species is intentionally empty and publications_count may be null when RNAcentral supplies only a publications URL. Conflicting or nonexistent species identifiers return an error instead of falling back to another organism. Example human IDs include URS0002A146E4_9606 (MALAT1), URS00026A23F2_9606 (HOTAIR), and URS000075DAEC_9606 (NEAT1).",
    "parameter": {
      "type": "object",
      "properties": {
        "rnacentral_id": {
          "type": "string",
          "pattern": "^URS[0-9A-Fa-f]{10}(?:_[1-9][0-9]*)?$",
          "description": "RNAcentral URS identifier. Use species-specific format 'URS_TAXID' (e.g., 'URS0002A146E4_9606' for human MALAT1) or base URS ID with taxid parameter."
        },
        "taxid": {
          "type": "integer",
          "minimum": 1,
          "description": "NCBI Taxonomy ID for species-specific lookup (e.g., 9606 for human). Optional if rnacentral_id already includes taxid."
        }
      },
      "required": [
        "rnacentral_id"
      ]
    },
    "fields": {
      "endpoint": "get_rna"
    },
    "type": "miRNAGetTool",
    "test_examples": [
      {
        "rnacentral_id": "URS0002A146E4",
        "taxid": 9606
      },
      {
        "rnacentral_id": "URS00026A23F2",
        "taxid": 9606
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "rnacentral_id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "short_description": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            },
            "length": {
              "type": "integer"
            },
            "rna_type": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "taxid": {
              "type": [
                "integer",
                "null"
              ]
            },
            "genes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "publications_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Species-specific publication count, or null when a bare cross-species URS record exposes only a publications URL."
            },
            "is_active": {
              "type": "boolean"
            },
            "distinct_databases": {
              "type": [
                "string",
                "array",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "lncRNA",
      "LNCipedia",
      "RNAcentral",
      "Sequence"
    ],
    "metadata": {
      "tags": [
        "lncrna",
        "long-noncoding-rna",
        "sequence",
        "ncrna",
        "lncipedia",
        "rnacentral"
      ],
      "estimated_execution_time": "< 2 seconds"
    }
  },
  {
    "name": "LNCipedia_get_lncrna_publications",
    "description": "Retrieve publications associated with a long non-coding RNA from RNAcentral with explicit page pagination. While has_more is true, pass next_page as page. Metadata warns that RNAcentral can repeat a PMID with different source metadata, so total_publications is a source-record count rather than a guaranteed unique-PMID count.",
    "parameter": {
      "type": "object",
      "properties": {
        "rnacentral_id": {
          "type": "string",
          "minLength": 1,
          "description": "RNAcentral URS identifier (e.g., 'URS0002A146E4' for MALAT1). Use base URS ID without taxid suffix."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Number of publications per page (1-50)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based RNAcentral page number. Continue with next_page."
        }
      },
      "required": [
        "rnacentral_id"
      ]
    },
    "fields": {
      "endpoint": "get_publications"
    },
    "type": "miRNAGetTool",
    "test_examples": [
      {
        "rnacentral_id": "URS0002A146E4",
        "page_size": 5
      },
      {
        "rnacentral_id": "URS00026A23F2",
        "page_size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_publications": {
              "type": "integer",
              "description": "Total number of publications for this lncRNA"
            },
            "returned": {
              "type": "integer",
              "description": "Number returned in this page"
            },
            "page": {
              "type": "integer"
            },
            "page_size": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_page": {
              "type": [
                "integer",
                "null"
              ]
            },
            "previous_page": {
              "type": [
                "integer",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "publications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "publication": {
                    "type": "string"
                  },
                  "pubmed_id": {
                    "type": "string"
                  },
                  "doi": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expert_db": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": [
            "total_publications",
            "returned",
            "page",
            "page_size",
            "has_more",
            "next_page",
            "previous_page",
            "truncated",
            "result_set_complete",
            "publications"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "lncRNA",
      "LNCipedia",
      "RNAcentral",
      "Publications"
    ],
