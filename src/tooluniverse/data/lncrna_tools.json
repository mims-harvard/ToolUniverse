        },
        "rna_type": {
          "type": "string",
          "description": "RNA type filter: miRNA, lncRNA, rRNA, tRNA, snRNA, snoRNA, piRNA, pre_miRNA, SRP_RNA, RNase_P_RNA, antisense_RNA, ribozyme, etc."
