                  "number"
                ]
              },
              "title": {
                "type": "string"
              },
              "animal": {
                "type": "number"
              },
              "human": {
                "type": "number"
              },
              "apt": {
                "type": "number"
              },
              "citedByClinicalArticle": {
                "type": "boolean"
              },
              "citedByPmidsByYear": {
                "type": "array",
                "items": {
                  "type": "object",
                  "patternProperties": {
                    "^[0-9]+$": {
                      "type": [
                        "integer",
