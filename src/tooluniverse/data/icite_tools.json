[
  {
    "name": "iCite_get_publications",
    "description": "Get citation metrics and research context for PubMed publications using NIH's iCite API. iCite provides evidence-based metrics including citation counts, relative citation ratios (RCR), approximate potential to translate (APT) scores for clinical translation, NIH percentile rankings, and research category flags (human/animal/molecular-cellular). Returns all available citations and the full list of citing PMIDs. Essential for evaluating scientific impact, identifying highly-cited papers, and assessing translational potential of biomedical research. Example: PMID 31510562 has citation_count=6, nih_percentile=29.0.",
    "parameter": {
      "type": "object",
      "properties": {
        "pmids": {
          "type": "string",
          "description": "Comma-separated PubMed IDs to look up (e.g., '24453150,24453148,31510562'). Maximum ~100 PMIDs per request."
        }
      },
      "required": [
        "pmids"
      ]
    },
    "fields": {
      "endpoint": "https://icite.od.nih.gov/api/pubs",
      "extract_path": "data"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "pmids": "24453150,24453148"
      },
      {
        "pmids": "31510562,33287077"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string"
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lastName": {
                      "type": "string"
                    },
                    "fullName": {
                      "type": "string"
                    },
                    "firstName": {
                      "type": "string"
                    }
                  }
                }
              },
              "doi": {
                "type": "string"
              },
              "pmid": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "title": {
                "type": "string"
              },
              "animal": {
                "type": "number"
              },
              "human": {
                "type": "number"
              },
              "apt": {
                "type": "number"
              },
              "citedByClinicalArticle": {
                "type": "boolean"
              },
              "citedByPmidsByYear": {
                "type": "array",
                "items": {
                  "type": "object",
                  "patternProperties": {
                    "^[0-9]+$": {
                      "type": [
                        "integer",
                        "number"
                      ]
                    }
                  }
                }
              },
              "year": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "journal": {
                "type": "string"
              },
              "is_research_article": {
                "type": "boolean"
              },
              "citation_count": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "field_citation_rate": {
                "type": "number"
              },
              "expected_citations_per_year": {
                "type": "number"
              },
              "citations_per_year": {
                "type": "number"
              },
              "relative_citation_ratio": {
                "type": "number"
              },
              "nih_percentile": {
                "type": "number"
              },
              "molecular_cellular": {
                "type": "number"
              },
              "x_coord": {
                "type": "number"
              },
              "y_coord": {
                "type": "number"
              },
              "is_clinical": {
                "type": "boolean"
              },
              "cited_by_clin": {
                "type": ["null", "array"]
              },
              "cited_by": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              },
              "references": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              },
              "provisional": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "optional_api_keys": [
      "NCBI_API_KEY"
    ],
    "api_key_info": {
      "NCBI_API_KEY": {
        "domain": "Literature & Patents",
        "type": "secret",
        "register_url": "https://www.ncbi.nlm.nih.gov/account/",
        "purpose": "Search PubMed and fetch citation metrics (iCite) and PubTator annotations.",
        "without": "Works at 3 requests/sec without it; the key raises the limit to 10/sec."
      }
    }
  },
  {
    "name": "iCite_search_publications",
    "description": "Search PubMed by relevance and enrich one recoverable result page with NIH iCite citation metrics. Metadata reports PubMed's exact total_results, next_offset, enrichment completeness, and any PMIDs omitted by iCite. Results are sorted by citation_count within the current PubMed relevance page only, not across the complete query result set.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for PubMed (e.g., 'BRCA1 cancer', 'COVID-19 vaccine efficacy', 'CRISPR gene editing')"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of PubMed records to enrich on this page (default 10, max 1000)"
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Zero-based PubMed relevance offset. Continue with metadata.next_offset while has_more is true."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://icite.od.nih.gov/api/pubs"
    },
    "type": "ICiteSearchPublicationsTool",
    "test_examples": [
      {
        "query": "BRCA1 breast cancer",
        "limit": 5
      },
      {
        "query": "COVID-19 mRNA vaccine",
        "limit": 5
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "\"success\" or \"error\"."
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string"
              },
              "authors": {
