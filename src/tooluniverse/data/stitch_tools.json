[
  {
    "name": "STITCH_get_chemical_protein_interactions",
    "description": "Get chemical-protein interactions from STITCH. Returns known and predicted interactions between chemicals and proteins with confidence scores.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string"
          },
          "description": "Chemical names, drug names, or STITCH IDs (e.g., ['aspirin', 'ibuprofen'] or ['CIDm00002244']). Alias: 'chemical'."
        },
        "chemical": {
          "type": "string",
          "description": "Single chemical name or STITCH ID (alias for identifiers, e.g., 'aspirin' or 'CIDm00002244')."
        },
        "species": {
          "type": "integer",
          "description": "NCBI taxonomy ID (9606 for human, 10090 for mouse).",
          "default": 9606
        },
        "required_score": {
          "type": "integer",
          "description": "Minimum confidence score (0-1000). 400=medium, 700=high, 900=highest.",
          "default": 400
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of interaction partners per query.",
          "default": 10
        }
      }
    },
    "fields": {
      "operation": "get_interactions"
    },
    "type": "STITCHTool",
    "test_examples": [
      {
        "identifiers": [
          "aspirin"
        ]
      },
      {
        "identifiers": [
          "metformin"
        ],
        "required_score": 700,
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stringId_A": {
                "type": "string",
                "description": "STITCH ID of first entity"
              },
              "stringId_B": {
                "type": "string",
                "description": "STITCH ID of second entity"
              },
              "preferredName_A": {
                "type": "string"
              },
              "preferredName_B": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "description": "Combined confidence score (0-1)"
              },
              "dscore": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Curated-database subscore, e.g. 0.9. Measured on 10 of 27 rows."
              },
              "escore": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Experimental subscore. Measured on 5 of 27 rows - the evidence an assay actually supports."
              },
              "tscore": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Text-mining subscore, e.g. 0.986. Present on all 27 measured rows. A high combined score built only on text mining is co-mention in abstracts, not measurement."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "error"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "STITCH_get_interaction_partners",
    "description": "Get all interaction partners (chemicals and proteins) for a given identifier. Returns network of related molecules.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string"
          },
          "description": "Chemical or protein identifiers to query."
        },
        "species": {
          "type": "integer",
          "description": "NCBI taxonomy ID.",
          "default": 9606
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of partners.",
          "default": 10
        }
      },
      "required": [
        "identifiers"
      ]
    },
    "fields": {
      "operation": "get_interactors"
    },
    "type": "STITCHTool",
    "test_examples": [
      {
        "identifiers": [
          "TP53"
        ]
      },
      {
        "identifiers": [
          "EGFR",
          "ERBB2"
        ]
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stringId": {
                "type": "string"
              },
              "preferredName": {
                "type": "string"
              },
              "annotation": {
                "type": "string"
              },
              "query": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which queried identifier this row answers, e.g. 'TP53'. Several identifiers are resolved in one call, so this is the only safe join back to the request."
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The partner's rank for that query, e.g. 1. Rows come back ordered by it, and a reordered subset silently loses the ranking."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "error"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "STITCH_resolve_identifier",
    "description": "Resolve a chemical or protein name to STITCH database identifiers. Useful for mapping common names to database IDs.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "Chemical or protein name to resolve (e.g., 'aspirin', 'TP53')."
        },
        "species": {
          "type": "integer",
          "description": "NCBI taxonomy ID.",
          "default": 9606
        }
      },
      "required": [
        "identifier"
      ]
    },
    "fields": {
      "operation": "resolve"
    },
    "type": "STITCHTool",
    "test_examples": [
      {
        "identifier": "aspirin"
      },
      {
        "identifier": "metformin"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stringId": {
                "type": "string",
                "description": "STITCH identifier"
              },
              "preferredName": {
                "type": "string"
              },
              "taxonId": {
                "type": "integer"
              },
              "annotation": {
                "type": "string"
              },
              "ncbiTaxonId": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Taxon id of the resolved entity. Measured as -1 for a chemical, which has no taxon - so the value is a sentinel, not a real id."
              },
              "queryIndex": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Which of the submitted query terms this row answers, e.g. 0. Several terms are resolved in one call and the results are not necessarily in order, so this is the only safe join back."
              },
              "taxonName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name for that taxon, e.g. 'small molecule' where the entity is a chemical rather than a protein."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "error"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
