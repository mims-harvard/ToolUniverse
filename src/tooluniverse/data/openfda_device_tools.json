[
  {
    "name": "OpenFDADevice_search_recalls",
    "type": "OpenFDADeviceTool",
    "description": "Search openFDA's medical device recall database by device name, recalling firm, or free text. Returns each recall's product description, recalling firm, stated reason and root cause, status, and date initiated. Example: query='pacemaker' returns hundreds of pacemaker-related recalls including terminated Guidant and Medtronic actions. ToolUniverse's existing openFDA tools cover only drug data; this is the device side.",
    "fields": {
      "operation": "search_recalls"
    },
    "parameter": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "Device name, recalling firm, or free text, e.g. 'pacemaker', 'insulin pump'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max recalls to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_description": {"type": ["string", "null"]},
              "recalling_firm": {"type": ["string", "null"]},
              "reason_for_recall": {"type": ["string", "null"]},
              "root_cause_description": {"type": ["string", "null"]},
              "recall_status": {"type": ["string", "null"]},
              "event_date_initiated": {"type": ["string", "null"]},
              "action": {"type": ["string", "null"]},
              "code_info": {"type": ["string", "null"], "description": "Which units are affected: models, lot and serial numbers. A recall naming only the firm and the reason cannot be acted on."},
              "product_quantity": {"type": ["string", "null"]},
              "distribution_pattern": {"type": ["string", "null"], "description": "Where the recalled units went"},
              "event_date_posted": {"type": ["string", "null"]},
              "event_date_terminated": {"type": ["string", "null"], "description": "Set when the recall is closed; recall_status alone does not distinguish a terminated recall from a live one"},
              "cfres_id": {"type": ["string", "null"], "description": "openFDA's id for this recall record"},
              "product_res_number": {"type": ["string", "null"]},
              "res_event_number": {"type": ["string", "null"], "description": "Groups the several product records of one recall event"},
              "product_code": {"type": ["string", "null"]},
              "firm_fei_number": {"type": ["string", "null"]},
              "additional_info_contact": {"type": ["string", "null"]},
              "recalling_firm_address": {"type": "object", "properties": {"address_1": {"type": ["string", "null"]}, "city": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]}, "postal_code": {"type": ["string", "null"]}}},
              "identifiers": {"type": "object", "description": "The clearance and registration numbers openFDA attaches to the record. These are the keys the device endpoints take as input, so a result without them cannot be followed.", "properties": {
                "k_numbers": {"type": "array", "items": {"type": "string"}, "description": "510(k) clearance numbers"},
                "pma_numbers": {"type": "array", "items": {"type": "string"}},
                "registration_numbers": {"type": "array", "items": {"type": "string"}, "description": "Establishment registration numbers"},
                "fei_numbers": {"type": "array", "items": {"type": "string"}, "description": "FDA Establishment Identifiers"},
                "device_name": {"type": ["string", "null"]},
                "device_class": {"type": ["string", "null"]},
                "regulation_number": {"type": ["string", "null"]},
                "medical_specialty_description": {"type": ["string", "null"]}
              }}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"query": "pacemaker", "limit": 5},
      {"query": "insulin pump", "limit": 5}
    ]
  },
  {
    "name": "OpenFDADevice_search_adverse_events",
    "type": "OpenFDADeviceTool",
    "description": "Search openFDA's MAUDE database of medical device adverse event reports by device generic name. Returns each report's device brand/generic name and manufacturer, event type (Malfunction/Injury/Death), date, product problems, and patient problems. Example: device_name='pacemaker' surfaces reports like under-sensing and high capture threshold in pacemaker leads. ToolUniverse's existing openFDA tools cover only drug adverse events (FAERS); this is the device side.",
    "fields": {
      "operation": "search_adverse_events"
    },
    "parameter": {
      "type": "object",
      "required": ["device_name"],
      "properties": {
        "device_name": {
          "type": "string",
          "description": "Device generic name, e.g. 'pacemaker', 'insulin pump'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max reports to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "brand_name": {"type": ["string", "null"]},
              "generic_name": {"type": ["string", "null"]},
              "manufacturer": {"type": ["string", "null"]},
              "event_type": {"type": ["string", "null"]},
              "date_of_event": {"type": ["string", "null"]},
              "product_problems": {"type": "array", "items": {"type": "string"}},
              "patient_problems": {"type": "array", "items": {"type": "string"}},
              "narratives": {"type": "array", "description": "What happened, as written on the report. The row used to carry the brand name, the event type and problem codes and nothing of the narrative, which is what a MAUDE report is written to say.", "items": {"type": "object", "properties": {"text_type": {"type": ["string", "null"], "description": "e.g. Description of Event or Problem, Additional Manufacturer Narrative"}, "text": {"type": ["string", "null"]}, "text_truncated": {"type": "boolean", "description": "True when the narrative was cut at 4000 characters"}, "text_length": {"type": "integer"}, "patient_sequence_number": {"type": ["string", "null"]}, "mdr_text_key": {"type": ["string", "null"]}}}},
              "narrative_count": {"type": "integer", "description": "Narratives on the report before the cap"},
              "narratives_truncated": {"type": "boolean"},
              "report_number": {"type": ["string", "null"], "description": "The report's own number, without which a MAUDE row cannot be cited or looked up"},
              "mdr_report_key": {"type": ["string", "null"]},
              "date_received": {"type": ["string", "null"]},
              "date_report": {"type": ["string", "null"]},
              "date_manufacturer_received": {"type": ["string", "null"]},
              "date_changed": {"type": ["string", "null"], "description": "When openFDA last changed the record, which says whether a report has been revised since it was filed"},
              "date_added": {"type": ["string", "null"]},
              "source_type": {"type": "array", "description": "Who reported it, e.g. HEALTH PROFESSIONAL", "items": {"type": "string"}},
              "type_of_report": {"type": "array", "description": "e.g. Initial submission or Follow-up; an initial physician report is not a manufacturer's follow-up", "items": {"type": "string"}},
              "report_source_code": {"type": ["string", "null"]},
              "reporter_occupation_code": {"type": ["string", "null"]},
              "reporter_country_code": {"type": ["string", "null"]},
              "reporter_state_code": {"type": ["string", "null"]},
              "event_location": {"type": ["string", "null"]},
              "remedial_action": {"type": "array", "items": {"type": "string"}},
              "adverse_event_flag": {"type": ["string", "null"]},
              "product_problem_flag": {"type": ["string", "null"]},
              "pma_pmn_number": {"type": ["string", "null"], "description": "The clearance the device was marketed under"},
              "devices": {"type": "array", "description": "Every device named on the report, not only the first. number_devices_in_event is often blank, so the one device reported looked like the only one.", "items": {"type": "object"}},
              "device_count": {"type": "integer"},
              "patients": {"type": "array", "description": "Every patient on the report, with age, sex, problems, outcome and treatment codes -- which is the difference between a malfunction and an injury.", "items": {"type": "object"}},
              "patient_count": {"type": "integer"}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"device_name": "pacemaker", "limit": 5},
      {"device_name": "insulin pump", "limit": 5}
    ]
  },
  {
    "name": "OpenFDADevice_search_udi",
    "type": "OpenFDADeviceTool",
    "description": "Search openFDA's Unique Device Identifier (UDI) database by brand name, company, or free text. Returns each device's brand name, company, description, primary device identifier (DI), GMDN terms, and regulatory device class. The UDI is the device-world equivalent of a drug's NDC code. Example: query='pacemaker' returns real UDI records from Medtronic, Cardinal Health, and others.",
    "fields": {
      "operation": "search_udi"
    },
    "parameter": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "Brand name, company name, or free text, e.g. 'pacemaker'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max UDI records to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "brand_name": {"type": ["string", "null"]},
              "company_name": {"type": ["string", "null"]},
              "device_description": {"type": ["string", "null"]},
              "primary_di": {"type": ["string", "null"]},
              "gmdn_terms": {"type": "array", "description": "GMDN terms with the code another system will match on, the definition of what the class of device is, and whether the term is still active. Only the name used to be returned.", "items": {"type": "object", "properties": {"name": {"type": ["string", "null"]}, "code": {"type": ["string", "null"]}, "code_status": {"type": ["string", "null"]}, "definition": {"type": ["string", "null"]}, "implantable": {"type": ["string", "boolean", "null"]}}}},
              "device_class": {"type": ["string", "null"]},
              "commercial_distribution_status": {"type": ["string", "null"]},
              "identifiers": {"type": "array", "description": "Every device identifier, not only the Primary one: a package or secondary DI is what a scanned barcode will match.", "items": {"type": "object"}},
              "version_or_model_number": {"type": ["string", "null"]},
              "sterilization": {"type": ["object", "null"], "description": "Whether the device is sterile and whether it requires sterilization before use"},
              "mri_safety": {"type": ["string", "null"], "description": "What the labelling says about use near an MRI"},
              "is_labeled_as_nrl": {"type": ["string", "boolean", "null"], "description": "Labelled as containing natural rubber latex"},
              "is_labeled_as_no_nrl": {"type": ["string", "boolean", "null"]},
              "is_rx": {"type": ["string", "boolean", "null"], "description": "Prescription-only"},
              "is_otc": {"type": ["string", "boolean", "null"]},
              "is_single_use": {"type": ["string", "boolean", "null"]},
              "is_kit": {"type": ["string", "boolean", "null"]},
              "is_combination_product": {"type": ["string", "boolean", "null"]},
              "is_hct_p": {"type": ["string", "boolean", "null"]},
              "is_pm_exempt": {"type": ["string", "boolean", "null"]},
              "is_direct_marking_exempt": {"type": ["string", "boolean", "null"]},
              "has_lot_or_batch_number": {"type": ["string", "boolean", "null"]},
              "has_serial_number": {"type": ["string", "boolean", "null"]},
              "has_expiration_date": {"type": ["string", "boolean", "null"]},
              "has_manufacturing_date": {"type": ["string", "boolean", "null"]},
              "has_donation_id_number": {"type": ["string", "boolean", "null"]},
              "storage": {"type": "array", "description": "Storage conditions with units", "items": {"type": "object"}},
              "device_sizes": {"type": "array", "items": {"type": "object"}},
              "device_count_in_base_package": {"type": ["integer", "string", "null"]},
              "customer_contacts": {"type": "array", "items": {"type": "object"}},
              "premarket_submissions": {"type": "array", "description": "The clearances this record is registered under", "items": {"type": "object"}},
              "record_status": {"type": ["string", "null"]},
              "public_version_status": {"type": ["string", "null"]},
              "public_version_number": {"type": ["string", "null"]},
              "public_version_date": {"type": ["string", "null"]},
              "public_device_record_key": {"type": ["string", "null"]},
              "publish_date": {"type": ["string", "null"]},
              "labeler_duns_number": {"type": ["string", "null"]},
              "commercial_distribution_end_date": {"type": ["string", "null"]},
              "product_codes": {"type": "array", "description": "All the product codes with their own classifications, rather than the device class of whichever came first.", "items": {"type": "object"}}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"query": "pacemaker", "limit": 5}
    ]
  },
  {
    "name": "OpenFDADevice_get_classification",
    "type": "OpenFDADeviceTool",
    "description": "Look up a medical device's US regulatory classification by device name. Returns device class (1 = general controls, 2 = special controls, 3 = premarket approval required), FDA product code, review panel, and CFR regulation number. Example: device_name='pacemaker' returns multiple pacemaker-related device types spanning Class 1 (test magnets) to Class 3 (implantable leads).",
    "fields": {
      "operation": "get_classification"
    },
    "parameter": {
      "type": "object",
      "required": ["device_name"],
      "properties": {
        "device_name": {
          "type": "string",
          "description": "Device type name, e.g. 'pacemaker', 'insulin pump'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max classifications to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device_name": {"type": ["string", "null"]},
              "product_code": {"type": ["string", "null"]},
              "device_class": {"type": ["string", "null"]},
              "review_panel": {"type": ["string", "null"]},
              "medical_specialty_description": {"type": ["string", "null"]},
              "regulation_number": {"type": ["string", "null"]},
              "third_party_flag": {"type": ["string", "null"]},
              "definition": {"type": ["string", "null"], "description": "What the regulation defines the device as"},
              "implant_flag": {"type": ["string", "null"]},
              "life_sustain_support_flag": {"type": ["string", "null"]},
              "gmp_exempt_flag": {"type": ["string", "null"]},
              "submission_type_id": {"type": ["string", "integer", "null"]},
              "summary_malfunction_reporting": {"type": ["string", "null"]},
              "unclassified_reason": {"type": ["string", "null"]},
              "medical_specialty": {"type": ["string", "null"]},
              "device_id": {"type": ["string", "null"]},
              "identifiers": {"type": "object", "description": "The clearance and registration numbers openFDA attaches to the record. These are the keys the device endpoints take as input, so a result without them cannot be followed.", "properties": {
                "k_numbers": {"type": "array", "items": {"type": "string"}, "description": "510(k) clearance numbers"},
                "pma_numbers": {"type": "array", "items": {"type": "string"}},
                "registration_numbers": {"type": "array", "items": {"type": "string"}, "description": "Establishment registration numbers"},
                "fei_numbers": {"type": "array", "items": {"type": "string"}, "description": "FDA Establishment Identifiers"},
                "device_name": {"type": ["string", "null"]},
                "device_class": {"type": ["string", "null"]},
                "regulation_number": {"type": ["string", "null"]},
                "medical_specialty_description": {"type": ["string", "null"]}
              }}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"device_name": "pacemaker", "limit": 5}
    ]
  },
  {
    "name": "OpenFDADevice_search_510k",
    "type": "OpenFDADeviceTool",
    "description": "Search openFDA's 510(k) premarket notification database by device name -- the pathway most medical devices use to reach market by demonstrating substantial equivalence to an existing device. Returns each clearance's K number, applicant, decision date and outcome, and clearance type. Example: device_name='pacemaker' returns clearances back to the 1980s-90s including K913805.",
    "fields": {
      "operation": "search_510k"
    },
    "parameter": {
      "type": "object",
      "required": ["device_name"],
      "properties": {
        "device_name": {
          "type": "string",
          "description": "Device name, e.g. 'pacemaker'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max clearances to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "k_number": {"type": ["string", "null"]},
              "device_name": {"type": ["string", "null"]},
              "applicant": {"type": ["string", "null"]},
              "decision_date": {"type": ["string", "null"]},
              "decision_description": {"type": ["string", "null"]},
              "clearance_type": {"type": ["string", "null"]},
              "advisory_committee_description": {"type": ["string", "null"]},
              "decision_code": {"type": ["string", "null"]},
              "date_received": {"type": ["string", "null"]},
              "product_code": {"type": ["string", "null"]},
              "advisory_committee": {"type": ["string", "null"]},
              "review_advisory_committee": {"type": ["string", "null"]},
              "third_party_flag": {"type": ["string", "null"]},
              "expedited_review_flag": {"type": ["string", "null"]},
              "statement_or_summary": {"type": ["string", "null"]},
              "applicant_address": {"type": "object", "description": "Who holds the clearance and where: two firms can clear devices of the same name.", "items": {"type": "object"}, "properties": {"address_1": {"type": ["string", "null"]}, "address_2": {"type": ["string", "null"]}, "city": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]}, "country_code": {"type": ["string", "null"]}, "zip_code": {"type": ["string", "null"]}, "postal_code": {"type": ["string", "null"]}, "contact": {"type": ["string", "null"]}}},
              "identifiers": {"type": "object", "description": "The clearance and registration numbers openFDA attaches to the record. These are the keys the device endpoints take as input, so a result without them cannot be followed.", "properties": {
                "k_numbers": {"type": "array", "items": {"type": "string"}, "description": "510(k) clearance numbers"},
                "pma_numbers": {"type": "array", "items": {"type": "string"}},
                "registration_numbers": {"type": "array", "items": {"type": "string"}, "description": "Establishment registration numbers"},
                "fei_numbers": {"type": "array", "items": {"type": "string"}, "description": "FDA Establishment Identifiers"},
                "device_name": {"type": ["string", "null"]},
                "device_class": {"type": ["string", "null"]},
                "regulation_number": {"type": ["string", "null"]},
                "medical_specialty_description": {"type": ["string", "null"]}
              }}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"device_name": "pacemaker", "limit": 5}
    ]
  },
  {
    "name": "OpenFDADevice_search_pma",
    "type": "OpenFDADeviceTool",
    "description": "Search openFDA's Premarket Approval (PMA) database by trade name -- the pathway required for higher-risk (Class 3) devices, requiring clinical evidence of safety and effectiveness. Returns each application's PMA number, applicant, trade name, decision date, and approval-order summary. Example: device_name='pacemaker' returns Guidant/Boston Scientific cardiac resynchronization therapy pacemaker approvals.",
    "fields": {
      "operation": "search_pma"
    },
    "parameter": {
      "type": "object",
      "required": ["device_name"],
      "properties": {
        "device_name": {
          "type": "string",
          "description": "Device trade name, e.g. 'pacemaker', 'defibrillator'."
        },
        "limit": {
          "type": ["integer", "null"],
          "description": "Max PMA records to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pma_number": {"type": ["string", "null"]},
              "trade_name": {"type": ["string", "null"]},
              "applicant": {"type": ["string", "null"]},
              "decision_date": {"type": ["string", "null"]},
              "ao_statement": {"type": ["string", "null"]},
              "advisory_committee_description": {"type": ["string", "null"]},
              "supplement_number": {"type": ["string", "null"], "description": "Which supplement this row is. A PMA number alone collapses the original approval and every later change into one answer."},
              "supplement_type": {"type": ["string", "null"]},
              "supplement_reason": {"type": ["string", "null"]},
              "decision_code": {"type": ["string", "null"]},
              "date_received": {"type": ["string", "null"]},
              "generic_name": {"type": ["string", "null"]},
              "product_code": {"type": ["string", "null"]},
              "advisory_committee": {"type": ["string", "null"]},
              "expedited_review_flag": {"type": ["string", "null"]},
              "applicant_address": {"type": "object", "properties": {"street_1": {"type": ["string", "null"]}, "street_2": {"type": ["string", "null"]}, "city": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]}, "zip": {"type": ["string", "null"]}, "zip_ext": {"type": ["string", "null"]}}},
              "identifiers": {"type": "object", "description": "The clearance and registration numbers openFDA attaches to the record. These are the keys the device endpoints take as input, so a result without them cannot be followed.", "properties": {
                "k_numbers": {"type": "array", "items": {"type": "string"}, "description": "510(k) clearance numbers"},
                "pma_numbers": {"type": "array", "items": {"type": "string"}},
                "registration_numbers": {"type": "array", "items": {"type": "string"}, "description": "Establishment registration numbers"},
                "fei_numbers": {"type": "array", "items": {"type": "string"}, "description": "FDA Establishment Identifiers"},
                "device_name": {"type": ["string", "null"]},
                "device_class": {"type": ["string", "null"]},
                "regulation_number": {"type": ["string", "null"]},
                "medical_specialty_description": {"type": ["string", "null"]}
              }}
            }
          }
        },
        {
          "type": "object",
          "properties": {"error": {"type": "string"}},
          "required": ["error"]
        }
      ]
    },
    "test_examples": [
      {"device_name": "pacemaker", "limit": 5}
    ]
  }
]
