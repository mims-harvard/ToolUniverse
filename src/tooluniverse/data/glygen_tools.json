                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resource": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "e.g. Disease Ontology"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
