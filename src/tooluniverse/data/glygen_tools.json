                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "synonym": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
