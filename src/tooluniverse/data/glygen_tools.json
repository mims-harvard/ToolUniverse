[
  {
    "name": "GlyGen_get_glycan",
    "description": "Get detailed glycan structure information from GlyGen by GlyTouCan accession. Returns mass, monosaccharide count, IUPAC/WURCS representations, and the complete species and glycoprotein association records with positions, taxonomy, and evidence. Also reports the publication count. Example: G17689DH returns a 12-monosaccharide biantennary N-glycan found in human and hamster.",
    "parameter": {
      "type": "object",
      "properties": {
        "glytoucan_ac": {
          "type": "string",
          "description": "GlyTouCan accession ID for the glycan. Examples: 'G17689DH', 'G62765YT', 'G00055MO'."
        }
      },
      "required": [
        "glytoucan_ac"
      ]
    },
    "fields": {
      "endpoint_type": "glycan",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "glytoucan_ac": "G17689DH"
      },
      {
        "glytoucan_ac": "G62765YT"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "glytoucan_ac": {
              "type": "string",
              "description": "GlyTouCan accession ID"
            },
            "mass": {
              "type": "number",
              "description": "Molecular mass in Daltons"
            },
            "number_monosaccharides": {
              "type": "integer",
              "description": "Number of monosaccharide residues"
            },
            "glycan_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Glycan classification type"
            },
            "iupac": {
              "type": [
                "string",
                "null"
              ],
              "description": "IUPAC condensed notation"
            },
            "wurcs": {
              "type": [
                "string",
                "null"
              ],
              "description": "WURCS linear notation"
            },
            "species": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Complete species records, including annotation category and evidence"
            },
            "species_count": {
              "type": "integer",
              "description": "Number of returned species records"
            },
            "glycoprotein_count": {
              "type": "integer",
              "description": "Number of associated glycoproteins"
            },
            "returned_glycoprotein_count": {
              "type": "integer",
              "description": "Number of complete glycoprotein association records returned"
            },
            "glycoproteins": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Complete glycoprotein associations with site, taxonomy, and evidence qualifiers"
            },
            "publication_count": {
              "type": "integer",
              "description": "Number of associated publications"
            },
            "enzymes": {
              "type": "array",
              "description": "The biosynthetic enzymes GlyGen records for this glycan, which no tool in this family exposed",
              "items": {
                "type": "object",
                "properties": {
                  "uniprot_canonical_ac": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gene": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "protein_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tax_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tax_common_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tax_id": {
                    "type": [
                      "integer",
                      "string",
                      "null"
                    ]
                  },
                  "gene_link": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "description": "GlyGen's evidence records: the source database, the id and a link",
                    "items": {
                      "type": "object"
                    }
                  },
                  "xref_key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "xref_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "enzyme_count": {
              "type": "integer",
              "description": "Enzymes before the cap on `enzymes`"
            },
            "enzymes_truncated": {
              "type": "boolean"
            },
            "residues": {
              "type": "array",
              "description": "The structure residue by residue: each monosaccharide, the residue it hangs off and the linkage. number_monosaccharides was the only thing said about it before.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parent_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The residue this one is attached to"
                  },
                  "attached_by": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The reaction or enzyme the attachment is attributed to"
                  }
                }
              }
            },
            "residue_count": {
              "type": "integer"
            },
            "residues_truncated": {
              "type": "boolean"
            },
            "motifs": {
              "type": "array",
              "description": "Named motifs the structure contains",
              "items": {
                "type": "object",
