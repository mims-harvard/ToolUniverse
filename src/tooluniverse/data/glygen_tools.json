  {
    "name": "GlyGen_search_glycans",
    "description": "Search GlyGen for glycans by mass range, monosaccharide count, or glycan type with one-based offset pagination. Returns accessions, mass, association counts, and relevance scores. Response metadata exposes total_results, returned_count, has_more, and next_offset; follow next_offset to retrieve the complete search result.",
    "parameter": {
      "type": "object",
      "properties": {
        "mass_min": {
          "type": "number",
          "description": "Minimum molecular mass in Daltons. Example: 1000."
        },
        "mass_max": {
          "type": "number",
          "description": "Maximum molecular mass in Daltons. Example: 3000."
        },
        "monosaccharide_min": {
          "type": "integer",
          "description": "Minimum number of monosaccharide residues."
        },
        "monosaccharide_max": {
          "type": "integer",
          "description": "Maximum number of monosaccharide residues."
        },
        "glycan_type": {
          "type": "string",
          "description": "Glycan type filter. Examples: 'N-linked', 'O-linked'."
        },
        "limit": {
          "type": "integer",
          "description": "Results per request (default 20, range 1-50).",
          "default": 20,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "One-based first result (default 1). Continue with metadata.next_offset.",
          "default": 1,
          "minimum": 1
        }
      }
    },
    "fields": {
      "endpoint_type": "glycan",
      "query_mode": "search"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "mass_min": 1000,
        "mass_max": 2000,
        "monosaccharide_min": 5,
        "monosaccharide_max": 10,
        "limit": 5
      },
      {
        "mass_min": 2000,
        "mass_max": 3000,
        "monosaccharide_min": 10,
        "monosaccharide_max": 15,
        "limit": 5,
        "offset": 6
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glytoucan_ac": {
                "type": "string"
              },
              "mass": {
                "type": "number"
              },
              "number_proteins": {
                "type": "integer"
              },
              "number_enzymes": {
                "type": "integer"
              },
              "number_species": {
                "type": "integer"
              },
              "hit_score": {
                "type": "number"
              },
              "publication_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many papers GlyGen records for the glycan. The row reported counts of proteins, enzymes and species and not this one."
              },
              "pubmed_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "PubMed ids of those papers. GlyGen sends them as one semicolon-joined string ('37485378; 30251656; ...'), which a caller taking it whole would read as a single 36-id identifier, so it is split here."
              },
              "image_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "GlyGen's rendering of the glycan structure, e.g. https://api.glygen.org/glycan/image/G62765YT."
              },
              "byonic": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Byonic-format composition string with its mass, e.g. 'HexNAc(2)Hex(8) % 1720.59189791'. The form mass-spectrometry software expects."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GlyGen_get_glycoprotein",
    "description": "Get detailed glycoprotein information from GlyGen by UniProt accession. Returns all gene names with evidence and all glycosylation annotations, preserving subtype, site, attached glycan, and evidence qualifiers; also reports associated disease/pathway/SNV/publication counts. Example: P14210 (Hepatocyte Growth Factor) has 77 glycosylation annotations.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_ac": {
          "type": "string",
          "description": "UniProt accession ID. Examples: 'P14210' (HGF), 'P02724' (Glycophorin A), 'P01857' (IgG1)."
        }
      },
      "required": [
        "uniprot_ac"
      ]
    },
    "fields": {
      "endpoint_type": "protein",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "uniprot_ac": "P14210"
      },
      {
        "uniprot_ac": "P02724"
      }
    ],
