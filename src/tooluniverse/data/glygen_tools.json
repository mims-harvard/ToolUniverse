                  }
                }
              }
            },
            "subsumption": {
              "type": "array",
              "description": "Other GlyTouCan accessions for the same structure at a coarser resolution, and how they relate (Topology, Basecomposition)",
              "items": {
                "type": "object",
                "properties": {
                  "related_accession": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "relationship": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "subsumption_count": {
              "type": "integer"
            },
            "subsumption_truncated": {
              "type": "boolean"
            },
            "publications": {
              "type": "array",
              "description": "The papers behind the record, which reached the caller only as publication_count",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "journal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "authors": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": "array",
                    "description": "PubMed and other references for the paper",
                    "items": {
                      "type": "object"
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "description": "GlyGen's evidence records: the source database, the id and a link",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "publications_truncated": {
              "type": "boolean"
            },
            "expression": {
              "type": "array",
              "description": "Where the glycan has been observed, with the tissue or cell line as an ontology record",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "tissue or cell_line"
                  },
                  "tissue": {
                    "type": [
                      "object",
                      "string",
                      "null"
                    ],
                    "description": "UBERON record: name, namespace, id, url"
                  },
                  "cell_line": {
                    "type": [
                      "object",
                      "string",
                      "null"
                    ]
                  },
                  "species": {
                    "type": [
                      "object",
                      "string",
                      "null"
                    ]
                  },
                  "uniprot_canonical_ac": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The glycoprotein it was seen on"
                  },
                  "start_pos": {
                    "type": [
                      "integer",
                      "string",
                      "null"
                    ]
                  },
                  "end_pos": {
                    "type": [
                      "integer",
                      "string",
                      "null"
                    ]
                  },
                  "residue": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "description": "GlyGen evidence records: source database, id and link",
