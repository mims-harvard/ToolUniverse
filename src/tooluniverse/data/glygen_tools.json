  {
    "name": "GlyGen_get_site",
    "description": "Get detailed information about a specific glycosylation site from GlyGen. Returns the amino acid position, flanking sequences, attached glycans, SNVs at the site, phosphorylation, and mutagenesis data. Useful for studying site-specific glycosylation and its biological consequences.",
    "parameter": {
      "type": "object",
      "properties": {
        "site_id": {
          "type": "string",
          "description": "Glycosylation site identifier in format UniProtAC.start_pos.end_pos. Examples: 'P02724-1.52.52', 'P14210-1.294.294'."
        }
      },
      "required": [
        "site_id"
      ]
    },
    "fields": {
      "endpoint_type": "site",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "site_id": "P02724-1.52.52"
      },
      {
        "site_id": "P14210-1.294.294"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "site_id": {
              "type": "string"
            },
            "uniprot_ac": {
              "type": "string"
            },
            "start_pos": {
              "type": "integer"
            },
            "end_pos": {
              "type": "integer"
            },
            "site_seq": {
              "type": "string",
              "description": "Amino acid at the glycosylation site"
            },
            "upstream_seq": {
              "type": "string",
              "description": "Upstream flanking sequence"
            },
            "downstream_seq": {
              "type": "string",
              "description": "Downstream flanking sequence"
            },
            "glycosylation": {
              "type": "array",
              "description": "Glycosylation annotations at this site"
            },
            "snv": {
              "type": "array",
              "description": "SNVs at this position"
            },
            "protein_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "The protein the site is in, which the accession alone did not say"
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "glycation": {
              "type": "array",
              "description": "Glycation at the site: the same kind of annotation as the phosphorylation and mutagenesis the description promises",
              "items": {
                "type": "object"
              }
            },
            "neighbors": {
              "type": "array",
              "description": "The annotated sites around this one, with how far away and in which direction",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "distance": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "direction": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "upstream or downstream"
                  },
                  "categories": {
                    "type": "array",
                    "description": "What is annotated at the neighbouring site",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "neighbor_count": {
              "type": "integer"
            },
            "neighbors_truncated": {
              "type": "boolean"
            },
            "publications": {
              "type": "array",
              "description": "The papers behind the record, which reached the caller only as publication_count",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "journal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "authors": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": "array",
                    "description": "PubMed and other references for the paper",
                    "items": {
                      "type": "object"
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "description": "GlyGen's evidence records: the source database, the id and a link",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "publication_count": {
              "type": "integer"
            },
            "publications_truncated": {
              "type": "boolean"
            },
            "all_sites_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many sites the protein has in total, e.g. 4. Puts the one returned in context."
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "What kind of site this is, e.g. ['glycosylation_flag']."
            },
            "species": {
              "type": "array",
              "items": {
