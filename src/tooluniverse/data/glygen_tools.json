[
  {
    "name": "GlyGen_get_glycan",
    "description": "Get detailed glycan structure information from GlyGen by GlyTouCan accession. Returns mass, monosaccharide count, IUPAC/WURCS representations, and the complete species and glycoprotein association records with positions, taxonomy, and evidence. Also reports the publication count. Example: G17689DH returns a 12-monosaccharide biantennary N-glycan found in human and hamster.",
    "parameter": {
      "type": "object",
      "properties": {
        "glytoucan_ac": {
          "type": "string",
          "description": "GlyTouCan accession ID for the glycan. Examples: 'G17689DH', 'G62765YT', 'G00055MO'."
        }
      },
      "required": [
        "glytoucan_ac"
      ]
    },
    "fields": {
      "endpoint_type": "glycan",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "glytoucan_ac": "G17689DH"
      },
      {
        "glytoucan_ac": "G62765YT"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "glytoucan_ac": {
              "type": "string",
              "description": "GlyTouCan accession ID"
            },
            "mass": {
              "type": "number",
              "description": "Molecular mass in Daltons"
            },
            "number_monosaccharides": {
              "type": "integer",
              "description": "Number of monosaccharide residues"
            },
            "glycan_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Glycan classification type"
            },
            "iupac": {
              "type": [
                "string",
                "null"
              ],
              "description": "IUPAC condensed notation"
            },
            "wurcs": {
              "type": [
                "string",
                "null"
              ],
              "description": "WURCS linear notation"
            },
            "species": {
              "type": "array",
              "items": {"type": "object"},
              "description": "Complete species records, including annotation category and evidence"
            },
            "species_count": {
              "type": "integer",
              "description": "Number of returned species records"
            },
            "glycoprotein_count": {
              "type": "integer",
              "description": "Number of associated glycoproteins"
            },
            "returned_glycoprotein_count": {
              "type": "integer",
              "description": "Number of complete glycoprotein association records returned"
            },
            "glycoproteins": {
              "type": "array",
              "items": {"type": "object"},
              "description": "Complete glycoprotein associations with site, taxonomy, and evidence qualifiers"
            },
            "publication_count": {
              "type": "integer",
              "description": "Number of associated publications"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GlyGen_search_glycans",
    "description": "Search GlyGen for glycans by mass range, monosaccharide count, or glycan type with one-based offset pagination. Returns accessions, mass, association counts, and relevance scores. Response metadata exposes total_results, returned_count, has_more, and next_offset; follow next_offset to retrieve the complete search result.",
    "parameter": {
      "type": "object",
      "properties": {
        "mass_min": {
          "type": "number",
          "description": "Minimum molecular mass in Daltons. Example: 1000."
        },
        "mass_max": {
          "type": "number",
          "description": "Maximum molecular mass in Daltons. Example: 3000."
        },
        "monosaccharide_min": {
          "type": "integer",
          "description": "Minimum number of monosaccharide residues."
        },
        "monosaccharide_max": {
          "type": "integer",
          "description": "Maximum number of monosaccharide residues."
        },
        "glycan_type": {
          "type": "string",
          "description": "Glycan type filter. Examples: 'N-linked', 'O-linked'."
        },
        "limit": {
          "type": "integer",
          "description": "Results per request (default 20, range 1-50).",
          "default": 20,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "One-based first result (default 1). Continue with metadata.next_offset.",
          "default": 1,
          "minimum": 1
        }
      }
    },
    "fields": {
      "endpoint_type": "glycan",
      "query_mode": "search"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "mass_min": 1000,
        "mass_max": 2000,
        "monosaccharide_min": 5,
        "monosaccharide_max": 10,
        "limit": 5
      },
      {
        "mass_min": 2000,
        "mass_max": 3000,
        "monosaccharide_min": 10,
        "monosaccharide_max": 15,
        "limit": 5,
        "offset": 6
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glytoucan_ac": {
                "type": "string"
              },
              "mass": {
                "type": "number"
              },
              "number_proteins": {
                "type": "integer"
              },
              "number_enzymes": {
                "type": "integer"
              },
              "number_species": {
                "type": "integer"
              },
              "hit_score": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GlyGen_get_glycoprotein",
    "description": "Get detailed glycoprotein information from GlyGen by UniProt accession. Returns all gene names with evidence and all glycosylation annotations, preserving subtype, site, attached glycan, and evidence qualifiers; also reports associated disease/pathway/SNV/publication counts. Example: P14210 (Hepatocyte Growth Factor) has 77 glycosylation annotations.",
    "parameter": {
      "type": "object",
      "properties": {
        "uniprot_ac": {
          "type": "string",
          "description": "UniProt accession ID. Examples: 'P14210' (HGF), 'P02724' (Glycophorin A), 'P01857' (IgG1)."
        }
      },
      "required": [
        "uniprot_ac"
      ]
    },
    "fields": {
      "endpoint_type": "protein",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "uniprot_ac": "P14210"
      },
      {
        "uniprot_ac": "P02724"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protein_name": {
              "type": "string"
            },
            "gene_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gene_name_count": {
              "type": "integer"
            },
            "gene_name_details": {
              "type": "array",
              "items": {"type": "object"},
              "description": "Complete gene-name records with type and evidence"
            },
            "species": {
              "type": "string"
            },
            "glycosylation_count": {
              "type": "integer",
              "description": "Total number of glycosylation annotations"
            },
            "glycosylation_sites": {
              "type": "array",
              "description": "Glycosylation site details with positions, types, and attached glycans"
            },
            "returned_glycosylation_count": {
              "type": "integer",
              "description": "Number of complete glycosylation annotations returned"
            },
            "disease_count": {
              "type": "integer"
            },
            "pathway_count": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GlyGen_search_glycoproteins",
    "description": "Search GlyGen for glycoproteins by organism, glycosylation evidence/type, protein name, or gene name with one-based offset pagination. Returns matching proteins with glycosylation-site counts and relevance scores. Response metadata exposes total_results, returned_count, has_more, and next_offset; follow next_offset for complete retrieval.",
    "parameter": {
      "type": "object",
      "properties": {
        "organism_id": {
          "type": "integer",
          "description": "NCBI taxonomy ID. Examples: 9606 (human), 10090 (mouse), 10029 (Chinese hamster)."
        },
        "glycosylation_evidence": {
          "type": "string",
          "description": "Evidence level filter. Options: 'reported' (experimentally confirmed)."
        },
        "glycosylation_type": {
          "type": "string",
          "description": "Type of glycosylation. Examples: 'N-linked', 'O-linked'."
        },
        "protein_name": {
          "type": "string",
          "description": "Protein name to search. Example: 'transferrin'."
        },
        "gene_name": {
          "type": "string",
          "description": "Gene name to search. Example: 'EGFR'."
        },
        "limit": {
          "type": "integer",
          "description": "Results per request (default 20, range 1-50).",
          "default": 20,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "One-based first result (default 1). Continue with metadata.next_offset.",
          "default": 1,
          "minimum": 1
        }
      }
    },
    "fields": {
      "endpoint_type": "protein",
      "query_mode": "search"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "organism_id": 9606,
        "glycosylation_evidence": "reported",
        "limit": 5
      },
      {
        "gene_name": "EGFR",
        "limit": 5,
        "offset": 6
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uniprot_canonical_ac": {
                "type": "string"
              },
              "protein_name": {
                "type": "string"
              },
              "gene_name": {
                "type": "string"
              },
              "organism": {
                "type": "string"
              },
              "glycosylation_count": {
                "type": "integer"
              },
              "hit_score": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GlyGen_get_site",
    "description": "Get detailed information about a specific glycosylation site from GlyGen. Returns the amino acid position, flanking sequences, attached glycans, SNVs at the site, phosphorylation, and mutagenesis data. Useful for studying site-specific glycosylation and its biological consequences.",
    "parameter": {
      "type": "object",
      "properties": {
        "site_id": {
          "type": "string",
          "description": "Glycosylation site identifier in format UniProtAC.start_pos.end_pos. Examples: 'P02724-1.52.52', 'P14210-1.294.294'."
        }
      },
      "required": [
        "site_id"
      ]
    },
    "fields": {
      "endpoint_type": "site",
      "query_mode": "detail"
    },
    "type": "GlyGenTool",
    "test_examples": [
      {
        "site_id": "P02724-1.52.52"
      },
      {
        "site_id": "P14210-1.294.294"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "site_id": {
              "type": "string"
            },
            "uniprot_ac": {
              "type": "string"
            },
            "start_pos": {
              "type": "integer"
            },
            "end_pos": {
              "type": "integer"
            },
            "site_seq": {
              "type": "string",
              "description": "Amino acid at the glycosylation site"
            },
            "upstream_seq": {
              "type": "string",
              "description": "Upstream flanking sequence"
            },
            "downstream_seq": {
              "type": "string",
              "description": "Downstream flanking sequence"
            },
            "glycosylation": {
              "type": "array",
              "description": "Glycosylation annotations at this site"
            },
            "snv": {
              "type": "array",
              "description": "SNVs at this position"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
