[
  {
    "name": "InspireHEP_search_papers",
    "description": "Search high-energy physics literature in INSPIRE-HEP. Results use exact one-based page pagination: begin with page=1 and continue with metadata.next_page while metadata.has_more is true; metadata.total_results is exact. Returns titles, authors, abstracts, citation counts, DOI and arXiv identifiers.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "INSPIRE search query. Examples: 'higgs boson discovery', 'author:einstein', 'a:witten AND string theory', 'dark matter direct detection', 'cn:atlas AND higgs', 't:gravitational waves'. Use field prefixes: a: or author:, t: or title:, j: journal, cn: collaboration"
        },
        "sort": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sort order. Values: 'mostrecent' (default), 'mostcited'. Examples: 'mostcited' to get highest-cited papers first"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 25,
          "default": 10,
          "description": "Results per page (1-25, default 10)"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based result page. Continue with metadata.next_page."
        },
        "fields": {
          "type": [
            "string",
            "null"
          ],
          "description": "Comma-separated fields to return. Default includes titles, authors, abstract, citations. Example: 'titles,authors,abstract,citation_count,arxiv_eprints,dois'"
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://inspirehep.net/api/literature",
      "params": {
        "sort": "mostrecent"
      },
      "pagination": "inspire_page"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "higgs boson LHC discovery",
        "sort": "mostcited",
        "size": 5
      },
      {
        "q": "author:witten string theory",
        "size": 5
      },
      {
        "q": "gravitational waves LIGO detection",
        "sort": "mostrecent",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "INSPIRE-HEP literature search results",
          "properties": {
            "hits": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "description": "Total matching papers"
                },
                "hits": {
                  "type": "array",
                  "description": "List of paper records",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "INSPIRE record ID"
                      },
                      "metadata": {
                        "type": "object",
                        "properties": {
                          "titles": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "authors": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "abstract": {
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "citation_count": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "citation_count_without_self_citations": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "arxiv_eprints": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "dois": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "collaborations": {
                            "type": "array"
                          },
                          "publication_info": {
                            "type": "array"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
