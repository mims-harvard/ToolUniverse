  {
    "name": "CryoET_list_runs",
    "type": "CryoETTool",
    "required_packages": [
      "requests"
    ],
    "description": "List the experimental tilt-series acquisition runs within a specific CryoET Data Portal dataset. Each run corresponds to one sample grid position with its own tilt series, tomograms, and annotations. Returns run names and data access paths. Use this after `CryoET_get_dataset` to enumerate the runs for a dataset before fetching tomograms or annotations.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "description": "Operation type",
          "enum": [
            "list_runs"
          ],
          "default": "list_runs"
        },
        "dataset_id": {
          "type": "integer",
          "description": "Numeric dataset ID (e.g. 10053)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of runs to return (default: 20).",
          "default": 20
        },
        "offset": {
          "type": "integer",
          "description": "Number of runs to skip for pagination (default: 0).",
          "default": 0
        }
      },
      "required": [
        "operation",
        "dataset_id"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "properties": {
                "dataset_id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "datasetId": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "s3Prefix": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "httpsPrefix": {
                        "type": [
                          "null",
                          "string"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
