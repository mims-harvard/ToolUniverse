[
  {
    "name": "umls_search_concepts",
    "description": "Search for concepts in UMLS (Unified Medical Language System) using concept names or terms. UMLS provides access to multiple medical terminologies including SNOMED CT, ICD-10, ICD-11, LOINC, RxNorm, and more. Requires free UMLS API key (register at https://uts.nlm.nih.gov/uts/). Set UMLS_API_KEY environment variable.",
    "type": "UMLSRESTTool",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query (concept name or term)"
        },
        "sabs": {
          "type": "string",
          "description": "Source abbreviation(s) to filter by (e.g., 'SNOMEDCT_US', 'ICD10CM', 'LOINC', 'RXNORM'). Comma-separated for multiple sources. Optional, searches all sources if not specified."
        },
        "pageNumber": {
          "type": "integer",
          "description": "Page number for pagination (default: 1)",
          "default": 1
        },
        "pageSize": {
          "type": "integer",
          "description": "Number of results per page (default: 25, max: 25)",
          "default": 25
        }
      },
      "required": [
        "query"
      ],
      "required_api_keys": [
        "UMLS_API_KEY"
      ]
    },
    "fields": {
      "endpoint": "/search/current",
      "return_format": "JSON",
      "base_url": "https://uts-ws.nlm.nih.gov/rest"
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ui": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "rootSource": {
                    "type": "string"
                  }
                }
              }
            },
            "classType": {
              "type": [
                "string",
                "null"
              ],
              "description": "The kind of record UMLS returned, e.g. searchResults"
            },
            "recCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many records the search matched"
            }
          }
        },
        "pageNumber": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page returned"
        },
        "pageSize": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page size applied"
        },
        "partialSearch": {
          "type": [
            "boolean",
            "null",
            "string"
          ],
          "description": "Whether UMLS treated the query as a partial match"
        }
      }
    },
    "test_examples": [
      {
        "query": "machine learning optimization",
        "sabs": "SNOMEDCT_US",
        "pageNumber": 1,
        "pageSize": 25
      }
    ],
    "optional_api_keys": [
      "UMLS_API_KEY"
    ],
    "api_key_info": {
      "UMLS_API_KEY": {
        "domain": "Clinical & Safety",
        "type": "secret",
        "register_url": "https://uts.nlm.nih.gov/uts/signup-login",
        "purpose": "Authenticate to UMLS for concept, SNOMED CT, and LOINC lookups.",
        "without": "UMLS/SNOMED/LOINC tools are blocked without it (free UMLS license)."
      }
    },
    "required_api_keys": [
      "UMLS_API_KEY"
    ]
  },
  {
    "name": "umls_get_concept_details",
    "description": "Get detailed information about a UMLS concept by its CUI (Concept Unique Identifier). Returns concept details, atoms, definitions, relations, and mappings to other terminologies. Requires free UMLS API key (register at https://uts.nlm.nih.gov/uts/). Set UMLS_API_KEY environment variable.",
    "type": "UMLSRESTTool",
    "parameter": {
      "type": "object",
      "properties": {
        "cui": {
          "type": "string",
          "description": "UMLS Concept Unique Identifier (CUI, e.g., 'C0004096')"
        },
        "pageNumber": {
          "type": "integer",
          "description": "Page number for pagination (default: 1)",
          "default": 1
        },
        "pageSize": {
          "type": "integer",
          "description": "Number of results per page (default: 25)",
          "default": 25
        }
      },
      "required": [
        "cui"
      ],
      "required_api_keys": [
        "UMLS_API_KEY"
      ]
    },
    "fields": {
      "endpoint": "/content/current/CUI/{cui}",
      "return_format": "JSON",
      "base_url": "https://uts-ws.nlm.nih.gov/rest"
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "ui": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "definitions": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL listing the concept's definitions; UMLS sends a link, not the text. The schema previously declared a singular `definition` field that the API never sends"
            },
            "atoms": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL listing the concept's atoms (its names in each source vocabulary)"
            },
            "relations": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL listing the concept's relations to other concepts"
            },
            "semanticTypes": {
              "type": [
                "array",
                "null"
              ],
              "description": "The UMLS semantic types the concept belongs to - 'Disease or Syndrome', 'Pharmacologic Substance' and so on. This is how a caller tells a disease concept from a drug concept",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Semantic type name"
                  },
                  "uri": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "URI of the semantic type, ending in its TUI, e.g. .../TUI/T047"
                  }
                }
              }
            },
            "suppressible": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether UMLS suppresses this concept; a suppressed concept should not be used as a current term"
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "description": "The concept's status in this UMLS release"
            },
            "classType": {
              "type": [
                "string",
                "null"
              ],
              "description": "The kind of record, e.g. Concept"
            },
            "dateAdded": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the concept entered UMLS"
            },
            "majorRevisionDate": {
              "type": [
                "string",
                "null"
              ],
              "description": "When it was last substantially revised"
            },
            "atomCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many atoms the concept has"
            },
            "relationCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many relations it has"
            },
            "attributeCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many attributes it has"
            },
            "cvMemberCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many content-view memberships it has"
            },
            "defaultPreferredAtom": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL of the atom UMLS treats as the concept's preferred name"
            }
          }
        },
        "pageCount": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Total pages available"
        },
        "pageNumber": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page returned"
        },
        "pageSize": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page size used"
        }
      }
    },
    "test_examples": [
      {
        "cui": "C0011849",
        "pageNumber": 1,
        "pageSize": 25
      }
    ],
    "required_api_keys": [
      "UMLS_API_KEY"
    ]
  },
  {
    "name": "icd_search_codes",
    "description": "Search for ICD-10 or ICD-11 codes using UMLS. Returns matching codes with descriptions. Requires free UMLS API key (register at https://uts.nlm.nih.gov/uts/). Set UMLS_API_KEY environment variable.",
    "type": "UMLSRESTTool",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query (disease name, condition, or ICD code)"
        },
        "version": {
          "type": "string",
          "enum": [
            "ICD10CM",
            "ICD10",
            "ICD11"
          ],
          "description": "ICD version to search (ICD10CM for US clinical modification, ICD10 for international, ICD11 for ICD-11)",
          "default": "ICD10CM"
        },
        "pageNumber": {
          "type": "integer",
          "description": "Page number for pagination (default: 1)",
          "default": 1
        },
        "pageSize": {
          "type": "integer",
          "description": "Number of results per page (default: 25, max: 25)",
          "default": 25
        }
      },
      "required": [
        "query"
      ],
      "required_api_keys": [
        "UMLS_API_KEY"
      ]
    },
    "fields": {
      "endpoint": "/search/current",
      "return_format": "JSON",
      "base_url": "https://uts-ws.nlm.nih.gov/rest",
      "sabs": "ICD10CM"
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ui": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "rootSource": {
                    "type": "string"
                  }
                }
              }
            },
            "classType": {
              "type": [
                "string",
                "null"
              ],
              "description": "The UTS class of the payload, e.g. 'searchResults'."
            },
            "recCount": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many records the UTS returned. ZERO with a non-empty result list means the UTS found nothing and echoed the query, which is the shape a no-match answer takes here."
            }
          }
        },
        "pageNumber": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Which page of results this is."
        },
        "pageSize": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Page size the UTS applied."
        },
        "partialSearch": {
          "type": [
            "string",
            "null"
          ],
          "description": "The UTS search URL this result came from, with the vocabularies and options that were actually sent. The record of what was searched, which the arguments alone do not show."
        }
      }
    },
    "test_examples": [
      {
        "query": "machine learning optimization",
        "version": "ICD10CM",
        "pageNumber": 1,
        "pageSize": 25
      }
    ],
    "required_api_keys": [
      "UMLS_API_KEY"
    ]
  },
