[
  {
    "name": "GBIF_search_species",
    "type": "GBIFTool",
    "description": "Find taxa by scientific/common-name keyword in GBIF with exact total and offset continuation. Continue with metadata.next_offset. GBIF species search exposes at most the first 100,000 ranked matches; refine broad queries when metadata.upstream_truncated is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search string for species/taxa (supports scientific/common names), e.g., 'Homo', 'Atlantic cod'."
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of results to return (1–1000). GBIF silently clamps larger values to 1000."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Result offset for pagination. The wrapper enforces offset + limit <= 100000."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://api.gbif.org/v1/species/search",
      "format": "json"
    },
    "return_schema": {
      "type": "object",
      "description": "GBIF species search response",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total records matching the query, which is not the number returned"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "GBIF key for this name record"
                  },
                  "scientificName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Full scientific name with authorship"
                  },
                  "rank": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Taxonomic rank"
                  },
                  "kingdom": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Kingdom in the classification"
                  },
                  "phylum": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Phylum in the classification"
                  },
                  "class": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Class in the classification"
                  },
                  "order": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Order in the classification"
                  },
                  "family": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Family in the classification"
                  },
                  "genus": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Genus in the classification"
                  },
                  "nubKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone taxon the name matched; for a synonym this differs from key"
                  },
                  "nameKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Key of the name itself"
                  },
                  "canonicalName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Name without authorship"
                  },
                  "authorship": {
                    "type": [
                      "string",
                      "null"
                    ],
