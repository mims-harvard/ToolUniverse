          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "The GBIF endpoint the wrapper called"
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "description": "Wrapper metadata about the request",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        },
        "query": {
          "type": [
            "object",
            "string",
