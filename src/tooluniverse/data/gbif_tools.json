                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ]
                    }
                  },
                  "vernacularNames": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "description": "Common names for the taxon",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ]
                    }
                  },
                  "kingdomKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the kingdom"
                  },
                  "phylumKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the phylum"
                  },
                  "classKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the class"
                  },
                  "orderKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the order"
                  },
                  "familyKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the family"
                  },
                  "genusKey": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Backbone key of the genus"
                  }
                }
              }
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Page size applied"
            },
            "offset": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Offset of this page"
            },
            "endOfRecords": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when this page is the last; the only signal that the result is complete"
            },
            "facets": {
              "type": [
                "array",
                "null"
              ],
              "description": "Facet counts GBIF computed for the query",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object",
                    "null"
                  ]
                }
              }
            }
