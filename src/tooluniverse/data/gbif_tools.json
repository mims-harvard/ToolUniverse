  {
    "name": "GBIF_search_occurrences",
    "type": "GBIFOccurrenceTool",
    "description": "Retrieve GBIF occurrence records with exact total and offset continuation. Continue with metadata.next_offset. Search results expose at most the first 100,001 records; refine filters or use GBIF's download API when metadata.upstream_truncated is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxonKey": {
          "type": "integer",
          "description": "GBIF taxon key to filter occurrences by a specific taxon (from species search)."
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code filter (e.g., 'US', 'CN')."
        },
        "hasCoordinate": {
          "type": "boolean",
          "default": true,
          "description": "Only return records with valid latitude/longitude coordinates when true."
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 300,
          "description": "Maximum number of results to return (1–300)."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset. The wrapper enforces GBIF's current offset + limit <= 100001 window."
        }
      }
    },
    "fields": {
      "endpoint": "https://api.gbif.org/v1/occurrence/search",
      "format": "json"
    },
