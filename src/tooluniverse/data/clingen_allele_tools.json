[
  {
    "name": "ClinGenAllele_lookup_hgvs",
    "description": "Look up a genetic variant by HGVS expression in the ClinGen Allele Registry. Returns the CA ID plus complete external database records, genomic alleles, transcript alleles, HGVS forms, coordinates, reference sequences, protein effects, and explicit counts; no former 5/10-record cutoffs. Accepts genomic, coding, or protein HGVS.",
    "parameter": {
      "type": "object",
      "properties": {
        "hgvs": {
          "type": "string",
          "description": "HGVS expression for the variant. Examples: 'NC_000017.11:g.7674220C>T' (genomic), 'NM_000546.6:c.743G>A' (coding). Must use a valid reference sequence accession."
        }
      },
      "required": ["hgvs"]
    },
    "fields": {
      "operation": "lookup_hgvs"
    },
    "type": "ClinGenAlleleTool",
    "test_examples": [
      {
        "hgvs": "NC_000017.11:g.7674220C>T"
      },
      {
        "hgvs": "NM_000546.6:c.743G>A"
      }
    ],
    "return_schema": {
      "type": "object",
      "properties": {
        "ca_id": {"type": ["string", "null"]},
        "community_standard_title": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "external_records": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "external_record_details": {"type": "object"},
        "external_record_count": {"type": "integer"},
        "genomic_alleles": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "chromosome": {"type": ["string", "null"]},
              "start": {"type": ["integer", "null"]},
              "end": {"type": ["integer", "null"]},
              "allele": {"type": ["string", "null"]},
              "reference_allele": {"type": ["string", "null"]},
              "reference_genome": {"type": ["string", "null"]},
              "hgvs": {"type": "array", "items": {"type": "string"}},
              "reference_sequence": {"type": ["string", "null"]}
            }
          }
        },
        "genomic_allele_count": {"type": "integer"},
        "transcript_alleles": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "hgvs": {"type": ["array", "null"], "items": {"type": "string"}},
              "gene_symbol": {"type": ["string", "null"]},
              "protein_effect": {"type": ["string", "null"]},
              "protein_effect_details": {"type": ["object", "null"]},
              "coordinates": {"type": "array"},
              "gene": {"type": ["string", "null"]},
              "gene_ncbi_id": {"type": ["integer", "null"]},
              "reference_sequence": {"type": ["string", "null"]}
            }
          }
        },
        "transcript_allele_count": {"type": "integer"}
      }
    }
  },
  {
    "name": "ClinGenAllele_get_allele",
    "description": "Get complete information for a ClinGen Allele Registry CA ID, including all external records, genomic alleles, transcript alleles, HGVS forms, coordinates, reference sequences, protein effects, and explicit counts; no former 5/10-record cutoffs.",
    "parameter": {
      "type": "object",
      "properties": {
        "ca_id": {
          "type": ["string", "null"],
          "description": "ClinGen canonical allele identifier (e.g., 'CA000387'). Obtain from ClinGenAllele_lookup_hgvs or ClinVar."
        },
        "allele_id": {
          "type": ["string", "null"],
          "description": "Alias for ca_id. ClinGen canonical allele identifier (e.g., 'CA000387')."
        }
      },
      "required": []
    },
