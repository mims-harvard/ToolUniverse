[
  {
    "type": "PGSCatalogTool",
    "name": "PGSCatalog_search_traits",
    "description": "Search the PGS Catalog (pgscatalog.org, EMBL-EBI — the open database of published polygenic scores) for traits/phenotypes matching a term. Returns each matching trait's id (EFO/MONDO, e.g. 'MONDO_0004989'), label, description, and the number of polygenic scores published for it. Use this first to find the trait_id, then PGSCatalog_get_scores_by_trait to list its scores. No API key.",
    "fields": {"operation": "search_traits"},
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Trait or phenotype term, e.g. 'coronary artery disease', 'type 2 diabetes', 'breast cancer'. PGS Catalog's own search can return zero results for some multi-word phrases that don't exactly match an indexed label even when a near-identical trait exists (e.g. 'familial hypercholesterolemia' finds nothing while 'hypercholesterolemia' alone does) -- if a natural-language query returns no results, retry with a shorter or more generic core term."
        }
      },
      "required": ["query"]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trait_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "n_scores": {
                "type": "integer"
              },
              "associated_pgs_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The trait's own polygenic score ids, already in the search response. MONDO_0005010 has 88"
              },
              "child_associated_pgs_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Scores attached to CHILD terms of the trait. Measured on MONDO_0005010: 8, and none is returned by PGSCatalog_get_scores_by_trait for this trait_id, so without this field they are reachable through no call this tool makes"
              },
              "n_child_scores": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many child-term scores exist, before the cap"
              },
              "trait_synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Why a row matched: the query 'coronary artery disease' is a synonym of the label 'coronary artery disorder'"
              },
              "trait_categories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "PGS Catalog categories, e.g. 'Cardiovascular disease'"
              },
              "trait_mapped_terms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Other ontology terms the trait maps to"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Ontology URL for the trait"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [{"query": "coronary artery disease"}]
  },
  {
    "type": "PGSCatalogTool",
    "name": "PGSCatalog_get_scores_by_trait",
    "description": "List the published polygenic scores (PGS) for a trait in the PGS Catalog, given its EFO/MONDO trait id (find one with PGSCatalog_search_traits). Each score summary includes the PGS id, name, reported trait, number of variants, development method, genome build, and publication (author/journal/year/PMID/DOI) plus the scoring-file URL. Use PGSCatalog_get_score for the full record of one score. No API key.",
    "fields": {"operation": "get_scores_by_trait"},
    "parameter": {
      "type": "object",
      "properties": {
        "trait_id": {
          "type": "string",
          "description": "EFO or MONDO trait id, e.g. 'MONDO_0004989' (breast carcinoma) or 'EFO_0001645' (coronary artery disease)."
        }
      },
      "required": ["trait_id"]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pgs_id": {
                "type": "string"
              },
              "trait_reported": {
                "type": "string"
              },
              "variants_number": {
                "type": "integer"
              },
              "method_name": {
                "type": "string"
              },
              "publication": {
                "type": "object"
              },
              "scoring_file": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [{"trait_id": "MONDO_0004989"}]
  },
  {
    "type": "PGSCatalogTool",
    "name": "PGSCatalog_get_score",
    "description": "Retrieve the full metadata for a specific polygenic score from the PGS Catalog by its PGS id (e.g. 'PGS000001'): reported and EFO/MONDO traits, number of variants, development method, genome build, weight type, publication, training samples, ancestry distribution, and the downloadable scoring-file URL. Find PGS ids with PGSCatalog_get_scores_by_trait. No API key.",
    "fields": {"operation": "get_score"},
    "parameter": {
      "type": "object",
      "properties": {
        "pgs_id": {
          "type": "string",
          "description": "PGS Catalog score id, e.g. 'PGS000001'."
        }
      },
      "required": ["pgs_id"]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pgs_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "trait_reported": {
              "type": "string"
            },
            "trait_efo": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "EFO/MONDO id"
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Trait label"
                  }
                }
              }
            },
            "variants_number": {
              "type": "integer"
            },
            "method_name": {
              "type": "string"
            },
            "genome_build": {
              "type": "string"
            },
            "publication": {
              "type": "object",
              "properties": {
                "first_author": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "First author"
                },
                "journal": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Journal"
                },
                "year": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Publication year"
                },
                "pmid": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ],
                  "description": "PubMed id"
                },
                "doi": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "DOI"
                }
              }
            },
            "ancestry_distribution": {
              "type": [
                "object",
                "null"
              ],
              "description": "The Catalog's ancestry breakdown keyed by stage ('gwas' for discovery, 'dev' for development, 'eval' for evaluation)",
              "additionalProperties": {
                "type": "object",
                "description": "One stage",
                "properties": {
                  "dist": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Percentage per ancestry code, e.g. {'EUR': 64.9, 'AFR': 8.1}",
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Samples at this stage"
                  },
                  "multi": {
                    "type": "array",
                    "description": "Multi-ancestry group codes",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "scoring_file": {
              "type": "string"
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "description": "Terms under which the scoring file may be reused"
            },
            "harmonized_scoring_files": {
              "type": [
                "object",
                "null"
              ],
              "description": "Scoring files harmonized per genome build, keyed by build ('GRCh37', 'GRCh38'); what applying the score to one's own genotypes needs, where the plain scoring_file is in the author's original build",
              "additionalProperties": {
                "type": "object",
                "description": "Files for one build",
                "properties": {
                  "positions": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "URL of the position-harmonized scoring file"
                  }
                }
              }
            },
            "matches_publication": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the Catalog's curation matches the paper it cites"
            },
            "method_params": {
              "type": [
                "string",
                "null"
              ],
              "description": "The method's actual parameters, e.g. 'p=1.23^-3, r^2=0.21'; method_name alone does not identify the score"
            },
            "date_release": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the Catalog released this score"
            },
            "trait_additional": {
              "type": [
                "string",
                "null"
              ],
              "description": "Further trait information published by the authors"
            },
            "samples_training": {
              "type": [
                "array",
                "null"
              ],
              "description": "The samples the score's weights were fitted in, as the Catalog publishes them"
            },
            "samples_variants": {
              "type": "array",
              "description": "The GWAS the score's variants were discovered in. Distinct from samples_training: transferability depends on both",
              "items": {
                "type": "object",
                "properties": {
                  "sample_number": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of samples"
                  },
                  "ancestry_broad": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Broad ancestry category"
                  },
                  "ancestry_free": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ancestry as the authors described it"
                  },
                  "source_PMID": {
                    "type": [
                      "integer",
                      "string",
                      "null"
                    ],
                    "description": "PubMed id of the discovery GWAS"
                  },
                  "source_GWAS_catalog": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GWAS Catalog accession, e.g. GCST003116"
                  },
                  "cohorts": {
                    "type": "array",
                    "description": "Short names of the contributing cohorts",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "weight_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Whether the weights are log(OR), log(HR), beta or similar"
            }
          },
          "required": [
            "pgs_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [{"pgs_id": "PGS000001"}]
  },
  {
    "type": "PGSCatalogTool",
    "name": "PGSCatalog_get_performance_metrics",
    "description": "Retrieve the published validation/evaluation performance metrics for a polygenic score from the PGS Catalog by its PGS id (e.g. 'PGS000001'). Returns one record per evaluation sample set, each with: effect sizes (Odds Ratio OR, Hazard Ratio HR, beta), classification accuracy (AUROC, Concordance/C-index), and other metrics (R2, top-vs-bottom quantile OR) — each as an estimate with 95% CI (ci_lower/ci_upper) — plus the evaluation cohort ancestry (ancestry_broad/free/country) and sample size (sample_number, cases, controls), covariates, and source publication. Use this to judge how well a score predicts and in which ancestries it was validated. Find PGS ids with PGSCatalog_get_scores_by_trait. No API key.",
    "fields": {"operation": "get_performance_metrics"},
    "parameter": {
      "type": "object",
      "properties": {
        "pgs_id": {
          "type": "string",
          "description": "PGS Catalog score id, e.g. 'PGS000001' or 'PGS000004'."
        }
      },
      "required": ["pgs_id"]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ppm_id": {
                "type": "string"
              },
              "pgs_id": {
                "type": "string"
              },
              "phenotyping_reported": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "covariates": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effect_sizes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name_short": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name_long": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "estimate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ci_lower": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "ci_upper": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              },
              "classification_accuracy": {
                "type": "array"
              },
              "other_metrics": {
                "type": "array"
              },
              "evaluation_sampleset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evaluation_samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sample_number": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "sample_cases": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "sample_controls": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "ancestry_broad": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ancestry_country": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "publication": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [{"pgs_id": "PGS000001"}]
  }
]
