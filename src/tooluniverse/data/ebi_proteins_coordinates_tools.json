[
    {
        "name": "EBIProteins_get_coordinate_mapping",
        "description": "Map UniProt protein positions to genomic coordinates at exon-level resolution. Transcript coordinate mappings and exons within every mapping are independently paginated. Inspect total/returned/truncated/next-offset fields at both levels; proteins such as CACNA1C have dozens of mappings and TTN has hundreds of exons.",
        "parameter": {
            "type": "object",
            "properties": {
                "accession": {
                    "type": "string",
                    "description": "UniProt accession. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (Insulin), 'P69905' (HBA1 hemoglobin alpha)."
                },
                "coordinate_offset": {
                    "type": "integer",
                    "description": "Zero-based transcript coordinate-mapping offset.",
                    "default": 0,
                    "minimum": 0
                },
                "coordinate_limit": {
                    "type": "integer",
                    "description": "Coordinate mappings returned per page (default 10, maximum 500).",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 500
                },
                "exon_offset": {
                    "type": "integer",
                    "description": "Zero-based exon offset applied within every returned coordinate mapping.",
                    "default": 0,
                    "minimum": 0
                },
                "exon_limit": {
                    "type": "integer",
                    "description": "Exons returned per coordinate mapping (default 20, maximum 1000).",
                    "default": 20,
                    "minimum": 1,
                    "maximum": 1000
                }
            },
            "required": ["accession"]
        },
        "fields": {
            "endpoint": "get_coordinates"
        },
        "type": "EBIProteinsCoordinatesTool",
        "test_examples": [
            {
                "accession": "P04637"
            },
            {
                "accession": "P00533"
            }
        ],
        "return_schema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "accession": {"type": "string"},
                        "protein_name": {"type": ["string", "null"]},
                        "taxid": {"type": "integer"},
                        "gene": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "value": {"type": "string"},
                                    "type": {"type": "string"}
                                }
                            }
                        },
                        "coordinate_mappings": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "ensembl_gene_id": {"type": ["string", "null"]},
                                    "ensembl_transcript_id": {"type": ["string", "null"]},
                                    "ensembl_translation_id": {"type": ["string", "null"]},
                                    "chromosome": {"type": ["string", "null"]},
                                    "start": {"type": ["integer", "null"]},
                                    "end": {"type": ["integer", "null"]},
                                    "reverse_strand": {"type": ["boolean", "null"]},
                                    "num_exons": {"type": "integer"},
                                    "exon_offset": {"type": "integer"},
                                    "exons_returned": {"type": "integer"},
                                    "exons_truncated": {"type": "boolean"},
                                    "next_exon_offset": {"type": ["integer", "null"]},
                                    "exons": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "exon_id": {"type": ["string", "null"]},
                                                "protein_start": {"type": ["integer", "null"]},
                                                "protein_end": {"type": ["integer", "null"]},
                                                "genome_start": {"type": ["integer", "null"]},
                                                "genome_end": {"type": ["integer", "null"]}
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "total_coordinate_mappings": {"type": "integer"},
                        "coordinate_offset": {"type": "integer"},
                        "coordinate_mappings_returned": {"type": "integer"},
                        "coordinate_mappings_truncated": {"type": "boolean"},
                        "next_coordinate_offset": {"type": ["integer", "null"]}
                    }
                },
                {
                    "type": "object",
                    "properties": {
                        "error": {"type": "string"}
                    },
                    "required": ["error"]
                }
            ]
        }
    },
    {
        "name": "EBIProteins_get_proteins_by_genomic_loc",
        "description": "Reverse genome-to-protein coordinate lookup from the EBI Proteins API: given a genomic position (taxonomy + chromosome:position), return all UniProt proteins whose coding sequence overlaps that position, with exon-level mapping (accession, Ensembl gene/transcript/translation IDs, protein start/end residue, amino acid, chromosome, strand, assembly). Inverse of EBIProteins_get_coordinate_mapping. Use to find which proteins a chromosomal variant affects and at which residue. Example: taxonomy 9606, location '17:7676154' returns 18 entries including TP53 (P04637) at protein residue 72 (Pro) on ENST00000923569.",
        "parameter": {
            "type": "object",
            "properties": {
                "taxonomy": {
                    "type": ["string", "integer"],
                    "description": "NCBI taxonomy ID. Default '9606' (human). Example: 9606 (Homo sapiens), 10090 (mouse)."
                },
                "location": {
                    "type": ["string", "null"],
                    "description": "Genomic location as 'chromosome:position' (1-based). Example: '17:7676154'. Provide this OR both 'chromosome' and 'position'."
                },
                "chromosome": {
                    "type": ["string", "integer", "null"],
                    "description": "Chromosome (used with 'position' if 'location' not given). Example: '17', 'X'."
                },
                "position": {
                    "type": ["string", "integer", "null"],
                    "description": "1-based genomic position (used with 'chromosome' if 'location' not given). Example: 7676154."
                }
            },
            "required": []
        },
        "fields": {
            "endpoint": "glocation"
        },
        "type": "EBIProteinsCoordinatesTool",
        "test_examples": [
            {
                "taxonomy": "9606",
                "location": "17:7676154"
            },
            {
                "taxonomy": "9606",
                "chromosome": "17",
                "position": 7676154
            }
        ],
        "return_schema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "taxonomy": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "proteins": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accession": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "entry_type": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "taxid": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "ensembl_gene_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ensembl_transcript_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ensembl_translation_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "protein_start": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "protein_end": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "amino_acids": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "chromosome": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "gene_start": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "gene_end": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "reverse_strand": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "assembly_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "total_proteins": {
                  "type": [
                    "integer",
                    "number"
                  ]
                }
              },
              "required": [
                "taxonomy"
              ]
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
    }
]
