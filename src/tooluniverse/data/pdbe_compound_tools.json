[
  {
    "name": "PDBe_get_compound_summary",
    "description": "Get detailed chemical compound information from PDBe by PDB chemical component ID. Returns complete SMILES, systematic names, and all cross-references without the former 15-reference cutoff, with explicit counts, plus formula, weight, charge, type, InChI, and first observation. Useful for protein-ligand and chemical-evidence analysis.",
    "parameter": {
      "type": "object",
      "properties": {
        "comp_id": {
          "type": "string",
          "description": "PDB chemical component ID (3-letter code). Examples: 'ATP', 'HEM' (heme), 'NAG' (N-acetylglucosamine), 'CFF' (caffeine), 'GOL' (glycerol), 'ZN' (zinc ion), 'FAD', 'NAD'. Case-insensitive."
        }
      },
      "required": [
        "comp_id"
      ]
    },
    "fields": {
      "endpoint": "get_summary"
    },
    "type": "PDBECompoundTool",
    "test_examples": [
      {
        "comp_id": "ATP"
      },
      {
        "comp_id": "HEM"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comp_id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "Chemical compound name"
            },
            "formula": {
              "type": "string",
              "description": "Molecular formula"
            },
            "weight": {
              "type": "number",
              "description": "Molecular weight in Daltons"
            },
            "formal_charge": {
              "type": ["integer", "null"],
              "description": "Net formal charge of the compound. Null when PDBe records none: ATP and NAG return 0, HEM returns null."
            },
            "compound_type": {
              "type": "string",
              "description": "Type (NON-POLYMER, D-saccharide, etc.)"
            },
            "inchi": {
              "type": [
                "string",
                "null"
              ],
              "description": "InChI identifier"
            },
            "inchi_key": {
              "type": [
                "string",
                "null"
              ],
              "description": "InChI key for database lookup"
            },
            "smiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "program": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              },
              "description": "SMILES representations"
            },
            "smiles_count": {
              "type": "integer"
            },
            "systematic_names": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "program": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "systematic_name_count": {
              "type": "integer"
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string"
                  },
                  "resource_id": {
                    "type": "string"
                  }
                }
              },
              "description": "Links to PubChem, DrugBank, EPA, ClinicalTrials, etc."
            },
            "cross_reference_count": {
              "type": "integer"
            },
            "first_observed_in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "release_status": {
              "type": "string"
            },
            "creation_date": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBe_get_compound_structures",
    "description": "Get every PDB structure containing a chemical compound through explicit limit/offset pages from PDBe's official compound/in_pdb endpoint. Returns exact total, next_offset, PDB IDs, and occurrence qualifiers (ligand type, total copies, distinct copies). Follow next_offset while has_more is true; ATP and NAG occur in thousands of structures.",
    "parameter": {
      "type": "object",
      "properties": {
        "comp_id": {
          "type": "string",
          "description": "PDB chemical component ID (3-letter code). Examples: 'ATP', 'HEM', 'NAG', 'FAD', 'NAD', 'ZN', 'GOL'. Case-insensitive."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100,
          "description": "Maximum structure-occurrence records to return"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based structure offset; continue with next_offset"
        }
      },
      "required": [
        "comp_id"
      ]
    },
    "fields": {
      "endpoint": "get_structures"
    },
    "type": "PDBECompoundTool",
    "test_examples": [
      {
        "comp_id": "CFF"
      },
      {
        "comp_id": "NAG"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "comp_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "formula": {
              "type": "string"
            },
            "weight": {
              "type": "number"
            },
            "first_observed_in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pdb_entries": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "PDB entry IDs containing this compound"
            },
            "occurrences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  },
                  "ligand_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ligand_total_number": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "ligand_distinct_number": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_structures": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
