  {
    "name": "odphp_outlink_fetch",
    "description": "Retrieve readable content from 1-3 ODPHP or related absolute URLs. HTML is cleaned, JSON is serialized instead of silently returned as empty text, and plain text is preserved. max_chars truncation is explicit per result via original_text_chars/text_truncated. More than 3 URLs or invalid controls are rejected before any network request; per-URL HTTP failures are surfaced in both the item and aggregate completeness metadata.",
    "type": "ODPHPOutlinkFetch",
    "parameter": {
      "type": "object",
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "1\u20133 absolute URLs from AccessibleVersion or RelatedItems.Url"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Optional hard cap on extracted text length (e.g., 5000)"
        },
        "return_html": {
          "type": "boolean",
          "default": false,
          "description": "If true, also return original HTML for HTML responses"
        }
      },
      "required": [
        "urls"
      ]
    },
    "fields": {
      "endpoint": "/outlink",
      "return_format": "JSON"
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "status": {
                "type": [
                  "integer",
                  "number"
                ]
              },
              "content_type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "original_text_chars": {
                "type": "integer"
              },
              "text_truncated": {
                "type": "boolean"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "requested_urls": {
              "type": "integer"
            },
            "processed_urls": {
              "type": "integer"
            },
            "failed_urls": {
              "type": "integer"
            },
            "requested_scope_complete": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "urls": [
          "https://odphp.health.gov/myhealthfinder/api/v4/topicsearch.json?TopicId=30606"
        ],
        "max_chars": 2000,
        "return_html": false
      },
      {
        "urls": [
          "https://odphp.health.gov/myhealthfinder/api/v4/topicsearch.json?TopicId=30606"
        ],
        "max_chars": 5000,
        "return_html": false
      }
    ]
  }
