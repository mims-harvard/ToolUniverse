  {
    "name": "odphp_topicsearch",
    "description": "Search ODPHP MyHealthfinder v4 topics by topic ID or keyword, or omit both to retrieve all topics. categoryId is retained for compatibility, but an upstream-ignored value now produces an explicit parameter-mismatch error. Exact total/count completeness and HTTP-200 application errors are exposed. Use odphp_outlink_fetch for linked content.",
    "type": "ODPHPTopicSearch",
    "parameter": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string",
          "enum": ["en", "es"],
          "default": "en",
          "description": "Language code (en or es)"
        },
        "topicId": {
          "type": "string",
          "description": "Comma-separated topic IDs"
        },
        "categoryId": {
          "type": "string",
          "description": "Comma-separated category IDs"
        },
        "keyword": {
          "type": "string",
          "description": "Keyword search for topics"
        },
        "strip_html": {
          "type": "boolean",
          "default": false,
          "description": "If true, also return PlainSections[] with HTML removed for each topic"
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "/topicsearch.json",
      "return_format": "JSON"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Error": {
              "type": "string"
            },
            "Total": {
              "type": [
                "integer",
                "number"
              ]
            },
            "Query": {
              "type": "object",
              "properties": {
                "ApiVersion": {
                  "type": "string"
                },
                "ApiType": {
                  "type": "string"
                },
                "TopicId": {
                  "type": "string"
                },
                "CategoryId": {
                  "type": "null"
                },
                "Keyword": {
                  "type": "string"
                },
                "Age": {
                  "type": "null"
                },
                "Sex": {
                  "type": "null"
                },
                "Pregnant": {
                  "type": "null"
                },
                "Lang": {
                  "type": "string"
                },
                "Type": {
                  "type": "null"
                },
                "ReturnType": {
                  "type": "string"
                },
                "Callback": {
                  "type": "null"
                },
                "APiType": {
                  "type": "string"
                }
              }
            },
            "Language": {
              "type": "string"
            }
          },
          "required": [
            "Error"
          ]
        },
        {
          "type": "object",
          "properties": {
