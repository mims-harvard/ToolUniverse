[
  {
    "name": "odphp_myhealthfinder",
    "description": "Retrieve personalized preventive-care recommendations from the ODPHP MyHealthfinder v4 API. The response reports the upstream total, returned record count, and exact completeness. HTTP-200 application errors and silently changed query values are explicit. Use odphp_outlink_fetch for AccessibleVersion links.",
    "type": "ODPHPMyHealthfinder",
    "parameter": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string",
          "enum": ["en", "es"],
          "default": "en",
          "description": "Language code (en or es)"
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "Age in years (0\u2013120)"
        },
        "sex": {
          "type": "string",
          "enum": ["Male", "Female", "male", "female"],
          "description": "Male or Female"
        },
        "pregnant": {
          "type": "string",
          "enum": ["Yes", "No", "yes", "no"],
          "description": "\"Yes\" or \"No\""
        },
        "strip_html": {
          "type": "boolean",
          "default": false,
          "description": "If true, also return PlainSections[] with HTML removed for each topic"
        }
      },
      "required": [
        "age",
        "sex"
      ]
    },
    "fields": {
