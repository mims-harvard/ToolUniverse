[
  {
    "name": "HGNC_fetch_gene_by_symbol",
    "description": "Fetch the complete authoritative HGNC gene record by official symbol. The wrapper requires one unique upstream document and verifies its returned symbol case-insensitively before success. Returns all source fields, including HGNC ID, approved name/status, chromosome, prior and alias names, gene groups, and Ensembl/Entrez/UniProt/OMIM/RefSeq cross-references.",
    "parameter": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "description": "Official HGNC gene symbol. Examples: 'TP53', 'BRCA1', 'EGFR', 'INS', 'ACE2'."
        }
      },
      "required": [
        "symbol"
      ]
    },
    "fields": {
      "endpoint": "fetch",
      "search_field": "symbol"
    },
    "type": "HGNCTool",
    "test_examples": [
      {
        "symbol": "TP53"
      },
      {
        "symbol": "BRCA1"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hgnc_id": {
              "type": "string",
              "description": "HGNC identifier (e.g., HGNC:11998)"
            },
            "symbol": {
              "type": "string",
              "description": "Approved gene symbol"
            },
            "name": {
              "type": "string",
              "description": "Approved gene name"
            },
            "locus_type": {
              "type": "string",
              "description": "Type of locus (e.g., gene with protein product)"
            },
            "locus_group": {
              "type": "string",
              "description": "Locus group classification"
            },
            "status": {
              "type": "string",
              "description": "Symbol status (Approved, etc.)"
            },
            "location": {
              "type": [
                "string",
                "null"
              ],
              "description": "Chromosomal location"
            },
            "entrez_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "NCBI Entrez Gene ID"
            },
            "ensembl_gene_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Ensembl Gene ID"
            },
            "uniprot_ids": {
              "type": [
                "array",
                "null"
              ],
              "description": "UniProt accession(s)"
            },
            "refseq_accession": {
              "type": [
                "array",
                "null"
              ],
              "description": "RefSeq accession(s)"
            },
            "omim_id": {
              "type": [
                "array",
                "null"
              ],
              "description": "OMIM ID(s)"
            },
            "ccds_id": {
              "type": [
                "array",
                "null"
              ],
              "description": "CCDS ID(s)"
            },
            "prev_symbol": {
              "type": [
                "array",
                "null"
              ],
              "description": "Previous gene symbols"
            },
            "prev_name": {
              "type": [
                "array",
                "null"
              ],
              "description": "Previous gene names"
            },
            "alias_symbol": {
              "type": [
                "array",
                "null"
              ],
              "description": "Alias symbols"
            },
            "gene_group": {
              "type": [
                "array",
                "null"
              ],
              "description": "Gene group memberships"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HGNC_fetch_gene_by_id",
    "description": "Fetch the complete HGNC gene record by numeric HGNC ID, with or without an HGNC: prefix. Prefix case is normalized, the ID must be numeric, and the returned identifier is verified before success. Example: HGNC:11998 returns TP53.",
    "parameter": {
      "type": "object",
      "properties": {
        "hgnc_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[Hh][Gg][Nn][Cc]:)?[0-9]+$",
          "description": "HGNC identifier, with or without 'HGNC:' prefix. Examples: 'HGNC:11998' (TP53), 'HGNC:1100' (BRCA1), '1101' (BRCA2)."
        }
      },
      "required": [
        "hgnc_id"
      ]
    },
    "fields": {
      "endpoint": "fetch",
      "search_field": "hgnc_id"
    },
    "type": "HGNCTool",
    "test_examples": [
      {
        "hgnc_id": "HGNC:11998"
      },
      {
        "hgnc_id": "HGNC:1100"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hgnc_id": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "locus_type": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "entrez_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "ensembl_gene_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "uniprot_ids": {
              "type": [
                "array",
                "null"
              ]
            },
            "refseq_accession": {
              "type": [
                "array",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HGNC_search_genes",
    "description": "Search HGNC by symbol, name, alias, previous symbol, external ID, or location. Wildcards are supported. The HGNC REST search endpoint returns its entire result set and ignores Solr-style rows/start controls (verified live: name=kinase returned 812/812); ToolUniverse therefore exposes no fake pagination and verifies len(docs)==numFound before reporting result_set_complete=true.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search query - gene symbol, partial name, or keyword. Supports wildcards (*). Examples: 'BRCA*', 'tumor protein', 'insulin receptor'."
        },
        "search_field": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "symbol",
            "name",
            "alias_symbol",
            "prev_symbol",
            "entrez_id",
            "ensembl_gene_id",
            "uniprot_ids",
            "location",
            null
          ],
          "description": "Field to search in. Options: 'symbol', 'name', 'alias_symbol', 'prev_symbol', 'entrez_id', 'ensembl_gene_id', 'uniprot_ids', 'location'. Default searches across symbol and name."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search",
      "search_field": null
    },
    "type": "HGNCTool",
    "test_examples": [
      {
        "query": "BRCA*"
      },
      {
        "query": "tumor protein",
        "search_field": "name"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hgnc_id": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HGNC_search_by_location",
    "description": "Search HGNC for every gene mapped to a cytogenetic band. The upstream endpoint is unpaginated; the wrapper verifies returned count against numFound before marking the result set complete. Example: 17p13.1 includes TP53.",
    "parameter": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "Cytogenetic band location. Examples: '17p13.1' (TP53 region), '17q21.31' (BRCA1 region), '7p11.2' (EGFR region), '13q14.2' (RB1 region)."
        }
      },
      "required": [
        "location"
      ]
    },
    "fields": {
      "endpoint": "search",
      "search_field": "location"
    },
    "type": "HGNCTool",
    "test_examples": [
      {
        "location": "17p13.1"
      },
      {
        "location": "17q21.31"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hgnc_id": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "locus_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HGNC_fetch_gene_family_members",
    "description": "Enumerate ALL member genes of an HGNC gene family/group by its numeric gene_group_id, returning the full HGNC record for every member gene. Unlike HGNC_fetch_gene_by_symbol/by_id (single gene) this lists the entire family. Each member record includes hgnc_id, approved symbol, full name, chromosomal location, locus type, and cross-references (Ensembl, Entrez, UniProt, OMIM, RefSeq). Example: gene_group_id '366' returns the 56 members of the 'Ubiquitin specific peptidases' family (USP1-USP54, USPL1, CYLD, PAN2). Find a gene_group_id from the 'gene_group_id' field of any gene record returned by HGNC_fetch_gene_by_symbol.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_group_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[1-9][0-9]*$"},
            {"type": "integer", "minimum": 1}
          ],
          "description": "Numeric HGNC gene group/family ID. Examples: '366' (Ubiquitin specific peptidases), '588' (BCL2 family), '475' (Solute carrier family). Accepts a string or integer."
        }
      },
      "required": [
        "gene_group_id"
      ]
    },
    "fields": {
      "endpoint": "fetch",
      "search_field": "gene_group_id"
    },
    "type": "HGNCTool",
    "test_examples": [
      {
        "gene_group_id": "366"
      },
      {
        "gene_group_id": "588"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "Full HGNC record for every member gene of the family",
          "items": {
            "type": "object",
            "properties": {
              "hgnc_id": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "locus_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_group": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "gene_group_id": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "ensembl_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entrez_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uniprot_ids": {
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
