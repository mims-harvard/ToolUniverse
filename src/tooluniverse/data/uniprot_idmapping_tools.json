[
  {
    "name": "UniProtIDMap_convert_ids",
    "description": "Convert identifiers with UniProt ID Mapping. All upstream result pages are fetched, then exposed through recoverable local limit/offset pagination. result_count is the full mapping count; follow next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "string",
          "description": "Comma-separated identifiers to convert. Examples: 'TP53,BRCA1,EGFR' (gene names), 'P04637,P38398' (UniProt ACs), 'ENSG00000141510' (Ensembl)."
        },
        "from_db": {
          "type": "string",
          "description": "Source database. Common values: 'Gene_Name', 'UniProtKB_AC-ID', 'Ensembl', 'Ensembl_Genomes', 'RefSeq_Protein', 'PDB', 'ChEMBL', 'GeneCards', 'HGNC'. See UniProt ID Mapping docs for full list."
        },
        "to_db": {
          "type": "string",
          "description": "Target database. Common values: 'UniProtKB', 'UniProtKB-Swiss-Prot', 'Gene_Name', 'Ensembl', 'RefSeq_Protein', 'PDB', 'ChEMBL', 'GeneCards'. Default: 'UniProtKB'.",
          "default": "UniProtKB"
        },
        "tax_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "NCBI Taxonomy ID to restrict results. Examples: 9606 (human), 10090 (mouse), 10116 (rat). Optional but recommended for gene names."
        },
        "limit": {
          "type": "integer", "minimum": 1, "maximum": 5000, "default": 500,
          "description": "Maximum mappings to return in this local page."
        },
        "offset": {
          "type": "integer", "minimum": 0, "default": 0,
          "description": "Zero-based mapping offset; continue with next_offset."
        }
      },
      "required": [
        "ids",
        "from_db"
      ]
    },
    "fields": {
      "endpoint_type": "convert"
    },
    "type": "UniProtIDMappingTool",
    "test_examples": [
      {
        "ids": "TP53,BRCA1,EGFR",
        "from_db": "Gene_Name",
        "to_db": "UniProtKB",
        "tax_id": 9606
      },
      {
        "ids": "P04637",
        "from_db": "UniProtKB_AC-ID",
        "to_db": "PDB"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from_db": {
              "type": "string"
            },
            "to_db": {
              "type": "string"
            },
            "result_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {"type": "integer"},
            "limit": {"type": "integer"},
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean",
              "description": "True when this local page is only part of the full result set."
            },
            "failed_ids": {
              "type": "array"
            }
          },
          "required": [
            "from_db"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
