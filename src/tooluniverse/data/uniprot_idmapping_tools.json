          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtIDMap_gene_to_uniprot",
    "description": "Convert gene symbols to UniProt accessions for a taxonomy. All upstream pages are fetched and exposed through local limit/offset pagination; follow next_offset while has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_names": {
          "type": "string",
          "description": "Comma-separated gene symbols. Examples: 'TP53', 'BRCA1,TP53,EGFR,KRAS', 'INS,GCG'."
        },
        "tax_id": {
          "type": "integer",
          "description": "NCBI Taxonomy ID. Required. 9606 = human, 10090 = mouse, 10116 = rat, 7227 = fruit fly, 6239 = C. elegans.",
          "default": 9606
        },
        "reviewed_only": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "If true, return only Swiss-Prot (reviewed) entries. Default: false (all UniProtKB entries)."
        },
        "limit": {
          "type": "integer", "minimum": 1, "maximum": 5000, "default": 500,
          "description": "Maximum mappings to return in this local page."
        },
        "offset": {
          "type": "integer", "minimum": 0, "default": 0,
          "description": "Zero-based mapping offset; continue with next_offset."
        }
      },
      "required": [
        "gene_names"
      ]
    },
    "fields": {
      "endpoint_type": "gene_to_uniprot"
    },
    "type": "UniProtIDMappingTool",
    "test_examples": [
      {
        "gene_names": "TP53,BRCA1,EGFR",
        "tax_id": 9606
      },
      {
        "gene_names": "INS",
        "tax_id": 9606,
        "reviewed_only": true
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene_names": {
              "type": "string"
            },
            "species_taxid": {
              "type": [
                "integer",
                "number"
              ]
            },
            "result_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {"type": "integer"},
            "limit": {"type": "integer"},
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean",
              "description": "True when this local page is only part of the full result set."
            }
          },
          "required": [
            "gene_names"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniProtIDMap_list_databases",
    "description": "List all available database identifiers supported by the UniProt ID Mapping service. Returns grouped databases with their display names and whether they can be used as source or target in ID conversion. Use this to discover what databases are available for cross-referencing. Over 100 databases are supported including sequence databases, 3D structure databases, genome annotation databases, organism-specific databases, and more.",
    "parameter": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "fields": {
      "endpoint_type": "list_databases"
    },
    "type": "UniProtIDMappingTool",
    "test_examples": [
      {}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "group_name": {
                    "type": "string"
                  },
                  "databases": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "display_name": {
                          "type": "string"
                        },
                        "from_supported": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": [
            "group_count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
