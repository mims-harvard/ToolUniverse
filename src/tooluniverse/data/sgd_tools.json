  {
    "name": "SGD_search",
    "description": "Search SGD across genes, GO terms, phenotypes, references, alleles, diseases, complexes, pathways, and other indexed categories. The query is applied through SGD's q parameter. Returns complete descriptions with description_length and explicit offset pagination; while has_more is true, use next_offset in the next call.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query string. Examples: 'GAL4', 'cell cycle', 'sporulation'."
        },
        "category": {
          "type": "string",
          "description": "Filter by category. Options: 'locus', 'reference', 'biological_process', 'molecular_function', 'cellular_component', 'phenotype', 'disease', 'allele', 'complex', 'pathway', 'chemical', 'strain', 'download'."
        },
        "limit": {
          "type": "integer",
          "description": "Number of results per page (default 10, max 50).",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based pagination offset; use next_offset for the following page.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search"
    },
    "type": "SGDTool",
    "test_examples": [
      {
        "query": "GAL4",
        "category": "locus",
        "limit": 5
      },
      {
        "query": "cell cycle",
        "category": "biological_process",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Complete upstream description without wrapper truncation"
              },
              "description_length": {
                "type": "integer"
              },
              "href": {
                "type": "string"
              },
              "aliases": {
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SGD_get_regulation",
    "description": "Get and page through the transcriptional regulation network for a yeast gene from SGD. Returns true total/continuation metadata plus regulator-target identifiers, evidence, direction, biological context, and references; dense networks do not silently stop at 100.",
    "parameter": {
      "type": "object",
      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000000364' (CDC28), 'S000000259' (GAL4)."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum regulation records to return."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based regulation-record offset."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "locus",
      "query_mode": "regulation"
    },
    "type": "SGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "sgd_id": "S000000364"
      },
      {
        "sgd_id": "S000000259"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regulator": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Regulator gene name"
              },
              "regulator_sgdid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Target gene name"
              },
              "target_sgdid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "regulation_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "What is regulated (e.g., transcription)"
              },
              "direction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "happens_during": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pubmed_id": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SGD_get_sequence",
    "description": "Get genomic, coding, and protein sequences plus genomic coordinates for a yeast gene from SGD (reference strain S288C). Returns the genomic DNA start/end/strand and full residue strings for genomic_dna, coding_dna, and protein. Example: S000000364 (CDC28) returns genomic_dna start=560078 end=560974 with residues 'ATGAGCGGTGAATTAGCAAAT...'.",
    "parameter": {
      "type": "object",
      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000000364' (CDC28), 'S000005564' (ACT1)."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "locus",
      "query_mode": "sequence"
    },
    "type": "SGDTool",
    "timeout": 30,
    "test_examples": [
      {
        "sgd_id": "S000000364"
      },
      {
        "sgd_id": "S000005564"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sgd_id": {
              "type": "string"
            },
            "genomic_dna": {
              "type": "object",
              "properties": {
                "start": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "strand": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "length": {
                  "type": "integer"
                },
                "residues": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "coding_dna": {
              "type": "object",
              "properties": {
                "length": {
                  "type": "integer"
                },
                "residues": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "protein": {
              "type": "object",
              "properties": {
                "length": {
                  "type": "integer"
                },
                "residues": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
