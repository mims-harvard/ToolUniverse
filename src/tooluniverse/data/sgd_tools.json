      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000003219' (RMR1), 'S000005564' (ACT1), 'S000000259' (GAL4)."
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum GO annotations to return."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based GO annotation offset."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
