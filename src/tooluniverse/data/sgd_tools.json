[
  {
    "name": "SGD_get_gene",
    "description": "Get a yeast gene/locus overview from SGD. Returns gene identifiers, descriptions, qualities, and explicitly pageable aliases with the true alias total and next offset; broad cross-resource alias lists are not silently stopped at 10.",
    "parameter": {
      "type": "object",
      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000000259' (GAL4), 'S000003219' (RMR1), 'S000005564' (ACT1)."
        },
        "alias_limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum aliases to return on this page."
        },
        "alias_offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into all locus aliases."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "locus",
      "query_mode": "overview"
    },
    "type": "SGDTool",
    "test_examples": [
      {
        "sgd_id": "S000000259"
      },
      {
        "sgd_id": "S000003219"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sgd_id": {
              "type": "string",
              "description": "SGD identifier"
            },
            "display_name": {
              "type": "string",
              "description": "Gene name (e.g., GAL4)"
            },
            "gene_name": {
              "type": "string"
            },
            "systematic_name": {
              "type": "string",
              "description": "Systematic ORF name (e.g., YPL248C)"
            },
            "locus_type": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "description": "Curated functional description"
            },
            "uniprot_id": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "name_description": {
              "type": [
                "string",
                "null"
              ]
            },
            "alias_details": {
              "type": "array"
            },
            "qualities": {
              "type": "object"
            },
            "resource_links": {
              "type": "array"
            },
            "paralogs": {
              "type": "array"
            },
            "alleles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "references_count": {
              "type": [
                "string",
                "null"
              ]
            },
            "go_slim": {
              "type": "array",
              "description": "The gene's GO Slim terms. Both fields of this row used to carry the wrong thing: `go_id` held SGD's internal numeric id and `term` held the name of the slim SET ('Yeast GO-Slim'), so every row read the same. The term is the annotation and the GO accession comes out of the link.",
              "items": {
                "type": "object",
                "properties": {
                  "term": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The GO term, e.g. 'U4/U6 x U5 tri-snRNP complex'"
                  },
                  "go_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The GO accession, e.g. GO:0046540"
                  },
                  "slim_set": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Which slim set the term belongs to, e.g. 'Yeast GO-Slim'"
                  },
                  "sgd_internal_id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "link": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "phenotype_experiment_categories": {
              "type": "array"
            },
            "protein_overview": {
              "type": "object"
            },
            "feature_type": {
              "type": "object"
            },
            "id": {
              "type": "object"
            },
            "citation": {
              "type": [
                "string",
                "null"
              ]
            },
            "pubmed_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "link": {
              "type": [
                "string",
                "null"
              ]
            },
            "year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "journal": {
              "type": "object"
            },
            "authors": {
              "type": "array"
            },
            "urls": {
              "type": "array"
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "allele_records": {
              "type": "array",
              "description": "The same alleles as `alleles`, with the SGD id out of the link so one can be looked up",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sgd_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "link": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "phenotype_summary": {
              "type": "object",
              "description": "The phenotypes themselves. `phenotype_experiment_categories` counts assay kinds; 'toxin resistance: increased' is the phenotype, and SGD buckets the large-scale ones by mutant type (null, repressible, reduction of function, conditional), which says whether a phenotype follows from losing the gene or from over-expressing it.",
              "properties": {
                "paragraph": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "classical_phenotypes": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "classical_phenotype_count": {
                  "type": "integer"
                },
                "classical_phenotypes_truncated": {
                  "type": "boolean"
                },
                "large_scale_phenotypes": {
                  "type": "object",
                  "description": "Keyed by mutant type; each holds up to 25 phenotypes, the full count and whether it was cut"
                },
                "strains": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SGD_get_phenotypes",
    "description": "Get and page through curated phenotype annotations for a yeast gene from SGD. Returns the true total, returned count, and next offset plus observable phenotype, mutant, experiment, strain, allele, chemical, and reference fields.",
    "parameter": {
      "type": "object",
      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000003219' (RMR1), 'S000000259' (GAL4), 'S000005564' (ACT1)."
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum phenotype annotations to return."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based phenotype annotation offset."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "locus",
      "query_mode": "phenotype"
    },
    "type": "SGDTool",
    "test_examples": [
      {
        "sgd_id": "S000003219"
      },
      {
        "sgd_id": "S000000259"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phenotype": {
                "type": "string",
                "description": "Phenotype name with qualifier (e.g., 'competitive fitness: decreased')"
              },
              "mutant_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "experiment_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "strain_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "allele": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chemical": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qualifier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "experiment_category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference_pubmed_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "experiment_properties": {
                "type": "array",
                "description": "The experiment's own properties (condition, reporter, allele and chemical details) as SGD records them.",
                "items": {
                  "type": "object",
                  "properties": {
                    "class_type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "What kind of property this is, e.g. BIOITEM, CHEMICAL, CONDITION."
                    },
                    "role": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The part it played in the experiment, e.g. Allele, Chemical pending, Media, Temperature."
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Name of the allele, chemical or condition."
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Its value where the property is quantified."
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Unit of value."
                    }
                  }
                }
              },
              "details": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference_citation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The curator's note on this annotation: the measurement or observation behind the qualitative call, e.g. 'Relative growth score: 0.0044' under haploproficient or 'large budded cells with nuclei situated at the mother-bud neck'."
              },
              "experiment_note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The note attached to the experiment rather than to the annotation, where SGD records one."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "SGD_get_go_annotations",
