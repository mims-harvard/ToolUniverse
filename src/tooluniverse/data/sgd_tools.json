  {
    "name": "SGD_get_interactions",
    "description": "Get and page through genetic and physical interactions for a yeast gene from SGD. Returns true total/continuation metadata plus interaction and experiment types, partner identifiers, annotation source, and reference; large networks do not silently stop at 50.",
    "parameter": {
      "type": "object",
      "properties": {
        "sgd_id": {
          "type": "string",
          "description": "SGD locus identifier. Examples: 'S000003219' (RMR1), 'S000005564' (ACT1), 'S000000259' (GAL4)."
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum interactions to return."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based interaction offset."
        }
      },
      "required": [
        "sgd_id"
      ]
    },
    "fields": {
      "endpoint_type": "locus",
      "query_mode": "interaction"
    },
    "type": "SGDTool",
    "test_examples": [
      {
        "sgd_id": "S000003219"
      },
      {
        "sgd_id": "S000005564"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "interaction_type": {
                "type": "string",
                "description": "Physical or Genetic"
              },
              "experiment_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Experimental method (Two-hybrid, Affinity Capture-MS, Synthetic Lethality, etc.)"
              },
              "bait_gene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hit_gene": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
