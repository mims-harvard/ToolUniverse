[
  {
    "name": "MarineRegions_search_by_name",
    "description": "Search the Marine Regions Gazetteer (VLIZ) for ocean/sea geographic features by name. Returns at most 100 records per call. Continue with metadata.next_offset while metadata.has_more is true; the wrapper performs a one-record lookahead on full pages because the API does not return a total count. like, fuzzy, and offset are sent as official query parameters.",
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the marine geographic feature. Examples: 'North Sea', 'Pacific Ocean', 'Mediterranean Sea', 'Caribbean Sea', 'Arctic Ocean', 'Coral Sea', 'Gulf of Mexico'"
        },
        "like": {
          "type": [
            "boolean",
            "null"
          ],
          "default": true,
          "description": "If true, perform a partial name match (SQL LIKE). Default: true"
        },
        "fuzzy": {
          "type": [
            "boolean",
            "null"
          ],
          "default": false,
          "description": "If true, perform Levenshtein fuzzy matching. Default: false"
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Zero-based record offset. Start at 0 and continue with metadata.next_offset.",
          "default": 0
        }
      },
      "required": [
        "name"
      ]
    },
    "fields": {
      "endpoint": "https://www.marineregions.org/rest/getGazetteerRecordsByName.json/{name}/",
      "params": {
        "count": 100
      },
      "pagination": "marine_regions_offset"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "name": "North Sea",
        "offset": 0
      },
      {
        "name": "Mediterranean Sea",
        "offset": 0
      },
      {
        "name": "Gulf of Mexico",
        "offset": 0
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of matching marine geographic features",
          "items": {
            "type": "object",
            "properties": {
              "MRGID": {
                "type": "integer",
                "description": "Marine Regions Gazetteer ID (unique identifier)"
              },
              "gazetteerSource": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Source database"
              },
              "placeType": {
                "type": "string",
                "description": "Feature type (e.g., IHO Sea Area, Large Marine Ecosystem, ICES Ecoregion, EEZ)"
              },
              "latitude": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Centroid latitude"
              },
              "longitude": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Centroid longitude"
              },
              "preferredGazetteerName": {
                "type": "string",
                "description": "Official standardized name"
              },
              "preferredGazetteerNameLang": {
                "type": "string",
                "description": "Language of the name"
              },
              "status": {
                "type": "string",
                "description": "Status: standard, synonym, or deleted"
              },
              "accepted": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "MRGID of accepted (canonical) record"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "MarineRegions_get_record",
    "description": "Get detailed information about a specific marine geographic feature by its MRGID (Marine Regions Gazetteer ID) from VLIZ. Returns full metadata including bounding box, coordinates, place type, status, and source. No authentication required. Common MRGIDs: 2350 (North Sea), 1901 (Pacific Ocean), 1902 (Atlantic Ocean), 4319 (Mediterranean Sea), 8466 (Indian Ocean), 1903 (Arctic Ocean), 1904 (Southern Ocean).",
    "parameter": {
      "type": "object",
      "properties": {
        "mrgid": {
          "type": "integer",
          "description": "Marine Regions Gazetteer ID. Examples: 2350 (North Sea), 1901 (Pacific Ocean), 1902 (Atlantic Ocean), 4319 (Mediterranean Sea), 8466 (Indian Ocean)"
        }
      },
      "required": [
        "mrgid"
      ]
    },
    "fields": {
      "endpoint": "https://marineregions.org/mrgid/{mrgid}.json",
      "params": {}
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "mrgid": 2350
      },
      {
        "mrgid": 1902
      },
      {
        "mrgid": 4319
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Marine geographic feature details",
          "properties": {
            "MRGID": {
              "type": "integer"
            },
            "gazetteerSource": {
              "type": [
                "string",
                "null"
              ]
            },
            "placeType": {
              "type": "string"
            },
            "latitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "minLatitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxLatitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "minLongitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxLongitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "preferredGazetteerName": {
              "type": "string"
            },
            "preferredGazetteerNameLang": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "accepted": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
