[
  {
    "name": "Ensembl_get_assembly_info",
    "description": "Get genome assembly metadata for a species from the Ensembl REST API. Returns assembly name, accession, version history, the complete chromosome karyotype with sizes, genebuild date, golden path length, and available coordinate system versions. Chromosomes are recognized from both Ensembl's coord_system and karyotype fields, including assemblies whose regions are labeled primary_assembly. Essential for interpreting genomic coordinates and understanding assembly composition.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Ensembl species name (lowercase with underscores). Examples: 'homo_sapiens' (human), 'mus_musculus' (mouse), 'danio_rerio' (zebrafish), 'drosophila_melanogaster' (fruit fly), 'saccharomyces_cerevisiae' (yeast)."
        }
      },
      "required": [
        "species"
      ]
    },
    "fields": {
      "endpoint": "assembly"
    },
    "type": "EnsemblInfoTool",
    "test_examples": [
      {
        "species": "homo_sapiens"
      },
      {
        "species": "mus_musculus"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "species": {
              "type": "string",
              "description": "Species name queried"
            },
            "assembly_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Assembly name (e.g., GRCh38.p14)"
            },
            "assembly_accession": {
              "type": [
                "string",
                "null"
              ],
              "description": "GenBank/RefSeq assembly accession (e.g., GCA_000001405.29)"
            },
            "assembly_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "Assembly release date"
            },
            "genebuild_method": {
              "type": [
                "string",
                "null"
              ],
              "description": "Method used for gene annotation"
            },
            "genebuild_last_update": {
              "type": [
                "string",
                "null"
              ],
              "description": "Date of last genebuild update"
            },
            "golden_path_length": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total genome length in base pairs"
            },
            "karyotype": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ordered list of chromosome names"
            },
            "coordinate_system_versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Available coordinate system versions (e.g., GRCh38, GRCh37)"
            },
            "total_regions": {
              "type": "integer",
              "description": "Total number of top-level regions"
            },
            "total_chromosomes": {
              "type": "integer",
              "description": "Number of chromosome records returned without truncation"
            },
            "chromosomes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Chromosome name"
                  },
                  "length": {
                    "type": "integer",
                    "description": "Chromosome length in bp"
                  },
                  "coord_system": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl's coordinate system for the region. The chromosome filter reads this, and a region admitted through the karyotype branch instead can carry something else"
                  }
                }
              },
              "description": "Complete chromosome list with lengths"
            },
            "other_regions": {
              "type": "array",
              "description": "Scaffolds and other non-chromosomal top-level regions, longest first. GRCh38's 194 regions are 25 chromosomes and 169 scaffolds, and no tool in this family returned the 169",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Region name, e.g. KI270728.1"
                  },
                  "length": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Length in bases"
                  },
                  "coord_system": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "e.g. scaffold"
                  }
                }
              }
            },
            "other_regions_returned": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many are in other_regions"
            },
            "total_other_regions": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many the assembly has"
            },
            "other_regions_truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when OTHER_REGIONS_PER_ASSEMBLY applied"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Ensembl_get_species_info",
    "description": "Search and page through species available in the Ensembl database with their genome assembly information. Returns true total and filtered-match counts plus explicit pagination metadata, so broad queries do not silently stop at the first 50 species. Supports filtering by species name, common name, or taxonomy ID.",
    "parameter": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string",
          "description": "Search term to filter species. Can be a species name ('mus_musculus'), common name ('mouse'), display name ('Mouse'), or taxonomy ID ('10090'). Leave empty to list all 348+ species."
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum matched species to return on this page."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based offset into the filtered species list."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "species"
    },
    "type": "EnsemblInfoTool",
    "test_examples": [
      {
        "search": "mouse"
      },
      {
        "search": "9606"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_species": {
              "type": "integer",
              "description": "Total species in Ensembl"
            },
            "matched_species": {
              "type": "integer",
              "description": "True number of species matching the search before pagination"
            },
            "returned_species": {
              "type": "integer",
              "description": "Number of species returned on this page"
            },
            "search_term": {
              "type": [
                "string",
                "null"
              ],
              "description": "Search term used (null if listing all)"
            },
            "species": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl species name (e.g., homo_sapiens)"
                  },
                  "display_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Display name (e.g., Human)"
                  },
                  "common_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Common name"
                  },
                  "taxon_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "NCBI taxonomy ID"
                  },
                  "assembly": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Current assembly name"
                  },
                  "accession": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Assembly accession"
                  },
                  "division": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl division (EnsemblVertebrates, EnsemblPlants, etc.)"
                  },
                  "strain": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Strain name if applicable"
                  },
                  "strain_collection": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Strain collection name"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Which Ensembl data sets exist for the species -- core, variation, funcgen, rnaseq, compara. The row said only which division the species is in, so 'can I get variation data for this species' had to be answered by trying it."
                  },
                  "release": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "The Ensembl release the entry is from, so an assembly can be pinned to a version"
                  }
                }
              },
              "description": "Matched species on the requested page"
            },
            "limit": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
