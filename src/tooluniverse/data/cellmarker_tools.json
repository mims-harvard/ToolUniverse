[
  {
    "name": "CellMarker_search_by_gene",
    "type": "CellMarkerTool",
    "description": "Search the CellMarker 2.0 database for cell types that express a given marker gene. Returns curated record-level annotations with limit/offset pagination and explicit total/has_more metadata. CellMarker 2.0 covers human and mouse cell types across many tissues. Example: CD3D marks T cells, CD68 marks macrophages, and EPCAM marks epithelial cells.",
    "category": "Genomics & Transcriptomics",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "description": "Gene symbol to search for (e.g., 'CD3D', 'CD68', 'EPCAM', 'MS4A1')"
        },
        "species": {
          "type": "string",
          "enum": [
            "Human",
            "Mouse"
          ],
          "description": "Species filter: 'Human' or 'Mouse'. If omitted, searches both species."
        },
        "tissue_type": {
          "type": "string",
          "description": "Filter results by tissue type (e.g., 'Blood', 'Lung', 'Brain'). Case-insensitive partial match."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 200,
          "description": "Maximum records to return. Default 200; total_records reports how many matched, so raise this or page with offset when it is larger.",
          "maximum": 1000
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": 0,
          "description": "Records to skip before returning, for paging through total_records. Use data.next_offset for the next page."
        }
      },
      "required": [
        "gene_symbol"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "total_records": {
          "type": "integer"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "species": {
                "type": "string"
              },
              "tissue_class": {
                "type": "string"
              },
              "tissue_type": {
                "type": "string"
              },
              "cell_type": {
                "type": "string"
              },
              "cell_name": {
                "type": "string"
              },
              "cell_marker": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "supports": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "search_by_gene",
        "gene_symbol": "CD3D",
        "species": "Human"
      },
      {
        "operation": "search_by_gene",
        "gene_symbol": "CD68",
        "species": "Human",
        "tissue_type": "Blood"
      }
    ],
    "fields": {
      "operation": "search_by_gene"
    }
  },
  {
    "name": "CellMarker_search_by_cell_type",
    "type": "CellMarkerTool",
    "description": "Search the CellMarker 2.0 database for marker genes of a cell-type phrase. Matching respects phrase boundaries, so 'T cell' includes qualified T-cell names but does not incorrectly match 'Fat cell' or 'Mast cell'. Marker summaries and curated records use limit/offset pagination with separate totals and has_more flags. Example: 'T cell' returns CD3D, CD3E, and CD3G; 'Macrophage' returns CD68 and CD163.",
    "category": "Genomics & Transcriptomics",
    "parameter": {
      "type": "object",
      "properties": {
        "cell_name": {
          "type": "string",
          "description": "Cell type name to search for (e.g., 'T cell', 'Macrophage', 'B cell', 'Fibroblast')"
        },
        "species": {
          "type": "string",
          "enum": [
            "Human",
            "Mouse"
          ],
          "description": "Species filter. If omitted, searches both species."
        },
        "tissue_type": {
          "type": "string",
          "description": "Filter results by tissue type (e.g., 'Blood', 'Lung', 'Brain'). Case-insensitive partial match."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 200,
          "description": "Maximum records to return. Default 200; total_records reports how many matched, so raise this or page with offset when it is larger.",
          "maximum": 1000
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": 0,
          "description": "Records to skip before returning, for paging through total_records. Use data.next_offset for the next page."
        }
      },
      "required": [
        "cell_name"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "cell_name": {
          "type": "string"
        },
        "species": {
          "type": "string"
        },
        "total_records": {
          "type": "integer"
        },
        "unique_markers": {
          "type": "integer"
        },
        "marker_genes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "species": {
                "type": "string"
              },
              "tissue_class": {
                "type": "string"
              },
              "tissue_type": {
                "type": "string"
              },
              "cell_type": {
                "type": "string"
              },
              "cell_name": {
                "type": "string"
              },
              "cell_marker": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "supports": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "search_by_cell_type",
        "cell_name": "Macrophage",
        "species": "Human"
      },
      {
        "operation": "search_by_cell_type",
        "cell_name": "T cell",
        "species": "Human",
        "tissue_type": "Blood"
      }
    ],
    "fields": {
      "operation": "search_by_cell_type"
    }
  },
  {
    "name": "CellMarker_list_cell_types",
    "type": "CellMarkerTool",
    "description": "List available cell types in the CellMarker 2.0 database for a given tissue and species. Returns all annotated cell types found in that tissue context. Use this to explore what cell types have been characterized in a specific tissue, or to get an overview of CellMarker's coverage. Supports both normal and cancer cell contexts.",
    "category": "Genomics & Transcriptomics",
    "parameter": {
      "type": "object",
      "properties": {
        "tissue_type": {
          "type": "string",
          "description": "Tissue type to list cell types for (e.g., 'Blood', 'Lung', 'Brain', 'Liver'). If omitted, returns a global list."
        },
        "species": {
          "type": "string",
          "enum": [
            "Human",
            "Mouse"
          ],
          "description": "Species to query (default: 'Human')"
        },
        "cell_class": {
          "type": "string",
          "enum": [
            "all",
            "cancer"
          ],
          "description": "Cell class filter: 'all' for normal+cancer (default), 'cancer' for cancer cells only"
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string"
        },
        "tissue_type": {
          "type": "string"
        },
        "total_cell_types": {
          "type": "integer"
        },
        "cell_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cell_name": {
                "type": "string"
              },
              "tissue_class": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "list_cell_types",
        "tissue_type": "Blood",
        "species": "Human"
      },
      {
        "operation": "list_cell_types",
        "tissue_type": "Lung",
        "species": "Human",
        "cell_class": "cancer"
      }
    ],
    "fields": {
      "operation": "list_cell_types"
    }
  },
  {
    "name": "CellMarker_search_cancer_markers",
    "type": "CellMarkerTool",
    "description": "Search the CellMarker 2.0 database for cancer-context marker records with complete limit/offset pagination and explicit total/has_more metadata. Cell-type phrase matching respects boundaries, so 'T cell' does not match 'Fat cell' or 'Mast cell'. At least one of cancer_type, gene_symbol, or cell_type is required.",
    "category": "Genomics & Transcriptomics",
    "parameter": {
      "type": "object",
      "properties": {
        "cancer_type": {
          "type": "string",
          "description": "Cancer tissue type (e.g., 'Breast', 'Lung', 'Brain', 'Liver'). Filters by tissue where cancer occurs."
        },
        "gene_symbol": {
          "type": "string",
          "description": "Marker gene to search in cancer context (e.g., 'CD274' for PD-L1, 'EPCAM')"
        },
        "cell_type": {
          "type": "string",
          "description": "Cancer cell type to search for (e.g., 'Cancer stem cell', 'T cell', 'Macrophage')"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": 200,
          "description": "Maximum records to return. Default 200; total_records reports how many matched, so raise this or page with offset when it is larger.",
          "maximum": 1000
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": 0,
          "description": "Records to skip before returning, for paging through total_records. Use data.next_offset for the next page."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
