              "type": "string"
            },
            "cell_type": {
              "type": "string"
            }
          }
        },
        "total_records": {
          "type": "integer"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "species": {
                "type": "string"
              },
              "tissue_class": {
                "type": "string"
              },
              "tissue_type": {
                "type": "string"
              },
              "cell_type": {
                "type": "string"
              },
              "cell_name": {
                "type": "string"
              },
              "cell_marker": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "supports": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "operation": "search_cancer_markers",
        "gene_symbol": "CD274"
      },
      {
        "operation": "search_cancer_markers",
        "cancer_type": "Breast",
        "cell_type": "T cell"
      }
    ],
    "fields": {
      "operation": "search_cancer_markers"
    }
  }
