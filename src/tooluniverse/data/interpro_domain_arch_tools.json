[
  {
    "name": "InterPro_get_protein_domain_architecture",
    "description": "Get Pfam domain architecture for a protein with exact residue positions using the InterPro API. Entry results are cursor-paginated: when has_more is true, pass next_cursor as cursor to retrieve the next page.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt protein accession. Examples: 'P04637' (TP53, 4 Pfam domains), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (Insulin)."
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50,
          "description": "Maximum InterPro entries to return per page (default 50, max 200)."
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "protein_domain_architecture"
    },
    "type": "InterProDomainArchTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "protein_length": {
              "type": [
                "integer",
                "number"
              ]
            },
            "total_entries": {
              "type": "integer"
            },
            "returned_entries": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "domain_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pfam_accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "integrated_interpro": {
                    "type": "string"
                  },
                  "start": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "end": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "required": [
            "accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "InterPro_get_structures_for_domain",
    "description": "Find PDB structures containing a specific Pfam domain using the InterPro API. Results are cursor-paginated: when has_more is true, pass next_cursor as cursor to retrieve the next page.",
    "parameter": {
      "type": "object",
      "properties": {
        "pfam_accession": {
          "type": "string",
          "description": "Pfam domain accession. Examples: 'PF00870' (P53 DNA-binding, 215 structures), 'PF00069' (Protein kinase, 5238 structures), 'PF07710' (P53 tetramerisation), 'PF00046' (Homeodomain)."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of PDB structures to return (default 20, max 200).",
          "default": 20
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "pfam_accession"
      ]
    },
    "fields": {
      "endpoint": "structures_for_domain"
    },
    "type": "InterProDomainArchTool",
    "test_examples": [
      {
        "pfam_accession": "PF00870",
        "max_results": 10
      },
      {
        "pfam_accession": "PF00069",
        "max_results": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pfam_accession": {
              "type": "string"
            },
            "total_structures": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": [
                "integer",
                "number"
              ]
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pdb_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "experiment_type": {
                    "type": "string"
                  },
                  "resolution": {
                    "type": "number"
                  },
                  "chains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Structure chains the domain was found in"
                  },
                  "entry_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "domain, family, homologous_superfamily or site"
                  },
                  "entry_source_database": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Database the entry comes from, e.g. pfam"
                  },
                  "entry_integrated_interpro": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "InterPro accession the entry is integrated into"
                  },
                  "protein_length": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Length of the matched protein in residues"
                  },
                  "protein_locations": {
                    "type": "array",
                    "description": "Where the domain sits in UniProt numbering",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fragments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "First residue in this frame"
                              },
                              "end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Last residue in this frame"
                              },
                              "auth_start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "PDB author numbering of the start, where InterPro gives it"
                              },
                              "auth_end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "PDB author numbering of the end"
                              },
                              "status": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "InterPro's continuity code, e.g. CONTINUOUS"
                              }
                            }
                          }
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Signature model behind the match"
                        },
                        "score": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "description": "Match e-value; 6.8e-60 for PF00870 in 1gzh"
                        },
                        "representative": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether InterPro treats this as representative"
                        }
                      }
                    }
                  },
                  "structure_locations": {
                    "type": "array",
                    "description": "Where it sits in the structure's own numbering, with the PDB author numbering beside it: 6-194 and auth 100-288 for PF00870 in 1gzh",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fragments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "First residue in this frame"
                              },
                              "end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Last residue in this frame"
                              },
                              "auth_start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "PDB author numbering of the start, where InterPro gives it"
                              },
                              "auth_end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "PDB author numbering of the end"
                              },
                              "status": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "InterPro's continuity code, e.g. CONTINUOUS"
                              }
                            }
                          }
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Signature model behind the match"
                        },
                        "score": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "description": "Match e-value; 6.8e-60 for PF00870 in 1gzh"
                        },
                        "representative": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether InterPro treats this as representative"
                        }
                      }
                    }
                  },
                  "entries_matched": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every entry accession reported for the hit"
                  }
                }
              }
            }
          },
          "required": [
            "pfam_accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "InterPro_get_clan_members",
    "description": "Get member families in a Pfam clan (superfamily) using the InterPro API. member_count is the complete total; use member_offset and max_results to page through the sorted member list until next_member_offset is null.",
    "parameter": {
      "type": "object",
      "properties": {
        "clan_accession": {
          "type": "string",
          "description": "Pfam clan accession. Examples: 'CL0016' (PKinase superfamily, 30+ families), 'CL0023' (P53-like transcription factor), 'CL0004' (EGF superfamily), 'CL0159' (E2 superfamily)."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of member families to return (default 50, max 200).",
          "default": 50
        },
        "member_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset into the clan member list (default 0)."
        }
      },
      "required": [
        "clan_accession"
      ]
    },
    "fields": {
      "endpoint": "clan_members"
    },
    "type": "InterProDomainArchTool",
    "test_examples": [
      {
        "clan_accession": "CL0016"
      },
      {
        "clan_accession": "CL0023",
        "max_results": 20
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "clan_accession": {
              "type": "string"
            },
            "clan_name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "member_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": "integer"
            },
            "members_truncated": {
              "type": "boolean"
            },
            "next_member_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "short_name": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "required": [
            "clan_accession"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
