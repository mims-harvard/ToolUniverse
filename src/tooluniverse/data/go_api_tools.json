[
  {
    "name": "GOAPI_get_term",
    "description": "Get detailed information about a Gene Ontology (GO) term by its GO ID. Returns the term label, full definition, synonyms, cross-references, and alternative IDs. GO terms describe gene product attributes across three domains: Biological Process (BP), Molecular Function (MF), and Cellular Component (CC). Example: GO:0006915 returns 'apoptotic process' with its definition and related terms.",
    "parameter": {
      "type": "object",
      "properties": {
        "go_id": {
          "type": "string",
          "description": "Gene Ontology term ID. Format: GO:NNNNNNN. Examples: 'GO:0006915' (apoptotic process), 'GO:0008285' (negative regulation of cell population proliferation), 'GO:0005634' (nucleus), 'GO:0003677' (DNA binding)."
        }
      },
      "required": [
        "go_id"
      ]
    },
    "fields": {
      "endpoint": "term"
    },
    "type": "GOAPITool",
    "test_examples": [
      {
        "go_id": "GO:0006915"
      },
      {
        "go_id": "GO:0005634"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "go_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "GO term identifier"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "Term name/label"
            },
            "definition": {
              "type": [
                "string",
                "null"
              ],
              "description": "Full text definition"
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Exact synonyms"
            },
            "related_synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Related synonyms"
            },
            "xrefs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Cross-references (Reactome, Wikipedia, etc.)"
            },
            "alternative_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Alternative/obsolete GO IDs"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GOAPI_get_gene_functions",
    "description": "Get Gene Ontology annotations for a specific gene with explicit start/rows pagination. The GO API omits a total count, so ToolUniverse uses one-record look-ahead to report exact has_more and next_start; total_results is populated only on the final page and total_results_exact states whether it is known.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "Gene identifier as a CURIE. Examples: 'HGNC:11998' (TP53), 'UniProtKB:P04637' (p53 protein), 'HGNC:1100' (BRCA1), 'MGI:MGI:98834' (Trp53 mouse). For human genes, use HGNC prefix."
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Annotations per page (default 20, verified upstream through 1000). ToolUniverse requests one extra association internally to determine has_more."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based association offset. Continue with metadata.next_start while has_more is true."
        },
        "aspect": {
          "type": "string",
          "description": "Filter by GO aspect: 'P' (Biological Process), 'F' (Molecular Function), 'C' (Cellular Component). Default: all aspects."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint": "gene_functions"
    },
    "type": "GOAPITool",
    "test_examples": [
      {
        "gene_id": "HGNC:11998"
      },
      {
        "gene_id": "UniProtKB:P04637",
        "rows": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "go_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "GO term ID"
              },
              "go_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "GO term name"
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "GO domain (biological_process, molecular_function, cellular_component)"
              },
              "evidence_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ECO evidence code of the annotation, from the API's 'evidence' field"
              },
              "evidence_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "What that evidence code means"
              },
              "provided_by": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Annotation providers"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Literature references (PMID, UniProtKB), from the API's 'publications' field"
              },
              "evidence_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Every ECO code the annotation carries"
              },
              "evidence_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Those codes' labels"
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "GO domains the term belongs to, nulls dropped"
              },
              "negated": {
                "type": "boolean",
                "description": "True for a NOT annotation: the gene is curated as not having this term"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GOAPI_get_genes_by_function",
    "description": "Get unique genes annotated with a GO term. The upstream /genes route actually returns repeated association rows, so ToolUniverse deduplicates by gene ID, preserves the encountered GO/evidence/provider rows under each gene, and applies offset after deduplication. Metadata reports unique-gene navigation and scan completeness; each gene's associations_complete flag states whether its nested association list is proven complete.",
    "parameter": {
      "type": "object",
      "properties": {
        "go_id": {
          "type": "string",
          "description": "Gene Ontology term ID. Examples: 'GO:0006915' (apoptotic process), 'GO:0003677' (DNA binding), 'GO:0005634' (nucleus)."
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Unique genes per locally deduplicated page (default 20, max 1000)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after deduplication by gene ID. Continue with metadata.next_offset while has_more is true."
        },
        "max_associations_scanned": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000,
          "description": "Optional upstream association-row scan budget. Increase and rerun the same offset if metadata.scan_limit_reached is true or complete nested associations are required."
        },
        "taxon": {
          "type": "string",
          "description": "Filter by taxon. Format: NCBITaxon:ID. Examples: 'NCBITaxon:9606' (human), 'NCBITaxon:10090' (mouse), 'NCBITaxon:7227' (Drosophila)."
        }
      },
      "required": [
        "go_id"
      ]
    },
    "fields": {
      "endpoint": "search_annotations"
    },
    "type": "GOAPITool",
    "test_examples": [
      {
        "go_id": "GO:0006915",
        "rows": 10
      },
      {
        "go_id": "GO:0003677",
        "taxon": "NCBITaxon:9606",
        "rows": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene/protein identifier (UniProtKB, HGNC, etc.)"
              },
              "gene_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene symbol or name"
              },
              "taxon_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxon identifier"
              },
              "taxon_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Species name"
              },
              "associations_returned": {
                "type": "integer",
                "description": "Number of association rows preserved for this unique gene in the scanned upstream window"
              },
              "associations_complete": {
                "type": "boolean",
                "description": "True only when the upstream association result was exhausted, proving no later row can mention this gene"
              },
              "associations": {
                "type": "array",
                "description": "Positive association rows encountered for this gene",
                "items": {
                  "type": "object",
                  "properties": {
                    "go_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "GO term the gene is annotated to"
                    },
                    "go_label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "That term's name"
                    },
                    "category": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "GO domains of the term, nulls dropped"
                    },
                    "evidence_type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ECO evidence code of the annotation, from the API's 'evidence' field"
                    },
                    "evidence_label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "What that evidence code means"
                    },
                    "evidence_codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Every ECO code the annotation carries"
                    },
                    "evidence_labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Those codes' labels"
                    },
                    "provided_by": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Annotation providers"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Literature references (PMID, UniProtKB), from the API's 'publications' field"
                    }
                  }
                }
              },
              "negated_associations": {
                "type": "array",
                "description": "NOT annotations seen for this gene: it is curated as not having those terms. They never put a gene in this list, so a gene annotated only negatively is absent from it.",
                "items": {
                  "type": "object",
                  "properties": {
                    "go_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "GO term the gene is annotated to"
                    },
                    "go_label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "That term's name"
                    },
                    "category": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "GO domains of the term, nulls dropped"
                    },
                    "evidence_type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ECO evidence code of the annotation, from the API's 'evidence' field"
                    },
                    "evidence_label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "What that evidence code means"
                    },
                    "evidence_codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Every ECO code the annotation carries"
                    },
                    "evidence_labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Those codes' labels"
                    },
                    "provided_by": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Annotation providers"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Literature references (PMID, UniProtKB), from the API's 'publications' field"
                    },
                    "negated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
