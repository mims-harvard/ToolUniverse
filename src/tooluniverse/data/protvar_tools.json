[
  {
    "name": "ProtVar_map_variant",
    "type": "ProtVarTool",
    "description": "Map a human protein variant to genomic coordinates and retrieve computational variant-effect predictions. AlphaMissense/EVE/ESM/PopEVE/CADD outputs are explicitly labeled as model predictions, not clinical classifications, and AlphaMissense class thresholds are returned with each prediction.",
    "parameter": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "description": "Variant identifier in one of three formats: (1) 'UniProtAccession SingleLetterChange' e.g. 'P04637 R175H' (TP53 R175H); (2) dbSNP rsID e.g. 'rs1799966'; (3) VCF genomic 'chr17 43057065 . REF ALT'. Note: colon-separated 'chr:pos:ref:alt' is auto-converted to VCF format."
        },
        "assembly": {
          "type": "string",
          "enum": ["GRCh38", "GRCh37"],
          "default": "GRCh38",
          "description": "Genome assembly used for genomic input and output coordinates."
        }
      },
      "required": ["variant"]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "description": "The variant query string"
        },
        "genomic_coordinates": {
          "type": "object",
          "properties": {
            "chr": {"type": ["string", "null"]},
            "pos": {"type": ["integer", "null"]},
            "ref": {"type": ["string", "null"]},
            "alt": {"type": ["string", "null"]}
          }
        },
        "isoform_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession": {"type": ["string", "null"]},
              "canonical": {"type": ["boolean", "null"]},
              "gene": {"type": ["string", "null"]},
              "ensg": {"type": ["string", "null"]},
              "consequence": {"type": ["string", "null"]},
              "ref_aa": {"type": ["string", "null"]},
              "alt_aa": {"type": ["string", "null"]},
              "position": {"type": ["integer", "null"]},
              "codon_change": {"type": ["string", "null"]},
              "protein_name": {"type": ["string", "null"]},
              "alphamissense": {
                "type": ["object", "null"],
                "properties": {
                  "score": {"type": ["number", "null"]},
                  "class": {"type": ["string", "null"]},
                  "classification_scope": {"type": "string"},
                  "is_clinical_classification": {"type": "boolean"},
                  "class_thresholds": {"type": "object"}
                }
              },
              "cadd_score": {"type": ["number", "null"]},
              "eve_score": {"type": ["number", "null"]},
              "esm1v_score": {"type": ["number", "null"]},
              "popeve_score": {"type": ["number", "null"]}
            }
          }
        },
        "prediction_context": {
          "type": "object",
          "description": "Provenance and non-clinical interpretation warning for computational scores."
        }
      }
    },
    "test_examples": [
      {"variant": "P04637 R175H"},
      {"variant": "rs1799966"}
    ],
    "label": ["ProtVar", "Variant", "Pathogenicity", "AlphaMissense", "EVE"],
    "metadata": {
      "tags": ["variant", "pathogenicity", "missense", "protein"],
      "estimated_execution_time": "3-5 seconds"
    }
  },
  {
    "name": "ProtVar_get_function",
    "type": "ProtVarFunctionTool",
    "description": "Get the functional, structural, interaction, and predictive annotations returned by ProtVar at a specific amino acid position. Includes UniProt features/comments, gene and database references, predicted pockets and protein interactions, conservation/ESM/EVE/PopEVE scores, FoldX predictions, and M3D predictions when available. Example: P04637 position 175 returns DNA-binding annotations and structural/predictive context.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession (e.g. 'P04637' for TP53)."
        },
        "position": {
          "type": "integer",
          "description": "Amino acid position in the protein (1-based)."
        },
        "variant_aa": {
          "type": "string",
          "pattern": "^[A-Za-z]$",
          "description": "Single-letter code for the variant amino acid (e.g. 'H' for histidine). Supply this to retrieve mutation-specific ESM, EVE, PopEVE, FoldX, and M3D predictions; without it ProtVar returns only position-level context."
        }
      },
      "required": ["accession", "position"]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "accession": {"type": ["string", "null"]},
        "position": {"type": ["integer", "null"]},
        "variant_aa": {"type": ["string", "null"]},
        "protein_name": {"type": ["string", "null"]},
        "gene_names": {
          "type": "array",
          "items": {"type": "object"}
        },
        "protein_existence": {"type": ["string", "null"]},
        "alternative_names": {
          "type": "array",
          "items": {}
        },
        "database_references": {
          "type": "array",
          "items": {"type": "object"}
        },
        "pockets": {
          "type": "array",
          "items": {"type": "object"},
          "description": "Predicted structural pockets involving the queried position."
        },
        "interactions": {
          "type": "array",
          "items": {"type": "object"},
          "description": "Predicted protein-protein interaction models involving the queried position."
        },
        "conservation_score": {
          "type": ["object", "number", "null"]
        },
        "esm_score": {
          "type": ["object", "number", "null"]
        },
        "eve_score": {
          "type": ["object", "number", "null"]
        },
        "population_eve_score": {
          "type": ["object", "number", "null"]
        },
        "foldx_predictions": {
          "type": "array",
          "items": {"type": "object"}
        },
        "m3d_predictions": {
          "type": ["object", "array", "number", "string", "null"]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": ["string", "null"]},
              "category": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "begin": {"type": ["string", "integer", "null"]},
              "end": {"type": ["string", "integer", "null"]}
            }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": ["string", "null"]},
              "value": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "test_examples": [
      {"accession": "P04637", "position": 175, "variant_aa": "H"},
      {"accession": "P22304", "position": 149}
    ],
    "label": ["ProtVar", "Function", "Annotation", "UniProt"],
    "metadata": {
      "tags": ["variant", "function", "annotation", "protein"],
      "estimated_execution_time": "2-3 seconds"
    }
  },
  {
    "name": "ProtVar_get_population",
    "type": "ProtVarPopulationTool",
    "description": "Get population observation data for a protein variant position from ProtVar. Returns co-located variants with population allele frequencies (gnomAD, 1000Genomes), clinical significance (ClinVar), and computational predictions (SIFT, PolyPhen).",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession (e.g. 'P22304' for IDS)."
        },
        "position": {
          "type": "integer",
          "description": "Amino acid position in the protein (1-based)."
        },
        "genomic_location": {
          "type": "integer",
          "description": "Genomic coordinate (GRCh38) for the variant. Obtain from ProtVar_map_variant output."
        }
      },
      "required": ["accession", "position", "genomic_location"]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "accession": {"type": "string"},
        "position": {"type": "integer"},
        "genomic_location": {"type": "integer"},
        "colocated_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {"type": ["string", "null"]},
              "wild_type": {"type": ["string", "null"]},
              "alt_sequence": {"type": ["string", "null"]},
              "genomic_location": {"type": ["string", "null"]},
              "cytogenetic_band": {"type": ["string", "null"]},
              "frequencies": {
                "type": "array",
                "items": {"type": "object"}
              },
              "predictions": {
                "type": "array",
                "items": {"type": "object"}
              },
              "xrefs": {
                "type": "array",
                "items": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {"accession": "P22304", "position": 149, "genomic_location": 149501011}
    ],
    "label": ["ProtVar", "Population", "Frequency", "ClinVar", "SIFT", "PolyPhen"],
    "metadata": {
      "tags": ["variant", "population", "frequency", "clinical"],
      "estimated_execution_time": "2-3 seconds"
    }
  }
]
