[
  {
    "name": "Eurostat_get_dataset",
    "description": "Retrieve statistical data from Eurostat (EU statistical office) for a specific dataset and filter combination. Eurostat provides 10,000+ datasets covering EU member states for economics (GDP, inflation, trade), social statistics (population, employment, poverty), health, environment, agriculture, and more. Returns time-series values with dimension metadata. Common datasets: 'demo_pjan' (population by age/sex), 'nama_10_gdp' (GDP), 'ilc_li01' (poverty rate), 'env_air_gge' (GHG emissions), 'hlth_ehis_fv3e' (health). Use Eurostat database explorer to find dataset codes.",
    "parameter": {
      "type": "object",
      "properties": {
        "datasetCode": {
          "type": "string",
          "description": "Eurostat dataset code. Examples: 'demo_pjan' (population by age/sex), 'nama_10_gdp' (GDP), 'ilc_li01' (at-risk-of-poverty rate), 'env_air_gge' (GHG emissions), 'une_rt_a' (unemployment rate), 'tec00001' (GDP per capita)"
        },
        "geo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Country/region code filter. EU country codes: DE (Germany), FR (France), IT (Italy), ES (Spain), PL (Poland), NL (Netherlands), BE (Belgium), SE (Sweden). Use 'EU27_2020' for EU average."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit of measurement filter (dataset-specific). Examples: 'PC' (percentage), 'NR' (number), 'CP_MEUR' (million EUR current prices), 'PC_GDP' (% of GDP), 'T' (tonnes)"
        },
        "na_item": {
          "type": [
            "string",
            "null"
          ],
          "description": "National accounts item filter for economic datasets (e.g., 'B1GQ' for GDP, 'P3' for final consumption)"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "description": "Time filter (year or time range). Examples: '2022', '2015:2022' (range)"
        }
      },
      "required": [
        "datasetCode"
      ]
    },
    "fields": {
      "endpoint": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/{datasetCode}",
      "params": {
        "format": "JSON",
        "lang": "en"
      }
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "datasetCode": "nama_10_gdp",
        "geo": "DE",
        "unit": "CP_MEUR",
        "na_item": "B1GQ"
      },
      {
        "datasetCode": "demo_pjan",
        "geo": "FR",
        "unit": "NR"
      },
      {
        "datasetCode": "une_rt_a",
        "geo": "ES",
        "unit": "PC"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "class": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "value": {
              "type": "object",
              "description": "Sparse map of flat cell index (decimal string) to observation value. Which indices are present depends on the dataset and the filters, so the keys cannot be enumerated.",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "status": {
              "type": "object",
              "description": "Sparse map of flat cell index to Eurostat observation flag (e.g. 'p' provisional, 'b' break in series, ':' not available).",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "id": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "size": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            },
            "dimension": {
              "type": "object",
              "description": "One entry per dataset dimension, keyed by the dimension's own code (geo, time, unit, na_item, age, sex, nace_r2, isced11, ...). The set of dimensions is a property of the dataset, not of this API, so it cannot be enumerated; `id` lists the dimensions of this response in cell order and `size` their lengths.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "category": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "object",
                        "description": "Category code -> position along this dimension.",
                        "additionalProperties": {
                          "type": [
                            "integer",
                            "number"
                          ]
                        }
                      },
                      "label": {
                        "type": "object",
                        "description": "Category code -> human-readable label.",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "unit": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            },
            "extension": {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "agencyId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "datastructure": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "agencyId": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                },
                "annotation": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "href": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                },
                "status": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "object",
                      "description": "Observation flag letter -> its meaning.",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                },
                "positions-with-no-data": {
                  "type": "object",
                  "description": "Per dimension code, the positions that carry no observation. Keyed by the dataset's own dimension codes, so not enumerable.",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": [
                        "integer",
                        "number"
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": [
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
