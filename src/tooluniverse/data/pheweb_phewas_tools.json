[
  {
    "name": "BioBankJapan_phewas_by_variant",
    "description": "Page through all BioBank Japan variant PheWAS associations after stable ascending p-value sorting. Returns true total, returned count, and next offset; accepts an rsID or explicit GRCh37 variant for Japanese-ancestry replication.",
    "parameter": {
      "type": "object",
      "properties": {
        "rsid": {
          "type": "string",
          "description": "dbSNP rsID, e.g. 'rs7903146'. Auto-resolved to GRCh37 coordinates via Ensembl. Provide this OR 'variant'."
        },
        "variant": {
          "type": "string",
          "description": "Variant in chr:pos:ref:alt or chr-pos-ref-alt format, in GRCh37, e.g. '10:114758349:C:T'. Provide this OR 'rsid'. A bare rsID is also accepted here."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of phenotype associations to return (sorted by ascending p-value).",
          "default": 20
        },
      "offset": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Zero-based offset into filtered, p-value-sorted associations."
      },
      "max_pval": {
          "type": ["number", "null"],
          "description": "Optional: only return associations with p-value <= this threshold (e.g. 5e-8 for genome-wide significance)."
        }
      },
      "required": []
    },
    "fields": {
      "biobank": "bbj"
    },
    "type": "PheWebPheWASTool",
    "test_examples": [
      {"rsid": "rs7903146", "max_pval": 5e-8},
      {"variant": "10:114758349:C:T", "limit": 10}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string"
            },
            "rsids": {
              "type": [
                "string",
                "null"
              ]
            },
            "nearest_genes": {
              "type": [
                "string",
                "null"
              ]
            },
            "associations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phenocode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "phenostring": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pval": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "beta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "sebeta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "af": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "num_cases": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "num_controls": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "variant"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
