  {
    "name": "Genebass_gene_burden_phewas",
    "description": "Page through all Genebass gene-burden PheWAS associations after stable ascending p-value sorting. Returns true total, returned count, next offset, and phenotype descriptions for the requested page across ~4,500 UK Biobank phenotypes.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Ensembl gene ID (e.g. 'ENSG00000148737') or gene symbol (e.g. 'TCF7L2'). Symbols are auto-resolved via Ensembl."
        },
        "burden_set": {
          "type": "string",
          "description": "Variant category aggregated in the burden test. One of: 'pLoF' (default), 'missense|LC', 'synonymous'. Aliases accepted: lof/plof -> pLoF, missense -> missense|LC.",
          "default": "pLoF"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of phenotype associations to return (sorted by ascending burden p-value).",
          "default": 25
        },
      "offset": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Zero-based offset into filtered, p-value-sorted burden associations."
      },
      "max_pval": {
          "type": ["number", "null"],
          "description": "Optional: only return associations with burden p-value <= this threshold (e.g. 2.5e-6 for exome-wide significance)."
        }
      },
      "required": ["gene"]
    },
    "type": "GenebassTool",
    "timeout": 90,
    "test_examples": [
      {"gene": "ENSG00000148737", "burden_set": "pLoF", "limit": 10, "offset": 25},
      {"gene": "ENSG00000148737", "burden_set": "missense|LC", "max_pval": 2.5e-6}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene_id": {
              "type": "string"
            },
            "gene_symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "burden_set": {
              "type": "string"
            },
            "associations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phenocode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trait_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pval": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pval_skat": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "beta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "total_variants": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "gene_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
