[
  {
    "type": "CompoundGeneDiseaseAssociationTool",
    "name": "gather_gene_disease_associations",
    "description": "Query multiple gene-disease databases (DisGeNET, OMIM, OpenTargets, GenCC, ClinVar) in a single call. Both the concordance table and each source-specific list expose independent recoverable pagination: use next_association_offset for associations and per_source_pagination[source].next_offset as source_offset for source rows.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gene symbol (e.g., 'TP53', 'BRCA1'). At least one of gene or disease required."
        },
        "disease": {
          "type": [
            "string",
            "null"
          ],
          "description": "Disease name (e.g., 'breast cancer', 'distal renal tubular acidosis'). At least one of gene or disease required."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Associations per page (1-500; default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based concordance association offset."
        },
        "source_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 10,
          "description": "Rows returned per source (1-500; default 10)."
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset applied independently to every source list."
        }
      },
      "required": []
    },
    "return_schema": {
      "type": "object",
      "description": "Unwrapped payload (result['data']) of a successful call.",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "gene": {
              "type": [
                "string",
                "null"
              ]
            },
            "disease": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sources_queried": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "num_associations": {
          "type": "integer"
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "concordance": {
                "type": "integer"
              },
              "total_sources_queried": {
                "type": "integer"
              },
              "scores": {
                "type": "object",
                "description": "Association score keyed by source name; sources without a numeric score are omitted."
              }
            },
            "required": [
              "name",
              "sources",
              "concordance",
              "total_sources_queried",
              "scores"
            ]
          }
        },
        "per_source_results": {
          "type": "object",
          "description": "Current page of extracted items per source, keyed by source name.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string",
                  "description": "Present only for GenCC entries (classification, e.g. Definitive, Strong, Moderate)."
                }
              },
              "required": [
                "name",
                "score",
                "source"
              ]
            }
          }
        },
        "per_source_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "per_source_pagination": {
          "type": "object"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Present only when a source's contribution needs explanation beyond a plain empty result (e.g. it lacks the data shape this tool extracts from, distinct from genuinely having no data for the query)."
        }
      },
      "required": [
        "query",
        "sources_queried",
        "sources_failed",
        "num_associations",
        "associations",
        "per_source_results"
      ]
    },
    "test_examples": [
      {
        "gene": "TP53"
      },
      {
        "disease": "breast cancer"
      },
      {
        "gene": "BRCA1",
        "disease": "breast cancer"
      }
    ]
  }
]
