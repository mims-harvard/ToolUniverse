[
  {
    "type": "OpenAIREDatasetTool",
    "name": "OpenAIRE_search_datasets",
    "description": "Search OpenAIRE research datasets with exact totals and explicit page navigation. Continue with metadata.next_page while metadata.has_more is true. Supports funder and country filters.",
    "parameter": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "string",
          "description": "Search keywords for dataset discovery. Searches across titles, descriptions, and subjects."
        },
        "funder": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional funder short name to filter datasets. Examples: 'EC' (European Commission), 'NIH', 'NSF', 'ARC' (Australian Research Council), 'WT' (Wellcome Trust), 'FCT' (Portugal), 'SNSF' (Swiss NSF).",
          "default": null
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ISO 3166-1 alpha-2 country code to filter by. Examples: 'DE' (Germany), 'FR' (France), 'IT' (Italy), 'NL' (Netherlands), 'GB' (UK), 'ES' (Spain).",
          "default": null
        },
        "size": {
          "type": "integer",
          "description": "Number of results to return. Default 10, maximum 100.",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "page": {
          "type": "integer",
          "description": "One-based result page. Continue with metadata.next_page.",
          "default": 1,
          "minimum": 1
        }
      },
      "required": [
        "keywords"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "keywords": {
              "type": "string"
            },
            "funder": {
              "type": [
                "null",
                "string"
              ]
            },
            "country": {
              "type": [
                "null",
                "string"
              ]
            },
            "total_count": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": [
                "integer",
                "number"
              ]
            },
            "datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "creators": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "date": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "publisher": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "access_rights": {
                    "type": "string"
                  },
                  "doi": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "subjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "keywords"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "keywords": "aging cohort physical function",
        "size": 3
      },
      {
        "keywords": "climate change biodiversity",
        "funder": "EC",
        "size": 3
      },
      {
        "keywords": "genomics cancer",
        "country": "DE",
        "size": 2
      }
    ]
  }
]
