[
  {
    "name": "SABIO_RK_search_reactions",
    "description": "Search SABIO-RK for biochemical reaction kinetic laws. Returns exact total and offset pagination plus complete per-entry source JSON, kinetic parameter values and normalized units, experimental conditions, enzyme metadata, and publication evidence. Search by EC number, enzyme, substrate, organism, product, or parameter type. Use offset/next_offset to retrieve all results rather than silently stopping at the first page.",
    "type": "SABIORKTool",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "search_reactions",
          "description": "Operation type (fixed: search_reactions)",
          "default": "search_reactions"
        },
        "ec_number": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.(?:[0-9]+|-)\\.(?:[0-9]+|-)\\.(?:[0-9]+|-)$",
          "description": "EC number (e.g., 1.1.1.1 for alcohol dehydrogenase, 2.7.1.1 for hexokinase)"
        },
        "enzyme_name": {
          "type": "string",
          "minLength": 1,
          "description": "Enzyme common name (e.g., alcohol dehydrogenase, hexokinase, lactate dehydrogenase)"
        },
        "substrate": {
          "type": "string",
          "minLength": 1,
          "description": "Substrate name (e.g., ethanol, glucose, ATP)"
        },
        "organism": {
          "type": "string",
          "minLength": 1,
          "description": "Organism name (e.g., Homo sapiens, Escherichia coli, Saccharomyces cerevisiae)"
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "description": "Product name (e.g., acetaldehyde, pyruvate)"
        },
        "parameter_type": {
          "type": "string",
          "minLength": 1,
          "description": "Filter by kinetic parameter type (e.g., Km, kcat, Vmax, Ki)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of kinetic laws to return (default 20, max 100)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based result offset (default 0). When has_more is true, pass next_offset to retrieve the next disjoint page."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query sent to SABIO-RK"
        },
        "kinetic_laws": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string",
                "description": "SABIO-RK entry identifier"
              },
              "ec_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "substrates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "array",
                "description": "Measured kinetic constants for this entry (constants without a reported value are omitted)",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Parameter type (Km, kcat, Ki, Vmax, kcat/Km)"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "species": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Compound the constant refers to (e.g. the substrate for a Km), if SABIO-RK names one"
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Value as reported, in 'unit'"
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value_si": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "SABIO-RK's SI-normalised value, in 'unit_si' (Km in M, kcat in s^(-1))"
                    },
                    "unit_si": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "end_value": {
                      "type": "number",
                      "description": "Upper end when a range is reported"
                    },
                    "standard_deviation": {
                      "type": "number"
                    },
                    "normalized_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "normalized_unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sbo_term": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "conditions": {
                "type": "object",
                "description": "Assay conditions: ph, temperature, temperature_unit (when reported)"
              },
              "experimental_conditions": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "publication": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "enzyme_description": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "source_record": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Complete SABIO-RK entry decoded from the Solr Json field."
              },
              "source_record_complete": {
                "type": "boolean"
              }
            }
          }
        },
        "total_count": {
          "type": "integer",
          "description": "Total number of matching kinetic laws"
        },
        "returned_count": {
          "type": "integer",
          "description": "Number of kinetic laws returned in this response"
        },
        "offset": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result_set_complete": {
          "type": "boolean"
        }
      }
    },
    "test_examples": [
      {
        "ec_number": "1.1.1.1"
      },
      {
        "enzyme_name": "hexokinase",
        "organism": "Homo sapiens",
        "limit": 5
      },
      {
        "substrate": "ethanol",
        "limit": 10
      }
    ],
    "fields": {
      "operation": "search_reactions"
    }
  }
]