[
  {
    "name": "USGSWater_get_streamflow",
    "type": "USGSWaterTool",
    "description": "Get recent streamflow (discharge) readings from USGS stream gages, in cubic feet per second (ft^3/s), with site name, state and coordinates. Values are usually every 15 minutes (some sites every 5) and provisional until reviewed. The USGS monitors over 10,000 stream gages across the United States. Source: USGS Water Data API (api.waterdata.usgs.gov, continuous values), which replaces the WaterServices API USGS is retiring on 2027-02-22.",
    "fields": {
      "parameter_code": "00060",
      "parameter_name": "streamflow (discharge)"
    },
    "parameter": {
      "type": "object",
      "required": [
        "sites"
      ],
      "properties": {
        "sites": {
          "type": "string",
          "description": "USGS site number(s), comma-separated, up to 25 (e.g. '01646500' for the Potomac River near Washington DC, '09380000' for the Colorado River at Lees Ferry). A 'USGS-' prefix is accepted."
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "description": "How far back from now, as an ISO 8601 duration (e.g. 'PT2H' for 2 hours, 'P1D' for 1 day, 'P7D' for 7 days). Default: 'P1D'."
        },
        "max_values": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Max values per site, newest kept, 1-10000 (shared across a site's sensors when it has several). Default 500, about 1.7 days of 5-minute data."
        }
      }
    },
    "optional_api_keys": [
      "USGS_WATER_API_KEY"
    ],
    "api_key_info": {
      "USGS_WATER_API_KEY": {
        "domain": "Other",
        "type": "secret",
        "register_url": "https://api.waterdata.usgs.gov/signup/",
        "purpose": "Raise the rate limit for USGS Water Data API requests (streamflow, gage height, water temperature).",
        "without": "Works anonymously at a lower rate limit."
      }
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string"
          },
          "time_series_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sensor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sensor/sublocation label when a site has several series for this parameter (e.g. 'UPPER', 'From multiparameter sonde'); null otherwise."
          },
          "site_number": {
            "type": "string"
          },
          "site_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "site_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_count": {
