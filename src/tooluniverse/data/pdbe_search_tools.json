[
  {
    "name": "PDBeSearch_search_structures",
    "description": "Search unique PDB structures through PDBe's entity-level Solr index by keyword, protein name, or gene name. A PDB entry can occur in many Solr documents, so this tool deduplicates by pdb_id and applies offset after deduplication. Metadata distinguishes entity-level total_found from unique results, exposes next_offset, and reports whether max_rows_scanned prevented the requested unique page from being filled.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query - protein name, gene name, or keyword. Supports Solr syntax. Examples: 'insulin', 'BRCA1', 'kinase AND human', 'TP53'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000,
          "description": "Unique PDB entries per page (1-1000, default 10). Invalid values return an error rather than being silently clamped."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset after deduplication by pdb_id. Continue with metadata.next_offset while has_more is true."
        },
        "max_rows_scanned": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000,
          "description": "Optional entity-level Solr scan budget used to fill the requested unique-PDB page. The dynamic default scales with offset+limit. If metadata.scan_limit_reached is true, increase this value and rerun the same offset."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search_structures"
    },
    "type": "PDBeSearchTool",
    "test_examples": [
      {
        "query": "insulin",
        "limit": 5
      },
      {
        "query": "BRCA1",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pdb_id": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolution": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "experimental_method": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deposition_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "number_of_entities": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "organism": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBeSearch_get_compound",
    "description": "Get PDB ligand/compound information by compound ID from PDBe. Returns chemical name, formula, molecular weight, InChI, InChI key, SMILES, and systematic names. Useful for looking up small molecules that co-crystallize with proteins. Example: 'ATP' returns adenosine-5'-triphosphate (C10H16N5O13P3, MW 507.18); 'HEM' returns protoporphyrin IX containing iron.",
    "parameter": {
      "type": "object",
      "properties": {
        "compound_id": {
          "type": "string",
          "description": "PDB ligand/compound 3-letter code. Examples: 'ATP' (adenosine triphosphate), 'HEM' (heme), 'NAG' (N-acetyl-D-glucosamine), 'FAD' (flavin adenine dinucleotide)."
        }
      },
      "required": [
        "compound_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_compound"
    },
    "type": "PDBeSearchTool",
    "test_examples": [
      {
        "compound_id": "ATP"
      },
      {
        "compound_id": "HEM"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "compound_id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "weight": {
              "type": [
                "number",
                "null"
              ]
            },
            "compound_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "inchi": {
              "type": [
                "string",
                "null"
              ]
            },
            "inchi_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "smiles": {
              "type": [
                "string",
                "null"
              ]
            },
            "systematic_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PDBeSearch_search_by_organism",
    "description": "Search PDBe Solr records filtered by organism, optionally combined with a keyword. Results are offset-paginated: pass metadata.next_start as start while metadata.has_more is true. PDBe's total_found is an entity-level Solr count, so one PDB entry can occur in multiple records.",
    "parameter": {
      "type": "object",
      "properties": {
        "organism": {
          "type": "string",
          "description": "Scientific name of organism. Examples: 'Homo sapiens', 'Escherichia coli', 'Mus musculus', 'Saccharomyces cerevisiae'."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional keyword query to combine with organism filter. Examples: 'kinase', 'receptor'. Default searches all structures for the organism."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000,
          "description": "PDBe Solr records per page (1-10000, default 10), matching the verified upstream capability. Invalid values return an error rather than being silently clamped."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based PDBe Solr record offset (default 0)."
        }
      },
      "required": [
        "organism"
      ]
    },
    "fields": {
      "endpoint_type": "search_by_organism"
    },
    "type": "PDBeSearchTool",
    "test_examples": [
      {
        "organism": "Escherichia coli",
        "query": "ribosome",
        "limit": 5
      },
      {
        "organism": "Saccharomyces cerevisiae",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pdb_id": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolution": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "experimental_method": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deposition_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "organism": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
