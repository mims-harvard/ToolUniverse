[
  {
    "name": "UniRef_get_cluster",
    "description": "Get detailed information about a UniProt UniRef protein sequence cluster. UniRef clusters group related protein sequences at different identity thresholds: UniRef100 (identical sequences + sub-fragments), UniRef90 (90%+ identity), UniRef50 (50%+ identity). Returns cluster name, member count, representative member details (protein name, organism, accession, sequence length), common taxon, seed sequence, update date, and full protein sequence. Use this to understand protein sequence families and find representative sequences.",
    "parameter": {
      "type": "object",
      "properties": {
        "cluster_id": {
          "type": "string",
          "description": "UniRef cluster ID. Format: UniRefNN_ACCESSION. Examples: 'UniRef90_P04637' (p53 cluster at 90% identity, 160 members), 'UniRef50_P04637' (p53 at 50% identity), 'UniRef100_P04637' (identical to p53), 'UniRef90_P00533' (EGFR at 90%)."
        }
      },
      "required": [
        "cluster_id"
      ]
    },
    "fields": {
      "endpoint": "get_cluster"
    },
    "type": "UniRefTool",
    "test_examples": [
      {
        "cluster_id": "UniRef90_P04637"
      },
      {
        "cluster_id": "UniRef50_P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cluster_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniRef cluster ID"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Cluster name (usually 'Cluster: protein_name')"
            },
            "entry_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Cluster type (UniRef100, UniRef90, UniRef50)"
            },
            "member_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of sequences in the cluster"
            },
            "updated": {
              "type": [
                "string",
                "null"
              ],
              "description": "Last update date"
            },
            "seed_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Seed sequence identifier"
            },
            "common_taxon": {
              "type": "object",
              "properties": {
                "scientific_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "description": "Most specific taxon common to all members"
            },
            "representative_member": {
              "type": "object",
              "properties": {
                "member_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "member_id_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "organism_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "organism_tax_id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "sequence_length": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "protein_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accessions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "Representative (longest) member details"
            },
            "sequence": {
              "type": [
                "string",
                "null"
              ],
              "description": "Representative protein sequence"
            },
            "sequence_length": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Sequence length"
            },
            "members": {
              "type": "array",
              "description": "The cluster's members. A UniRef cluster is its membership: UniRef90_P05067 reports member_count 254 and only the representative member was returned, so the 253 sequences the cluster groups had no path to any caller. At most MEMBERS_PER_CLUSTER are returned; members_truncated says when that applied.",
              "items": {
                "type": "object",
                "properties": {
                  "member_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The member's id, e.g. A4_PANTR."
                  },
                  "member_id_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What kind of id, e.g. 'UniProtKB ID'."
                  },
                  "accessions": {
                    "type": "array",
                    "description": "UniProtKB accessions for the member -- what joins it to every other protein resource.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "organism_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Source organism."
                  },
                  "organism_tax_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "NCBI taxon id of the organism."
                  },
                  "protein_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Protein name as UniRef records it."
                  },
                  "sequence_length": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Length of the member's sequence."
                  },
                  "uniref50_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The same sequence's UniRef50 cluster."
                  },
                  "uniref100_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Its UniRef100 cluster."
                  },
                  "uniparc_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Its UniParc identifier."
                  }
                }
              }
            },
            "members_returned": {
              "type": "integer",
              "description": "How many member records are in members."
            },
            "members_in_response": {
              "type": "integer",
              "description": "How many members the UniRef reply carried (253 for UniRef90_P05067, whose member_count is 254: the count includes the representative, which is reported separately)."
            },
            "members_truncated": {
              "type": "boolean",
              "description": "True when the reply carried more members than MEMBERS_PER_CLUSTER."
            },
            "go_terms": {
              "type": "array",
              "description": "GO annotations UniRef assigns to the cluster. Answered by this endpoint and previously unread; an unannotated cluster answers an empty list.",
              "items": {
                "type": "object",
                "properties": {
                  "go_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GO identifier, e.g. GO:0003677."
                  },
                  "aspect": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GO aspect, e.g. 'GO Molecular Function'."
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "UniRef_search_clusters",
    "description": "Search UniProt UniRef protein sequence clusters with official cursor pagination. Metadata reports the true upstream total and next_cursor; pass that opaque cursor back for the next distinct page.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query. Examples: 'p53', 'insulin', 'kinase Homo sapiens', 'BRCA1', 'hemoglobin'. Supports protein names, gene symbols, organism names."
        },
        "cluster_type": {
          "type": "string",
          "enum": [
            "UniRef100",
            "UniRef90",
            "UniRef50"
          ],
          "default": "UniRef90",
          "description": "Cluster identity level: 'UniRef100' (identical), 'UniRef90' (90% identity, default), 'UniRef50' (50% identity). Invalid values return an error rather than silently removing the identity filter."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Results per cursor page (default 10, official API maximum 500). Invalid values return an error rather than being silently clamped."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from metadata.next_cursor. Omit for the first page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "search_clusters"
    },
    "type": "UniRefTool",
    "test_examples": [
      {
        "query": "p53",
        "cluster_type": "UniRef90",
        "size": 5
      },
      {
        "query": "insulin",
        "size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cluster_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "UniRef cluster ID"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Cluster name"
              },
              "entry_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Cluster type"
              },
              "member_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Number of members"
              },
              "updated": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Last update date"
              },
              "representative_member_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Representative member ID"
              },
              "representative_organism": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Organism of representative"
              },
              "representative_protein": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Protein name of representative"
              },
              "representative_sequence_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Sequence length of representative"
              },
              "common_taxon": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common taxon scientific name"
              },
              "common_taxon_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "NCBI taxon id of the common taxon, beside its name: Amniota is 32524 and the name alone cannot be joined."
              },
              "go_terms": {
                "type": "array",
                "description": "GO annotations UniRef assigns to the cluster -- the functional summary of the group. Both endpoints answer them and neither handler read them, so no UniRef tool returned them anywhere. A cluster with no annotation answers an empty list.",
                "items": {
                  "type": "object",
                  "properties": {
                    "go_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "GO identifier, e.g. GO:0003677."
                    },
                    "aspect": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "GO aspect, e.g. 'GO Molecular Function'."
                    }
                  }
                }
              },
              "members_from": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Names the tool that returns this cluster's members (UniRef_get_cluster). member_count is the cluster's size; the member records are not duplicated into every search row."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
