[
  {
    "name": "PomBase_get_gene",
    "description": "Get detailed gene information from PomBase for fission yeast (S. pombe) by systematic ID. Returns the complete InterPro match and transmembrane-domain lists with explicit counts, plus product, deletion viability, and cross-references. S. pombe is a key model organism for cell cycle, chromosome biology, and RNA processing research. Example: SPAC1093.06c (dhc1) returns all 29 annotated domain matches.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "PomBase systematic gene identifier. Examples: 'SPBC11B10.09' (cdc2), 'SPAC2F7.03c' (pom1), 'SPAC1002.17c' (ase1)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_detail"
    },
    "type": "PomBaseTool",
    "test_examples": [
      {
        "gene_id": "SPBC11B10.09"
      },
      {
        "gene_id": "SPAC2F7.03c"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "systematic_id": {
              "type": "string"
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "product": {
              "type": [
                "string",
                "null"
              ]
            },
            "taxon_id": {
              "type": "integer"
            },
            "uniprot_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "deletion_viability": {
              "type": [
                "string",
                "null"
              ]
            },
            "biogrid_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "interpro_domains": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "db": {
                    "type": "string"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interpro_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                }
              }
            },
            "interpro_domain_count": {
              "type": "integer"
            },
            "tm_domains": {
              "type": "array"
            },
            "tm_domain_count": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PomBase_search_genes",
    "description": "Search all PomBase fission-yeast genes by name, systematic ID, or product keyword with complete local limit/offset pagination. Metadata reports total_matches, has_more, and next_offset; continue while more matches remain.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query - gene name, systematic ID prefix, or product keyword. Examples: 'cdc2', 'kinase', 'SPAC', 'pom1'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Maximum results in this page (1-50, default 10)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based offset in the complete filtered match list. Continue with metadata.next_offset."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "gene_summary_search"
    },
    "type": "PomBaseTool",
    "test_examples": [
      {
        "query": "cdc2",
        "limit": 5
      },
      {
        "query": "kinase",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "systematic_id": {
                "type": "string"
              },
              "gene_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "product": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uniprot_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PomBase_get_gene_phenotypes",
    "description": "Get all phenotype annotations for a fission yeast (S. pombe) gene from PomBase. Returns deletion viability and the complete set of both single-locus and multi-locus FYPO (Fission Yeast Phenotype Ontology) annotations; phenotype_count is the full returned count. S. pombe phenotypes are a key resource for understanding gene function in cell biology. Example: SPBC11B10.09 (cdc2) has hundreds of phenotype annotations and is inviable when deleted.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "PomBase systematic gene identifier. Examples: 'SPBC11B10.09' (cdc2), 'SPAC2F7.03c' (pom1)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_phenotypes"
    },
    "type": "PomBaseTool",
    "test_examples": [
      {
        "gene_id": "SPBC11B10.09"
      },
      {
        "gene_id": "SPAC2F7.03c"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "systematic_id": {
              "type": "string"
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "deletion_viability": {
              "type": [
                "string",
                "null"
              ]
            },
            "phenotype_count": {
              "type": "integer"
            },
            "phenotypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "term_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cv_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PomBase_get_orthologs",
    "description": "Get human and S. cerevisiae orthologs of a fission-yeast (S. pombe) gene from PomBase. Returns ortholog IDs with taxon (9606=human via HGNC, 4932=budding yeast via systematic name). Example: SPBC11B10.09 (cdc2) returns human CDKs HGNC:1722/1771/1772 (taxon 9606) and S. cerevisiae CDC28 / YBR160W (taxon 4932).",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "PomBase systematic ID. Examples: 'SPBC11B10.09' (cdc2), 'SPAC1006.03c' (red1)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_orthologs"
    },
    "type": "PomBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "SPBC11B10.09"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "systematic_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "ortholog_count": {
              "type": "integer"
            },
            "orthologs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ortholog_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ortholog_taxon_id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "ortholog_species": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PomBase_get_interactions",
    "description": "Get physical and genetic interactions for a fission-yeast gene from PomBase, each with evidence, reference, throughput, and source. The two lists are independently paginated: continue with next_physical_offset and/or next_genetic_offset while the corresponding has_more field is true. Example: cdc2 has about 100 physical and 118 genetic records.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "PomBase systematic ID. Examples: 'SPBC11B10.09' (cdc2)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "default": 75,
          "description": "Maximum records returned from each interaction list in this page."
        },
        "physical_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based physical-interaction offset; continue with next_physical_offset."
        },
        "genetic_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based genetic-interaction offset; continue with next_genetic_offset."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_interactions"
    },
    "type": "PomBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "SPBC11B10.09"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "systematic_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "physical_interaction_count": {
              "type": "integer"
            },
            "physical_interactions_returned": {
              "type": "integer"
            },
            "physical_offset": {
              "type": "integer"
            },
            "physical_has_more": {
              "type": "boolean"
            },
            "next_physical_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "physical_interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "interactor_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interactor_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "throughput": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "genetic_interaction_count": {
              "type": "integer"
            },
            "genetic_interactions_returned": {
              "type": "integer"
            },
            "genetic_offset": {
              "type": "integer"
            },
            "genetic_has_more": {
              "type": "boolean"
            },
            "next_genetic_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "limit": {
              "type": "integer"
            },
            "genetic_interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "interactor_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interactor_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interaction_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "throughput": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_database": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "PomBase_get_go_annotations",
    "description": "Get the complete Gene Ontology annotation set (biological_process / molecular_function / cellular_component) for a fission-yeast (S. pombe) gene from PomBase, with full per-aspect counts and resolved term names. No aspect is silently capped. Example: SPBC11B10.09 (cdc2) returns all BP, MF, and CC annotations.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "PomBase systematic ID. Examples: 'SPBC11B10.09' (cdc2)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_go_annotations"
    },
    "type": "PomBaseTool",
    "timeout": 30,
    "test_examples": [
      {
        "gene_id": "SPBC11B10.09"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "systematic_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "gene_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "aspect_counts": {
              "type": "object"
            },
            "go_term_count": {
              "type": "integer"
            },
            "go_terms": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "term_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "aspect": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "aspect_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_not": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
