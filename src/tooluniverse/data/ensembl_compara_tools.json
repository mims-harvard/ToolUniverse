[
  {
    "name": "EnsemblCompara_get_orthologues",
    "description": "Find orthologous genes (genes in different species that evolved from a common ancestor) using Ensembl Compara. Essential for comparative genomics - finding the mouse, zebrafish, or fly equivalent of a human gene. Returns orthologue gene IDs, species, homology type (one-to-one, one-to-many), and taxonomy level of divergence. Example: TP53 in human has a one-to-one orthologue (Trp53) in mouse.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol or Ensembl gene ID. Examples: 'BRCA1', 'TP53', 'ENSG00000141510', 'ENSG00000012048'."
        },
        "species": {
          "type": "string",
          "description": "Source species (default: 'human'). Examples: 'human', 'mouse', 'zebrafish', 'drosophila_melanogaster'."
        },
        "target_species": {
          "type": "string",
          "description": "Target species to limit orthologue search. Examples: 'mouse', 'zebrafish', 'rat', 'drosophila_melanogaster'. Default: all species."
        },
        "target_taxon": {
          "type": "integer",
          "description": "NCBI taxon ID to limit orthologue search. Examples: 10090 (mouse), 7955 (zebrafish), 7227 (fruit fly). Alternative to target_species."
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "endpoint": "orthologues"
    },
    "type": "EnsemblComparaTool",
    "test_examples": [
      {
        "gene": "BRCA1",
        "target_species": "mouse"
      },
      {
        "gene": "TP53",
        "species": "human",
        "target_taxon": 10090
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_gene": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Source Ensembl gene ID"
              },
              "target_gene": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Target orthologue Ensembl gene ID"
              },
              "target_protein": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Target orthologue Ensembl protein ID"
              },
              "target_species": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Target species name"
              },
              "homology_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Type: ortholog_one2one, ortholog_one2many, ortholog_many2many"
              },
              "taxonomy_level": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Taxonomic level of divergence (e.g., Euarchontoglires, Mammalia)"
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Method used (ENSEMBL_ORTHOLOGUES)"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblCompara_get_paralogues",
    "description": "Find paralogous genes (genes within the same species that arose from gene duplication events) using Ensembl Compara. Paralogues often have related but diverged functions. Returns paralogue gene IDs, duplication type, and evolutionary context. Example: TP53 has paralogues TP63 (ENSG00000073282) and TP73 (ENSG00000078900) in human, from ancient vertebrate gene duplication.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol or Ensembl gene ID. Examples: 'TP53', 'BRCA1', 'ENSG00000141510'."
        },
        "species": {
          "type": "string",
          "description": "Species (default: 'human'). Examples: 'human', 'mouse', 'zebrafish'."
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "endpoint": "paralogues"
    },
    "type": "EnsemblComparaTool",
    "test_examples": [
      {
        "gene": "TP53"
      },
      {
        "gene": "BRCA1",
        "species": "human"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_gene": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Source Ensembl gene ID"
              },
              "paralogue_gene": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Paralogue Ensembl gene ID"
              },
              "paralogue_protein": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Paralogue Ensembl protein ID"
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Species name"
              },
              "paralogy_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Type of paralogy (within_species_paralog, etc.)"
              },
              "taxonomy_level": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Level of gene duplication event"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblCompara_get_gene_tree",
    "description": "Get an Ensembl Compara phylogenetic gene tree and its complete member count. Members are recoverably paginated with limit/offset; continue with data.next_offset while data.has_more is true. The collector itself has no hidden cap.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene": {
          "type": "string",
          "description": "Gene symbol or Ensembl gene ID. Examples: 'TP53', 'BRCA1', 'ENSG00000141510'. Ensembl IDs are more reliable than symbols for gene tree retrieval."
        },
        "species": {
          "type": "string",
          "description": "Species (default: 'human'). Used when providing a gene symbol. Examples: 'human', 'mouse'."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum tree members per page (default 50).",
          "default": 50,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based member offset. Continue with data.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "gene"
      ]
    },
    "fields": {
      "endpoint": "gene_tree"
    },
    "type": "EnsemblComparaTool",
    "test_examples": [
      {
        "gene": "OR7D4",
        "species": "human"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tree_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Gene tree stable ID"
            },
            "newick": {
              "type": [
                "string",
                "null"
              ],
              "description": "The whole tree in Newick form, with branch lengths. Ensembl serves it only as a separate plain-text response, so it is a second request; it was previously asked for with a `Content-Type` request header instead of `Accept`, which describes a request body rather than the format wanted back, so this was null on every call. Its LEAVES are protein accessions (ENSSSCP...), not the gene ids in 'members' - match them through members[].protein_ids. Null only if the second request fails."
            },
            "rooted": {
              "type": [
                "boolean",
                "integer",
                "null"
              ],
              "description": "Whether tree is rooted (may be 0/1 integer or boolean)"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "branch_length": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Length of the branch leading to this leaf, e.g. 0.030995. A gene tree without branch lengths is a list of names; every node in Ensembl's response carries one and the flattening dropped them all."
                  },
                  "common_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Common name of the species, e.g. 'Pig'."
                  },
                  "taxon_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "NCBI taxonomy id of the species, e.g. 9823. What joins the leaf to any other species-keyed dataset."
                  },
                  "protein_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Protein accessions for the leaf, e.g. ['ENSSSCP00000014538']. These are the labels used in 'newick', so they are what lets the flat member list and the tree be read together."
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Genomic location of the gene, e.g. '2:68622806-68623744'."
                  },
                  "species": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Species name"
                  },
                  "gene_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl gene id of the tree member, e.g. 'ENSSSCG00000058680'. The leaf label is a protein or species name; this is the gene it belongs to."
                  }
                }
              },
              "description": "Paged gene tree members (gene_id, species)"
            },
            "total_members": {
              "type": "integer",
              "description": "Total members in the gene tree"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EnsemblCompara_get_cafe_tree",
    "description": "Retrieve an Ensembl Compara CAFE gene-family gain/loss tree. Nodes are recoverably paginated with limit/offset and a complete total_nodes count; continue with data.next_offset while data.has_more is true. The recursive collector has no hidden cap.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_tree_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ensembl gene tree (family) stable ID, e.g. 'ENSGT00390000003602'. Use this OR 'gene'."
        },
        "gene": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gene symbol (e.g. 'BRCA2') or Ensembl gene ID (e.g. 'ENSG00000139618'). The CAFE tree for the family containing this gene is returned. Use this OR 'gene_tree_id'."
        },
        "species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Species for symbol lookup when 'gene' is a symbol (default: 'human'). Examples: 'human', 'mouse', 'homo_sapiens'."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum CAFE nodes per page (default 200).",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based node offset. Continue with data.next_offset.",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "fields": {
      "endpoint": "cafe_tree"
    },
    "type": "EnsemblComparaTool",
    "test_examples": [
      {
        "gene_tree_id": "ENSGT00390000003602"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "rooted": {
              "type": [
                "integer",
                "boolean",
                "null"
              ]
            },
            "pvalue_avg": {
              "type": [
                "number",
                "null"
              ]
            },
            "lambda": {
              "type": [
                "number",
                "null"
              ]
            },
            "root_n_members": {
              "type": [
                "integer",
                "number",
                "null"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scientific_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "taxon_id": {
                    "type": [
                      "integer",
                      "number",
                      "null"
                    ]
                  },
                  "n_members": {
                    "type": [
                      "integer",
                      "number",
                      "null"
                    ]
                  },
                  "pvalue": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "p_value_lim": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lambda": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "total_nodes": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
