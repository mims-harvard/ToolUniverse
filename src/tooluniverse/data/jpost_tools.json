[
  {
    "type": "JPOSTTool",
    "name": "jPOST_search_datasets",
    "description": "Search the jPOST (Japan ProteOme STandard Repository, jPOSTrepo) mass-spectrometry proteomics data repository for datasets by keyword and/or species. jPOST is a ProteomeXchange-member repository. Returns a list of dataset summaries with the jPOST accession (JPSTxxxxxx), the cross-referenced ProteomeXchange accession (PXDxxxxxx), title, description, species, instruments, post-translational modifications, keywords, publications, and submitter contacts. No API key required.",
    "parameter": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "Free-text keyword to search dataset titles, descriptions, and keywords (e.g. 'phosphorylation', 'alzheimer', 'thymocytes'). Optional; omit to browse all datasets."
        },
        "species": {
          "type": "string",
          "description": "Filter by species using the NCBI taxonomy scientific name exactly as stored (e.g. 'Homo sapiens', 'Mus musculus'). Note: numeric NCBI taxonomy IDs are NOT accepted here. Optional."
        },
        "page_size": {
          "type": "integer",
          "description": "Number of datasets to return per page (1-100). Default 10.",
          "default": 10
        },
        "page_number": {
          "type": "integer",
          "description": "1-based page number. Page 1 is the first page; values below 1 are clamped to 1. Default 1.",
          "default": 1
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "search_datasets"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["success"]
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "jpost_id": {
                    "type": ["string", "null"]
                  },
                  "px_id": {
                    "type": ["string", "null"]
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "species": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "instruments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "modifications": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "publications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pubmed_id": {
                          "type": ["string", "null"]
                        },
                        "doi": {
                          "type": ["string", "null"]
                        }
                      }
                    }
                  },
                  "contacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": ["string", "null"]
                        },
                        "affiliation": {
                          "type": ["string", "null"]
                        },
                        "role": {
                          "type": ["string", "null"]
                        }
                      }
                    }
                  },
                  "ftp_link": {
                    "type": ["string", "null"]
                  }
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "required": ["status", "data"]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["error"]
            },
            "error": {
              "type": "string"
            }
          },
          "required": ["status", "error"]
        }
      ]
    },
    "test_examples": [
      {
        "keyword": "phosphorylation",
        "page_size": 5
      },
      {
        "species": "Homo sapiens",
        "page_size": 3
      }
    ]
  },
  {
    "type": "JPOSTTool",
    "name": "jPOST_get_dataset",
    "description": "Retrieve full metadata for a single jPOST proteomics dataset by its jPOST accession (e.g. 'JPST000004'). Returns title, description, species, instruments, post-translational modifications, keywords, publications, submitter contacts, the cross-referenced ProteomeXchange (PXDxxxxxx) accession, and the dataset FTP location. Only jPOST accessions (JPSTxxxxxx) are accepted; ProteomeXchange (PXD) accessions are rejected with guidance to search by keyword instead. No API key required.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "jPOST dataset accession, e.g. 'JPST000004'. Must be a jPOST (JPSTxxxxxx) identifier, not a ProteomeXchange (PXD) identifier."
        }
      },
      "required": ["accession"]
    },
    "fields": {
      "endpoint_type": "get_dataset"
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["success"]
            },
            "data": {
              "type": "object",
              "properties": {
                "jpost_id": {
                  "type": ["string", "null"]
                },
                "px_id": {
                  "type": ["string", "null"]
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "species": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "instruments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "modifications": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "publications": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pubmed_id": {
                        "type": ["string", "null"]
                      },
                      "doi": {
                        "type": ["string", "null"]
                      }
                    }
                  }
                },
                "contacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": ["string", "null"]
                      },
                      "affiliation": {
                        "type": ["string", "null"]
                      },
                      "role": {
                        "type": ["string", "null"]
                      }
                    }
                  }
                },
                "ftp_link": {
                  "type": ["string", "null"]
                }
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "required": ["status", "data"]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["error"]
            },
            "error": {
              "type": "string"
            }
          },
          "required": ["status", "error"]
        }
      ]
    },
    "test_examples": [
      {
        "accession": "JPST000004"
      },
      {
        "accession": "JPST000031"
      }
    ]
  }
]
