[
  {
    "name": "LINCS_search_signatures",
    "description": "Search LINCS SigCom drug perturbation signatures with offset pagination and pages up to 1000 records. The service has no count endpoint, so this tool uses a one-record lookahead to report reliable has_more and next_offset without presenting the current page length as a total. Returns signature IDs, doses, time points, cell lines, tissues, and disease context.",
    "parameter": {
      "type": "object",
      "properties": {
        "drug_name": {
          "type": "string",
          "description": "Drug or perturbagen name to search for. Case-sensitive, use lowercase for best results. Examples: 'vorinostat', 'imatinib', 'dexamethasone', 'trichostatin-a'."
        },
        "cell_line": {
          "type": "string",
          "description": "Optional cell line filter. Examples: 'MCF7', 'A549', 'HepG2', 'PC3'. Leave empty to search all cell lines."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Signatures per page (1-1000, default 20)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based signature offset (default 0). Continue with metadata.next_offset."
        }
      },
      "required": [
        "drug_name"
      ]
    },
    "fields": {
      "endpoint_type": "search_signatures"
    },
    "type": "LINCSSignatureTool",
    "test_examples": [
      {
        "drug_name": "vorinostat",
        "limit": 5
      },
      {
        "drug_name": "imatinib",
        "limit": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "description": "One row per matching L1000 signature.",
      "items": {
        "type": "object",
        "properties": {
          "signature_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "SigCom LINCS signature uuid."
          },
          "drug_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Perturbagen name."
          },
          "cell_line": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cell line the perturbation was applied to."
          },
          "dose": {
            "type": [
              "string",
              "null"
            ],
            "description": "Perturbation dose as recorded, e.g. '10uM'."
          },
          "time_point": {
            "type": [
              "string",
              "null"
            ],
            "description": "Perturbation duration, e.g. '6H'."
          },
          "perturbation_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. trt_cp for a compound treatment."
          },
          "tissue": {
            "type": [
              "string",
              "null"
            ]
          },
          "disease": {
            "type": [
              "string",
              "null"
            ]
          },
          "anatomy": {
            "type": [
              "string",
              "null"
            ]
          },
          "pubchem_id": {
            "type": [
              "integer",
              "null",
              "string"
            ],
            "description": "PubChem CID of the perturbagen."
          },
          "library_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "SigCom library the signature belongs to."
          },
          "cmap_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "CMap identifier, which joins this signature to the rest of the LINCS ecosystem, e.g. 'CPC006_TYKNU_6H:BRD-A35108200-001-04-7:10'."
          },
          "local_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "SigCom's own local identifier."
          },
          "disease_ontology_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Disease Ontology id, where the signature carries one."
          },
          "data_level": {
            "type": [
              "integer",
              "null"
            ],
            "description": "LINCS processing level; 5 is a differential expression signature."
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Release version of the signature."
          },
          "created": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the signature file was created."
          },
          "data_file": {
            "type": "object",
            "description": "Where the signature's data is and how to verify it. The search returned the signature's annotations -- drug, cell line, dose, time -- and nothing that led to the signature itself, so a caller could not fetch the differential expression it describes.",
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Resolvable URL to the signature file, an https://lincs-dcic.s3.amazonaws.com/... .tsv."
              },
              "filename": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "File name as published."
              },
              "size_in_bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "uncompressed_size_in_bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Checksum, so a caller can verify what arrived."
              },
              "md5": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "LINCS_list_libraries",
    "description": "List and optionally keyword-filter the complete LINCS SigCom library catalog. Filtering is applied to the full catalog before exact local offset pagination; metadata reports total_libraries, exact total_matches, has_more, and next_offset.",
    "parameter": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "Optional keyword to filter libraries (case-insensitive). Examples: 'L1000', 'kinase', 'proteomics', 'RNA-seq', 'CRISPR'. Leave empty to list all."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Libraries per page (1-1000, default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset into the filtered library list. Continue with metadata.next_offset."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint_type": "list_libraries"
    },
    "type": "LINCSSignatureTool",
    "test_examples": [
      {
        "keyword": "L1000",
        "limit": 5
      },
      {
        "keyword": "kinase",
        "limit": 5
      }
    ],
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The library's identifier."
          },
          "dataset": {
            "type": [
              "string",
              "null"
            ],
            "description": "The dataset it belongs to."
          },
          "dataset_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "What kind of dataset."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the library contains."
          },
          "assay": {
            "type": [
              "string",
              "null"
            ],
            "description": "The assay used."
          },
          "organism": {
            "type": [
              "string",
              "null"
            ],
            "description": "The organism."
          }
        }
      }
    }
  }
]
