[
  {
    "name": "Nominatim_geocode",
    "description": "Geocode addresses and place names to geographic coordinates using the OpenStreetMap Nominatim service. Converts human-readable addresses, landmarks, or place names into latitude/longitude coordinates. Returns structured address components, bounding box, and place type. No authentication required. Useful for geospatial analysis, mapping, and location-based research.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "description": "Free-form address or place name query. Examples: 'Eiffel Tower Paris', '1600 Pennsylvania Ave Washington DC', 'Big Ben London', 'Mount Everest'"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of results to return (default 5, max 50)"
        },
        "countrycodes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Restrict to specific countries (comma-separated ISO 3166-1 alpha-2 codes). Examples: 'us', 'de,fr', 'gb'"
        }
      },
      "required": [
        "q"
      ]
    },
    "fields": {
      "endpoint": "https://nominatim.openstreetmap.org/search",
      "params": {
        "format": "json",
        "addressdetails": "1",
        "limit": "5"
      },
      "headers": {
        "User-Agent": "ToolUniverse/1.0 +https://github.com/ToolUniverse"
      }
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "Eiffel Tower Paris"
      },
      {
        "q": "Big Ben London",
        "limit": 3
      },
      {
        "q": "Central Park New York City"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of geocoding results",
          "items": {
            "type": "object",
            "properties": {
              "place_id": {
                "type": "integer"
              },
              "lat": {
                "type": "string",
                "description": "Latitude"
              },
              "lon": {
                "type": "string",
                "description": "Longitude"
              },
              "display_name": {
                "type": "string",
                "description": "Full human-readable address"
              },
              "type": {
                "type": "string",
                "description": "Place type"
              },
              "importance": {
                "type": "number",
                "description": "Relevance score 0-1"
              },
              "address": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The address components Nominatim resolved, keyed by OSM place type. Which keys appear depends on the place: a building has house_number and road, a region has none of them",
                "properties": {
                  "amenity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Amenity name, when the match is one"
                  },
                  "house_number": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "House number"
                  },
                  "road": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Street"
                  },
                  "quarter": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Quarter"
                  },
                  "suburb": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Suburb"
                  },
                  "city_district": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "City district"
                  },
                  "city": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "City"
                  },
                  "county": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "County"
                  },
                  "region": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Region"
                  },
                  "state": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "State or province"
                  },
                  "postcode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Postal code"
                  },
                  "country": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Country name"
                  },
                  "country_code": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ISO 3166-1 alpha-2 country code"
                  },
                  "man_made": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Man-made feature name, when the match is one"
                  },
                  "ISO3166-2-lvl4": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ISO 3166-2 subdivision code at level 4"
                  },
                  "ISO3166-2-lvl6": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ISO 3166-2 subdivision code at level 6"
                  }
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "boundingbox": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Bounding box [south, north, west, east]"
              },
              "licence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The data licence and required attribution: 'Data (c) OpenStreetMap contributors, ODbL 1.0'. ODbL requires attribution, so a caller redistributing this result needs it"
              },
              "osm_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "OSM object type - node, way or relation - which with osm_id identifies the object in OpenStreetMap"
              },
              "osm_id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "OSM object id; the pair (osm_type, osm_id) is the key to the OSM object, where place_id is a Nominatim-internal number that changes between imports"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The place's own name, as against the full display_name"
              },
              "class": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "OSM class of the match, e.g. amenity, highway, boundary"
              },
              "addresstype": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which address component the match itself is, e.g. amenity, road, city"
              },
              "place_rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Nominatim's rank for the match, 0 (continent) to 30 (building); how specific the result is"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Nominatim_reverse_geocode",
    "description": "Reverse geocode latitude/longitude coordinates to a human-readable address using OpenStreetMap Nominatim. Converts geographic coordinates into structured address information including street, city, country. No authentication required.",
    "parameter": {
