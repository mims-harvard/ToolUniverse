                                            "null"
                                        ]
                                    },
                                    "group_name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "matched_term": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                }
