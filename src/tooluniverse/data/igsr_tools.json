                  "title": {
                    "type": "string"
                  },
                  "short_title": {
                    "type": "string"
                  },
                  "sample_count": {
                    "type": "integer"
                  },
                  "population_count": {
                    "type": "integer"
                  },
                  "data_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "website": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
