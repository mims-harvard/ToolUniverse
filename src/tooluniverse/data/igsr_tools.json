[
  {
    "name": "IGSR_search_populations",
    "type": "IGSRTool",
    "description": "Search 1000 Genomes Project populations from IGSR. Results are recoverably paginated: start with offset=0 and continue with next_offset while has_more is true. Pagination is applied after the superpopulation filter. Returns population codes, names, coordinates, sample counts, and superpopulation assignments.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_populations"
          ],
          "default": "search_populations",
          "description": "Operation type (fixed: search_populations)."
        },
        "superpopulation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by superpopulation code: AFR (African), AMR (Admixed American), EAS (East Asian), EUR (European), SAS (South Asian). Leave empty for all."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free-text search query to find populations by name or description (e.g., 'Chinese', 'Yoruba', 'British')."
        },
        "limit": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 500,
          "description": "Results per page (1-500). The IGSR server's real maximum is 500; invalid values return an error rather than being silently clamped."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based result offset. Continue with next_offset while has_more is true."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "description": "Total number of matching records in IGSR, independent of the `limit` page size."
            },
            "returned": {
              "type": "integer",
              "description": "Number of records included in this response (at most `limit`)."
            },
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "populations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "sample_count": {
                    "type": "integer"
                  },
                  "superpopulation_code": {
                    "type": "string"
                  },
                  "superpopulation_name": {
                    "type": "string"
                  },
                  "latitude": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "longitude": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "search_populations",
        "superpopulation": "EAS",
        "limit": 10
      },
      {
        "operation": "search_populations",
        "limit": 5
      }
    ],
    "fields": {
      "operation": "search_populations"
    }
  },
  {
    "name": "IGSR_search_samples",
    "type": "IGSRTool",
    "description": "Search samples from the 1000 Genomes Project by population, data collection, or sample name. Results are recoverably paginated: start with offset=0 and continue with next_offset while has_more is true. Returns sample names, sex, BioSample IDs, population assignments, and available data collections.",
    "parameter": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "search_samples"
          ],
          "default": "search_samples",
          "description": "Operation type (fixed: search_samples)."
        },
        "population": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by population code (e.g., 'CHB', 'YRI', 'GBR', 'CEU'). Use IGSR_search_populations to find valid codes."
        },
        "data_collection": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filter by data collection title (e.g., '1000 Genomes 30x on GRCh38', '1000 Genomes on GRCh38')."
        },
        "sample_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Look up specific sample by name (e.g., 'HG00096', 'NA12878')."
        },
        "limit": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 500,
          "description": "Results per page (1-500). The IGSR server's real maximum is 500; invalid values return an error rather than being silently clamped."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based result offset. Continue with next_offset while has_more is true."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "description": "Total number of matching records in IGSR, independent of the `limit` page size."
            },
            "returned": {
              "type": "integer",
              "description": "Number of records included in this response (at most `limit`)."
            },
            "offset": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "sex": {
                    "type": "string"
                  },
                  "biosample_id": {
                    "type": "string"
                  },
                  "populations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "superpopulation": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "data_collections": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "operation": "search_samples",
        "population": "GBR",
        "limit": 5
      },
      {
        "operation": "search_samples",
        "sample_name": "NA12878",
        "limit": 1
      }
    ],
    "fields": {
      "operation": "search_samples"
    }
  },
  {
    "name": "IGSR_list_data_collections",
