[
  {
    "name": "Ensembl_get_region_features",
    "description": "Get genomic features overlapping a specified chromosomal region, including genes, transcripts, regulatory elements, and constrained elements. Results are paged with limit/offset; total_features and next_offset make every upstream feature reachable.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "string",
          "description": "Species name. Default: 'human'. Examples: 'human', 'mouse', 'rat', 'zebrafish'."
        },
        "region": {
          "type": "string",
          "description": "Genomic region in format 'chr:start-end'. Examples: '17:7661779-7687546' (TP53), '7:140424943-140524564' (BRAF), '13:32315086-32400266' (BRCA2). Max region size ~5Mb."
        },
        "feature_types": {
          "type": "string",
          "description": "Comma-separated feature types to retrieve. Options: 'gene', 'transcript', 'regulatory', 'constrained', 'variation', 'repeat', 'motif'. Default: 'gene'. Example: 'gene,regulatory,constrained'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "Maximum overlapping features per page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based feature offset. Continue with data.next_offset while has_more is true."
        }
      },
      "required": [
        "region"
      ]
    },
    "fields": {
      "endpoint": "region"
    },
    "type": "EnsemblOverlapTool",
    "test_examples": [
      {
        "species": "human",
        "region": "7:140424943-140524564",
        "feature_types": "gene,regulatory,constrained"
      },
      {
        "species": "human",
        "region": "17:7661779-7687546",
        "feature_types": "gene,regulatory"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "region": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "total_features": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "feature_type": {
                    "type": "string"
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  },
                  "strand": {
                    "type": "integer"
                  },
                  "biotype": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "external_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "seq_region_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Sequence region (chromosome) the feature is on, e.g. '7' -- no 'chr' prefix."
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Annotation source that called the feature, e.g. 'havana' (manual) versus 'ensembl' (automatic) or 'ensembl_havana' (both). Present on 25 of the 100 features measured, so its absence does not mean the feature is unsourced."
                  }
                }
              }
            },
            "type_summary": {
              "type": "object",
              "description": "Count of features by type"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Ensembl_get_gene_overlapping_features",
    "description": "Get features overlapping an Ensembl gene ID with limit/offset pagination and explicit total/has_more metadata. Returns neighboring genes, transcripts, exons, regulatory elements, constrained elements, variants, and repeats selected by feature_types. Complex loci can contain thousands of records; follow next_offset until has_more is false.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "Ensembl gene ID. Examples: 'ENSG00000141510' (TP53), 'ENSG00000012048' (BRCA1), 'ENSG00000157764' (BRAF)."
        },
        "feature_types": {
          "type": "string",
          "description": "Comma-separated feature types. Options include 'gene', 'transcript', 'exon', 'cds', 'regulatory', 'constrained', 'variation', and 'repeat'. Default: 'gene'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "description": "Maximum number of overlapping features to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based feature offset. Use data.next_offset or metadata.next_offset for the next page."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint": "gene_id"
    },
    "type": "EnsemblOverlapTool",
    "test_examples": [
      {
        "gene_id": "ENSG00000141510",
        "feature_types": "gene"
      },
      {
        "gene_id": "ENSG00000141510",
        "feature_types": "transcript"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "gene_id": {
              "type": "string"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "feature_type": {
                    "type": "string"
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  },
                  "biotype": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "external_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "transcript_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The feature's description as Ensembl stores it, including its source, e.g. 'tumor protein p53 [Source:HGNC Symbol;Acc:HGNC:11998]'. The bracketed part names the authority for the symbol."
                  },
                  "seq_region_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Sequence region (chromosome) the feature is on, e.g. '17' -- no 'chr' prefix."
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Annotation source that called the feature, e.g. 'ensembl_havana' (both automatic and manual agree), versus 'ensembl' or 'havana' alone."
                  },
                  "strand": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Strand as 1 or -1, e.g. -1. Ensembl uses integers here, not '+'/'-'."
                  }
                }
              }
            },
            "type_summary": {
              "type": "object"
            },
            "has_more": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when further features remain past this page. The field that distinguishes a complete answer from a first page."
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The limit that was applied, e.g. 100."
            },
            "offset": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The offset this page started at, e.g. 0."
            },
            "returned": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many features this reply actually contains, e.g. 2."
            },
            "total_features": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many overlapping features exist in total, e.g. 2 -- before any limit was applied. Compare with `returned` to know whether you have them all."
            },
            "truncated": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when the reply was cut to fit the limit, e.g. false. If true, the feature list is not the full overlap set."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
