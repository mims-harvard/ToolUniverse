[
  {
    "name": "Planteome_search_terms",
    "type": "PlanteomeTool",
    "description": "Search Planteome (a Global Core Biodata Resource) for plant ontology terms by keyword, across the Plant Ontology, Plant Trait Ontology, Plant Stress Ontology, and crop-specific ontologies together. Example: query='pollen' returns terms like 'pollen development' (GO:0009555) and crop-specific pollen traits. Complements ToolUniverse's generic GO tools (OLS/QuickGO), which don't carry plant-specific trait/structure ontologies.",
    "fields": {
      "operation": "search_terms"
    },
    "parameter": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "description": "Keyword or phrase, e.g. 'pollen development'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Max terms to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_class_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_obsolete": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "True when the term has been retired. Obsolete terms are returned by search alongside current ones."
              },
              "synonym": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Other names for the term. Measured on 2 of 5 hits, and what explains a hit whose label does not match the query."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "pollen development",
        "limit": 5
      },
      {
        "query": "drought stress",
        "limit": 5
      }
    ]
  },
  {
    "name": "Planteome_get_term",
    "type": "PlanteomeTool",
    "description": "Get a single Planteome ontology term by its accession ID (from Planteome_search_terms or Planteome_search_annotations results). Example: term_id='GO:0009555' returns the full definition of 'pollen development'.",
    "fields": {
      "operation": "get_term"
    },
    "parameter": {
      "type": "object",
      "required": [
        "term_id"
      ],
      "properties": {
        "term_id": {
          "type": "string",
          "description": "Ontology term accession, e.g. 'GO:0009555' or 'PO:0025281'."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "annotation_class_label": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_obsolete": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True when the term has been retired. An obsolete term still answers a lookup and must not be used for new annotation."
            },
            "synonym": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "description": "Other names for the term, e.g. ['formation of generative and vegetative cells', ...] - 5 on the measured term."
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "term_id": "GO:0009555"
      },
      {
        "term_id": "PO:0025281"
      }
    ]
  },
  {
    "name": "Planteome_search_annotations",
    "type": "PlanteomeTool",
    "description": "Search Planteome's gene-to-ontology-term annotation index by gene id or accession. Resolves a plant gene to every ontology term (GO/PO/TO/crop ontologies) it has been annotated with, across evidence types and source databases. Example: query='AT4G32150' (Arabidopsis VAMP711) returns its GO annotations including 'vesicle-mediated transport'.",
    "fields": {
      "operation": "search_annotations"
    },
    "parameter": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene id or accession, e.g. 'AT4G32150'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Max annotations to return, 1-100. Default 20."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bioentity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bioentity_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_class": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "annotation_class_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "taxon_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bioentity_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The gene's full name where Planteome records one"
              },
              "synonym": {
                "type": [
                  "array",
                  "string",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Other identifiers and names for the gene, which is how a hit found under one id is matched to another source"
              },
              "aspect": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Ontology aspect: P (biological process), F (molecular function), C (cellular component)"
              },
              "taxon": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "NCBITaxon id behind taxon_label, e.g. NCBITaxon:3702"
              },
              "evidence_type": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Three-letter evidence code, e.g. IEA, IDA, IMP"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The ECO term for the evidence code, e.g. ECO:0000501"
              },
              "evidence_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The ECO term's label, e.g. 'evidence used in automatic assertion'"
              },
              "evidence_with": {
                "type": [
                  "array",
                  "string",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "What the annotation was inferred from, e.g. InterPro:IPR001388 -- what makes a computed (IEA) annotation checkable"
              },
              "assigned_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The source database that made the annotation, e.g. InterPro, TAIR. The description promises annotations across source databases; this names the source."
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The gene identifier's namespace, e.g. AGI_LocusCode"
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "When the annotation was made, YYYYMMDD"
              },
              "reference": {
                "type": [
                  "array",
                  "string",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Supporting references, e.g. TAIR:AnalysisReference:501756966, PMID:..."
              }
            },
            "description": "One annotation. Planteome's Solr documents also carry ancestor expansions (taxon_closure, isa_partof_closure, evidence_closure and their label variants); those restate the term's own hierarchy and are deliberately not returned."
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "AT4G32150",
        "limit": 5
      },
      {
        "query": "AT1G01010",
        "limit": 5
      }
    ]
  }
]
