[
  {
    "type": "DBLPTool",
    "name": "DBLP_search_publications",
    "description": "Search DBLP publications with offset pagination while preserving the historical list return type. Every paper contains search_pagination with total_matches, accessible_results, upstream_truncated, has_more, and next_offset. DBLP may compute only a ranked subset of broad matches, so refine the query when upstream_truncated is true. Fields DBLP does not provide (abstract, citations, open-access status, keywords) are null/empty and explicitly listed in unavailable_fields rather than fabricated as zero, false, or placeholder text. NOTE: dblp.org currently serves an anti-bot challenge page (\"Making sure you're not a bot!\") on this endpoint, so this tool can return an HTML-instead-of-data error; ToolUniverse does not attempt to bypass it. Alternatives: Crossref_search_works, SemanticScholar_search_papers, openalex_search_works.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for DBLP publications. Use keywords separated by spaces to refine your search."
        },
        "limit": {
          "type": "integer",
          "description": "Page size (1-1000), matching DBLP's documented h limit.",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based first hit (DBLP f parameter). Continue with each paper's search_pagination.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always null because DBLP search does not provide abstracts."
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "@pid": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "year": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "ee": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "citations": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Null because DBLP search does not provide citation counts."
          },
          "open_access": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Null because DBLP search does not provide an open-access classification."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "article_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Normalized from DBLP's actual publication type; never hard-coded."
          },
          "publication_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact DBLP publication type label."
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "unavailable_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_pagination": {
            "type": "object",
            "properties": {
              "total_matches": {
                "type": "integer"
              },
              "accessible_results": {
                "type": "integer"
              },
              "upstream_truncated": {
                "type": "boolean"
              },
              "returned": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "requested_offset": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_offset": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean"
              },
              "warning": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "data_quality": {
            "type": "object",
            "properties": {
              "has_abstract": {
                "type": "boolean"
              },
              "has_authors": {
                "type": "boolean"
              },
              "has_journal": {
                "type": "boolean"
              },
              "has_year": {
                "type": "boolean"
              },
              "has_doi": {
                "type": "boolean"
              },
              "has_citations": {
                "type": "boolean"
              },
              "has_open_access_status": {
                "type": "boolean"
              },
              "has_keywords": {
                "type": "boolean"
              },
              "has_url": {
                "type": "boolean"
              },
              "has_publication_type": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "test_examples": [
      {
        "query": "computer science",
        "limit": 2
      },
      {
        "query": "machine learning",
        "limit": 1,
        "offset": 1
      }
    ]
  },
  {
    "name": "DBLP_search_authors",
    "description": "Search and disambiguate DBLP authors by name with offset pagination. Each response includes metadata.total_matches, accessible_results, upstream_truncated, has_more, and next_offset; follow next_offset within the computed DBLP window and refine broad queries when upstream_truncated is true. Hits resolve names to canonical PID URLs and may include affiliations, aliases, or awards. NOTE: dblp.org currently serves an anti-bot challenge page (\"Making sure you're not a bot!\") on this endpoint, so this tool can return an HTML-instead-of-data error; ToolUniverse does not attempt to bypass it.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Author name to search for (e.g., 'jure leskovec', 'yann lecun', 'Geoffrey Hinton'). Spaces are treated as prefix-matched terms by DBLP."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of author hits to return (default 10, max 1000).",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based first hit (DBLP f parameter). Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://dblp.org/search/author/api",
      "param_mapping": {
        "query": "q",
        "limit": "h",
        "offset": "f"
      },
      "pagination": "dblp_offset",
      "params": {
        "format": "json"
      }
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "query": "jure leskovec",
        "limit": 1
      },
      {
        "query": "yann lecun",
        "limit": 3,
        "offset": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "DBLP author search response",
          "properties": {
            "result": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "status": {
                  "type": "object"
                },
                "hits": {
                  "type": "object",
                  "description": "Matched author records",
                  "properties": {
                    "@total": {
                      "type": "string"
                    },
                    "@computed": {
                      "type": "string"
                    },
                    "@sent": {
                      "type": "string"
                    },
                    "@first": {
                      "type": "string"
                    },
                    "hit": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        {
                          "type": "object"
                        }
                      ],
                      "description": "Author hits; a single hit may be returned as an object by DBLP. Each hit contains @id, @score, and info with author name, PID URL, and optional aliases or notes."
                    }
                  }
                }
              },
              "required": [
                "hits"
              ]
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "DBLP_search_venues",
    "description": "Search DBLP venues by acronym or full name with offset pagination. Each response includes metadata.total_matches, accessible_results, upstream_truncated, has_more, and next_offset; follow next_offset within the computed DBLP window and refine broad queries when upstream_truncated is true. Hits contain canonical venue names, acronyms, type, and DBLP URLs. NOTE: dblp.org currently serves an anti-bot challenge page (\"Making sure you're not a bot!\") on this endpoint, so this tool can return an HTML-instead-of-data error; ToolUniverse does not attempt to bypass it.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Venue acronym or name to search for (e.g., 'ICML', 'neurips', 'VLDB', 'Nature Machine Intelligence')."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of venue hits to return (default 10, max 1000).",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based first hit (DBLP f parameter). Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "https://dblp.org/search/venue/api",
      "param_mapping": {
        "query": "q",
        "limit": "h",
        "offset": "f"
      },
      "pagination": "dblp_offset",
      "params": {
        "format": "json"
      }
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "query": "ICML",
        "limit": 1
      },
      {
        "query": "neurips",
        "limit": 1,
        "offset": 1
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "DBLP venue search response",
          "properties": {
            "result": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "status": {
                  "type": "object"
                },
                "hits": {
                  "type": "object",
                  "description": "Matched venue records",
                  "properties": {
                    "@total": {
                      "type": "string"
                    },
                    "@computed": {
                      "type": "string"
                    },
                    "@sent": {
                      "type": "string"
                    },
                    "@first": {
                      "type": "string"
                    },
                    "hit": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        {
                          "type": "object"
                        }
                      ],
                      "description": "Venue hits; a single hit may be returned as an object by DBLP. Each hit contains @id, @score, and info with venue name, optional acronym/type, and URL."
                    }
                  }
                }
              },
              "required": [
                "hits"
              ]
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
