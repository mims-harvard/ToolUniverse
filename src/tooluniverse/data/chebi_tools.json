[
  {
    "name": "ChEBI_get_compound",
    "description": "Get detailed chemical information from ChEBI, including paginated synonyms, brand names, and systematic names. Use synonym_offset/synonym_limit and inspect synonyms_total, synonyms_truncated, and next_synonym_offset; common drugs can have dozens of names.",
    "parameter": {
      "type": "object",
      "properties": {
        "chebi_id": {
          "type": [
            "integer",
            "string"
          ],
          "description": "ChEBI identifier as a bare integer (e.g. 15365) or the 'CHEBI:15365' CURIE form returned by ChEBI_search. Examples: 15365 (aspirin), 17234 (glucose)."
        },
        "synonym_offset": {
          "type": "integer",
          "description": "Zero-based offset in the deduplicated name list.",
          "default": 0,
          "minimum": 0
        },
        "synonym_limit": {
          "type": "integer",
          "description": "Names returned per page (default 20, maximum 500).",
          "default": 20,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "chebi_id"
      ]
    },
    "fields": {
      "endpoint_type": "get_compound"
    },
    "type": "ChEBITool",
    "test_examples": [
      {
        "chebi_id": 15365
      },
      {
        "chebi_id": 17234
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "chebi_id": {
              "type": "integer"
            },
            "chebi_accession": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "definition": {
              "type": [
                "string",
                "null"
              ]
            },
            "stars": {
              "type": "integer"
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "mass": {
              "type": [
                "number",
                "null"
              ]
            },
            "monoisotopic_mass": {
              "type": [
                "number",
                "null"
              ]
            },
            "charge": {
              "type": [
                "integer",
                "null"
              ]
            },
            "smiles": {
              "type": [
                "string",
                "null"
              ]
            },
            "inchikey": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "synonyms_total": {"type": "integer"},
            "synonym_offset": {"type": "integer"},
            "synonyms_returned": {"type": "integer"},
            "synonyms_truncated": {"type": "boolean"},
            "next_synonym_offset": {"type": ["integer", "null"]}
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ChEBI_search",
    "description": "Search the ChEBI database for chemical entities by name, formula, or keyword. Uses Elasticsearch-powered full-text search across compound names, synonyms, definitions, and formulas. Returns matching compounds with IDs, names, formulas, and masses. The underlying API paginates at 15 hits per page; this wrapper maps limit/offset onto those pages and reports total_matches plus next_offset so all results remain reachable. Note: use ChEBI_get_compound for structural data.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query string - compound name, synonym, formula, or keyword. Examples: 'glucose', 'caffeine', 'C9H8O4' (aspirin formula), 'kinase inhibitor'."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of compounds to return. Default: 10. Max: 100. Values above 15 are served by fetching additional API pages, so they cost extra requests."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based result offset. Continue with data.next_offset while has_more is true."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "search"
    },
    "type": "ChEBITool",
    "test_examples": [
      {
        "query": "caffeine",
        "limit": 5
      },
      {
        "query": "glucose",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "result_count": {
              "type": "integer",
              "description": "Number of compounds actually returned in 'compounds' (at most 'limit')."
            },
            "total_matches": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total number of compounds in ChEBI matching the query, which may be far larger than result_count. Null when the API does not report a count. Compare against result_count to tell '10 returned of 116 matching' from 'only 10 exist'."
            },
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "truncated": {"type": "boolean"},
            "next_offset": {"type": ["integer", "null"]},
            "compounds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "chebi_accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "formula": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mass": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "stars": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ChEBI_get_ontology_children",
    "description": "Get the ontology children (is-a, has-part, has-functional-parent, etc.) of a ChEBI compound. ChEBI uses a rich ontology with relationships like 'is a', 'has part', 'has role', 'has functional parent', and 'is conjugate base/acid of'. This enables navigation of the chemical classification hierarchy. Example: CHEBI:15365 (aspirin) children include NCX-4040 (has functional parent), acetylsalicylate (conjugate base), and Yosprala (has part).",
    "parameter": {
      "type": "object",
      "properties": {
        "chebi_id": {
          "type": [
            "integer",
            "string"
          ],
          "description": "ChEBI numeric identifier (with or without the 'CHEBI:' prefix). Examples: 15365 (aspirin), 17234 (glucose), 16236 (ethanol)."
        }
      },
      "required": [
        "chebi_id"
      ]
    },
    "fields": {
      "endpoint_type": "ontology_children"
    },
    "type": "ChEBITool",
    "test_examples": [
      {
        "chebi_id": 15365
      },
      {
        "chebi_id": 17234
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "chebi_id": {
              "type": "integer"
            },
            "chebi_accession": {
              "type": "string"
            },
            "relation_count": {
              "type": "integer"
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "child_id": {
                    "type": "integer"
                  },
                  "child_name": {
                    "type": "string"
                  },
                  "relation_type": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "integer"
                  },
                  "parent_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ChEBI_get_ontology_parents",
    "description": "Get the ontology parents (is-a / has-role ancestors) of a ChEBI compound, navigating UPWARD in the chemical classification hierarchy (the symmetric counterpart of ChEBI_get_ontology_children). ChEBI uses a rich ontology with relationships like 'is a', 'has role', 'has functional parent', and 'is conjugate base/acid of'. Example: CHEBI:15377 (water) parents include 'mononuclear parent hydride' and 'inorganic hydroxy compound' (is a), and 'human metabolite', 'amphiprotic solvent' (has role).",
    "parameter": {
      "type": "object",
      "properties": {
        "chebi_id": {
          "type": [
            "integer",
            "string"
          ],
          "description": "ChEBI numeric identifier (with or without the 'CHEBI:' prefix). Examples: 15377 (water), 15365 (aspirin), 17234 (glucose)."
        }
      },
      "required": [
        "chebi_id"
      ]
    },
    "fields": {
      "endpoint_type": "ontology_parents"
    },
    "type": "ChEBITool",
    "test_examples": [
      {
        "chebi_id": 15377
      },
      {
        "chebi_id": 15365
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "chebi_id": {
              "type": "integer"
            },
            "chebi_accession": {
              "type": "string"
            },
            "relation_count": {
              "type": "integer"
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relation_type": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "integer"
                  },
                  "parent_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
