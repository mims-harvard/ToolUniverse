  {
    "name": "GBIF_parse_name",
    "description": "Parse one or more scientific name strings into structured components using the GBIF name parser. Returns the canonical name (no authorship), genus, specific/infraspecific epithet, authorship, bracket (basionym) authorship, year and rank marker for each input. Useful for normalizing messy or authored names before matching. No taxonKey needed; this is pure string parsing. No API key required. Example: name='Panthera leo (Linnaeus, 1758)' -> canonicalName 'Panthera leo', genusOrAbove 'Panthera', specificEpithet 'leo', bracketAuthorship 'Linnaeus'.",
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "A single scientific name string to parse, e.g. 'Panthera leo (Linnaeus, 1758)'. Provide either 'name' or 'names'."
        },
        "names": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "A list of scientific name strings to parse in one call, e.g. ['Homo sapiens Linnaeus, 1758', 'Quercus robur L.']. Provide either 'name' or 'names'."
        }
      },
      "required": []
    },
    "fields": {
      "operation": "parse_name",
      "base_url": "https://api.gbif.org/v1"
    },
    "type": "GBIFTaxonomyTool",
    "test_examples": [
      {
        "name": "Panthera leo (Linnaeus, 1758)"
      },
      {
        "names": [
          "Homo sapiens Linnaeus, 1758",
          "Quercus robur L."
        ]
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scientificName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "canonicalName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "genusOrAbove": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "specificEpithet": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "infraSpecificEpithet": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authorship": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bracketAuthorship": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "year": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rankMarker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parsed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "canonicalNameComplete": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The parsed name with its authorship, e.g. 'Panthera leo (Linnaeus, 1758)'. The form a taxonomic citation needs; the canonical name alone drops the author."
              },
              "parsedPartially": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "True when GBIF could parse only part of the string. The result then looks like a clean parse and is not one."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
