  {
    "name": "GBIF_get_vernacular_names",
    "description": "Get de-duplicated vernacular names of a GBIF Backbone taxon, optionally filtered by language. GBIF does not server-filter this endpoint by language, so filtering is applied to each raw page; continue through metadata.next_offset while metadata.has_more is true to avoid missing later names in the requested language.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_key": {
          "type": "integer",
          "description": "GBIF Backbone usageKey of the taxon, e.g. 5219404 (Panthera leo). Obtain from GBIF_match_name or GBIF_search_species."
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ISO 639-3 language code to filter by, e.g. 'eng' (English), 'spa' (Spanish), 'fra' (French). If omitted, returns names in all languages."
        },
        "limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of raw GBIF vernacular-name records to inspect per page."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based raw GBIF result offset. Continue with metadata.next_offset even when a language-filtered page returns no names."
        }
      },
      "required": [
        "taxon_key"
      ]
    },
    "fields": {
      "operation": "get_vernacular_names",
      "base_url": "https://api.gbif.org/v1"
    },
    "type": "GBIFTaxonomyTool",
    "test_examples": [
      {
        "taxon_key": 5219404,
        "language": "eng"
      },
      {
        "taxon_key": 2878688
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vernacularName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "area": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preferred": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Which of a taxon's many common names GBIF marks as the one to show; the rows were otherwise interchangeable"
              },
              "taxonKey": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sourceTaxonKey": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The checklist dataset's taxon the name came from, so a name can be traced to its supplier"
              },
              "sourceReference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
