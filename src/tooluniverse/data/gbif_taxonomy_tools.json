  {
    "name": "GBIF_get_taxon_parents",
    "description": "Get the full ranked ancestor lineage of a GBIF Backbone taxon. Given a taxonKey, returns the ordered list of higher taxa from KINGDOM down to the immediate parent (kingdom, phylum, class, order, family, genus...), each with key, rank and scientificName. Use to walk UP the taxonomic tree / build a classification path. Returns a root-first array. Get a taxonKey from GBIF_match_name or GBIF_search_species. Example: taxon_key=5219404 (Panthera leo) -> Animalia, Chordata, Mammalia, Carnivora, Felidae, Panthera. No API key required.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_key": {
          "type": "integer",
          "description": "GBIF Backbone usageKey of the taxon, e.g. 5219404 (Panthera leo). Obtain from GBIF_match_name or GBIF_search_species."
        }
      },
      "required": [
        "taxon_key"
      ]
    },
    "fields": {
      "operation": "get_parents",
      "base_url": "https://api.gbif.org/v1"
    },
    "type": "GBIFTaxonomyTool",
    "test_examples": [
      {
        "taxon_key": 5219404
      },
      {
        "taxon_key": 2878688
      }
    ],
    "return_schema": {
      "oneOf": [
