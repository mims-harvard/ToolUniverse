[
  {
    "name": "GBIF_get_taxon_children",
    "description": "List direct child taxa of a GBIF Backbone taxon. Results use GBIF offset pagination; when metadata.has_more is true pass metadata.next_offset as offset with the same taxon_key and limit.",
    "parameter": {
      "type": "object",
      "properties": {
        "taxon_key": {
          "type": "integer",
          "description": "GBIF Backbone usageKey of the parent taxon, e.g. 2435194 (genus Panthera). Obtain from GBIF_match_name or GBIF_search_species."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum number of child taxa to return (1-100, default 20).",
          "default": 20
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Zero-based GBIF result offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "taxon_key"
      ]
    },
    "fields": {
      "operation": "get_children",
      "base_url": "https://api.gbif.org/v1"
    },
    "type": "GBIFTaxonomyTool",
    "test_examples": [
      {
        "taxon_key": 2435194,
        "limit": 8
      },
      {
        "taxon_key": 2877951,
        "limit": 5
      }
    ],
