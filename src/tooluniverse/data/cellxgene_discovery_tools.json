[
  {
    "name": "CxGDisc_list_collections",
    "description": "List curated single-cell RNA-seq collections from CZI CellxGene Discovery. Each collection is a published dataset group with DOI, typically corresponding to a paper. Returns the complete (untruncated) collection description, collection name, DOI, dataset count, total cell count, curator info, exact total/returned counts, and explicit pagination fields. Follow next_offset while has_more is true to retrieve later collections.",
    "parameter": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "Maximum number of collections to return (1-100). Default: 20."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based result offset. Default: 0. Use the returned next_offset to retrieve the next slice."
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "list_collections"
    },
    "type": "CellxGeneDiscoveryTool",
    "test_examples": [
      {
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_collections": {
              "type": "integer",
              "description": "Total number of public collections"
            },
            "returned": {
              "type": "integer",
              "description": "Number returned in this response"
            },
            "offset": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "collections": {
              "type": "array",
              "description": "Collection summaries with name, DOI, dataset count, cell count",
              "items": {
                "type": "object",
                "properties": {
                  "collection_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Complete, untruncated collection description"
                  },
                  "description_length": {
                    "type": "integer"
                  },
                  "doi": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dataset_count": {
                    "type": "integer"
                  },
                  "total_cells": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Cells summed over the datasets that report a count, or null when none does. It used to be 0 for every collection, because the listing endpoint's datasets carry no cell_count and a 0 reads as 'no cells'."
                  },
                  "collection_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "contact_email": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "published_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "revised_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "publication": {
                    "type": "object",
                    "description": "The paper the collection belongs to: the journal, the date and the full author list, none of which the row carried -- so a collection could not be cited from a listing.",
                    "properties": {
                      "journal": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "publication_year": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "publication_month": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "publication_day": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "is_preprint": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "authors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "author_count": {
                        "type": "integer"
                      },
                      "authors_truncated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "tissues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "ontology_term_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tissue_type": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "description": "The distinct tissues across the collection's datasets, with their UBERON ids, capped at 25. The sibling dataset-search handler read these and the collection row did not."
                  },
                  "tissue_count": {
                    "type": "integer"
                  },
                  "tissues_truncated": {
                    "type": "boolean"
                  },
                  "diseases": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "ontology_term_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tissue_type": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "disease_count": {
                    "type": "integer"
                  },
                  "organisms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "ontology_term_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tissue_type": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "assays": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "ontology_term_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tissue_type": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "assay_count": {
                    "type": "integer"
                  },
                  "datasets_with_cell_count": {
                    "type": "integer",
                    "description": "How many of the datasets report a cell count. The listing endpoint reports none, which is why total_cells is null rather than 0."
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
