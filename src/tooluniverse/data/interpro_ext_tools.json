[
  {
    "name": "InterPro_get_proteins_by_domain",
    "description": "Find proteins that contain a specific InterPro domain. Results are cursor-paginated: when has_more is true, pass next_cursor as cursor with the same reviewed_only filter.",
    "parameter": {
      "type": "object",
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "InterPro accession ID. Examples: 'IPR011615' (p53 DNA-binding domain, 6K proteins), 'IPR000719' (Protein kinase domain, 2.2M proteins), 'IPR002117' (p53 family), 'IPR001245' (Serine-threonine/tyrosine-protein kinase)."
        },
        "page_size": {
          "type": "integer",
          "description": "Number of proteins to return (1-50, default 20).",
          "default": 20
        },
        "reviewed_only": {
          "type": "boolean",
          "description": "If true, only return Swiss-Prot reviewed entries (default false returns all UniProt).",
          "default": false
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque InterPro cursor returned as next_cursor by a previous call."
        }
      },
      "required": [
        "domain_id"
      ]
    },
    "fields": {
      "endpoint": "proteins_by_domain"
    },
    "type": "InterProExtTool",
    "test_examples": [
      {
        "domain_id": "IPR011615"
      },
      {
        "domain_id": "IPR011615",
        "reviewed_only": true,
        "page_size": 10
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "domain_id": {
              "type": "string"
            },
            "total_proteins": {
              "type": [
                "integer",
                "number"
              ]
            },
            "returned": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "proteins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accession": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source_database": {
                    "type": "string"
                  },
                  "length": {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  "source_organism": {
                    "type": "string"
                  },
                  "tax_id": {
                    "type": "string"
                  },
                  "gene": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene name of the protein, where UniProt records one"
                  },
                  "in_alphafold": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether AlphaFold DB holds a model for it"
                  },
                  "match_locations": {
                    "type": "array",
                    "description": "Where on this protein the domain matches - what 'contains this domain' means. Same shape as InterPro_get_entries_for_protein returns",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fragments": {
                          "type": "array",
                          "description": "Discontinuous pieces of the match",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "First residue"
                              },
                              "end": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Last residue"
                              },
                              "status": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "InterPro's continuity code, e.g. CONTINUOUS"
                              }
                            }
                          }
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Signature model the match came from"
                        },
                        "score": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "description": "Match score or e-value as InterPro reports it"
                        },
                        "representative": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether InterPro treats this as the representative match"
                        }
                      }
                    }
                  },
                  "match_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of match locations on this protein"
                  },
                  "entry_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What kind of entry the domain is on this protein: domain, family, homologous_superfamily, site"
                  },
                  "entry_source_database": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Database the entry comes from"
                  },
                  "entry_integrated_interpro": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "InterPro accession the entry is integrated into, if any"
                  },
                  "entries_matched": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Every entry accession reported for this protein in the response"
                  }
                }
              }
            },
            "page_size": {
              "type": [
                "integer",
                "number"
              ]
            },
            "reviewed_only": {
              "type": "boolean"
            }
          },
          "required": [
            "domain_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
