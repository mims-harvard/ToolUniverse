[
  {
    "type": "RemoteTool",
    "name": "opendde_fold",
    "description": "Predict an all-atom biomolecular structure with OpenDDE 1.1.1, Aureka's open AlphaFold3-class model. The query is a list of chains, each with a molecule_type (protein, dna, rna, ligand or ion) and a sequence -- SMILES or CCD_<id> for a ligand, the element symbol for an ion. One call folds one complex for one seed into up to 5 diffusion samples; returns per-sample confidence scores (rank on ranking_score) and timings, and the mmCIF text is opt-in. Folds single-sequence: no MSA search is performed.",
    "parameter": {
      "type": "object",
      "properties": {
        "chains": {
          "type": "array",
          "description": "The chains of one complex.",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "molecule_type": {
                "type": "string",
                "enum": [
                  "protein",
                  "dna",
                  "rna",
                  "ligand",
                  "ion"
                ],
                "default": "protein"
              },
              "sequence": {
                "type": "string",
                "description": "Residue sequence; SMILES or CCD_<id> when molecule_type is 'ligand'; the element symbol when it is 'ion'.",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "description": "Identical copies of this chain in the complex (default 1).",
                "default": 1,
                "minimum": 1,
                "maximum": 16
              }
            },
            "required": [
              "sequence"
            ]
          }
        },
        "name": {
          "type": "string",
          "description": "A label for this complex; it names the output files. Defaults to 'complex'."
        },
        "seed": {
          "type": "integer",
          "description": "Random seed; the same seed reproduces the prediction. Default 101.",
          "default": 101,
          "minimum": 0
        },
        "num_diffusion_samples": {
          "type": "integer",
          "description": "Structures to sample (upstream's default is 5, and 5 is this server's ceiling: peak memory scales with it). Each is scored separately, so this is how to compare conformations; rank them on `scores`.",
          "minimum": 1,
          "maximum": 5
        },
        "num_diffusion_steps": {
          "type": "integer",
          "description": "Diffusion steps per sample (upstream's default is 200). Fewer is faster and coarser.",
          "minimum": 1,
          "maximum": 400
        },
        "num_recycles": {
          "type": "integer",
          "description": "Pairformer recycling cycles (upstream's default is 10). Fewer is faster and less accurate.",
          "minimum": 1,
          "maximum": 20
        },
        "return_structures": {
          "type": "boolean",
          "description": "Return the mmCIF text (default false: megabytes). The confidence scores come back either way.",
          "default": false
        }
      },
      "required": [
        "chains"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "n_structures": {
          "type": "integer"
        },
        "structures": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "structures_note": {
          "type": "string"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "scores": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "use_msa": {
          "type": "boolean"
        },
        "msa_note": {
          "type": "string"
        },
        "options_applied": {
          "type": "object"
        },
        "timing": {
          "type": "object"
        },
        "peak_reserved_gib": {
          "type": "number"
        },
        "weights_held_by": {
          "type": "string"
        },
        "kit_mode": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "remote_info": {
      "server_type": "MCP",
      "transport": "http",
      "original_type": "OpenDDEFoldTool",
      "url": "https://github.com/anthropics/uplifting-biomolecular-modeling",
      "code_url": "https://github.com/mims-harvard/ToolUniverse/tree/main/src/tooluniverse/remote/opendde",
      "mcp_tool_name": "opendde_fold"
    },
    "test_examples": [
      {
        "chains": [
          {
            "molecule_type": "protein",
            "sequence": "LSDEDFKAVFGMTRSAFANLPLWKQQNLKKEKGLF"
          }
        ]
      }
    ]
  }
]
