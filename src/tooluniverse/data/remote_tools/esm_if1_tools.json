[
  {
    "type": "RemoteTool",
    "name": "esm_if1_design",
    "description": "Design protein SEQUENCES for a given backbone with ESM-IF1 (inverse folding). Give the backbone as PDB or mmCIF text and, optionally, the chain to design; returns num_samples sampled sequences, the structure's own sequence, and each sample's sequence recovery against it. Raise 'temperature' for diversity. Use multichain_backbone=true to design one chain of a complex while conditioning on all of its backbones. Runs on the CPU: expect ~1.5 s for a 64-residue backbone and ~40 s for 800 residues, roughly linear in length.",
    "parameter": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "description": "The backbone, as the text of a PDB or mmCIF file. Only the N, CA and C atoms of amino-acid residues are read; side chains, waters and ligands are ignored. Up to 8 MB."
        },
        "structure_format": {
          "type": "string",
          "enum": [
            "pdb",
            "cif"
          ],
          "description": "Which of the two the 'structure' text is (default pdb). Upstream's loader dispatches on this, so a cif sent as pdb fails to parse rather than being sniffed.",
          "default": "pdb"
        },
        "chain": {
          "type": "string",
          "description": "The chain id to design. Omit to take every chain the file's loader returns as one backbone. Required when multichain_backbone is true."
        },
        "num_samples": {
          "type": "integer",
          "description": "How many sequences to sample (default 1, max 64). Samples are independent draws from the same conditional distribution.",
          "default": 1,
          "minimum": 1,
          "maximum": 64
        },
        "temperature": {
          "type": "number",
          "description": "Sampling temperature (default 1.0). Higher is more diverse and lower recovers the native sequence more often.",
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10.0
        },
        "seed": {
          "type": "integer",
          "description": "Random seed, applied once per request (default 37, the kit's own). At a fixed seed, num_samples and batch_size the sampled sequences repeat exactly.",
          "default": 37,
          "minimum": 0
        },
        "batch_size": {
          "type": "integer",
          "description": "How many samples share one forward pass (default 64, max 64). It changes speed and memory, not the distribution. min(batch_size, num_samples) x the backbone's length must not exceed 6400.",
          "default": 64,
          "minimum": 1,
          "maximum": 64
        },
        "multichain_backbone": {
          "type": "boolean",
          "description": "Design 'chain' conditioned on the backbones of every chain in the file (upstream's multichain route) rather than on that chain alone. Needs 'chain'.",
          "default": false
        }
      },
      "required": [
        "structure"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_sequence": {
          "type": "string"
        },
        "sequence_recovery": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "chain": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "n_tokens": {
          "type": "integer"
        },
        "designed_length": {
          "type": "integer"
        },
        "num_samples": {
          "type": "integer"
        },
        "temperature": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "batch_size": {
          "type": "integer"
        },
        "rows_per_forward": {
          "type": "integer"
        },
        "n_batches": {
          "type": "integer"
        },
        "device": {
          "type": "string"
        },
        "timing": {
          "type": "object"
        },
        "peak_reserved_gib": {
          "type": "number"
        },
        "peak_rss_gib": {
          "type": "number"
        },
        "kit_mode": {
          "type": "string"
        },
        "kit_levers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weights_held_by": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "remote_info": {
      "server_type": "MCP",
      "transport": "http",
      "original_type": "ESMIF1DesignTool",
      "url": "https://github.com/anthropics/uplifting-biomolecular-modeling",
      "code_url": "https://github.com/mims-harvard/ToolUniverse/tree/main/src/tooluniverse/remote/esm_if1",
      "mcp_tool_name": "esm_if1_design"
    },
