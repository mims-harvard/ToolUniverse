[
  {
    "type": "RemoteTool",
    "name": "get_abstract_from_patent_app_number",
    "description": "Returns the abstract (ABST) text for a given patent application number.",
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationNumberText": {
          "type": "string",
          "description": "The USPTO application number (e.g. \"19113417\").",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[0-9]{8,16}$"
        }
      },
      "required": [
        "applicationNumberText"
      ]
    },
    "remote_info": {
      "server_type": "MCP",
      "transport": "http",
      "original_type": "USPTOPatentDocumentDownloader",
      "url": "https://zitniklab.hms.harvard.edu/ToolUniverse/expand_tooluniverse/remote/uspto_downloader.html",
      "code_url": "https://github.com/mims-harvard/bioagent/tree/main/ToolUniverse/src/tooluniverse/remote/uspto_downloader",
      "api_endpoint": "patent/applications/{applicationNumberText}/documents",
      "document": "ABST",
      "mcp_tool_name": "get_abstract_from_patent_app_number"
    },
    "test_examples": [
      {
        "applicationNumberText": "19113417"
      }
    ],
    "return_schema": {
      "type": "object",
      "description": "Output of the tool execution.",
      "properties": {
        "result": {
          "type": "string"
        },
        "document_chars": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    }
  },
