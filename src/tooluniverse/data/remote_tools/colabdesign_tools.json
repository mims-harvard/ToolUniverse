[
  {
    "type": "RemoteTool",
    "name": "colabdesign_design",
    "description": "Design a protein BINDER against a target structure with BindCraft's binder-hallucination step on ColabDesign 1.1.3 and AlphaFold-Multimer v3. Give the target as PDB text, its chain, the binder length and optionally hotspot residues. No alignment is needed and no external service is contacted. One call is one trajectory (gradient-based sequence optimisation through the structure predictor): it returns the best binder sequence, whether the trajectory passed BindCraft's own pLDDT gates, and the final confidence terms. Only the design step runs -- no MPNN redesign, reprediction, relaxation or filtering. The first request of each (target residues, binder length, recycles) shape compiles for minutes.",
    "parameter": {
      "type": "object",
      "properties": {
        "target_pdb": {
          "type": "string",
          "description": "The target structure as PDB text (ATOM records). Crop it to the region around the binding site: target residues plus binder length may not exceed 400."
        },
        "chain": {
          "type": "string",
          "description": "Target chain id(s) in the PDB, e.g. 'A' or 'A,B'.",
          "default": "A"
        },
        "binder_len": {
          "type": "integer",
          "description": "Length of the binder to design, in residues.",
          "minimum": 8,
          "maximum": 250
        },
        "hotspot": {
          "type": "string",
          "description": "Target residues the binder should contact, in BindCraft's grammar: '56', '31,33,57', 'A31,A33' or 'A1-10'. Omit for no hotspot."
        },
        "seed": {
          "type": "integer",
          "description": "Random seed for the trajectory.",
          "default": 0,
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "A job name; it prefixes the design's name.",
          "default": "design"
        },
        "num_recycles_design": {
          "type": "integer",
          "description": "AlphaFold recycles per design step (BindCraft's default is 1). Part of the compiled program, so changing it recompiles.",
          "minimum": 1,
          "maximum": 3
        },
        "soft_iterations": {
          "type": "integer",
          "description": "Stage-1 logit iterations (BindCraft default 75). Upstream hard-codes the first 50, so values below 50 are not accepted.",
          "minimum": 50,
          "maximum": 200
        },
        "temporary_iterations": {
          "type": "integer",
          "description": "Stage-2 softmax iterations (BindCraft default 45).",
          "minimum": 0,
          "maximum": 100
        },
        "hard_iterations": {
          "type": "integer",
          "description": "Stage-3 one-hot iterations (BindCraft default 5).",
          "minimum": 0,
          "maximum": 50
        },
        "greedy_iterations": {
          "type": "integer",
          "description": "Stage-4 PSSM semi-greedy iterations (BindCraft default 15).",
          "minimum": 0,
          "maximum": 50
        },
        "return_structures": {
          "type": "boolean",
          "description": "Return the design PDB text and the per-step trajectory (default false). Sequences and scores come back either way.",
          "default": false
        }
      },
      "required": [
        "target_pdb",
        "binder_len"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted_by_stage_gates": {
          "type": "boolean"
        },
        "terminate": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_fired": {
          "type": [
            "string",
            "null"
          ]
        },
        "final": {
          "type": "object"
        },
        "best_metric": {
          "type": "number"
        },
        "best_metric_name": {
          "type": "string"
        },
        "n_steps": {
          "type": "integer"
        },
        "phases_run": {
          "type": [
            "array",
            "object",
            "string",
            "integer"
          ]
        },
        "tokens": {
          "type": "integer"
        },
        "target_residues": {
          "type": "integer"
        },
        "binder_len": {
          "type": "integer"
        },
        "hotspot": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "num_recycles_design": {
          "type": "integer"
        },
        "iterations": {
          "type": "object"
        },
        "optimise_beta": {
          "type": "boolean"
        },
        "engine_key": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "first_of_engine_key": {
          "type": "boolean"
        },
        "timing": {
          "type": "object"
        },
        "peak_reserved_gib": {
          "type": "number"
        },
        "weights_held_by": {
          "type": "string"
        },
        "kit_mode": {
          "type": "string"
        },
        "output_sha256": {
          "type": "object"
        },
        "design_pdb": {
          "type": [
            "string",
            "null"
          ]
        },
        "trajectory_jsonl": {
          "type": [
            "string",
            "null"
          ]
        },
        "structure_note": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "remote_info": {
