[
  {
    "type": "RemoteTool",
    "name": "af2ig_predict",
    "description": "Re-predict a designed binder-target complex with AlphaFold 2 using the complex itself as the structural initial guess (nrbennet/dl_binder_design af2_initial_guess, model_1_ptm). This is the standard in-silico filter for designed binders: give it the complex as PDB text with the BINDER AS THE FIRST CHAIN and the target as the chains after it, and it returns the predicted complex and the interface confidence scores. The headline number is pae_interaction, in angstroms, where the field's working threshold is below 10. No MSA is built, no template is searched and no external service is contacted; the result is deterministic. The input must be a structure -- there is no sequence-only route.",
    "parameter": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "description": "The complex as PDB text. CHAIN 1 IS THE BINDER and every following chain is the target; a single-chain file is predicted as a monomer and the interface scores come back null. ATOM records of standard residues are read; HETATM, waters and ligands are ignored. Backbone-only coordinates are enough.",
          "minLength": 1
        },
        "num_recycle": {
          "type": "integer",
          "description": "AlphaFold recycling iterations (upstream's default is 3). This is compile-time: changing it rebuilds the held model and recompiles, which the reply reports as config_rebuilt.",
          "minimum": 0,
          "maximum": 20,
          "default": 3
        },
        "initial_guess": {
          "type": "boolean",
          "description": "Use the input coordinates as the structural initial guess (default true, and the whole point of the method). False runs the same template-conditioned prediction without it, which is a different and weaker filter. Compile-time, as num_recycle is.",
          "default": true
        },
        "force_monomer": {
          "type": "boolean",
          "description": "Treat the first chain alone as the whole input and drop the rest. Used to score a binder's own fold independently of its target.",
          "default": false
        },
        "max_amide_dist": {
          "type": "number",
          "description": "Angstroms. A C-N amide distance above this is read as a chain break and gets AlphaFold's +200 residue-index offset (upstream's default 3.0).",
          "minimum": 0.1,
          "maximum": 100.0,
          "default": 3.0
        },
        "return_structure": {
          "type": "boolean",
          "description": "Return the predicted complex as PDB text, with per-residue pLDDT in the B-factor column (default false: the scores are what a filter reads, and a few-hundred-residue PDB is hundreds of kilobytes). This is the ONLY way to get the structure: the server keeps no output directory and returns no host path.",
          "default": false
        }
      },
      "required": [
        "structure"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "pae_interaction": {
          "type": "number"
        },
        "scores": {
          "type": "object"
        },
        "structure_name": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        },
        "structure_note": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "n_residues": {
          "type": "integer"
        },
        "n_chains": {
          "type": "integer"
        },
        "binder_length": {
          "type": "integer"
        },
        "monomer": {
          "type": "boolean"
        },
        "num_recycle": {
          "type": "integer"
        },
        "initial_guess": {
          "type": "boolean"
        },
        "config_rebuilt": {
          "type": "boolean"
        },
        "new_length": {
          "type": "boolean"
        },
        "timing": {
          "type": "object"
        },
        "peak_reserved_gib": {
          "type": "number"
        },
        "weights_held_by": {
          "type": "string"
        },
        "kit_mode": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
