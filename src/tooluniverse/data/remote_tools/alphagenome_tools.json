[
  {
    "type": "RemoteTool",
    "name": "run_alphagenome_score_variant",
    "description": "Score a regulatory variant's effect with DeepMind AlphaGenome (Avsec, Nature 2026), the hosted successor to Enformer/Borzoi. Predicts ref vs alt over up to 1 Mb at single-base resolution and returns the recommended per-track effect scores (sorted by |effect|). Served as a remote MCP tool so the alphagenome gRPC SDK and ALPHA_GENOME_API_KEY live on the server; free for non-commercial use.",
    "required_api_keys": ["ALPHA_GENOME_API_KEY"],
    "api_key_info": {
      "ALPHA_GENOME_API_KEY": {
        "domain": "Models & Infrastructure",
        "type": "api_key",
        "register_url": "https://deepmind.google.com/science/alphagenome",
        "purpose": "Free non-commercial access to the hosted AlphaGenome prediction API.",
        "without": "Tool stays config-only until the key is set."
      }
    },
    "parameter": {
      "type": "object",
      "properties": {
        "chromosome": {"type": "string", "description": "Chromosome, e.g. 'chr22'."},
        "position": {"type": "integer", "description": "1-based variant position."},
        "reference_bases": {"type": "string", "description": "Reference allele, e.g. 'A'."},
        "alternate_bases": {"type": "string", "description": "Alternate allele, e.g. 'C'."},
        "output_type": {"type": ["string", "null"], "description": "Modality to score: RNA_SEQ (default), ATAC, DNASE, CAGE, CHIP_HISTONE, CHIP_TF, SPLICE_SITES, CONTACT_MAPS."},
        "organism": {"type": ["string", "null"], "description": "'human' (default) or 'mouse'."},
        "sequence_length": {"type": ["string", "null"], "description": "Context window: 16KB, 100KB, 500KB, or 1MB (default)."},
        "top_n": {"type": ["integer", "null"], "description": "Number of top |effect| tracks to return (default 20)."}
      },
      "required": ["chromosome", "position", "reference_bases", "alternate_bases"]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "provider": {"type": "string"},
        "variant": {"type": "string"},
        "output_type": {"type": "string"},
        "scores": {"type": "array", "items": {"type": "object"}, "description": "Top |effect| per-track scores."},
        "error": {"type": "string", "description": "Error description if the run failed."}
      }
    },
    "remote_info": {
      "server_type": "SMCP",
      "transport": "http",
      "original_type": "AlphagenomeScoreVariantTool",
      "url": "https://deepmind.google.com/science/alphagenome",
      "code_url": "https://github.com/mims-harvard/ToolUniverse/tree/main/src/tooluniverse/remote/alphagenome",
      "mcp_tool_name": "run_alphagenome_score_variant"
    },
    "test_examples": [
      {"chromosome": "chr22", "position": 36201698, "reference_bases": "A", "alternate_bases": "C", "output_type": "RNA_SEQ"}
    ]
  },
  {
    "type": "RemoteTool",
    "name": "run_alphagenome_predict_interval",
    "description": "Predict multimodal genomic tracks for a genomic interval with DeepMind AlphaGenome (single DNA-sequence model; up to 1 Mb at single-base resolution). Returns a compact per-modality summary (track counts and shapes) for the requested outputs (RNA_SEQ, ATAC, DNASE, CAGE, ChIP, splicing, contact maps). Served as a remote MCP tool so the alphagenome gRPC SDK and ALPHA_GENOME_API_KEY live on the server.",
    "required_api_keys": ["ALPHA_GENOME_API_KEY"],
    "api_key_info": {
      "ALPHA_GENOME_API_KEY": {
        "domain": "Models & Infrastructure",
        "type": "api_key",
        "register_url": "https://deepmind.google.com/science/alphagenome",
        "purpose": "Free non-commercial access to the hosted AlphaGenome prediction API.",
        "without": "Tool stays config-only until the key is set."
      }
    },
    "parameter": {
      "type": "object",
      "properties": {
        "chromosome": {"type": "string", "description": "Chromosome, e.g. 'chr19'."},
        "start": {"type": "integer", "description": "Interval start (0-based)."},
        "end": {"type": "integer", "description": "Interval end."},
        "output_types": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Modalities to predict, e.g. ['RNA_SEQ','ATAC'] (default ['RNA_SEQ'])."},
        "ontology_terms": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Optional tissue/cell ontology terms (e.g. ['UBERON:0001114'] = liver) to restrict tracks."},
        "organism": {"type": ["string", "null"], "description": "'human' (default) or 'mouse'."},
        "sequence_length": {"type": ["string", "null"], "description": "Context window: 16KB, 100KB, 500KB, or 1MB (default)."}
      },
      "required": ["chromosome", "start", "end"]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "provider": {"type": "string"},
        "interval": {"type": "string"},
        "tracks": {"type": "array", "items": {"type": "object"}, "description": "Per-modality {modality, shape, n_tracks} summary."},
        "error": {"type": "string", "description": "Error description if the run failed."}
      }
    },
    "remote_info": {
      "server_type": "SMCP",
      "transport": "http",
      "original_type": "AlphagenomePredictIntervalTool",
      "url": "https://deepmind.google.com/science/alphagenome",
      "code_url": "https://github.com/mims-harvard/ToolUniverse/tree/main/src/tooluniverse/remote/alphagenome",
      "mcp_tool_name": "run_alphagenome_predict_interval"
    },
    "test_examples": [
