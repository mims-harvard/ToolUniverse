[
  {
    "type": "RemoteTool",
    "name": "complexa_design_binder",
    "description": "Design de novo protein binders against a target with Proteina-Complexa 1.1.0 (NVIDIA's flow-matching binder generator). Give the target structure as PDB text, the chain and residue range to crop it to (e.g. 'A1-115'), and hotspot residues on its surface (e.g. 'A37'); it samples binders of the requested length and returns, per design, the decoded binder amino-acid sequence, with the full complex (chain A target crop, chain B new binder) as PDB text on request. Generation stage only: samples are raw, not scored or ranked.",
    "parameter": {
      "type": "object",
      "properties": {
        "target_pdb": {
          "type": "string",
          "description": "The target protein structure as PDB text (ATOM records). Residue numbers in it are the ones target_input and hotspot_residues refer to.",
          "minLength": 1
        },
        "target_input": {
          "type": "string",
          "description": "Chain and residue range of the target to design against, e.g. 'A1-115' (at most 300 residues).",
          "pattern": "^[A-Za-z0-9]-?\\d+--?\\d+$"
        },
        "hotspot_residues": {
          "type": "array",
          "description": "Target residues the binder should contact, each <chain><number> and inside target_input, e.g. ['A37', 'A39', 'A49'].",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "binder_length": {
          "type": "integer",
          "description": "Residues in each designed binder, 20..200 (default 80).",
          "default": 80,
          "minimum": 20,
          "maximum": 200
        },
        "num_designs": {
          "type": "integer",
          "description": "Designs to sample, 1..16 (default 1).",
          "default": 1,
          "minimum": 1,
          "maximum": 16
        },
        "batch_size": {
          "type": "integer",
          "description": "Designs per forward pass (default: all of them). Lowering it trades time for peak GPU memory; (target crop + binder)^2 x batch_size is bounded at 4000000.",
          "minimum": 1,
          "maximum": 16
        },
        "num_steps": {
          "type": "integer",
          "description": "Flow-matching integration steps per design (10..400, default 400, upstream's own). Fewer is faster and rougher.",
          "default": 400,
          "minimum": 10,
          "maximum": 400
        },
        "seed": {
          "type": "integer",
          "description": "Random seed (upstream's default is 5). The same seed and inputs reproduce the designs.",
          "default": 5,
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "A label for this target; defaults to 'design'."
        },
        "return_pdb": {
          "type": "boolean",
          "description": "Return each design's PDB text (default false: ~100 KB per design). Sequences come back either way.",
          "default": false
        }
      },
      "required": [
        "target_pdb",
        "target_input",
        "hotspot_residues"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "n_designs": {
          "type": "integer"
        },
        "designs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "binder_sequence": {
                "type": "string"
              },
              "binder_length": {
                "type": "integer"
              },
              "pdb": {
                "type": "string"
              },
              "pdb_error": {
                "type": "string"
              }
            }
          }
        },
        "seed": {
          "type": "integer"
        },
        "target_residues": {
          "type": "integer"
        },
        "binder_length": {
          "type": "integer"
        },
        "num_steps": {
          "type": "integer"
        },
        "batch_size": {
          "type": "integer"
        },
        "stage": {
          "type": "string"
        },
        "timing": {
          "type": "object"
        },
        "request_peak_reserved_gib": {
          "type": "number"
        },
        "peak_reserved_gib": {
          "type": "number"
        },
        "weights_held_by": {
          "type": "string"
        },
        "kit_mode": {
          "type": "string"
        },
        "pdb_note": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "remote_info": {
      "server_type": "MCP",
      "transport": "http",
      "original_type": "ComplexaDesignBinderTool",
      "url": "https://github.com/anthropics/uplifting-biomolecular-modeling",
      "code_url": "https://github.com/mims-harvard/ToolUniverse/tree/main/src/tooluniverse/remote/complexa",
      "mcp_tool_name": "complexa_design_binder"
    },
