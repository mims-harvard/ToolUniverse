                  },
                  "gene_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl gene ID"
                  },
                  "protein_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Ensembl protein ID"
                  },
                  "hgnc_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HGNC gene ID"
                  },
                  "refseq_transcript_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "RefSeq transcripts matching this Ensembl transcript"
                  },
                  "variant_allele": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Alternate allele as VEP reports it for this transcript"
                  },
                  "canonical": {
                    "type": [
                      "string",
                      "integer",
                      "boolean",
                      "null"
                    ],
