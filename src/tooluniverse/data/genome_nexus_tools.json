  {
    "name": "GenomeNexus_get_cancer_hotspots",
    "description": "Get cancer mutation hotspot annotations from Genome Nexus (MSK) for a specific genomic variant. Cancer hotspots are recurrently mutated residues in cancer, curated by the Chang et al. study. Returns hotspot residue, tumor count, hotspot type (single residue or 3D cluster), and the gene symbol. Use this to check if a variant falls in a known cancer hotspot. Input is a GRCh37/hg19 HGVS genomic variant. Example: '7:g.140453136A>T' (BRAF V600E) returns V600 hotspot with 897 tumors.",
    "parameter": {
      "type": "object",
      "properties": {
        "hgvsg": {
          "type": "string",
          "description": "Genomic variant in HGVS notation using GRCh37/hg19 coordinates. Format: 'chr:g.posRef>Alt'. Examples: '7:g.140453136A>T' (BRAF V600E), '17:g.7577120C>T' (TP53 R273H)."
        }
      },
      "required": [
        "hgvsg"
      ]
    },
    "fields": {
      "endpoint": "get_cancer_hotspots"
    },
    "type": "GenomeNexusTool",
    "test_examples": [
      {
        "hgvsg": "7:g.140453136A>T"
      },
      {
        "hgvsg": "17:g.7577120C>T"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "variant": {
              "type": "string"
            },
            "gene_symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_hotspot": {
              "type": "boolean"
            },
            "variant_summary": {
              "type": "object",
              "description": "What the variant is. `is_hotspot: true` without the protein change does not say WHICH hotspot, and the canonical transcript summary -- already fetched to read the gene symbol -- carries p.V600E, the Missense_Mutation classification, the transcript, the exon and the SIFT/PolyPhen/AlphaMissense calls.",
              "properties": {
                "protein_change": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "e.g. p.V600E"
                },
                "protein_change_long": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "coding_change": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "variant_classification": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "consequence_terms": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "transcript_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exon": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "protein_position": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "codon_change": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "amino_acids": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "uniprot_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "refseq": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "entrez_gene_id": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                },
                "sift_prediction": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sift_score": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "polyphen_prediction": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "polyphen_score": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "alpha_missense": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            },
            "most_severe_consequence": {
              "type": [
                "string",
                "null"
              ]
            },
            "consequence_terms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every consequence term across the transcripts, which differ: the same base change is a missense on three BRAF transcripts and a 3'-UTR variant on a fourth."
            },
            "colocated_variant_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The ids this position is already known by -- COSMIC, dbSNP -- which is how a hotspot call is cross-checked."
            },
            "hotspots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hugoSymbol": {
                    "type": "string"
                  },
                  "residue": {
                    "type": "string"
                  },
                  "tumorCount": {
                    "type": "integer",
                    "description": "Tumours with any mutation at this residue; the counts below say what kind"
                  },
                  "type": {
                    "type": "string",
                    "description": "single residue or 3d"
                  },
                  "transcriptId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Transcript the residue number is counted against"
                  },
                  "transcriptIdVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "missenseCount": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "truncatingCount": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "inframeCount": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "spliceCount": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cancer Hotspots release the counts come from"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GenomeNexus_get_canonical_transcript",
    "description": "Get the canonical transcript for a gene from Genome Nexus (MSK). Returns the Ensembl transcript ID, protein ID, protein length, RefSeq mRNA ID, CCDS ID, HUGO symbol, and Pfam protein domain annotations. Useful for determining the standard transcript to use for variant annotation, and for getting a quick overview of protein domain architecture. Input is a HUGO gene symbol (e.g., 'TP53', 'BRAF', 'BRCA1').",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "description": "HUGO gene symbol. Examples: 'TP53', 'BRAF', 'BRCA1', 'EGFR', 'KRAS'."
        }
      },
      "required": [
        "gene_symbol"
      ]
    },
    "fields": {
      "endpoint": "get_canonical_transcript"
    },
    "type": "GenomeNexusTool",
    "test_examples": [
      {
        "gene_symbol": "TP53"
      },
      {
        "gene_symbol": "BRAF"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "type": "object",
          "properties": {
            "transcriptId": {
              "type": "string",
              "description": "Ensembl transcript ID"
            },
            "geneId": {
              "type": "string",
              "description": "Ensembl gene ID"
            },
            "proteinId": {
              "type": "string",
              "description": "Ensembl protein ID"
            },
            "proteinLength": {
              "type": "integer"
            },
            "hugoSymbols": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "refseqMrnaId": {
              "type": [
                "string",
                "null"
              ]
            },
            "ccdsId": {
              "type": [
                "string",
                "null"
              ]
            },
            "transcriptIdVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "uniprotId": {
              "type": [
                "string",
                "null"
              ],
              "description": "UniProt accession of this transcript's protein"
            },
            "exon_count": {
              "type": "integer",
              "description": "Number of exons returned"
            },
            "exons": {
              "type": "array",
              "description": "Exon structure of the canonical transcript, in the order Ensembl reports it",
              "items": {
                "type": "object",
                "properties": {
                  "exonId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exonStart": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "exonEnd": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "rank": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Exon number along the transcript"
                  },
                  "strand": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "utrs": {
              "type": "array",
              "description": "Untranslated regions, which is how a coding exon is told from a UTR",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "five_prime_UTR or three_prime_UTR"
                  },
                  "start": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "strand": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "pfamDomains": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pfamDomainId": {
                    "type": "string"
                  },
                  "pfamDomainStart": {
                    "type": "integer"
                  },
                  "pfamDomainEnd": {
                    "type": "integer"
                  },
                  "pfamDomainDescription": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "GenomeNexus_annotate_mutation",
    "description": "Annotate a cancer mutation using Genome Nexus (MSK) by specifying chromosome, start, end, reference allele, and variant allele separately. This is an alternative to the HGVS-based annotation for when you have genomic coordinates directly (GRCh37/hg19). Returns the same comprehensive annotation as GenomeNexus_annotate_variant including VEP consequences, SIFT, PolyPhen, AlphaMissense scores, cancer hotspots, and mutation assessor. Example: chr=7, start=140453136, end=140453136, ref=A, alt=T for BRAF V600E.",
    "parameter": {
      "type": "object",
      "properties": {
        "chromosome": {
          "type": "string",
          "description": "Chromosome (without 'chr' prefix). Examples: '7', '17', '12', 'X'."
        },
        "start": {
          "type": "integer",
          "description": "Start position (GRCh37/hg19, 1-based)."
        },
        "end": {
          "type": "integer",
          "description": "End position (GRCh37/hg19, 1-based). Same as start for SNVs."
        },
        "reference_allele": {
          "type": "string",
          "description": "Reference allele. Example: 'A'."
        },
        "variant_allele": {
          "type": "string",
          "description": "Variant (alternate) allele. Example: 'T'."
        }
      },
      "required": [
        "chromosome",
        "start",
        "end",
        "reference_allele",
        "variant_allele"
      ]
    },
    "fields": {
      "endpoint": "annotate_mutation"
    },
    "type": "GenomeNexusTool",
    "test_examples": [
      {
        "chromosome": "7",
        "start": 140453136,
        "end": 140453136,
