  {
    "name": "GenomeNexus_annotate_dbsnp",
    "description": "Annotate a variant directly by its dbSNP rsID using Genome Nexus (Memorial Sloan Kettering). Genome Nexus resolves the rsID to genomic coordinates and returns aggregated annotation from VEP, SIFT, PolyPhen-2, AlphaMissense, and cancer hotspots, plus an annotation summary with the genomic location (chromosome/start/end) and HGVS protein notation. Use this when you have a dbSNP rsID rather than HGVS coordinates. Example: 'rs121913529' (KRAS G12 codon) returns 12 transcript consequences, gene KRAS, SIFT 'deleterious', PolyPhen 'probably_damaging', AlphaMissense score 0.9949 (pathogenic), genomic location chr12:25398284.",
    "parameter": {
      "type": "object",
      "properties": {
        "rsid": {
          "type": "string",
          "description": "dbSNP reference SNP ID. Examples: 'rs121913529' (KRAS G12), 'rs113488022' (BRAF V600E), 'rs28934578' (TP53 R273H). A bare numeric id (e.g. '121913529') is accepted and prefixed with 'rs'."
        }
      },
      "required": [
        "rsid"
      ]
    },
