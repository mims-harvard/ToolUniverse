                    "null"
                  ],
                  "description": "Chromosome, start, end and alleles",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array",
                      "object",
                      "null"
                    ]
                  }
                },
                "transcriptConsequenceSummaries": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Summarised consequence per transcript",
                  "items": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "One summary",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ]
                    }
                  }
                },
                "transcriptConsequenceSummary": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Summarised consequence on the canonical transcript",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array",
                      "object",
                      "null"
                    ],
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                      ],
                      "additionalProperties": {
                        "type": [
