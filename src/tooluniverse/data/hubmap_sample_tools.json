[
  {
    "name": "HuBMAP_search_samples",
    "description": "Search HuBMAP biospecimen Samples with exact totals and Elasticsearch offset pagination. Continue with metadata.next_offset while metadata.has_more is true. Filter by organ, sample category, and CCF/RUI registration.",
    "parameter": {
      "type": "object",
      "properties": {
        "organ": {
          "type": "string",
          "description": "2-letter RUI organ code to filter by (e.g. 'LK' left kidney, 'HT' heart, 'SK' skin, 'BR' brain). Case-insensitive."
        },
        "sample_category": {
          "type": "string",
          "description": "Tissue granularity: 'block', 'section', 'organ', or 'suspension'. Case-insensitive."
        },
        "registered_only": {
          "type": "boolean",
          "description": "If true, return only spatially-registered samples that carry CCF/RUI coordinates (rui_location). Default false.",
          "default": false
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-50, default 10).",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "Number of matching samples to skip. Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fields": {
      "operation": "search_samples"
    },
    "type": "HuBMAPSampleTool",
    "test_examples": [
      {
        "organ": "LK",
        "sample_category": "block",
        "limit": 3
      },
      {
        "sample_category": "section",
        "registered_only": true,
        "limit": 3
      },
      {
        "organ": "HT",
        "limit": 2
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hubmap_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "uuid": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sample_category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "organ_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "organ_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "group_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "spatially_registered": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "donor_hubmap_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "total"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HuBMAP_get_sample",
    "description": "Get the full record for a single HuBMAP tissue Sample by its HuBMAP ID, including its CCF/RUI spatial registration. For spatially-registered blocks and sections this returns rui_location: the 3-D dimensions (x/y/z + units) of the tissue, the placement_target reference organ in the Common Coordinate Framework (e.g. a 3-D kidney/heart/lung model), and ccf_annotations -- the list of CCF/UBERON anatomical structures the specimen overlaps. Also returns sample_category, organ, owning group, protocol URL, and the parent donor's HuBMAP ID. Obtain valid sample IDs from HuBMAP_search_samples. Example: HBM658.BXNB.873.",
    "parameter": {
      "type": "object",
      "properties": {
        "hubmap_id": {
          "type": "string",
          "description": "HuBMAP Sample identifier (e.g. 'HBM658.BXNB.873'). Obtain from HuBMAP_search_samples."
        }
      },
      "required": ["hubmap_id"]
    },
    "fields": {
      "operation": "get_sample"
    },
    "type": "HuBMAPSampleTool",
    "test_examples": [
      {
        "hubmap_id": "HBM658.BXNB.873"
      },
      {
        "hubmap_id": "HBM828.FDRM.746"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hubmap_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "uuid": {
              "type": [
                "string",
                "null"
              ]
            },
            "entity_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "sample_category": {
              "type": [
                "string",
                "null"
              ]
            },
            "organ_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "organ_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "group_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_access_level": {
              "type": [
                "string",
                "null"
              ]
            },
            "protocol_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "donor_hubmap_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_timestamp": {
              "type": [
                "integer",
                "number",
                "null"
              ]
            },
            "donor_demographics": {"type": "object", "description": "The donor's own attributes, from metadata.organ_donor_data or metadata.living_donor_data on the sample's donor record. Reading only organ_donor_data returned an empty dict for every living donor."},
            "donor_demographics_coded": {"type": "array", "description": "The same attributes with the codes that define them -- 'Race: White' is SNOMEDCT_US 413773004 -- which the flat map loses and the provenance tool already reported.", "items": {"type": "object", "properties": {"attribute": {"type": ["string", "null"]}, "value": {"type": ["string", "number", "null"]}, "units": {"type": ["string", "null"]}, "data_type": {"type": ["string", "null"]}, "code": {"type": ["string", "null"]}, "concept_id": {"type": ["string", "null"]}, "vocabulary": {"type": ["string", "null"]}}}},
            "descendants": {"type": "array", "items": {"type": "object"}, "description": "What was made from this sample. Each row carries whichever of uuid/hubmap_id/entity_type/dataset_type/status/sample_category this index stores -- uuid for all of them, dataset_type for most."},
            "descendant_count": {"type": "integer", "description": "Length of descendant_ids, which is longer than `descendants`: HBM658.BXNB.873 lists 67 ids and 45 entities, so the two upstream lists disagree."},
            "immediate_descendant_ids": {"type": "array", "items": {"type": "string"}, "description": "Only the entities derived directly from this sample."},
            "rui_location": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "registered": {
                  "type": "boolean"
                },
                "placement_target": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "x_dimension": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y_dimension": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "z_dimension": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dimension_units": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ccf_annotations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "hubmap_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "HuBMAP_search_donors",
    "description": "Search HuBMAP human Donors with normalized demographics, exact totals, and Elasticsearch offset pagination. Continue with metadata.next_offset while metadata.has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "group_name": {
          "type": "string",
          "description": "Filter by the data-providing group/TMC name (partial match, e.g. 'Stanford', 'Vanderbilt TMC', 'University of California San Diego TMC')."
        },
        "query": {
          "type": "string",
          "description": "Free-text search across donor description and demographic values (e.g. 'female', 'White', 'diabetes')."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-50, default 10).",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "type": "integer",
          "description": "Number of matching donors to skip. Continue with metadata.next_offset.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fields": {
      "operation": "search_donors"
    },
    "type": "HuBMAPSampleTool",
    "test_examples": [
      {
        "group_name": "Stanford",
        "limit": 3
      },
      {
        "query": "Female",
        "limit": 3
      },
      {
        "group_name": "Vanderbilt TMC",
        "limit": 2
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "donors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hubmap_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "uuid": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "group_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "demographics": {
                    "type": "object"
                  },
                  "demographics_coded": {"type": "array", "description": "The same attributes with the codes that define them, which the flat map loses.", "items": {"type": "object", "properties": {"attribute": {"type": ["string", "null"]}, "value": {"type": ["string", "number", "null"]}, "units": {"type": ["string", "null"]}, "data_type": {"type": ["string", "null"]}, "code": {"type": ["string", "null"]}, "concept_id": {"type": ["string", "null"]}, "vocabulary": {"type": ["string", "null"]}}}}
                }
              }
            }
          },
          "required": [
            "total"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
