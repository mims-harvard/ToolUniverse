[
  {
    "name": "Ensembl_get_cross_references",
    "description": "Get external database cross-references for an Ensembl stable identifier with exact local offset pagination over the complete Ensembl response. Supports an official external_db filter. Metadata exposes total_xrefs and next_offset; database_summary covers the full result while page_database_summary covers only returned xrefs.",
    "parameter": {
      "type": "object",
      "properties": {
        "ensembl_id": {
          "type": "string",
          "minLength": 1,
          "description": "Ensembl stable identifier. Can be gene (ENSG*), transcript (ENST*), or translation (ENSP*). Examples: 'ENSG00000141510' (TP53 gene), 'ENST00000269305' (TP53 canonical transcript)."
        },
        "external_db": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional: filter by external database name. Examples: 'HGNC', 'EntrezGene', 'Uniprot_gn', 'MIM_GENE', 'Reactome_gene', 'GeneCards'. If not specified, returns all cross-references."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 500,
          "description": "Maximum xrefs returned from the complete response (default 500)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based xref offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "ensembl_id"
      ]
    },
    "fields": {
      "endpoint": "xrefs_by_id"
    },
    "type": "EnsemblXrefsTool",
    "test_examples": [
      {
        "ensembl_id": "ENSG00000141510"
      },
      {
        "ensembl_id": "ENSG00000141510",
        "external_db": "HGNC"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ensembl_id": {
              "type": "string"
            },
            "xrefs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dbname": {
                    "type": "string"
                  },
                  "db_display_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "primary_id": {
                    "type": "string"
                  },
                  "display_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "info_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "synonyms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "database_summary": {
              "type": "object",
              "description": "Count of all matching xrefs per database, before local pagination."
            },
            "page_database_summary": {
              "type": "object",
              "description": "Count of returned-page xrefs per database."
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "ensembl_id",
            "xrefs",
            "database_summary",
            "page_database_summary",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Ensembl_lookup_gene_by_symbol",
    "description": "Look up Ensembl IDs for a gene symbol and species. The complete Ensembl response is exposed through local offset pagination with total_results and next_offset, instead of silently dropping matches after 50. An optional external_db filter is passed to Ensembl.",
    "parameter": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "description": "Gene symbol to look up. Examples: 'TP53', 'BRCA1', 'EGFR', 'BRAF', 'KRAS'."
        },
        "species": {
          "type": "string",
          "minLength": 1,
          "default": "human",
          "description": "Species name. Default: 'human'. Examples: 'human', 'mouse', 'rat', 'zebrafish'."
        },
        "external_db": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional: filter by external database. Examples: 'HGNC', 'EntrezGene'."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 50,
          "description": "Maximum Ensembl IDs returned (default 50)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based result offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "symbol"
      ]
    },
    "fields": {
      "endpoint": "xrefs_by_symbol"
    },
    "type": "EnsemblXrefsTool",
    "test_examples": [
      {
        "symbol": "TP53",
        "species": "human"
      },
      {
        "symbol": "BRCA1",
        "species": "human"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "ensembl_ids": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "symbol",
            "species",
            "ensembl_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
