[
  {
    "name": "Bgee_search_genes",
    "description": "Search for genes in the Bgee comparative gene expression database across 29+ animal species. Search by gene symbol, name, or description and optionally restrict to one NCBI taxonomy ID. Results support limit/offset pagination. Bgee's official endpoint can expose at most the first 10,000 matches for one query; metadata reports accessible_matches and upstream_truncated, and species_id can be used to partition very broad cross-species searches. Example: searching 'TP53' returns tumor protein p53 across human, mouse, zebrafish, and other model organisms.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene name, symbol, or description to search for. Examples: 'TP53', 'insulin', 'BRCA1', 'sonic hedgehog'."
        },
        "species_id": {
          "type": "string",
          "description": "Optional NCBI taxonomy ID used by Bgee to restrict the search to one species, e.g. '9606' for human or '10090' for mouse. Recommended for broad queries whose cross-species total exceeds Bgee's 10,000-record upstream limit."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Maximum number of gene matches to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999,
          "default": 0,
          "description": "Zero-based result offset within Bgee's first 10,000 accessible matches. Use metadata.next_offset for the next page."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint": "gene_search"
    },
    "timeout": 90,
    "type": "BgeeTool",
    "test_examples": [
      {
        "query": "TP53"
      },
      {
        "query": "insulin"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Ensembl gene ID"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene symbol"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene description"
              },
              "species_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "NCBI taxonomy ID"
              },
              "species_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Scientific species name"
              },
              "common_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common species name"
              },
              "gene_biotype": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Gene biotype (e.g., protein_coding)"
              },
              "match_source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "How the match was found (name, description, etc.)"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Bgee_get_gene_expression",
    "description": "Get expression data for a gene across tissues and organs from the Bgee database. Returns where a gene is expressed with expression scores, confidence levels, and quality ratings. Supports RNA-Seq, Affymetrix, EST, and in situ hybridization data types. Requires both an Ensembl gene ID and NCBI taxonomy ID. Example: ENSG00000141510 (TP53) with species 9606 (human) returns expression across 145+ tissues including ventricular zone (score 95.11), ganglionic eminence, and monocytes.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "Ensembl gene ID. Examples: 'ENSG00000141510' (human TP53), 'ENSMUSG00000059552' (mouse Trp53), 'ENSDARG00000115148' (zebrafish tp53)."
        },
        "species_id": {
          "type": "string",
          "description": "NCBI taxonomy ID for the species. Examples: '9606' (human), '10090' (mouse), '7955' (zebrafish), '7227' (fruit fly)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Maximum number of expression calls to return in this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based expression-call offset. Use metadata.next_offset to retrieve the next page."
        }
      },
      "required": [
        "gene_id",
        "species_id"
      ]
    },
    "fields": {
      "endpoint": "gene_expression"
    },
    "timeout": 90,
    "type": "BgeeTool",
    "test_examples": [
      {
        "gene_id": "ENSG00000141510",
        "species_id": "9606"
      },
      {
        "gene_id": "ENSMUSG00000059552",
        "species_id": "10090"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tissue_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Uberon or CL ontology ID"
              },
              "tissue_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Anatomical entity name"
              },
              "expression_score": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Expression score (0-100)"
              },
              "score_confidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Confidence level (high/low)"
              },
              "expression_state": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "expressed or not expressed"
              },
              "quality": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Quality rating (gold/silver/bronze)"
              },
              "data_types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Data types supporting expression call"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Bgee_list_species",
    "description": "List all species available in the Bgee gene expression database. Returns species with taxonomy IDs, genome versions, and common names. Bgee currently covers 29+ animal species including major model organisms (human, mouse, zebrafish, fruit fly, C. elegans, rat) and additional vertebrates and invertebrates. Useful for discovering which species are available before querying gene expression data.",
    "parameter": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "fields": {
      "endpoint": "species_list"
    },
    "type": "BgeeTool",
    "test_examples": [
      {}
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "species_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "NCBI taxonomy ID"
              },
              "genus": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Genus name"
              },
              "species_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Species epithet"
              },
              "common_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Common name"
              },
              "genome_version": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Genome assembly version"
              },
              "full_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Full binomial name"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
