  {
    "name": "ZFIN_search",
    "description": "Search zebrafish (Danio rerio) genes in Alliance/ZFIN by symbol, synonym, name, or keyword. Returns exact total_results and recoverable offset pagination; continue with metadata.next_offset while has_more is true. Use each returned gene_id with ZFIN_get_gene for details.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Gene symbol or name to search for (e.g., 'tp53', 'sox9a', 'pax2a', 'fgf8a')"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of results (default: 10)",
          "default": 10
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based offset in the complete zebrafish gene result list. Continue with metadata.next_offset.",
          "default": 0
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "endpoint_type": "zfin_search"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "query": "tp53"
      },
      {
        "query": "sox9a"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_id": {
                "type": "string"
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "diseases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Diseases linked to this record"
              },
              "automated_description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Alliance's generated one-line description of the gene"
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gene_synopsis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "search_score": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Alliance's relevance score, which is the order the hits come back in"
              },
              "so_term": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Sequence Ontology type of the hit"
              },
              "related_data_counts": {
                "type": "object",
                "description": "How much of each kind of evidence the gene has, for picking a hit worth following up"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
