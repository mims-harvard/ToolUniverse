[
  {
    "name": "ZFIN_get_gene",
    "description": "Get detailed Danio rerio (zebrafish) gene information from ZFIN via the Alliance of Genome Resources. Returns gene symbol, name, synopsis, genomic location, synonyms, and cross-references. ZFIN is the primary database for zebrafish genetics. Example: 'ZFIN:ZDB-GENE-990415-8' returns pax2a (paired box 2a) with its role in nervous system development.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "ZFIN gene ID with 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-980526-166' (shha/sonic hedgehog a), 'ZFIN:ZDB-GENE-990415-72' (tp53/tumor protein p53), 'ZFIN:ZDB-GENE-030131-7740' (bmp4/bone morphogenetic protein 4)."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_detail"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-8"
      },
      {
        "gene_id": "ZFIN:ZDB-GENE-980526-166"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "species": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "short_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "taxon_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "data_provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "automated_gene_synopsis": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "so_term": {
              "type": [
                "string",
                "null"
              ]
            },
            "genomic_location": {
              "type": "object",
              "properties": {
                "chromosome": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "start": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "assembly": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "strand": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "curie": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "secondary_ids": {
              "type": "array",
              "description": "Retired accessions for the gene. Older literature cites these, and nothing else recovers them."
            },
            "cross_references_total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "xref_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cross_references_returned": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cross_references_truncated": {
              "type": "boolean"
            },
            "next_xref_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "notes": {
              "type": "array",
              "description": "Curator notes the model-organism database wrote about the gene",
              "items": {
                "type": "object",
                "properties": {
                  "note_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What kind of note this is, as the source database classifies it"
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The note's text"
                  }
                }
              }
            },
            "reference_curies": {
              "type": "array",
              "description": "Publication curies for the gene. Alliance lists thousands for a well-studied gene, so this is capped; reference_curies_total is the true count."
            },
            "reference_curies_total": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many publications Alliance links to the gene"
            },
            "reference_curies_returned": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many are carried on this response"
            },
            "reference_curies_truncated": {
              "type": "boolean",
              "description": "True when reference_curies is a prefix of the full list"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ZFIN_get_gene_phenotypes",
    "description": "Get phenotype annotations for a zebrafish gene from ZFIN via the Alliance of Genome Resources. Returns phenotypes observed when the gene is mutated or knocked out in zebrafish, including affected anatomical structures and phenotype statements. Zebrafish is widely used for forward genetic screens and disease modeling. Example: 'ZFIN:ZDB-GENE-990415-8' (pax2a) returns phenotypes related to eye, kidney, and nervous system development.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "ZFIN gene ID with 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-990415-72' (tp53), 'ZFIN:ZDB-GENE-980526-166' (shha)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of phenotypes to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_phenotypes"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-8",
        "limit": 10
      },
      {
        "gene_id": "ZFIN:ZDB-GENE-980526-166",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gene_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phenotype_statement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "references": {
                "type": "array",
                "description": "The publications behind this record",
                "items": {
                  "type": "object",
                  "properties": {
                    "agr_curie": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Alliance reference curie"
                    },
                    "pubmed_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "e.g. PMID:29735293"
                    },
                    "mod_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The model-organism database's own reference id"
                    },
                    "citation": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Short citation"
                    },
                    "cross_references": {
                      "type": "array",
                      "description": "Every curie Alliance cross-references, DOI included",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "inferred_allele": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The allele the phenotype was observed in"
              },
              "inferred_allele_synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Other names for that allele, which is how it is matched across databases"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Experimental conditions the phenotype was observed under; 'standard conditions' versus a treatment changes what the statement means"
              },
              "pubmed_publications": {
                "type": "array"
              },
              "annotation_count": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ZFIN_get_gene_orthologs",
    "description": "Get orthologs of a zebrafish gene across other species from the Alliance of Genome Resources. Returns orthologous genes in human, mouse, fly, worm, yeast, and other model organisms. Essential for translating zebrafish findings to human gene function. Zebrafish share approximately 70% of genes with humans. Example: 'ZFIN:ZDB-GENE-990415-8' (pax2a) returns human PAX2 as ortholog.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "ZFIN gene ID with 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-990415-72' (tp53), 'ZFIN:ZDB-GENE-980526-166' (shha)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of orthologs to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        },
        "stringency": {
          "type": "string",
          "description": "Stringency filter for orthology calls: 'stringent' (high confidence) or 'moderate'. Default: 'stringent'."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_orthologs"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-8",
        "limit": 10
      },
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-72",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_gene_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_species": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_best_score": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "is_best_score_reverse": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "method_count": {
                "type": "integer"
              },
              "methods_not_matched": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ortholog prediction methods that did NOT support the call, which is what makes method_count interpretable"
              },
              "stringency": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Which stringency band this ortholog row satisfies. The request asks for a stringency and the rows did not say what each one met."
              },
              "subject_taxon_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ortholog_taxon_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "relationship": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Alliance's category for the row: 'gene_to_gene_orthology' or 'gene_to_gene_paralogy'"
              },
              "is_paralogy": {
                "type": "boolean",
                "description": "True when the row is a paralogy call - a same-species relative, not an ortholog"
              },
              "similarity": {
                "type": [
                  "number",
                  "integer",
                  "null"
                ],
                "description": "Sequence similarity percent, paralogy rows only"
              },
              "identity": {
                "type": [
                  "number",
                  "integer",
                  "null"
                ],
                "description": "Sequence identity percent, paralogy rows only"
              },
              "alignment_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Aligned length in residues, paralogy rows only"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ZFIN_get_gene_alleles",
    "description": "Get alleles and variants for a zebrafish gene from ZFIN via the Alliance of Genome Resources. Returns mutant alleles with variant types (deletion, insertion, point mutation), molecular consequences, and phenotype/disease associations. Zebrafish genetics benefits from large-scale mutagenesis screens producing thousands of alleles. Example: 'ZFIN:ZDB-GENE-990415-8' (pax2a) returns alleles like szu2 (deletion) with start_lost consequence.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "ZFIN gene ID with 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-990415-72' (tp53), 'ZFIN:ZDB-GENE-980526-166' (shha)."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of alleles to return (1-100). Default: 20."
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination. Default: 1."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_alleles"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-8",
        "limit": 5
      },
      {
        "gene_id": "ZFIN:ZDB-GENE-990415-72",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "symbol_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "has_disease": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "has_phenotype": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The variant's id"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The variant's genomic HGVS"
                    },
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "e.g. point_mutation, deletion"
                    },
                    "location": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "chromosome": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "start": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "end": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "hgvs": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "most_severe_consequence": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The most severe predicted consequence"
                    }
                  }
                },
                "description": "The allele's variants. variants_total says how many it has; the list is cut to three."
              },
              "alliance_curie": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The curie Alliance's own endpoints take, which differs from the source database's primary id"
              },
              "synonyms": {
                "type": "array"
              },
              "alteration_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "variants_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many variants the record has, as opposed to how many are carried"
              },
              "variants_returned": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "How many variants are carried on this response"
              },
              "variants_truncated": {
                "type": "boolean",
                "description": "True when the variant list is a prefix"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ZFIN_get_gene_expression",
    "description": "Get expression annotations for a zebrafish gene from the Alliance of Genome Resources. Returns per-annotation records of developmental stage (whenExpressed) and anatomical location (whereExpressed) for the gene, plus the total annotation count. Example: 'ZFIN:ZDB-GENE-980526-166' (shha) has hundreds of annotations across developmental stages. Zebrafish is a premier model for vertebrate development.",
    "parameter": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "description": "ZFIN gene ID, with or without the 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-980526-166' (shha), 'ZFIN:ZDB-GENE-990415-72' (tp53)."
        },
        "limit": {
          "type": "integer",
          "description": "Max annotations to return (default 50, max 100).",
          "default": 50
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based annotation page. Continue with next_page while has_more is true."
        }
      },
      "required": [
        "gene_id"
      ]
    },
    "fields": {
      "endpoint_type": "gene_expression_summary"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "gene_id": "ZFIN:ZDB-GENE-980526-166",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_annotations": {
              "type": "integer"
            },
            "returned": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "page": {
              "type": "integer"
            },
            "total_pages": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            },
            "next_page": {
              "type": [
                "integer",
                "null"
              ]
            },
            "result_set_complete": {
              "type": "boolean"
            },
            "annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "data_provider": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ZFIN_get_allele",
    "description": "Get detailed information about a specific zebrafish allele from ZFIN via the Alliance of Genome Resources. Returns allele symbol, associated gene, alteration type, species, and synonyms. Useful for looking up specific zebrafish mutant lines. Example: 'ZFIN:ZDB-ALT-210706-1' returns the szu2 allele of pax2a with its deletion variant details.",
    "parameter": {
      "type": "object",
      "properties": {
        "allele_id": {
          "type": "string",
          "description": "ZFIN allele ID with 'ZFIN:' prefix. Examples: 'ZFIN:ZDB-ALT-210706-1' (szu2 allele of pax2a), 'ZFIN:ZDB-ALT-980203-1590' (tm243a allele of pax2a)."
        }
      },
      "required": [
        "allele_id"
      ]
    },
    "fields": {
      "endpoint_type": "allele_detail"
    },
    "type": "AllianceGenomeTool",
    "test_examples": [
      {
        "allele_id": "ZFIN:ZDB-ALT-210706-1"
      },
      {
        "allele_id": "ZFIN:ZDB-ALT-980203-1590"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "species": {
              "type": [
                "string",
                "null"
              ]
            },
            "alteration_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "gene_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "gene_symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "synonyms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "has_phenotype": {
              "type": "boolean"
            },
