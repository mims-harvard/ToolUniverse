[
  {
    "name": "EBIProteins_get_interactions",
    "description": "Get experimentally supported protein interaction partners from the EBI Proteins API/IntAct, sorted by supporting experiment count. Use limit and offset to page through all partners; inspect total_interactions, interactions_truncated, and next_offset. TP53 currently has well over 100 distinct partners.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession of the query protein. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (insulin)."
        },
        "limit": {
          "type": "integer",
          "description": "Interaction partners returned per page (default 50, maximum 500).",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset in the experiment-count-sorted interaction list.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "interactions"
    },
    "type": "EBIProteinsInteractionsTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query_accession": {
              "type": "string"
            },
            "interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "partner_accession": {
                    "type": "string",
                    "description": "UniProt accession of the interaction partner"
                  },
                  "gene_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene name of the interaction partner"
                  },
                  "experiments": {
                    "type": "integer",
                    "description": "Number of supporting experiments"
                  },
                  "organism_differ": {
                    "type": "boolean",
                    "description": "Whether the partner is from a different organism"
                  },
                  "intact_id_a": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "intact_id_b": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Binary protein-protein interactions"
            },
            "total_interactions": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "interactions_returned": {
              "type": "integer"
            },
            "interactions_truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_interaction_details",
    "description": "Get protein metadata, disease associations, subcellular locations, and a paginated experiment-count-sorted interaction list from the EBI Proteins API. Use limit/offset and inspect total_interactions, interactions_truncated, and next_offset to retrieve every partner.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession of the query protein. Examples: 'P04637' (TP53), 'P00533' (EGFR)."
        },
        "limit": {
          "type": "integer",
          "description": "Interaction partners returned per page (default 50, maximum 500).",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset in the experiment-count-sorted interaction list.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "interaction_details"
    },
    "type": "EBIProteinsInteractionsTool",
    "test_examples": [
      {
        "accession": "P04637"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query_accession": {
              "type": "string"
            },
            "protein_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "protein_existence": {
              "type": [
                "string",
                "null"
              ]
            },
            "organism": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_interaction_entries": {
              "type": "integer"
            },
            "top_interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "partner_accession": {
                    "type": "string"
                  },
                  "gene_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "experiments": {
                    "type": "integer"
                  },
                  "organism_differ": {
                    "type": "boolean"
                  }
                }
              },
              "description": "Top interaction partners sorted by experiment count"
            },
            "total_interactions": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "interactions_returned": {
              "type": "integer"
            },
            "interactions_truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "diseases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Associated disease names"
            },
            "subcellular_locations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Subcellular location terms"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
