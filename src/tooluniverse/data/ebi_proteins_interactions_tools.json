[
  {
    "name": "EBIProteins_get_interactions",
    "description": "Get experimentally supported protein interaction partners from the EBI Proteins API/IntAct, sorted by supporting experiment count. Use limit and offset to page through all partners; inspect total_interactions, interactions_truncated, and next_offset. TP53 currently has well over 100 distinct partners.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession of the query protein. Examples: 'P04637' (TP53), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (insulin)."
        },
        "limit": {
          "type": "integer",
          "description": "Interaction partners returned per page (default 50, maximum 500).",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset in the experiment-count-sorted interaction list.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "interactions"
    },
    "type": "EBIProteinsInteractionsTool",
    "test_examples": [
      {
        "accession": "P04637"
      },
      {
        "accession": "P00533"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query_accession": {
              "type": "string"
            },
            "interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "partner_accession": {
                    "type": "string",
                    "description": "UniProt accession of the interaction partner"
                  },
                  "gene_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Gene name of the interaction partner"
                  },
                  "experiments": {
                    "type": "integer",
                    "description": "Number of supporting experiments"
                  },
                  "organism_differ": {
                    "type": "boolean",
                    "description": "Whether the partner is from a different organism"
                  },
                  "intact_id_a": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "intact_id_b": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "description": "Binary protein-protein interactions"
            },
            "total_interactions": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "interactions_returned": {
              "type": "integer"
            },
            "interactions_truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "EBIProteins_get_interaction_details",
    "description": "Get protein metadata, disease associations, subcellular locations, and a paginated experiment-count-sorted interaction list from the EBI Proteins API. Use limit/offset and inspect total_interactions, interactions_truncated, and next_offset to retrieve every partner.",
    "parameter": {
      "type": "object",
      "properties": {
        "accession": {
          "type": "string",
          "description": "UniProt accession of the query protein. Examples: 'P04637' (TP53), 'P00533' (EGFR)."
        },
        "limit": {
          "type": "integer",
          "description": "Interaction partners returned per page (default 50, maximum 500).",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset in the experiment-count-sorted interaction list.",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "accession"
      ]
    },
    "fields": {
      "endpoint": "interaction_details"
    },
    "type": "EBIProteinsInteractionsTool",
    "test_examples": [
      {
        "accession": "P04637"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "query_accession": {
              "type": "string"
            },
            "protein_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "protein_existence": {
              "type": [
                "string",
                "null"
              ]
            },
            "organism": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_interaction_entries": {
              "type": "integer"
            },
            "top_interactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "partner_accession": {
                    "type": "string"
                  },
                  "gene_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "experiments": {
                    "type": "integer"
                  },
                  "organism_differ": {
                    "type": "boolean"
                  },
                  "intact_id_a": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "IntAct interactor id for the query protein, as the sibling tool returns"
                  },
                  "intact_id_b": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "IntAct interactor id for the partner"
                  }
                }
              },
              "description": "Top interaction partners sorted by experiment count"
            },
            "total_interactions": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "interactions_returned": {
              "type": "integer"
            },
            "interactions_truncated": {
              "type": "boolean"
            },
            "next_offset": {
              "type": [
                "integer",
                "null"
              ]
            },
            "diseases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Associated disease names"
            },
            "subcellular_locations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Subcellular location terms"
            },
            "disease_records": {
              "type": "array",
              "description": "The disease annotations behind `diseases`. `diseases` is the list of names of the records that have one; these carry the OMIM id, the definition and the evidence, and include the record that has no diseaseId at all -- TP53's free-text disease involvement paragraph, which the name list therefore dropped entirely.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "acronym": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference_database": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Usually MIM"
                  },
                  "reference_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidences": {
                    "type": "array",
                    "description": "Who says so: the ECO code and the publication, capped at 10 per record",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "source": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "url": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "subcellular_location_records": {
              "type": "array",
              "description": "The same locations as `subcellular_locations`, with the membrane topology, the orientation and the publications behind each",
              "items": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "topology": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "orientation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidences": {
                    "type": "array",
                    "description": "Who says so: the ECO code and the publication, capped at 10 per record",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "source": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "url": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
