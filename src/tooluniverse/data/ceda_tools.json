[
  {
    "name": "CEDA_search_datasets",
    "description": "Search the CEDA environmental data catalogue with a real case-insensitive Django filter over one selected field (title, abstract, or keywords). The API has no full-text OR query across fields; search_field defaults to title. Returns exact count and offset continuation metadata.",
    "parameter": {
      "type": "object",
      "properties": {
        "q": {
          "type": [
            "string",
            "null"
          ],
          "description": "Case-insensitive substring applied to search_field. Omit to list all observations."
        },
        "search_field": {
          "type": "string",
          "enum": [
            "title",
            "abstract",
            "keywords"
          ],
          "default": "title",
          "description": "Single CEDA field searched by q; the API cannot OR across these fields."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results to return (default 10, max 100)"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "required": []
    },
    "fields": {
      "endpoint": "https://catalogue.ceda.ac.uk/api/v2/observations.json",
      "params": {
        "limit": "10"
      },
      "pagination": "ceda_offset",
      "client_only_params": [
        "search_field"
      ]
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "q": "climate model temperature",
        "limit": 5
      },
      {
        "q": "sea surface temperature satellite",
        "limit": 5
      },
      {
        "q": "atmospheric CO2 measurements",
        "limit": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "CEDA dataset catalogue results",
          "properties": {
            "count": {
              "type": "integer",
              "description": "Total number of matching datasets"
            },
            "next": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL for next page"
            },
            "previous": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL for previous page"
            },
            "results": {
              "type": "array",
              "description": "List of datasets",
              "items": {
                "type": "object",
                "properties": {
                  "ob_id": {
                    "type": "integer",
                    "description": "Dataset ID"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Dataset UUID"
                  },
                  "title": {
                    "type": "string",
                    "description": "Dataset title"
                  },
                  "abstract": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Dataset description"
                  },
                  "keywords": {
                    "type": [
                      "array",
                      "string",
                      "null"
                    ],
                    "description": "Keywords/topics (space-separated string or array)"
                  },
                  "timePeriod": {
                    "type": [
                      "string",
                      "object",
                      "null"
                    ],
                    "description": "Temporal coverage (URL string or object with startTime/endTime)"
                  },
                  "geographicExtent": {
                    "type": [
                      "string",
                      "object",
                      "null"
                    ],
                    "description": "Geographic coverage (URL string or object)"
                  },
                  "phenomena": {
                    "type": "array",
                    "description": "Physical phenomena measured"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
