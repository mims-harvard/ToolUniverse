  {
    "name": "ReactomeAnalysis_expression_analysis",
    "description": "Quantitative EXPRESSION analysis: map tab-delimited GENE/value rows onto Reactome pathways. Each pathway carries matched expression values and the result reports column names and value range. Results are pageable; continue with data.next_page while data.has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": "string",
          "description": "Tab-delimited expression rows, one identifier per line as 'GENE<TAB>VALUE'. Newline-separated rows. Gene symbols, UniProt, or Ensembl IDs in the first column; numeric fold-change/expression value(s) in following tab-separated column(s). Example: 'PTEN\\t2.5\\nTP53\\t-1.8\\nEGFR\\t3.1'."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Number of pathways to return (default 20, max 50)."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "One-based pathway result page."
        },
        "include_disease": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Include disease pathways in results (default true)."
        },
        "projection": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Project identifiers to human pathways via orthology (default false; set true for non-human input)."
        }
      },
      "required": [
        "identifiers"
      ]
    },
    "fields": {
      "endpoint": "expression_analysis"
    },
    "type": "ReactomeAnalysisTool",
    "test_examples": [
      {
        "identifiers": "PTEN\t2.5\nTP53\t-1.8\nEGFR\t3.1",
        "page_size": 2
      },
      {
        "identifiers": "TP53\t-1.8\nBRCA1\t2.2\nEGFR\t3.1\nKRAS\t-0.5",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "token": {
              "type": [
                "string",
                "null"
              ]
            },
            "analysis_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Expected to be EXPRESSION"
            },
            "expression_column_names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Names of the submitted expression value columns"
            },
            "expression_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "expression_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "identifiers_not_found": {
              "type": "integer"
            },
            "pathways_found": {
              "type": "integer"
            },
            "pathways": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pathway_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "entities_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "entities_exp": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "description": "Matched expression values overlaid on this pathway"
                  },
                  "p_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fdr": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
