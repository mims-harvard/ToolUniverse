                    ]
                  },
                  "fdr": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "reactions_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reactions_total": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
