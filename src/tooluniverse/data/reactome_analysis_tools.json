[
  {
    "name": "ReactomeAnalysis_pathway_enrichment",
    "description": "Perform pathway overrepresentation analysis using Reactome. Submit gene symbols, UniProt IDs, or Ensembl IDs and retrieve enriched pathways with p-values, FDR, entity counts, and reaction coverage. Results are pageable; when data.has_more is true pass data.next_page as page with the same inputs.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": "string",
          "description": "Newline-separated list of gene/protein identifiers. Supports gene symbols (TP53, BRCA1), UniProt IDs (P04637, P38398), or Ensembl IDs. Example: 'TP53\\nBRCA1\\nCDH1\\nEGFR\\nKRAS'."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Number of pathways to return (default 20, max 50)."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "One-based pathway result page. Continue with data.next_page while data.has_more is true."
        },
        "include_disease": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Include disease pathways in results (default true)."
        },
        "projection": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Project identifiers to human Reactome pathways for cross-species analysis (default true)."
        }
      },
      "required": [
        "identifiers"
      ]
    },
    "fields": {
      "endpoint": "pathway_enrichment"
    },
    "type": "ReactomeAnalysisTool",
    "test_examples": [
      {
        "identifiers": "TP53\nBRCA1\nCDH1\nEGFR\nKRAS"
      },
      {
        "identifiers": "P04637\nP38398\nO15350\nP00533\nP01116",
        "page_size": 5
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "token": {
              "type": [
                "string",
                "null"
              ],
              "description": "Analysis token for retrieving results later"
            },
            "analysis_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "OVERREPRESENTATION or EXPRESSION"
            },
            "projection": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether projection was applied"
            },
            "identifiers_not_found": {
              "type": "integer",
              "description": "Count of unmatched identifiers"
            },
            "pathways_found": {
              "type": "integer",
              "description": "Total enriched pathways"
            },
            "pathways": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pathway_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "species": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_disease": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "is_lowest_level": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "entities_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "entities_total": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "entities_ratio": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "p_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fdr": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "reactions_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reactions_total": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "ReactomeAnalysis_species_comparison",
    "description": "Perform Reactome identifier projection: submit protein/gene identifiers and Reactome automatically maps them to human pathways. The endpoint does not accept a source-species filter; use ReactomeAnalysis_species_comparison_v2 for an explicit species-to-species pathway comparison. Results are pageable; continue with data.next_page while data.has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": "string",
          "description": "Newline-separated list of gene/protein identifiers from any species. Supports UniProt, Ensembl, or gene symbols. Example: 'Trp53\\nBrca1\\nCdh1' (mouse gene symbols)."
        },
        "species": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Unsupported by this Reactome endpoint. Supplying it returns an explicit error because it was previously ignored. Use ReactomeAnalysis_species_comparison_v2 for explicit species comparison."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Number of pathways to return (default 20, max 50)."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "One-based pathway result page."
        }
      },
      "required": [
        "identifiers"
      ]
    },
    "fields": {
      "endpoint": "species_comparison"
    },
    "type": "ReactomeAnalysisTool",
    "test_examples": [
      {
        "identifiers": "TP53\nBRCA1\nEGFR\nMYC\nPIK3CA"
      },
      {
        "identifiers": "P04637\nP38398",
        "page_size": 5
      }
    ],
    "return_schema": {
