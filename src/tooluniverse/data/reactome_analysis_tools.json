    }
  },
  {
    "name": "ReactomeAnalysis_species_comparison_v2",
    "description": "True cross-species pathway comparison using Reactome's /species/{source}/{target} endpoint. It compares the entire source pathway set against a target species by orthology. Results are pageable; continue with data.next_page while data.has_more is true.",
    "parameter": {
      "type": "object",
      "properties": {
        "species": {
          "type": "integer",
          "description": "Reactome species dbId of the species to compare against the source. NOTE: this is the Reactome dbId, not the NCBI taxonomy id. Example: 48892 = Mus musculus, 49646 = Rattus norvegicus, 68323 = Danio rerio."
        },
        "source_species": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source species name in Reactome lowerCamelCase form (default 'homoSapiens'). Examples: 'homoSapiens', 'musMusculus'."
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Number of pathways to return (default 20, max 50)."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "One-based pathway result page."
        }
      },
      "required": [
        "species"
      ]
    },
    "fields": {
      "endpoint": "species_comparison_v2"
    },
    "type": "ReactomeAnalysisTool",
    "test_examples": [
      {
        "species": 48892,
        "page_size": 3
      },
      {
        "species": 49646,
        "source_species": "homoSapiens",
        "page_size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "token": {
              "type": [
                "string",
                "null"
              ]
            },
            "analysis_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Expected to be SPECIES_COMPARISON"
            },
            "identifiers_not_found": {
              "type": "integer"
            },
            "pathways_found": {
              "type": "integer"
            },
            "pathways": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pathway_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "entities_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "p_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fdr": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
