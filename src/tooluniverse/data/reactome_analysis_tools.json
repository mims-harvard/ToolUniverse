              "type": "integer"
            },
            "pathways_found": {
              "type": "integer"
            },
            "pathways": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pathway_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "species": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_disease": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "entities_found": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "entities_total": {
                    "type": [
                      "integer",
