[
  {
    "name": "Anaconda_search_packages",
    "description": "Search Anaconda.org packages with explicit limit/offset pagination. The upstream default silently returns only 100 records and reports no total. ToolUniverse uses a one-record lookahead; continue with metadata.next_offset while metadata.has_more is true. Exact total_results is available only on the final short page; otherwise matches_lower_bound is reported.",
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Package name to search for (e.g., 'numpy', 'samtools', 'biopython', 'r-ggplot2')"
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Package type filter: 'conda' (default), 'pypi', or 'standard_python'"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "Packages per page (default 20, max 100)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based package offset. Continue with metadata.next_offset."
        }
      },
      "required": [
        "name"
      ]
    },
    "fields": {
      "endpoint": "https://api.anaconda.org/search",
      "pagination": "anaconda_offset_lookahead"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "name": "numpy"
      },
      {
        "name": "samtools",
        "type": "conda"
      },
      {
        "name": "biopython"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of matching conda packages from all channels",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Package name"
              },
              "full_name": {
                "type": "string",
                "description": "Full name with owner/channel (e.g., 'conda-forge/numpy')"
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Package owner or channel name"
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Brief package description"
              },
              "public": {
                "type": "boolean"
              },
              "access": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "latest_version": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Latest available version"
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "List of available version strings"
              },
              "platforms": {
                "type": "object",
                "description": "Platform availability map (e.g., {'linux-64': '1.26', 'osx-64': '1.26'})"
              },
              "package_types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Package types ('conda', 'pypi')"
              },
              "ndownloads": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Total download count"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "API URL for package details"
              },
              "html_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Web URL on anaconda.org"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Extended description"
              },
              "home": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Project homepage URL"
              },
              "builds": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "Every build string published, e.g. 'py39hf48478c_1' -- 1736 of them for numpy. The python and ABI tags are encoded in the string; there is no structured form of this."
              },
              "conda_platforms": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "Platforms the package has builds for, e.g. ['linux-64', 'osx-arm64', 'win-64', ...] (8 for numpy). A package absent from the caller's platform cannot be installed however popular it is."
              },
              "dev_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Development/source repository the recipe declares, e.g. 'https://github.com/numpy/numpy'. Present on only 1 of 20 search hits."
              },
              "doc_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Documentation URL the recipe declares, e.g. 'https://numpy.org/doc/stable/'. Present on only 1 of 20 search hits."
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Anaconda.org's internal package record id, e.g. '573efc1708df8671aa72838f'. Not the package name and not citable; use owner+name."
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Licence as the package metadata declares it, e.g. 'BSD-3-Clause'. Present on 14 of 20 search hits -- a missing licence is a blocker for redistribution, so absence here is a finding, not a detail."
              },
              "license_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "URL of the licence text when the recipe gave one. Measured null on all 20 search hits."
              },
              "revision": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Anaconda.org's monotonically increasing revision counter for the package record, e.g. 6636. Bumped by any change, so it is not a version number."
              },
              "source_git_tag": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Git tag the recipe built from. Measured null on all 20 search hits."
              },
              "source_git_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Git URL the recipe built from. Measured null on all 20 search hits."
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  },
  {
    "name": "Anaconda_get_package",
    "description": "Get detailed information about a specific conda package from a specific channel on Anaconda.org. Returns the package's full metadata including description, all versions, platform availability, download counts, home URL, license, and owner details. Use the format '{channel}/{package_name}' (e.g., 'conda-forge/numpy', 'bioconda/samtools', 'defaults/scipy').",
    "parameter": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel or owner name (e.g., 'conda-forge', 'bioconda', 'defaults', 'anaconda')"
        },
        "package_name": {
          "type": "string",
          "description": "Exact package name (e.g., 'numpy', 'samtools', 'biopython', 'r-ggplot2')"
        }
      },
      "required": [
        "channel",
        "package_name"
      ]
    },
    "fields": {
      "endpoint": "https://api.anaconda.org/package/{channel}/{package_name}"
    },
    "type": "BaseRESTTool",
    "test_examples": [
      {
        "channel": "conda-forge",
        "package_name": "numpy"
      },
      {
        "channel": "bioconda",
        "package_name": "samtools"
      },
      {
        "channel": "conda-forge",
        "package_name": "scipy"
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "description": "Full package details from Anaconda.org",
          "properties": {
            "name": {
              "type": "string"
            },
            "full_name": {
              "type": "string",
              "description": "Channel/package name"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ],
              "description": "Brief package summary"
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Extended description"
            },
            "home": {
              "type": [
                "string",
                "null"
              ],
              "description": "Project homepage URL"
            },
            "public": {
              "type": "boolean"
            },
            "owner": {
              "type": "object",
              "description": "Channel/owner details",
              "properties": {
                "login": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "user_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "API URL for package details"
                },
                "company": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Company of the owning account. Measured null."
                },
                "created_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "When the owning account was created, e.g. '2015-04-11 10:15:08.727000+00:00'."
                },
                "location": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Location of the owning account. Measured null."
                }
              }
            },
            "versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "All available version strings"
            },
            "latest_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "platforms": {
              "type": "object",
              "description": "Platform -> latest version mapping"
            },
            "package_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ndownloads": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Total download count"
            },
            "html_url": {
              "type": [
                "string",
                "null"
              ],
              "description": "Web URL on anaconda.org"
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "description": "API URL for package details"
            },
            "access": {
              "type": [
                "string",
                "null"
              ],
              "description": "Who may fetch the package, e.g. 'public'."
            },
            "builds": {
              "type": [
                "array",
                "null"
              ],
              "description": "Every build string published, e.g. 'py39hf48478c_1' -- 1736 of them for numpy. The python and ABI tags are encoded in the string; there is no structured form of this."
            },
            "conda_platforms": {
              "type": [
                "array",
                "null"
              ],
              "description": "Platforms the package has builds for, e.g. ['linux-64', 'osx-arm64', 'win-64', ...] (8 for numpy). A package absent from the caller's platform cannot be installed however popular it is."
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the package was first published, e.g. '2020-06-06 23:22:39.637000+00:00'. A space, not a 'T', between date and time."
            },
            "dev_url": {
              "type": [
                "string",
                "null"
              ],
              "description": "Development/source repository the recipe declares, e.g. 'https://github.com/numpy/numpy'. Present on only 1 of 20 search hits."
            },
            "doc_url": {
              "type": [
                "string",
                "null"
              ],
              "description": "Documentation URL the recipe declares, e.g. 'https://numpy.org/doc/stable/'. Present on only 1 of 20 search hits."
            },
            "files": {
              "type": [
                "array",
                "null"
              ],
              "description": "Every distributed file, each with its own version, platform, size, upload date and dependency block -- 3868 entries for numpy. This is the full inventory and it is large; prefer releases for a version overview."
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Anaconda.org's internal package record id, e.g. '573efc1708df8671aa72838f'. Not the package name and not citable; use owner+name."
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "description": "Licence as the package metadata declares it, e.g. 'BSD-3-Clause'. Present on 14 of 20 search hits -- a missing licence is a blocker for redistribution, so absence here is a finding, not a detail."
            },
            "modified_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When the package record last changed, e.g. '2026-10-11 00:56:55.129000+00:00'."
            },
            "releases": {
              "type": [
                "array",
                "null"
              ],
              "description": "One entry per version, each {version, distributions}, e.g. {'version': '1.11.0', 'distributions': [...]} -- 118 for numpy. The compact view of what versions exist."
            },
            "revision": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Anaconda.org's monotonically increasing revision counter for the package record, e.g. 6636. Bumped by any change, so it is not a version number."
            },
            "upvoted": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Count of upvotes on Anaconda.org, e.g. 0. Near-zero even for numpy, so it is not a usage signal."
            },
            "watchers": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Count of watchers, e.g. 1. Like upvoted, not a popularity measure -- the download counts in files are."
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
]
