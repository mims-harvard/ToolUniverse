                "string",
                "null"
              ]
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "type": [
                "integer",
                "null"
              ]
            },
            "history": {
              "type": "array"
            },
            "children": {
              "type": [
                "object",
                "array"
              ]
            },
            "precursors": {
              "type": "array"
            },
            "revocations": {
              "type": "array"
            },
            "external_references": {
              "type": "object"
            }
          },
          "required": [
