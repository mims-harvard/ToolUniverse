[
  {
    "name": "OncoTree_search",
    "type": "OncoTreeSearchTool",
    "description": "Search the OncoTree cancer type ontology by name, code, main type, or tissue. Returns every upstream field for each matched tumor type, including color, hierarchy children, history, precursors, revocations, and UMLS/NCI references. An upstream HTTP 404 for no matches is normalized to a successful empty result. Exact name/code searches are checked against every returned record; metadata confirms source-record completeness and the requested version.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search term. Interpreted according to the 'field' parameter. Examples: 'breast cancer', 'BRCA', 'Lung', 'Non-Small Cell Lung Cancer'."
        },
        "field": {
          "type": "string",
          "description": "Field to search in. One of: 'name' (cancer type name), 'code' (OncoTree code), 'main_type' (main cancer category), 'tissue' (tissue of origin). Default: 'name'.",
          "enum": [
            "name",
            "code",
            "main_type",
            "tissue"
          ],
          "default": "name"
        },
        "exact_match": {
          "type": "boolean",
          "description": "If true, requires exact match. If false (default), performs substring/prefix matching.",
          "default": false
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "OncoTree version identifier. Use 'oncotree_latest_stable' (default) for the current production version.",
          "default": "oncotree_latest_stable"
        }
      },
      "required": [
        "query"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "main_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tissue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "color": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "history": {
                "type": "array"
              },
              "children": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "precursors": {
                "type": "array"
              },
              "revocations": {
                "type": "array"
              },
              "external_references": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "test_examples": [
      {
        "query": "breast cancer",
        "field": "name"
      },
      {
        "query": "LUAD",
        "field": "code",
        "exact_match": true
      },
      {
        "query": "Lung",
        "field": "tissue"
      }
    ],
    "label": [
      "OncoTree",
      "Cancer",
      "Oncology",
      "Classification"
    ],
    "metadata": {
      "tags": [
        "cancer",
        "oncology",
        "tumor type",
        "classification",
        "MSK",
        "UMLS",
        "NCI"
      ],
      "estimated_execution_time": "1-2 seconds"
    }
  },
  {
    "name": "OncoTree_get_type",
    "type": "OncoTreeGetTypeTool",
    "description": "Get complete information about one OncoTree cancer type by exact code (e.g. 'BRCA', 'LUAD', 'GBM'). The wrapper requires one unique upstream result and verifies its code before success. Returns name, main type, tissue, hierarchy, color, history, children, precursors, revocations, and UMLS/NCI references. A missing code returns an explicit not-found error rather than a generic HTTP error.",
    "parameter": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "OncoTree cancer type code (case-insensitive). Examples: 'BRCA' (Invasive Breast Carcinoma), 'LUAD' (Lung Adenocarcinoma), 'GBM' (Glioblastoma Multiforme), 'PAAD' (Pancreatic Adenocarcinoma)."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "OncoTree version. Default: 'oncotree_latest_stable'.",
          "default": "oncotree_latest_stable"
        }
      },
      "required": [
        "code"
      ]
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
