      "type": "object",
      "properties": {
        "rnacentral_id": {
          "type": "string",
          "minLength": 1,
          "description": "RNAcentral URS identifier (e.g., 'URS000039ED8D' for hsa-miR-21-5p). Use base URS ID without taxid suffix."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Number of cross-references per page (1-50)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based RNAcentral page number. Continue with next_page."
        }
      },
      "required": [
        "rnacentral_id"
      ]
    },
    "fields": {
