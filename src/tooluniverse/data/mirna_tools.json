[
  {
    "name": "miRBase_search_mirna",
    "description": "Search for microRNAs by name, accession, or keyword using EBI Search over RNAcentral. Results use exact offset pagination: total_hits reports all matches and, while has_more is true, pass next_start as start with the same query and filters. Returns RNAcentral IDs, descriptions, sequence lengths, and source databases.",
    "parameter": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search query: miRNA name (e.g., 'hsa-miR-21-5p'), miRBase accession (e.g., 'MIMAT0000076'), gene name, or keyword. Supports AND/OR operators."
        },
        "species": {
          "type": "string",
          "description": "Species name filter (e.g., 'Homo sapiens', 'Mus musculus', 'Drosophila melanogaster'). Leave empty for all species."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Number of results per page (1-100)."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based EBI Search result offset. Continue with next_start."
        }
      },
      "required": [
        "query"
      ]
    },
    "fields": {
      "rna_type_filter": "miRNA"
    },
    "type": "miRNASearchTool",
    "test_examples": [
      {
        "query": "hsa-miR-21-5p",
        "size": 5
      },
      {
        "query": "let-7",
        "species": "Homo sapiens",
        "size": 5
      },
      {
        "query": "MIMAT0000076",
        "size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_hits": {
              "type": "integer",
              "description": "Total number of matching miRNA entries"
            },
            "returned": {
              "type": "integer",
              "description": "Number of entries returned in this response"
            },
            "start": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_start": {"type": ["integer", "null"]},
            "truncated": {"type": "boolean"},
            "result_set_complete": {"type": "boolean"},
            "entries": {
              "type": "array",
              "description": "List of miRNA entries with IDs, descriptions, and metadata",
              "items": {
                "type": "object",
                "properties": {
                  "rnacentral_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "rna_type": {
                    "type": "string"
                  },
                  "length": {
                    "type": "integer"
                  },
                  "expert_databases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "has_secondary_structure": {
                    "type": "boolean"
                  },
                  "has_genomic_coordinates": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": ["total_hits", "returned", "start", "has_more", "next_start", "truncated", "result_set_complete", "entries"]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "miRNA",
      "miRBase",
      "RNAcentral",
      "Search"
    ],
    "metadata": {
      "tags": [
        "mirna",
        "microrna",
        "ncrna",
        "mirbase",
        "rnacentral",
        "search"
      ],
      "estimated_execution_time": "< 3 seconds"
    }
  },
  {
    "name": "miRBase_get_mirna",
    "description": "Get detailed miRNA information from RNAcentral including full RNA sequence, species, RNA type, gene associations, publication count, and source databases. For species-specific metadata, use URS_TAXID (for example URS000039ED8D_9606) or pass the same positive integer taxid with a base URS ID; the returned record identity and taxid are verified. A bare URS without taxid is a cross-species sequence record, so species is intentionally empty and publications_count may be null when RNAcentral supplies only a publications URL. Conflicting or nonexistent species identifiers return an error instead of falling back to another organism.",
    "parameter": {
      "type": "object",
      "properties": {
        "rnacentral_id": {
          "type": "string",
          "pattern": "^URS[0-9A-Fa-f]{10}(?:_[1-9][0-9]*)?$",
          "description": "RNAcentral URS identifier. Use species-specific format 'URS_TAXID' (e.g., 'URS000039ED8D_9606') or base URS ID (e.g., 'URS000039ED8D') with taxid parameter."
        },
        "taxid": {
          "type": "integer",
          "minimum": 1,
          "description": "NCBI Taxonomy ID for species-specific lookup (e.g., 9606 for human, 10090 for mouse). Optional if rnacentral_id already includes taxid."
        }
      },
      "required": [
        "rnacentral_id"
      ]
    },
    "fields": {
      "endpoint": "get_rna"
    },
    "type": "miRNAGetTool",
    "test_examples": [
      {
        "rnacentral_id": "URS000039ED8D",
        "taxid": 9606
      },
      {
        "rnacentral_id": "URS0000D54CAD",
        "taxid": 9606
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "rnacentral_id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "short_description": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            },
            "length": {
              "type": "integer"
            },
            "rna_type": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "taxid": {
              "type": [
                "integer",
                "null"
              ]
            },
            "genes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "publications_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Species-specific publication count, or null when a bare cross-species URS record exposes only a publications URL."
            },
            "is_active": {
              "type": "boolean"
            },
            "distinct_databases": {
              "type": [
                "string",
                "array",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "miRNA",
      "miRBase",
      "RNAcentral",
      "Sequence"
    ],
    "metadata": {
      "tags": [
        "mirna",
        "microrna",
        "sequence",
        "ncrna",
        "mirbase",
        "rnacentral"
      ],
      "estimated_execution_time": "< 2 seconds"
    }
  },
  {
    "name": "miRBase_get_mirna_publications",
    "description": "Retrieve publications associated with a microRNA from RNAcentral with explicit page pagination. miR-21-5p has hundreds of records; while has_more is true, pass next_page as page. Metadata warns that RNAcentral can repeat a PMID with different source metadata, so total_publications is a source-record count rather than a guaranteed unique-PMID count.",
    "parameter": {
      "type": "object",
      "properties": {
        "rnacentral_id": {
          "type": "string",
          "minLength": 1,
          "description": "RNAcentral URS identifier (e.g., 'URS000039ED8D' for hsa-miR-21-5p). Use base URS ID without taxid suffix."
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10,
          "description": "Number of publications per page (1-50)."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "One-based RNAcentral page number. Continue with next_page."
        }
      },
      "required": [
        "rnacentral_id"
      ]
    },
    "fields": {
      "endpoint": "get_publications"
    },
    "type": "miRNAGetTool",
    "test_examples": [
      {
        "rnacentral_id": "URS000039ED8D",
        "page_size": 5
      },
      {
        "rnacentral_id": "URS0000D54CAD",
        "page_size": 3
      }
    ],
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_publications": {
              "type": "integer",
              "description": "Total number of publications for this RNA"
            },
            "returned": {
              "type": "integer",
              "description": "Number returned in this page"
            },
            "page": {"type": "integer"},
            "page_size": {"type": "integer"},
            "has_more": {"type": "boolean"},
            "next_page": {"type": ["integer", "null"]},
            "previous_page": {"type": ["integer", "null"]},
            "truncated": {"type": "boolean"},
            "result_set_complete": {"type": "boolean"},
            "publications": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "publication": {
                    "type": "string"
                  },
                  "pubmed_id": {
                    "type": "string"
                  },
                  "doi": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expert_db": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": ["total_publications", "returned", "page", "page_size", "has_more", "next_page", "previous_page", "truncated", "result_set_complete", "publications"]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "description": "Error message if the request failed"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "label": [
      "miRNA",
      "miRBase",
      "RNAcentral",
      "Publications"
    ],
    "metadata": {
      "tags": [
        "mirna",
        "publications",
        "literature",
        "pubmed",
        "rnacentral"
      ],
      "estimated_execution_time": "< 5 seconds"
    }
  },
  {
    "name": "miRBase_get_mirna_xrefs",
