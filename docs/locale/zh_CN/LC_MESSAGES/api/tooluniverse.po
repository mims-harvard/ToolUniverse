#: 8c5fd5526a1b4f05be9c2d54bf72ef80 of
#: tooluniverse.drug_synergy_tool.DrugSynergyTool._calculate_bliss:3
msgid ""
"Bliss model: E_expected = E_a + E_b - E_a * E_b Synergy score = "
"E_combination - E_expected Positive score = synergy; Negative = "
"antagonism."
msgstr ""

#: 14077a0c02bc4a93ada6f4f393a56dc9 of
#: tooluniverse.drug_synergy_tool.DrugSynergyTool._calculate_bliss:7
