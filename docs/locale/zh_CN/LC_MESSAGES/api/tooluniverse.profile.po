#: 03cb630df0394841a3ee8e2df97d85e2 of tooluniverse.profile:1
msgid "ToolUniverse Profile Configuration Management"
msgstr ""

#: dac0b641970246f7b21028549673f8bf of tooluniverse.profile:3
msgid ""
"This module provides tools for loading, validating, and managing "
"ToolUniverse Profile configurations. Profile allows users to define "
"collections of tools with specific configurations, LLM settings, and "
"hooks for advanced scientific workflows."
msgstr ""

#: abc5f1585ae542baa21323ad892259c6 of tooluniverse.profile:7
msgid ""
"Main Components: - ProfileLoader: Loads Profile configurations from "
"various sources (HuggingFace, local files, URLs) - ProfileValidator: "
"Validates Profile configurations using JSON Schema - ValidationError: "
"Exception raised when configuration validation fails"
msgstr ""

