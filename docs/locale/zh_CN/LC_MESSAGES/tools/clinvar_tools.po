msgstr ""

#: ../../tools/clinvar_tools.rst:116 e6324471d286410098002ce97a563f79
msgid ""
"``gene_symbol`` (string, null) (optional) Alias for gene. HGNC gene "
"symbol (e.g., \"DPYD\", \"CYP2C19\")."
msgstr ""

#: ../../tools/clinvar_tools.rst:119 80b47a18120445249de0f60bf4bf45a2
msgid ""
"``significance`` (string, null) (optional) Alias for "
"clinical\\_significance (e.g., \"pathogenic\", \"benign\", "
"\"uncertain\\_significance\")."
msgstr ""

#: ../../tools/clinvar_tools.rst:122 5e88952948354cbdaf0815a08806c3c5
