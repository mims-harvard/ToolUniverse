"provided."
msgstr ""

#: ../../tools/clinvar_tools.rst:98 5e7d248df55041c0b4970002d805eda4
msgid ""
"``gene`` (string) (optional) Gene name or symbol (e.g., 'BRCA1', 'BRCA2')"
" At least one of gene, condition, or variant\\_id must be provided."
msgstr ""

#: ../../tools/clinvar_tools.rst:101 9f735194d45c4153b0236f6ceaa1ef09
msgid ""
"``condition`` (string) (optional) Disease or condition name (e.g., "
"'breast cancer', 'diabetes') At least one of gene, condition, or "
"variant\\_id must be provided."
msgstr ""

#: ../../tools/clinvar_tools.rst:104 e52b0c685a644c3cba0ab38afd35bbf3
msgid ""
"``variant_id`` (string) (optional) ClinVar variant ID (e.g., '12345') At "
"least one of gene, condition, or variant\\_id must be provided."
msgstr ""

#: ../../tools/clinvar_tools.rst:107 8b56f3b0909842eeb6edbf0c60fffe68
msgid ""
"``max_results`` (integer) (optional) Maximum number of results to return "
"(default: 20). Alias: limit."
msgstr ""

#: ../../tools/clinvar_tools.rst:110 7930da4a0fa04af1a567d2fe1f74714a
msgid ""
