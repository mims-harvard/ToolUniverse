#: ../../tools/sabiork_tools.rst:32 bd43f1a7eaf24e1b94d824aec6406cb1
msgid ""
"**Description**: Search SABIO-RK database for biochemical reaction "
"kinetic parameters. Returns Km, kcat, Vmax, Ki values with substrate "
"specificity, organism, and literature references. No authentication "
"required. Search by EC number (e.g., 1.1.1.1), enzyme name (e.g., alcohol"
" dehydrogenase), substrate (e.g., ethanol), organism (e.g., Homo "
"sapiens), or product. SABIO-RK contains >200,000 kinetic entries curated "
"from published literature."
msgstr ""

#: ../../tools/sabiork_tools.rst:34 2bd5e1bf487642238634a491bb919b3f
msgid "**Parameters:**"
msgstr ""

#: ../../tools/sabiork_tools.rst:36 82a0696d0c5d431493b228e41ba50d71
msgid ""
"``operation`` (string) (optional) Operation type (fixed: "
"search\\_reactions)"
msgstr ""

#: ../../tools/sabiork_tools.rst:39 b00b4d65546744619dabb8b3760d8820
msgid ""
"``ec_number`` (string) (optional) EC number (e.g., 1.1.1.1 for alcohol "
"dehydrogenase, 2.7.1.1 for hexokinase)"
msgstr ""

#: ../../tools/sabiork_tools.rst:42 1724d3d81b6049a1abe73b80297332cd
msgid ""
"``enzyme_name`` (string) (optional) Enzyme common name (e.g., alcohol "
"dehydrogenase, hexokinase, lactate dehydrogenase)"
msgstr ""

#: ../../tools/sabiork_tools.rst:45 0eed9d58f3a84c2da1e31fb5ddd7ba39
msgid ""
"``substrate`` (string) (optional) Substrate name (e.g., ethanol, glucose,"
" ATP)"
msgstr ""

#: ../../tools/sabiork_tools.rst:48 9cc685e4d6d1476980ec299896e85102
msgid ""
"``organism`` (string) (optional) Organism name (e.g., Homo sapiens, "
"Escherichia coli, Saccharomyces cerevisiae)"
msgstr ""

#: ../../tools/sabiork_tools.rst:51 410be1a2539b45f493a3d657b53cc4d7
msgid ""
"``product`` (string) (optional) Product name (e.g., acetaldehyde, "
"pyruvate)"
msgstr ""

#: ../../tools/sabiork_tools.rst:54 34dd488961a6478f84f0945f13a7dd82
msgid ""
"``parameter_type`` (string) (optional) Filter by kinetic parameter type "
"(e.g., Km, kcat, Vmax, Ki)"
msgstr ""

#: ../../tools/sabiork_tools.rst:57 37ab32e9e38f41c28763a3e048f19f1b
