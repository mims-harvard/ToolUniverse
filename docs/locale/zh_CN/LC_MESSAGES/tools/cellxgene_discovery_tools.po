#: ../../tools/cellxgene_discovery_tools.rst:93
#: 498f6a4e5aae40a6b286654e39b62a29
msgid ""
"**Description**: Search CellxGene Discovery single-cell RNA-seq datasets "
"by tissue, disease, organism, or cell type. The platform hosts 2,000+ "
"datasets with detailed cell-type annotations. Supports flexible text-"
"based filtering: 'lung' returns 134 lung datasets, 'brain' returns 144, "
"'T cell' returns 667, 'cancer' returns 193. Results sorted by cell count "
"(largest first)."
msgstr ""

#: ../../tools/cellxgene_discovery_tools.rst:97
#: 27617a2fbd41415ea99fa406d93d5a68
msgid ""
"``tissue`` (string) (optional) Filter by tissue name (e.g., 'lung', "
"'brain', 'heart', 'kidney', 'liver'). Case-insensitive partial match."
msgstr ""

#: ../../tools/cellxgene_discovery_tools.rst:100
#: 21583331aa7f4fac9b934cdde4c83a5d
msgid ""
"``disease`` (string) (optional) Filter by disease (e.g., 'cancer', "
"'COVID', 'Alzheimer', 'normal'). Case-insensitive partial match."
msgstr ""

#: ../../tools/cellxgene_discovery_tools.rst:103
#: 157a8464690d4bfbb4ac5013eb37ada6
msgid ""
"``organism`` (string) (optional) Filter by organism (e.g., 'Homo "
"sapiens', 'Mus musculus'). Case-insensitive partial match."
msgstr ""

#: ../../tools/cellxgene_discovery_tools.rst:106
#: 0276d9c436584b198ecef637122e502b
msgid ""
"``cell_type`` (string) (optional) Filter by cell type (e.g., 'T cell', "
"'neuron', 'macrophage', 'epithelial'). Case-insensitive partial match."
msgstr ""

#: ../../tools/cellxgene_discovery_tools.rst:109
#: 1907444060384b6ab10cb59bf589043d
msgid ""
"``limit`` (integer) (optional) Maximum datasets to return (1-100). "
"Default: 20."
msgstr ""

