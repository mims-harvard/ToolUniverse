#: ../../tools/uniprot_ref_tools.rst:185 3935b0a1aa8d4651b16352e12e94ecd3
msgid ""
"Search UniProt reference proteomes by organism name, taxon ID, or "
"keyword. Returns proteome IDs, ..."
msgstr ""

#: ../../tools/uniprot_ref_tools.rst f2ff2f1565054ec5959591570d16b6ad
msgid "UniProtRef_search_proteomes tool specification"
msgstr ""

#: ../../tools/uniprot_ref_tools.rst:191 13ecf2f2bf6c4cf7815e1066aa7c6af7
msgid "**Name**: ``UniProtRef_search_proteomes``"
msgstr ""

#: ../../tools/uniprot_ref_tools.rst:193 fa816e88029541b18b0966b9a8d63a96
msgid ""
"**Description**: Search UniProt reference proteomes by organism name, "
"taxon ID, or keyword. Returns proteome IDs, organism names, proteome "
"types, and total protein counts. Use this to find the reference proteome "
"ID for an organism before using UniProtRef\\_get\\_proteome for detailed "
"data. Example: searching 'Arabidopsis thaliana' returns UP000006548 "
"(reference proteome with 39K+ proteins)."
msgstr ""

#: ../../tools/uniprot_ref_tools.rst:197 7cdf5b992b364cf9a62d440ec55f19ca
msgid ""
"``query`` (string) (required) Search query for proteomes. Can be organism"
" name or taxon ID. Examples: 'homo sapiens', 'mouse', 'Arabidopsis "
"thaliana', '9606', 'Escherichia coli'."
msgstr ""

