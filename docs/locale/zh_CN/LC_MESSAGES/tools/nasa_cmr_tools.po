#: ../../tools/nasa_cmr_tools.rst:64 a211b04be2a14710b091952e36cad901
msgid ""
"Search NASA CMR for individual granules (data files/scenes) within Earth "
"observation collections...."
msgstr ""

#: ../../tools/nasa_cmr_tools.rst b1af20a60da1462cbd6201a3f457e424
msgid "NASACMR_search_granules tool specification"
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:70 8ccab59e7bef4575b1283e5f8bd1ac1f
msgid "**Name**: ``NASACMR_search_granules``"
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:72 afd8b623cd014af5ad73e1639efb070f
msgid ""
"**Description**: Search NASA CMR for individual granules (data "
"files/scenes) within Earth observation collections. Granules are the "
"individual data files (e.g., a single day's MODIS image, one Landsat "
"scene). Search by collection concept ID, bounding box, time range, or "
"keyword. Returns file metadata including download links, spatial "
"coverage, and temporal information. Useful for finding specific satellite"
" data files to download."
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:76 0766b7c7878b46df8690fdf13e86a4f1
msgid ""
"``concept_id`` (string, null) (optional) Parent collection concept ID "
"(e.g., 'C2036882064-POCLOUD'). Get from NASACMR\\_search\\_collections."
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:79 e9c25ff20eec4e27ac450ea2648dcd5e
msgid ""
"``short_name`` (string, null) (optional) Collection short name (e.g., "
"'MYD11A1', 'MODIS\\_A-JPL-L2P-v2019.0')"
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:82 c985fc2baf2e4126b7d5db03f8a05992
msgid ""
"``temporal`` (string, null) (optional) Temporal range in format 'YYYY-MM-"
"DD,YYYY-MM-DD'. Examples: '2020-01-01,2020-01-31', "
"'2023-06-01,2023-06-30'"
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:85 b88f6d2f8aa142b79cc21c4868c08571
msgid ""
"``bounding_box`` (string, null) (optional) Spatial bounding box: "
"'west,south,east,north' in decimal degrees. Example: '-10,35,10,55' for "
"Western Europe"
msgstr ""

#: ../../tools/nasa_cmr_tools.rst:88 185bb702a92a477eb71e4de228d728dc
msgid ""
"``page_size`` (integer, null) (optional) Number of results (default 10, "
"max 2000)"
msgstr ""

