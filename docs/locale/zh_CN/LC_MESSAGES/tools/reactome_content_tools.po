#: ../../tools/reactome_content_tools.rst 09c8cd1d29d64727b19381a6f61b078c
msgid "ReactomeContent_search tool specification"
msgstr ""

#: ../../tools/reactome_content_tools.rst:92 712ef48d062f4a0999e7d47e032e46ce
msgid "**Name**: ``ReactomeContent_search``"
msgstr ""

#: ../../tools/reactome_content_tools.rst:94 dc025febfb5f4a37a0d4ebff5260931b
msgid ""
"**Description**: Search Reactome for pathways, reactions, and biological "
"entities by keyword. Performs free-text search across Reactome's "
"knowledge base of biological pathways. Supports filtering by species and "
"entity type. Example: searching 'apoptosis' in Homo sapiens returns "
"pathways like R-HSA-109581 (Apoptosis), R-HSA-169911 (Regulation of "
"Apoptosis), R-HSA-9635465 (Suppression of apoptosis). Use this to "
"discover relevant pathways before querying their details."
msgstr ""

#: ../../tools/reactome_content_tools.rst:98 c6bcddca3e0440f2a63006b339f9a5ff
msgid ""
"``query`` (string) (required) Search query. Examples: 'apoptosis', "
"'TP53', 'cell cycle', 'DNA repair', 'insulin signaling'."
msgstr ""

#: ../../tools/reactome_content_tools.rst:101 576ac0480fdc433194b1900a1b306c0f
msgid ""
"``species`` (string) (optional) Species name for filtering results. "
"Default: 'Homo sapiens'. Other options: 'Mus musculus', 'Rattus "
"norvegicus', 'Danio rerio', 'Drosophila melanogaster'."
msgstr ""

#: ../../tools/reactome_content_tools.rst:104 83f5f23beef941ee920aab00a8841f58
msgid ""
"``types`` (string) (optional) Entity type to search. Options: 'Pathway', "
"'Reaction', 'Complex', 'Protein', 'SmallMolecule'. Default: 'Pathway'."
msgstr ""

