msgid "**Parameters:**"
msgstr ""

#: ../../tools/reactome_content_tools.rst:36 58144b0c650e4e159150ae4dd97aebab
msgid ""
"``identifier`` (string) (required) Reactome pathway stable identifier. "
"Examples: 'R-HSA-109581' (Apoptosis, 177 events), 'R-HSA-69278' (Cell "
"Cycle), 'R-HSA-73857' (RNA Polymerase II Transcription), 'R-HSA-1640170' "
"(Cell Cycle Checkpoints)."
msgstr ""

