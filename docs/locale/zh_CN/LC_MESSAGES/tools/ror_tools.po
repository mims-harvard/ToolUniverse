msgstr ""

#: ../../tools/ror_tools.rst:36 5d0a4ff86ef54b27871b7fb076a9dc45
msgid ""
"``ror_id`` (string) (required) ROR identifier. Can be the short ID (e.g.,"
" '042nb2s44') or full URL (e.g., 'https://ror.org/042nb2s44'). Find IDs "
"using ROR\\_search\\_organizations."
msgstr ""

