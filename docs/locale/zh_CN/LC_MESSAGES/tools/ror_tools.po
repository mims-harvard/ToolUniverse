#: ../../tools/ror_tools.rst:32 c49aac9b42654973b4ae032c8afa957f
msgid ""
"**Description**: Get detailed metadata for a specific research "
"organization by its ROR ID. Returns comprehensive information including "
"all name variants (official, aliases, acronyms, labels in different "
"languages), organization type, establishment year, geographic location, "
"website/Wikipedia links, external identifiers (GRID, ISNI, Wikidata, "
"FundRef), and relationships to parent/child/related organizations. Use "
"ROR\\_search\\_organizations first to find the ROR ID."
msgstr ""

#: ../../tools/ror_tools.rst:34 ../../tools/ror_tools.rst:65
#: 52a13f0fe87a4f93b621e9c3aa08376b f0e5693f6ee34aeca99559e47f6f81e2
