msgid "**FlyBase_get_gene_orthologs** (Type: AllianceGenomeTool)"
msgstr ""

#: ../../tools/flybase_tools.rst:200 84dbd87e2b6b4bb89e65597a532d64bc
msgid ""
"Get orthologs of a Drosophila gene across other species from the Alliance"
" of Genome Resources. Re..."
