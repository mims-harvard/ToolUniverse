"Examples: 'FB:FBgn0003996' (white/w), 'FB:FBgn0000490' (dpp), "
"'FB:FBgn0004647' (Notch/N)."
msgstr ""

#: ../../tools/flybase_tools.rst:70 9c77fcfd9ff143d8ad834a8db29b19d5
