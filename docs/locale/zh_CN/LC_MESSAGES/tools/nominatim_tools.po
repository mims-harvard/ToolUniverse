#: ../../tools/nominatim_tools.rst:32 e45c424e3e904aac83e0dc7d2f450f5c
msgid ""
"**Description**: Geocode addresses and place names to geographic "
"coordinates using the OpenStreetMap Nominatim service. Converts human-"
"readable addresses, landmarks, or place names into latitude/longitude "
"coordinates. Returns structured address components, bounding box, and "
"place type. No authentication required. Useful for geospatial analysis, "
"mapping, and location-based research."
msgstr ""

#: ../../tools/nominatim_tools.rst:34 ../../tools/nominatim_tools.rst:71
#: 114fc050669045e8aff3aaa38e06b860 ac0e3b9e574e452da4f2aae54d6ef127
msgid "**Parameters:**"
msgstr ""

#: ../../tools/nominatim_tools.rst:36 ca0f0df5c7f7489b9761237579603a90
msgid ""
"``q`` (string) (required) Free-form address or place name query. "
"Examples: 'Eiffel Tower Paris', '1600 Pennsylvania Ave Washington DC', "
"'Big Ben London', 'Mount Everest'"
msgstr ""

#: ../../tools/nominatim_tools.rst:39 db30b7e0ae554af0a8939ccd34db05cd
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results to return "
"(default 5, max 50)"
msgstr ""

#: ../../tools/nominatim_tools.rst:42 7b95a5b6d2544035a39a8dfc20103edf
msgid ""
"``countrycodes`` (string, null) (optional) Restrict to specific countries"
" (comma-separated ISO 3166-1 alpha-2 codes). Examples: 'us', 'de,fr', "
"'gb'"
msgstr ""

