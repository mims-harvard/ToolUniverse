msgid ""
"Search for orthologous groups by gene/protein name in OrthoDB v12. "
"OrthoDB catalogs orthologous g..."
msgstr ""

#: ../../tools/orthodb_tools.rst 938b6b4d3b774cfd9675283dc0692cff
msgid "OrthoDB_search_groups tool specification"
