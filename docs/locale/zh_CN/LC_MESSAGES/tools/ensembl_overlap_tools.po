msgstr ""

#: ../../tools/ensembl_overlap_tools.rst:36 785ca5014f994774b1257677e60be194
msgid ""
"``gene_id`` (string) (required) Ensembl gene ID. Examples: "
"'ENSG00000141510' (TP53), 'ENSG00000012048' (BRCA1), 'ENSG00000157764' "
"(BRAF)."
msgstr ""

#: ../../tools/ensembl_overlap_tools.rst:39 8c87db9a699b49c2b3b1ac0997c588bc
msgid ""
"``feature_types`` (string) (optional) Comma-separated feature types. "
"Options: 'gene', 'transcript', 'regulatory', 'constrained', 'variation', "
"'repeat'. Default: 'gene'."
msgstr ""

