#: ../../tools/nasa_ned_tools.rst:32 40795c3cd42440e484c7c7790b0c0857
msgid ""
"**Description**: Look up an extragalactic astronomical object by name in "
"the NASA/IPAC Extragalactic Database (NED). NED is the authoritative "
"database for extragalactic objects (galaxies, quasars, AGN, galaxy "
"clusters) containing 1 billion+ photometry measurements for 60 million+ "
"objects. Returns the preferred name, coordinates (RA/Dec), object type, "
"redshift with uncertainty, distance estimates, morphology, and all "
"alternative names. Object types: G (galaxy), QSO (quasar), GPair (galaxy "
"pair), GClstr (galaxy cluster), AGN, RadioS (radio source)."
msgstr ""

#: ../../tools/nasa_ned_tools.rst:34 0f588cce64294bb99aa08863dcebef16
msgid "**Parameters:**"
msgstr ""

#: ../../tools/nasa_ned_tools.rst:36 f36915f047e34fe28096fef0f1cac4ae
msgid ""
"``name`` (string) (required) Object name in NED format. Examples: 'NGC "
"1300', 'M31', 'Andromeda Galaxy', 'Coma Cluster', '3C 273', 'Markarian "
"421', 'Arp 299', 'NGC 4889'"
msgstr ""

