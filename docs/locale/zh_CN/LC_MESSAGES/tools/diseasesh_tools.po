#: ../../tools/diseasesh_tools.rst:90 090539ba44c54b07ab93bba8bd3cf4ef
msgid "**Name**: ``DiseaseSh_get_historical``"
msgstr ""

#: ../../tools/diseasesh_tools.rst:92 7e6306a787de4601b4f97e2c83b0e3a5
msgid ""
"**Description**: Get historical COVID-19 time series data for a country "
"or globally from Disease.sh. Returns daily cumulative totals for cases, "
"deaths, and recovered over the specified time period. Data sourced from "
"Johns Hopkins University CSSE. Use lastdays parameter to control the time"
" range. Example: lastdays=30 returns the last 30 days, lastdays=all "
"returns all available data from the start of the pandemic. Useful for "
"trend analysis, epidemiological modeling, and visualization."
msgstr ""

#: ../../tools/diseasesh_tools.rst:96 95db47df234d4801a22f6af365f93469
msgid ""
"``country`` (string, null) (optional) Country name or 'all' for global "
"data. Examples: 'USA', 'India', 'all'. If omitted, returns global data."
msgstr ""

#: ../../tools/diseasesh_tools.rst:99 4c9bd48449b7409889f14c07ec4fb827
msgid ""
"``lastdays`` (string, null) (optional) Number of days of historical data "
"to return. Use a number (e.g., '30') or 'all' for all available data. "
"Default: '30'"
msgstr ""

