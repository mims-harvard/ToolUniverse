msgstr ""

#: ../../tools/diseasesh_tools.rst:36 1ce7f598c8cd4e31a63662ad65a64c81
msgid ""
"``country`` (string) (required) Country name (e.g., 'USA', 'India', "
"'Brazil'), ISO2 code (e.g., 'US', 'IN'), or ISO3 code (e.g., 'USA', "
"'IND')"
msgstr ""

