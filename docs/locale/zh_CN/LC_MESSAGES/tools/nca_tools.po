#: ../../tools/nca_tools.rst:73 e036be76d68e4ce1ae2138200838e5aa
msgid "**Name**: ``NCA_compute_parameters``"
msgstr ""

#: ../../tools/nca_tools.rst:75 5a26df2f477547f0b01b99f3fef5e4c5
msgid ""
"**Description**: Perform Non-Compartmental Analysis (NCA) on time-"
"concentration pharmacokinetic data. Computes key PK parameters: Cmax "
"(peak concentration), Tmax (time to peak), AUC0-t (area under curve to "
"last measured point using linear-log trapezoidal method), AUC0-inf "
"(extrapolated), terminal elimination half-life (t½), elimination rate "
"constant (λz), clearance (CL), and volume of distribution (Vd) when dose "
"is provided. Follows FDA/EMA NCA guidelines. Use this when you have raw "
"plasma concentration vs. time data from a PK study. Output includes "
"goodness of AUC extrapolation assessment."
msgstr ""

#: ../../tools/nca_tools.rst:79 d2713149b80e4e3a8c592593b9aed45d
msgid ""
"``times`` (array) (required) Time points in consistent units (hours "
"recommended). Example: [0, 0.25, 0.5, 1, 2, 4, 8, 12, 24]."
msgstr ""

#: ../../tools/nca_tools.rst:82 4ea4ca0e5a824479a4d6b8d9e5bdb2dc
msgid ""
"``concentrations`` (array) (required) Plasma concentrations at each time "
"point (same length as times). Example: [0, 150, 280, 220, 180, 120, 60, "
"30, 8]."
msgstr ""

#: ../../tools/nca_tools.rst:85 7d3b1086ed0f42fe8c013384553a6be1
msgid ""
"``dose`` (number, null) (optional) Administered dose (optional). Required"
" to calculate CL and Vd. Example: 100 (for 100 mg dose)."
msgstr ""

#: ../../tools/nca_tools.rst:88 82100dddcb124b3a99013b8db373ef36
msgid ""
"``route`` (string, null) (optional) Route of administration: 'iv' "
"(default) or 'po'. Affects Vd calculation formula."
msgstr ""

#: ../../tools/nca_tools.rst:91 4ee556a259314cdc916afacad0a91294
msgid ""
"``dose_unit`` (string, null) (optional) Unit of dose (default: 'mg'). "
"Examples: 'mg', 'ug', 'nmol'."
msgstr ""

#: ../../tools/nca_tools.rst:94 8f8caf0e3dd94323bf839436f7476d40
msgid ""
"``conc_unit`` (string, null) (optional) Unit of concentration (default: "
"'ng/mL'). Examples: 'ng/mL', 'ug/L', 'nM'."
msgstr ""

#: ../../tools/nca_tools.rst:97 626ec152752a4e55af9f10ab32ce860f
msgid ""
"``time_unit`` (string, null) (optional) Unit of time (default: 'h'). "
"Examples: 'h', 'min', 'd'."
msgstr ""

