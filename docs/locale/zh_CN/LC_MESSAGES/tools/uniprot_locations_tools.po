msgstr ""

#: ../../tools/uniprot_locations_tools.rst:36 1a4ae78ceb814f26955a8360632dff66
msgid ""
"``location_id`` (string) (required) UniProt subcellular location ID. "
"Format: SL-XXXX. Examples: 'SL-0091' (Cytosol), 'SL-0191' (Nucleus), "
"'SL-0173' (Mitochondrion), 'SL-0204' (Plasma membrane), 'SL-0147' "
"(Endomembrane system), 'SL-0123' (Golgi apparatus)."
msgstr ""

