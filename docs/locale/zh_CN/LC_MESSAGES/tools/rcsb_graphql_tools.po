msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:36 7ff95a29d40a43978e80f2e09cea972a
msgid ""
"``comp_id`` (string) (required) PDB chemical component identifier "
"(3-letter code). Examples: 'ATP' (adenosine triphosphate), 'HEM' (heme), "
"'NAG' (N-acetylglucosamine), 'STI' (imatinib/Gleevec), 'ZMA' (zinc ion "
"with methylamine), 'FAD' (flavin adenine dinucleotide), 'NAD' "
"(nicotinamide adenine dinucleotide)."
msgstr ""

