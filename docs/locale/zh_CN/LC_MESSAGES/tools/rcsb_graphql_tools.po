#: ../../tools/rcsb_graphql_tools.rst:32 6e2d791f5dd041408654350dbbdbf9ba
msgid ""
"**Description**: Get detailed chemical component (ligand) information "
"from the PDB using the RCSB Data API. Returns the ligand name, molecular "
"formula, molecular weight, SMILES, InChIKey, type (non-polymer, peptide-"
"like, etc.), and known drug targets with their actions (inhibitor, "
"substrate, cofactor, etc.) from DrugBank. Use this to look up small "
"molecules, cofactors, or drugs found in PDB structures."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:34 ../../tools/rcsb_graphql_tools.rst:65
#: ../../tools/rcsb_graphql_tools.rst:101 15c28c41d57c439cb9993ac4b39112a1
