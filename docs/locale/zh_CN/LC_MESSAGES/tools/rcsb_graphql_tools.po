#: ../../tools/rcsb_graphql_tools.rst:61 793b91f9c4b64eca8c13dc3b6b7f99cf
msgid "**Name**: ``RCSBGraphQL_get_polymer_entity``"
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:63 bf4c6a7ab2854b27a682421067095ca2
msgid ""
"**Description**: Get detailed polymer entity information from PDB "
"structures including amino acid sequence, chain IDs, polymer type, source"
" organism, and domain/family annotations (Pfam, GO terms). Each PDB entry"
" can contain multiple polymer entities (chains). Use this to retrieve the"
" protein sequence, identify chains, and find functional annotations for "
"proteins in a PDB structure."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:67 814e7633a97b47b29978fdead1a13f89
msgid ""
"``pdb_id`` (string, null) (optional) PDB ID (will fetch entity 1 by "
"default). Examples: '4HHB' (hemoglobin), '1TUP' (p53-DNA). Use "
"entity\\_num to specify which entity."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:70 58f01c87ed6749f38fbeb9957a59ee59
msgid ""
"``entity_num`` (integer, null) (optional) Entity number within the PDB "
"entry (default: 1). PDB entries can have multiple polymer entities (1, 2,"
" 3, ...)."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:73 d6eae23e309140c1a1057ff51bcb5b90
msgid ""
"``entity_ids`` (string, null) (optional) Comma-separated list of entity "
"IDs for batch query. Format: 'PDB\\_ENTITY' (e.g., '4HHB\\_1,4HHB\\_2'). "
"Overrides pdb\\_id/entity\\_num."
msgstr ""

