msgid ""
"Get comprehensive structure summary for one or more PDB entries using the"
" RCSB PDB Data API (Grap..."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst 06e808c9e90d4856bbca396dcfab3395
msgid "RCSBGraphQL_get_structure_summary tool specification"
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:97 ed445eb54479462ab9412863ea4f5b96
msgid "**Name**: ``RCSBGraphQL_get_structure_summary``"
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:99 8e62c058a9ed4232b8cb4b11a5963487
msgid ""
"**Description**: Get comprehensive structure summary for one or more PDB "
"entries using the RCSB PDB Data API (GraphQL). Returns title, resolution,"
" molecular weight, experimental method, deposition/release dates, primary"
" citation (PubMed ID, journal, year), atom count, entity counts, and unit"
" cell dimensions. Supports batch queries for multiple PDB IDs at once. "
"Use this when you need detailed metadata about specific PDB structures "
"beyond what basic PDB tools provide."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:103 e111e62f67184426b858d2d0f853808a
msgid ""
"``pdb_id`` (string, null) (optional) Single PDB ID. Example: '4HHB' "
"(hemoglobin), '1TUP' (p53-DNA complex), '6LU7' (SARS-CoV-2 main "
"protease)."
msgstr ""

#: ../../tools/rcsb_graphql_tools.rst:106 b883281e91204014a63e9089cc6a552c
msgid ""
"``pdb_ids`` (string, null) (optional) Comma-separated list of PDB IDs for"
" batch query. Example: '4HHB,1TUP,6LU7'. Maximum ~20 IDs per query."
msgstr ""

