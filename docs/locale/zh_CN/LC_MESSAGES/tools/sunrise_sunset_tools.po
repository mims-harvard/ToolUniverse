#: ../../tools/sunrise_sunset_tools.rst:32 ed0d53a4667f4e85971a41619d328843
msgid ""
"**Description**: Get sunrise, sunset, solar noon, and twilight times for "
"any location on Earth using the Sunrise-Sunset.org API. Returns times in "
"UTC ISO 8601 format. Supports historical dates. No authentication "
"required. Useful for astronomy, agriculture, photography planning, "
"circadian rhythm research, and solar energy calculations."
msgstr ""

#: ../../tools/sunrise_sunset_tools.rst:34 f45f2b5af74a487cbb6fce3fcfd8c9e9
msgid "**Parameters:**"
msgstr ""

#: ../../tools/sunrise_sunset_tools.rst:36 a1725f379a124644b3af9705b10bae95
msgid ""
"``lat`` (number) (required) Latitude in decimal degrees (-90 to 90). "
"Examples: 40.7128 (New York), 51.5074 (London), 35.6762 (Tokyo), 48.8566 "
"(Paris), -33.8688 (Sydney)"
msgstr ""

#: ../../tools/sunrise_sunset_tools.rst:39 4c6c7bbda93448638e2adeb4e8f77696
msgid ""
"``lng`` (number) (required) Longitude in decimal degrees (-180 to 180). "
"Examples: -74.0060 (New York), -0.1278 (London), 139.6503 (Tokyo), 2.3522"
" (Paris), 151.2093 (Sydney)"
msgstr ""

#: ../../tools/sunrise_sunset_tools.rst:42 127ca1e02c2a4745b967b2abfb850c4c
msgid ""
"``date`` (string, null) (optional) Date in YYYY-MM-DD format, or 'today'."
" Default: today. Examples: '2024-06-21', '2024-12-21', 'today'"
msgstr ""

