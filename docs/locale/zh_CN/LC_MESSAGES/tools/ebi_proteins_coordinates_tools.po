msgid "**Parameters:**"
msgstr ""

#: ../../tools/ebi_proteins_coordinates_tools.rst:36
#: e1a87835cfb64fe2b657f6b8466bfb48
msgid ""
"``accession`` (string) (required) UniProt accession. Examples: 'P04637' "
"(TP53), 'P00533' (EGFR), 'P38398' (BRCA1), 'P01308' (Insulin), 'P69905' "
"(HBA1 hemoglobin alpha)."
msgstr ""

