#: ../../tools/github_tools.rst:96 6cb8146c1f0641698502acf3a823ec15
msgid "**Name**: ``GitHub_search_repositories``"
msgstr ""

#: ../../tools/github_tools.rst:98 adcab4d29ca04313a154e04e39295b60
msgid ""
"**Description**: Search GitHub public repositories using GitHub's search "
"API. Returns repository metadata including name, description, language, "
"star count, fork count, topics, license, and creation/update dates. "
"Supports filtering by language, topic, stars, forks, and creation date. "
"Useful for finding open-source bioinformatics tools, scientific computing"
" packages, and research codebases. Rate limit: 10 requests/minute "
"unauthenticated."
msgstr ""

#: ../../tools/github_tools.rst:102 3860d1f3c43f42ee9e282c59c8759699
msgid ""
"``q`` (string) (required) Search query with optional qualifiers. "
"Examples: 'bioinformatics language:python stars:>100', 'protein structure"
" prediction', 'topic:machine-learning language:python', 'alphafold "
"protein', 'single cell RNA sequencing', 'user:deepmind'"
msgstr ""

#: ../../tools/github_tools.rst:105 22eba484749641deb3203a9bf6177687
msgid ""
"``sort`` (string, null) (optional) Sort by: 'stars', 'forks', 'help-"
"wanted-issues', 'updated'. Default: best match."
msgstr ""

#: ../../tools/github_tools.rst:108 ee85a1060af34bacbca870b38b1d8b1c
msgid ""
"``order`` (string, null) (optional) Sort direction: 'desc' (default) or "
"'asc'"
msgstr ""

#: ../../tools/github_tools.rst:111 51f5a2521e4c4db98809553ad49025ef
msgid ""
"``per_page`` (integer, null) (optional) Results per page (default 30, max"
" 100)"
msgstr ""

