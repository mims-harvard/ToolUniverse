#: ../../tools/elixir_tess_tools.rst:74 efb3694532f84e4f89dfbedc51a2304b
msgid ""
"**Description**: Search ELIXIR TeSS (Training eSupport System) for "
"bioinformatics and life science training materials. TeSS aggregates "
"learning resources from ELIXIR nodes and partner organizations including "
"tutorials, online courses, webinars, and training presentations. Returns "
"materials with scientific topics, EDAM operations, difficulty levels, and"
" resource URLs. Essential for finding bioinformatics training resources "
"and educational content."
msgstr ""

#: ../../tools/elixir_tess_tools.rst:78 3cb599b15bbf4755a45e1845cbb8c73c
msgid ""
"``q`` (string, null) (optional) Search query for training materials. "
"Examples: 'CRISPR', 'protein structure prediction', 'RNA-seq', 'machine "
"learning', 'genome assembly'"
msgstr ""

#: ../../tools/elixir_tess_tools.rst:81 b66ea2fc72a34a2eb50499cb2ad5649d
msgid ""
"``scientific_topics`` (string, null) (optional) Filter by EDAM scientific"
" topic. Examples: 'Genomics', 'Proteomics', 'Sequence analysis', "
"'Phylogenetics'"
msgstr ""

#: ../../tools/elixir_tess_tools.rst:84 9e2b0a8cec5449be868ea49a03aa05aa
msgid ""
"``target_audience`` (string, null) (optional) Filter by target audience. "
"Examples: 'Researchers', 'Graduate students', 'Bioinformaticians'"
msgstr ""

#: ../../tools/elixir_tess_tools.rst:87 035e9025758f4bfeb05e61892b080d05
msgid ""
"``difficulty_level`` (string, null) (optional) Filter by difficulty: "
"'Beginner', 'Intermediate', 'Advanced'"
msgstr ""

#: ../../tools/elixir_tess_tools.rst:90 71c579d0292c4bfa91f6c6e19640770e
msgid ""
"``licence`` (string, null) (optional) Filter by license type. Example: "
"'CC-BY'"
msgstr ""

#: ../../tools/elixir_tess_tools.rst:93 6b48aa9a9e6244599cf369194f4d5e67
