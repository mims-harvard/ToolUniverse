msgstr ""

#: ../../tools/kegg_ext_tools.rst:61 48bc5091dc2c4bc08faa73f17a746a65
msgid "**Name**: ``KEGG_get_gene_pathways``"
msgstr ""

#: ../../tools/kegg_ext_tools.rst:63 8ce915dfb3654e6f9e2f69043214f48e
msgid ""
"**Description**: Get all KEGG pathways that a gene participates in. "
"Returns pathway IDs and names for a given KEGG gene identifier. Example: "
"hsa:7157 (human TP53) participates in 51 pathways including p53 signaling"
" pathway (hsa04115), apoptosis (hsa04210), cell cycle (hsa04110), and 48 "
"disease pathways (various cancers, viral infections). Requires KEGG "
"organism:id format."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:67 854b1b18fa7f4691be61bbdbbb2d192f
msgid ""
"``gene_id`` (string) (optional) KEGG gene identifier in organism:id "
"format. Examples: 'hsa:7157' (human TP53), 'hsa:672' (human BRCA1), "
"'mmu:22059' (mouse Trp53). Use organism prefix: hsa=human, mmu=mouse, "
"rno=rat, dme=fly, sce=yeast."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:70 5883c8b7b0ef471a94d7aace1c634b24
msgid ""
"``gene_symbol`` (string) (optional) Alias for gene\\_id: human gene "
"symbol (e.g. 'TP53', 'BRCA1'). Auto-resolved to KEGG gene ID using "
"organism='hsa'."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:73 ac210960d8974e278e018c50523e1095
msgid ""
"``gene`` (string) (optional) Alias for gene\\_id: human gene symbol (e.g."
" 'TP53', 'EGFR')."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:76 d9cb319a2b424d0aa90d44c418bf42af
msgid ""
"``organism`` (string) (optional) KEGG organism code for gene symbol "
"resolution (default: 'hsa' for human). Used only when gene\\_symbol is "
"provided instead of gene\\_id."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:92 880c42a4f13843c782f4d69690552cf3
msgid "**KEGG_get_pathway_genes** (Type: KEGGExtTool)"
msgstr ""

#: ../../tools/kegg_ext_tools.rst:94 c364eb0d347e419fb14bd2f2a0dd3f52
msgid ""
"Get all genes in a KEGG pathway. Returns gene IDs for all member genes of"
" a specific pathway. Exa..."
msgstr ""

#: ../../tools/kegg_ext_tools.rst 74baf80740e949f3922c7ba1b8ecfe49
msgid "KEGG_get_pathway_genes tool specification"
msgstr ""

#: ../../tools/kegg_ext_tools.rst:100 e87b6445997a4a2f9cbf2f9be4c8f5f3
msgid "**Name**: ``KEGG_get_pathway_genes``"
msgstr ""

#: ../../tools/kegg_ext_tools.rst:102 0ab4158b90da49cca11830beb5e26d94
msgid ""
"**Description**: Get all genes in a KEGG pathway. Returns gene IDs for "
"all member genes of a specific pathway. Example: hsa04115 (p53 signaling "
"pathway) contains genes including CDK2 (hsa:1017), CDK4 (hsa:1019), CDK6 "
"(hsa:1021), CDKN1A (hsa:1026), CDKN2A (hsa:1029), and many more involved "
"in p53-mediated cell cycle arrest, apoptosis, and senescence."
msgstr ""

#: ../../tools/kegg_ext_tools.rst:106 4222a27be7364ea88bfa5362453f5470
msgid ""
"``pathway_id`` (string) (required) KEGG pathway identifier (e.g., "
"'hsa04115' for p53 signaling pathway, 'hsa04110' for cell cycle, "
"'hsa04210' for apoptosis). Use organism prefix: hsa=human, mmu=mouse."
msgstr ""

