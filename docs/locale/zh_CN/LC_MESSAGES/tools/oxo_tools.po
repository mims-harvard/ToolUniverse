#: ../../tools/oxo_tools.rst 407a292a90e64b37a5bcd38f3602593b
msgid "OxO_search_ontology_mappings tool specification"
msgstr ""

#: ../../tools/oxo_tools.rst:67 786867cfae8e43d4a5ce1bfd8de1bc6e
msgid "**Name**: ``OxO_search_ontology_mappings``"
msgstr ""

#: ../../tools/oxo_tools.rst:69 54c6b9ada3d74b3caceaf57a8fde18b8
msgid ""
"**Description**: Search for cross-reference mappings for multiple "
"ontology terms at once using the EBI OxO service. Supports batch queries "
"to map multiple terms across biomedical ontologies. Can filter by target "
"ontology prefix (e.g., only return MeSH mappings). Example: mapping "
"HP:0001250 and HP:0001263 simultaneously returns MeSH, SNOMED-CT, and "
"UMLS equivalents for both seizure-related phenotypes."
msgstr ""

#: ../../tools/oxo_tools.rst:73 106188de503e476ebe4cd431c34856bd
msgid ""
"``term_ids`` (string) (required) Comma-separated list of ontology term "
"IDs to map. Examples: 'HP:0001250,HP:0001263' (seizures and delayed motor"
" development), 'DOID:9352,DOID:162' (T2DM and cancer)."
msgstr ""

#: ../../tools/oxo_tools.rst:76 be3193162dad499fb792a5eb630b5865
msgid ""
"``distance`` (integer) (optional) Maximum mapping distance (1-3). "
"Default: 1."
msgstr ""

#: ../../tools/oxo_tools.rst:79 7538d99879a648ca98b7a8cb162c621a
msgid ""
"``target_prefix`` (string) (optional) Filter mappings to a specific "
"ontology prefix. Examples: 'MeSH' (Medical Subject Headings), 'SNOMEDCT' "
"(clinical terms), 'UMLS' (unified medical language), 'ICD10' (diagnostic "
"codes), 'OMIM' (genetic disorders)."
msgstr ""

