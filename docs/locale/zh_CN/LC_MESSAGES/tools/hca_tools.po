#: ../../tools/hca_tools.rst:70 21b7a020538f4ce390eac9e47c11c2c9
msgid ""
"**Description**: Searches for single-cell projects in the Human Cell "
"Atlas (HCA) Data Coordination Platform (DCP). This tool allows filtering "
"projects based on specific organs and disease states."
msgstr ""

#: ../../tools/hca_tools.rst:74 3403503436294196b6d12f4ce3801250
msgid ""
"``action`` (string) (required) The specific action to perform. Must be "
"set to 'search\\_projects'."
msgstr ""

#: ../../tools/hca_tools.rst:77 f11f46ed5f05414890a84f245b8dbdc2
msgid ""
"``organ`` (string) (optional) The organ to filter projects by. Examples "
"include 'heart', 'liver', 'brain', 'kidney'. This field is optional."
msgstr ""

#: ../../tools/hca_tools.rst:80 35d7cebe558f4e04866ae309000101d4
msgid ""
"``disease`` (string) (optional) The disease state to filter by. Examples "
"include 'normal', 'cancer', 'covid-19'. This field is optional."
msgstr ""

#: ../../tools/hca_tools.rst:83 481c882ad9e948409c509bda07e89336
msgid ""
"``limit`` (integer) (optional) The maximum number of projects to return. "
"The default is 10. Use this to control the size of the result set."
msgstr ""

