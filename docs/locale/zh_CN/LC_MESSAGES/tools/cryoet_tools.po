#: ../../tools/cryoet_tools.rst:109 da766db4927542a4b9c0466597840f49
msgid "**Name**: ``CryoET_list_datasets``"
msgstr ""

#: ../../tools/cryoet_tools.rst:111 d2e2f69f0340429cae05c8485d09af13
msgid ""
"**Description**: Search and list cryo-electron tomography (cryo-ET) "
"datasets from the CZ BioHub CryoET Data Portal "
"(cryoetdataportal.czscience.com). Returns dataset metadata including "
"title, description, organism, tissue/cell type, sample type, and S3/HTTPS"
" data access paths. Supports filtering by organism name or tissue name. "
"Use for: discovering available cryo-ET datasets, finding datasets by "
"organism (e.g. 'Homo sapiens', 'Saccharomyces cerevisiae'), filtering by "
"tissue or cell type. Returns up to \\`limit\\` datasets per call; use "
"\\`offset\\` for pagination."
msgstr ""

#: ../../tools/cryoet_tools.rst:118 381fecc4d9cd4edc8ebe8c20fe47cad0
msgid ""
"``organism_name`` (string, null) (optional) Filter by organism name "
"(case-insensitive substring match). Examples: 'Homo sapiens', "
"'Saccharomyces cerevisiae', 'Coxiella burnetii'."
msgstr ""

#: ../../tools/cryoet_tools.rst:121 750b4e8ca8f9432f9cfd5420fb319bda
msgid ""
"``tissue_name`` (string, null) (optional) Filter by tissue or cell type "
"name (case-insensitive substring match). Examples: 'kidney', "
"'endothelial', 'prokaryotic cell'."
msgstr ""

#: ../../tools/cryoet_tools.rst:124 dcce3cf52c5d4086b5d4a27e50b6752f
msgid ""
"``limit`` (integer) (optional) Maximum number of datasets to return "
"(default: 10, max recommended: 50)."
msgstr ""

#: ../../tools/cryoet_tools.rst:127 0830e0f560004083a2a706e77f38eb80
msgid ""
"``offset`` (integer) (optional) Number of datasets to skip for pagination"
" (default: 0)."
msgstr ""

