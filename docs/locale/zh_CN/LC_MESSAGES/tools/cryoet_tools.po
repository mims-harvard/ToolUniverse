#: ../../tools/cryoet_tools.rst:154 491b9b4ec2a64562b91d65958f7746d2
msgid ""
"**Description**: List the experimental tilt-series acquisition runs "
"within a specific CryoET Data Portal dataset. Each run corresponds to one"
" sample grid position with its own tilt series, tomograms, and "
"annotations. Returns run names and data access paths. Use this after "
"\\`CryoET\\_get\\_dataset\\` to enumerate the runs for a dataset before "
"fetching tomograms or annotations."
msgstr ""

#: ../../tools/cryoet_tools.rst:161 5b7ed9390ccd47a593b11ce063746005
msgid "``dataset_id`` (integer) (required) Numeric dataset ID (e.g. 10053)."
msgstr ""

#: ../../tools/cryoet_tools.rst:164 4ff16d11e32b4f37b798a586be3d2c2c
msgid ""
"``limit`` (integer) (optional) Maximum number of runs to return (default:"
" 20)."
msgstr ""

#: ../../tools/cryoet_tools.rst:167 a3336be79a574942b1fe60b7795d1150
msgid ""
"``offset`` (integer) (optional) Number of runs to skip for pagination "
"(default: 0)."
msgstr ""

