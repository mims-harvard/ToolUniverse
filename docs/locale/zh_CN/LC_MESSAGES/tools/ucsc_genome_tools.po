#: ../../tools/ucsc_genome_tools.rst:32 44da8f4c07454791b7b0ef342ebadf0f
msgid ""
"**Description**: Get DNA sequence from the UCSC Genome Browser for a "
"specified genomic region. Returns the nucleotide sequence for a given "
"chromosome, start, and end position in a genome assembly. Useful for "
"primer design, sequence analysis, and regulatory element inspection. "
"Example: hg38, chr17, start=7668421, end=7668521 returns 100bp of TP53 "
"sequence."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:34 ../../tools/ucsc_genome_tools.rst:77
#: ../../tools/ucsc_genome_tools.rst:127 2754bd864a014804b4562b54877c38c7
