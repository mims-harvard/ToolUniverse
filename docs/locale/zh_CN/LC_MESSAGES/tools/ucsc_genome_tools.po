#: ../../tools/ucsc_genome_tools.rst:36 b1f20cb744bc4d9a84f5faa198423e19
msgid ""
"``genome`` (string) (required) UCSC genome assembly identifier. Examples:"
" 'hg38' (human), 'mm39' (mouse), 'dm6' (fly), 'sacCer3' (yeast)."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:39 b071e1634283482dbd98022c50050e3c
msgid ""
"``chrom`` (string) (required) Chromosome name. Examples: 'chr1', 'chr17',"
" 'chrX', 'chrM'."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:42 883216abf596433f90c3968f6b1ca29b
msgid ""
"``start`` (integer) (required) 0-based start position (inclusive). "
"Example: 7668421."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:45 906fb4917f3b4be4a83fb09cb6f4606a
msgid ""
"``end`` (integer) (required) End position (exclusive). Must be > start "
"and span <= 100000 bp. Example: 7668521."
msgstr ""

