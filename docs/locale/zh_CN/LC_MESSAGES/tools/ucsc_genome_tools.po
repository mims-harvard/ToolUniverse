#: ../../tools/ucsc_genome_tools.rst:73 ef99c6d8919044ba9ab4e99f3cb17ae9
msgid "**Name**: ``UCSC_get_track``"
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:75 b150c3123c684c428565acd70e1387a8
msgid ""
"**Description**: Get annotation track data from the UCSC Genome Browser "
"for a specified genomic region. Retrieves features like genes, regulatory"
" elements, conservation scores, variants, or repeats from any of UCSC's "
"370+ tracks. Use UCSC\\_search first to find the genomic coordinates of "
"your gene of interest. Example: track 'knownGene' on hg38 "
"chr17:7668421-7687490 returns GENCODE gene annotations for the TP53 "
"region."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:79 970efd4a4a3a4ce88e6f3970ec410171
msgid ""
"``genome`` (string) (required) UCSC genome assembly. Examples: 'hg38', "
"'hg19', 'mm39'."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:82 ac99028fd0594b69a156460770052ade
msgid ""
"``track`` (string) (required) Track name. Common tracks: 'knownGene' "
"(GENCODE genes), 'ncbiRefSeq' (RefSeq), 'snp151' (dbSNP), "
"'encodeCcreCombined' (ENCODE cCREs), 'phastCons100way' (conservation), "
"'rmsk' (repeats)."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:85 3e5eba32f7904721b3118d2d24e766aa
msgid ""
"``chrom`` (string) (required) Chromosome name. Examples: 'chr1', 'chr17',"
" 'chrX'."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:88 d4cc9b605c384150843bb7d30cb6a317
msgid "``start`` (integer) (required) 0-based start position (inclusive)."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:91 2c8833a5600646eb9e510f5da7f3de4c
msgid "``end`` (integer) (required) End position (exclusive). Must be > start."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:94 ca11ecc09aba426eb18cd803c9c5faf6
msgid ""
"``maxItemsOutput`` (integer, null) (optional) Maximum number of items to "
"return. Default: 100. Set to limit large result sets."
msgstr ""

