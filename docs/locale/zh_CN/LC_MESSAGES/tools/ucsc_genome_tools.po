#: ../../tools/ucsc_genome_tools.rst:123 a5a8b4b3f73b47bcab2daf7f383ae899
msgid "**Name**: ``UCSC_search``"
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:125 15ca921cb66644029aa57c4024cc7b9e
msgid ""
"**Description**: Search the UCSC Genome Browser for genes, transcripts, "
"or genomic features by name. Returns position matches across tracks "
"(MANE, RefSeq, GENCODE, HGNC, etc.) for a given genome assembly. Supports"
" searching for gene symbols, transcript IDs, SNP rsIDs, or chromosomal "
"bands. Example: searching 'TP53' in hg38 returns chr17:7668421-7687490 "
"from MANE Select and other tracks."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:129 6481c3004d954a66b2d3f20bbfbfe5c6
msgid ""
"``search_term`` (string) (required) Gene symbol, transcript ID, SNP rsID,"
" or genomic feature to search. Examples: 'TP53', 'BRCA1', 'rs429358', "
"'ENST00000269305'."
msgstr ""

#: ../../tools/ucsc_genome_tools.rst:132 c238b04ddc59434996ee395de8c6d095
msgid ""
"``genome`` (string) (optional) UCSC genome assembly identifier. Default: "
"'hg38'. Others: 'hg19', 'mm10', 'mm39', 'dm6', 'ce11', 'danRer11', "
"'sacCer3'."
msgstr ""

