msgid ""
"``gene_id`` (string) (required) ZFIN gene ID with 'ZFIN:' prefix. "
"Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-990415-72' "
"(tp53), 'ZFIN:ZDB-GENE-980526-166' (shha)."
msgstr ""

#: ../../tools/zfin_tools.rst:101 0fdd3909667b441aa1acd64b1b9a9d9b
msgid ""
"``limit`` (integer) (optional) Maximum number of alleles to return "
"(1-100). Default: 20."
msgstr ""

