#: ../../tools/zfin_tools.rst af29c7a62a30480183b2774538a31ee3
msgid "ZFIN_get_gene_expression tool specification"
msgstr ""

#: ../../tools/zfin_tools.rst:129 aa777d3e11a14511a523017e9ea3075d
msgid "**Name**: ``ZFIN_get_gene_expression``"
msgstr ""

#: ../../tools/zfin_tools.rst:131 91f93bf415f94515b30a6d20436e4a64
msgid ""
"**Description**: Get expression summary for a zebrafish gene from the "
"Alliance of Genome Resources. Returns a ribbon summary of expression "
"across anatomical systems (nervous system, renal system, sensory system, "
"etc.) with annotation counts. Zebrafish is a premier model for studying "
"vertebrate development and expression. Example: 'ZFIN:ZDB-GENE-990415-8' "
"(pax2a) shows 1092 annotations including nervous system (216), renal "
"system (60), sensory system (25)."
msgstr ""

#: ../../tools/zfin_tools.rst:135 3f8e68dc7c05492fac1eefd67ce06fa1
msgid ""
"``gene_id`` (string) (required) ZFIN gene ID with 'ZFIN:' prefix. "
"Examples: 'ZFIN:ZDB-GENE-990415-8' (pax2a), 'ZFIN:ZDB-GENE-980526-166' "
"(shha), 'ZFIN:ZDB-GENE-990415-72' (tp53)."
msgstr ""

#: ../../tools/zfin_tools.rst:152 485790fe3ed0411d92793d75e5635d11
msgid "**ZFIN_get_gene_orthologs** (Type: AllianceGenomeTool)"
msgstr ""

#: ../../tools/zfin_tools.rst:154 8fed3e51e57b4dd181ccc32d8a44afde
msgid ""
"Get orthologs of a zebrafish gene across other species from the Alliance "
"of Genome Resources. Ret..."
msgstr ""

