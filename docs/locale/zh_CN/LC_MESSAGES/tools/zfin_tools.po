msgid "**ZFIN_search** (Type: AllianceGenomeTool)"
msgstr ""

#: ../../tools/zfin_tools.rst:231 09b074e50ef24a8d9bbbecb8ec98cfce
msgid ""
"Search for zebrafish (Danio rerio) genes in ZFIN by keyword (gene symbol "
"or name). Returns matchi..."
msgstr ""

#: ../../tools/zfin_tools.rst bcdb96c508f745d0b033082b61112a0f
msgid "ZFIN_search tool specification"
msgstr ""

#: ../../tools/zfin_tools.rst:237 1731820e29b74b70bd8d9937a261682f
msgid "**Name**: ``ZFIN_search``"
msgstr ""

#: ../../tools/zfin_tools.rst:239 1f811bf054c54dcdbf4cee2de749c6a1
msgid ""
"**Description**: Search for zebrafish (Danio rerio) genes in ZFIN by "
"keyword (gene symbol or name). Returns matching genes with their ZFIN "
"IDs, symbols, and names. Use the returned gene\\_id with "
"ZFIN\\_get\\_gene for full details. Example: query='tp53' returns "
"zebrafish tumor protein p53."
msgstr ""

#: ../../tools/zfin_tools.rst:243 323b68157e024315a018f2ff2bc1690c
msgid ""
"``query`` (string) (required) Gene symbol or name to search for (e.g., "
"'tp53', 'sox9a', 'pax2a', 'fgf8a')"
msgstr ""

