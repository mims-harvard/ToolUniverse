#: ../../tools/figshare_tools.rst:61 7e1247e2beb74b8080874d1ae1d262f9
msgid "**Name**: ``Figshare_search_articles``"
msgstr ""

#: ../../tools/figshare_tools.rst:63 5baa656b4af64e9e80b8a3d5a58978db
msgid ""
"**Description**: Search Figshare for research outputs (datasets, figures,"
" code, posters, papers, theses, presentations) by keyword. Figshare is a "
"major open-access research repository where researchers share "
"supplementary data, code, figures, and complete datasets. Returns article"
" ID, title, DOI, resource type, publication date, and authors. Essential "
"for finding research datasets, supplementary materials, and research code"
" associated with published papers."
msgstr ""

#: ../../tools/figshare_tools.rst:67 bd44839b72f94d62a1d07ea23fff5aa1
msgid ""
"``search_for`` (string) (required) Keyword search query (e.g., 'CRISPR "
"knockout RNA-seq', 'protein structure cryo-EM', 'climate change "
"temperature dataset')"
msgstr ""

#: ../../tools/figshare_tools.rst:70 2c47fd68f8e741ffa9980f7391189694
msgid ""
"``item_type`` (integer, null) (optional) Filter by item type: 3=dataset, "
"2=media, 1=figure, 9=code, 7=thesis, 6=book, 5=presentation, 4=paper, "
"12=journal contribution, 11=poster"
msgstr ""

#: ../../tools/figshare_tools.rst:73 e7c2a9b74a4d4e77b78557aaa4b230ca
msgid ""
"``page_size`` (integer, null) (optional) Number of results (default 10, "
"max 1000)"
msgstr ""

#: ../../tools/figshare_tools.rst:76 ad905af1519c4e8d9af6b41546e999fa
msgid ""
"``published_since`` (string, null) (optional) Filter to articles "
"published after this date in format 'YYYY-MM-DD' (e.g., '2023-01-01')"
msgstr ""

