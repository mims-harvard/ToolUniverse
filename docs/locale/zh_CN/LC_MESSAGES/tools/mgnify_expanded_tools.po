msgid ""
"``analysis_id`` (string) (required) MGnify analysis accession (e.g., "
"'MGYA00585482'). Find IDs via MGnify\\_list\\_analyses."
msgstr ""

#: ../../tools/mgnify_expanded_tools.rst:70 b088304b1f57407491cf8e6d591de2c2
msgid ""
"``page_size`` (integer) (optional) Number of GO terms to return per page "
"(default 25, max 100)."
msgstr ""

