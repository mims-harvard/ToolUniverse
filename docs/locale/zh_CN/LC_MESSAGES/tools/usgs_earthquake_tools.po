#: ../../tools/usgs_earthquake_tools.rst:36 e91ebfec8e1f400da009c040c9d1d19b
msgid ""
"``magnitude`` (string) (required) Minimum magnitude filter: 'significant'"
" (felt widely), '4.5', '2.5', '1.0', 'all' (includes micro-earthquakes). "
"Higher magnitude = fewer but larger events."
msgstr ""

#: ../../tools/usgs_earthquake_tools.rst:39 7323351b4f31497890717c929b132b8e
msgid ""
"``period`` (string) (required) Time period: 'hour' (past 1 hour), 'day' "
"(past 24 hours), 'week' (past 7 days), 'month' (past 30 days)"
msgstr ""

