#: ../../tools/iedb_prediction_tools.rst:32 cb94411ed13446ef85eb54ac16e33b1a
msgid ""
"**Description**: Predict MHC class I peptide binding using NetMHCpan via "
"the IEDB Analysis Resource API. Given a protein sequence and HLA allele, "
"predicts which peptides will bind and be presented on the cell surface. "
"Returns peptides ranked by percentile rank (lower = stronger binding). "
"Essential for vaccine design, neoantigen prediction, and epitope mapping."
" Supports human HLA-A/B/C and mouse H-2 alleles."
msgstr ""

#: ../../tools/iedb_prediction_tools.rst:34
#: ../../tools/iedb_prediction_tools.rst:74 06d22b534d0a4ee98240d03312d79eaf
#: 59c1d163d23f4cd991415e0c5bab1139
msgid "**Parameters:**"
msgstr ""

#: ../../tools/iedb_prediction_tools.rst:36 196978dbf5f34f3481fc47a09a31b604
msgid ""
"``sequence`` (string) (required) Protein sequence (amino acid letters, "
"e.g., 'TYQRTRALVFQRTRALKMFAL'). Multiple peptides can be concatenated."
msgstr ""

#: ../../tools/iedb_prediction_tools.rst:39 ff0fbca6110a423da2fb80be9d3d419c
msgid ""
"``allele`` (string) (optional) MHC allele name. Human: 'HLA-A\\*02:01', "
"'HLA-B\\*07:02'. Mouse: 'H-2-Kd', 'H-2-Db'. Default: HLA-A\\*02:01"
msgstr ""

#: ../../tools/iedb_prediction_tools.rst:42 ea0105e8b922467d9515c596fbf1fe32
msgid ""
"``method`` (string) (optional) Prediction method. 'netmhcpan\\_el' "
"(recommended, eluted ligand), 'netmhcpan\\_ba' (binding affinity), 'ann',"
" 'smm'"
msgstr ""

#: ../../tools/iedb_prediction_tools.rst:45 738c96f7207b49e1b7fc224db5b023f8
msgid ""
"``length`` (integer) (optional) Peptide length (8-14 for MHC-I, typically"
" 9)"
msgstr ""

