msgid "**Name**: ``ENCODE_get_file``"
msgstr ""

#: ../../tools/encode_tools.rst:94 19f502a4c85c4ab0a555e94c8444cac3
msgid ""
"**Description**: Get detailed metadata for a specific ENCODE file by its "
"accession ID. Returns comprehensive file information including file "
"format, output type, dataset accession, biological/technical replicate "
"numbers, file size, MD5 checksum, download URL (href), genome assembly, "
"quality metrics, and processing status. Essential for accessing download "
"URLs, verifying file integrity, and understanding file provenance. Find "
"file accessions using ENCODE\\_list\\_files (format: ENCFF######)."
msgstr ""

#: ../../tools/encode_tools.rst:98 95bd79fb7a9b4b8f8b0b4643cb140e7a
msgid ""
"``accession`` (string) (required) ENCODE file accession identifier "
"(format: ENCFF######, e.g., 'ENCFF001JXO'). Find accessions using "
"ENCODE\\_list\\_files."
msgstr ""

#: ../../tools/encode_tools.rst:115 b871f4376aaf4e88bc5d4dca98cdf7f3
msgid "**ENCODE_list_files** (Type: ENCODEFilesTool)"
