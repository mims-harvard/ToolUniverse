msgid "**Parameters:**"
msgstr ""

#: ../../tools/mutalyzer_tools.rst:36 8112d1db179f4e0bbd56d43d92756469
msgid ""
"``variant`` (string) (required) Protein-level HGVS variant description. "
"Examples: 'NP\\_002993.1:p.Asp92Tyr' (SDHD), 'NP\\_000537.3:p.Pro72Arg' "
"(TP53), 'NP\\_000050.2:p.Tyr32Cys' (BRCA2). Format: "
"NP\\_accession:p.AminoAcidChange"
msgstr ""

