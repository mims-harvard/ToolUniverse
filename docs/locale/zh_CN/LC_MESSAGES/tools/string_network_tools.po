msgstr ""

#: ../../tools/string_network_tools.rst:36 8677de3f41c74c96984715dfc84e3254
msgid ""
"``identifiers`` (string) (required) Protein identifier (gene name or "
"STRING ID). Examples: 'TP53', 'BRCA1', 'EGFR', '9606.ENSP00000269305'"
msgstr ""

#: ../../tools/string_network_tools.rst:39 43848af287744da2aeaaed0eae16bfa8
msgid ""
"``species`` (integer) (optional) NCBI taxonomy ID (9606=human, "
"10090=mouse, 7227=fly, 6239=worm)"
msgstr ""

#: ../../tools/string_network_tools.rst:42 f08abbed46004165861c1a6496a7d035
msgid ""
"``limit`` (integer) (optional) Maximum number of interaction partners to "
"return"
msgstr ""

#: ../../tools/string_network_tools.rst:45 b571772e91844321a350f10ffdd7f4de
msgid ""
"``required_score`` (integer, null) (optional) Minimum combined STRING "
"score (0-1000). 400=medium, 700=high, 900=highest confidence."
msgstr ""

