#: ../../tools/kegg_conv_link_tools.rst:32 f4ee5b522f2545ab9984977ea0502dc0
msgid ""
"**Description**: Convert KEGG gene/compound identifiers to external "
"database IDs using the KEGG /conv API. Maps KEGG gene IDs (e.g., hsa:7157"
" for TP53) to UniProt, NCBI Gene, NCBI Protein, ChEBI, or PubChem IDs. "
"Essential for cross-database integration in bioinformatics workflows. "
"Example: converting hsa:7157 to UniProt returns P04637 (TP53\\_HUMAN)."
msgstr ""

#: ../../tools/kegg_conv_link_tools.rst:34
#: ../../tools/kegg_conv_link_tools.rst:69 569140a58bb348d28b6ea42a08f72ebe
#: 85b3fe05b3f34d7ca09f1de3c4acd4af
msgid "**Parameters:**"
msgstr ""

#: ../../tools/kegg_conv_link_tools.rst:36 64cdf1f835c04596843f1747d7789be9
msgid ""
"``kegg_id`` (string) (required) KEGG entry ID. For genes use format "
"'organism:gene\\_id' (e.g., 'hsa:7157' for human TP53, 'mmu:22059' for "
"mouse Trp53). For compounds use 'cpd:C00002' (ATP). Multiple IDs "
"separated by '+' (e.g., 'hsa:7157+hsa:672')."
msgstr ""

#: ../../tools/kegg_conv_link_tools.rst:39 ff48ff23243e40cfaac7161520fc5af2
msgid ""
"``target_db`` (string) (required) External database to convert to. "
"Options: 'uniprot' (UniProt accessions), 'ncbi-geneid' (NCBI Gene/Entrez "
"IDs), 'ncbi-proteinid' (NCBI protein accessions), 'chebi' (ChEBI compound"
" IDs), 'pubchem' (PubChem substance IDs)."
msgstr ""

