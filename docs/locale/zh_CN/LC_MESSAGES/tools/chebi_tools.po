#: ../../tools/chebi_tools.rst:92 638de43dc2c543c6a78b01069a690197
msgid "**Name**: ``ChEBI_search``"
msgstr ""

#: ../../tools/chebi_tools.rst:94 b4f0fa968e2f4cdaaedc498ed615394e
msgid ""
"**Description**: Search the ChEBI database for chemical entities by name,"
" formula, or keyword. Uses Elasticsearch-powered full-text search across "
"compound names, synonyms, definitions, and formulas. Returns matching "
"compounds with IDs, names, formulas, and masses. Note: smiles and "
"inchikey are not available from the search endpoint (use "
"ChEBI\\_get\\_compound for structural data). Compound names are HTML-"
"stripped. ChEBI contains 195,000+ chemical entities of biological "
"interest."
msgstr ""

#: ../../tools/chebi_tools.rst:98 43aa8e345c4c475cadd192991b196131
msgid ""
"``query`` (string) (required) Search query string - compound name, "
"synonym, formula, or keyword. Examples: 'glucose', 'caffeine', 'C9H8O4' "
"(aspirin formula), 'kinase inhibitor'."
msgstr ""

#: ../../tools/chebi_tools.rst:101 2f78654db92e430484692ea05551e31c
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results to return."
" Default: 10. Max: 100."
msgstr ""

