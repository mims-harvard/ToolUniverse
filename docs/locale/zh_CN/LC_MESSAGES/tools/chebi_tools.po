msgid ""
"``chebi_id`` (integer) (required) ChEBI numeric identifier (without the "
"'CHEBI:' prefix). Examples: 15365 (aspirin), 17234 (glucose), 16236 "
"(ethanol), 15377 (water), 17790 (methanol)."
msgstr ""

