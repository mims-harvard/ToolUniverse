#: ../../tools/wikipathways_ext_tools.rst:32 56ff334f432c485db6ce5112fc0ed0ca
msgid ""
"**Description**: Find all WikiPathways pathways containing a specific "
"gene. Takes a gene identifier (HGNC symbol, Entrez ID, or Ensembl ID) and"
" returns all pathways in which that gene appears. Useful for "
"understanding the biological context of a gene across curated pathway "
"databases. Example: searching for 'TP53' returns multiple pathways "
"including WP254 (Apoptosis), WP179 (Cell Cycle), and others. Supports "
"multiple species."
msgstr ""

#: ../../tools/wikipathways_ext_tools.rst:34
#: ../../tools/wikipathways_ext_tools.rst:68 584842c0d7ff49fd804dbedfd9e7e931
#: a89fe58b30fa48f6972ac35067891d40
msgid "**Parameters:**"
msgstr ""

#: ../../tools/wikipathways_ext_tools.rst:36 68288381c24c482982501ea74aae92ba
msgid ""
"``gene`` (string) (required) Gene identifier to search. Examples: 'TP53',"
" 'BRCA1', 'EGFR', '7157' (Entrez), 'ENSG00000141510' (Ensembl)."
msgstr ""

#: ../../tools/wikipathways_ext_tools.rst:39 f53949d78e4242e9878aacfcb2dfd1d1
msgid ""
"``species`` (string) (optional) Species to filter results. Default: 'Homo"
" sapiens'. Other options: 'Mus musculus', 'Rattus norvegicus', 'Danio "
"rerio'."
msgstr ""

