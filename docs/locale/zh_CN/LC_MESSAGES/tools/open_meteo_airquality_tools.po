#: ../../tools/open_meteo_airquality_tools.rst:32
#: 45a982f748a04f13ac5cf3cd2968d103
msgid ""
"**Description**: Get current and forecast air quality data for any "
"location using the Open-Meteo Air Quality API. Returns hourly "
"concentrations of PM2.5, PM10, ozone, NO2, SO2, carbon monoxide, and "
"European Air Quality Index (AQI). Data from the Copernicus Atmosphere "
"Monitoring Service. No authentication required."
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:34
#: 026a6ae5914c4b67835f61739e474553
msgid "**Parameters:**"
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:36
#: bd983d78277b4e70b179e4d6d63375a9
msgid ""
"``latitude`` (number) (required) Location latitude (-90 to 90). Examples:"
" 52.52 (Berlin), 40.71 (NYC), 48.85 (Paris), 35.68 (Tokyo)"
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:39
#: bc20993920f54fd4bdb856a70e41a1e5
msgid ""
"``longitude`` (number) (required) Location longitude (-180 to 180). "
"Examples: 13.41 (Berlin), -74.01 (NYC), 2.35 (Paris), 139.69 (Tokyo)"
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:42
#: db5ffa0a609c4d968dc7e09f94bd1f12
msgid ""
"``hourly`` (string, null) (optional) Comma-separated air quality "
"variables. Values: 'pm10', 'pm2\\_5', 'carbon\\_monoxide', "
"'nitrogen\\_dioxide', 'sulphur\\_dioxide', 'ozone', "
"'aerosol\\_optical\\_depth', 'european\\_aqi', 'us\\_aqi'. Default: "
"pm10,pm2\\_5,european\\_aqi"
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:45
#: dee8c9bee3c24bb79e23d769363d7e49
msgid ""
"``forecast_days`` (integer, null) (optional) Number of forecast days "
"(1-7). Default: 5"
msgstr ""

#: ../../tools/open_meteo_airquality_tools.rst:48
#: 0e9a7c441dd04833aa480026f9b2a7fa
msgid ""
"``past_days`` (integer, null) (optional) Include past days in response "
"(0-92). Examples: 1, 7"
msgstr ""

