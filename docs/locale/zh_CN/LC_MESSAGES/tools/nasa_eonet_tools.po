#: ../../tools/nasa_eonet_tools.rst:59 5bb66fbe3f534cc98322dcc92cc6d7f2
msgid "**Name**: ``NASAEONET_get_events``"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:61 bbd14c5bd9a04317a0b44d41cabdf253
msgid ""
"**Description**: Get natural event data from NASA Earth Observatory "
"Natural Event Tracker (EONET). EONET tracks ongoing and historical "
"natural events including wildfires, storms, volcanoes, floods, sea ice "
"changes, landslides, earthquakes, and more. Returns event details with "
"geographic coordinates, time series, and source references. Useful for "
"disaster monitoring, environmental research, and geospatial analysis."
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:65 19553ab1a3b14f85bc9167bce873e5de
msgid ""
"``status`` (string, null) (optional) Event status: 'open' (ongoing "
"events) or 'closed' (past events). Default: both"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:68 9d47bd8bdc6e40a587342b1fd1c5aadc
msgid ""
"``category`` (string, null) (optional) Filter by event category. Values: "
"'wildfires', 'severeStorms', 'volcanoes', 'seaLakeIce', 'earthquakes', "
"'floods', 'landslides', 'manmade', 'snow'. Use the exact slug."
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:71 6e729b2a4ba04b6caaf65a688986bd8c
msgid ""
"``limit`` (integer, null) (optional) Maximum number of events to return "
"(default 10, max 1000)"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:74 5c445dabcc394883b0d1196a2cef3762
msgid ""
"``days`` (integer, null) (optional) Return events in the last N days. "
"Example: 7 for last week. Ignored if start/end are set."
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:77 fae207a769e54139a6f89b706b489f56
msgid ""
"``start`` (string, null) (optional) Filter events starting from this date"
" (YYYY-MM-DD). Example: '2024-01-01'"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:80 3e9d0e1ad2ac4a12b570a8361ae16c63
msgid ""
"``end`` (string, null) (optional) Filter events up to this date (YYYY-MM-"
"DD). Example: '2024-12-31'"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:83 902e0056372d43bd9060bcff9d2213fe
msgid ""
"``bbox`` (string, null) (optional) Bounding box filter: "
"'minLon,minLat,maxLon,maxLat'. Example: '-120,30,-100,50' for western US"
msgstr ""

#: ../../tools/nasa_eonet_tools.rst:86 747d52868662414bb433c9d796013ffa
msgid ""
"``source`` (string, null) (optional) Filter by data source. Examples: "
"'GDACS', 'InciWeb', 'IRWIN'"
msgstr ""

