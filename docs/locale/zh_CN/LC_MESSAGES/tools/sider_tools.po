msgid "**SIDER_get_drugs_for_side_effect** (Type: SiderTool)"
msgstr ""

#: ../../tools/sider_tools.rst:101 5a651e620254440e9b64989109f0bda1
msgid ""
"Find all drugs associated with a specific side effect in SIDER. Returns "
"drugs known to cause the ..."
msgstr ""

#: ../../tools/sider_tools.rst 73a1f9b0dc2a4b8ab1d9f5c2c885b903
msgid "SIDER_get_drugs_for_side_effect tool specification"
msgstr ""

#: ../../tools/sider_tools.rst:107 8d88fbf8ffe9436e9eaf7d7f7d077de2
msgid "**Name**: ``SIDER_get_drugs_for_side_effect``"
msgstr ""

#: ../../tools/sider_tools.rst:109 8f2e4ab963f14d7bbe752f088d19448a
msgid ""
"**Description**: Find all drugs associated with a specific side effect in"
" SIDER. Returns drugs known to cause the given adverse reaction, with "
"frequency information when available (e.g., '7%', '5% - 18%', "
"'postmarketing', 'common'). Provide either a MedDRA code (e.g., C0018681 "
"for headache) or a side effect name (will auto-search). Useful for drug "
"safety comparisons and adverse event analysis."
msgstr ""

#: ../../tools/sider_tools.rst:116 add198e349e043098f7d1c2f7ccb82ae
msgid ""
"``meddra_code`` (string, null) (optional) MedDRA concept code / UMLS CUI "
"(e.g., 'C0018681' for headache, 'C0027497' for nausea)"
msgstr ""

#: ../../tools/sider_tools.rst:119 a6f4110f06af4e5ba186e7a7d3e24e5b
msgid ""
"``side_effect_name`` (string, null) (optional) Side effect name to search"
" (e.g., 'headache', 'nausea', 'diarrhea'). Will search SIDER and use "
"first match."
msgstr ""

#: ../../tools/sider_tools.rst:122 a14a7f40e2fc4da4a93dadeaa6111774
msgid ""
"``limit`` (integer) (optional) Maximum number of drugs to return "
"(default: 50)"
msgstr ""

#: ../../tools/sider_tools.rst:139 53ea6862ae1e416597b831c8b6663682
