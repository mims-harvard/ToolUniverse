#: ../../tools/idigbio_tools.rst:32 b7e7a78868f1454e9463033604d51d5a
msgid ""
"**Description**: Search iDigBio (Integrated Digitized Biocollections) for"
" natural history specimen records from 800+ museums and herbaria "
"worldwide. iDigBio contains 130M+ digitized specimens including plants, "
"animals, fungi, and fossils. Returns specimen records with taxonomic "
"names, collection locations (GPS coordinates), institution codes, "
"collection dates, and catalog numbers. Essential for biodiversity "
"research, biogeography, and ecological studies."
msgstr ""

#: ../../tools/idigbio_tools.rst:34 3f469270354c4a2db1cd1c65d4efd4ed
msgid "**Parameters:**"
msgstr ""

#: ../../tools/idigbio_tools.rst:36 1ad8230b384144d38343bf0c97356143
msgid ""
"``scientificname`` (string, null) (optional) Scientific name to search "
"for. Examples: 'Quercus robur', 'Homo sapiens', 'Drosophila melanogaster'"
msgstr ""

#: ../../tools/idigbio_tools.rst:39 b590ff56d5414a9d891d3621274d65f2
msgid ""
"``kingdom`` (string, null) (optional) Kingdom filter. Values: 'Plantae', "
"'Animalia', 'Fungi', 'Bacteria', 'Chromista'"
msgstr ""

#: ../../tools/idigbio_tools.rst:42 3528e5b066d947ee88a9aa016d8e233f
msgid ""
"``phylum`` (string, null) (optional) Phylum filter. Examples: 'Chordata',"
" 'Arthropoda', 'Magnoliophyta'"
msgstr ""

#: ../../tools/idigbio_tools.rst:45 09bcc9ea257c4925a780cb79072c57a1
msgid ""
"``family`` (string, null) (optional) Family filter. Examples: 'Rosaceae',"
" 'Felidae', 'Orchidaceae'"
msgstr ""

#: ../../tools/idigbio_tools.rst:48 89946988d6c443a98d01d83f57247715
msgid ""
"``genus`` (string, null) (optional) Genus filter. Examples: 'Rosa', "
"'Quercus', 'Drosophila'"
msgstr ""

#: ../../tools/idigbio_tools.rst:51 686e22ad8f0a4ae5a971da05ebf28b57
msgid ""
"``country`` (string, null) (optional) Country filter. Examples: 'United "
"States', 'Germany', 'Brazil'"
msgstr ""

#: ../../tools/idigbio_tools.rst:54 0dc5d43089684b7989a1be8f0cfbf57d
msgid ""
"``stateprovince`` (string, null) (optional) State or province filter. "
"Examples: 'California', 'Bavaria', 'Minas Gerais'"
msgstr ""

#: ../../tools/idigbio_tools.rst:57 f3619e404d5b459db978e22059fa2600
msgid ""
"``institutioncode`` (string, null) (optional) Institution code filter. "
"Examples: 'USNM' (Smithsonian), 'CAS' (California Academy), 'NHMUK' "
"(Natural History Museum London)"
msgstr ""

#: ../../tools/idigbio_tools.rst:60 94ecc99c0e604c4585cbf85b7549a3d8
msgid ""
"``limit`` (integer, null) (optional) Maximum number of records to return "
"(default 10, max 5000)"
msgstr ""

