#: ../../tools/bridgedb_tools.rst:73 b664351133244acbbc2bdc6c51f5a83e
msgid ""
"**Description**: Search for biological identifiers by name using "
"BridgeDb. Enter a gene name, metabolite name, or protein name and get "
"matching identifiers from supported databases. Useful for finding "
"database-specific IDs when you only know the common name. Searches across"
" all database sources available for the specified organism. Returns "
"identifier-database pairs. For example, searching 'glucose' returns "
"matches from MetaCyc, KEGG, and other databases."
msgstr ""

#: ../../tools/bridgedb_tools.rst:77 8f69dc6a33644d52a6ec3aa9a85beafb
msgid "``operation`` (string) (optional) Operation type (fixed: search)"
msgstr ""

#: ../../tools/bridgedb_tools.rst:80 9dc12658c72e4ae0aa63427ed66864fd
msgid ""
"``query`` (string) (required) Name to search for (e.g., 'glucose', "
"'TP53', 'ATP')"
msgstr ""

#: ../../tools/bridgedb_tools.rst:83 755a0b00eddf49719f7f8a8160d37a82
msgid ""
"``organism`` (string) (optional) Organism name (default: Human). Options:"
" Human, Mouse, Rat, Yeast, Worm, Fruit fly, Zebra fish, etc."
msgstr ""

#: ../../tools/bridgedb_tools.rst:100 d60f5af1fdb24d26a1f0d59139735a75
