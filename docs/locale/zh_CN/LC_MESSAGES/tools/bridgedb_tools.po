#: ../../tools/bridgedb_tools.rst:32 ee90ec22f42943e4b0a1043841ebcef6
msgid ""
"**Description**: Get properties and attributes for a biological "
"identifier from BridgeDb. Returns metadata such as molecular formula, "
"molecular weight, InChI, InChIKey, synonyms, and other database-specific "
"attributes. Especially useful for metabolites (HMDB, ChEBI, KEGG compound"
" IDs) to get chemical properties, and for genes to get symbol and name "
"information. System codes: Ch=HMDB, Ce=ChEBI, Ck=KEGG Compound, "
"En=Ensembl, H=HGNC, S=UniProt."
msgstr ""

