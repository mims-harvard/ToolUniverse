msgstr ""

#: ../../tools/bridgedb_tools.rst:102 7473c18d215140578f5a1dc0324d4cac
msgid ""
"Map a biological identifier across databases using BridgeDb. Given an "
"identifier from one databas..."
msgstr ""

#: ../../tools/bridgedb_tools.rst a2eadaec32ae47ac8c9481168dbd04cc
msgid "BridgeDb_xrefs tool specification"
msgstr ""

#: ../../tools/bridgedb_tools.rst:108 d62cf1f98b4d4b6e9606b4a4f7903b15
msgid "**Name**: ``BridgeDb_xrefs``"
msgstr ""

#: ../../tools/bridgedb_tools.rst:110 a5b45b47519f42f08ba8158982c3f557
msgid ""
"**Description**: Map a biological identifier across databases using "
"BridgeDb. Given an identifier from one database (e.g., HMDB0000122 from "
"HMDB), returns equivalent identifiers in all other supported databases "
"(ChEBI, KEGG, PubChem, Wikidata, CAS, etc.). Supports genes, proteins, "
"metabolites, and other biological entities across 45+ databases and 30+ "
"organisms. System codes: Ch=HMDB, Ce=ChEBI, Ck=KEGG Compound, En=Ensembl,"
" H=HGNC, S=UniProt, L=NCBI Gene, Cpc=PubChem-compound, Ik=InChIKey. Use "
"this when you need to convert between database identifiers for the same "
"biological entity."
msgstr ""

#: ../../tools/bridgedb_tools.rst:114 89cf6bee5c8c40e39b616105a3d7123d
msgid "``operation`` (string) (optional) Operation type (fixed: xrefs)"
msgstr ""

#: ../../tools/bridgedb_tools.rst:117 9541bf78907e4cd9b16187ddc8317260
msgid ""
"``identifier`` (string) (required) The identifier to look up (e.g., "
"'HMDB0000122' for glucose, 'ENSG00000141510' for TP53, '17234' for ChEBI "
"glucose)"
msgstr ""

#: ../../tools/bridgedb_tools.rst:120 71a1157bde4242ff8c3749ce95589f74
msgid ""
"``source`` (string) (optional) Source database name or system code. "
"Common codes: Ch=HMDB, Ce=ChEBI, Ck=KEGG Compound, En=Ensembl, H=HGNC, "
"S=UniProt, L=NCBI Gene, Cpc=PubChem-compound"
msgstr ""

#: ../../tools/bridgedb_tools.rst:123 9b8ddba8568d4e3d8b7fa8b243494c7a
msgid ""
"``source_database`` (string) (optional) Alias for source. Source database"
" name or system code."
msgstr ""

#: ../../tools/bridgedb_tools.rst:126 00ec675f8a8d43cea6b4a3d154024877
msgid ""
"``organism`` (string) (optional) Organism name (default: Human). Options "
"include: Human, Mouse, Rat, Yeast, Worm, Fruit fly, Zebra fish, "
"Arabidopsis thaliana, and others."
msgstr ""

#: ../../tools/bridgedb_tools.rst:129 6c4588c7da334c2ea7a7c4eee940fc57
msgid ""
"``target_source`` (string) (optional) Optional: filter results to a "
"specific target database. Use database name or system code."
msgstr ""

