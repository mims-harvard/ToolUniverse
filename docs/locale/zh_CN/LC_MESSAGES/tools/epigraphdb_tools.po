#: ../../tools/epigraphdb_tools.rst:58 f466e37178714d40ba4f19cf9a6dbcc5
msgid ""
"Get pharmacogenomics drug-gene associations from CPIC and PharmGKB "
"databases via EpiGraphDB. Retu..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst d4f1e5ff8f70492f82eb2f5846b1a994
msgid "EpiGraphDB_get_gene_drug_associations tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:64 b4df1a65e20349eeb86ebd72bd524a83
msgid "**Name**: ``EpiGraphDB_get_gene_drug_associations``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:66 5c5b8564e4e5466aac1a99fc3b187ace
msgid ""
"**Description**: Get pharmacogenomics drug-gene associations from CPIC "
"and PharmGKB databases via EpiGraphDB. Returns drugs associated with a "
"gene with clinical evidence levels. Example: 'DPYD' returns fluorouracil "
"with CPIC Level A evidence."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:70 64d568e70ba946cfa5692bdfa3a29873
msgid ""
"``gene_name`` (string) (optional) Gene symbol to find drug associations "
"for (e.g., 'TP53', 'EGFR', 'DPYD', 'CYP2D6')."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:73 362deb5715db4219a07d9237e6c4dcff
msgid ""
"``gene_symbol`` (string) (optional) Alias for gene\\_name. Gene symbol "
"(e.g., 'CYP2D6', 'BRCA1')."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:76 21717aa86e504f0f9986b337d3d2c511
msgid "``pval_threshold`` (number) (optional) P-value threshold (default 0.05)."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:92 bf7046a6d2354ddaa63e3f27800df810
msgid "**EpiGraphDB_get_genetic_correlations** (Type: EpiGraphDBTool)"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:94 f12bc743c2bf4d34b713e7791e82ba8f
msgid ""
"Get genetic correlations (rg) between a GWAS trait and all other traits "
"in the IEU OpenGWAS datab..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst eff049adb95740b2930ec5bf00218989
msgid "EpiGraphDB_get_genetic_correlations tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:100 dda07086bdf744a79d7d63cbaeb07d18
msgid "**Name**: ``EpiGraphDB_get_genetic_correlations``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:102 41841531f56c4dfeabcda563af2da3f4
msgid ""
"**Description**: Get genetic correlations (rg) between a GWAS trait and "
"all other traits in the IEU OpenGWAS database. Returns traits with "
"significant genetic overlap. Useful for understanding shared genetic "
"architecture between diseases. Example: 'Body mass index' shows high "
"genetic correlation with waist circumference, diabetes."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:106 a17bb6deade94044a150f0e0cbbf2fd1
msgid ""
"``trait`` (string) (required) GWAS trait name to find genetic "
"correlations for (e.g., 'Body mass index', 'Depression', 'Type 2 "
"diabetes')."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:109 6aefeaf0f2514097b8de61f469fffd16
msgid ""
"``pval_threshold`` (number) (optional) P-value threshold for genetic "
"correlations (default 0.05)."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:126 3750461e69644d40bc8c6eca04966abd
msgid "**EpiGraphDB_get_mendelian_randomization** (Type: EpiGraphDBTool)"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:128 4424065a017148d88db0c75e5dd0fc92
msgid ""
"Get Mendelian Randomization (MR) evidence for a causal relationship "
"between an exposure trait and..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst b92330200f48426d8ba6f45bb3e65dc0
msgid "EpiGraphDB_get_mendelian_randomization tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:134 f625ba83023a4a1693e441290b730ec9
msgid "**Name**: ``EpiGraphDB_get_mendelian_randomization``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:136 4d6fa87b9b614aa39dd53f4a3d01abac
msgid ""
"**Description**: Get Mendelian Randomization (MR) evidence for a causal "
"relationship between an exposure trait and an outcome trait using IEU "
"OpenGWAS data. Returns MR estimates (beta, SE, p-value) from multiple "
"instruments/methods. Example: exposure='Body mass index', "
"outcome='Coronary heart disease' returns causal effect estimates."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:140 3c39b519eb014020b15dd5d92bca0fc5
msgid ""
"``exposure_trait`` (string) (required) GWAS trait name for the exposure "
"(e.g., 'Body mass index', 'LDL cholesterol', 'Type 2 diabetes'). Use "
"EpiGraphDB\\_search\\_opengwas to find exact trait names."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:143 443f14e8a28f41349dcc77674a03b735
msgid ""
"``outcome_trait`` (string) (required) GWAS trait name for the outcome "
"(e.g., 'Coronary heart disease', 'Stroke', 'Alzheimer disease'). Use "
"EpiGraphDB\\_search\\_opengwas to find exact trait names."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:146 40d33cb1ed3e49b1b52b52caa78b0df1
msgid ""
"``pval_threshold`` (number) (optional) P-value threshold for instrument "
"selection (default 1e-5)."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:164 d562be5dce4944fba3bd0a2e0de20cce
msgid "**EpiGraphDB_map_gwas_to_efo** (Type: EpiGraphDBTool)"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:166 662470eb7aa74ec4a0546be62f3640c9
msgid ""
"Map GWAS trait names to EFO (Experimental Factor Ontology) terms for "
"standardization. Returns EFO..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst 46bdadc8fc394cb29889943d68d84e14
msgid "EpiGraphDB_map_gwas_to_efo tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:172 e69f37d1129e4001a7e72ef0896250f5
msgid "**Name**: ``EpiGraphDB_map_gwas_to_efo``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:174 9b69ba12c846430fabac604e8caba801
msgid ""
"**Description**: Map GWAS trait names to EFO (Experimental Factor "
"Ontology) terms for standardization. Returns EFO IDs and labels "
"corresponding to a GWAS trait. Useful for cross-database trait "
"harmonization. Example: 'Body mass index' maps to EFO:0004340."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:178 ef599cf7604a456092b5f706b239d086
msgid ""
"``trait`` (string) (required) GWAS trait name to map to EFO (e.g., 'Body "
"mass index', 'coronary artery disease', 'type 2 diabetes')."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:195 8f8f099f492748bda58952c29cd49d8a
msgid "**EpiGraphDB_search_gene** (Type: EpiGraphDBTool)"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:197 af9c56f0895f43eea3efef8dd993306b
msgid ""
"Search for gene information in EpiGraphDB by gene symbol or Ensembl ID. "
"Returns gene metadata inc..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst 8fe53e8fbd0a4160a76b8ea8509b4dc1
msgid "EpiGraphDB_search_gene tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:203 4174df5349654cfb9a83e57fec27e07d
msgid "**Name**: ``EpiGraphDB_search_gene``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:205 6dd8a70fdc484eef9dd6f65ec1fa1471
msgid ""
"**Description**: Search for gene information in EpiGraphDB by gene symbol"
" or Ensembl ID. Returns gene metadata including druggability "
"classification, chromosomal location, and gene type. Example: 'BRCA1' "
"returns Tier 2 druggability, chr17 location."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:209 9b828776dcbb4b51a868c5d496d0c1f1
msgid ""
"``gene_name`` (string, null) (optional) Gene symbol to search for (e.g., "
"'BRCA1', 'TP53', 'EGFR'). Either gene\\_name or gene\\_id required."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:212 bea7e38c3b4f48e08bf66b56e53959b6
msgid ""
"``gene_id`` (string, null) (optional) Ensembl gene ID (e.g., "
"'ENSG00000012048'). Either gene\\_name or gene\\_id required."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:215 6cf3ccde0f2c471abd9fed43ba27245e
msgid ""
"``limit`` (integer) (optional) Maximum results to return (default 10, max"
" 50)."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:231 721e5916e4774528a62993be892b70f2
msgid "**EpiGraphDB_search_opengwas** (Type: EpiGraphDBTool)"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:233 f69137da9b244316b649bc2f4a22e779
msgid ""
"Search the IEU OpenGWAS database for GWAS studies by trait name. Returns "
"matching GWAS study IDs ..."
msgstr ""

#: ../../tools/epigraphdb_tools.rst b9428313d9fc4873b5966da2fdad6d3a
msgid "EpiGraphDB_search_opengwas tool specification"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:239 66ff261a9b21417195e849fdd26b8e6d
msgid "**Name**: ``EpiGraphDB_search_opengwas``"
msgstr ""

#: ../../tools/epigraphdb_tools.rst:241 d4c535947f314c93ace8bbfa9c7d7f6f
msgid ""
"**Description**: Search the IEU OpenGWAS database for GWAS studies by "
"trait name. Returns matching GWAS study IDs and trait names with "
"similarity scores. OpenGWAS IDs (e.g., 'ieu-a-2') are needed as inputs "
"for Mendelian Randomization analyses. Example: 'body mass index' returns "
"'ieu-a-2', 'ieu-b-40', etc."
msgstr ""

#: ../../tools/epigraphdb_tools.rst:245 829d7f63f0d24a98b642e2ba38e3abda
msgid ""
"``query`` (string) (required) Trait or phenotype name to search for in "
"OpenGWAS (e.g., 'body mass index', 'coronary heart disease', 'type 2 "
"diabetes', 'blood pressure')."
msgstr ""

