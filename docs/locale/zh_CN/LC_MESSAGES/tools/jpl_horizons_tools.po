#: ../../tools/jpl_horizons_tools.rst:63 03b32a5866a9408dae9f601ccd4cf9d6
msgid ""
"**Description**: Search for solar system objects in the JPL Horizons "
"database by name, partial name, or designation. Returns a list of "
"matching objects with their SPK IDs (used for ephemeris queries), object "
"type (planet, asteroid, comet, spacecraft, satellite), and alternate "
"names/designations. The SPK ID is needed to query ephemerides. Examples: "
"'Mars' returns planets, spacecraft, and missions; '2020 SO' returns near-"
"Earth objects; 'Ceres' returns the dwarf planet."
msgstr ""

#: ../../tools/jpl_horizons_tools.rst:67 ddfc25383b014b88a0e54dc0ae516e64
msgid ""
"``sstr`` (string) (required) Object name or partial name to search. "
"Examples: 'Mars', 'Jupiter', 'Ceres', 'Halley', '1P' (Halley's Comet "
"designation), 'Apophis', 'Voyager', 'Cassini'"
msgstr ""

