msgstr ""

#: ../../tools/eva_tools.rst:36 9428b4e5bfc64788b13ff8ae424d7ce7
msgid ""
"``gene`` (string) (required) Gene symbol (HGNC format, e.g., 'BRCA1', "
"'TP53', 'EGFR', 'BRCA2', 'APOE')"
msgstr ""

