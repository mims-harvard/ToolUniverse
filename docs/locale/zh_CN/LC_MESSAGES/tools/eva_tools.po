#: ../../tools/eva_tools.rst:69 c61deea5f4464f58a19304ff5bf79739
msgid ""
"**Description**: Get genetic variants from the European Variation Archive"
" (EVA) within a specific genomic region. Returns all known variants in "
"the specified chromosomal coordinate range, including SNVs, indels, and "
"structural variants with allele frequencies from multiple studies. Useful"
" for scanning variant hotspots or checking variants in regulatory "
"regions. The endpoint URL uses 'chromosome:start-end' format."
msgstr ""

#: ../../tools/eva_tools.rst:73 f47f3115fbff4a26a257ac902a42e92e
msgid ""
"``region`` (string) (required) Genomic region in 'chr:start-end' format "
"(e.g., '17:41200000-41210000', '7:140753300-140753400', "
"'19:44905700-44910000')"
msgstr ""

#: ../../tools/eva_tools.rst:76 f98fb2cd7cb043718933ea6de463f211
msgid ""
"``species`` (string) (optional) Species and assembly (e.g., "
"'hsapiens\\_grch38', 'hsapiens\\_grch37')"
msgstr ""

#: ../../tools/eva_tools.rst:79 6f14a859f62e4c3b925c5dcb295753a5
msgid "``limit`` (integer) (optional) Maximum number of variants to return"
msgstr ""

