#: ../../tools/go_api_tools.rst:32 1114cc55b28544a8b5442f5e909abbd1
msgid ""
"**Description**: Get Gene Ontology (GO) annotations for a specific gene, "
"showing its known biological processes, molecular functions, and cellular"
" components. Returns GO terms with evidence types (IDA=direct assay, "
"IMP=mutant phenotype, ISS=sequence similarity, etc.) and literature "
"references. Input is a gene CURIE identifier. Example: HGNC:11998 (TP53) "
"returns annotations like 'apoptotic process', 'DNA binding', 'nucleus'."
msgstr ""

#: ../../tools/go_api_tools.rst:34 ../../tools/go_api_tools.rst:71
#: ../../tools/go_api_tools.rst:108 444121b8822e4450811c7c1eb8ab51e2
#: 9029faf32ff1462a9f13f7d3ef10ae18 df1945d71e26423096e769b2f97d4528
msgid "**Parameters:**"
msgstr ""

#: ../../tools/go_api_tools.rst:36 3ce51161a8f7476aab46e0c6d8248921
msgid ""
"``gene_id`` (string) (required) Gene identifier as a CURIE. Examples: "
"'HGNC:11998' (TP53), 'UniProtKB:P04637' (p53 protein), 'HGNC:1100' "
"(BRCA1), 'MGI:MGI:98834' (Trp53 mouse). For human genes, use HGNC prefix."
msgstr ""

#: ../../tools/go_api_tools.rst:39 4e3750941c1441648ef81427e627c778
msgid ""
"``rows`` (integer) (optional) Maximum number of annotations to return "
"(default: 20, max: 100)."
msgstr ""

#: ../../tools/go_api_tools.rst:42 c044771aec3f4e2d8583a0e39b0f4a55
msgid ""
"``aspect`` (string) (optional) Filter by GO aspect: 'P' (Biological "
"Process), 'F' (Molecular Function), 'C' (Cellular Component). Default: "
"all aspects."
msgstr ""

