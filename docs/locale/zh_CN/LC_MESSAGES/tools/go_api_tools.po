#: ../../tools/go_api_tools.rst:104 c43ae390044043d48fcb37723e34cec0
msgid "**Name**: ``GOAPI_get_term``"
msgstr ""

#: ../../tools/go_api_tools.rst:106 ea12b7fb1dcd48019d6dc0d66399e1d1
msgid ""
"**Description**: Get detailed information about a Gene Ontology (GO) term"
" by its GO ID. Returns the term label, full definition, synonyms, cross-"
"references, and alternative IDs. GO terms describe gene product "
"attributes across three domains: Biological Process (BP), Molecular "
"Function (MF), and Cellular Component (CC). Example: GO:0006915 returns "
"'apoptotic process' with its definition and related terms."
msgstr ""

#: ../../tools/go_api_tools.rst:110 be5cd8dde64145f682905327a38b0e25
msgid ""
"``go_id`` (string) (required) Gene Ontology term ID. Format: GO:NNNNNNN. "
"Examples: 'GO:0006915' (apoptotic process), 'GO:0008285' (negative "
"regulation of cell population proliferation), 'GO:0005634' (nucleus), "
"'GO:0003677' (DNA binding)."
msgstr ""

