#: ../../tools/go_api_tools.rst:69 af5e5d08ae4e429ea8a307a7a781831c
msgid ""
"**Description**: Get genes annotated with a specific Gene Ontology (GO) "
"term. Find all genes/proteins that have been experimentally or "
"computationally associated with a biological process, molecular function,"
" or cellular component. Optionally filter by taxon. Example: GO:0006915 "
"(apoptotic process) returns genes like TP53, BAX, BCL2 that function in "
"apoptosis."
msgstr ""

#: ../../tools/go_api_tools.rst:73 352dbede900d4393842378363545ab2f
msgid ""
"``go_id`` (string) (required) Gene Ontology term ID. Examples: "
"'GO:0006915' (apoptotic process), 'GO:0003677' (DNA binding), "
"'GO:0005634' (nucleus)."
msgstr ""

#: ../../tools/go_api_tools.rst:76 22f719344b224ebdbfb7a30ebe17169a
msgid ""
"``rows`` (integer) (optional) Maximum number of gene annotations to "
"return (default: 20, max: 100)."
msgstr ""

#: ../../tools/go_api_tools.rst:79 05d966547f1440a68bf86aa383c9d35e
msgid ""
"``taxon`` (string) (optional) Filter by taxon. Format: NCBITaxon:ID. "
"Examples: 'NCBITaxon:9606' (human), 'NCBITaxon:10090' (mouse), "
"'NCBITaxon:7227' (Drosophila)."
msgstr ""

