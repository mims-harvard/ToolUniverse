#: ../../tools/neurovault_tools.rst:63 701344dddb5e48758ffbc93b9748798a
msgid ""
"**Description**: Get detailed metadata for a specific brain statistical "
"map image in NeuroVault by image ID. Returns comprehensive information "
"including map type (T/Z/F map), cognitive paradigm and contrast "
"annotations from Cognitive Atlas, analysis level, modality, and file "
"download URL (NIfTI format). Use image IDs from "
"NeuroVault\\_list\\_collection\\_images. Example: image 3128 is a Z map "
"of 'emotion processing fMRI task paradigm' showing FACES minus SHAPES "
"contrast from the Human Connectome Project."
msgstr ""

#: ../../tools/neurovault_tools.rst:67 7969c7f943344bda95a6e7b06d0835a6
msgid ""
"``image_id`` (integer) (required) NeuroVault image ID. Examples: 3128 "
"(HCP emotion task Z map), 946 (pain T map)"
msgstr ""

