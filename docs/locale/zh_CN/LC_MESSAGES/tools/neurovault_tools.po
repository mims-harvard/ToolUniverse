"return per page (default 10, max 100). Example: 10"
msgstr ""

#: ../../tools/neurovault_tools.rst:138 953dc3fdcfff4d3297f8ac7ff0b2daa8
msgid ""
"``offset`` (integer, null) (optional) Number of collections to skip for "
"pagination (default 0). Example: 20 to get page 3 with limit=10"
msgstr ""

