#: ../../tools/bgee_tools.rst:32 2bd99c1fa0a34e9a9f8c0237a594aa49
msgid ""
"**Description**: Get expression data for a gene across tissues and organs"
" from the Bgee database. Returns where a gene is expressed with "
"expression scores, confidence levels, and quality ratings. Supports RNA-"
"Seq, Affymetrix, EST, and in situ hybridization data types. Requires both"
" an Ensembl gene ID and NCBI taxonomy ID. Example: ENSG00000141510 (TP53)"
" with species 9606 (human) returns expression across 145+ tissues "
"including ventricular zone (score 95.11), ganglionic eminence, and "
"monocytes."
msgstr ""

#: ../../tools/bgee_tools.rst:34 ../../tools/bgee_tools.rst:69
#: ../../tools/bgee_tools.rst:98 365190ed8c3b4061bc7b0b76ded2339d
#: 49d5e6d787394700ab70fd01ea1b9cee 8bbfe01c1cb74f46b70a9e4faa359d6b
msgid "**Parameters:**"
msgstr ""

#: ../../tools/bgee_tools.rst:36 32f4b93d32e64797910f1d8c77457b0e
msgid ""
"``gene_id`` (string) (required) Ensembl gene ID. Examples: "
"'ENSG00000141510' (human TP53), 'ENSMUSG00000059552' (mouse Trp53), "
"'ENSDARG00000115148' (zebrafish tp53)."
msgstr ""

#: ../../tools/bgee_tools.rst:39 f9b36a09daad4706af02a31829101676
msgid ""
"``species_id`` (string) (required) NCBI taxonomy ID for the species. "
"Examples: '9606' (human), '10090' (mouse), '7955' (zebrafish), '7227' "
"(fruit fly)."
msgstr ""

