#: ../../tools/uniref_tools.rst:32 4f5e81185f3045b799b5da19ec4b6a6f
msgid ""
"**Description**: Get detailed information about a UniProt UniRef protein "
"sequence cluster. UniRef clusters group related protein sequences at "
"different identity thresholds: UniRef100 (identical sequences + sub-"
"fragments), UniRef90 (90%+ identity), UniRef50 (50%+ identity). Returns "
"cluster name, member count, representative member details (protein name, "
"organism, accession, sequence length), common taxon, seed sequence, "
"update date, and full protein sequence. Use this to understand protein "
"sequence families and find representative sequences."
msgstr ""

#: ../../tools/uniref_tools.rst:34 ../../tools/uniref_tools.rst:65
#: 7f428a219c994ba0884311dbb36fc60b a72b751e3a19442e9e2bec5ca1b80070
msgid "**Parameters:**"
msgstr ""

#: ../../tools/uniref_tools.rst:36 5b3e6749c4c94d46a7f757154a1e0e08
#, python-format
msgid ""
"``cluster_id`` (string) (required) UniRef cluster ID. Format: "
"UniRefNN\\_ACCESSION. Examples: 'UniRef90\\_P04637' (p53 cluster at 90% "
"identity, 160 members), 'UniRef50\\_P04637' (p53 at 50% identity), "
"'UniRef100\\_P04637' (identical to p53), 'UniRef90\\_P00533' (EGFR at "
"90%)."
msgstr ""

