#: ../../tools/ncbi_nucleotide_tools.rst:56 d50bf5cf35df43458c85690ff1e9ef99
msgid "**NCBI_get_sequence** (Type: NCBINucleotideSearchTool)"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:58 245cbbb6c35b4aa2905c13895123f939
msgid ""
"Retrieve DNA/RNA sequence data from NCBI by accession number. Returns "
"sequences in specified form..."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst b248e3408ee44e46af440ead6ade9789
msgid "NCBI_get_sequence tool specification"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:64 5c3c4235cc3d479ca9015279e3278f45
msgid "**Name**: ``NCBI_get_sequence``"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:66 078f7d314a624b0695760d20aa8cee0c
msgid ""
"**Description**: Retrieve DNA/RNA sequence data from NCBI by accession "
"number. Returns sequences in specified format (fasta, gb, embl). Works "
"with both EMBL/GenBank accessions (U00096, M15390) and RefSeq accessions "
"(NC\\_045512, NM\\_000546). Use this to get actual sequence data after "
"finding accessions with NCBI\\_search\\_nucleotide. Returns full sequence"
" with annotations depending on format."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:70 15e4992907f341f1af4826e7944fcc45
msgid ""
"``operation`` (unknown) (optional) Operation type (fixed: "
"fetch\\_sequence)"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:73 4fe12ff4d795467da967a8c7b8325425
msgid ""
"``accession`` (string) (required) NCBI accession number (e.g., 'U00096', "
"'NC\\_045512', 'NM\\_000546'). Works with GenBank, EMBL, and RefSeq "
"accessions."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:76 1aa8cd91cbd44e1cb79e833d8643fdcd
msgid ""
"``format`` (string) (optional) Sequence format: 'fasta' for FASTA, 'gb' "
"for GenBank, 'embl' for EMBL, 'gp' for GenPept protein. Default: fasta"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:93 70ab6f1525c64caca2accb610f7671ed
msgid "**NCBI_search_nucleotide** (Type: NCBINucleotideSearchTool)"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:95 4e12a6155c91455e941350b7f9e91390
msgid ""
"Search NCBI Nucleotide database (GenBank/EMBL/RefSeq) by organism, gene "
"name, or keywords. Return..."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst 92843067d858415192953db70fe6013c
msgid "NCBI_search_nucleotide tool specification"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:101 cf999a02dcac482b80b39cc850091d57
msgid "**Name**: ``NCBI_search_nucleotide``"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:103 3ced875850ca46c485451398cf6977d6
msgid ""
"**Description**: Search NCBI Nucleotide database (GenBank/EMBL/RefSeq) by"
" organism, gene name, or keywords. Returns GenBank UIDs which can be used"
" to fetch accession numbers. Supports filtering by organism, gene, "
"strain, sequence type (complete genome, mRNA, RefSeq). Use this to "
"discover DNA/RNA sequences for specific organisms or genes. Returns both "
"EMBL/GenBank accessions (U00096, M15390) and RefSeq accessions (NC\\_\\*,"
" NM\\_\\*). Follow up with NCBI\\_fetch\\_accessions to get actual "
"accession numbers."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:107 4ee25587337043e19ec4b848f067ff29
msgid "``operation`` (unknown) (optional) Operation type (fixed: search)"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:110 5ff7c621d57b4ea993c3de76b2666ec7
msgid ""
"``organism`` (string) (optional) Organism name to search (e.g., "
"'Escherichia coli', 'Homo sapiens'). Searches in [Organism] field."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:113 f455d8077d4746aa9dee85e34a9b56e7
msgid ""
"``gene`` (string) (optional) Gene name to search (e.g., 'BRCA1', 'TP53')."
" Searches in [Gene] field."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:116 21720adf54db4315966f83268b06f7b1
msgid ""
"``strain`` (string) (optional) Strain name to filter (e.g., 'K-12', "
"'MG1655'). Searches in [Strain] field."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:119 c12c86637d8f43fe9f217c19c62bf104
msgid ""
"``keywords`` (string) (optional) Keywords to search in titles (e.g., "
"'complete genome', 'mitochondrial'). Searches in [Title] field."
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:122 fddc0fdaf8d4473e9e721dda209262fd
msgid ""
"``seq_type`` (string) (optional) Sequence type filter: "
"'complete\\_genome' for complete genomes, 'mrna' for mRNA sequences, "
"'refseq' for RefSeq curated sequences"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:125 3c3a2ee9c0c141258847e5c950fb9544
msgid ""
"``query`` (string) (optional) Free-form search query if not using "
"structured filters. Use NCBI query syntax (e.g., '(Escherichia "
"coli[Organism]) AND (K-12[Strain])')"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:128 663972ad2df34ec288162e1f1b0ea390
msgid ""
"``limit`` (integer) (optional) Maximum number of results to return "
"(default: 20, max: 100)"
msgstr ""

#: ../../tools/ncbi_nucleotide_tools.rst:131 7dc3cd43ef20400fb53c1900ab68606b
msgid "``sort`` (string) (optional) Sort order for results (default: relevance)"
msgstr ""

