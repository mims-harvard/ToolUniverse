#: ../../tools/gene2phenotype_tools.rst:63 9127210f075449f7b66f010b30531941
msgid ""
"**Description**: Get summary statistics for a Gene2Phenotype clinical "
"panel. G2P organizes gene-disease associations into expert-curated "
"panels: DD (developmental disorders), Cancer, Skeletal, Eye, Cardiac, "
"Ear, Skin, and Prenatal. Returns panel name, description, last update "
"date, total records count, total genes, and breakdown by confidence level"
" (definitive, strong, moderate, limited)."
msgstr ""

#: ../../tools/gene2phenotype_tools.rst:67 1b4083ad34c74868a50db4d502077a9b
msgid ""
"``panel`` (string) (required) Panel name: 'cancer', 'dd' (developmental "
"disorders), 'skeletal', 'eye', 'cardiac', 'ear', 'skin', 'prenatal'"
msgstr ""

