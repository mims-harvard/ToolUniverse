#: ../../tools/cod_crystal_tools.rst:63 5ef61f065fe64b77886c4bbe8aab1120
msgid "**Name**: ``COD_search_structures``"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:65 0573e8f2176d4cfd878baa9b0c36ba2b
msgid ""
"**Description**: Search the Crystallography Open Database (COD) for "
"crystal structures by chemical formula, elements, space group, mineral "
"name, or compound name. COD is the largest open-access collection of "
"crystal structures with 500,000+ experimentally determined structures. "
"Returns unit cell parameters (a, b, c, alpha, beta, gamma), space group, "
"chemical formula, mineral/compound name, and publication details (DOI, "
"journal, authors). Useful for materials science, chemistry, mineralogy, "
"and solid-state physics research."
msgstr ""

#: ../../tools/cod_crystal_tools.rst:69 f7f43c3577344f6687e0e6d0f10c9f27
msgid ""
"``query`` (string, null) (optional) Alias for 'text'. Free text search "
"across titles, keywords, and compound names. Examples: 'aspirin', "
"'perovskite', 'diamond'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:72 2f515f2126164ca99b37cccdb54e3075
msgid ""
"``text`` (string, null) (optional) Free text search across titles, "
"keywords, and compound names. Examples: 'aspirin', 'perovskite', "
"'diamond', 'zeolite', 'ice'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:75 eb0efc97147c4ffbb9edf2f7971a8ff4
msgid ""
"``formula`` (string, null) (optional) Chemical formula to search (use "
"spaces between elements). Examples: 'Fe2 O3', 'Si O2', 'Na Cl', 'C H4'. "
"Exact formula matching."
msgstr ""

#: ../../tools/cod_crystal_tools.rst:78 599d2f49139b4d758003a9f75485b043
msgid ""
"``el1`` (string, null) (optional) First required element (chemical "
"symbol). Examples: 'Cu', 'Fe', 'Si', 'C', 'N'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:81 cb0ca5e2bcc847c78fac57ac310b0413
msgid ""
"``el2`` (string, null) (optional) Second required element (chemical "
"symbol)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:84 b30631c53958486299e64e3d7b3caae5
msgid "``el3`` (string, null) (optional) Third required element (chemical symbol)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:87 696194f72aa1405eb3c44513509f5ba3
msgid ""
"``nel`` (string, null) (optional) Number of distinct elements in formula "
"(e.g., '2' for binary compounds, '3' for ternary)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:90 b7ded393426a462d9b854a62c45936a4
msgid ""
"``commonname`` (string, null) (optional) Common/trivial name search "
"(partial match). Examples: 'quartz', 'perovskite', 'zeolite', 'diamond'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:93 10181c4979204664a43da0d4147c61a0
msgid ""
"``mineral`` (string, null) (optional) Mineral name search (partial "
"match). Examples: 'calcite', 'feldspar', 'pyrite', 'magnetite'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:96 f185a236941c48d5ad3bf9119aca7fb0
msgid ""
"``spacegroup`` (string, null) (optional) Alias for 'sg'. Space group "
"symbol (Hermann-Mauguin notation). Examples: 'P 21/c', 'Fm -3 m', 'P 1'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:99 67d8b629eba447cf9360afff82f26b06
msgid ""
"``sg`` (string, null) (optional) Space group symbol (Hermann-Mauguin "
"notation). Examples: 'P 21/c', 'Fm -3 m', 'P 1'"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:102 33f7814ceeca4c1a938852c2b3b22590
msgid ""
"``sgNumber`` (string, null) (optional) Space group number (1-230). "
"Examples: '225' (Fm-3m, FCC metals), '62' (Pnma, common for perovskites)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:105 a77ac7b68a0f4b258db78abcd155951b
msgid ""
"``max_results`` (integer, null) (optional) Alias for 'results'. Maximum "
"number of results to return (default 100, use smaller values for speed, "
"e.g. 5 or 10)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:108 48647fda19a54b9a8f50b4ca993ac433
msgid ""
