msgstr ""

#: ../../tools/cod_crystal_tools.rst:36 1722d0f987344bef8432fbe636de14c2
msgid ""
"``cod_id`` (string) (optional) Alias for 'id'. COD structure entry ID "
"(numeric string). Examples: '9008460' (Aluminum), '1011240' (Hematite "
"Fe2O3), '5900000' (Methane), '1515581' (Aspirin)"
msgstr ""

#: ../../tools/cod_crystal_tools.rst:39 e7b1102b70064a0b90fcfb88855ecc63
msgid ""
"``id`` (string) (optional) COD structure entry ID (numeric string). "
"Examples: '9008460' (Aluminum), '1011240' (Hematite Fe2O3), '5900000' "
