#: ../../tools/rhea_tools.rst:32 7980957060b3419d8028db27ea54dd2c
msgid ""
"**Description**: Search for biochemical reactions involving a specific "
"ChEBI compound in Rhea. Returns reactions where the given compound "
"participates as a substrate, product, or cofactor. All Rhea reactions are"
" linked to ChEBI compound identifiers. Example: CHEBI:17234 (glucose) "
"returns reactions including lactose hydrolysis, glucose isomerization, "
"and glucose oxidation with their balanced equations and EC numbers."
msgstr ""

#: ../../tools/rhea_tools.rst:34 ../../tools/rhea_tools.rst:68
#: ../../tools/rhea_tools.rst:102 17eba4d32bac4d1088dfe1f1e689ac59
