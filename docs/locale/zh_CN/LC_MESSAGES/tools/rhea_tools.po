#: ../../tools/rhea_tools.rst dbc23178444f40dc92bd67d57c95cfad
msgid "Rhea_search_by_ec tool specification"
msgstr ""

#: ../../tools/rhea_tools.rst:64 707e822fb0834b8ba271079d13cead43
msgid "**Name**: ``Rhea_search_by_ec``"
msgstr ""

#: ../../tools/rhea_tools.rst:66 73f91c2422ac448b92f64aade645ae31
msgid ""
"**Description**: Search for biochemical reactions in Rhea by EC (Enzyme "
"Commission) number. Returns all reactions catalyzed by enzymes in a given"
" EC class. Useful for finding the specific biochemical transformations "
"catalyzed by a class of enzymes. Example: EC:1.1.1.1 (alcohol "
"dehydrogenase) returns reactions including 'a primary alcohol + NAD(+) = "
"an aldehyde + NADH + H(+)' and 'ethanol + NAD(+) = acetaldehyde + NADH + "
"H(+)'."
msgstr ""

#: ../../tools/rhea_tools.rst:70 29ca04082bf84733bd048dd270ed2054
msgid ""
"``ec_number`` (string) (required) EC (Enzyme Commission) number. Can "
"include or omit 'EC:' prefix. Examples: 'EC:1.1.1.1' (alcohol "
"dehydrogenase), '3.5.1.50' (pentanamidase), '2.7.1.1' (hexokinase), "
"'1.14.13.39' (nitric-oxide synthase)."
msgstr ""

