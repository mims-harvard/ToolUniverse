#: ../../tools/progenetix_tools.rst:78 42637ffe4db34e189e8ec0c3e47c664c
msgid "**Name**: ``Progenetix_list_cohorts``"
msgstr ""

#: ../../tools/progenetix_tools.rst:80 f7ccb64536ad4870addd969bf6c2bdd3
msgid ""
"**Description**: List available cohorts in the Progenetix cancer CNV "
"database. Returns cohort IDs, names, sizes, and data types. Progenetix "
"organizes samples into cohorts like TCGA, DIPG studies, and curated "
"cancer sets. Example: returns 6 cohorts including TCGA (517 samples) and "
"DIPG (16 samples)."
msgstr ""

#: ../../tools/progenetix_tools.rst:84 a4e546abcbae481b96fcd1f91ae6f55c
msgid ""
"``limit`` (integer) (optional) Maximum number of cohorts to return "
"(default: 10)."
msgstr ""

#: ../../tools/progenetix_tools.rst:100 a5ca4eb051244fd9a95792050051bc77
msgid "**Progenetix_list_filtering_terms** (Type: ProgenetixTool)"
msgstr ""

#: ../../tools/progenetix_tools.rst:102 fe1376322a054f67aa8118efd8e37a9f
msgid ""
"List available filtering terms (ontology codes) in the Progenetix cancer "
"CNV database. Returns NC..."
msgstr ""

#: ../../tools/progenetix_tools.rst 63b4633e8bbc4915b5e7f74b4794e97e
msgid "Progenetix_list_filtering_terms tool specification"
msgstr ""

#: ../../tools/progenetix_tools.rst:108 09ffc8470cb14ebcb27118a173bf5be4
msgid "**Name**: ``Progenetix_list_filtering_terms``"
msgstr ""

#: ../../tools/progenetix_tools.rst:110 943f326802f1418a8a26062b08ecf22a
msgid ""
"**Description**: List available filtering terms (ontology codes) in the "
"Progenetix cancer CNV database. Returns NCIt cancer type codes, EDAM "
"operation codes, or other ontology terms with the number of matching "
"samples. Useful for discovering which cancer types are available before "
"querying biosamples or individuals. Example: prefixes='NCIT' returns 890 "
"NCIt terms across all cancer types."
msgstr ""

#: ../../tools/progenetix_tools.rst:114 114508f5666b431abed3d5f3b3f34bdb
msgid ""
"``prefixes`` (string) (optional) Ontology prefix to filter terms by. Use "
"'NCIT' for NCI Thesaurus cancer types (default), 'EDAM' for operation "
"types, 'HP' for HPO phenotypes."
msgstr ""

#: ../../tools/progenetix_tools.rst:117 741f1a8d513442ca9696ca6d8e8bc1a4
msgid ""
"``limit`` (integer) (optional) Maximum number of terms to return "
"(default: 25)."
msgstr ""

#: ../../tools/progenetix_tools.rst:133 489facd0136e4392a617f75a87463245
msgid "**Progenetix_search_biosamples** (Type: ProgenetixTool)"
msgstr ""

#: ../../tools/progenetix_tools.rst:135 2faf8ed581064bba8d406ed753b22404
msgid ""
"Search cancer tumor biosamples in the Progenetix database by NCIt disease"
" ontology code. Progenet..."
msgstr ""

#: ../../tools/progenetix_tools.rst c6cd19d0df084b9cba3c11c9b0cd68c0
msgid "Progenetix_search_biosamples tool specification"
msgstr ""

#: ../../tools/progenetix_tools.rst:141 7c1afa4ccbc141609a54634014de77e8
msgid "**Name**: ``Progenetix_search_biosamples``"
msgstr ""

#: ../../tools/progenetix_tools.rst:143 98ccf73463494d63ba89de12d0eefa6e
msgid ""
"**Description**: Search cancer tumor biosamples in the Progenetix "
"database by NCIt disease ontology code. Progenetix contains genome-wide "
"copy number variation (CNV) profiles from over 100,000 tumor samples. "
"Returns biosample IDs, histological diagnosis, pathological stage, and "
"external references. Uses the GA4GH Beacon v2 protocol. Example: "
"NCIT:C3058 returns 28 glioblastoma biosamples with histological "
"classification and study references."
msgstr ""

#: ../../tools/progenetix_tools.rst:147 d7ad4ce29cbb444ba139287d4c8cf87a
msgid ""
"``filters`` (string) (required) NCIt ontology code to filter biosamples "
"by cancer type. Examples: 'NCIT:C3058' (Glioblastoma), 'NCIT:C4017' "
"(Breast Carcinoma), 'NCIT:C9145' (Acute Myeloid Leukemia), 'NCIT:C3224' "
"(Melanoma), 'NCIT:C4872' (Lung Adenocarcinoma), 'NCIT:C3167' "
"(Neuroblastoma)."
msgstr ""

#: ../../tools/progenetix_tools.rst:153 0615b6b807224fbbb70838fd66a85fc5
msgid ""
"``skip`` (integer) (optional) Number of results to skip for pagination "
"(default: 0)."
msgstr ""

#: ../../tools/progenetix_tools.rst:170 e8994d6703df47a389fec32db5b30b32
msgid "**Progenetix_search_individuals** (Type: ProgenetixTool)"
