#: ../../tools/progenetix_tools.rst:32 53c9550aa82741858465bfe6d87f3a77
msgid ""
"**Description**: Search for cancer biosamples with copy number variations"
" (CNVs) in a specific genomic region. Combines disease filter with "
"genomic coordinates to find samples with amplifications or deletions in "
"genes of interest. Uses RefSeq chromosome accessions for coordinates. "
"Example: searching for EGFR amplifications "
"(refseq:NC\\_000007.14:55019017-55211628, DUP) in breast cancer "
"(NCIT:C4017) returns 9 matching biosamples."
msgstr ""

#: ../../tools/progenetix_tools.rst:34 ../../tools/progenetix_tools.rst:82
#: ../../tools/progenetix_tools.rst:112 ../../tools/progenetix_tools.rst:145
#: ../../tools/progenetix_tools.rst:182 2f5ae0f334c24cd395f95639a5521d82
#: 3621305601e140089311b337123df88d 66d56e63be8e49be88535d36aae63800
#: 83cde020f32341a1b2258d78ebb7ced8 e83a57b15ecd49d291a93b33b4a0b267
msgid "**Parameters:**"
msgstr ""

#: ../../tools/progenetix_tools.rst:36 5e7ac447fd16419f93e6a3e638bd974f
msgid ""
"``reference_name`` (string) (required) RefSeq chromosome accession. "
"Examples: 'refseq:NC\\_000007.14' (chr7/GRCh38), 'refseq:NC\\_000017.11' "
"(chr17/GRCh38), 'refseq:NC\\_000001.11' (chr1/GRCh38)."
msgstr ""

#: ../../tools/progenetix_tools.rst:39 bf40581b969247c98997a9a43f73f4d2
msgid ""
"``start`` (integer) (required) Start position (1-based, GRCh38). Example:"
" 55019017 for EGFR start."
msgstr ""

#: ../../tools/progenetix_tools.rst:42 6f046daf30094ba2bd0f67fa25896ef2
msgid ""
"``end`` (integer) (required) End position (1-based, GRCh38). Example: "
"55211628 for EGFR end."
msgstr ""

#: ../../tools/progenetix_tools.rst:45 5dbde854fefd4200857956096c56510d
msgid ""
"``variant_type`` (string) (optional) CNV type: 'DUP' for "
"amplification/duplication, 'DEL' for deletion. Leave empty for any CNV "
"type."
msgstr ""

#: ../../tools/progenetix_tools.rst:48 4ca460dd577f4bbe8e98d9ba08d6faf9
msgid ""
"``filters`` (string) (optional) Optional NCIt ontology code to filter by "
"cancer type. Example: 'NCIT:C4017' for breast cancer."
msgstr ""

