#: ../../tools/artic_tools.rst:32 64b5e4a730564de19593d83342216e1e
msgid ""
"**Description**: Get detailed information about a specific artwork from "
"the Art Institute of Chicago collection by its numeric ID. Returns full "
"metadata including title, artist, date, medium, dimensions, provenance, "
"exhibition history, and IIIF image URL. No authentication required. Use "
"ArtIC\\_search\\_artworks to find artwork IDs."
msgstr ""

#: ../../tools/artic_tools.rst:34 ../../tools/artic_tools.rst:65
#: 648d3a51a5364bb889fc0736d3c78589 a663c121ba64456197dcb5c028751159
msgid "**Parameters:**"
msgstr ""

#: ../../tools/artic_tools.rst:36 bcb0992868d74494868bed371439edd7
msgid ""
"``id`` (integer) (required) Artwork ID from Art Institute of Chicago. "
"Examples: 27992 (A Sunday on La Grande Jatte), 16568 (The Bedroom by Van "
"Gogh), 20684 (American Gothic)"
msgstr ""

#: ../../tools/artic_tools.rst:39 ../../tools/artic_tools.rst:76
