#: ../../tools/artic_tools.rst:53 3d67aead16924ba2b1de818e22af80b7
msgid "**ArtIC_search_artworks** (Type: BaseRESTTool)"
msgstr ""

#: ../../tools/artic_tools.rst:55 f01812606c3c445ca69bd7ce98996617
msgid ""
"Search the Art Institute of Chicago's collection of over 100,000 artworks"
" using its public API. R..."
msgstr ""

#: ../../tools/artic_tools.rst 52e980c0fff0437587660d54a09dc9e7
msgid "ArtIC_search_artworks tool specification"
msgstr ""

#: ../../tools/artic_tools.rst:61 134d1431266f4848b480d02622a25d86
msgid "**Name**: ``ArtIC_search_artworks``"
msgstr ""

#: ../../tools/artic_tools.rst:63 e606681265ba4db9822c0a1391b79920
msgid ""
"**Description**: Search the Art Institute of Chicago's collection of over"
" 100,000 artworks using its public API. Returns artwork titles, artists, "
"dates, mediums, and collection links. No authentication required. The "
"collection includes Impressionist paintings (Seurat, Monet, Picasso), "
"ancient art, photography, prints, and decorative arts. Useful for art "
"research, museum data analysis, and cultural heritage studies."
msgstr ""

#: ../../tools/artic_tools.rst:67 bb2e783df17c4c0daf1ebdc7c7571c61
msgid ""
"``q`` (string) (required) Search query. Examples: 'monet water lilies', "
"'picasso cubism', 'ancient egypt', 'japanese woodblock', 'american "
"landscape'"
msgstr ""

#: ../../tools/artic_tools.rst:70 b3c5845f39d84daf897bd79cebd22c61
msgid ""
"``limit`` (integer, null) (optional) Number of results (1-100). Default: "
"10"
msgstr ""

#: ../../tools/artic_tools.rst:73 1d7042fbdc1a4919bc23531dedab00ee
msgid ""
"``fields`` (string, null) (optional) Comma-separated fields to return. "
"Default: 'id,title,artist\\_display,date\\_display,medium\\_display'. "
"Other options: image\\_id, dimensions, artwork\\_type\\_title, "
"style\\_title, classification\\_title"
msgstr ""

