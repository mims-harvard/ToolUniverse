msgid "**Name**: ``EnsemblVEP_variant_recoder``"
msgstr ""

#: ../../tools/ensembl_vep_tools.rst:105 19a1894407cf4051a5c30afc0ef3ea7b
msgid ""
"**Description**: Convert genetic variant identifiers between different "
"nomenclature formats using the Ensembl Variant Recoder. Given a variant "
"ID (e.g., rs number), returns equivalent representations in HGVS genomic "
"(hgvsg), HGVS coding (hgvsc), HGVS protein (hgvsp), and SPDI format. "
"Essential for cross-referencing variants across databases that use "
"different notation systems. Example: 'rs429358' returns HGVS coding "
"notation for all APOE transcripts."
msgstr ""

#: ../../tools/ensembl_vep_tools.rst:109 e93f872f5de945f891f8aa5d5ea17de4
msgid ""
"``variant_id`` (string) (required) Variant identifier to recode. Accepts:"
" rsID (e.g., 'rs429358'), HGVS notation (e.g., 'AGT:c.803T>C'), SPDI "
"(e.g., 'NC\\_000019.10:44908683:T:C')."
msgstr ""

