#: ../../tools/opencravat_tools.rst:32 29a33619559948469b648408378f28ff
msgid ""
"**Description**: Annotate a single genomic variant using OpenCRAVAT with "
"182+ annotation sources including ClinVar, gnomAD, SIFT, PolyPhen-2, "
"REVEL, AlphaMissense, SpliceAI, GERP, PhastCons, DANN, FATHMM, and more. "
"Returns gene name, amino acid change, consequence type, and all requested"
" annotator results. Input: chromosome, position (1-based, GRCh38), "
"reference and alternate alleles. Optionally specify which annotators to "
"use (comma-separated)."
msgstr ""

#: ../../tools/opencravat_tools.rst:34 ../../tools/opencravat_tools.rst:88
#: 1c0a9a30eb704f2c83b76e13055df219 5f0906a92be6464db12d01f97b684d1d
msgid "**Parameters:**"
msgstr ""

#: ../../tools/opencravat_tools.rst:36 cdcfa02aaf8d4491a873cb99cbf58fce
msgid ""
"``chrom`` (string, null) (optional) Chromosome (e.g., 'chr17', 'chr7', "
"'17'). 'chr' prefix added automatically if missing."
msgstr ""

#: ../../tools/opencravat_tools.rst:39 4b0ed4b34b8a476180e4a89bb2aa3d37
msgid ""
"``chromosome`` (string, null) (optional) Alias for chrom. Chromosome "
"(e.g., 'chr17', 'chr7', '17')."
msgstr ""

#: ../../tools/opencravat_tools.rst:42 9b41f0b4cde74f4fa4763fc69674cb91
msgid ""
"``pos`` (integer, null) (optional) Genomic position (1-based, GRCh38 "
"coordinates)"
msgstr ""

#: ../../tools/opencravat_tools.rst:45 2555c0fadae84831a07305c92e959864
msgid ""
"``position`` (integer, null) (optional) Alias for pos. Genomic position "
"(1-based, GRCh38 coordinates)."
msgstr ""

#: ../../tools/opencravat_tools.rst:48 dfd1feb90deb43e6a7ff12d31cba4216
msgid ""
"``ref_base`` (string, null) (optional) Reference allele (e.g., 'C', 'A', "
"'G', 'T')"
msgstr ""

#: ../../tools/opencravat_tools.rst:51 ef424c2e9a9649c5a00c34f4aff25bd0
msgid "``ref`` (string, null) (optional) Alias for ref\\_base. Reference allele."
msgstr ""

#: ../../tools/opencravat_tools.rst:54 5ee8d160b9d147569dde8ac3658fb82e
msgid ""
"``alt_base`` (string, null) (optional) Alternate allele (e.g., 'T', 'A', "
"'G', 'C')"
msgstr ""

#: ../../tools/opencravat_tools.rst:57 e674c6a48ebc40f0a1dccbf9dca599ae
msgid "``alt`` (string, null) (optional) Alias for alt\\_base. Alternate allele."
msgstr ""

#: ../../tools/opencravat_tools.rst:60 13fc444fb8ef47f495293fd2d7331160
msgid ""
"``annotators`` (string, null) (optional) Comma-separated annotator names "
"(e.g., 'clinvar,gnomad3,sift,polyphen2,revel,alphamissense'). If omitted,"
" returns only basic variant annotation (gene, consequence). Common "
"annotators: clinvar, gnomad3, sift, polyphen2, cadd\\_exome, revel, "
"alphamissense, spliceai, dann, fathmm, gerp, phastcons, dbsnp, "
"mutation\\_assessor, provean, vest, primateai, lrt."
msgstr ""

