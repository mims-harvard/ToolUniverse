msgstr ""

#: ../../tools/mondo_tools.rst:36 fad3f2c922be48ac833bc87a3db46eb1
msgid ""
"``disease_id`` (string) (required) Mondo disease identifier. Examples: "
"'MONDO:0004975' (Alzheimer disease), 'MONDO:0005148' (type 2 diabetes "
"mellitus), 'MONDO:0007254' (breast cancer), 'MONDO:0018076' (Huntington "
"disease), 'MONDO:0009061' (cystic fibrosis)."
msgstr ""

