#: ../../tools/datacite_tools.rst:63 23b585a35dce4b56860fe113026ff7c1
msgid ""
"**Description**: Get metadata for a research dataset or publication by "
"DOI from DataCite. DataCite is the primary registry for research data "
"DOIs, covering datasets, software, samples, and other research outputs "
"deposited in repositories like Zenodo, Dryad, Figshare, and thousands of "
"institutional repositories. Returns title, creators, affiliations, "
"publication year, resource type, subjects, funding information, and "
"related identifiers. Essential for finding research data linked to "
"publications, understanding data provenance, and discovering datasets in "
"a field."
msgstr ""

#: ../../tools/datacite_tools.rst:67 0abf9e2da3b9463eaba446b761c7cdbf
msgid ""
"``doi`` (string) (required) DOI of the research output (e.g., "
"'10.5281/zenodo.4088438', '10.5061/dryad.234', "
"'10.6084/m9.figshare.1000050'). Include full DOI without URL prefix."
msgstr ""

#: ../../tools/datacite_tools.rst:84 aa4e9741075f41a7a739c79107d12b77
msgid "**DataCite_search_datasets** (Type: DataCiteRESTTool)"
msgstr ""

#: ../../tools/datacite_tools.rst:86 f5bb1943e85e4b43ba9c7268bb13d986
msgid ""
"Search for research datasets with DOIs across all repositories worldwide "
"(Zenodo, Figshare, Dryad..."
msgstr ""

#: ../../tools/datacite_tools.rst ae5052e22eed4fe2b6c0bb821cbbaba2
msgid "DataCite_search_datasets tool specification"
msgstr ""

#: ../../tools/datacite_tools.rst:92 dfcdca562b284006a25b362bf83c4781
msgid "**Name**: ``DataCite_search_datasets``"
msgstr ""

#: ../../tools/datacite_tools.rst:94 051d76e14b5e426087b9b2d438dfcba3
msgid ""
"**Description**: Search for research datasets with DOIs across all "
"repositories worldwide (Zenodo, Figshare, Dryad, ICPSR, institutional "
"repositories, and more). This is a dataset-focused search that "
"automatically filters for resource type 'Dataset'. Returns DOI, title, "
"description, creators, publisher, publication year, URL, and subjects. "
"Covers millions of datasets registered via DataCite across thousands of "
"repositories. Use this to find specific research datasets by topic, or to"
" discover available data for a research question."
msgstr ""

#: ../../tools/datacite_tools.rst:98 513791519089497fa4fbe789eeb42d7b
msgid ""
"``query`` (string) (required) Search query for datasets (e.g., 'iron "
"intake physical function older adults', 'COVID-19 genomic surveillance', "
"'soil microbiome diversity'). Searches across titles, descriptions, "
"subjects, and creator names."
msgstr ""

#: ../../tools/datacite_tools.rst:101 05cd2eb17aec4015a4657a0829b78eb0
msgid ""
"``resource_type`` (string, null) (optional) Override resource type "
"filter. Defaults to 'Dataset'. Other options: 'Software', 'Text', "
"'Image', 'Collection', 'Workflow', 'Model'."
msgstr ""

#: ../../tools/datacite_tools.rst:104 da6f9f00d84a4051a29fcbdd69a1a432
msgid ""
"``publisher`` (string, null) (optional) Filter by publisher/repository "
"name (e.g., 'Zenodo', 'Dryad', 'figshare'). Note: uses free-text "
"matching."
msgstr ""

#: ../../tools/datacite_tools.rst:107 c26eca8104324f74b46a851d7a406a7a
msgid ""
"``year`` (integer, null) (optional) Filter by publication year (e.g., "
"2024, 2023). Returns datasets published in that year only."
msgstr ""

#: ../../tools/datacite_tools.rst:110 ../../tools/datacite_tools.rst:150
#: a5be2177b8e44626b5ba643f01276ad5 ec472ecd72774528accb1497d3d21a91
msgid ""
"``page_size`` (integer, null) (optional) Number of results per page "
"(default 10, max 100)"
msgstr ""

