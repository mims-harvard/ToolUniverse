msgstr ""

#: ../../tools/monarch_v3_tools.rst:195 b7f45f9e4a904a2db708595d08b8db54
msgid ""
"Search the Monarch Initiative knowledge graph for biomedical entities by "
"name or keyword. Returns..."
msgstr ""

#: ../../tools/monarch_v3_tools.rst 8d9f5c8f8b9d48e08a7813c1c0c28604
msgid "MonarchV3_search tool specification"
msgstr ""

#: ../../tools/monarch_v3_tools.rst:201 3630ac1ba4a94b1082916c59ab909826
msgid "**Name**: ``MonarchV3_search``"
msgstr ""

#: ../../tools/monarch_v3_tools.rst:203 74fecbb2d2764e8c8acb475da112f15a
msgid ""
"**Description**: Search the Monarch Initiative knowledge graph for "
"biomedical entities by name or keyword. Returns genes, diseases, "
"phenotypes, and other entities matching the query, with their CURIE "
"identifiers and categories. Useful for finding entity IDs to use with "
"MonarchV3\\_get\\_entity and MonarchV3\\_get\\_associations. Example: "
"searching 'BRCA1' returns HGNC:1100 (gene), 'Alzheimer' returns MONDO "
"disease entries."
msgstr ""

#: ../../tools/monarch_v3_tools.rst:207 446ccb9a6f4f43048ac41d932a081c25
msgid ""
"``query`` (string) (optional) Search query. Can be gene names, disease "
"names, phenotype terms, etc. Examples: 'BRCA1', 'breast cancer', "
"'seizure', 'insulin resistance'."
msgstr ""

#: ../../tools/monarch_v3_tools.rst:210 9d73bf422e1a421085af36baa7422b19
msgid ""
"``limit`` (integer) (optional) Maximum results to return (default: 10, "
"max: 50)."
msgstr ""

#: ../../tools/monarch_v3_tools.rst:213 5497c7300305436e9cd3ca4e5c53a588
msgid ""
"``category`` (string) (optional) Filter by entity category. Options: "
"'biolink:Gene', 'biolink:Disease', 'biolink:PhenotypicFeature', "
"'biolink:NamedThing'. Default: all categories."
msgstr ""

#: ../../tools/monarch_v3_tools.rst:216 48e8b4081a3a444ebd3db301dcfc72a1
msgid "``q`` (string) (optional) Alias for query parameter."
msgstr ""

