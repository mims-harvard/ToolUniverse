msgid "**Parameters:**"
msgstr ""

#: ../../tools/reactome_interactors_tools.rst:36
#: 9fb1af15b5194fc181dd631d42cc4135
msgid ""
"``entity_id`` (string) (required) Reactome stable identifier for the "
"entity. Use ReactomeInteractors\\_search\\_entity to find IDs. Examples: "
"'R-HSA-199420' (PTEN), 'R-HSA-69541' (TP53 tetramer), 'R-HSA-8869337' "
"(TP53)."
msgstr ""

#: ../../tools/reactome_interactors_tools.rst:39
#: d0319e65bef44597868def7824116d67
msgid ""
"``species`` (integer, null) (optional) NCBI taxonomy ID for species "
"filter (default: 9606 for human). Examples: 9606 (human), 10090 (mouse)."
msgstr ""

