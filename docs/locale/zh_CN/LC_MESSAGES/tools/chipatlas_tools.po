msgstr ""

#: ../../tools/chipatlas_tools.rst:51 6ad663bef51646f0a96c4e64383dee55
msgid ""
"``antigen_class`` (string) (optional) Filter by antigen class (e.g., 'TFs"
" and others', 'Histone', 'RNA polymerase')"
msgstr ""

#: ../../tools/chipatlas_tools.rst:54 c4332e36a49f41b58e0908ae6deaa5dd
msgid ""
"``cell_type_class`` (string) (optional) Filter by cell type class (e.g., "
"'Blood', 'Liver', 'Brain')"
msgstr ""

#: ../../tools/chipatlas_tools.rst:57 c7b655b522a046b78b09f93d1940e072
msgid ""
"``threshold`` (string) (optional) Peak calling stringency (MACS2 "
"Q-value). Options: '05'=1e-5 (permissive, more peaks, broader features), "
"'10'=1e-10 (moderate, balanced), '20'=1e-20 (strict, high confidence "
"only, narrow peaks). Default '05' suitable for most analyses. Higher "
"values = fewer but more confident peaks."
msgstr ""

#: ../../tools/chipatlas_tools.rst:60 311836949a274d369b72713176338fc7
msgid ""
"``distance`` (string) (optional) Distance from Transcription Start Site "
"(TSS) in base pairs for gene-TF association. Defines promoter region. "
"Default 5000 (±5kb, captures typical promoters). Use 1000-2000 for narrow"
" promoters, 10000+ for enhancer regions."
msgstr ""

