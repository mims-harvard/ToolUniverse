#: ../../tools/biogrid_tools.rst:36 2902999be597438ba9b342d9e227536f
msgid ""
"``gene_names`` (array) (optional) List of gene names to query for "
"chemical interactions (e.g., ['TP53', 'EGFR', 'AKT1']). Leave empty to "
"search by chemical only."
msgstr ""

#: ../../tools/biogrid_tools.rst:39 34824fa988be49c9929e2119fdbffe42
msgid ""
"``chemical_names`` (array) (optional) List of chemical compound names "
"(e.g., ['Aspirin', 'Metformin', 'Imatinib']). Leave empty to search by "
"gene only."
msgstr ""

#: ../../tools/biogrid_tools.rst:42 ../../tools/biogrid_tools.rst:132
#: 9b56bd89da854b8887bc2ceb60e8d7d7 a42c4cd2f4af4c03b3629d34e94b5a7f
