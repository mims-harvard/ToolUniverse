#: ../../tools/protparam_tools.rst:32 ecdc4d4356f843b0af4fa85d083d8049
msgid ""
"**Description**: Calculate physicochemical properties of a protein from "
"its amino acid sequence (similar to ExPASy ProtParam). Returns molecular "
"weight, isoelectric point (pI), amino acid composition, extinction "
"coefficients at 280 nm, instability index, aliphatic index, and GRAVY "
"(grand average of hydropathicity). No external API needed."
msgstr ""

#: ../../tools/protparam_tools.rst:34 801f6d56cafe4a429e657eafd4a85804
msgid "**Parameters:**"
msgstr ""

#: ../../tools/protparam_tools.rst:36 0af33617766c43c0a5701c1df2271885
msgid ""
"``sequence`` (string) (required) Protein amino acid sequence in single-"
"letter code. Example: 'MEEPQSDPSVEPPLSQETFSDLWKLLPENNVLSPLPS' (partial "
"TP53). Whitespace, numbers, and FASTA headers are stripped."
msgstr ""

