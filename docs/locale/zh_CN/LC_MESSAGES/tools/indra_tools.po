#: ../../tools/indra_tools.rst:104 a9b31f31ad5143e0ab6ad49d833c7c96
msgid "**Name**: ``INDRA_get_statements``"
msgstr ""

#: ../../tools/indra_tools.rst:106 5654bca9f1f44b28b8e6b93a931e4bb0
msgid ""
"**Description**: Get literature-mined biological statements for a gene, "
"protein, or chemical from INDRA DB. Returns mechanistic relationships "
"(Activation, Inhibition, Phosphorylation, Complex, etc.) with supporting "
"evidence from PubMed articles. INDRA aggregates knowledge from 30+ NLP "
"readers across millions of publications. Use 'agent' for the entity name "
"(e.g., 'TP53', 'EGFR', 'gefitinib'). Optionally filter by statement "
"'type' (Activation, Inhibition, Phosphorylation, etc.) or specify "
"'agent2' for pairwise interactions."
msgstr ""

#: ../../tools/indra_tools.rst:110 6cc6f6ecadb94ad7a72a1aaac33f2bf9
msgid "``operation`` (string) (optional) Operation type (fixed: get\\_statements)"
msgstr ""

#: ../../tools/indra_tools.rst:113 4f6bbe82b302472c877c432445be4568
msgid ""
"``agent`` (string) (required) Gene symbol, protein name, or chemical name"
" (e.g., 'TP53', 'EGFR', 'gefitinib', 'BRAF')"
msgstr ""

#: ../../tools/indra_tools.rst:116 87d3e6d4be524e72841aaadc2d6ca218
msgid ""
"``type`` (string) (optional) Filter by statement type: Activation, "
"Inhibition, Phosphorylation, Dephosphorylation, Ubiquitination, Complex, "
"IncreaseAmount, DecreaseAmount, Translocation, Autophosphorylation"
msgstr ""

#: ../../tools/indra_tools.rst:119 8edeeb177cbf46ecaa172b695b0ab95f
msgid ""
"``agent2`` (string) (optional) Second agent for pairwise queries (e.g., "
"agent='BRAF' agent2='MAP2K1')"
msgstr ""

#: ../../tools/indra_tools.rst:122 eb8bd31c07cd4d5fb8d58cb9be932186
msgid "``limit`` (integer) (optional) Maximum statements to return (default: 10)"
msgstr ""

#: ../../tools/indra_tools.rst:125 c77f369b60e7407bb77f5683600d101a
msgid ""
"``ev_limit`` (integer) (optional) Maximum evidence items per statement "
"(default: 2)"
