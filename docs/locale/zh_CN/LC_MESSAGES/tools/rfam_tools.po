#: ../../tools/rfam_tools.rst:217 3766746aad514087b8607fff21e9d511
msgid "**Name**: ``Rfam_get_structure_mapping``"
msgstr ""

#: ../../tools/rfam_tools.rst:219 8ecd275453464fbea240fa263c8e34a5
msgid ""
"**Description**: Get mapping between Rfam family and 3D structures (PDB)."
" Returns correspondence between RNA family, EMBL sequence regions, and "
"PDB residues. Shows which structures are available for the family. Tab-"
"delimited format includes PDB IDs, chains, residue ranges, and "
"alignments. Use for: structure-function analysis, 3D visualization, "
"structural annotation, integrating sequence and structure data. Links "
"Rfam families to experimental structures."
msgstr ""

