msgstr ""

#: ../../tools/eol_tools.rst:64 8457b000e4b34b08ad8ecb595ada9fe0
msgid ""
"Get taxonomy hierarchy (classification tree) for a species from a "
"specific classification system ..."
msgstr ""

#: ../../tools/eol_tools.rst 5c14b447502e4e348e18fbce361771c2
msgid "EOL_get_hierarchy_entry tool specification"
msgstr ""

#: ../../tools/eol_tools.rst:70 5f101ac2238d43e99dfb6e921988b3dd
msgid "**Name**: ``EOL_get_hierarchy_entry``"
msgstr ""

#: ../../tools/eol_tools.rst:72 1aea91df2c6d4ce2af01e3fec014e1ab
msgid ""
"**Description**: Get taxonomy hierarchy (classification tree) for a "
"species from a specific classification system in the Encyclopedia of "
"Life. Returns ancestors (full lineage from root to species), children "
"taxa, synonyms, and source classification (NCBI, GBIF, ITIS, Catalogue of"
" Life). Use EOL\\_get\\_page first to find hierarchy\\_entry\\_id values "
"from the classifications list. Example: 70872770 is the NCBI hierarchy "
"entry for Homo sapiens, showing the complete lineage from root through "
"Primates to species level."
msgstr ""

#: ../../tools/eol_tools.rst:76 9539215d5692405e8cd826a4e06c0105
msgid ""
"``hierarchy_entry_id`` (integer) (required) EOL hierarchy entry ID from a"
" specific classification system. Get this from EOL\\_get\\_page "
"'classifications' field. Examples: 70872770 (Homo sapiens in NCBI), "
"86685972 (Homo sapiens in GBIF), 147191154 (Homo sapiens in ITIS)."
msgstr ""

#: ../../tools/eol_tools.rst:93 49dd9bf6ee3d4d75ac0248e95977caab
msgid "**EOL_get_page** (Type: EOLTool)"
msgstr ""

#: ../../tools/eol_tools.rst:95 fe1b87c561aa4eb08f0c45380113de2b
msgid ""
"Get detailed species/taxon information from an Encyclopedia of Life (EOL)"
" page. Returns scientifi..."
msgstr ""

#: ../../tools/eol_tools.rst 7ca902ade4574db5bc92a01de0b69d58
msgid "EOL_get_page tool specification"
msgstr ""

#: ../../tools/eol_tools.rst:101 637f8b2317344bdab61912c8b409a323
msgid "**Name**: ``EOL_get_page``"
msgstr ""

#: ../../tools/eol_tools.rst:103 6dba18c5356e474ba505e46311cea0ba
msgid ""
"**Description**: Get detailed species/taxon information from an "
"Encyclopedia of Life (EOL) page. Returns scientific name, common names in"
" multiple languages, synonyms, images with URLs, text descriptions, and "
"available taxonomy classifications from multiple sources (NCBI, GBIF, "
"ITIS, Catalogue of Life). Use EOL\\_search\\_species first to get "
"page\\_id. Example: page\\_id 327955 for Homo sapiens, 583954 for "
"Arabidopsis thaliana, 328672 for Panthera leo."
msgstr ""

#: ../../tools/eol_tools.rst:107 398dea34e40b4f0bb5b1ac87126fd0d3
msgid ""
"``page_id`` (integer) (required) EOL page identifier. Get this from "
"EOL\\_search\\_species. Examples: 327955 (Homo sapiens), 583954 "
"(Arabidopsis thaliana), 328672 (Panthera leo), 1045608 (Apis mellifera)."
msgstr ""

#: ../../tools/eol_tools.rst:110 7ab07dbc8a7b4a92bdff5daf845b38e3
msgid ""
"``images_per_page`` (integer) (optional) Number of image data objects to "
"return (0-75)."
msgstr ""

#: ../../tools/eol_tools.rst:113 eff4a9e022f34f99b69a2cae286d513f
msgid ""
"``texts_per_page`` (integer) (optional) Number of text description "
"objects to return (0-75)."
msgstr ""

#: ../../tools/eol_tools.rst:116 ce4bce9b51f3448b94b0f48d666d45a3
msgid ""
"``common_names`` (boolean) (optional) Include vernacular/common names in "
"multiple languages."
msgstr ""

#: ../../tools/eol_tools.rst:119 5c74fd3665db45cc8de03591bbeebc5c
msgid "``synonyms`` (boolean) (optional) Include taxonomic synonyms."
msgstr ""

#: ../../tools/eol_tools.rst:122 7e8ca993509c477c83a0b255399eddd3
msgid ""
"``details`` (boolean) (optional) Include detailed data object information"
" (media, descriptions)."
msgstr ""

#: ../../tools/eol_tools.rst:139 a1f52ea6f088429fbedc08281ca96bbb
msgid "**EOL_search_species** (Type: EOLTool)"
msgstr ""

#: ../../tools/eol_tools.rst:141 17b2fe6ee04a40c5b50b8980ce9868b5
msgid ""
"Search the Encyclopedia of Life (EOL) for species and taxa by name. "
"Returns matching EOL page IDs..."
msgstr ""

#: ../../tools/eol_tools.rst e3f375c78eb84ebc92549f7dbc516277
msgid "EOL_search_species tool specification"
msgstr ""

#: ../../tools/eol_tools.rst:147 001e92d3719b48cc80512f811f34af60
msgid "**Name**: ``EOL_search_species``"
msgstr ""

#: ../../tools/eol_tools.rst:149 c7be2eaa52544775a778928f281dc658
msgid ""
"**Description**: Search the Encyclopedia of Life (EOL) for species and "
"taxa by name. Returns matching EOL page IDs, scientific names, and name "
"variants. Use this to find EOL page IDs for detailed lookups with "
"EOL\\_get\\_page. Supports exact matching. EOL aggregates data from "
"hundreds of biodiversity databases. Example: searching 'Homo sapiens' "
"returns page ID 327955."
msgstr ""

#: ../../tools/eol_tools.rst:153 bf2ef2b702574064bc87c73fbb55879c
msgid ""
"``query`` (string) (required) Search string for species or taxon name. "
"Supports scientific names, common names, and partial matches. Examples: "
"'Homo sapiens', 'Arabidopsis thaliana', 'Panthera leo', 'honey bee'."
msgstr ""

#: ../../tools/eol_tools.rst:156 627e44aaca42403c9261ebf3741d81dd
msgid "``page`` (integer) (optional) Page number for paginated results (1-based)."
msgstr ""

#: ../../tools/eol_tools.rst:159 aaafeb22b9474d7c88c79a5a7dbd0efe
msgid "``exact`` (boolean) (optional) If true, only return exact name matches."
msgstr ""

