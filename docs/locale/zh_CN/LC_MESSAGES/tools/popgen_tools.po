msgstr ""

#: ../../tools/popgen_tools.rst:112 74eea7420e5b442e9fe6b7f5a5671720
msgid ""
"Test Hardy-Weinberg equilibrium for a biallelic locus given observed "
"genotype counts (AA, Aa, aa)..."
msgstr ""

