#: ../../tools/popgen_tools.rst:77 dfc87e699daf425d9e1a5954532b9ad2
msgid "**Name**: ``PopGen_haplotype_count``"
msgstr ""

#: ../../tools/popgen_tools.rst:79 2426d9c45bc54916b562ad5b3284324b
msgid ""
"**Description**: Estimate distinct haplotypes after recombination across "
"generations for a region with multiple biallelic SNPs. Reports maximum "
"theoretical haplotypes (2^n), expected crossovers per gamete, probability"
" of at least one recombination event, and estimated haplotype diversity "
"based on LD decay. Useful for understanding recombination impact on "
"genetic variation."
msgstr ""

#: ../../tools/popgen_tools.rst:86 b3f2217d8d9a45afb1b02d035cede6d4
msgid "``n_snps`` (integer) (required) Number of biallelic SNP loci in the region"
msgstr ""

#: ../../tools/popgen_tools.rst:89 e6e6ab79c0b244a7a1c045dc8dafc35a
msgid ""
"``generations`` (integer) (optional) Number of generations of random "
"mating (default 1)"
msgstr ""

#: ../../tools/popgen_tools.rst:92 29202ae9bde34680afe48cf681831766
msgid ""
"``recomb_rate`` (number) (optional) Per-adjacent-interval recombination "
"rate [0, 1] per generation (default 0.5)"
msgstr ""

#: ../../tools/popgen_tools.rst:110 9d4dcec6f0da4a76be42014cf5f147e3
