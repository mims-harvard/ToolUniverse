msgid "**Name**: ``PopGen_inbreeding``"
msgstr ""

#: ../../tools/popgen_tools.rst:163 811b2841a1e24cbeae33c53b471c224a
#, python-brace-format
msgid ""
"**Description**: Compute inbreeding coefficient F for a known pedigree "
"type over one or more generations. Supports: self, full-sib, half-sib, "
"first-cousin, double-first-cousin, uncle-niece, aunt-nephew, half-first-"
"cousin, second-cousin. Uses the recurrence F\\_t = base\\_F + "
"(1-base\\_F)\\*F\\_{t-1} for iterated inbreeding. Reports F per "
"generation, cumulative F, and retained heterozygosity."
msgstr ""

#: ../../tools/popgen_tools.rst:170 97721d6ef286400c98a4bbbcdd4a4e11
msgid ""
"``pedigree`` (string) (required) Pedigree type (e.g., 'half-sib', 'first-"
"cousin', 'full-sib')"
msgstr ""

#: ../../tools/popgen_tools.rst:173 6e6ecdcdd27d46809544d1f49efbf023
msgid ""
