#: ../../tools/europepmc_citations_tools.rst:36
#: 5f2b99ecc87f417894c559b4790fd44e
msgid ""
"``pmid`` (string) (required) PubMed ID of the article to find citations "
"for. Examples: '25378148' (AlphaFold paper), '33234567', '29474920' "
"(CRISPR review). Find PMIDs using Europe PMC search."
msgstr ""

#: ../../tools/europepmc_citations_tools.rst:39
#: ../../tools/europepmc_citations_tools.rst:76
