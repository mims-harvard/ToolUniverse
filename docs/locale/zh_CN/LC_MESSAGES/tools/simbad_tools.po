msgid ""
"Query the SIMBAD astronomical database for information about celestial "
"objects. Supports queries ..."
msgstr ""

#: ../../tools/simbad_tools.rst 6d9f68f8c20f4bfc8369ee4a6dd1accd
msgid "SIMBAD_query_object tool specification"
