#: ../../tools/simbad_tools.rst:67 d8e4838cda6044149cdf353c841e2528
msgid "**Name**: ``SIMBAD_query_object``"
msgstr ""

#: ../../tools/simbad_tools.rst:68 54f6beee429d404bbae9caf69e215133
msgid "**Type**: ``SIMBADTool``"
msgstr ""

#: ../../tools/simbad_tools.rst:69 167a5984ee494f618d89e6521f896881
msgid ""
"**Description**: Query the SIMBAD astronomical database for information "
"about celestial objects. Supports queries by object name, coordinates, or"
" identifier. SIMBAD contains data on millions of astronomical objects "
"including stars, galaxies, and other celestial bodies."
msgstr ""

#: ../../tools/simbad_tools.rst:73 7486079e7f924328a502c1318d388ee9
msgid ""
"``query_type`` (string) (optional) Type of query to perform. Options: "
"'object\\_name' (search by name), 'coordinates' (search by position), "
"'identifier' (search by identifier pattern)"
msgstr ""

#: ../../tools/simbad_tools.rst:76 8af3b968a8904e039c96046805d6a7e8
msgid ""
"``object_name`` (string) (optional) Name of the astronomical object "
"(e.g., 'M31', 'Sirius', 'NGC 1068'). Required when "
"query\\_type='object\\_name'"
msgstr ""

#: ../../tools/simbad_tools.rst:79 db812587c3b944f9bc1ca8eee8938419
msgid ""
"``ra`` (number) (optional) Right Ascension in degrees (0-360). Required "
"when query\\_type='coordinates'"
msgstr ""

#: ../../tools/simbad_tools.rst:82 cef31c06d6014ab49bc7d49f68699fd7
msgid ""
"``dec`` (number) (optional) Declination in degrees (-90 to +90). Required"
" when query\\_type='coordinates'"
msgstr ""

#: ../../tools/simbad_tools.rst:85 6ff03bed79d44f7789a503864b7652e2
msgid ""
"``radius`` (number) (optional) Search radius in arcminutes for coordinate"
" queries. Default is 1.0 arcmin"
msgstr ""

#: ../../tools/simbad_tools.rst:88 6ca0e4b12fe84b4493d33333fa262122
msgid ""
"``identifier`` (string) (optional) Identifier pattern with wildcards "
"(e.g., 'HD \\*', 'NGC 10\\*'). Required when query\\_type='identifier'"
msgstr ""

#: ../../tools/simbad_tools.rst:91 dd4980e5278d4fb7b497839cbdfeb300
msgid ""
"``output_format`` (string) (optional) Level of detail in output. Options:"
" 'basic' (ID, coordinates, type), 'detailed' (includes spectral type and "
"flux), 'full' (all available data)"
msgstr ""

#: ../../tools/simbad_tools.rst:94 6e955193f7a94f15909bccb021bc10b0
msgid ""
"``max_results`` (integer) (optional) Maximum number of results to return "
"for coordinate or identifier queries"
msgstr ""

