msgstr ""

#: ../../tools/igsr_tools.rst:96 a09846c7150b4a68b7f7186d3855600b
msgid ""
"Search samples from the 1000 Genomes Project by population, data "
"collection, or sample name. Retu..."
msgstr ""

#: ../../tools/igsr_tools.rst e91ab45e18a24ed69aeffff8a92225e5
msgid "IGSR_search_samples tool specification"
msgstr ""

#: ../../tools/igsr_tools.rst:102 04d69711cb7b480294b8944a0f3f1c49
msgid "**Name**: ``IGSR_search_samples``"
msgstr ""

#: ../../tools/igsr_tools.rst:104 6738a9970e61488d8e93664c1b3e2e55
msgid ""
"**Description**: Search samples from the 1000 Genomes Project by "
"population, data collection, or sample name. Returns sample names (e.g., "
"HG00096, NA12878), sex, BioSample IDs, population assignments, and "
"available data collections. Use this to find samples from specific "
"populations for variant analysis, to identify samples with particular "
"sequencing data types (WGS, exome, RNA-seq), or to look up specific well-"
"characterized samples like NA12878 (reference genome sample)."
msgstr ""

#: ../../tools/igsr_tools.rst:108 01e335876dd944c994ec1cbb6ebabb82
msgid ""
"``operation`` (string) (optional) Operation type (fixed: "
"search\\_samples)."
msgstr ""

#: ../../tools/igsr_tools.rst:111 90a0db2003b24a999d034b9ab14a211b
msgid ""
"``population`` (string, null) (optional) Filter by population code (e.g.,"
" 'CHB', 'YRI', 'GBR', 'CEU'). Use IGSR\\_search\\_populations to find "
"valid codes."
msgstr ""

#: ../../tools/igsr_tools.rst:114 f09dcd9ec7f4437c900d19882fd02666
msgid ""
"``data_collection`` (string, null) (optional) Filter by data collection "
"title (e.g., '1000 Genomes 30x on GRCh38', '1000 Genomes on GRCh38')."
msgstr ""

#: ../../tools/igsr_tools.rst:117 b46d09d1fc8e4eb5856017c877f62964
msgid ""
"``sample_name`` (string, null) (optional) Look up specific sample by name"
" (e.g., 'HG00096', 'NA12878')."
msgstr ""

