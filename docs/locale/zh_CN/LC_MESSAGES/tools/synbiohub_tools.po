msgstr ""

#: ../../tools/synbiohub_tools.rst:86 8354ae1c87b8468d8ec68d14fb17fc36
msgid ""
"Search the SynBioHub synthetic biology parts repository for genetic parts"
" and designs by keyword...."
msgstr ""

#: ../../tools/synbiohub_tools.rst 85580d370741410f95ea767dc46baa8d
msgid "SynBioHub_search_parts tool specification"
msgstr ""

#: ../../tools/synbiohub_tools.rst:92 e764de0b3895437ca4c4dbfc5f874cfa
msgid "**Name**: ``SynBioHub_search_parts``"
msgstr ""

#: ../../tools/synbiohub_tools.rst:94 452004150ed54af495338e8f8bbd7647
msgid ""
"**Description**: Search the SynBioHub synthetic biology parts repository "
"for genetic parts and designs by keyword. SynBioHub hosts the iGEM "
"Registry of Standard Biological Parts (20,000+ BioBricks) and other "
"public SBOL collections. Parts include promoters, coding sequences "
"(CDS/genes), terminators, ribosome binding sites (RBS), reporters (GFP, "
"RFP, LacZ), regulatory elements, and composite genetic devices. Returns "
"part IDs, names, descriptions, SBOL types, and functional roles. Example:"
" search 'GFP' finds green fluorescent protein parts; search 'lac "
"promoter' finds lac operon regulatory parts."
msgstr ""

#: ../../tools/synbiohub_tools.rst:98 256bff2cc778497790f1f9088cacb0c3
msgid ""
"``query`` (string) (required) Search query for finding genetic parts. Can"
" include gene names, part functions, BioBrick IDs, or biological "
"descriptions. Examples: 'GFP', 'lac promoter', 'BBa\\_E0040', "
"'terminator', 'riboswitch', 'CRISPR', 'T7 promoter'."
msgstr ""

#: ../../tools/synbiohub_tools.rst:101 eb0fa3463bb6432295fb08b062422457
msgid "``offset`` (integer, null) (optional) Offset for pagination (default: 0)."
msgstr ""

#: ../../tools/synbiohub_tools.rst:104 3bdcbc60b6f74da9807f3c84b937a737
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results to return "
"(default: 10, max: 50)."
msgstr ""

