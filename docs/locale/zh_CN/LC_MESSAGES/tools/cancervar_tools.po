#: ../../tools/cancervar_tools.rst:32 72a21ffe9c2d483a951e2dd73d9b9db8
msgid ""
"**Description**: Classify a somatic cancer variant using AMP/ASCO/CAP "
"2017 guidelines (CancerVar). Returns a Tier I–IV assignment: Tier I = "
"Strong Clinical Significance (FDA-approved therapy association), Tier II "
"= Potential Clinical Significance (investigational/preclinical evidence),"
" Tier III = Unknown Clinical Significance, Tier IV = Benign/Likely "
"Benign. Also returns 12 CBP evidence scores and an Oncogenicity "
"Pathogenicity Index (OPAI, 0–1). Input requires genomic coordinates in "
"hg19 or hg38. No API key needed. Example: BRAF V600E (chr7:140453136 A>T "
"hg19) is Tier I (strong) with OPAI=0.99."
msgstr ""

#: ../../tools/cancervar_tools.rst:34 027b4d7f35294b5e8cf4ba2c3e8fb571
msgid "**Parameters:**"
msgstr ""

#: ../../tools/cancervar_tools.rst:36 b876b9d5d582498986fa88b62aba3b44
msgid ""
"``chrom`` (string) (required) Chromosome number or name. Can include "
"'chr' prefix (e.g., '7', 'chr7', 'X')."
msgstr ""

#: ../../tools/cancervar_tools.rst:39 02d5077f13864d35a0674fb70617011a
msgid "``pos`` (integer) (required) Genomic position (1-based)."
msgstr ""

#: ../../tools/cancervar_tools.rst:42 fa1b2ef568ed4b5d9e447343bd6932bd
msgid "``ref`` (string) (required) Reference allele (e.g., 'A', 'G', 'ATCG')."
msgstr ""

#: ../../tools/cancervar_tools.rst:45 729567dc1507406281775f86a7f7cb31
msgid "``alt`` (string) (required) Alternate allele (e.g., 'T', 'C')."
msgstr ""

#: ../../tools/cancervar_tools.rst:48 372e72fc20a6431a87c3a46d3720956b
msgid "``build`` (string) (optional) Genome build. Default: hg19."
msgstr ""

