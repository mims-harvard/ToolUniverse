#: ../../tools/mirna_tools.rst:92 8d08841f10564cb7923f2549ecef93d2
msgid ""
"Get cross-references (xrefs) for a microRNA from RNAcentral. Returns "
"database links from miRBase,..."
msgstr ""

#: ../../tools/mirna_tools.rst 325739b9ccbb4f1190cc90a0d730240d
msgid "miRBase_get_mirna_xrefs tool specification"
