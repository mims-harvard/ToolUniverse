msgid "**Parameters:**"
msgstr ""

#: ../../tools/mirna_tools.rst:36 c09020783d9749c7b2ef0d0d169fc7bb
msgid ""
"``rnacentral_id`` (string) (required) RNAcentral URS identifier. Use "
"species-specific format 'URS\\_TAXID' (e.g., 'URS000039ED8D\\_9606') or "
"base URS ID (e.g., 'URS000039ED8D') with taxid parameter."
msgstr ""

#: ../../tools/mirna_tools.rst:39 ec42d07ffef449308b6c28cda11d33ea
msgid ""
"``taxid`` (integer) (optional) NCBI Taxonomy ID for species-specific "
"lookup (e.g., 9606 for human, 10090 for mouse). Optional if "
"rnacentral\\_id already includes taxid."
msgstr ""

