#: ../../tools/mirna_tools.rst:98 1e2f7d48c89b43b39ad36457e255ff33
msgid "**Name**: ``miRBase_get_mirna_xrefs``"
msgstr ""

#: ../../tools/mirna_tools.rst:100 badfd59fee604bfe9d423c76bd6a8edc
msgid ""
"**Description**: Get cross-references (xrefs) for a microRNA from "
"RNAcentral. Returns database links from miRBase, TarBase, ENA, RefSeq, "
"piRBase, LncBase, and other sources. Includes external accession IDs, "
"expert database URLs, species information, and miRBase-specific fields "
"(mature products, precursor links). Essential for mapping miRNA IDs "
"across databases and finding target interaction data."
msgstr ""

#: ../../tools/mirna_tools.rst:107 9c6cdac97ee44c91a9ab7886a56290d4
msgid ""
"``page_size`` (integer) (optional) Number of cross-references to return "
"(1-50). Default: 10."
msgstr ""

