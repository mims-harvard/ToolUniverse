msgid "**Parameters:**"
msgstr ""

#: ../../tools/signor_tools.rst:36 28958c5524eb4a1fac111daa370e339f
msgid ""
"``entity_id`` (string) (optional) Entity identifier - typically a UniProt"
" accession (e.g., 'P04637' for TP53, 'Q00987' for MDM2, 'P38398' for "
"BRCA1). Can also be a SIGNOR complex/pathway ID."
msgstr ""

#: ../../tools/signor_tools.rst:39 7ce9e63f20cc464480db0e3972e66cba
msgid ""
"``organism`` (integer) (optional) NCBI taxonomy ID. 9606 for human, 10090"
" for mouse."
msgstr ""

