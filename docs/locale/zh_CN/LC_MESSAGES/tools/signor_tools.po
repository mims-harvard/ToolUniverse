#: ../../tools/signor_tools.rst:32 294d60fbca0840a6a4ddf3849cebe3a8
msgid ""
"**Description**: Get causal signaling interactions for a protein or "
"entity from the SIGNOR database. Returns upstream regulators and "
"downstream targets with the type of effect (up/down-regulation), "
"mechanism (phosphorylation, ubiquitination, transcriptional regulation, "
"etc.), affected residue, and supporting literature. Use UniProt IDs "
"(e.g., P04637 for TP53) or SIGNOR entity IDs."
msgstr ""

#: ../../tools/signor_tools.rst:34 ../../tools/signor_tools.rst:73
#: ../../tools/signor_tools.rst:107 17ad7ef34e804bbdb66507e004cd022d
