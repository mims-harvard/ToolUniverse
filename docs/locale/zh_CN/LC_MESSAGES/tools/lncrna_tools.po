#: e3d8eaae8b814ef4838fa0b76e8fffe4 e4b9c715ed664f3197fe2dfb2a4305ca
msgid "**Parameters:**"
msgstr ""

#: ../../tools/lncrna_tools.rst:36 ca2660e6a55a4eb09aafd506b997ecc5
msgid ""
"``rnacentral_id`` (string) (required) RNAcentral URS identifier. Use "
"species-specific format 'URS\\_TAXID' (e.g., 'URS0002A146E4\\_9606' for "
"human MALAT1) or base URS ID with taxid parameter."
msgstr ""

#: ../../tools/lncrna_tools.rst:39 90e92685b577417aa513939626122a2c
msgid ""
"``taxid`` (integer) (optional) NCBI Taxonomy ID for species-specific "
"lookup (e.g., 9606 for human). Optional if rnacentral\\_id already "
"includes taxid."
msgstr ""

