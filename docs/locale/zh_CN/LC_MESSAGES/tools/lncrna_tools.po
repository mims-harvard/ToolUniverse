#: ../../tools/lncrna_tools.rst:66 96a250183c984ab6b1bf07b4cfd270fc
msgid ""
"**Description**: Retrieve publications associated with a long non-coding "
"RNA from RNAcentral. Returns publication titles, authors, PubMed IDs, "
"DOIs, and journal information. Use after LNCipedia\\_search\\_lncrna to "
"get the RNAcentral URS ID, then retrieve associated literature. MALAT1 "
"and HOTAIR are among the most-studied lncRNAs with hundreds of "
"publications."
msgstr ""

#: ../../tools/lncrna_tools.rst:70 ../../tools/lncrna_tools.rst:104
#: 41854cafe7a446d9a4730be395559568 b6065d7e6c1640f788657506c91c013a
msgid ""
"``rnacentral_id`` (string) (required) RNAcentral URS identifier (e.g., "
"'URS0002A146E4' for MALAT1). Use base URS ID without taxid suffix."
msgstr ""

#: ../../tools/lncrna_tools.rst:73 7e29d2e147ab439aa4b64da14ae97c72
msgid ""
"``page_size`` (integer) (optional) Number of publications to return "
"(1-50). Default: 10."
msgstr ""

#: ../../tools/lncrna_tools.rst:90 daa19dba7b6447718f0bd0d5eebba9db
msgid "**LNCipedia_get_lncrna_xrefs** (Type: miRNAGetTool)"
msgstr ""

#: ../../tools/lncrna_tools.rst:92 e331a8cdb5e3416b81741cb9e177485b
msgid ""
"Get cross-references for a long non-coding RNA from RNAcentral. Returns "
"database links from LNCip..."
msgstr ""

#: ../../tools/lncrna_tools.rst 725c77132fb647eeaa83daa9ccd82310
msgid "LNCipedia_get_lncrna_xrefs tool specification"
msgstr ""

#: ../../tools/lncrna_tools.rst:98 00abb883268b47edb31c8452ed66a62b
msgid "**Name**: ``LNCipedia_get_lncrna_xrefs``"
msgstr ""

#: ../../tools/lncrna_tools.rst:100 6a89636223be4aae8b537b08437e83cf
msgid ""
"**Description**: Get cross-references for a long non-coding RNA from "
"RNAcentral. Returns database links from LNCipedia, NONCODE, LncBook, "
"HGNC, RefSeq, GeneCards, MalaCards, Ensembl, and other sources. Includes "
"external accession IDs, expert database URLs, and species information. "
"Essential for mapping lncRNA IDs across databases and finding functional "
"annotation data."
msgstr ""

#: ../../tools/lncrna_tools.rst:107 55b202fa1d7941f1a706d919a611962b
msgid ""
"``page_size`` (integer) (optional) Number of cross-references to return "
"(1-50). Default: 10."
msgstr ""

