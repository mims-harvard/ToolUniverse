#: ../../tools/lncrna_tools.rst be11a77da9334836a24579229e2bb475
msgid "LNCipedia_search_lncrna tool specification"
msgstr ""

#: ../../tools/lncrna_tools.rst:132 60e15c4b72704a279a1b9d1e43746795
msgid "**Name**: ``LNCipedia_search_lncrna``"
msgstr ""

#: ../../tools/lncrna_tools.rst:133 ../../tools/lncrna_tools.rst:170
#: ca69ceabcf9c4748aee43056f77d08bd efbc2204222a4712ba3010b3b9e27d60
msgid "**Type**: ``miRNASearchTool``"
msgstr ""

#: ../../tools/lncrna_tools.rst:134 da3d118922844f0db10fbce48ab8e6e3
msgid ""
"**Description**: Search for long non-coding RNAs (lncRNAs) by name, "
"accession, or keyword using EBI Search over RNAcentral. RNAcentral "
"aggregates lncRNA data from LNCipedia, NONCODE, LncBook, HGNC, RefSeq, "
"GeneCards, and 50+ other databases. Supports filtering by species. "
"Returns RNAcentral IDs, descriptions, sequence lengths, and source "
"databases. Use to search for lncRNAs like MALAT1, HOTAIR, NEAT1, XIST, "
"H19, or KCNQ1OT1. The human genome encodes 50,000+ lncRNA transcripts. "
"Example: search 'MALAT1' returns URS0002A146E4\\_9606 (7472 nt, "
"metastasis-associated lung adenocarcinoma transcript 1)."
msgstr ""

#: ../../tools/lncrna_tools.rst:138 0207d55e365340b3856128f98b080877
msgid ""
"``query`` (string) (required) Search query: lncRNA name (e.g., 'MALAT1', "
"'HOTAIR'), gene symbol, accession, or keyword. Supports AND/OR operators."
msgstr ""

#: ../../tools/lncrna_tools.rst:141 c4d1169c8465424d9036bb14cf7a51a7
msgid ""
"``species`` (string) (optional) Species name filter (e.g., 'Homo "
"sapiens', 'Mus musculus'). Leave empty for all species."
msgstr ""

#: ../../tools/lncrna_tools.rst:144 ../../tools/lncrna_tools.rst:184
#: 3157781441254773bf373964a7a48cd4 ba51d97f90334019aae8f97756dc78b1
msgid ""
"``size`` (integer) (optional) Number of results to return (1-100). "
"Default: 10."
msgstr ""

#: ../../tools/lncrna_tools.rst:161 c0fab1ac41b649c3bb0147c62fab99b0
msgid "**LNCipedia_search_ncrna_by_type** (Type: miRNASearchTool)"
msgstr ""

#: ../../tools/lncrna_tools.rst:163 c198499ac4db4bcba330609ca733d074
msgid ""
"Search for any type of non-coding RNA by RNA type classification. "
"Supports all RNA types in RNAce..."
msgstr ""

#: ../../tools/lncrna_tools.rst 1c7ef502467a4905b79f9bfc00efe3d6
msgid "LNCipedia_search_ncrna_by_type tool specification"
msgstr ""

#: ../../tools/lncrna_tools.rst:169 3e4555f33f7e4dd5b79e8ba103d89a17
msgid "**Name**: ``LNCipedia_search_ncrna_by_type``"
msgstr ""

#: ../../tools/lncrna_tools.rst:171 712a24d7cc994b6591efdca171f3d699
msgid ""
"**Description**: Search for any type of non-coding RNA by RNA type "
"classification. Supports all RNA types in RNAcentral: miRNA, lncRNA, "
"rRNA, tRNA, snRNA, snoRNA, piRNA, pre\\_miRNA, SRP\\_RNA, "
"RNase\\_P\\_RNA, antisense\\_RNA, and more. Useful for browsing or "
"discovering ncRNAs of a specific type, optionally filtered by species or "
"keyword. Example: search for all human snoRNAs, or find piRNAs related to"
" a specific gene."
msgstr ""

#: ../../tools/lncrna_tools.rst:175 dc656bb1ae62404f836dad785d9095c9
msgid ""
"``query`` (string) (required) Search query: gene name, keyword, or "
"accession. Use '\\*' for all entries of the specified RNA type."
msgstr ""

#: ../../tools/lncrna_tools.rst:178 83b6a3c18dfa4188897d76aa1163d720
msgid ""
"``rna_type`` (string) (optional) RNA type filter: miRNA, lncRNA, rRNA, "
"tRNA, snRNA, snoRNA, piRNA, pre\\_miRNA, SRP\\_RNA, RNase\\_P\\_RNA, "
"antisense\\_RNA, ribozyme, etc."
msgstr ""

#: ../../tools/lncrna_tools.rst:181 e8a856a8e32c4b9b8cc59d69aa1d955c
msgid ""
"``species`` (string) (optional) Species name filter (e.g., 'Homo "
"sapiens'). Leave empty for all species."
msgstr ""

