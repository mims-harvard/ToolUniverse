#: ../../tools/ncbi_variation_tools.rst:154 e33eac7baa9947cba68307836cdc853b
msgid "**Name**: ``NCBIVariation_spdi_to_hgvs``"
msgstr ""

#: ../../tools/ncbi_variation_tools.rst:156 fc0fdf2a16b74a38bd3cb54213ad6630
msgid ""
"**Description**: Convert a variant in SPDI notation to HGVS notation "
"using NCBI Variation Services. SPDI (Sequence Position Deletion "
"Insertion) is NCBI's canonical variant representation. Input format: "
"'SeqID:Position:DeletedSequence:InsertedSequence' (e.g., "
"'NC\\_000001.11:230710047:A:G'). Returns the equivalent HGVS genomic "
"description (e.g., 'NC\\_000001.11:g.230710048A>G'). Note: SPDI uses "
"0-based interbase coordinates, while HGVS uses 1-based."
msgstr ""

#: ../../tools/ncbi_variation_tools.rst:160 199dc7c05ec0422b840ba8a0e80a8503
msgid ""
"``spdi`` (string) (required) Variant in SPDI notation "
"(SeqID:Position:Deleted:Inserted). Examples: "
"'NC\\_000001.11:230710047:A:G' (AGT M259T), 'NC\\_000017.11:7674220:G:C' "
"(TP53 region), 'NM\\_000059.4:266:AT:' (BRCA2 c.68\\_69del)"
msgstr ""

