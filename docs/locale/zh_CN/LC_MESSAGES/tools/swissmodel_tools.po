msgstr ""

#: ../../tools/swissmodel_tools.rst:36 ff6907ea60394bfd9ca7976b06d65ec5
msgid ""
"``uniprot_id`` (string) (required) UniProt accession identifier. "
"Examples: 'P04637' (human p53), 'P00533' (human EGFR), 'Q9Y6I3' (human "
"EPN1)."
msgstr ""

