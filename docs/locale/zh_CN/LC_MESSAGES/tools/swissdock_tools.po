msgstr ""

#: ../../tools/swissdock_tools.rst:102 9bc6fc9dad614af8b5959927de12f338
msgid ""
"Retrieve results for a completed SwissDock docking job. Returns download "
"URL and metadata for doc..."
msgstr ""

#: ../../tools/swissdock_tools.rst 4d850e14c84d48199a5f6bc2a735345f
msgid "SwissDock_retrieve_results tool specification"
msgstr ""

#: ../../tools/swissdock_tools.rst:108 5cde3842c8ad411d8136808be1885a51
msgid "**Name**: ``SwissDock_retrieve_results``"
msgstr ""

#: ../../tools/swissdock_tools.rst:110 2411aedbfbf94a1ebbd6564e7e22569d
msgid ""
"**Description**: Retrieve results for a completed SwissDock docking job. "
"Returns download URL and metadata for docking output files. The results "
"archive (tar.gz) contains: predicted binding poses (PDB files), docking "
"scores (energies and rankings), cluster information, and visualization "
"files. Use this only after check\\_job\\_status confirms the job is "
"FINISHED. Results are available for several days after completion. "
"Example: Download results to analyze top-ranked poses and binding "
"energies."
msgstr ""

#: ../../tools/swissdock_tools.rst:114 fbe7b210b69a478383e7af491d93c9af
msgid ""
"``session_id`` (string) (required) Session identifier from dock\\_ligand "
"or check\\_job\\_status call (same alphanumeric string). Example: Use the"
" session\\_id from successful dock\\_ligand submission."
msgstr ""

