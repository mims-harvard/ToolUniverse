msgstr ""

#: ../../tools/swissdock_tools.rst:55 3742445b3e7a42fa845f73a090ca48fc
msgid ""
"Perform protein-ligand molecular docking using SwissDock service with "
"AutoDock Vina or Attracting..."
msgstr ""

#: ../../tools/swissdock_tools.rst 8884046e6aad4ce3bb23c8ec315c49af
msgid "SwissDock_dock_ligand tool specification"
msgstr ""

#: ../../tools/swissdock_tools.rst:61 e986174d969844b3bc4024a0a9e3665c
msgid "**Name**: ``SwissDock_dock_ligand``"
msgstr ""

#: ../../tools/swissdock_tools.rst:63 0e67a5b4e54b4efeb9280423e72ae4ee
msgid ""
"**Description**: Perform protein-ligand molecular docking using SwissDock"
" service with AutoDock Vina or Attracting Cavities 2.0 engines. Predicts "
"binding modes, poses, and energies for small molecules against protein "
"structures. Essential for drug discovery, virtual screening, and "
"structure-based drug design. Supports blind docking (whole protein) or "
"targeted docking (specific binding site). Returns docking scores, poses, "
"and download URL for detailed results. Example: Dock aspirin "
"(CC(=O)Oc1ccccc1C(=O)O) against COX-2 (PDB: 1CX2) to predict binding mode"
" and affinity."
msgstr ""

#: ../../tools/swissdock_tools.rst:67 d5a888d40d704aceaf0da7506edd28da
msgid ""
"``ligand_smiles`` (string) (required) SMILES string of the ligand/small "
"molecule to dock. Example: 'CC(=O)Oc1ccccc1C(=O)O' for aspirin"
msgstr ""

#: ../../tools/swissdock_tools.rst:70 be7fc2f6f0c547d3b52137b40a7b3a98
msgid ""
"``pdb_id`` (string) (required) 4-character PDB ID of the target protein "
"structure. Example: '1ATP' for protein kinase A"
msgstr ""

#: ../../tools/swissdock_tools.rst:73 ee21cb58a8c44c0ebb6b0f893de50b64
msgid ""
"``exhaustiveness`` (integer) (optional) Search exhaustiveness (1-20). "
"Higher values increase accuracy but take longer. Default: 8. Use 16-20 "
"for publication-quality results. Example: Use 8 for quick screening, 16 "
"for final validation."
msgstr ""

#: ../../tools/swissdock_tools.rst:76 2c45ae3c6d6d4d3f84d630654dff2646
msgid ""
"``box_center`` (string) (optional) Binding site center coordinates as "
"'x,y,z' in Angstroms. If not provided, performs blind docking (whole "
"protein). Example: '10.5,20.3,15.8'"
msgstr ""

#: ../../tools/swissdock_tools.rst:79 5f70ee33c1454629b4c74bcfccc4321e
msgid ""
"``box_size`` (string) (optional) Search box dimensions as 'a,b,c' in "
"Angstroms. If not provided, uses default size. Example: '20,20,20' for "
"20x20x20 Angstrom box."
msgstr ""

#: ../../tools/swissdock_tools.rst:82 b3442abeb76148faa4425c09c1671e75
msgid ""
"``docking_engine`` (string) (optional) Docking engine: "
"'attracting\\_cavities' (cavity-based, default, recommended for blind "
"docking) or 'vina' (AutoDock Vina, faster for targeted docking). Example:"
" Use 'attracting\\_cavities' for whole-protein screening, 'vina' for "
"known binding site."
msgstr ""

