#: ../../tools/rxclass_tools.rst:69 45fc8850d81e4c818839425fdf5fed39
msgid ""
"**Description**: List all drugs belonging to a specific drug class by "
"class ID in NLM RxClass. Returns RXCUIs and drug names for all member "
"ingredients. No API key required. Example: classId='M01AE' (propionic "
"acid derivatives) returns ibuprofen, naproxen, ketoprofen, etc."
msgstr ""

#: ../../tools/rxclass_tools.rst:73 1d6c6fcb3f64452f8f3774af38874d90
msgid ""
"``class_id`` (string) (required) Drug class identifier. ATC class codes: "
"'M01AE' (propionic acid derivatives), 'N02BA' (salicylic acid "
"derivatives), 'A10BA' (biguanides). FDA EPC IDs are long numeric strings."
msgstr ""

#: ../../tools/rxclass_tools.rst:76 d553a73f230647eba4efbe2f626c33aa
msgid ""
"``rela_source`` (string, null) (optional) Classification source system. "
"Options: 'ATC' (default), 'FDASPL', 'MESH', 'VA', 'DAILYMED'."
msgstr ""

#: ../../tools/rxclass_tools.rst:79 45470898e4214cb4bfcf24946514065f
msgid ""
"``ttys`` (string, null) (optional) RxNorm term types to include. Options:"
" 'IN' (ingredients, default), 'PIN' (precise ingredients), 'MIN' (multi-"
"ingredients), 'SCD' (semantic clinical drugs). Default: 'IN'."
msgstr ""

#: ../../tools/rxclass_tools.rst:82 6156ae45d57f4d588272a6983c0507a2
msgid ""
"``limit`` (integer, null) (optional) Maximum number of drugs to return "
"(default 50)."
msgstr ""

