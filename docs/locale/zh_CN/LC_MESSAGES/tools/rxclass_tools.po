#: ../../tools/rxclass_tools.rst:32 b89d7244b41f4ba0b51fec243571739f
msgid ""
"**Description**: Search NLM RxClass drug classification database by "
"keyword. Returns matching class IDs, names, and types (ATC, EPC, MoA, "
"etc.). No API key required. Example: query='analgesic' returns pain-"
"related drug classes; query='beta blocker' returns adrenergic receptor "
"blocker classes."
msgstr ""

#: ../../tools/rxclass_tools.rst:34 ../../tools/rxclass_tools.rst:71
#: ../../tools/rxclass_tools.rst:111 9040c17396c64dde94cc877285c79ec2
