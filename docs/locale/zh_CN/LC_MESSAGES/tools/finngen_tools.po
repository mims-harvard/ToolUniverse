#: ../../tools/finngen_tools.rst:121 4248e4da0ce24579a6cb2ea31930bca1
msgid ""
"Search and list FinnGen disease endpoints (phenotypes). FinnGen is a "
"Finnish population genomics ..."
msgstr ""

#: ../../tools/finngen_tools.rst 30a2cecb11b741d0a3621946b8dd2b3d
msgid "FinnGen_list_phenotypes tool specification"
msgstr ""

#: ../../tools/finngen_tools.rst:127 00735a1dcf574efc9f6990e498b4a5c4
msgid "**Name**: ``FinnGen_list_phenotypes``"
msgstr ""

#: ../../tools/finngen_tools.rst:129 ea661aaaa0aa47a29e4d9d8965a852da
msgid ""
"**Description**: Search and list FinnGen disease endpoints (phenotypes). "
"FinnGen is a Finnish population genomics study with 486,367 participants "
"and 2,470 phenotypes. Search by keyword (e.g., 'diabetes', 'asthma', "
"'cancer') or browse by category. Returns phenotype codes, case/control "
"counts, and number of genome-wide significant loci. Use phenocode values "
"from results with FinnGen\\_get\\_phenotype and "
"FinnGen\\_get\\_region\\_associations."
msgstr ""

#: ../../tools/finngen_tools.rst:133 a10c30fc121d4722965956200b4c568e
msgid ""
"``query`` (string, null) (optional) Search query to filter phenotypes by "
"code, name, or category (e.g., 'diabetes', 'breast cancer', 'asthma'). "
"Case-insensitive."
msgstr ""

#: ../../tools/finngen_tools.rst:136 74ba70c5514a48d6baa5670c653b689a
msgid ""
"``category`` (string, null) (optional) Filter by disease category (e.g., "
"'Diabetes', 'circulatory', 'Neoplasms'). Case-insensitive substring "
"match."
msgstr ""

#: ../../tools/finngen_tools.rst:139 287e7266e4374cdd9ba79a20d4b404bc
msgid ""
"``min_cases`` (integer, null) (optional) Minimum number of cases "
"required. Use to filter for well-powered phenotypes (e.g., 1000)."
msgstr ""

#: ../../tools/finngen_tools.rst:142 b9b4f81eeb8a48d8b2bc12577cf1f90b
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results to return "
"(default 50)."
msgstr ""

