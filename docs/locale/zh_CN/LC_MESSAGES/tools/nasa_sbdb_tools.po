#: ../../tools/nasa_sbdb_tools.rst:32 8717543eb0554044986e737f564add2b
msgid ""
"**Description**: Query NASA's Close Approach Data (CAD) API for asteroids"
" and comets making close approaches to Earth or other planets. Returns "
"upcoming or historical close approaches with distances, velocities, and "
"object properties. Useful for planetary defense research, monitoring "
"near-Earth objects, and studying asteroid flybys. Distance units: AU (1 "
"AU = 149.6 million km). Minimum distance 0 (impact), typical close "
"approaches < 0.05 AU."
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:34 ../../tools/nasa_sbdb_tools.rst:79
#: 430a3fa2513f4ac7a946738bc2ef5596 ea2ff804b2534a2fbcde42ca404eebe5
msgid "**Parameters:**"
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:36 5f102a1f2fc646efba7833c171cb3f35
msgid ""
"``dist-max`` (string, null) (optional) Maximum approach distance in AU. "
"Examples: '0.01' (1.5 million km), '0.05' (7.5 million km), '0.5' (75 "
"million km). Default: 0.05"
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:39 13d1c381b99f4fbb88d280f5d4c4398b
msgid ""
"``date-min`` (string, null) (optional) Start date for search (YYYY-MM-DD "
"format). Default: current date."
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:42 fbc14b6ff8004e2e961f7ada1ea2a60b
msgid ""
"``date-max`` (string, null) (optional) End date for search (YYYY-MM-DD "
"format). Example: '2025-12-31'"
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:45 6041b908e9484dea8218e7a28c5445e1
msgid ""
"``h-max`` (number, null) (optional) Filter by maximum absolute magnitude "
"H (smaller H = larger object). H<18 is ~1km diameter, H<22 is ~100m "
"diameter."
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:48 bd2ab02a7c9a4645afda964755b5e217
msgid ""
"``des`` (string, null) (optional) Filter by specific body designation "
"(e.g., '99942' for Apophis, '2020 SO')"
msgstr ""

#: ../../tools/nasa_sbdb_tools.rst:51 c15b535dd6a5494381a3b639d1ca1ad7
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results (default "
"50, max 10000)"
msgstr ""

