#: ../../tools/targetmine_tools.rst:32 361ba18521f44886af7bb4ee28f8521b
msgid ""
"**Description**: Search TargetMine, the InterMine data warehouse focused "
"on drug target discovery and prioritization. TargetMine integrates data "
"from UniProt, PDB, ChEMBL, Reactome, KEGG, DrugBank, TTD, and clinical "
"trials databases. Searches across genes, proteins, pathways, disease "
"terms, drugs, and biomarkers. Use this to find drug targets, investigate "
"target-disease associations, and explore chemical-genomics data. Filter "
"by facet\\_Category for specific entity types (e.g., 'Gene', 'Protein', "
"'Pathway', 'DiseaseTerm', 'IPFBiomarker', 'IPFTrial')."
msgstr ""

#: ../../tools/targetmine_tools.rst:34 ../../tools/targetmine_tools.rst:74
#: a64425c0d7004105aecacb564b4c638b ecfdc068ad224f43b23ae9d43b769f02
msgid "**Parameters:**"
msgstr ""

#: ../../tools/targetmine_tools.rst:36 743ef703612a4a39bbc4233c72510aae
msgid ""
"``q`` (string) (required) Search query: gene symbol (e.g., 'TP53', "
"'EGFR', 'BRCA1'), protein name, drug name, disease term, or free text."
msgstr ""

#: ../../tools/targetmine_tools.rst:39 ../../tools/targetmine_tools.rst:79
#: 093abe509a5b462ebb8c17665b8fd092 4849e80ff5204e69bcd3af937450582e
msgid "``size`` (integer) (optional) Number of results to return (default: 10)."
msgstr ""

#: ../../tools/targetmine_tools.rst:42 ee442ad4f2f444168a3599a7f25918a4
msgid "``format`` (string) (optional) Response format. Must be 'json'."
msgstr ""

#: ../../tools/targetmine_tools.rst:45 f56264ce3c294441a1a112e2dbb0c6f1
msgid ""
"``facet_Category`` (string) (optional) Filter by entity category. "
"Options: 'Gene', 'Protein', 'Pathway', 'DiseaseTerm', 'DiseaseConcept', "
"'IPFBiomarker', 'IPFTrial', 'WHOTrial', 'IPF', 'UMLSTerm', 'MeshTerm', "
"'EFOTerm', 'DOTerm', 'GOTerm', 'Transcript', 'Exon', 'MRNA', "
"'IntegratedPathwayCluster', 'TbcAnnotation'."
msgstr ""

