#: ../../tools/inaturalist_tools.rst:36 7215b62e600746fa88232322d902f1c8
msgid ""
"``taxon_id`` (integer, null) (optional) Parent taxon ID to get species "
"counts within. Examples: 41479 (Delphinidae - dolphins), 41944 (Panthera "
"- big cats), 47126 (Sequoioideae - redwoods)."
msgstr ""

#: ../../tools/inaturalist_tools.rst:39 8b81cd876d4d4caf9910bd1f8d9fa6bb
msgid ""
"``place_id`` (integer, null) (optional) Place ID to filter by location. "
"Example: 10211 (Yellowstone)."
msgstr ""

#: ../../tools/inaturalist_tools.rst:42 f24236987c024813aa75383b8bd9daf7
msgid ""
"``quality_grade`` (string, null) (optional) Quality filter: 'research', "
"'needs\\_id', or 'casual'. Default: 'research'."
