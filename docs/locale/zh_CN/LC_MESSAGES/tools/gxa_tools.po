#: ../../tools/gxa_tools.rst:95 465adfc591c8480b94824dd909fe3942
msgid "**Name**: ``GxA_list_experiments``"
msgstr ""

#: ../../tools/gxa_tools.rst:97 fa5db8597e4549ba8550204069cf25e3
msgid ""
"**Description**: List gene expression experiments from EBI Gene "
"Expression Atlas. Can filter by species (e.g., 'Homo sapiens') and "
"experiment type ('baseline' for tissue expression, 'differential' for "
"condition comparisons). The Atlas contains 4,500+ experiments across "
"hundreds of species. Example: filtering by 'Homo sapiens' and 'baseline' "
"returns 123 human tissue-level expression experiments including "
"E-MTAB-2836 (122 human tissues), E-MTAB-2706 (675 cancer cell lines), and"
" E-GEOD-46817 (melanoma)."
msgstr ""

#: ../../tools/gxa_tools.rst:101 8adb1d12e84e410fa4192219855981b5
msgid ""
"``species`` (string) (optional) Species name to filter experiments (e.g.,"
" 'Homo sapiens', 'Mus musculus', 'Arabidopsis thaliana'). Leave empty for"
" all species."
msgstr ""

#: ../../tools/gxa_tools.rst:104 5da58aa2c66243ccb5eeb67bf4b2fd5a
msgid ""
"``experiment_type`` (string) (optional) Filter by experiment type: "
"'baseline' (tissue/cell type expression), 'differential' (condition "
"comparisons), 'proteomics', or 'rnaseq'. Leave empty for all types."
msgstr ""

#: ../../tools/gxa_tools.rst:107 e6b7eb2fa4ea4712acbf06dfb49e70d2
msgid ""
"``limit`` (integer) (optional) Maximum number of experiments to return "
"(1-100). Default: 20."
msgstr ""

