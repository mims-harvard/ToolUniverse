#: ../../tools/gxa_tools.rst:32 f38adea371ce48f4bf5d737714856425
msgid ""
"**Description**: Get gene expression data from a specific Expression "
"Atlas experiment. Returns expression levels across tissues or conditions,"
" with optional filtering by gene ID. Experiment E-MTAB-2836 contains RNA-"
"seq of 122 human tissues, E-MTAB-2706 covers 675 cancer cell lines. For "
"each gene, expression values are provided across all assayed conditions "
"(tissues, cell types, developmental stages, etc.)."
msgstr ""

#: ../../tools/gxa_tools.rst:34 ../../tools/gxa_tools.rst:68
#: ../../tools/gxa_tools.rst:99 6839ee2e153a47c484cda9cc32057dae
