msgid "**Name**: ``KLIFS_list_kinases``"
msgstr ""

#: ../../tools/klifs_tools.rst:156 3827f92434e643e8b662f75e8ce45f9c
msgid ""
"**Description**: List kinases in the Kinase-Ligand Interaction "
"Fingerprints and Structures (KLIFS) database. KLIFS contains 1,100+ "
"kinases from 7,000+ crystal structures with curated binding pocket "
"information. Returns kinase IDs, names, HGNC symbols, kinase family/group"
" classification, species, and UniProt IDs. Filter by kinase group (TK, "
"TKL, STE, CK1, AGC, CAMK, CMGC) or species (Human, Mouse, Rat)."
msgstr ""

#: ../../tools/klifs_tools.rst:160 2c4f0266547b4e54be12ce5e972aeac8
msgid ""
"``kinase_group`` (string, null) (optional) Filter by kinase group: 'TK' "
"(tyrosine kinase), 'TKL' (TK-like), 'STE', 'CK1', 'AGC', 'CAMK', 'CMGC', "
"'RGC', 'Other'"
msgstr ""

#: ../../tools/klifs_tools.rst:163 34537c88e17845e6a38ad3ed3b366899
msgid ""
"``species`` (string, null) (optional) Filter by species: 'Human', "
"'Mouse', 'Rat'"
msgstr ""

