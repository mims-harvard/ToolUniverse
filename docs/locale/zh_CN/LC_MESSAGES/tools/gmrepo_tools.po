msgstr ""

#: ../../tools/gmrepo_tools.rst:36 441c7192eb724b368bae0cca006feba8
msgid ""
"``query`` (string) (optional) Optional keyword to filter phenotypes. "
"Examples: 'diabetes', 'obesity', 'cancer', 'Healthy', 'Crohn'. Leave "
"empty to list all phenotypes."
msgstr ""

