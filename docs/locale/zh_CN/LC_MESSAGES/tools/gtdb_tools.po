#: ../../tools/gtdb_tools.rst:138 2aaa6fb887634ed1a079103fe98266f2
msgid "**Name**: ``GTDB_search_genomes``"
msgstr ""

#: ../../tools/gtdb_tools.rst:140 0947cd7f68b7431ea811e737c759161c
msgid ""
"**Description**: Search for prokaryotic genomes in GTDB by organism name."
" Returns genome accessions with both NCBI and GTDB taxonomy "
"classifications, allowing comparison between the two taxonomic systems. "
"Each result shows the genome accession (GCA/GCF), NCBI organism name, "
"NCBI taxonomy, GTDB taxonomy, and whether the genome is a GTDB species "
"representative. Supports pagination. Useful for finding genome "
"accessions, exploring taxonomic reclassifications, and linking genomes to"
" the GTDB taxonomy."
msgstr ""

#: ../../tools/gtdb_tools.rst:144 cbe480e07a274845a5d1d70dc352c05f
msgid "``operation`` (string) (required) Operation type (fixed: search\\_genomes)"
msgstr ""

#: ../../tools/gtdb_tools.rst:147 9780562cdc3a49439cbe1492a9115152
msgid ""
"``query`` (string) (required) Search query for organism name (e.g., "
"'Escherichia', 'Staphylococcus aureus', 'Lactobacillus')"
msgstr ""

#: ../../tools/gtdb_tools.rst:150 9c4dec3b19e04c6c9875d8e662ae87bf
msgid "``page`` (integer) (optional) Page number for pagination (default: 1)"
msgstr ""

#: ../../tools/gtdb_tools.rst:153 93bedb75b6ad4e33bafe3e1c04af9cc5
msgid ""
"``items_per_page`` (integer) (optional) Number of results per page "
"(default: 10, max: 50)"
msgstr ""

