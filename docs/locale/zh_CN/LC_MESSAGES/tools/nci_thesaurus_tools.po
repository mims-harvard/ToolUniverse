msgid ""
"Search the NCI Thesaurus (NCIt) for biomedical concepts by term. NCIt is "
"the National Cancer Inst..."
msgstr ""

#: ../../tools/nci_thesaurus_tools.rst d30a1b0b1e2c4293b5cfc63580df2877
msgid "NCIThesaurus_search tool specification"
msgstr ""

#: ../../tools/nci_thesaurus_tools.rst:92 e5673e63ddc44b4bae5968b085a761b5
msgid "**Name**: ``NCIThesaurus_search``"
msgstr ""

#: ../../tools/nci_thesaurus_tools.rst:94 64fe4a8fc65c4bc4ac870136884b0257
msgid ""
"**Description**: Search the NCI Thesaurus (NCIt) for biomedical concepts "
"by term. NCIt is the National Cancer Institute's reference terminology "
"covering cancer-related terms, diseases, drugs, anatomy, genes, and "
"biological processes. Returns matching concepts with NCI codes, names, "
"and semantic types. Essential for standardized cancer research "
"vocabulary. Example: searching 'melanoma' returns C3224 (Melanoma) as the"
" primary concept."
msgstr ""

#: ../../tools/nci_thesaurus_tools.rst:98 530aba7936074bf0bd1120eb05641203
msgid ""
"``term`` (string) (required) Search term for NCI concepts. Examples: "
"'melanoma', 'breast cancer', 'imatinib', 'BRCA1', 'apoptosis', 'lung "
"adenocarcinoma'."
msgstr ""

#: ../../tools/nci_thesaurus_tools.rst:101 d41329cd7d854043a5e4f13a7a7ce2d4
msgid ""
"``page_size`` (integer, null) (optional) Number of results to return "
"(default 10, max 100)."
msgstr ""

