#: ../../tools/metnorway_tools.rst:32 94594415dbee4237898b6b89d9e18851
msgid ""
"**Description**: Get weather forecasts for any global location from the "
"Norwegian Meteorological Institute (MET Norway) Locationforecast API. "
"Returns hourly or 6-hourly temperature, precipitation, wind, humidity, "
"and cloud cover forecasts for up to 9 days. No authentication required, "
"but a User-Agent header with contact info is requested. Excellent free "
"alternative to paid weather APIs. Used by major weather services "
"worldwide."
msgstr ""

#: ../../tools/metnorway_tools.rst:34 1f4c1863837c4dcab392aaf99f8c9247
msgid "**Parameters:**"
msgstr ""

#: ../../tools/metnorway_tools.rst:36 c629b24ca094423e8b53b76c8c4da1a7
msgid ""
"``lat`` (number) (required) Latitude in decimal degrees (-90 to 90). "
"Examples: 59.9139 (Oslo), 51.5074 (London), 40.7128 (New York), 48.8566 "
"(Paris), 35.6762 (Tokyo)"
msgstr ""

#: ../../tools/metnorway_tools.rst:39 87aba65aa9034e4b98a1c95d57e6831b
msgid ""
"``lon`` (number) (required) Longitude in decimal degrees (-180 to 180). "
"Examples: 10.7522 (Oslo), -0.1278 (London), -74.0060 (New York), 2.3522 "
"(Paris), 139.6503 (Tokyo)"
msgstr ""

#: ../../tools/metnorway_tools.rst:42 40305324164a4579955fd0bdf796008c
msgid ""
"``altitude`` (integer, null) (optional) Station altitude in meters above "
"sea level. Optional. Improves forecast accuracy for mountain locations."
msgstr ""

