#: ../../tools/lincs_tools.rst:32 6c9dcfdf6c454ccdbc6f3ab90ebc7fb1
msgid ""
"**Description**: List available LINCS signature libraries with metadata. "
"LINCS SigCom contains 431+ libraries covering L1000 gene expression, "
"kinase profiling, cell growth inhibition, proteomics, and other assay "
"types. Optionally filter by keyword (e.g., 'L1000', 'kinase', "
"'proteomics'). Returns library IDs, dataset identifiers, assay types, "
"organisms, and descriptions."
msgstr ""

#: ../../tools/lincs_tools.rst:34 ../../tools/lincs_tools.rst:67
#: 3e1a3673e68b44218a988d5cf22b1ef8 d931c62c5efc4934b52c376edee71d5d
