msgstr ""

#: ../../tools/lincs_tools.rst:36 3c1892a68d684d689f82fcfeac11b943
msgid ""
"``keyword`` (string) (optional) Optional keyword to filter libraries "
"(case-insensitive). Examples: 'L1000', 'kinase', 'proteomics', 'RNA-seq',"
" 'CRISPR'. Leave empty to list all."
msgstr ""

#: ../../tools/lincs_tools.rst:39 18e8cb2365ab4a7aabe1659a03715b7c
msgid ""
"``limit`` (integer) (optional) Maximum number of libraries to return "
"(1-100). Default: 50."
msgstr ""

