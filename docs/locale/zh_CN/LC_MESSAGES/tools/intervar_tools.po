#: ../../tools/intervar_tools.rst:32 3d6f18ed14374fb8ae00ea267dfd11d1
msgid ""
"**Description**: Classify a germline variant using ACMG/AMP 2015 "
"standards (InterVar). Returns the clinical significance category — "
"Pathogenic, Likely Pathogenic, Uncertain Significance, Likely Benign, or "
"Benign — plus the activation status of all 28 evidence criteria (PVS1, "
"PS1-PS4, PM1-PM6, PP1-PP5, BA1, BP1-BP7, BS1-BS4). Input requires genomic"
" coordinates in hg19 or hg38. No API key needed. Example: BRCA1 "
"c.5266dupC (chr17:41245466 G>A in hg19) is Likely Pathogenic with "
"PM2+PP3+PP5."
msgstr ""

#: ../../tools/intervar_tools.rst:34 ef8b2a1615814748b73c8f103e697c63
msgid "**Parameters:**"
msgstr ""

#: ../../tools/intervar_tools.rst:36 dc31cc2a1c9f4b8aa9b9cd5c3f447636
msgid ""
"``chrom`` (string) (required) Chromosome number or name. Can include "
"'chr' prefix (e.g., '17', 'chr17', 'X')."
msgstr ""

#: ../../tools/intervar_tools.rst:39 beab00a91d7a46afadd94ae54cc5cacd
msgid "``pos`` (integer) (required) Genomic position (1-based)."
msgstr ""

#: ../../tools/intervar_tools.rst:42 cbf6bb38218c4175b13a767639e8b26b
msgid "``ref`` (string) (required) Reference allele (e.g., 'G', 'A', 'ATCG')."
msgstr ""

#: ../../tools/intervar_tools.rst:45 e050283707b041f0ba5ce9c7e0043a90
msgid "``alt`` (string) (required) Alternate allele (e.g., 'A', 'T', 'C')."
msgstr ""

#: ../../tools/intervar_tools.rst:48 7d4324b50ede44f89a4afaba3a3b2c11
msgid "``build`` (string) (optional) Genome build. Default: hg19."
msgstr ""

