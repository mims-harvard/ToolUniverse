msgstr ""

#: ../../tools/europepmc_annotations_tools.rst:36
#: eaaa986659eb4f07a3c8981c85ee4545
msgid ""
"``article_ids`` (string) (required) Comma-separated article identifiers. "
"Format: 'PMC:PMCXXXXXXX' or 'MED:PMID'. Examples: "
"'PMC:PMC4353746,PMC:PMC3531190', 'MED:25780448,MED:23256780'. Max 200 "
"articles."
msgstr ""

#: ../../tools/europepmc_annotations_tools.rst:39
#: 52cede0e2b574bdd8d399ac4e9bd4cc4
msgid ""
"``annotation_type`` (string) (required) Annotation type to retrieve. One "
"of: 'Chemicals', 'Organisms', 'Gene Ontology', 'Diseases', 'Genes & "
"Proteins', 'Accession Numbers'."
msgstr ""

#: ../../tools/europepmc_annotations_tools.rst:42
#: a7d802579332423b9e74b791513c35c8
msgid ""
"``page_size`` (integer, null) (optional) Number of results per page. "
"Default: 25. Max: 1000."
msgstr ""

