#: ../../tools/ncbi_gene_tools.rst 37f97707b7e04694993edca032b9c611
msgid "NCBIProtein_get_summary tool specification"
msgstr ""

#: ../../tools/ncbi_gene_tools.rst:95 0e7be63f7ff1408381622cc6c9e57564
msgid "**Name**: ``NCBIProtein_get_summary``"
msgstr ""

#: ../../tools/ncbi_gene_tools.rst:97 e6666eacc0aa4b42b96811f9ecba4eca
msgid ""
"**Description**: Get protein record summary from the NCBI Protein "
"database by GI number or accession using the E-utilities ESummary API. "
"Returns protein title, organism, accession version, sequence length, "
"molecular type, source database, and creation/update dates. NCBI Protein "
"aggregates sequences from GenBank, RefSeq, Swiss-Prot, PDB, and other "
"sources. Use for resolving NCBI protein GI numbers to names, accessions, "
"and species. Example: GI 119395750 returns 'keratin, type II cytoskeletal"
" 1 [Homo sapiens]' with accession NP\\_006112.3 and length 644 aa."
msgstr ""

#: ../../tools/ncbi_gene_tools.rst:101 109d56211f204bcf86f9a709cb191a20
msgid ""
"``id`` (string) (required) NCBI Protein ID (GI number or accession). Can "
"be a single ID or comma-separated list. Examples: '119395750' (keratin 1,"
" NP\\_006112), '4507879' (TP53, NP\\_000537), '4503747' (EGFR, "
"NP\\_005219). GI numbers can be obtained from NCBI Gene genomic info or "
"from BLAST results."
msgstr ""

