#: ../../tools/fooddata_central_tools.rst:63 0beb685e5176406c956d81137b5b8030
msgid ""
"**Description**: Search USDA FoodData Central for foods by keyword. "
"Returns matching foods with nutrient data, brand info, and ingredients. "
"Covers Foundation, Branded, SR Legacy, and Survey data. Example: 'banana'"
" finds all banana products."
msgstr ""

#: ../../tools/fooddata_central_tools.rst:67 8959d0303ddc4279900caed41d2d9da9
msgid ""
"``query`` (string) (required) Search keywords (e.g., 'cheddar cheese', "
"'banana', 'chicken breast'). Supports multi-word search."
msgstr ""

#: ../../tools/fooddata_central_tools.rst:70 0dc66f88da3f4207b831652ea248e6d3
msgid ""
"``page_size`` (integer) (optional) Number of results per page (default "
"25, max 200)."
msgstr ""

#: ../../tools/fooddata_central_tools.rst:73 4b10c0fe42984db78637be6be3e049b5
msgid ""
"``page_number`` (integer) (optional) Page number for pagination (starts "
"at 1)."
msgstr ""

#: ../../tools/fooddata_central_tools.rst:76 309c4238e8e84264af71c042c1951eaf
msgid ""
"``data_type`` (string) (optional) Filter by data type. Options: "
"'Foundation' (reference foods), 'Branded' (commercial products), 'SR "
"Legacy' (USDA standard reference), 'Survey (FNDDS)' (national dietary "
"survey)."
msgstr ""

