#: ../../tools/zinc_tools.rst:163 dd868574db2846e0b78493c68dd30f89
msgid ""
"**Description**: Search the ZINC database by SMILES structure string. "
"Finds exact or similar compounds matching the given SMILES. Useful for "
"finding purchasable analogs of a lead compound or checking if a specific "
"structure is commercially available. Returns ZINC IDs, SMILES, and "
"molecular properties."
msgstr ""

#: ../../tools/zinc_tools.rst:170 d63224c30b274b20857193901892de8e
msgid ""
"``smiles`` (string) (required) SMILES string to search for. Examples: "
"CC(=O)Oc1ccccc1C(=O)O (aspirin), Cn1c(=O)c2c(ncn2C)n(C)c1=O (caffeine), "
"c1ccccc1 (benzene)"
msgstr ""

#: ../../tools/zinc_tools.rst:191 e268ed80f6c248eca5cdbfcb563aff54
msgid "**ZINC_search_compounds** (Type: ZincTool)"
msgstr ""

#: ../../tools/zinc_tools.rst:193 562c7c7357cf4fe68510864440f2dc91
msgid ""
"Search the ZINC database for commercially available compounds by name or "
"keyword. Returns ZINC ID..."
msgstr ""

#: ../../tools/zinc_tools.rst 7dafd3ea02044a18b2fabb6e7aeaa370
msgid "ZINC_search_compounds tool specification"
msgstr ""

#: ../../tools/zinc_tools.rst:199 c6edf34a579f4fbe951315271552b8c3
msgid "**Name**: ``ZINC_search_compounds``"
msgstr ""

#: ../../tools/zinc_tools.rst:201 596e79565a354697bc8a1353d739269b
msgid ""
"**Description**: Search the ZINC database for commercially available "
"compounds by name or keyword. Returns ZINC IDs, SMILES structures, and "
"molecular properties (MW, LogP, HBD, HBA, rotatable bonds). ZINC contains"
" 750M+ purchasable compounds for virtual screening and drug discovery. "
"Optionally filter by purchasability tier (in-stock, for-sale, on-demand, "
"agent). Use this as the first step in a virtual screening workflow."
msgstr ""

#: ../../tools/zinc_tools.rst:208 71d105b4654e46778b53ecc74f547003
msgid ""
"``query`` (string) (required) Search query: drug name (aspirin, "
"ibuprofen, metformin), keyword, or partial name"
msgstr ""

#: ../../tools/zinc_tools.rst:211 ee3ab3a956364f57b3b736df6376d1ae
msgid ""
"``count`` (integer) (optional) Maximum number of results to return "
"(default: 10, max: 100)"
msgstr ""

#: ../../tools/zinc_tools.rst:214 7798f010656b4db59eb981b1c0d6d0db
msgid ""
