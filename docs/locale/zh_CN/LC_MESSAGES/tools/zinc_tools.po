msgid "**Name**: ``ZINC_search_by_properties``"
msgstr ""

#: ../../tools/zinc_tools.rst:105 a542edd9921e427195c365576c7dbd62
msgid ""
"**Description**: Filter ZINC compounds by molecular properties (Lipinski "
"Rule of Five, Veber rules). Specify ranges for molecular weight, LogP, "
"hydrogen bond donors/acceptors, and rotatable bonds. Optionally restrict "
"to a purchasability tier. Useful for finding drug-like compounds: "
"Lipinski (MW<500, LogP<5, HBD<5, HBA<10), fragment-like (MW<250, LogP<3),"
" or lead-like (MW 250-350, LogP 1-3)."
msgstr ""

#: ../../tools/zinc_tools.rst:112 6f389262d666429a8a38a449c4ca0e96
msgid ""
"``mwt_min`` (number, null) (optional) Minimum molecular weight in Da "
"(e.g., 150 for fragments, 250 for leads)"
msgstr ""

#: ../../tools/zinc_tools.rst:115 7085407348fa4e1ab08b06ac635b38e6
msgid ""
"``mwt_max`` (number, null) (optional) Maximum molecular weight in Da "
"(e.g., 500 for Lipinski, 250 for fragments)"
msgstr ""

#: ../../tools/zinc_tools.rst:118 167f5377a52b40d4a0c151fd2715a730
msgid ""
"``logp_min`` (number, null) (optional) Minimum LogP (e.g., -1 for "
"hydrophilic compounds)"
msgstr ""

#: ../../tools/zinc_tools.rst:121 cdffc967d2c04c0d9ba01453f1a1b1d1
msgid ""
"``logp_max`` (number, null) (optional) Maximum LogP (e.g., 5 for Lipinski"
" rule, 3 for lead-like)"
msgstr ""

#: ../../tools/zinc_tools.rst:124 4ae9801954f34985b071929303096388
msgid ""
"``hbd_max`` (integer, null) (optional) Maximum hydrogen bond donors "
"(e.g., 5 for Lipinski)"
msgstr ""

#: ../../tools/zinc_tools.rst:127 5faf4a0c52d0421796e8157ff1c49083
