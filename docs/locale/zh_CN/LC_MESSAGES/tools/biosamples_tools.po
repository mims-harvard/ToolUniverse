msgstr ""

#: ../../tools/biosamples_tools.rst:36 0ba09fda7ca9492f8cf97a9e0dc82009
msgid ""
"``accession`` (string) (required) BioSamples accession. Formats: SAMEA\\*"
" (EBI), SAMN\\* (NCBI), SAMD\\* (DDBJ). Examples: 'SAMEA104228123', "
"'SAMD00000603'."
msgstr ""

