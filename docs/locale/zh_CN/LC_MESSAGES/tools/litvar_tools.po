#: ../../tools/litvar_tools.rst:69 6eb524b664a44cf582bf143ca56a4ac0
msgid ""
"**Description**: Search for genetic variants in the NCBI LitVar2 database"
" by rsID, gene name, or HGVS notation. LitVar2 links genetic variants to "
"their mentions in PubMed literature. Returns variant identifiers, "
"associated gene names, HGVS nomenclature, publication counts, and "
"clinical significance when available. Useful for finding which variants "
"have been studied for a gene or identifying literature-linked variants by"
" rsID."
msgstr ""

#: ../../tools/litvar_tools.rst:73 9daf6183b4044623a4cd98da956ef587
msgid ""
"``query`` (string) (required) Search query: rsID (e.g., 'rs328', "
"'rs7903146'), gene name (e.g., 'BRCA1', 'TP53'), or HGVS notation (e.g., "
"'p.V600E')"
msgstr ""

