#: ../../tools/mgi_tools.rst 14b0f12651754eee94d879ae48e5aa5b
msgid "MGI_search_genes tool specification"
msgstr ""

#: ../../tools/mgi_tools.rst:98 d344f76b25744f3ea1ad4861df2495a1
msgid "**Name**: ``MGI_search_genes``"
msgstr ""

#: ../../tools/mgi_tools.rst:100 981a0d9f2e954210a7f8a8254cf214a1
msgid ""
"**Description**: Search for mouse (Mus musculus) genes in MGI (Mouse "
"Genome Informatics) by gene symbol, name, or keyword. Returns matching "
"mouse gene symbols, names, and MGI identifiers. Powered by the Alliance "
"of Genome Resources API which integrates MGI data. Use this to find mouse"
" gene IDs before calling MGI\\_get\\_gene or MGI\\_get\\_phenotypes. "
"Examples: 'Trp53' (tumor protein p53), 'Brca1', 'insulin', 'Notch'."
msgstr ""

#: ../../tools/mgi_tools.rst:104 358a0c4fe13641489b37bf8051606384
msgid ""
"``query`` (string) (required) Gene search query: mouse gene symbol (e.g.,"
" 'Trp53', 'Brca1', 'Sox9'), gene name keyword (e.g., 'insulin', 'tumor'),"
" or MGI ID (e.g., 'MGI:98834')."
msgstr ""

#: ../../tools/mgi_tools.rst:107 72b5af2863da45a58c7a6898486e6757
msgid ""
"``limit`` (integer) (optional) Maximum number of results to return "
"(default: 10, max: 50)."
msgstr ""

