msgstr ""

#: ../../tools/gprofiler_tools.rst:95 486564bde86f4d68a661e9a50baf97e3
msgid ""
"Perform functional enrichment analysis on a gene list using g:Profiler "
"(g:GOSt) from the Universi..."
msgstr ""

#: ../../tools/gprofiler_tools.rst 9ce493d2bf954c01a455a4cf8ef7b42e
msgid "gProfiler_enrichment tool specification"
msgstr ""

#: ../../tools/gprofiler_tools.rst:101 475935f3b790411b8aea99c850de6607
msgid "**Name**: ``gProfiler_enrichment``"
msgstr ""

#: ../../tools/gprofiler_tools.rst:103 9abf64aee6d74bacb6df5a8c0da674df
msgid ""
"**Description**: Perform functional enrichment analysis on a gene list "
"using g:Profiler (g:GOSt) from the University of Tartu. Identifies "
"statistically overrepresented biological functions, pathways, and "
"phenotypes in your gene list. Supports multiple data sources: Gene "
"Ontology (GO:BP, GO:MF, GO:CC), KEGG pathways, Reactome, WikiPathways, "
"Human Phenotype Ontology (HP), miRNA targets (MIRNA), CORUM protein "
"complexes, and Transcription Factor targets (TF). Returns enriched terms "
"with p-values (g:SCS multiple testing correction), term sizes, "
"intersection genes, precision, and recall. Input is a list of gene "
"symbols (e.g., ['TP53', 'BRCA1', 'EGFR', 'KRAS', 'PTEN']). Supports 500+ "
"organisms (use NCBI taxonomy prefix, e.g., 'hsapiens', 'mmusculus', "
"'dmelanogaster')."
msgstr ""

#: ../../tools/gprofiler_tools.rst:107 1abddd9ec30e4c06a738ce935ae382ed
msgid ""
"``gene_list`` (string) (required) Comma-separated list of gene symbols. "
"Examples: 'TP53,BRCA1,EGFR,KRAS,PTEN' or 'Trp53,Brca1,Egfr' (mouse)."
msgstr ""

#: ../../tools/gprofiler_tools.rst:110 fede9fe81ac84378bdc18e84c205e519
msgid ""
"``organism`` (string) (optional) Organism identifier. Default: "
"'hsapiens'. Examples: 'hsapiens' (human), 'mmusculus' (mouse), "
"'dmelanogaster' (fly), 'scerevisiae' (yeast), 'drerio' (zebrafish)."
msgstr ""

#: ../../tools/gprofiler_tools.rst:113 440b2549e0254b22b0a789d896115592
msgid ""
"``sources`` (string) (optional) Comma-separated data sources to query. "
"Default: 'GO:BP,GO:MF,GO:CC,KEGG,REAC,WP,HP'. Options: GO:BP, GO:MF, "
"GO:CC, KEGG, REAC, WP, MIRNA, HPA, CORUM, HP, TF."
msgstr ""

