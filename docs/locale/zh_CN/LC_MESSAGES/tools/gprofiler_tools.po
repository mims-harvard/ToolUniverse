#: 7c5430d90f2649edb14128349f387b15 f09c9d79f8dc49469ddf3dabd62abb6a
msgid "**Parameters:**"
msgstr ""

#: ../../tools/gprofiler_tools.rst:36 876dea69c9c64115a6adbf869a5211e5
msgid ""
"``snp_list`` (string) (required) Comma-separated list of SNP rsIDs. "
"Examples: 'rs11540652,rs429358,rs7903146' or 'rs1042779,rs6792369'. "
"Maximum ~200 SNPs per query."
msgstr ""

#: ../../tools/gprofiler_tools.rst:39 da0b34a094294e7bae954c8c37749826
msgid ""
"``organism`` (string) (optional) Organism identifier. Default: "
"'hsapiens'. Examples: 'hsapiens' (human), 'mmusculus' (mouse)."
msgstr ""

