msgid "**MedGen_search_conditions** (Type: MedGenTool)"
msgstr ""

#: ../../tools/medgen_tools.rst:96 ae42790f350e47db8ed1f22972d456b6
msgid ""
"Search NCBI MedGen for genetic conditions, diseases, or syndromes by "
"keyword. Returns condition n..."
msgstr ""

#: ../../tools/medgen_tools.rst dd7e709abf0c401c9a2d4cf4f65c9472
msgid "MedGen_search_conditions tool specification"
msgstr ""

#: ../../tools/medgen_tools.rst:102 ad188b3ee4e24f4db948b3e54406c0bd
msgid "**Name**: ``MedGen_search_conditions``"
msgstr ""

#: ../../tools/medgen_tools.rst:104 d3b8e0db3e4a4df29e12b6570b51b99f
msgid ""
"**Description**: Search NCBI MedGen for genetic conditions, diseases, or "
"syndromes by keyword. Returns condition names, definitions, OMIM IDs, and"
" associated genes. MedGen aggregates data from OMIM, Orphanet, ClinVar, "
"HPO, GTR, and GeneReviews. Example: query='cystic fibrosis' returns CF "
"entry with CFTR gene, OMIM 219700."
msgstr ""

#: ../../tools/medgen_tools.rst:108 b3c9533b41b042a2a47c6e068941ca03
msgid ""
"``query`` (string) (required) Search term (e.g., 'cystic fibrosis', "
"'BRCA1', 'Marfan syndrome', 'autosomal recessive')."
msgstr ""

#: ../../tools/medgen_tools.rst:111 a610b34e895a40fb93ec0aff99e2e65c
msgid ""
"``max_results`` (integer) (optional) Maximum number of results (default "
"10, max 50)."
msgstr ""

