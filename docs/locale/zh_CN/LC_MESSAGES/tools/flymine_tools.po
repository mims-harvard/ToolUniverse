#: ../../tools/flymine_tools.rst:32 780460ab0a0d482a9def6f61c5b74962
msgid ""
"**Description**: Search FlyMine, the InterMine data warehouse for "
"Drosophila melanogaster (fruit fly) genomics data from FlyBase. Searches "
"across genes, proteins, publications, protein domains, gene ontology "
"terms, and more. FlyMine integrates data from FlyBase, UniProt, Reactome,"
" KEGG, TreeFam, and other model organism databases. Returns matching "
"records with category facets and relevance scores. Use facet\\_Category "
"parameter to filter by entity type (e.g., 'Gene', 'Protein', "
"'Publication', 'ProteinDomain', 'CDNAClone', 'GOTerm', "
"'InteractionExperiment')."
msgstr ""

#: ../../tools/flymine_tools.rst:34 ../../tools/flymine_tools.rst:74
#: 1eeaf960c02a4e2095b3260069c478e7 6f4f311e5f9a47698db8f86eb9ed3d71
msgid "**Parameters:**"
msgstr ""

#: ../../tools/flymine_tools.rst:36 4a76db9b509a4f899304107e9b0f4aa8
msgid ""
"``q`` (string) (required) Search query: gene symbol (e.g., 'dpp', "
"'Notch', 'hedgehog'), protein name, domain name, or free text."
msgstr ""

#: ../../tools/flymine_tools.rst:39 378d606db6ce4817931fff208b0f553d
msgid ""
"``size`` (integer) (optional) Number of results to return (default: 10, "
"max: 100)."
msgstr ""

#: ../../tools/flymine_tools.rst:42 e231d9e4462f471cbe231c0c81f0638b
msgid "``format`` (string) (optional) Response format. Must be 'json'."
msgstr ""

#: ../../tools/flymine_tools.rst:45 d92a6e15f8924cdb8c5c40d02bc1d2c2
msgid ""
"``facet_Category`` (string) (optional) Filter by entity category. "
"Options: 'Gene', 'Protein', 'Publication', 'ProteinDomain', 'CDNAClone', "
"'GOTerm', 'InteractionExperiment', 'RNAiScreen', 'UniProtFeature'."
msgstr ""

