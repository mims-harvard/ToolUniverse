"(e.g., "
"'temperature\\_2m,precipitation,wind\\_speed\\_10m,relative\\_humidity\\_2m')"
msgstr ""

#: ../../tools/open_meteo_tools.rst:132 55568ad64202462dbff82bd319b97fe6
msgid ""
