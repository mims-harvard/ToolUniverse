#: ../../tools/open_meteo_tools.rst:162 a883cf4811de499a932585af8b193d01
msgid ""
"**Description**: Get current weather and forecasts for any location using"
" Open-Meteo (free, no API key needed). Returns current conditions and "
"hourly/daily forecasts up to 16 days. Essential for weather-aware "
"applications, research, and decision making. Supports 170+ weather "
"variables including temperature, precipitation, wind, humidity, UV index,"
" cloud cover, and more. Latitude/longitude required (use "
"OpenMeteo\\_geocode\\_location to get coordinates from city names). "
"Example: latitude=51.5, longitude=-0.12 for London."
msgstr ""

#: ../../tools/open_meteo_tools.rst:166 560b5d85441c44bcb7d8ef1c84543cb0
msgid ""
"``latitude`` (number) (required) Latitude in decimal degrees (e.g., 51.5 "
"for London, 40.7 for New York, 35.7 for Tokyo)"
msgstr ""

#: ../../tools/open_meteo_tools.rst:169 569d9a8cc8df4d0db2fcdaae02fb66e7
msgid ""
"``longitude`` (number) (required) Longitude in decimal degrees (e.g., "
"-0.12 for London, -74.0 for New York, 139.7 for Tokyo)"
msgstr ""

#: ../../tools/open_meteo_tools.rst:172 841a6c6ab5df431db6ee11738e5fe167
msgid ""
"``current`` (string, null) (optional) Comma-separated current weather "
"variables (e.g., "
"'temperature\\_2m,wind\\_speed\\_10m,precipitation,weather\\_code,relative\\_humidity\\_2m,surface\\_pressure')"
msgstr ""

#: ../../tools/open_meteo_tools.rst:175 171b6c14e70242ec8040461dda578eaa
msgid ""
"``daily`` (string, null) (optional) Comma-separated daily forecast "
"variables (e.g., "
"'temperature\\_2m\\_max,temperature\\_2m\\_min,precipitation\\_sum,wind\\_speed\\_10m\\_max,uv\\_index\\_max')"
msgstr ""

#: ../../tools/open_meteo_tools.rst:178 ffc1fe698fd74ba1a115eba0d63ca63d
msgid ""
"``hourly`` (string, null) (optional) Comma-separated hourly variables "
"(e.g., "
"'temperature\\_2m,precipitation\\_probability,wind\\_speed\\_10m,relative\\_humidity\\_2m')"
msgstr ""

#: ../../tools/open_meteo_tools.rst:181 9c6e618a323b41f8bbc8247a523ec092
msgid ""
"``forecast_days`` (integer, null) (optional) Number of forecast days "
"(1-16, default 7)"
msgstr ""

#: ../../tools/open_meteo_tools.rst:184 002527ae3ea947b9a9e83f4abb8db4ad
