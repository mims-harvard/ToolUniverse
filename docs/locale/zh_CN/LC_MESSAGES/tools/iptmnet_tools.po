#: ../../tools/iptmnet_tools.rst:141 771b9e86049f459fb29d996af6873bd3
msgid "**Name**: ``iPTMnet_search``"
msgstr ""

#: ../../tools/iptmnet_tools.rst:143 03c1769b6e2a499a8ef9ec9819724f49
msgid ""
"**Description**: Search the iPTMnet database for proteins with post-"
"translational modification (PTM) data. Find proteins by gene name, "
"protein name, or keyword. Filter by role (Substrate = modified protein, "
"Enzyme = modifier) and PTM type (Phosphorylation, Acetylation, "
"Ubiquitination, Methylation, etc.). iPTMnet integrates data from "
"PhosphoSitePlus, UniProt, PRO ontology, and text mining. Returns UniProt "
"IDs, PTM site counts, enzyme/substrate roles, and isoform counts."
msgstr ""

#: ../../tools/iptmnet_tools.rst:147 38b5e19b8ac34fc5ae44880382c8ba67
msgid "``operation`` (string) (optional) Operation type"
msgstr ""

#: ../../tools/iptmnet_tools.rst:150 507627ef1e00480eb9bee144a741cebd
msgid ""
"``search_term`` (string) (optional) Search query: gene name (TP53, EGFR, "
"AKT1), protein name (p53, insulin receptor), or keyword (kinase, "
"ubiquitin)"
msgstr ""

#: ../../tools/iptmnet_tools.rst:153 688d49efecc048679744bf97fd06e0b3
msgid ""
"``role`` (string) (optional) Filter by protein role. Substrate = proteins"
" that are modified; Enzyme = proteins that modify others. Default: "
"Substrate"
msgstr ""

#: ../../tools/iptmnet_tools.rst:156 6034fa11c2a847239822cf22a1eae2a0
msgid ""
"``ptm_type`` (string, null) (optional) Filter by PTM type: "
"Phosphorylation, Acetylation, Ubiquitination, Methylation, Sumoylation, "
"N-Glycosylation, O-Glycosylation, S-Nitrosylation, etc. Case-sensitive. "
"Omit to return all types."
msgstr ""

#: ../../tools/iptmnet_tools.rst:159 1d5fe10d5ed240ebaf8182463a2cd5d6
msgid ""
"``term_type`` (string) (optional) Type of search term. Default: All "
"(searches across all fields)"
msgstr ""

#: ../../tools/iptmnet_tools.rst:162 c5b5b316a4aa48539158a582a95b0459
msgid ""
"``max_results`` (integer) (optional) Maximum results to return (default: "
"25)"
msgstr ""

#: ../../tools/iptmnet_tools.rst:165 99c55e3b3ca34aa9abaf7ec6b7875910
msgid ""
"``query`` (string) (optional) Gene name, protein name, or keyword to "
"search (alias for search\\_term)"
msgstr ""

