#: ../../tools/oncotree_tools.rst:36 d22994cb8aaa427b9e6d90b2b9d7135c
msgid ""
"``code`` (string) (required) OncoTree cancer type code (case-"
"insensitive). Examples: 'BRCA' (Invasive Breast Carcinoma), 'LUAD' (Lung "
"Adenocarcinoma), 'GBM' (Glioblastoma Multiforme), 'PAAD' (Pancreatic "
"Adenocarcinoma)."
msgstr ""

