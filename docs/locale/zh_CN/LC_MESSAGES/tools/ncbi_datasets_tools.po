#: ../../tools/ncbi_datasets_tools.rst:63 14a8874de3574b26a692b854ff97b6a3
msgid ""
"**Description**: Look up gene information by gene symbol and organism. "
"Searches NCBI Gene database using official gene symbols. Specify the "
"taxon as common name (human, mouse, rat) or taxonomy ID. Returns gene ID,"
" description, chromosomal location, and database cross-references."
msgstr ""

#: ../../tools/ncbi_datasets_tools.rst:67 14f5b0904ebf4602bf1c7a30aace5622
msgid ""
"``symbol`` (string) (required) Gene symbol. Examples: 'TP53', 'BRCA1', "
"'INS', 'EGFR'."
msgstr ""

#: ../../tools/ncbi_datasets_tools.rst:70 ecdcc5d5a1244e94a5d31123254d489f
msgid ""
"``taxon`` (string) (optional) Organism as common name or taxonomy ID. "
"Examples: 'human', 'mouse', 'rat', '9606', '10090'. Default: 'human'."
msgstr ""

#: ../../tools/ncbi_datasets_tools.rst:87 1c7724e0800741509e4dedae8fa39632
msgid "**NCBIDatasets_get_orthologs** (Type: NCBIDatasetsTool)"
