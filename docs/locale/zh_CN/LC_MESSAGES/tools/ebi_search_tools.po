#: ../../tools/ebi_search_tools.rst:259 0b6496a432b9482e98b5ce8668dd91ed
msgid ""
"**Description**: Search EBI domain with faceted filtering and returns "
"facet information. Use facetcount to request facets (returned "
"automatically). To filter results BY facet values, use the 'facets' "
"parameter with format 'FACET\\_NAME:value' (e.g., 'TAXONOMY:9606' for "
"human). First run ebi\\_search\\_domain to see available facet IDs in the"
" response, or use ebi\\_get\\_domain\\_info. Returns search results with "
"facet categories for advanced filtering."
msgstr ""

#: ../../tools/ebi_search_tools.rst:263 787fe0a780ba4e73b3821b1d38cbec97
msgid ""
"``domain`` (string) (required) EBI domain to search (e.g., 'ensembl', "
"'uniprot', 'interpro')"
msgstr ""

#: ../../tools/ebi_search_tools.rst:266 bed3bf5c2bde4f8c9c395160f24628a0
msgid "``query`` (string) (required) Search query string"
msgstr ""

#: ../../tools/ebi_search_tools.rst:269 31cd0a1865ae4f8983170c47a2a4ba8c
msgid ""
"``facets`` (string) (optional) Optional filter for results using facet "
"values in format 'FACET\\_NAME:value' (e.g., 'TAXONOMY:9606' for human, "
"'keyword\\_id:KW-0418' for kinase). Multiple filters can be comma-"
"separated. IMPORTANT: This is for FILTERING results, not selecting which "
"facets to return. Facets are returned automatically when facetcount > 0."
msgstr ""

#: ../../tools/ebi_search_tools.rst:272 747e9bacb3fa465792cb40cba1b8af81
msgid ""
"``facetcount`` (integer) (optional) Number of facet values to return per "
"facet category (default: 10). Set to 0 to disable facet return."
msgstr ""

#: ../../tools/ebi_search_tools.rst:275 08d5d3f5fc5c444b8179458cc29435ad
msgid "``size`` (integer) (optional) Number of results to return (default: 10)"
msgstr ""

