#: ../../tools/brenda_tools.rst:68 1f1f89653ade4ab0be96f06d917e8861
msgid ""
"**Description**: Get comprehensive enzyme kinetic parameters WITHOUT "
"requiring BRENDA credentials. Retrieves enzyme identity (name, catalytic "
"activity, alternative names) from ExPASy ENZYME and kinetic parameters "
"(Km, kcat, Ki, Vmax, kcat/Km) from SABIO-RK. If BRENDA credentials are "
"set (BRENDA\\_EMAIL, BRENDA\\_PASSWORD), additionally fetches optimal pH,"
" optimal temperature, and specific activity from BRENDA. Accepts EC "
"number (e.g., 1.1.1.1) or enzyme name (e.g., alcohol dehydrogenase). "
"Returns aggregated summary statistics across all reported values plus "
"individual measurements with substrate specificity and organism "
"information."
msgstr ""

#: ../../tools/brenda_tools.rst:72 e104394214194c6a9b7a3f071166ba20
msgid ""
"``operation`` (string) (optional) Operation type (fixed: "
"get\\_enzyme\\_kinetics)"
msgstr ""

#: ../../tools/brenda_tools.rst:75 81dc4415cecf45feb92ea44d209a7036
msgid ""
"``ec_number`` (string) (optional) EC number (e.g., 1.1.1.1 for alcohol "
"dehydrogenase, 2.7.1.1 for hexokinase, 3.4.21.5 for thrombin)"
msgstr ""

#: ../../tools/brenda_tools.rst:78 6e8b0d0b5ac54b4ab38be43980a047f3
msgid ""
"``enzyme_name`` (string) (optional) Enzyme common name. Will be resolved "
"to EC number via UniProt. Examples: alcohol dehydrogenase, hexokinase, "
"lactate dehydrogenase, thrombin"
msgstr ""

#: ../../tools/brenda_tools.rst:81 4abb197dd56f4fb087a1b131cbf0dcd5
