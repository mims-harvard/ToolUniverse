#: ../../tools/proteinsplus_tools.rst:166
#: ../../tools/proteinsplus_tools.rst:212 594d9fa6775844d18a256a288e21bbd9
#: 99b86cbbce77416cb321a4755b5381fb 9cef9e5821564d968c0e8f17a4f92f21
#: d02e3b4f1a4547d39bc0d71863be8fae
msgid ""
"``pdb_id`` (string) (required) PDB identifier (e.g., '1KZK', '2OZR', "
"'4HHB'). Required."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:39 543e84d03be84d8bb110a60fbe7d8d43
msgid ""
"``mode`` (string) (required) Analysis mode: 'flexibility\\_analysis' "
"(compare protein conformations), 'docking' (prepare ensemble for "
"docking), 'screening' (find similar binding sites for virtual screening),"
" 'mutation\\_analysis' (assess mutation tolerance), or "
"'ligand\\_pose\\_comparison' (compare binding poses). Required. Example: "
"Use 'screening' for hit discovery across protein families."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:42 13c55f86bd27484e8013fb70d87d55f4
msgid ""
"``ligand`` (string) (optional) Ligand identifier in format "
"'residue\\_name\\_residue\\_chain\\_residue\\_number' (e.g., "
"'JE2\\_A\\_701'). Mutually exclusive with pocket."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:45 18cf60f5cd6f421085ead7bc72a3c4bb
msgid ""
"``pocket`` (string) (optional) Pocket definition for analysis "
"(alternative to ligand). Example: Define custom pocket region. Mutually "
"exclusive with ligand."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:48 e031f6ed047c48f09e45fe426c4eaedb
msgid ""
"``fragment_length`` (integer) (optional) Fragment length for analysis "
"(3-15). Default: 9. Longer fragments = more specific matching. Example: "
"Use 12 for strict similarity."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:51 9fe4df4ddc794a3cb33773fff9cefa40
msgid ""
"``flexibility_sensitivity`` (number) (optional) Sensitivity for "
"flexibility detection (0.0-1.0). Default: 0.5. Higher = more flexible "
"regions detected. Example: Use 0.7 for highly dynamic proteins."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:54 7432f3c08c62465aa90554829ff36948
msgid ""
"``site_radius`` (number) (optional) Radius around ligand to define "
"binding site (3-15 Angstroms). Requires ligand. Default: 6.5. Example: "
"Use 8.0 for larger binding sites."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:57 761652f700a643f9ac99ed16175dabcd
msgid ""
"``minimal_site_identity`` (number) (optional) Minimum binding site "
"sequence identity threshold (0.3-1.0). Default: 0.6. Higher = stricter "
"matching. Example: Use 0.8 for closely related proteins."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:60 8c566bda78fa4c66b0ca36fdca7c2b98
msgid ""
"``minimal_site_coverage`` (number) (optional) Minimum binding site "
"coverage required (0.3-1.0). Default: 0.8. Higher = more complete binding"
" site overlap required. Example: Use 0.9 for stringent matches."
msgstr ""

#: ../../tools/proteinsplus_tools.rst:63 4d54ecb64113466fa9f70489a1192f39
msgid ""
"``maximum_mutations`` (integer) (optional) Maximum number of mutations "
"allowed in mutation analysis mode (0-10). Default: 3. Example: Use 5 for "
"permissive mutation screening."
msgstr ""

