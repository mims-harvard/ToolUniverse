#: ../../tools/wikidata_entity_tools.rst:67 669c735e498446008ddd5b86f889cb98
msgid "**Name**: ``Wikidata_search_entities``"
msgstr ""

#: ../../tools/wikidata_entity_tools.rst:69 a6a40f416fd64c8c94a9483710273fb4
msgid ""
"**Description**: Search Wikidata for entities (items, properties, or "
"lexemes) by label or description using the MediaWiki Wikibase API. "
"Wikidata is the world's largest open knowledge graph with 100M+ data "
"items. Returns entity IDs (Q-numbers), labels, descriptions, and aliases."
" Complementary to Wikidata\\_SPARQL\\_query for finding entity IDs before"
" constructing SPARQL queries."
msgstr ""

#: ../../tools/wikidata_entity_tools.rst:73 a6aada4bc4ee49b2a3beff29553229ab
msgid ""
"``search`` (string) (required) Search term to find Wikidata entities. "
"Examples: 'CRISPR', 'Albert Einstein', 'HIV', 'perovskite', 'insulin'"
msgstr ""

#: ../../tools/wikidata_entity_tools.rst:76 0c07c79519de483f909b1be8763743b5
msgid ""
"``language`` (string, null) (optional) Language code for search and "
"results. Default: 'en'. Examples: 'fr', 'de', 'zh', 'ja', 'es'"
msgstr ""

#: ../../tools/wikidata_entity_tools.rst:79 75f4341b431a4ebcbcf106fc736055c0
msgid ""
"``type`` (string, null) (optional) Entity type to search. Values: 'item' "
"(Q-numbers, default), 'property' (P-numbers), 'lexeme' (L-numbers)"
msgstr ""

#: ../../tools/wikidata_entity_tools.rst:82 0c59eb5bb3ef43d482eaa64689d3b5bb
msgid ""
"``limit`` (integer, null) (optional) Number of results to return (default"
" 7, max 50)"
msgstr ""

