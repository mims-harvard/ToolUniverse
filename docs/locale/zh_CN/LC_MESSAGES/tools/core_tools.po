msgstr "**参数：**"

#: ../../tools/core_tools.rst:36 a7ae30d24df04d1ab0dcbec54d3404e6
msgid ""
"``pdf_url`` (string) (optional) Direct PDF URL to download (preferred). "
"CORE\\_search\\_papers returns this as the \\`url\\` field in many "
"results."
msgstr ""

#: ../../tools/core_tools.rst:39 8f76e8a5b4c54743827be25ad31e7573
msgid ""
"``url`` (string) (optional) Alias for \\`pdf\\_url\\` for convenience "
"when piping CORE\\_search\\_papers outputs."
msgstr ""

#: ../../tools/core_tools.rst:42 b8d6576972354d0e9611ec55d4cf8160
msgid ""
"``terms`` (array) (required) Terms to search for in the extracted PDF "
"text (case-insensitive)."
msgstr ""

#: ../../tools/core_tools.rst:45 0f012d9c7a624d40ac17cf3997206271
msgid ""
"``window_chars`` (integer) (optional) Context window size (characters) "
"before and after each match."
msgstr ""

#: ../../tools/core_tools.rst:48 ff89d9d2246a46d1a51ca3564d3143a6
msgid ""
"``max_snippets_per_term`` (integer) (optional) Maximum number of snippets"
" returned per term."
msgstr ""

#: ../../tools/core_tools.rst:51 b080d80319454b22a35393179ae26fee
msgid ""
"``max_total_chars`` (integer) (optional) Hard cap on total characters "
"returned across all snippets."
msgstr ""

#: ../../tools/core_tools.rst:54 4b59ddef57064c399754c8eddccbf011
msgid ""
"``extractor`` (string) (optional) PDF text extraction backend: auto "
