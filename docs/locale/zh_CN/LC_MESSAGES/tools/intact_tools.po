#: ../../tools/intact_tools.rst:100 db7ee90db3b744bd8a317ae5c0804991
msgid ""
"**Description**: Get interaction network centered on a specific "
"interactor. Uses EBI Search API (IntAct domain) for reliable access. "
"Accepts IntAct identifiers (e.g., 'EBI-1004115'), UniProt IDs (e.g., "
"'P04637'), or gene names (e.g., 'BRCA1'). Returns interactions with "
"interaction IDs in the 'interaction\\_ids' field. These IDs can be used "
"with intact\\_get\\_interaction\\_details for detailed information."
msgstr ""

#: ../../tools/intact_tools.rst:104 569e164ab06c453580b46e79c20b1da6
msgid ""
"``identifier`` (string) (optional) IntAct identifier, UniProt ID, or gene"
" name. Aliases: uniprot\\_id, protein\\_id, gene\\_symbol, gene\\_name."
msgstr ""

#: ../../tools/intact_tools.rst:107 cef626ed92df48f99259bc5fd56d1d46
msgid ""
"``uniprot_id`` (string) (optional) Alias for identifier: UniProt "
"accession (e.g., 'P04637')."
msgstr ""

#: ../../tools/intact_tools.rst:110 3377ff6b24704f839cb4967459f6268d
msgid ""
"``protein_id`` (string) (optional) Alias for identifier: protein "
"identifier."
msgstr ""

#: ../../tools/intact_tools.rst:113 4b8effed92a4471192f670786bd48170
msgid ""
"``gene_symbol`` (string) (optional) Alias for identifier: gene symbol "
"(e.g., 'BRCA1')."
msgstr ""

#: ../../tools/intact_tools.rst:116 a6bdcbf6067742259e1761ecddebd7ce
msgid "``gene_name`` (string) (optional) Alias for identifier: gene name."
msgstr ""

#: ../../tools/intact_tools.rst:119 a15dc64003954015b31ea17b08c17b1d
msgid ""
"``depth`` (integer) (optional) Network depth: 1 for direct interactions "
"only, 2 for 2-hop network, etc. (default: 1)"
msgstr ""

