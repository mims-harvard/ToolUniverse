#: ../../tools/hgnc_tools.rst:63 892453e6c3c44e3bbf5fa8a631be938c
msgid ""
"**Description**: Fetch detailed gene information from HGNC (HUGO Gene "
"Nomenclature Committee) by official gene symbol. Returns comprehensive "
"gene data including HGNC ID, full name, chromosomal location, cross-"
"references to Ensembl, NCBI Entrez, UniProt, OMIM, and RefSeq. HGNC is "
"the authoritative source for human gene nomenclature. Example: 'TP53' "
"returns tumor protein p53 with all its identifiers."
msgstr ""

#: ../../tools/hgnc_tools.rst:67 a45779ed80f14081ba6a4e8cce7d68da
msgid ""
"``symbol`` (string) (required) Official HGNC gene symbol. Examples: "
"'TP53', 'BRCA1', 'EGFR', 'INS', 'ACE2'."
msgstr ""

#: ../../tools/hgnc_tools.rst:84 b8f9abd4a0444de6afe805b1ae386fe8
msgid "**HGNC_search_by_location** (Type: HGNCTool)"
msgstr ""

#: ../../tools/hgnc_tools.rst:86 8b50c9dadf4a4c60bc83910a8af2afc3
msgid ""
"Search HGNC for genes at a specific chromosomal location. Returns all "
"genes mapped to that cytoge..."
msgstr ""

#: ../../tools/hgnc_tools.rst df54155cc5f2436d823234f4afa34b78
msgid "HGNC_search_by_location tool specification"
msgstr ""

#: ../../tools/hgnc_tools.rst:92 f67ff03beeff49699374debbdc27c3e4
msgid "**Name**: ``HGNC_search_by_location``"
msgstr ""

#: ../../tools/hgnc_tools.rst:94 30b4e5e9c2d648788cdb64cc47d479ef
msgid ""
"**Description**: Search HGNC for genes at a specific chromosomal "
"location. Returns all genes mapped to that cytogenetic band. Useful for "
"identifying genes in a chromosomal region of interest. Example: '17p13.1'"
" returns genes including TP53."
msgstr ""

#: ../../tools/hgnc_tools.rst:98 61ca44eaa0ce4daeadc4abb450144be6
msgid ""
"``location`` (string) (required) Cytogenetic band location. Examples: "
"'17p13.1' (TP53 region), '17q21.31' (BRCA1 region), '7p11.2' (EGFR "
"region), '13q14.2' (RB1 region)."
msgstr ""

