#: ../../tools/scxa_tools.rst:32 6830ddc5b22f4eef9460e1c343bdb3c0
msgid ""
"**Description**: List single-cell RNA-seq experiments from EBI Single "
"Cell Expression Atlas. Returns 380+ curated scRNA-seq datasets with "
"species, cell counts, technology (10x, Smart-seq2, Drop-seq), and "
"experimental factors (cell type, tissue, disease). Filter by species or "
"keyword. Covers Human Cell Atlas, GTEx, Tabula Sapiens, and more. "
"Example: filtering by 'Homo sapiens' returns 159 experiments."
msgstr ""

#: ../../tools/scxa_tools.rst:34 ../../tools/scxa_tools.rst:70
#: 1c67b6f9b2e3494d8a33106255ccf99e 55e488eb085b4419a9ecfd654b231595
msgid "**Parameters:**"
msgstr ""

#: ../../tools/scxa_tools.rst:36 8aac4deb099a4491a9179b140eff2ab2
msgid ""
"``species`` (string) (optional) Species name to filter by (e.g., 'Homo "
"sapiens', 'Mus musculus', 'Drosophila melanogaster'). Case-insensitive."
msgstr ""

#: ../../tools/scxa_tools.rst:39 e2dffecc0c2749e2ae0579282e4b2fbd
msgid ""
"``keyword`` (string) (optional) Keyword to search in experiment "
"descriptions and factors (e.g., 'pancreas', 'brain', 'cancer', 'immune')."
msgstr ""

#: ../../tools/scxa_tools.rst:42 be40ace2ce744c8984f8a360530dc6bd
msgid ""
"``limit`` (integer) (optional) Maximum number of experiments to return "
"(default 20, max 100)."
msgstr ""

