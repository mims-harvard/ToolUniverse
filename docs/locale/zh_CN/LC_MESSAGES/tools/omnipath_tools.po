#: ../../tools/omnipath_tools.rst:171 d4d1edf882a8440d902e06b29e710f20
msgid ""
"Get intercellular communication roles for proteins from OmniPath. "
"Classifies proteins as ligands,..."
msgstr ""

#: ../../tools/omnipath_tools.rst 7721ad6ecf554a779c80bcf717d56eaf
msgid "OmniPath_get_intercell_roles tool specification"
msgstr ""

#: ../../tools/omnipath_tools.rst:177 629fa5e901054ddc9f74788ba4951038
msgid "**Name**: ``OmniPath_get_intercell_roles``"
msgstr ""

#: ../../tools/omnipath_tools.rst:179 4f03f8efd1334fc5b9f780b3c8386424
msgid ""
"**Description**: Get intercellular communication roles for proteins from "
"OmniPath. Classifies proteins as ligands, receptors, transmembrane "
"proteins, secreted factors, or extracellular matrix components based on "
"evidence from 40+ databases. Returns functional categories "
"(ligand/receptor/adhesion/transporter), locational annotations "
"(secreted/transmembrane/peripheral), consensus scores, and supporting "
"databases. Critical for identifying which genes act as senders vs "
"receivers in cell-cell communication. Example: querying EGFR shows it is "
"classified as 'receptor' by 10 databases with consensus\\_score 7, "
"plasma\\_membrane\\_transmembrane=true; querying TGFB1 shows it is a "
"'ligand' (secreted=true, transmitter=true)."
msgstr ""

#: ../../tools/omnipath_tools.rst:183 9ee3de9ac5624cb7b338a5953da8ecf1
msgid ""
"``proteins`` (string, null) (optional) Gene symbol(s) or UniProt ID(s), "
"comma-separated. Examples: 'EGFR', 'TGFB1,PDCD1', 'P00533,P01137'."
msgstr ""

#: ../../tools/omnipath_tools.rst:186 7e8c3208938c4465af03304c0a24f23e
msgid ""
"``categories`` (string, null) (optional) Filter by intercellular role "
"category. Examples: 'ligand', 'receptor', 'adhesion', 'transporter', "
"'ecm', 'transmembrane'. Comma-separated for multiple."
msgstr ""

#: ../../tools/omnipath_tools.rst:189 ac1b162a6cae479fa894c0cf56d8e202
msgid ""
"``scope`` (string, null) (optional) Filter by annotation scope: 'generic'"
" (general role) or 'specific' (cell-type specific). Default: all."
msgstr ""

#: ../../tools/omnipath_tools.rst:192 74928ad7aee04d9da62534d764cec8ee
msgid ""
"``transmitter`` (boolean, null) (optional) Filter for transmitter/sender "
"proteins (true) or non-transmitters (false)."
msgstr ""

#: ../../tools/omnipath_tools.rst:195 2c6c7959f3584c78b81010f7721865a3
msgid ""
"``receiver`` (boolean, null) (optional) Filter for receiver proteins "
"(true) or non-receivers (false)."
msgstr ""

#: ../../tools/omnipath_tools.rst:198 c193bc050a654deb8af97a2e5dcf5cbd
msgid ""
"``secreted`` (boolean, null) (optional) Filter for secreted proteins "
"(true) or non-secreted (false)."
msgstr ""

#: ../../tools/omnipath_tools.rst:201 40045c3b12524cfd86ff7ca493d7d2c1
msgid ""
"``limit`` (integer, null) (optional) Maximum number of results to return."
" Default: no limit."
msgstr ""

