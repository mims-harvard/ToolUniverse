#: ../../tools/pfam_tools.rst d25b320e9aa84074b9d6a4f949009796
msgid "Pfam_get_family_proteins tool specification"
msgstr ""

#: ../../tools/pfam_tools.rst:61 fad5bf9cea654f3cbe8a3e11e77192cb
msgid "**Name**: ``Pfam_get_family_proteins``"
msgstr ""

#: ../../tools/pfam_tools.rst:63 26bb7a48756940f7bb15c94a94353b19
msgid ""
"**Description**: Get proteins containing a specific Pfam domain, "
"optionally filtered by species. Returns protein accessions, names, gene "
"names, lengths, organisms, and exact domain positions (start/end "
"residues). Can filter to SwissProt-reviewed proteins only and/or specific"
" species by NCBI taxonomy ID. For example, PF00001 (7tm\\_1 GPCR domain) "
"has 289 human reviewed proteins including GPCRs like chemokine receptors,"
" olfactory receptors, and serotonin receptors. PF00076 (RRM\\_1) has 199 "
"human reviewed proteins. Use this to find which proteins in a species "
"contain a specific domain."
msgstr ""

#: ../../tools/pfam_tools.rst:67 950596654ceb4e18b53ee3d29633ef70
msgid ""
"``pfam_accession`` (string) (required) Pfam family accession. Examples: "
"'PF00001' (7tm\\_1 GPCR), 'PF00076' (RRM\\_1), 'PF00069' (Pkinase), "
"'PF00125' (Core histone)."
msgstr ""

#: ../../tools/pfam_tools.rst:70 4145ef82af9a441d920d19e34f0971fb
msgid ""
"``max_results`` (integer) (optional) Maximum number of proteins to return"
" (default 20, max 100)."
msgstr ""

#: ../../tools/pfam_tools.rst:73 6008cd54ea694a9e8279a7c1cf61ad8c
msgid ""
"``reviewed_only`` (boolean) (optional) If true (default), return only "
"SwissProt-reviewed proteins. Set false for all UniProt proteins."
msgstr ""

#: ../../tools/pfam_tools.rst:76 43f64cdf08c942b6b9f0ef2442435694
msgid ""
"``tax_id`` (string, null) (optional) NCBI taxonomy ID to filter by "
"species. Examples: '9606' (human), '10090' (mouse), '7227' (Drosophila), "
"'559292' (S. cerevisiae)."
msgstr ""

#: ../../tools/pfam_tools.rst:93 783430bd87a544bf866e078a99ebc411
msgid "**Pfam_get_family_proteomes** (Type: PfamTool)"
msgstr ""

#: ../../tools/pfam_tools.rst:95 2b67dfea196c4a6dbf93873f2f976141
msgid ""
"Get the proteome (organism) distribution for a Pfam protein family. "
"Returns the list of reference..."
msgstr ""

#: ../../tools/pfam_tools.rst a6ad630dff584411a866501079cee392
msgid "Pfam_get_family_proteomes tool specification"
msgstr ""

#: ../../tools/pfam_tools.rst:101 4a039b9b015d474d9f8225a5a7156b56
msgid "**Name**: ``Pfam_get_family_proteomes``"
msgstr ""

#: ../../tools/pfam_tools.rst:103 dd03bdd656c24e7987f4287dc2786137
msgid ""
"**Description**: Get the proteome (organism) distribution for a Pfam "
"protein family. Returns the list of reference proteomes that contain "
"proteins with this Pfam domain, including organism names, taxonomy IDs, "
"and whether the proteome is a reference proteome. This reveals the "
"taxonomic distribution of a domain across the tree of life. For example, "
"PF00001 (7tm\\_1 GPCR) is found in 1,890 proteomes spanning from early-"
"diverging animals to humans, while PF00076 (RRM\\_1 RNA recognition "
"motif) is in 6,831 proteomes. Use this to understand the evolutionary "
"spread of a protein domain."
msgstr ""

#: ../../tools/pfam_tools.rst:107 30bbc0b83cbb42919b8a875588fcc11c
msgid ""
"``pfam_accession`` (string) (required) Pfam family accession. Examples: "
"'PF00001' (7tm\\_1, found in 1890 proteomes), 'PF00076' (RRM\\_1, 6831 "
"proteomes), 'PF00069' (Pkinase)."
msgstr ""

#: ../../tools/pfam_tools.rst:110 a27b9b3f33f948368b9acf9889cf703d
msgid ""
"``max_results`` (integer) (optional) Maximum number of proteomes to "
"return (default 20, max 100)."
msgstr ""

#: ../../tools/pfam_tools.rst:127 f33ee358b9bb4fab8860a831d9d1b709
msgid "**Pfam_get_protein_annotations** (Type: PfamTool)"
msgstr ""

#: ../../tools/pfam_tools.rst:129 918ba4fe500346679032b09698da4bc7
msgid ""
"Get all Pfam domain annotations for a specific protein by its UniProt "
"accession. Returns every Pf..."
msgstr ""

#: ../../tools/pfam_tools.rst 4f078f7129664703bc57f16a084c5a43
msgid "Pfam_get_protein_annotations tool specification"
msgstr ""

#: ../../tools/pfam_tools.rst:135 679b5d5e334b411d94d4d1be21e0f991
msgid "**Name**: ``Pfam_get_protein_annotations``"
msgstr ""

#: ../../tools/pfam_tools.rst:137 bfe449d425ac40e98384bef3455fd838
msgid ""
"**Description**: Get all Pfam domain annotations for a specific protein "
"by its UniProt accession. Returns every Pfam domain found in the protein "
"with exact start/end residue positions, E-values (scores), short names, "
"and integrated InterPro entries. This provides the complete Pfam domain "
"architecture of a protein. For example, P04637 (TP53) has 4 Pfam domains:"
" PF08563 (P53\\_TAD, 6-30), PF18521 (P53\\_TAD2, 35-59), PF00870 (P53, "
"100-288), PF07710 (P53\\_tetramer, 319-357). Use this to understand the "
"domain composition of any protein."
msgstr ""

#: ../../tools/pfam_tools.rst:141 0c4e18885033436c95d77aa99efdb128
msgid ""
"``accession`` (string) (required) UniProt protein accession. Examples: "
"'P04637' (TP53, 4 domains), 'P00533' (EGFR), 'P68431' (Histone H3.1), "
"'P38398' (BRCA1), 'P01308' (Insulin)."
msgstr ""

#: ../../tools/pfam_tools.rst:158 81a07764065f4629af64be2f59595301
msgid "**Pfam_search_clans** (Type: PfamTool)"
msgstr ""

#: ../../tools/pfam_tools.rst:160 140cfd968e164863bb4cd475471322fe
msgid ""
"Search and list Pfam clans (superfamilies) by keyword. Pfam clans group "
"together related Pfam fam..."
msgstr ""

#: ../../tools/pfam_tools.rst 524f1cb346a841f6be2cd785a50c0611
msgid "Pfam_search_clans tool specification"
msgstr ""

#: ../../tools/pfam_tools.rst:166 49579ec9714d4c5f9ddcee627ef9162c
msgid "**Name**: ``Pfam_search_clans``"
msgstr ""

#: ../../tools/pfam_tools.rst:168 91ea7040c12c4d17a54ab59ea3bdcfe1
msgid ""
"**Description**: Search and list Pfam clans (superfamilies) by keyword. "
"Pfam clans group together related Pfam families that share a common "
"evolutionary origin but may have diverged beyond simple sequence "
"similarity. There are 812 Pfam clans covering major protein "
"superfamilies. For example, CL0016 (PKinase) groups 30+ kinase domain "
"families, CL0001 (EGF) groups EGF-like domain families, CL0221 (RRM) "
"groups RNA recognition motif families. Use this to explore protein "
"superfamily relationships. If no query is given, returns a general "
"listing of clans."
msgstr ""

#: ../../tools/pfam_tools.rst:172 615d127d770f405f9c06c33e20234755
msgid ""
"``query`` (string) (optional) Search keyword for clan name. Examples: "
"'kinase', 'EGF', 'RRM', 'immunoglobulin'. Leave empty to list all clans."
msgstr ""

#: ../../tools/pfam_tools.rst:175 5aec56e741634fd498c86157378d4322
msgid ""
"``max_results`` (integer) (optional) Maximum number of clans to return "
"(default 20, max 100)."
msgstr ""

#: ../../tools/pfam_tools.rst:191 7c772b8b8fe24f45907ec6bb983cf9ad
msgid "**Pfam_search_families** (Type: PfamTool)"
msgstr ""

#: ../../tools/pfam_tools.rst:193 071be6de46eb4be5aea592d40e3a5def
msgid ""
"Search for Pfam protein family entries by keyword using the InterPro API."
" Pfam is the authoritati..."
msgstr ""

#: ../../tools/pfam_tools.rst bfe2b3a677674e409dc106bf616db87d
msgid "Pfam_search_families tool specification"
msgstr ""

#: ../../tools/pfam_tools.rst:199 98f9f7dc8c404e92965902167c130c7b
msgid "**Name**: ``Pfam_search_families``"
msgstr ""

#: ../../tools/pfam_tools.rst:201 28929b6eb4ea4984b7525ff1975388bc
msgid ""
"**Description**: Search for Pfam protein family entries by keyword using "
"the InterPro API. Pfam is the authoritative database of protein families,"
" domains, and functional sites. Returns matching Pfam family accessions, "
"names, types (domain, family, repeat, etc.), and integrated InterPro "
"entries. There are over 20,000 Pfam families covering protein domains "
"like kinases (PF00069), zinc fingers (PF00096), immunoglobulin (PF07654),"
" and many more. Use this to find Pfam families related to a biological "
"function or structural motif."
msgstr ""

#: ../../tools/pfam_tools.rst:205 3eed59f977e848acaedcf4eca2851fed
msgid ""
"``query`` (string) (required) Search keyword. Examples: 'kinase', 'zinc "
"finger', 'helicase', 'immunoglobulin', 'rhodopsin', 'RNA binding'."
msgstr ""

#: ../../tools/pfam_tools.rst:208 548996059610443bb179b647e900701b
msgid ""
"``max_results`` (integer) (optional) Maximum number of results to return "
"(default 20, max 100)."
msgstr ""

