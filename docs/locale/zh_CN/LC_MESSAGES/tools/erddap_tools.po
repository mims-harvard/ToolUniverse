msgstr ""

#: ../../tools/erddap_tools.rst:36 e612353ecb014d51ac07b0420b1eea86
msgid ""
"``datasetID`` (string) (required) ERDDAP dataset identifier. Examples: "
"'erdATssta8day' (AVHRR SST 8-day), 'goes\\_west' (GOES-18 SST), "
"'erdMHchla8day' (MODIS chlorophyll), 'cwwcNDBCMet' (NDBC buoy "
"meteorological data)"
msgstr ""

