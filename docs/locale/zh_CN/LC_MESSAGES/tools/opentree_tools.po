#: ../../tools/opentree_tools.rst:32 289b0bb8fe7a4eb0a31318a82cc695b8
msgid ""
"**Description**: Get a phylogenetic subtree (in Newick format) from the "
"Open Tree of Life synthetic tree for a specified set of taxa. Returns the"
" evolutionary tree connecting the given taxa, showing their branching "
"relationships. Useful for constructing phylogenies for comparative "
"studies. Example: OTT IDs 770315 (Homo sapiens), 417950 (Pan "
"troglodytes), 158484 (Pan paniscus) returns the ape phylogeny showing Pan"
" troglodytes and Pan paniscus as sister species."
msgstr ""

#: ../../tools/opentree_tools.rst:34 ../../tools/opentree_tools.rst:65
#: ../../tools/opentree_tools.rst:96 ../../tools/opentree_tools.rst:127
