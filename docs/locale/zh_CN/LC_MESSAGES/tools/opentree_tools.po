#: ../../tools/opentree_tools.rst:86 376104a4de8741a4afde90347e8ccd9e
msgid ""
"Get detailed taxonomy information for a taxon from the Open Tree of Life "
"by its OTT ID. Returns t..."
msgstr ""

#: ../../tools/opentree_tools.rst a9d4819d733848709bb67783d18ab3d4
msgid "OpenTree_get_taxon tool specification"
msgstr ""

#: ../../tools/opentree_tools.rst:92 86106e2d74d044b3982b9d47c2142315
msgid "**Name**: ``OpenTree_get_taxon``"
msgstr ""

#: ../../tools/opentree_tools.rst:94 a36ca0b4123443f58e013a1863a5e321
msgid ""
"**Description**: Get detailed taxonomy information for a taxon from the "
"Open Tree of Life by its OTT ID. Returns the taxon name, rank, synonyms, "
"source databases (NCBI, GBIF, IRMNG), and flags indicating taxonomic "
"status. Use OpenTree\\_match\\_names first to get OTT IDs from species "
"names. Example: OTT ID 770315 returns Homo sapiens with rank 'species', "
"synonyms, and NCBI/GBIF cross-references."
msgstr ""

#: ../../tools/opentree_tools.rst:98 054de16a2b0643618b0290c2227f3491
msgid ""
"``ott_id`` (integer) (required) Open Tree Taxonomy ID. Examples: 770315 "
"(Homo sapiens), 417950 (Pan troglodytes), 158484 (Pan paniscus), 312031 "
"(Homininae), 244265 (Drosophila melanogaster)."
msgstr ""

