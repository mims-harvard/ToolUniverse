msgid "**Parameters:**"
msgstr ""

#: ../../tools/opentree_tools.rst:36 ffe08a7a72044141b3f1150408b61222
msgid ""
"``ott_ids`` (string) (required) Comma-separated OTT IDs (at least 2). "
"Examples: '770315,417950,158484' (human, chimp, bonobo), "
"'770315,417950,158484,770309' (plus Homo genus)."
msgstr ""

